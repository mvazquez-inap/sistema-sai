<?php
//----------------------------------------------------------------------------------------- 
class cDictamen  {
	var $conexion;

	public function __construct($conexion) {
		$this->conexion = &$conexion;
	}
//-----------------------------------------------------------------------------------------------------	
	function TraerDatosDictamen($dic_codigo,&$datosresult,&$es_modif){
		
		$datosresult=array();
		$es_modif = false;		
		$sparam=array('pdic_codigo'=>$dic_codigo);
		$spnombre="sel_dictamen_xdic_codigo";	
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$errormail="\ndic_codigo=".$dic_codigo."\nerror=".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}

		return true;
	}
	
//-----------------------------------------------------------------------------------------------------	
	function TraerDatosActividadProgramacion($act_codigo,$actprog_sec,&$datosresult,&$es_modif){
		
		$datosresult=array();
		$es_modif = false;		
		
		$spnombre="sel_actividad_programacion_xact_codigo_actprog_sec";	
		$sparam=array('pact_codigo'=>$act_codigo, 'pactprog_sec'=>$actprog_sec, 'porderby'=>"actprog_sec");
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$errormail="\nact_codigo=".$act_codigo."\nactprog_sec=".$act_codigo."\nerror=".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la Programación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function ObtenerSPClave(&$spnombre,&$spparam,$codigo) {
		$spnombre="sel_dictamen_xdic_codigo";
		$spparam=array('pdic_codigo'=>$codigo);
	}
//-----------------------------------------------------------------------------------------------------	
	// Entrada:
	//  ArregloDatos['formact_codigo']:  es una cadena, con los tipos separados por ','.
	//  				                 Puede no estar seteado, en cuyo caso se buscará 
	//								  	 por todos los formatos			
	// ArregloDatos['dic_estado']: estados separados por coma		
	// ArregloDatos['act_codigo']: una sola actividad.		
	// Salida:	resultado_array: es un array con el resultado de las consultas (ditamenes de todo los tipos).
	//							 se le adiciona el componente del formato.
//-----------------------------------------------------------------------------------------------------	
	function BuscarDictamen($ArregloDatos,&$numfilas,&$resultado_array,&$error,&$errormail)	{

		//  Los dictamenes de una actividad pueden estar en: 
		//	actividad_programacion (actividad - actividad_curso - actividad_programacion)
		//						   (actividad - actividad_externa - actividad_programacion)
		//  actividad_autodesarrollo_dictamen (actividad - actividad_autodesarrollo - actividad_autodesarrollo_dictamen)

   		    $numfilas = 0;
			$resultado_array = array();
	
			if (isset($ArregloDatos['formact_codigo']))
				$formact_codigo = explode(',',$ArregloDatos['formact_codigo']);

			$sparam=array('pxact_codigo'=>0);
			$sparam+=array('pxdic_estado'=>0);
			$sparam+=array('pxtipoact_codigo'=>0);

			$sparam+=array('pact_codigo'=>"");
			$sparam+=array('pdic_estado'=>"0");
			$sparam+=array('ptipoact_codigo'=>"");

			$sparam2=array('pxact_codigo_1'=>0);
			$sparam2+=array('pxdic_estado_1'=>0);
			$sparam2+=array('pxdic_estado_1'=>0);
			$sparam2+=array('pxtipoact_codigo_1'=>0);
			$sparam2+=array('pact_codigo_1'=>"");
			$sparam2+=array('pdic_estado_1'=>"0");
			$sparam2+=array('ptipoact_evento_asis_1'=>TIPOACTAUTOEVASIS);
			$sparam2+=array('ptipoact_codigo_1'=>"");

			$sparam2+=array('pxact_codigo_2'=>0);
			$sparam2+=array('pxdic_estado_2'=>0);
			$sparam2+=array('pxdic_estado_2'=>0);
			$sparam2+=array('pxtipoact_codigo_2'=>0);
			$sparam2+=array('pact_codigo_2'=>"");
			$sparam2+=array('pdic_estado_2'=>"0");
			$sparam2+=array('ptipoact_evento_asis_2'=>TIPOACTAUTOEVASIS);
			$sparam2+=array('ptipoact_codigo_2'=>"");

			if (isset ($ArregloDatos['act_codigo'])) {
				if ($ArregloDatos['act_codigo']!="") {	
					$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
					$sparam['pxact_codigo']= 1;
					
					$sparam2['pact_codigo_1']=$ArregloDatos['act_codigo'];
					$sparam2['pxact_codigo_1']=1;
					$sparam2['pact_codigo_2']=$ArregloDatos['act_codigo'];
					$sparam2['pxact_codigo_2']=1;
				}
			}	

			if (isset ($ArregloDatos['dic_estado'])) {
				if ($ArregloDatos['dic_estado']!="") {	
					$sparam['dic_estado']= $ArregloDatos['dic_estado'];
					$sparam['pxdic_estado']= 1;
					
					$sparam2['dic_estado_1']= $ArregloDatos['dic_estado'];
					$sparam2['pxdic_estado_1']=1;
					$sparam2['dic_estado_2']=$ArregloDatos['dic_estado'];
					$sparam2['pxdic_estado_2']=1;
				}
			}	
			
			if (isset ($ArregloDatos['tipoact_codigo'])) {
				if ($ArregloDatos['tipoact_codigo']!="") {	
					$sparam['ptipoact_codigo'] = $ArregloDatos['tipoact_codigo'];
					$sparam['pxtipoact_codigo']= 1;
					
					$sparam2['ptipoact_codigo_1'] = $ArregloDatos['tipoact_codigo'];
					$sparam2['pxtipoact_codigo_1']= 1;
					$sparam2['ptipoact_codigo_2'] = $ArregloDatos['tipoact_codigo'];
					$sparam2['pxtipoact_codigo_2']= 1;
				}
			}								
			//--------------------------------------------------------------------
			if (!isset($ArregloDatos['formact_codigo']) || in_array(FORMATOCURSO,$formact_codigo)) {
				$spnombre="sel_dictamen_curso_programacion_xdatos";
				if(!($this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultadodict,$numfilasdic,$errno)) )	{
					$error="Error al buscar dictámenes de la actividad.";
					$errormail="Error al buscar el Dictamen (curso)".$errno;
					return false;
				} else {
					while ($fila_dict = mysqli_fetch_assoc($resultadodict)) {
						$fila_dict['formact_codigo'] = FORMATOCURSO;
						$resultado_array[] = $fila_dict;
					}
				}	
			}
			//-----------------------------------------------------------------
			if (!isset($ArregloDatos['formact_codigo']) || in_array(FORMATOAUTO,$formact_codigo)) {
				$spnombre="sel_dictamen_actividad_autodesarrollo_xdatos";
				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam2,$resultadodict,$numfilasdic,$errno)) {
					$error="Error al buscar dictámenes de la actividad.";
					$errormail="Error al buscar el Dictamen (autodesarrollo)".$errno;
					return false;
				} else { 
					while ($fila_dict = mysqli_fetch_assoc($resultadodict)) {
						$fila_dict['formact_codigo'] = FORMATOAUTO;
						$resultado_array[] = $fila_dict;
					}
				}	
			}
			//-----------------------------------------------------------------
			if (!isset($ArregloDatos['formact_codigo']) || in_array(FORMATOEXT,$formact_codigo)) {
				$spnombre="sel_dictamen_actividad_externa_programacion_xdatos";
				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultadodict,$numfilasdic,$errno)) {
					$error="Error al buscar dictámenes de la actividad.";
					$errormail="Error al buscar el Dictamen (actividad-externa)".$errno;
					return false;
				} else {
					while ($fila_dict = mysqli_fetch_assoc($resultadodict)) {
						$fila_dict['formact_codigo'] = FORMATOEXT;
						$resultado_array[] = $fila_dict;
					}
				}	
			}

		   $numfilas = count($resultado_array);
		   return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoModificarDictamen($dic_codigo) {

		// no valido que sea el único dictamen de la actividad
		if (!$this->TraerDatosDictamen($dic_codigo, $fila_dictamen, $es_modif) ) 
			return false;

		$txt_sys_mail="\ndic_codigo=".$dic_codigo;		
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe el dictamen a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 

		if ($_SESSION["rolcod"] != SUPERUSUARIO) {
		
			if ($fila_dictamen['dic_estado'] == DICTAMENNUEVO || $fila_dictamen['dic_estado'] == DICTAMENRECHAZADO ) 
				return true;		
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","DICTAMENESTADO","' and constantecod='",$fila_dictamen['dic_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado del Dictamen (".$descri."), no le permite modificarlo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;		
			}
		} else
			return true;	

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar el Dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoBajaDictamen($dic_codigo) {

		if (!$this->TraerDatosDictamen($dic_codigo, $fila_dictamen, $es_modif) ) 
