	$arregloBuscar = array();
	$arregloBuscar['buscaCurso'] = false;
	$arregloBuscar['buscaAuto'] = false;
	$arregloBuscar['buscaExt']= false;
	$arregloBuscar['buscaFormal'] = false;

	switch ($_SESSION['array_busqueda_actividad']['formact_codigo'])  {
	case FORMATOCURSO :
		$arregloBuscar['buscaCurso'] = true;
		break;
	case FORMATOAUTO :
		$arregloBuscar['buscaAuto'] = true;
		break;
	case FORMATOEXT :
		$arregloBuscar['buscaExt'] = true;
		break;
	case FORMATOEFORMAL:
		$arregloBuscar['buscaFormal'] = true;
		break;
		
	case "*" :
		$arregloBuscar['buscaCurso'] = true;
		$arregloBuscar['buscaAuto'] = true;
		$arregloBuscar['buscaExt'] = true;
		$arregloBuscar['buscaFormal'] = true;
	}
 ?>	
 
