	// Falta ver si se limitan los permisos	
	 switch ($_GET['tipoact_codigo']) {
	 case TIPOACTCURSOINAP:
	 	 $oActividad = new cActividadCursoInap($conexion);
	 	break;
	 case TIPOACTCURSOJURISD:
 	 	 $oActividad = new cActividadCursoJurisdiccional($conexion);
 	 	break;
	 case TIPOACTCURSOINST:
  	 	 $oActividad = new cActividadCursoInstitucional($conexion);
 	 	break;
	 case TIPOACTEXTASIS:
