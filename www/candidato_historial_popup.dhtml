//-------------------------------------------------------------------------------------
function MostrarPersonasAsignadas($conexion,$ArregloDatos) {



	$formact_codigo = FORMATOCURSO; 	
	$oActividadPersona=new cComisionPersona($conexion);

	$formact_descripcion="";
	$conexion->TraerCampo("formato_actividad","formact_descripcion",array("formact_codigo='",$formact_codigo,"'"),$formact_descripcion,$numfilas,$errorcod); 

	$numfilas=0;	
	$ArregloDatos['orderby'] = "comi_codigo DESC";

	if(!$oActividadPersona->BuscarActividadAsignadaPersonaAvanzada ($ArregloDatos, $numfilas, $resultPersonas, $error, $errormail)) {
		$txt_sys_mail = "Buscando el formato de actividad \nformato=$formact_codigo";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar las personas asignadas a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	} 
	if($numfilas > LIMITE_BUSQUEDA_MEDIANO*50)	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La b&uacute;squeda retorn&oacute; más de ".LIMITE_BUSQUEDA_MEDIANO." personas (".$numfilas."), deber&aacute; acotarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	} elseif($numfilas==0) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se encontraron personas, que cumplan con la condición <br> y tengan asignadas actividades de formato ".$formact_descripcion,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} elseif($numfilas>0) {  
	
			$opciones=array(
				"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
				"FilasPagina"=>1000,
				"FormularioBotonera"=>"form_boton",		
				"NombrePaginaQuery"=>"pagina"
			);				
	
			if (isset($_GET["pagina"]))	{
				$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
				$opciones['QueryString']=$querystring;
			}

			$oPersonas = new cPersonas($conexion);
			$oActividad = new cActividad($conexion);
			$oActividadCursoINAP = new cActividadCursoINAP($conexion);
			$oComision = new cComision($conexion);			
					
			$personas_asignadas=array();					
			while ($fila_asignacion = mysqli_fetch_assoc($resultPersonas)) {  
				$muestra = true;


				$fila_asignacion['formact_codigo']=$formact_codigo;
	
				$tipoact_descripcion="";
				$conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_asignacion['tipoact_codigo'],"'"),$tipoact_descripcion,$numfilas,$errorcod); 
				$fila_asignacion['tipoact_descripcion']=$tipoact_descripcion;

//				Cambio piden fecha de la comisión
//				$fila_asignacion['fecha_desde_hasta'] = $fila_asignacion['actprog_fecha_inicio']."\na\n".$fila_asignacion['actprog_fecha_fin'];
				$oComision->TraerDatosComision($fila_asignacion['comi_codigo'],$fila_comision,$es_modif);

				$fila_asignacion['fecha_desde_hasta'] = FuncionesPHPLocal::ConvertirFecha($fila_comision['comi_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa')
														."\na\n".
														FuncionesPHPLocal::ConvertirFecha($fila_comision['comi_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa');

				$fila_asignacion['actividad_identificacion'] = $fila_asignacion['act_nombre']." (".$fila_asignacion['act_codinap'].")";
				
				
				$evaluacion="";
				if ($conexion->TraerCampo("evaluacion","eval_descripcion",array("eval_codigo='",$fila_asignacion['eval_codigo'],"'"),$evaluacion,$numfilas,$errorcod))
					$fila_asignacion['evaluacion'] = $evaluacion;
				

				
				if ($muestra)
					$personas_asignadas[]=$fila_asignacion;
				
			} // while $fila_asignacion = mysql_fetch_assoc($resultPersonas)
			
	
			
			$oGrilla = new cGrilla($opciones);
			$oGrilla->SetearTituloGrilla('Personas Asignadas Formato ('.$formact_descripcion.")");
			$oGrilla->SetearAnchoGrilla('100%');

			$miColumna1 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna1,'Actividad');
			$oGrilla->Setear('campo_grilla',$miColumna1,'actividad_identificacion');
			$oGrilla->Setear('align_columna',$miColumna1,'left');
			
			$miColumna2 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna2,'Tipo Actividad');
			$oGrilla->Setear('campo_grilla',$miColumna2,'tipoact_descripcion');					
			$oGrilla->Setear('align_columna',$miColumna2,'left');

			$miColumna4 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna4,'Comisión');
			$oGrilla->Setear('campo_grilla',$miColumna4,'comi_codinap');
			$oGrilla->Setear('align_columna',$miColumna4,'center');
			$oGrilla->Setear('ancho_columna',$miColumna4,'80');

			$miColumna3 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna3,'Fecha Comisión');
			$oGrilla->Setear('campo_grilla',$miColumna3,'fecha_desde_hasta');
			$oGrilla->Setear('ancho_columna',$miColumna3,'80');

			$miColumna5 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna5,'Evaluación');
			$oGrilla->Setear('campo_grilla',$miColumna5,'evaluacion');					
			$oGrilla->Setear('align_columna',$miColumna5,'left');

	

			echo "<a name=Ira></a>";
			
			if ($oGrilla->CargarGrilla($personas_asignadas)) {
				$oGrilla->MostrarGrilla();	
				echo "<br>";				
			} else {
				$txt_sys_mail = "Error Grilla='".$oGrilla->GetError();
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar las personas asignadas.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
				return false;
			}		
	}		

	return true;
} 




//----------------------------------------------------------------------------------------- 
$datosvalidados = array();

if (isset($_GET['pers_cuilt'])) {
		$_SESSION['filtro_busqueda']=array();

		if(!$oPersonas->TraerDatosPersona($_GET["pers_cuilt"],$datospersona,$es_modif)) {
			$txt_sys_mail="\n pers_cuilt=".$_GET["pers_cuilt"];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar el dictamen personal.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), "");
			$_SESSION['filtro_busqueda']['pers_codigo']=-1;
		} else {
			if (!$es_modif)
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El candidato no está registrado en el Sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), "");
			else {
				$_SESSION['filtro_busqueda']['pers_codigo']=$datospersona['pers_codigo'];
				MostrarPersonasAsignadas($conexion,$_SESSION['filtro_busqueda']);
			}

		}
}



?>
