	function CreditosActividad_porPersona($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('ppers_cuilt'=>'');

		$sparam+=array('pxfecha_inicio'=>0);
		$sparam+=array('pfecha_inicio'=>'');
		$sparam+=array('pxfecha_fin'=>0);
		$sparam+=array('pfecha_fin'=>'');

		// Se copian los valores del valor correspondiente sin c1
		$sparam+=array('ppers_cuilt_c1'=>'');

		// Es por cuit
		$sparam['ppers_cuilt']= $ArregloDatos['pers_cuilt'];
		$sparam['ppers_cuilt_c1']= $ArregloDatos['pers_cuilt'];

		// Fecha de realizacion
		if (isset($ArregloDatos['fecha_inicio']))
		{
			if ($ArregloDatos['fecha_inicio']!="")
			{
				$sparam['pfecha_inicio']= $ArregloDatos['fecha_inicio'];
				$sparam['pxfecha_inicio']= 1;
			}
		}

		if (isset($ArregloDatos['fecha_fin']))
		{
			if ($ArregloDatos['fecha_fin']!="")
			{
				$sparam['pfecha_fin']= $ArregloDatos['fecha_fin'];
				$sparam['pxfecha_fin']= 1;
			}
		}

		$spnombre="sel_creditos_actividad_curso_xcuilt";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar créditos por Actividades Curso.";
			$errormail="Error al buscar créditos de Actividades Curso.".$errno;
			return false;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function ActividadCertificada_porPersona($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('ppers_cuilt'=>'');

		$sparam+=array('pxfecha_inicio'=>0);
		$sparam+=array('pfecha_inicio'=>'');
		$sparam+=array('pxfecha_fin'=>0);
		$sparam+=array('pfecha_fin'=>'');

		// Se copian los valores del valor correspondiente sin c1
		$sparam+=array('ppers_cuilt_c1'=>'');

		$sparam+=array('porderby'=>'fecha_fin');
		// Es por cuit
		$sparam['ppers_cuilt']= $ArregloDatos['pers_cuilt'];
		$sparam['ppers_cuilt_c1']= $ArregloDatos['pers_cuilt'];

		// Fecha de realizacion
		if (isset($ArregloDatos['fecha_inicio']))
		{
			if ($ArregloDatos['fecha_inicio']!="")
			{
				$sparam['pfecha_inicio']= $ArregloDatos['fecha_inicio'];
				$sparam['pxfecha_inicio']= 1;
			}
		}

		if (isset($ArregloDatos['fecha_fin']))
		{
			if ($ArregloDatos['fecha_fin']!="")
			{
				$sparam['pfecha_fin']= $ArregloDatos['fecha_fin'];
				$sparam['pxfecha_fin']= 1;
			}
		}
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}
		$spnombre="sel_actividad_curso_certificada_xcuilt";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar Actividades Curso Certificadas.";
			$errormail="Error al buscar Actividades Curso Certificadas".$errno;
			return false;
		}
		return true;
	}
