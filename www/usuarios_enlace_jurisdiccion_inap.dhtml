//--------------------------------------------------------------------------------------------------
function MostrarGrillaSeleccion($conexion) {

	$spnombre='sel_usuarios_usuarios_roles_jurisdiccion_inap_xrolcod';
	$spparam = array('prolcod'=>USUACTJUR,				
			);

	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$result_usu,$num_usu,$errno)) {	
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar usuarios enlaces.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
		return false;			
	}

	if ($num_usu>0) {


			$opciones=array(
				"numPagina"=>isset($_GET['paginaG1'])?$_GET['paginaG1']:1,
				"FilasPagina"=>$num_usu,
				"NombrePaginaQuery"=>"paginaG1"
			);
			
			if (isset($_GET['paginaG1']))	{
				$querystring=FuncionesPHPLocal::ArmarQueryString("paginaG1","",false);
				$opciones['QueryString']=$querystring;
			}
			
			$oGrilla = new cGrilla($opciones);
			$oGrilla->SetearTituloGrilla('Usuarios de Actividades Jurisdiccionales (enlaces)');
			
			$oGrilla->SetearAnchoGrilla('90%');
			
			$miColumna1 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna1,'CUIT');
			$oGrilla->Setear('campo_grilla',$miColumna1,'usuarioCUIT');
			$oGrilla->Setear('align_columna',$miColumna1,'left');
		
			$miColumna2 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna2,'Nombre');
			$oGrilla->Setear('campo_grilla',$miColumna2,'usuarionombre');
			$oGrilla->Setear('align_columna',$miColumna2,'left');
		
			$miColumna3 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna3,'Apellido');
			$oGrilla->Setear('campo_grilla',$miColumna3,'usuarioapellido');
			$oGrilla->Setear('align_columna',$miColumna3,'left');
		
			$miColumna4 = $oGrilla->AddColumna('linkimg');
			$oGrilla->Setear('titulo_columna',$miColumna4,'Editar');
			$oGrilla->Setear('ancho_columna',$miColumna4,'60');
			$oGrilla->Setear('url',$miColumna4,'usuarios_enlace_jurisdiccion_inap.dhtml');
			$oGrilla->Setear('url_ancla',$miColumna4,'Edicion');
			
			$oGrilla->Setear('imagen',$miColumna4,'images/editar.jpg');
			$oGrilla->Setear('altImagen',$miColumna4,'Editar');						
			$oGrilla->AddParametrosURL($miColumna4,"usuariocod","usuariocod");
			$oGrilla->AddParametrosURL($miColumna4,"operacion","M","cte");
		
			if (!$oGrilla->CargarGrilla($result_usu))
				return false;

			$oGrilla->MostrarGrilla();
		

} else { 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No hay usuarios enlaces.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	 }
	return true;
} 		
