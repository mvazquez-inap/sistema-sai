	public function BusquedaAvanzada($datosbusqueda,&$tipo,&$resultado,&$numfilas)
	{
		$campo = " a.* ";  
		if ($tipo==1)
			$campo = " COUNT(idpub) as total ";
		

		$spnombre="sel_publicaciones_buscar";
		$sparam=array(
			'pcampo'=> $campo,
			'pxidpub'=> 0,
			'pidpub'=> "",
			'pxanio_edicion'=> 0,
			'panio_edicion'=> "",
			'pxnumero_edicion'=> 0,
			'pnumero_edicion'=>"",
			'pxestadopub'=> 0,
			'pestadopub'=> -1,
			'porderby'=> "",
			'plimit'=> ""
			);	

		if (isset ($datosbusqueda['idpub']) && $datosbusqueda['idpub']!="")
		{
			$sparam['pidpub'] = $datosbusqueda['idpub'];
			$sparam['pxidpub'] = 1;
		}
	
		if (isset ($datosbusqueda['anio_edicion']) && $datosbusqueda['anio_edicion']!="")
		{
			$sparam['panio_edicion'] = $datosbusqueda['anio_edicion'];
			$sparam['pxanio_edicion'] = 1;
		}		
		if (isset ($datosbusqueda['numero_edicion']) && $datosbusqueda['numero_edicion']!="")
		{
			$sparam['pnumero_edicion'] = $datosbusqueda['numero_edicion'];
			$sparam['pxnumero_edicion'] = 1;
		}	
	
		if (isset ($datosbusqueda['estadopub']) && $datosbusqueda['estadopub']!="")
		{
			$sparam['pestadopub'] = $datosbusqueda['estadopub'];
			$sparam['pxestadopub'] = 1;
		}	
		
		if (isset ($datosbusqueda['limit']) && $datosbusqueda['limit']!="")
		{
			$sparam['plimit'] = $datosbusqueda['limit'];
		}	
		
		if (isset ($datosbusqueda['orderby']) && $datosbusqueda['orderby']!="")
		{
			$sparam['porderby'] = $datosbusqueda['orderby'];
		}else {
			$sparam['porderby'] = 'fecha_edicion asc';
		}	
		

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se han podido obtener los registros por búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	
	
		return true;	
	}
		function StoreBuscar($datos,&$spnombre,&$sparam)
	{
		
		$campo = " a.* ";  
		

		$spnombre="sel_publicaciones_buscar";
		$sparam=array(
			'pcampo'=> $campo,
			'pxidpub'=> 0,
			'pidpub'=> "",
			'pxanio_edicion'=> 0,
			'panio_edicion'=> "",
			'pxnumero_edicion'=> 0,
			'pnumero_edicion'=>"",
			'pxestadopub'=> 0,
			'pestadopub'=> -1,
			'porderby'=> "",
			'plimit'=> ""
			);	

		if (isset ($datosbusqueda['idpub']) && $datosbusqueda['idpub']!="")
		{
			$sparam['pidpub'] = $datosbusqueda['idpub'];
			$sparam['pxidpub'] = 1;
		}
	
		if (isset ($datosbusqueda['anio_edicion']) && $datosbusqueda['anio_edicion']!="")
		{
			$sparam['panio_edicion'] = $datosbusqueda['anio_edicion'];
			$sparam['pxanio_edicion'] = 1;
		}		
		if (isset ($datosbusqueda['numero_edicion']) && $datosbusqueda['numero_edicion']!="")
		{
			$sparam['pnumero_edicion'] = $datosbusqueda['numero_edicion'];
			$sparam['pxnumero_edicion'] = 1;
		}	
	
		if (isset ($datosbusqueda['estadopub']) && $datosbusqueda['estadopub']!="")
		{
			$sparam['pestadopub'] = $datosbusqueda['estadopub'];
			$sparam['pxestadopub'] = 1;
		}	
		
		if (isset ($datosbusqueda['limit']) && $datosbusqueda['limit']!="")
		{
			$sparam['plimit'] = $datosbusqueda['limit'];
		}	
		
		if (isset ($datosbusqueda['orderby']) && $datosbusqueda['orderby']!="")
		{
			$sparam['porderby'] = $datosbusqueda['orderby'];
		}else {
			$sparam['porderby'] = 'fecha_edicion asc';
		}	
				
	return true;
	}
	
	function InsertarPublicacionCompleta($datos,$archivo,&$idpub)
	{

		if (!$this->PuedeInsertar($datos))
			return false;
		
		$datos["fecha_edicion"]=convertirfecha($datos["fecha_edicion"],"aaaa-mm-dd","dd/mm/aaaa");
		$datos['revista_pdf'] = "Archivo_".date("Ymdhms").".pdf";
		$datos['imagen_tapa'] = "ImagenTapa_".date("Ymdhms").".jpg";
		$imagen="contenido_multimedia/tapas/".$datos["imagen_tapa"];
		
		if (strlen($datos['anio_edicion'])=="1"){
			$datos["anio_edicion"] = "0".$datos["anio_edicion"];
		}
		if (strlen($datos['numero_edicion'])=="1"){
			$datos["numero_edicion"]="0".$datos["numero_edicion"];
		}
		$spnombre="ins_publicacion";
		$sparam=array(
			'pfecha_edicion'=> $datos["fecha_edicion"],
			'panio_edicion'=> $datos["anio_edicion"],
			'pnumero_edicion'=> $datos["numero_edicion"],
			'pimagen_tapa'=> $imagen,
			'prevista_pdf'=> $datos["revista_pdf"],
			'pvideo_fotonovela_embebido'=> $datos["video_foto_novela"],
			'pestado'=> ACTIVO,
			'pultmodusuario'=> $_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y-m-d H:i:s")
			);
			
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha podido insertar la publicación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$idpub=$this->conexion->UltimoCodigoInsertado();
		
		//print_r($archivo);
		if (isset($archivo['revista_pdf']))
		{
			if (!$this->SubirArchivoPdf($archivo['revista_pdf'],$datos['revista_pdf']))
				return false;
		}
		

		if (!$this->SubirImagenTapa($datos,$datos['imagen_tapa']))
			return false;
	
		return true;
	
	}
	
	
	function SubirImagenTapa($datos,$nombrearchivo)
	{
		$data = str_replace("data:image/png;base64,","",$datos['imagen_tapa_archivo']);
		$imageStr = base64_decode($data);

		$image = imagecreatefromstring($imageStr);
		if ($image == false) {
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al subir la imagen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>""));
			return false;
		}
		$img = ARCHIVOS_IMG_TAPAS.$nombrearchivo;

		
		if(!imagepng($image, $img))
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al subir la imagen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>""));
			return false;
		}
		if(($tamanio=getimagesize($img))===false)
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"El archivo ingresado no es una imagen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>""));
			return false;
		}

		$archnom=$img;
		$ancho = 500;
		$calidad = 100;
		$forma = "X"; 
		$image_new = Guardafoto($img, $ancho, $calidad, $forma);
		$savePath = ARCHIVOS_IMG_TAPAS;
		if (!imagejpeg($image_new, $savePath.$nombrearchivo, $calidad))
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error guardar la imagen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>""));
			return false;
		}
			

		return true;		
	}
	
	


	function ValidarAltaArchivo($archivo)
	{
		if ($archivo['error'] != UPLOAD_ERR_OK) 
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al subir el pdf. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>""));
			return false;
	
		}
		if ($archivo['size'] ==0)		
		{			
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error archivo vacio. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>""));
			return false;
		}
		
		if(!is_uploaded_file($archivo['tmp_name']))
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en el archivo ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>""));
			return false;
		}
		
		return true;	
	}
	
	function SubirArchivoPdf($archivo,$nombrearchivo)
	{
		if (!$this->ValidarAltaArchivo($archivo))
			return false;

		if (!move_uploaded_file($archivo["tmp_name"], ARCHIVOS_PDF.$nombrearchivo))	
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al subir el archivo ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>""));
			return false;
		}
			

		return true;		
	}
	
	
