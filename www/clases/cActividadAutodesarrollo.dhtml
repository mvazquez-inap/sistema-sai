	function PedirActividad($codinap,$formularioName,$inputName,$accion,$submit=true) { 
?>		<table width="100%" class="textoTablaDato" align="center">
			<tr>
				<td valign="middle" width="15%" class='textoEtiqueta'>Código INAP</td>
				<td class="textoEtiquetaDato" valign="middle" align="left" width="50">
					<input type="text" size="21" maxlength="20" name="<?php echo $inputName ?>" id="<?php echo $inputName ?>" onblur="PasarAMayusculas('<?php echo $inputName ?>')" value="<?php echo trim($codinap);?>">
				</td>			
				<td class="textoEtiquetaDato" align="center" width="7%">
					<a href='javascript:void(0)' onClick="Popup('actividad_selector.dhtml?formulario=<?php echo $formularioName ?>&amp;destino=<?php echo $inputName."&amp;submit=".$submit."&amp;tipoact_codigo=&amp;accion=".$accion ?>&amp;volver=1','ventana_descripciones',630,360,screen.availWidth-650,screen.availHeight-420,'yes');"><img src="images/searchsai.jpg" alt="Buscar" border="0" style="vertical-align:-5px"></a>
				</td>			
				<td class="textoEtiquetaDato"  valign="middle" align="left">
					<input type="submit" name="Confirma" value="Confirma" class="botones" />
				</td>			
				
			</tr>
		</table>
<?php		unset($_SESSION['array_busqueda_basica_actividad']);	
		unset($_SESSION['filtro_busqueda']);
?>
<?php	} 

