<?php
//----------------------------------------------------------------------------------------- 
class cActividadCursoInstitucional extends cActividadCurso {

	public function __construct($conexion) {
		parent::__construct($conexion);
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,&$datosresult,&$es_modif) {
		if (!$this->TraerDatosActividadCursoInstitucional($act_codigo,$datosresult_detalle,$es_modif)) {
			return false;
		} else {
			$datosresult['act_codigo']=$datosresult_detalle['actividad']['act_codigo'];
			$datosresult['act_formato']=FORMATOCURSO;
			$datosresult['tipoact_codigo']=TIPOACTCURSOINST;			
			$datosresult['act_nombre']=$datosresult_detalle['actividad']['act_nombre'];
			$datosresult['act_codinap']=$datosresult_detalle['actividad']['act_codinap'];
			$datosresult['act_duracionhs']=$datosresult_detalle['actividad_curso_institucional']['actdisinst_duracionhs'];
			$datosresult['act_estado']=$datosresult_detalle['actividad_curso']['actcur_estado'];
			$datosresult['act_creditos']=$datosresult_detalle['actividad_curso']['actcur_creditos'];
			$datosresult['jurisdid_inap']=$datosresult_detalle['actividad_curso']['jurisdid_inap'];
			return true;
		}
	}	
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadCursoInstitucional($act_codigo,&$datosresult,&$es_modif) {
		
		// Si se hay error al ejecutar algún SQL retorna error, sino si no encuentra
		// la actividad o la actividad curso no es Curso Institucional, retorna que es_modif=false
		// pues no se encontro una actividad curso inap con el codigo enviado

		$datosresult=array();
		$es_modif = false;		

		if (!$this->TraerDatosActividad($act_codigo,$result_actividad,$es_modif_act)) 
			return false;
	
		if ($es_modif_act) {

			$datosresult['actividad']=$result_actividad; // Datos de la actividad

			if (!$this->TraerDatosActividadCurso($act_codigo,$result_actividad_curso,$es_modif_act_curso)) 
				return false;
		
			if ($es_modif_act_curso) { // Datos de la actividad curso

				$datosresult['actividad_curso']=$result_actividad_curso;
	
				// Verifico que sea una actividad curso Institucional
				if ($datosresult['actividad_curso']['tipoact_codigo'] != TIPOACTCURSOINST) {
					$es_modif=false;
				}
				
				$sparam=array('pact_codigo'=>$act_codigo);
				$spnombre="sel_actividad_curso_diseno_institucional_xact_codigo";	
				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
				{
					$errormail="\nact_codigo".$act_codigo;
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
				if ($numfilas == 1)	{
					$datosresult['actividad_curso_institucional']= mysqli_fetch_assoc($resultado);
					$es_modif = true;
				}
			} // $es_modif_act_curso
		} // $es_modif_act
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function AltaDatosActividadCursoInstitucional($datos,&$act_codigo_nuevo,&$act_codinap) {

		$datosvalidados=array();		
		$this->_AguparDatosPost($datos,$datos_agrup,false);	
		
		$datoscurso['actividad']=$datos_agrup['actividad'];
		$datoscurso['actividad_curso']=$datos_agrup['actividad_curso'];		
		
		if(!$this->AltaDatosActividadCurso($datoscurso,$act_codigo_nuevo,$act_codinap))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38101","act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);

		if(!$this->_DatosValidosAltaActividadCursoInstitucional($datos_agrup['actividad_curso_institucional'],$datosvalidados))
			return false;

		$spnombre="ins_actividad_curso_diseno_institucional";
		$spparam=array('pact_codigo'=>$act_codigo_nuevo,
					  'pactdisinst_fundamentacion'=>$datosvalidados['actdisinst_fundamentacion'],
					  'pactdisinst_perfil'=>$datosvalidados['actdisinst_perfil'],
					  'pactdisinst_objetivos'=>$datosvalidados['actdisinst_objetivos'],
					  'pactdisinst_contenido'=>$datosvalidados['actdisinst_contenido'],
					  'pactdisinst_eval'=>$datosvalidados['actdisinst_eval'],
					  'pactdisinst_requiaprobacion'=>$datosvalidados['actdisinst_requiaprobacion'],
					  'pactdisinst_fecha'=>$datosvalidados['actdisinst_fecha'],
					  'pactdisinst_duracionhs'=>$datosvalidados['actdisinst_duracionhs'],
					  'pactdisinst_duraciondetalle'=>$datosvalidados['actdisinst_duraciondetalle'],
					  'ppais_codigo'=>$datosvalidados['pais_codigo'],
					  'pprov_codigo'=>$datosvalidados['prov_codigo'],
					  'pactdisinst_direccion'=>$datosvalidados['actdisinst_direccion'],
			  		  'porgapri_codigo'=>$datosvalidados['orgapri_codigo'],
			  		  'pjurisdid_apn'=>$datosvalidados['jurisdid_apn'],
			  		  'porgapub_codigo'=>$datosvalidados['orgapub_codigo'],		
					  			  
 				      'pactdisinst_metodologia'=>$datosvalidados['actdisinst_metodologia'],
					  'pactdisinst_bibliografia'=>$datosvalidados['actdisinst_bibliografia'],
					  'pactdisinst_perfil_instructor'=>$datosvalidados['actdisinst_perfil_instructor'],
					  
		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad Curso Institucional.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosActividadCursoInstitucional($act_codigo) {

		if(!$this->_DatosValidosEliminarActividadCursoInstitucional($act_codigo,$datosvalidados))
			return false;

		$spnombre="del_actividad_curso_diseno_institucional";
		$spparam=array('pact_codigo'=>$act_codigo);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la Actividad Curso Institucional.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if(!$this->EliminarDatosActividadCurso($act_codigo)) 
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38102","act_codigo=".$act_codigo,$_SESSION['usuariocod']);

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function ModifDatosActividadCursoInstitucional($datos)	{

		$this->_AguparDatosPost($datos,$datos_agrup,true);	
		
		$datoscurso['actividad']=$datos_agrup['actividad'];
		$datoscurso['actividad_curso']=$datos_agrup['actividad_curso'];		

		if(!$this->ModifDatosActividadCurso($datoscurso))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38103","act_codigo=".$datos_agrup['actividad']['act_codigo'],$_SESSION['usuariocod']);

		if(!$this->_DatosValidosModifActividadCursoInstitucional($datos_agrup['actividad_curso_institucional'],$datosvalidados))
			return false;
			
		$spnombre="upd_actividad_curso_diseno_institucional";
		$spparam=array('pact_codigo'=>$datosvalidados['act_codigo'], 
					  'pactdisinst_fundamentacion'=>$datosvalidados['actdisinst_fundamentacion'],
					  'pactdisinst_perfil'=>$datosvalidados['actdisinst_perfil'],
					  'pactdisinst_objetivos'=>$datosvalidados['actdisinst_objetivos'],
					  'pactdisinst_contenido'=>$datosvalidados['actdisinst_contenido'],
					  'pactdisinst_eval'=>$datosvalidados['actdisinst_eval'],
					  'pactdisinst_requiaprobacion'=>$datosvalidados['actdisinst_requiaprobacion'],
					  'pactdisinst_fecha'=>$datosvalidados['actdisinst_fecha'],
					  'pactdisinst_duracionhs'=>$datosvalidados['actdisinst_duracionhs'],
					  'pactdisinst_duraciondetalle'=>$datosvalidados['actdisinst_duraciondetalle'],
					  'ppais_codigo'=>$datosvalidados['pais_codigo'],
					  'pprov_codigo'=>$datosvalidados['prov_codigo'],
					  'pactdisinst_direccion'=>$datosvalidados['actdisinst_direccion'],
			  		  'porgapri_codigo'=>$datosvalidados['orgapri_codigo'],
			  		  'pjurisdid_apn'=>$datosvalidados['jurisdid_apn'],
			  		  'porgapub_codigo'=>$datosvalidados['orgapub_codigo'],		  

   				      'pactdisinst_metodologia'=>$datosvalidados['actdisinst_metodologia'],
					  'pactdisinst_bibliografia'=>$datosvalidados['actdisinst_bibliografia'],
					  'pactdisinst_perfil_instructor'=>$datosvalidados['actdisinst_perfil_instructor'],

		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\nact_codigo='.$datosvalidados['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la Actividad Curso Institucional.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function ValidarFormAltaActividadCursoInstitucional() {	

	// Incluir las validaciones javascript de las 3 tablas.
	$this->ValidarFormAltaActividad(); 
	$this->ValidarFormAltaActividadCurso(); 
?>		
	function ValidarFormAltaActividadCursoInstitucional(formulario,operacion) {

		
			// Fundamentación 					- [actdisinst_fundamentacion] 	- [OPCIONAL]
		
			// Perfil del participante 			- [actdisinst_perfil] 			- [OBLIG]
			if ((trim(formulario.actdisinst_perfil.value)=="")) {
				alert("Debe ingresar el perfil del participante");
				formulario.actdisinst_perfil.focus();
				return false;
			}	
			
			// Objetivos 						- [actdisinst_objetivos] 		- [OPCIONAL]
			
			// Contenido 						- [actdisinst_contenido] 		- [OBLIG]
			if ((trim(formulario.actdisinst_contenido.value)=="")) {
				alert("Debe ingresar el contenido");
				formulario.actdisinst_contenido.focus();
				return false;
			}	

			// Metodologia							- [actdisinst_metodologia] 			- [OBLIG]
			if ((trim(formulario.actdisinst_metodologia.value)=="")) {
				alert("Debe ingresar las estrategias metodológicas y recursos didácticos.");
				formulario.actdisinst_metodologia.focus();
				return false;
			}	
            
			// Evaluación de los aprendizajes 	- [actdisinst_eval] 			- [OBLIG]
			if ((trim(formulario.actdisinst_eval.value)=="")) {
				alert("Debe ingresar la evaluación de los aprendizajes");
				formulario.actdisinst_eval.focus();
				return false;
			}	

			// Requisitos de Asistencia y aprobación			- [actdisinst_requiaprobacion] 	- [OBLIG]
			if ((trim(formulario.actdisinst_requiaprobacion.value)=="")) {
				alert("Debe ingresar los requisitos de Asistencia y aprobación");
				formulario.actdisinst_requiaprobacion.focus();
				return false;
			}	
			// Fecha
			if (formulario.actdisinst_fecha.value=="" || !ValidarFecha(formulario.actdisinst_fecha.value))
			{
				alert("La fecha no es válida");
				formulario.actdisinst_fecha.focus();
				return false;
			}
			
			// Duración	en hs. - [actdisinst_duracionhs] 	- [OBLIG]
			if (!ValidarContenido(formulario.actdisinst_duracionhs.value,'NumericoEntero') ) {
				alert("La duración en hs. debe ser un número entero");
				formulario.actdisinst_duracionhs.focus();
				return false;
			}	
			if (formulario.actdisinst_duracionhs.value<=0) {
				alert("La duración en hs. debe ser mayor que cero");
				formulario.actdisinst_duracionhs.focus();
				return false;
			}	
			
			// Detalle sobre la duración	 	- [actdisinst_duraciondetalle] 	- [OPCIONAL]
			
			// Pais								- [pais_codigo] 	- [OBLIG]
			if ((trim(formulario.pais_codigo.value)=="")) {
				alert("Debe ingresar un pais");
				formulario.pais_codigo.focus();
				return false;
			}	

			// Provincia						- [prov_codigo] 	- [OBLIG] / Si es Argentina
			if ((trim(formulario.pais_codigo.value)== <?php echo ARGENTINA?>)){
				if ((trim(formulario.prov_codigo.value)=="")){
					alert("Debe ingresar una provincia");
					formulario.prov_codigo.focus();
					return false;
				}					
			}
			
			// Direccion 							- [actdisinst_direccion] [OPCIONAL]

			// Sector del Organismo
			if (!formulario.tipo_institucion[0].checked   && !formulario.tipo_institucion[1].checked) {
				alert("Debe seleccionar el sector del organismo");
				formulario.tipo_institucion[0].focus();
				return false;
			}
			
			// Organismo 											[OBLIG]
			if (formulario.tipo_institucion[0].checked ) {			// Organismo Público
				if (trim(formulario.jurisdid.value)=="") {
					alert("Debe seleccionar el organismo público");
					formulario.jurisdid.focus();
					return false;
				}
			}  
			if (formulario.tipo_institucion[1].checked ) {			// Organismo Privado
				if (trim(formulario.orgapri_codigo.value)=="") {
					alert("Debe seleccionar el organismo privado");
					formulario.orgapri_codigo.focus();
					return false;
				}
			}  
		
			// Bibliografia							- [actdisinst_bibliografia] 			- [OBLIG]
			if ((trim(formulario.actdisinst_bibliografia.value)=="")) {
				alert("Debe ingresar la bibliografía");
				formulario.actdisinst_bibliografia.focus();
				return false;
			}	

			// Perfil del instructor				- [actdisinst_perfil_instructor] 			- [OBLIG]
			if ((trim(formulario.actdisinst_perfil_instructor.value)=="")) {
				alert("Debe ingresar el perfil del instructor");
				formulario.actdisinst_perfil_instructor.focus();
				return false;
			}	

			
			return true;
		}				
//-----------------------------------------------------------------------------------------------------	
	function SeleccionPais(formulario){
		var elSelect = document.getElementById('datos_provincia');
		if (formulario.pais_codigo.value == <?php echo ARGENTINA ?>) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";
		}
	}
//-----------------------------------------------------------------------------------------------------	
	function SeleccionTipoInstitucion(valorlogico,seccion_mostrar,seccion_ocultar ){

		var elSelectMostrar = document.getElementById(seccion_mostrar);
		var elSelectOcultar = document.getElementById(seccion_ocultar);

			if (valorlogico) {
				elSelectMostrar.style.display ="block";
				elSelectOcultar.style.display ="none";			
			} else {
				elSelectMostrar.style.display ="none";
				elSelectOcultar.style.display ="block";			
			}				
	}
<?php }
