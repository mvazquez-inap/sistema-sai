			</tr>
			<tr>
				<td class='textoEtiqueta' width="30%">Estado</td>
				<td class='textoEtiquetaDatoResaltado'>
						<?php $this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","POCACTIVIDADESTADO","' and constantecod='",$fila_actpoc['pocact_estado'],"'"),$descri,$numfilas,$errorcod); 
							echo htmlspecialchars($descri,ENT_QUOTES);
						?>
				</td>
			</tr>
		</table>	
		
<?php 
		// busco todos los objetivos asociados a la actividad poc
		$oPocActividadPocObjetivo = new cPocActividadPocObjetivo($this->conexion);			

