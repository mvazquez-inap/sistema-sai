<script type="text/javascript" language="javascript">

function ArmaComboPoc(jurisdid_inap,formulario,idCombo,idAguarde) {

	var archivo="obtener_poc_organismo_ajax.dhtml";		
	var datos ="jurisdid_inap="+jurisdid_inap+"&formulario="+formulario;

	var contenedor=document.getElementById(idAguarde);
	contenedor.innerHTML='Aguarde, cargando objetivos ...';
	
	var objCombo=document.getElementById(idCombo);
	
	var ajax=nuevoAjax();
	ajax.open("POST",archivo,true);

	ajax.onreadystatechange=function() {
		if (ajax.readyState==4) {	
//			if (ajax.responseText.substr(0,15)=="//tienepermisos") 	{	
			objCombo.innerHTML=ajax.responseText;
			contenedor.innerHTML='';
			
//			} else {	
//				objCombo.innerHTML="Ud. no tiene los permisos";
//				contenedor.innerHTML='';
//			}
				
		}
	}

	ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
	ajax.send(datos);		
}	



function ArmaComboObj(poc_codigo,idCombo,idAguarde) {

	var archivo="obtener_objetivos_poc_ajax.dhtml";		
	var datos ="poc_codigo="+poc_codigo;

	var contenedor=document.getElementById(idAguarde);
	contenedor.innerHTML='Aguarde, cargando Poc ...';
	
	var objCombo=document.getElementById(idCombo);
	
	var ajax=nuevoAjax();
	ajax.open("POST",archivo,true);

	ajax.onreadystatechange=function() {
		if (ajax.readyState==4) {	
//			if (ajax.responseText.substr(0,15)=="//tienepermisos") 	{				
				objCombo.innerHTML=ajax.responseText;
				contenedor.innerHTML='';
//			} else {	
//				objCombo.innerHTML="Ud. no tiene los permisos";
//				contenedor.innerHTML='';
//			}
				
		}
	}

	ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
	ajax.send(datos);		
}	


//------------------------------------------------------------------------------------------------ 
 function PedirParametrosListado(form, cod_listado) {
	form.cod_listado.value=cod_listado;
	InvertirEstado_Visibilidad('interfaz_parametros_'+cod_listado) ;
 }
//------------------------------------------------------------------------------------------------ 
 function ValidarJS(form, cod_listado) {    
	
	if (form.param_poc_codigo.value=="") {
		alert('Debe seleccionar el código del POC');
		form.param_poc_codigo.focus();
		return false;
	} else 
		return true;
 }
//------------------------------------------------------------------------------------------------ 
