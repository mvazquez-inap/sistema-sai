# Copy to .env. PHP reads these with getenv(). Do not commit .env.
# SAI_DB_HOST is the host string the application uses. Inside this container,
# localhost reaches MariaDB through the socket forwarded to SAI_DB_UPSTREAM.
SAI_DB_HOST=localhost
SAI_DB_USER=
SAI_DB_PASSWORD=
SAI_DB_NAME=sai
SAI_DB_TABGRALES=tabgralessai
SAI_DB_TABGRALES2=tabgrales2
SAI_DB_TABGRALES2_V0=tabgrales2_v0
SAI_DB_TABGRALES2_ETAPS=tabgrales2_etaps
SAI_DB_TABGRALES_SIREPEVA=tabgralessirepeva
SAI_DB_UPSTREAM=host.docker.internal:3311

# Other databases and consoles. Leave passwords empty.
SAI_AFIP_PASSPHRASE=
SAI_ATLINEA_DB=atlinea
SAI_ATLINEA_HOST=localhost
SAI_ATLINEA_PASSWORD=
SAI_ATLINEA_USER=
