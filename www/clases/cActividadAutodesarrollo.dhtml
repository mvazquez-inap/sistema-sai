<?php	} ?>
		</table>	
<?php	
		}	// ok
		return $ok;	
}
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoModificar($act_codigo,$tipoact_codigo,$rolcod) {
	
		// Valida el estado con rol, NO valida si tiene o no dictamen la actividad.	
		if (!$this->TraerDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo,$filaautodesarrollo,$es_modif_act_auto)) 
			return false;
		$txt_sys_mail="\nact_codigo=".$act_codigo;		
		if (!$es_modif_act_auto)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Autodesarrollo a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
		
		if 	($rolcod == USUAUTODESARROLLO)  {
			if ($filaautodesarrollo['actividad_autodesarrollo']['actauto_estado'] == ACTAUTOACTIVO) 
				return true;		
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$filaautodesarrollo['actividad_autodesarrollo']['actauto_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El estado de la Actividad Autodesarrollo (".$descri."), no le permite modificarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;		
			}
		} 
		
		if 	($rolcod == SUPERUSUARIO)
			return true;
		
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar la Actividad Autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}

//-----------------------------------------------------------------------------------------------------	
	function TienePermisoEliminar($act_codigo,$tipoact_codigo,$rolcod) {
	
		// Valida el estado con rol, NO valida si tiene o no dictamen la actividad.	
		if (!$this->TraerDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo,$filaautodesarrollo,$es_modif_act_auto)) 
			return false;
		$txt_sys_mail="\nact_codigo=".$act_codigo;		
		if (!$es_modif_act_auto)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Autodesarrollo a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
		
		if 	($rolcod == USUAUTODESARROLLO)  {
			if ($filaautodesarrollo['actividad_autodesarrollo']['actauto_estado'] == ACTAUTOACTIVO) 
				return true;		
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$filaautodesarrollo['actividad_autodesarrollo']['actauto_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Autodesarrollo (".$descri."), no le permite eliminarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;		
			}
		} 

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para eliminar la Actividad Autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}


//-----------------------------------------------------------------------------------------------------	
	function MostrarDatoActividadAutodesarrollo($conexion,$operacion, $operacion_evento, $filaauto=array(), $tipoact_codigo) {

	$oActividadCurso = new cActividadCurso($conexion);
	$oActividadAutodesarrollo= new cActividadAutodesarrollo($conexion);
	$jurisdicciones	= new jurisdicciones;
	if(!$jurisdicciones->BuscarRaizTipoOrg(TABGRALES_TIPOORG_NAC_EJ,array(),TABGRALES_TS_ARRAY,$nodo_jurisd,array(),$CodError)) {
		$txt_sys_mail="Error buscando la raiz del árbol de jurisdicciones.";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar el organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
	}

	$ok = true;
	$es_evento = false;	
	$jurisdid = "";
	$act_codigo = "";

	if ($operacion=="A") {
	   $es_modif = false;  
	} elseif ($operacion=="M" || $operacion=="V" || $operacion == "E") {   

		   	$es_modif = true;
			 //determino el tipo de actividad a asignar
			$act_codigo = $filaauto['actividad']['act_codigo'];
			$tipoact_origen = "";

			// CURSO
			if (!$oActividadCurso->TraerDatosActividadCurso($act_codigo,$fila_curso,$modif))
				$ok = false;
			if ($modif) {
				$tipoact_origen = TIPOACTCURSOINAP.",".TIPOACTCURSOJURISD.",".TIPOACTCURSOINST;
				$ok = true;
				$operacion="V";			
			}

			if (!$this->TraerDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo,$filaauto,$modif))
				$ok=false;		

			if ($tipoact_codigo == TIPOACTAUTOEVACT || $tipoact_codigo == TIPOACTAUTOEVASIS) {
				$ok = true;
				$es_evento = true;
				$tipoact_origen = $tipoact_codigo;
			}	

	   } else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en la llamada, operación inválida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
	   }
	   
	if ($es_evento) {
	
		$jurisdnom="";
		$ok_evento = true;

		if (!$this->TraerDatosActividadAutodesarrolloEvento($act_codigo,$fila_evento,$es_modif))
			$ok_evento=false;		

		if ($ok_evento) {
			$filaauto['actividad_autodesarrollo_evento'] = $fila_evento['actividad_autodesarrollo_evento'];

		if (isset($filaauto['actividad_autodesarrollo_evento']['orgapri_codigo'])) 
			$sector_org = ORGANISMO_PRIVADO;		
		elseif (isset($filaauto['actividad_autodesarrollo_evento']['jurisdid_apn'])) {

				$tipoorg_codigo = ORGANISMO_APN;
				$sector_org = ORGANISMO_PUBLICO;
				$jurisdid = 'jurisdid_apn';
				
				if ($jurisdicciones->SelectJurisdxID($filaauto['actividad_autodesarrollo_evento']['jurisdid_apn'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError)) 
					$jurisdnom=htmlspecialchars($fila_jurisd[$filaauto['actividad_autodesarrollo_evento']['jurisdid_apn']]['jurisdnom'],ENT_QUOTES);
				else {
					$txt_sys_mail="\njurisdid_apn=".$filaauto['actividad_autodesarrollo_evento']['jurisdid_apn'];
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar el organismo público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					return false;
				}						
				
			} elseif (isset($filaauto['actividad_autodesarrollo_evento']['orgapub_codigo'])) {
					$tipoorg_codigo = ORGANISMO_NO_APN;		
					$sector_org = ORGANISMO_PUBLICO;
					$jurisdid = 'orgapub_codigo';				
					
					$ArregloDatos= array();
					$ArregloDatos['clave']=$filaauto['actividad_autodesarrollo_evento']["orgapub_codigo"];		
		
		
					$oTablaOrganismoPublico= new cTablaOrganismoPublico($this->conexion);
					if (!$oTablaOrganismoPublico->BuscarEnTabla($ArregloDatos,$numfilas,$result,$error,$errormail) || $numfilas!=1 ) {
						$txt_sys_mail="\norgapub_codigo=".$ArregloDatos['clave']."\nerror=".$errormail;
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar el organismo público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
						return false;
					} else {			
						$filaret=mysqli_fetch_assoc($result);			
							$jurisdnom = $filaret['orgapub_nombre'];
					}	
			} else {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, no tiene definido el organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		} // if ($ok_evento)

	}	else  {		// No es modificacion
			$jurisdnom="";
			$jurisdid="jurisdid_apn";
			$tipoorg_codigo = ORGANISMO_APN;
			$sector_org = ORGANISMO_PUBLICO;
	}	// es_evento	
	
		
	if ($ok) {	?>		
		<!-- Datos comunes de actividad -->
		<table width="100%" class="textoTablaDato" align="center" cellpadding="2">
			<tr>
				<td colspan="2" >
					<fieldset class="bordeDetalleRegistro">
					<legend class="textoLeyendaDetalleRegistro">Datos Actividad </legend>
					<table width="100%" class="textoTablaDato" align="center">
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Nombre</td>
						<td class="textoEtiquetaDatoResaltado">
						<textarea cols="100" rows="2" class=<?php echo ($operacion=="V" || $operacion=="E")?"'inputReadonly' readonly='true'":"'textoInput'" ?>  name="act_nombre"  id="act_nombre" onblur="PasarAMayusculas('act_nombre')" style="width:400px" ><?php echo ($es_modif)?htmlspecialchars($filaauto['actividad']['act_nombre'],ENT_QUOTES):""; ?></textarea>
						<input type="hidden" id="act_codigo" name="act_codigo" value="<?php echo $act_codigo ?>"/>
						</td>
					</tr>				
				<?php  if ($es_modif) { ?>
					<tr>
						<td valign="top" width="15%" class='textoEtiqueta'>Código INAP</td>
						<td class="textoEtiquetaDatoResaltado">
						<input type="text" name="act_codinap" id="act_codinap" class="inputReadonly" readonly="readonly" size="21" maxlength="20" value="<?php echo ($es_modif)?htmlspecialchars($filaauto['actividad']['act_codinap'],ENT_QUOTES):""; ?>">
						</td>
					</tr>
				<?php  } ?>					
					
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Observación</td>
						<td class="textoEtiquetaDatoResaltado">
						<textarea cols="100" rows="5" name="act_obs"  id="act_obs" class=<?php echo ($operacion=="V" || $operacion=="E")?"'inputReadonly' readonly='true'":"'textoInput'" ?>  style="width:400px" ><?php echo ($es_modif)?htmlspecialchars($filaauto['actividad']['act_obs'],ENT_QUOTES):"" ?></textarea>
						</td>
