//-----------------------------------------------------------------------------------------------------
	function _AguparDatosPost($datos,&$datos_agrup,$es_modif)	{

		$datos_agrup['actividad']=array('act_codinap'=>$datos['act_codinap'],
										'act_nombre'=>trim($datos['act_nombre']),
										'act_obs'=>$datos['act_obs']);

		if ($es_modif) {
			$datos_agrup['actividad']+=array('act_codigo'=>$datos['act_codigo']);
		} else
			$datos_agrup['actividad']+=array('formact_codigo'=>FORMATOEFORMAL);

		//-------------------------------------------------------------
		$datos_agrup['actividad_eformal']=array(
								  'tipoact_codigo'=>$datos['tipoact_codigo'],
								  'actform_estado'=>ACTPRESDOCACTIVO
							);
		if ($es_modif) 
			$datos_agrup['actividad_eformal']+=array('act_codigo'=>$datos['act_codigo']);
		
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosAltaEducacionFormal($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->_DatosValidosComunesActividadEducacionFormal($datos,$datosvalidados))
		   return false;

		return true;
	}
	
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosEliminarActividadEducacionFormal($act_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoBaja($act_codigo,$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false;
		}

		$error=false;
		$tiene_formato=false;
		
		if (!$this->TieneFormato($act_codigo,FORMATOEFORMAL,$tiene_formato)) {
			$errormail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} 

		if(!$tiene_formato) {
			$errormail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosModifActividadEducacionFormal($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoModificar($datos['act_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false;
		}

		if (!$this->_DatosValidosComunesActividadEducacionFormal($datos,$datosvalidados))
		   return false;

		
		$error=false;
		$tiene_formato=false;
		
		if (!$this->TieneFormato($datos['act_codigo'],FORMATOEFORMAL,$tiene_formato)) {
			$errormail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} 
		
		if(!$tiene_formato) {
			$errormail="\nact_codigo=".$datos['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		$datosvalidados['act_codigo'] = $datos['act_codigo'];
	
		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosComunesActividadEducacionFormal($datos,&$datosvalidados)	{

		$datosvalidados=array();
		
		// Los tipos de actividad deben estar entre los de educación formal

		// Tipo de Actividad							- [tipoact_codigo] 				- [OBLIG]
		$spnombre = "sel_tipo_actividad_xformact_codigo_orden";
		$spparam = array("pformact_codigo"=>FORMATOEFORMAL,"porderby"=>'tipoact_codigo' );
		
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("tipoact_codigo"=>$datos['tipoact_codigo']),$resultado,$filatipoact,$numfilas,$errno) || $numfilas!=1)	
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en el tipo de actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["tipoact_codigo"]=$datos["tipoact_codigo"];

		$datosvalidados["actform_estado"]=$datos["actform_estado"];

		return true;
	}
	
} // class
?>