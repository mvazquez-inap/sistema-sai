<?php class cTablaAreaEspecifica {

	var $conexion;
//--------------------------------------------------------------------------------------------------
	public function __construct($conexion)	{
		$this->conexion = &$conexion;
	}
//--------------------------------------------------------------------------------------------------
	function MostrarGrillaSeleccion($modulo,$area_contextual,$area_general) {

		// Selecciono todos los relacionados
		$spnombre='sel_area_especifica_xareacon_codigo_areagen_codigo';
		$spparam = array('pareacon_codigo'=>$area_contextual, 
						 'pareagen_codigo'=>$area_general, 
						 'porderby'=>"areaesp_descripcion");

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$result,$numfilas,$errno)) {	
			$txt_sys_mail="\nareacon_codigo=".$area_contextual."\nareagen_codigo=".$area_general;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar usuarios.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		}
	
		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
	//		"FilasPagina"=>$numfilas,
			"NombrePaginaQuery"=>"pagina",
			"FilasPagina"=>10
		);
		
		if (isset($_GET['pagina']))	{
			$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
			$opciones['QueryString']=$querystring;
		}
		
		$oGrilla = new cGrilla($opciones);
	
		// $oGrilla->SetearTituloGrilla("Areas Específicas dentro del área contextual y general");
		
		$oGrilla->SetearAnchoGrilla('90%');
		
		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,"Area Específica");
		$oGrilla->Setear('campo_grilla',$miColumna1,"areaesp_descripcion");
		$oGrilla->Setear('align_columna',$miColumna1,'left');
	
		$miColumna2 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Editar');
		$oGrilla->Setear('ancho_columna',$miColumna2,'60');
		$oGrilla->Setear('url',$miColumna2,$modulo);
		$oGrilla->Setear('imagen',$miColumna2,'images/editar.jpg');
		$oGrilla->Setear('altImagen',$miColumna2,'Editar');					
		$oGrilla->AddParametrosURL($miColumna2,"areacon_codigo","areacon_codigo");
		$oGrilla->AddParametrosURL($miColumna2,"areagen_codigo","areagen_codigo");
		$oGrilla->AddParametrosURL($miColumna2,"areaesp_codigo","areaesp_codigo");
		$oGrilla->AddParametrosURL($miColumna2,"operacion","M","cte");
	
		$miColumna3 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Eliminar');
		$oGrilla->Setear('ancho_columna',$miColumna3,'60');
		$oGrilla->Setear('url',$miColumna3,$modulo);
		$oGrilla->Setear('imagen',$miColumna3,'images/borrar.jpg');
		$oGrilla->Setear('altImagen',$miColumna3,'Eliminar');
		$oGrilla->AddParametrosURL($miColumna3,"areacon_codigo","areacon_codigo");
		$oGrilla->AddParametrosURL($miColumna3,"areagen_codigo","areagen_codigo");
		$oGrilla->AddParametrosURL($miColumna3,"areaesp_codigo","areaesp_codigo");
		$oGrilla->AddParametrosURL($miColumna3,"operacion","B","cte");
	
		if (!$oGrilla->CargarGrilla($result))
			return false;
			
		$oGrilla->MostrarGrilla();
	
		return true;
	}
	
//--------------------------------------------------------------------------------------------------
	function ValidarFormSysTabla() {
	?>
 	function ValidarFormSysTabla(formulario,operacion) {
	
			if (formulario.areacon_codigo.value=="")	{
				alert("Debe ingresar el área contextual");
				formulario.areacon_codigo.focus();
				return false;
			}
			if (formulario.areagen_codigo.value=="")	{
				alert("Debe ingresar el área general");
				formulario.areagen_codigo.focus();
				return false;
			}			

			if (operacion=="I"  || operacion=="M") { 		
				if (formulario.areaesp_descripcion.value=="")	{
					alert("Debe ingresar la descripción");
					formulario.areaesp_descripcion.focus();
					return false;
				}
			}		
			return true;
		}
	<?php } 
//---------------------------------------------------------------	
	function AltaSysTabla($datos)	{

		if(!$this->_DatosValidosAlta($datos,$datosvalidados))
			return false;

		$spnombre="sel_area_especifica_max_areaesp_codigo";
		$spparam=array(	'pareacon_codigo'=>$datosvalidados['areacon_codigo'],
						'pareagen_codigo'=>$datosvalidados['areagen_codigo']);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$result,$numfilas,$errorcod))	{
			$txt_sys_mail="\nareacon_codigo=".$datosvalidados['areacon_codigo']."\nareagen_codigo=".$datosvalidados['areagen_codigo'];	
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error al obtener el código de área específica.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
			return false;
		}
		
		if ($numfilas==0)
			$max_codigo=0;
		else {
			$fila=mysqli_fetch_assoc($result);
			$max_codigo=$fila['max_codigo'];
		}
		
		$spnombre="ins_area_especifica";
		$spparam=array(	'pareacon_codigo'=>$datosvalidados['areacon_codigo'],
						'pareagen_codigo'=>$datosvalidados['areagen_codigo'],
						'pareaesp_codigo'=>$max_codigo+1,
						'pareaesp_descripcion'=>$datosvalidados['areaesp_descripcion'],
						'pareaesp_falta'=>date("Y/m/d H:i:s"),
						'pultmodusuario'=>$_SESSION['usuariocod'],
						'pultmodfecha'=>date("Y/m/d H:i:s")
					);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod) || $numfilas!=1)	{
			if($errorcod==MYSQLCLAVEDUP) {
				$txt_sys_mail="\nareaesp_descripcion=".$datosvalidados['areaesp_descripcion'];	
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Ya existe un registro con esa clave.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
			}
			return false;
		}

		return true;
	}
