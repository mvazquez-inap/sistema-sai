</head>
<body>
<script language="javascript" src="<?php echo DIR_JSComunes ?>funcionesjs.js" type="text/javascript"></script>
<script type="text/javascript" language="javascript">
function Validar(formulario) {
	if (!ValidarContenido(document.formulario.pers_apellido.value,"AlfabeticoPuro"))
	{
		alert("El apellido a buscar es inválido");
		document.formulario.pers_apellido.focus();
		return false;	
	}
	if (!ValidarContenido(document.formulario.pers_nombre.value,"AlfabeticoPuro"))
	{
		alert("El nombre a buscar es inválido");
		document.formulario.pers_nombre.focus();
		return false;	
	}

	return true;	
}
</script>	
<br /><div class="textoTitulo" align="left"> Búsqueda de Personas </div><br />
<?php

if (isset($_POST['boton_buscar'])) {
	$_SESSION['array_busqueda_basica_persona']['idtextboxAddValor']=$_POST['destino'];	
	$_SESSION['array_busqueda_basica_persona']['formulario']=$_POST['formulario'];	
	$_SESSION['array_busqueda_basica_persona']['submit']=$_POST['submit'];	
	$_SESSION['array_busqueda_basica_persona']['destino']=$_POST['destino'];	
	$_SESSION['array_busqueda_basica_persona']['accion']=$_POST['accion'];		

	$_SESSION['filtro_busqueda']=array();
	$_SESSION['filtro_busqueda']['pers_cuilt']=$_POST['pers_cuilt'];
	$_SESSION['filtro_busqueda']['pers_apellido']=$_POST['pers_apellido'];
	$_SESSION['filtro_busqueda']['pers_nombre']=$_POST['pers_nombre'];
}			

if (!isset($_SESSION['array_busqueda_basica_persona'])) {
	$_SESSION['array_busqueda_basica_persona']=""; 
	$_SESSION['filtro_busqueda']=array();
}

if(isset($_POST['boton_buscar']) || isset($_GET['pagina']) ) {
	MostrarGrillaSeleccion($conexion,$_SESSION['filtro_busqueda'], $estado_leyenda); ?>	
	<span class="textoDatoBold"><br></span>
	<div align="left" class="textoTablaDatoChico">&nbsp;&nbsp;Nota: Se muestran las personas en estado <?php echo $estado_leyenda ?> que cumplen con el filtro seleccionado.</div>	
	<br /><br /><div align="center"><a href="persona_busq_basica.dhtml" class="linkFondoBlanco">Volver a buscar</a></div>
<?php
} else {
?>
	<form action="persona_busq_basica.dhtml" name="formulario" method="post">
	<table width="100%" class="textoTablaDato" align="center">
		<tr>
			<td width="25%"></td>
			<td width="65%"></td>
		</tr>
		<tr>
			<td class="textoEtiquetaClave">CUIT/CUIL/CDI</td>
			<td class="textoEtiquetaDatoResaltado">	<input type="text" name="pers_cuilt" id="pers_cuilt" class="textoInput" maxlength="11" size="12"></td>
		</tr>
		<tr>
			<td class="textoEtiqueta">Apellido</td>
			<td class="textoEtiquetaDatoResaltado"><input type="text" name="pers_apellido" id="pers_apellido"  onblur="PasarAMayusculas('pers_apellido')" class="textoInput" maxlength="30" size="31"></td>
		</tr>
		<tr>
			<td class="textoEtiqueta">Nombre</td>
			<td class="textoEtiquetaDatoResaltado"><input type="text" name="pers_nombre" id="pers_nombre"  onblur="PasarAMayusculas('pers_nombre')" class="textoInput" maxlength="30" size="31"></td>
		</tr>
		<tr>
			<td colspan="2" height="20"></td>
		</tr>
		<tr align="center">
			<td colspan="2">
				<input type="submit" name="boton_buscar" class="botones" value="Buscar Personas" onClick="return Validar(formulario)">&nbsp;&nbsp;&nbsp;&nbsp;
				<input type="reset" name="boton_limpiar" class="botones" value="Limpiar">
				<input type="hidden" name="submit" value="<?php echo isset($_GET['submit'])?$_GET['submit']:$_SESSION['array_busqueda_basica_persona']['submit']?>">
				<input type="hidden" name="formulario" value="<?php echo isset($_GET['formulario'])?$_GET['formulario']:$_SESSION['array_busqueda_basica_persona']['formulario'] ?>" > 
				<input type="hidden" name="destino" value="<?php echo isset($_GET['destino'])?$_GET['destino']:$_SESSION['array_busqueda_basica_persona']['destino'] ?>" >
				<input type="hidden" name="accion" value="<?php echo isset($_GET['accion'])?$_GET['accion']:$_SESSION['array_busqueda_basica_persona']['accion'] ?>" >				
			</td>
		</tr>
	</table>
	</form>
	<?php
} // se seleccionó buscar 
