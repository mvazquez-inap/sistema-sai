		<?php	} else { ;?>
				<img name="img_<?php echo $idFila?>_estado" src="images/boton_grupo_close.gif" border=0 hspace="1" style="width:15px" alt=""><br>
		<?php } ?>				
	</td> 
 </tr>
<?php } 
