$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oActividadAutodesarrollo= new cActividadAutodesarrollo($conexion);
//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccion($conexion,$ArregloDatos) {

	$spnombre="sel_actividad_autodesarrollo_tipo_actividad_xact_codigo";
	$spparam=array('pact_codigo'=>$ArregloDatos['act_codigo']);
				
	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$result,$numfilas,$errno)) {	
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar los tipos de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
		return false;			
	}
				

	if ($numfilas >=LIMITE_BUSQUEDA_CHICO) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda retornó demasiadas filas, ajuste el criterio de búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}

	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda no retornó resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}
	
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>10
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
	
	$oGrilla = new cGrilla($opciones);

	$oGrilla->SetearTituloGrilla('Tipos asignados para la Actividad Autodesarrollo: ');
	$oGrilla->SetearAnchoGrilla('90%');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Tipo de Actividad');
	$oGrilla->Setear('campo_grilla',$miColumna1,'tipoact_descripcion');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	
	
	$miColumna2 = $oGrilla->AddColumna('linkimg');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Seleccionar');
	$oGrilla->Setear('imagen',$miColumna2,'images/seleccionar.jpg');
	$oGrilla->Setear('altImagen',$miColumna2,'Seleccionar');
	$oGrilla->Setear('url',$miColumna2,'actividad_autodesarrollo_baja.dhtml');
	$oGrilla->AddParametrosURL($miColumna2,"act_codigo","act_codigo");
	$oGrilla->AddParametrosURL($miColumna2,"tipoact_codigo","tipoact_codigo");	
	$oGrilla->AddParametrosURL($miColumna2,"act_codinap_seleccion","act_codigo");	




	$oGrilla->Setear('ancho_columna',$miColumna2,'20%');
	
	if (!$oGrilla->CargarGrilla($result))
		return false;
		
	$oGrilla->MostrarGrilla();
} 		
//----------------------------------------------------------------------------------------- 
