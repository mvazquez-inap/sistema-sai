									<tr>
										<td valign="middle" width="25%" class='textoEtiqueta'>Fecha de Inicio </td>
										<td class="textoEtiquetaDatoResaltado"><input type="text" name="actprog_fecha_inicio" id="actprog_fecha_inicio"  class="inputReadonly" readonly="readonly" size="11"  value="<?php echo FuncionesPHPLocal::ConvertirFecha($filaexterna['actprog_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa'); ?>"></td>
										<td valign="middle" width="25%" class='textoEtiqueta'>Fecha de Finalización</td>
										<td class="textoEtiquetaDatoResaltado"><input type="text" name="actprog_fecha_fin" id="actprog_fecha_fin"  class="inputReadonly" readonly="readonly" size="11"  value="<?php echo FuncionesPHPLocal::ConvertirFecha($filaexterna['actprog_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa'); ?>"></td>
									</tr>				
								</table>	
							</td>
						</tr>
						</table>
					</td>
					</tr>
				</table>
			</fieldset>
		<?php }  // if ok 
		return $ok;
