		return false;
	}
//-----------------------------------------------------------------------------------------------------
	function EvaluarExpedienteActividadCursoJurisdiccional($act_codigo,$operacion,$datos,&$datosvalidados) {

		// Es la unica validación que se hace por eso no va a un Validar
		if (!$this->TienePermisoEvaluarExpediente($act_codigo,$_SESSION['rolcod'],$_SESSION['jurisdid_inap']))
			return false;

		// Nota: la carga del expediente lo dejamos para que lo ingrese cuando dictamine.
		if ($operacion == "A") {
			$estado = ACTCURSOACTIVO;
		} else {
			$estado = ACTCURSORECHAZADO;
		}

		$spnombre="upd_actividad_curso_cambio_estado_xact_codigo";
		$spparam=array(
			'pactcur_estado'=>$estado,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'pact_codigo'=> $act_codigo
			);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al ejecutar la evaluación del expediente con la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if( trim($datos['aclaracion_mail']) != "") {

			// Ver si cambio por traer solo historial
			if (!$this->TraerDatosActividadCursoJurisdiccional($act_codigo, $fila_actividad, $es_modif) )
				return false;

			$txt_sys_mail="\nact_codigo=".$act_codigo;
			if (!$es_modif)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, no existe la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}

			$spnombre="upd_actividad_curso_diseno_jurisdiccional_hist_evaluacion";
			$spparam=array(
				'pactdisjurisd_hist_evaluacion'=>($fila_actividad['actividad_curso_jurisdiccional']['actdisjurisd_hist_evaluacion']."\n----------- ".
										date("Y/m/d H:i:s")." ----------\n\n".
										$datos['aclaracion_mail']."\n"),
				'pultmodusuario'=>$_SESSION['usuariocod'],
				'pultmodfecha'=> date("Y/m/d H:i:s"),
				'pact_codigo'=>$act_codigo
			);

			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
			{
				$txt_sys_mail="Actualizando el historial de evaluaciones de \nact_codigo=".$act_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar el historial de la actividad. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}	// if hay datos aclaratorios

		return true;
	}

