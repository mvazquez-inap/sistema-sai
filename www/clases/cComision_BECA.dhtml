//-----------------------------------------------------------------------------------------------------	
function DatosValidosCertificarComisionViejo($datos,&$datosvalidados,&$hay_otros_errores) {

	// 	El usuario tiene permiso de certicar la comisión y la comisión tiene que estar cerrada
	if (!$this->TienePermisoCertificar($datos['comi_codigo'],$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) 
		return false; 

	// Busco los datos de la comision.
	$ArregloDatos=array("comi_codigo"=>$datos['comi_codigo'],"comi_estado"=>COMISIONCERRADA);	
	if(!$this->BuscarComision($ArregloDatos,$numfilas,$resulcomi,$error,$errormail)) {
		$txt_sys_mail="Error al buscar para la comisión CERRADA - \ncomi_codigo=".$datos['comi_codigo'];
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	} elseif ($numfilas!=1) {
		$txt_sys_mail="Hay cero o más de un registros para la comisión (si fue seleccionada debería poder abrirse)\ncomi_codigo=".$datos['comi_codigo'];
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la comisión no permite su certificación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	} 
	$fila_comision=mysqli_fetch_assoc($resulcomi);
	
	// La actividad de la comisión tiene que tener dictamen aprobado con disposición
	$ArregloDatos= array();
	$ArregloDatos['act_codigo'] = $fila_comision["act_codigo"];
	$ArregloDatos['actprog_sec'] = $fila_comision["actprog_sec"];
	$ArregloDatos['dic_estado'] = DICTAMENACTIVO;
	$ArregloDatos['formact_codigo'] = FORMATOCURSO;
	$ArregloDatos['con_disposicion'] = 1;				

	$oActividad = new cActividadCurso($this->conexion);
	if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;								
	}	
	if($numfilas!=1) {
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión no puede ser certificada hasta que <br> el dictamen de la actividad este aprobado y tenga disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;								
	}

	$datosvalidados = array();
	$datosvalidados['comi_codigo']=$datos['comi_codigo'];
	// tiene un POC asociado a la actividad		
	if ($oActividad->EsActividadCursoTipo($fila_comision["act_codigo"],TIPOACTCURSOJURISD,$error,$errormsg)) {
		if (!$this->ValidarActividadPoc($datos['comi_codigo'],$_SESSION['jurisdid_inap'])) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión no puede ser certificada pues la actividad <br> no esta asociada al POC del año de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false; 			
		}
	}
		
	$hay_otros_errores= false;		// Errores de inscriptos

	// La comisión tiene todos sus alumnos con evaluación
	$ArregloDatos= array();
	$ArregloDatos['comi_codigo'] = $datos['comi_codigo'];
	$ArregloDatos['eval_codigo'] = EVALCURSANDO;		// Unico estado no final es cursando 

	$oComisionPersona = new cComisionPersona($this->conexion);
	if (!$oComisionPersona->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)) {
		$txt_sys_mail="\nvalor_buscado_".$datos['comi_codigo']."\nerror=".$errormail;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscriptos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false; 
	}			
	
	if ($numfilas>0) {
		$hay_otros_errores = true;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Existen personas inscriptas en la comisión que no tienen el resultado cargado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	}

	// Los inscriptos a la comisión no deben tener acreditada la actividad
	
	// Obtengo todos los inscriptos de la comisión
	$ArregloDatos= array();
	$ArregloDatos['comi_codigo'] = $datos['comi_codigo'];
	if (!$oComisionPersona->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)) {
		$txt_sys_mail="\nvalor_buscado_".$datos['comi_codigo']."\nerror=".$errormail;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscriptos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false; 
	}			

	$ArregloDatos = array();
	$ArregloDatos['act_codigo'] = $fila_comision['act_codigo'];		

	$error_acreditada = false;
	$error_acreditada_autodesarrollo = false;
		
	// Ver si tiene la actividada esa persona en otro formato										
	while ($fila_inscripto=mysqli_fetch_assoc($result)) {
				
		// Busco si ya la tiene certificada x otra comision (ACTIVIDAD CURSO)
		$ArregloDatos['pers_codigo'] = $fila_inscripto['pers_codigo'];
		if (!$oComisionPersona->BuscarActividadPersonaCertificada($ArregloDatos,$numfilas,$resultComiPers,$error,$errormail)) {
			$txt_sys_mail="\nvalor_buscado_".$datos['comi_codigo']."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscriptos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false; 
		}
		if ($numfilas!=0) {
			$hay_otros_errores = true;
			$error_acreditada = true;
		}

		// Busco si ya la tiene certificada x otro formato (ACTIVIDAD AUTODESARROLLO)
		$oActividadAutodesarrolloPersona = new cActividadAutodesarrolloPersona($this->conexion);
		if(!$oActividadAutodesarrolloPersona -> BuscarActividadPersonaCertificada($ArregloDatos, $numfilasAuto, $resultAuto, $error, $errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} 

		if ($numfilasAuto != 0) {
			$error_acreditada_autodesarrollo = true;
			$hay_otros_errores = true;
		}
	} // while

	if ($error_acreditada) 	 
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Alguna de las personas inscriptas ya tienen acreditada la actividad.<br> Deberá eliminarla para poder certificar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

	if ($error_acreditada_autodesarrollo) 	 
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Alguna de las personas inscriptas ya tienen acreditada <br>la actividad con formato Autodesarrollo.<br> Deberá eliminarla para poder certificar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

	if ($hay_otros_errores) 
		return false;
	
	return true;
}
//-----------------------------------------------------------------------------------------------------	
function ValidarActividadPoc ($comi_codigo,$jurisdid_inap) {
		
		// obtener las fechas de la comisión
		if (!$this->TraerDatosComision($comi_codigo,$fila_comi,$es_modif)) 
			return false;

		$txt_sys_mail="\comi_codigo=".$comi_codigo;			
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la comisión a certificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
	
		$comi_fecha_inicio = $fila_comi['comi_fecha_inicio'];
	
		// obtener todos los poc de la jurisdicción del usuario logeado asociados a la actividad de la comisión 
	
		$spnombre="sel_poc_actividad_actividad_xact_codigo_jurisdid";	
		$spparam=array(	'pact_codigo'=>$fila_comi['act_codigo'],
						'pjurisdid_inap'=>$jurisdid_inap);

		if(!($this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))) {
			$errormail="\ncomi_codigo=".$comi_codigo."\nact_codigo=".$fila_comi['act_codigo']."\njurisdid_inap=".$jurisdid_inap."\nerror=".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar los poc asociados a la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}

		// determinar si la fecha de inicio de la comisión está incluida en algún POC seleccionado
		$pertenece = false;
		while (($fila_poc = mysqli_fetch_assoc($resultado)) && !$pertenece) {
			if (substr($comi_fecha_inicio,0,4)==$fila_poc['poc_ano'])
				$pertenece = true;	
		}
		
	
	return $pertenece;
}	

//-----------------------------------------------------------------------------------------------------	
	function TienePermisoBaja($comi_codigo,$rolcod,$jurisdid) {
		return ($this->TienePermisoModificar($comi_codigo,$rolcod,$jurisdid));
	}
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoModificar($comi_codigo,$rolcod,$jurisdid) {

		// Valida el estado con rol y la jurisdicción
		if (!$this->TraerDatosComision($comi_codigo,$fila_comi,$es_modif)) 
			return false;

		$txt_sys_mail="\comi_codigo=".$comi_codigo;			
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la comisión a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 

	 if($rolcod==SUPERUSUARIO){
	
					if($fila_comi['comi_estado']==COMISIONCERTIFICADA){
					$titulo = "Modificar Comision Certificada";
					}
					if($fila_comi['comi_estado']==COMISIONCERRADA){
					$titulo = "Modificar Comision Cerrada";
					}
					if($fila_comi['comi_estado']==COMISIONNUEVA){
					$titulo = "Comision Nueva";
					}
					if($fila_comi['comi_estado']==COMISIONABIERTA){
					$titulo = "Modificar Comision Abierta";
					}
					
			  ?> 
			  <br />
			  <div align="center" style="font-weight:bold; color:#666666">
				  <?php echo "$titulo"?>
			  </div> 
			  <br />
			  
		<?php	 
		  if($fila_comi['comi_estado']==COMISIONCERTIFICADA || $fila_comi['comi_estado']==COMISIONCERRADA){
				$numfilas=0;
				$ArregloDatos = array();
				$ArregloDatos['comi_estado']=COMISIONCERTIFICADA.",".COMISIONCERRADA;
				$ArregloDatos['act_codigo']=$fila_comi['act_codigo'];
				$ArregloDatos['comi_codigo']=$fila_comi['comi_codigo'];
		    }else{
					$ArregloDatos = array();
					$ArregloDatos['comi_estado']=COMISIONNUEVA.",".COMISIONABIERTA;
					$ArregloDatos['act_codigo']=$fila_comi['act_codigo'];
					$ArregloDatos['comi_codigo']=$fila_comi['comi_codigo'];
			}//cierre del else			
		
	 }// cierre del if
			
			
		if($rolcod!=SUPERUSUARIO){
			if (($fila_comi['comi_estado'] != COMISIONNUEVA) && 
				($fila_comi['comi_estado'] != COMISIONABIERTA) ) {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","COMISIONESTADO","' and constantecod='",$fila_comi['comi_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El estado de la Comisión (".$descri."), no le permite realizar la operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}

		if($rolcod!=SUPERUSUARIO){
			$numfilas=0;
			$ArregloDatos = array();
			$ArregloDatos['comi_estado']=COMISIONNUEVA.",".COMISIONABIERTA;
			$ArregloDatos['act_codigo']=$fila_comi['act_codigo'];
			$ArregloDatos['comi_codigo']=$fila_comi['comi_codigo'];
		}
		if 	($rolcod == USUCURSOINAP )  { //  Si la actividad de la comision es curso INAP esta todo OK.
			$ArregloDatos['tipoact_codigo']=TIPOACTCURSOINAP;
		} elseif ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO) {  //  Si la actividad de la comision es curso de la jurisdiccion del usuario logueado esta OK.
			$ArregloDatos['jurisdid_inap']=$_SESSION['jurisdid_inap'];
 			$ArregloDatos['tipoact_codigo']=TIPOACTCURSOJURISD;
		} 
		
		if(!$this->BuscarComisionAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al verificar el acceso el acceso a al comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;	
		}
		if ($numfilas == 1) 
			return true;	

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}	
