<?php 
require('./include.dhtml');
$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
$oDictamen=new cDictamen($conexion);
//----------------------------------------------------------------------------------------- 
switch ($_SESSION['rolcod']) {
	case SUPERUSUARIO:
		$oActividad= new cActividadCursoJurisdiccional($conexion);
		$tipoact_codigo=TIPOACTCURSOJURISD;
		$formact_codigo=FORMATOCURSO;		
		$estado_activo=ACTCURSOACTIVO;
		break;

}
// Defino los dictamenes a los que tiene acceso
$filaactividad=array();
$filaactividad['act_codinap']=(isset($_POST['act_codinap_seleccion']))?$_POST['act_codinap_seleccion']:"";
$filaactividad['act_codigo']=(isset($_POST['act_codigo']))?$_POST['act_codigo']:"";



if (isset($_POST['act_codinap_seleccion'])) {
	if($conexion->TraerCampo("actividad","act_codigo",array("act_codinap='",$_POST['act_codinap_seleccion'],"'"),$act_codigo,$numfilas,$errno))
		$filaactividad['act_codigo']=htmlspecialchars($act_codigo,ENT_QUOTES);
}

$destino_formulario_interface="actividad_dictaminar_programacion_jurisdiccional_modificar.dhtml";

?>
<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oActividad->PedirActividad($filaactividad['act_codinap'],'formulario_seleccion','act_codinap_seleccion','ModificarDictaminar'); ?></td>
	</tr>
	</table>
</form>	

<?php
$ok=true;

if ($filaactividad['act_codigo']=="") {
	if (isset($_POST['act_codigo']) || isset($_POST['act_codinap_seleccion']) )
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
} else {

	// Hay que chequear que la actividad tenga el formato esperado.	
	if (!$oActividad->TieneFormatoTipo($filaactividad['act_codigo'],$formact_codigo,$tipoact_codigo,$tiene_formato_tipo)) {
	
		$txt_sys_mail="Error al determinar el formato - tipo de la actividad.\nact_codigo=".$filaactividad['act_codigo'];
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al dictaminar actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		$ok=false;		
	
	} elseif (!$tiene_formato_tipo && $_SESSION['rolcod'] != SUPERUSUARIO) {
	
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok=false;		
	
	} else {

		$oDictamen= new cDictamen($conexion);
		// Obtengo datos basicos de la actividad y la programacion
		if ( ($oDictamen->ObtenerDatosParaModificarDictamen($conexion,$oActividad,
						$filaactividad['act_codigo'],
						$tipoact_codigo,$operacion_dictamen,$operacion_programacion,
						$fila_ultimo_dictamen,$fila_detalle,$fila_dictamen_editable))) {
		
			// Hay por lo menos 1 dictamente - $operacion_dictamen!="A"
			if( ($operacion_dictamen!="A") && $fila_ultimo_dictamen['dic_estado']==DICTAMENPENDIENTEAPROBACION) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El último dictamen de la actividad esta pendiente de aprobación.<br> No puede redictaminar hasta tanto se evalúe el dictamen anterior.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok=false;								
			} elseif ($fila_detalle['act_estado']!=$estado_activo && $_SESSION['rolcod'] != SUPERUSUARIO) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El estado de la actividad no permite actualizar el dictamen",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok=false;								
			} elseif ($_SESSION['rolcod']==USUACTJUR && $fila_detalle['jurisdid_inap']!=$_SESSION['jurisdid_inap']) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Ud. no tiene acceso a dictaminar la actividad seleccionada.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok=false;								
			} else {
				?><form action="<?= "actividad_dictaminar_programacion_upd.dhtml" ?>" method="post" name="formulario"><?php	

					
					$ok = $oDictamen->MostrarDatosDictamenProgramacion( $conexion,$oActividad,$fila_detalle,
															$operacion_dictamen,$operacion_programacion,
															$fila_ultimo_dictamen);
	
					if ($ok) { ; ?>
						<table width="100%" class="textoTablaDato" align="center">
							<tr align="center">
								<td> <?php
									if (isset($operacion_programacion) && $operacion_programacion=="M" ) {
								?>		<input type="submit" name="boton_actualizar" value="Actualizar"  onClick="return (ValidarFormDictamen(formulario,'M')  &amp;&amp; ValidarFormProgramacion(formulario,'M') );" class="botones"  />
										<input type="submit" name="boton_eliminar" value="Eliminar"   onClick="return (ValidarFormDictamen(formulario,'E') &amp;&amp; ValidarFormProgramacion(formulario,'E') );" class="botones" />
								<?php	} else  { ?>
										<input type="submit" name="boton_alta" value="Agregar" onClick="return (ValidarFormDictamen(formulario,'A') &amp;&amp; ValidarFormProgramacion(formulario,'A') ); " class="botones" />
									<?php } ?>
									<input type="hidden" name="operacion_dictamen" id="operacion_dictamen" value="<?php echo $operacion_dictamen; ?>" />
									<input type="hidden" name="operacion_programacion" id="operacion_programacion" value="<?php echo $operacion_programacion; ?>" />
									<input type="hidden" name="act_codigo" id="act_codigo" value="<?php  echo (isset($fila_detalle['act_codigo']))?$fila_detalle['act_codigo']:"";  ?>" />				  
									<input type="hidden" name="actprog_sec" id="actprog_sec" value="<?php echo (isset($fila_ultimo_dictamen['actprog_sec']))?$fila_ultimo_dictamen['actprog_sec']:""?>" />				  
									<input type="hidden" name="dic_codigo" id="dic_codigo" value="<?php  echo (isset($fila_ultimo_dictamen['dic_codigo']))?$fila_ultimo_dictamen['dic_codigo']:"";  ?>" />				  
								</td>
							</tr>
						</table>		
	<?php 				}  // ok ?>
				</form> 
<?php			} // 
		} else { 

			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok=false;	
				
		} // Obtencion de datos del dictamen
	}	// !$oActividad->TieneFormatoTipo
} // $filaactividad['act_codigo']==""
$oEncabezados->PieMenuEmergente(); 
?>