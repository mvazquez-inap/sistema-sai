	MostrarCursando($conexion,$array_errores['inscriptos_cursando']);
}
echo "<br><br><br>";	
if(isset($array_errores['inscriptos_ya_acreditados'])) {
	MostrarAcreditados($conexion,$array_errores['inscriptos_ya_acreditados']);
}
