						$borde = " style=\"border:none;\"";

					$querystring = FuncionesPHPPortal::ArmarQueryString("");
					$texto = ObetenerTextoMes($i);
					$seleccionado = " ";
					if (isset($this->mes) && $this->mes!="" && $this->mes==$i)
						$seleccionado = " class=\"seleccionado\"";

