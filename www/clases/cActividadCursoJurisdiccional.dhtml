<?php
//-----------------------------------------------------------------------------------------
class cActividadCursoJurisdiccional extends cActividadCurso {

	public function __construct($conexion) {
		parent::__construct($conexion);
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,&$datosresult,&$es_modif) {

		if (!$this->TraerDatosActividadCursoJurisdiccional($act_codigo,$datosresult_detalle,$es_modif)) {
			return false;
		} else {
			$datosresult['act_codigo']=$datosresult_detalle['actividad']['act_codigo'];
			$datosresult['act_formato']=FORMATOCURSO;
			$datosresult['tipoact_codigo']=TIPOACTCURSOJURISD;
			$datosresult['act_nombre']=$datosresult_detalle['actividad']['act_nombre'];
			$datosresult['act_codinap']=$datosresult_detalle['actividad']['act_codinap'];
			$datosresult['act_duracionhs']=$datosresult_detalle['actividad_curso_jurisdiccional']['actdisjurisd_duracionhs'];
			$datosresult['act_estado']=$datosresult_detalle['actividad_curso']['actcur_estado'];
			$datosresult['act_creditos']=$datosresult_detalle['actividad_curso']['actcur_creditos'];
			$datosresult['jurisdid_inap']=$datosresult_detalle['actividad_curso']['jurisdid_inap'];
			return true;
		}
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadCursoJurisdiccional($act_codigo,&$datosresult,&$es_modif) {

		// Si se hay error al ejecutar algún SQL retorna error, sino si no encuentra
		// la actividad o la actividad curso no es Curso Jurisdiccional, retorna que es_modif=false
		// pues no se encontro una actividad curso inap con el codigo enviado

		$datosresult=array();
		$es_modif = false;

		if (!$this->TraerDatosActividad($act_codigo,$result_actividad,$es_modif_act))
			return false;

		if ($es_modif_act) {

			$datosresult['actividad']=$result_actividad; // Datos de la actividad

			if (!$this->TraerDatosActividadCurso($act_codigo,$result_actividad_curso,$es_modif_act_curso))
				return false;

			if ($es_modif_act_curso) { // Datos de la actividad curso

				$datosresult['actividad_curso']=$result_actividad_curso;

				// Verifico que sea una actividad curso Institucional
				if ($datosresult['actividad_curso']['tipoact_codigo'] != TIPOACTCURSOJURISD) {
					$es_modif=false;
				}

				$sparam=array('pact_codigo'=>$act_codigo);
				$spnombre="sel_actividad_curso_diseno_jurisdiccional_xact_codigo";
				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
				{
					$errormail="\nact_codigo".$act_codigo;
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
				if ($numfilas == 1)	{
					$datosresult['actividad_curso_jurisdiccional']= mysqli_fetch_assoc($resultado);
					$es_modif = true;
				}
			} // $es_modif_act_curso
		} // $es_modif_act

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function AltaDatosActividadCursoJurisdiccional($datos,&$act_codigo_nuevo,&$act_codinap) {

		$datosvalidados=array();
		$this->_AguparDatosPost($datos,$datos_agrup,false);

		$datoscurso['actividad']=$datos_agrup['actividad'];
		$datoscurso['actividad_curso']=$datos_agrup['actividad_curso'];

		if(!$this->AltaDatosActividadCurso($datoscurso,$act_codigo_nuevo,$act_codinap))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38101","act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);

		if(!$this->_DatosValidosAltaActividadCursoJurisdiccional($datos_agrup['actividad_curso_jurisdiccional'],$datosvalidados))
			return false;

		$spnombre="ins_actividad_curso_diseno_jurisdiccional";
		$spparam=array('pact_codigo'=>$act_codigo_nuevo,
					  'pactdisjurisd_fundamentacion'=>$datosvalidados['actdisjurisd_fundamentacion'],
					  'pactdisjurisd_contribucion'=>$datosvalidados['actdisjurisd_contribucion'],
					  'pactdisjurisd_perfil'=>$datosvalidados['actdisjurisd_perfil'],
					  'pactdisjurisd_objetivos'=>$datosvalidados['actdisjurisd_objetivos'],
					  'pactdisjurisd_contenido'=>$datosvalidados['actdisjurisd_contenido'],
					  'pactdisjurisd_modaldesc'=>$datosvalidados['actdisjurisd_modaldesc'],
					  'pactdisjurisd_eval'=>$datosvalidados['actdisjurisd_eval'],
					  'pactdisjurisd_evalinstru'=>$datosvalidados['actdisjurisd_evalinstru'],
					  'pactdisjurisd_requiaprobacion'=>$datosvalidados['actdisjurisd_requiaprobacion'],
					  'pactdisjurisd_duracionhs'=>$datosvalidados['actdisjurisd_duracionhs'],
					  'pactdisjurisd_duraciondetalle'=>$datosvalidados['actdisjurisd_duraciondetalle'],
					  'pactdisjurisd_cronogramatentativo'=>$datosvalidados['actdisjurisd_cronogramatentativo'],
					  'pactdisjurisd_lugar'=>$datosvalidados['actdisjurisd_lugar'],

  					  'pactdisjurisd_metodologia'=>$datosvalidados['actdisjurisd_metodologia'],
					  'pactdisjurisd_bibliografia'=>$datosvalidados['actdisjurisd_bibliografia'],
					  'pactdisjurisd_perfil_instructor'=>$datosvalidados['actdisjurisd_perfil_instructor'],

					  'pactdisjurisd_planrecursos'=>$datosvalidados['actdisjurisd_planrecursos'],
					  'pactdisjurisd_plancontenidos'=>$datosvalidados['actdisjurisd_plancontenidos'],
					  'pactdisjurisd_planestrategias'=>$datosvalidados['actdisjurisd_planestrategias'],

					  'pactdisjurisd_origen'=>$datosvalidados['actdisjurisd_origen'],

		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad Curso Jurisdiccional.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function EliminarDatosActividadCursoJurisdiccional($act_codigo) {

		if(!$this->_DatosValidosEliminarActividadCursoJurisdiccional($act_codigo,$datosvalidados))
			return false;

		if(!$this->_BajaCascada($datosvalidados['act_codigo']))
				return false;

		$spnombre="del_actividad_curso_diseno_jurisdiccional";
		$spparam=array('pact_codigo'=>$act_codigo);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la Actividad Curso Jurisdiccional.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if(!$this->EliminarDatosActividadCurso($act_codigo))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38102","act_codigo=".$act_codigo,$_SESSION['usuariocod']);

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function ModifDatosActividadCursoJurisdiccional($datos)	{

		$this->_AguparDatosPost($datos,$datos_agrup,true);

		$datoscurso['actividad']=$datos_agrup['actividad'];
		$datoscurso['actividad_curso']=$datos_agrup['actividad_curso'];

		if(!$this->ModifDatosActividadCurso($datoscurso))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38103","act_codigo=".$datos_agrup['actividad']['act_codigo'],$_SESSION['usuariocod']);

		if(!$this->_DatosValidosModifActividadCursoJurisdiccional($datos_agrup['actividad_curso_jurisdiccional'],$datosvalidados))
			return false;

		$spnombre="upd_actividad_curso_diseno_jurisdiccional";
		$spparam=array('pact_codigo'=>$datosvalidados['act_codigo'],
					  'pactdisjurisd_fundamentacion'=>$datosvalidados['actdisjurisd_fundamentacion'],
					  'pactdisjurisd_contribucion'=>$datosvalidados['actdisjurisd_contribucion'],
					  'pactdisjurisd_perfil'=> $datosvalidados['actdisjurisd_perfil'],
					  'pactdisjurisd_objetivos'=>$datosvalidados['actdisjurisd_objetivos'],
					  'pactdisjurisd_contenido'=>$datosvalidados['actdisjurisd_contenido'],
					  'pactdisjurisd_modaldesc'=>$datosvalidados['actdisjurisd_modaldesc'],
					  'pactdisjurisd_eval'=>$datosvalidados['actdisjurisd_eval'],
					  'pactdisjurisd_evalinstru'=>$datosvalidados['actdisjurisd_evalinstru'],
					  'pactdisjurisd_requiaprobacion'=>$datosvalidados['actdisjurisd_requiaprobacion'],
					  'pactdisjurisd_duracionhs'=>$datosvalidados['actdisjurisd_duracionhs'],
					  'pactdisjurisd_duraciondetalle'=>$datosvalidados['actdisjurisd_duraciondetalle'],
					  'pactdisjurisd_cronogramatentativo'=>$datosvalidados['actdisjurisd_cronogramatentativo'],
					  'pactdisjurisd_lugar'=>$datosvalidados['actdisjurisd_lugar'],
   					  'pactdisjurisd_metodologia'=>$datosvalidados['actdisjurisd_metodologia'],
					  'pactdisjurisd_bibliografia'=>$datosvalidados['actdisjurisd_bibliografia'],
					  'pactdisjurisd_perfil_instructor'=>$datosvalidados['actdisjurisd_perfil_instructor'],

					  'pactdisjurisd_planrecursos'=>$datosvalidados['actdisjurisd_planrecursos'],
					  'pactdisjurisd_plancontenidos'=>$datosvalidados['actdisjurisd_plancontenidos'],
					  'pactdisjurisd_planestrategias'=>$datosvalidados['actdisjurisd_planestrategias'],

					  'pactdisjurisd_origen'=>$datosvalidados['actdisjurisd_origen'],

					  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\nact_codigo='.$datosvalidados['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la Actividad Curso Jurisdiccional.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}

//-----------------------------------------------------------------------------------------------------
	function _BajaCascada($act_codigo) {

		// elimino todas las relaciones ActPoc / Act

		// busco todas las relaciones
		$oPocActividadActividad = new cPocActividadActividad($this->conexion);
		$filtro = array('act_codigo'=>$act_codigo,
						'orderby'=>'poc_codigo'
						);

		if (!$oPocActividadActividad->BuscarPocActividadActividad($filtro,$numfilas,$result_act_asignadas,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		// por cada relación -> la elimino
		while ($fila_act = mysqli_fetch_assoc($result_act_asignadas)) {

			if($oPocActividadActividad->BajaDatosPocActividadActividad($fila_act)) {
				FuncionesPHPLocal::RegistrarAcceso($this->conexion,"37402","operacion=baja"."\npocact_codigo=".$fila_act['pocact_codigo']."\nact_codigo=".$fila_act['act_codigo'],$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha eliminado la asignación de la Actividad Curso a la Actividad POC ".$fila_act['pocact_nombre_tentativo'],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else
				return false;

		}

		return true;
	}


//-----------------------------------------------------------------------------------------------------
	function ValidarFormAltaActividadCursoJurisdiccional() {

	// Incluir las validaciones javascript de las 3 tablas.
	$this->ValidarFormAltaActividad();
	$this->ValidarFormAltaActividadCurso();
?>
	function ValidarFormAltaActividadCursoJurisdiccional(formulario,operacion) {

			// Fundamentación 					- [actdisjurisd_fundamentacion] 	- [OBLIG]
			if ((trim(formulario.actdisjurisd_fundamentacion.value)=="")) {
				alert("Debe ingresar la fundamentación");
				formulario.actdisjurisd_fundamentacion.focus();
				return false;
			}

			// Contribución esperada 			- [actdisjurisd_contribucion] 	- [OBLIG]
			if ((trim(formulario.actdisjurisd_contribucion.value)=="")) {
				alert("Debe ingresar la contribución esperada");
				formulario.actdisjurisd_contribucion.focus();
				return false;
			}

			// Perfil del participante 			- [actdisjurisd_perfil] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_perfil.value)=="")) {
				alert("Debe ingresar el perfil del participante");
				formulario.actdisjurisd_perfil.focus();
				return false;
			}

			// Objetivos 						- [actdisjurisd_objetivos] 		- [OBLIG]
			if ((trim(formulario.actdisjurisd_objetivos.value)=="")) {
				alert("Debe ingresar los objetivos");
				formulario.actdisjurisd_objetivos.focus();
				return false;
			}

			// Contenido 						- [actdisjurisd_contenido] 		- [OBLIG]
			if ((trim(formulario.actdisjurisd_contenido.value)=="")) {
				alert("Debe ingresar el contenido");
				formulario.actdisjurisd_contenido.focus();
				return false;
			}

			// Metodologia							- [actdisjurisd_metodologia] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_metodologia.value)=="")) {
				alert("Debe ingresar las estrategias metodológicas y recursos didácticos.");
				formulario.actdisjurisd_metodologia.focus();
				return false;
			}

			// Descripción de la modalidad 		- [actdisjurisd_modaldesc] 		- [OBLIG]
			if ((trim(formulario.actdisjurisd_modaldesc.value)=="")) {
				alert("Debe ingresar la modalidad");
				formulario.actdisjurisd_modaldesc.focus();
				return false;
			}

			// Bibliografia							- [actdisjurisd_bibliografia] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_bibliografia.value)=="")) {
				alert("Debe ingresar la bibliografía");
				formulario.actdisjurisd_bibliografia.focus();
				return false;
			}

			// Evaluación de los aprendizajes 	- [actdisjurisd_eval] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_eval.value)=="")) {
				alert("Debe ingresar la evaluación de los aprendizajes");
				formulario.actdisjurisd_eval.focus();
				return false;
			}

			// Instrumentos para la evaluación 	- [actdisjurisd_evalinstru] 		- [OPCIONAL]

			// Requisitos de Asistencia y aprobación			- [actdisjurisd_requiaprobacion] 	- [OBLIG]
			if ((trim(formulario.actdisjurisd_requiaprobacion.value)=="")) {
				alert("Debe ingresar los requierimientos de aprobación");
				formulario.actdisjurisd_requiaprobacion.focus();
				return false;
			}

			// Duración	en hs. - [actdisjurisd_duracionhs] 	- [OBLIG]
			if (!ValidarContenido(formulario.actdisjurisd_duracionhs.value,'NumericoEntero') ) {
				alert("La duración en hs. debe ser un número entero");
				formulario.actdisjurisd_duracionhs.focus();
				return false;
			}
			if (formulario.actdisjurisd_duracionhs.value<=0) {
				alert("La duración en hs. debe ser mayor que cero");
				formulario.actdisjurisd_duracionhs.focus();
				return false;
			}

			// Detalle sobre la duración	 	- [actdisjurisd_duraciondetalle] 	- [OBLIG]
			if ((trim(formulario.actdisjurisd_duraciondetalle.value)=="")) {
				alert("Debe ingresar la duración");
				formulario.actdisjurisd_duraciondetalle.focus();
				return false;
			}

			// Cronograma tentativo	 	- [actdisjurisd_cronogramatentativo] 	- [OBLIG]
			if ((trim(formulario.actdisjurisd_cronogramatentativo.value)=="")) {
				alert("Debe ingresar el Cronograma tentativo");
				formulario.actdisjurisd_cronogramatentativo.focus();
				return false;
			}

			// Lugar 							- [actdisjurisd_lugar] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_lugar.value)=="")) {
				alert("Debe ingresar el lugar");
				formulario.actdisjurisd_lugar.focus();
				return false;
			}

			// Perfil del instructor				- [actdisjurisd_perfil_instructor] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_perfil_instructor.value)=="")) {
				alert("Debe ingresar el perfil del instructor");
				formulario.actdisjurisd_perfil_instructor.focus();
				return false;
			}

            /*
			// Plan de Clase - Recursos				- [actdisjurisd_planrecursos] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_planrecursos.value)=="")) {
				alert("Debe ingresar el Plan de Clase - Recursos");
				formulario.actdisjurisd_planrecursos.focus();
				return false;
			}

			// Plan de Clase - Contenidos				- [actdisjurisd_plancontenidos] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_plancontenidos.value)=="")) {
				alert("Debe ingresar el Plan de Clase - Contenidos");
				formulario.actdisjurisd_plancontenidos.focus();
				return false;
			}

			// Plan de Clase - Estrategias				- [actdisjurisd_planestrategias] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_planestrategias.value)=="")) {
				alert("Debe ingresar el Plan de Clase - Estrategias");
				formulario.actdisjurisd_planestrategias.focus();
				return false;
			}
			*/

			// Origen				- [actdisjurisd_origen] 			- [OBLIG]
			if ((trim(formulario.actdisjurisd_origen.value)=="")) {
				alert("Debe ingresar el Origen de la demanda");
				formulario.actdisjurisd_origen.focus();
				return false;
			}
			return true;
		}
<?php }
//-----------------------------------------------------------------------------------------------------
	function BuscarActividadCursoJurisdiccional($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{
		echo "(Falta) Funcion: BuscarActividadCursoJurisdiccional <br>";
