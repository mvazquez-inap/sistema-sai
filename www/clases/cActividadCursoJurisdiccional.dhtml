	function MostrarDatosActividadCursoJurisdiccional($conexion,$operacion,$filacurso=array()) {

	// si queda esta opcion no mandar la conexion
	if ($operacion=="A") {
	   $es_modif = false;
	} elseif ($operacion=="M" || $operacion=="V") {
	   	$es_modif = true;
	   } else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en la llamada, operación inválida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
	   }
