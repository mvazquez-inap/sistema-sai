<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oComision= new cComision($conexion);
//----------------------------------------------------------------------------------------- 

$filacomision=array();
$filacomision['comi_codinap']=(isset($_POST['comi_codinap_seleccion']))?$_POST['comi_codinap_seleccion']:"";
$filacomision['comi_codigo']=(isset($_GET['comi_codigo']))?$_GET['comi_codigo']:"";
$filacomision['comi_codigo']=(isset($_POST['comi_codigo']))?$_POST['comi_codigo']:$filacomision['comi_codigo'];

if (isset($_POST['comi_codinap_seleccion'])) {
	if($conexion->TraerCampo("comision","comi_codigo",array("comi_codinap='",$_POST['comi_codinap_seleccion'],"'"),$comi_codigo,$numfilas,$errno))
		$filacomision['comi_codigo']=htmlspecialchars($comi_codigo,ENT_QUOTES);
}
if ( isset($_POST['comi_codigo']) || isset($_GET['comi_codigo']) ) {
	if($conexion->TraerCampo("comision","comi_codinap",array("comi_codigo='",$filacomision['comi_codigo'],"'"),$comi_codigo_inap,$numfilas,$errno))
		$filacomision['comi_codinap']=htmlspecialchars($comi_codigo_inap,ENT_QUOTES);
}

$destino_formulario_interface="comision_emitir_acta.dhtml";
?>
<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oComision->PedirComision($filacomision['comi_codinap'],'formulario_seleccion','comi_codinap_seleccion','Emitir Acta'); ?></td>
	</tr>
	</table>
</form>	

<?php
$ok=false;

if ($filacomision['comi_codigo']=="") {

	if ( isset($_POST['comi_codigo']) || isset($_POST['comi_codinap_seleccion']) )
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

} else {

	if ($oComision->TraerDatosComision($filacomision['comi_codigo'],$filacomision,$es_modif)) {
		if (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else { 			
			if ($oComision->TienePermisoEmitirActa($filacomision['comi_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
				$ok=true;
			} // Tiene permiso el usuario sobre la comision
		}	// Se encontró la actividad con el formato esperado		
	} // No se produjo error al buscar la actividad con el formato esperado		

} // seleccion de actividad
//------------------------------------------------------------
// Inicio de pantalla
//------------------------------------------------------------
if ($ok) { 	
	?>
	<div style="width:95%" align="right"><img src="images/personas.jpg" alt="" width="25" height="25" />
		<a href="javascript:Popup('comision_ver_inscriptos_popup.dhtml?comi_codigo=<?php echo $filacomision['comi_codigo'] ?>','ventana_persona_inscripta',540,500,screen.availWidth-560,screen.availHeight-500,'yes');" >Ver Inscriptos </a>	
	</div>
	<br>
	<div style="width:95%" align="right">
		<img src="images/resultados.jpg" alt="" width="25" height="25" />		
		<a href="javascript:Popup('comision_ver_resumen_resultados.dhtml?comi_codigo=<?php echo $filacomision['comi_codigo'] ?>','ventana_persona',650,250,screen.availWidth-560,screen.availHeight-300,'yes');" >Ver Resumen Resultados </a>
	</div>
	<?php
	if($oComision->MostrarDatosComision($conexion,"V",$filacomision)){ 
		$destino_formulario_upd="comision_emitir_acta.dhtml";	
	?>
		<form action="<?php echo $destino_formulario_upd ?>" method="post" name="formulario">
		<table width="100%" class="textoTablaDato" align="center">
			<tr align="center">
				<td width="50">&nbsp;</td>
				<td colspan="2" valign="top">
			      <div align="left">
			        <img src="images/imprimir.gif"  alt="Imprimir" />
				    <a href="javascript:Popup('comision_emitir_acta_download.dhtml?comi_codigo=<?= $filacomision['comi_codigo']?>&amp;formato=S','ventana_acta',630,500,screen.availWidth-680,screen.availHeight-550,'yes')">Imprimir Acta Formato Simple</a>
                </div></td>
			</tr>	
			<tr align="center">
				<td>&nbsp;</td>			
				<td colspan="2" valign="top">
				  <div align="left">
			        <img src="images/imprimir.gif"  alt="Imprimir" />
				    <a href="javascript:Popup('comision_emitir_acta_download.dhtml?comi_codigo=<?= $filacomision['comi_codigo']?>&amp;formato=M','ventana_acta_2',630,500,screen.availWidth-680,screen.availHeight-550,'yes')">Imprimir Acta Formato Múltiple </a>
	            </div></td>
			</tr>				
		</table>
		</form>	
<?php } // MostrarDatosComision 
	
} // fin ok
$oEncabezados->PieMenuEmergente(); 
?>