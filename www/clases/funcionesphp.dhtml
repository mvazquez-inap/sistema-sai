	static function ArmarLinkEstrucVertical($conexion,$archivonom,$querystring,$nomnivelactualiz,$codnivelactualiz,$separador,$texto)
	{
		echo "<span class='textoAclaraciones'>".htmlspecialchars($separador,ENT_QUOTES);
