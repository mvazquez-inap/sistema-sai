<?php
if (isset($_POST['boton_buscar'])) {
	$_SESSION['array_busqueda_basica_prestador_docente']=array();	
	$_SESSION['array_busqueda_basica_prestador_docente']['idtextboxAddValor']=$_POST['destino'];	
	$_SESSION['array_busqueda_basica_prestador_docente']['formulario']=$_POST['formulario'];	
	$_SESSION['array_busqueda_basica_prestador_docente']['submit']=$_POST['submit'];
	$_SESSION['array_busqueda_basica_prestador_docente']['accion']=$_POST['accion'];	
		

	$_SESSION['filtro_busqueda']=array();
	$_SESSION['filtro_busqueda']['presdoc_estado']=$_POST['presdoc_estado'];
	$_SESSION['filtro_busqueda']['presdoc_nombre']=$_POST['presdoc_nombre'];
	$_SESSION['filtro_busqueda']['presdoc_apellido']=$_POST['presdoc_apellido'];
	$_SESSION['filtro_busqueda']['presdoc_cuilt']=$_POST['presdoc_cuilt'];
}			
if (!isset($_SESSION['array_busqueda_basica_prestador_docente'])) {
	$_SESSION['array_busqueda_basica_prestador_docente']=array();
	$_SESSION['filtro_busqueda']=array();
}

if(isset($_POST['boton_buscar']) || isset($_GET['pagina']) ) {
	MostrarGrillaSeleccion($conexion,$_SESSION['filtro_busqueda'],$estado_leyenda);
?>	
	<span class="textoDatoBold"><br></span>
	<div align="left" class="textoTablaDatoChico">&nbsp;&nbsp;Nota: Se muestran los Prestadores Docentes <?php echo $estado_leyenda ?> que cumplen con el filtro seleccionado.</div>
	<br><br><div align="center"><a href="prestador_docente_selector.dhtml?<?php echo "formulario=".$_SESSION['array_busqueda_basica_prestador_docente']['formulario']."&amp;"."destino=".$_SESSION['array_busqueda_basica_prestador_docente']['idtextboxAddValor']."&amp;"."submit=".$_SESSION['array_busqueda_basica_prestador_docente']['submit']."&amp;"."presdoc_estado=".$_SESSION['filtro_busqueda']['presdoc_estado'] ?>" class="linkFondoBlanco">Volver a buscar</a></div><?php
} else {
?>
	<script type="text/javascript" language="javascript">
	function ValidarJS(formulario) {
		if (!ValidarContenido(formulario.presdoc_apellido.value,"AlfabeticoPuro"))
		{
			alert("El apellido a buscar es inválido");
			formulario.presdoc_apellido.focus();
			return false;	
		}
			if (!ValidarContenido(formulario.presdoc_nombre.value,"AlfabeticoPuro"))
		{
			alert("El nombre a buscar es inválido");
			formulario.presdoc_nombre.focus();
			return false;	
		}
	
		return true;	
	}
	</script>

	<form action="<?php echo $_SERVER['PHP_SELF'] ?>" name="formulario"  method="post">
	<table width="100%" class="textoTablaDato" align="center">
		<tr>
			<td width="25%"></td>
			<td width="65%"></td>
		</tr>
		<tr>
			<td class="textoEtiquetaClave">CUIT/CUIL</td>
			<td class="textoEtiquetaDatoResaltado">	<input type="text" name="presdoc_cuilt" id="presdoc_cuilt" class="textoInput" maxlength="11" size="12"></td>
		</tr>
		<tr>
			<td class="textoEtiqueta">Apellido</td>
			<td class="textoEtiquetaDatoResaltado"><input type="text" name="presdoc_apellido"  id="presdoc_apellido" class="textoInput" maxlength="30" size="31"></td>
		</tr>
		<tr>
			<td class="textoEtiqueta">Nombre</td>
			<td class="textoEtiquetaDatoResaltado"><input type="text" name="presdoc_nombre" id="presdoc_nombre" class="textoInput" maxlength="30" size="31"></td>
		</tr>
		<tr>
			<td colspan="2" height="20"></td>
		</tr>
		<tr align="center">
			<td colspan="2">
				<input type="hidden" name="formulario" value="<?php echo (isset($_GET['formulario']))?$_GET['formulario']:"" ?>" > 
				<input type="hidden" name="destino" value="<?php echo (isset($_GET['destino']))?$_GET['destino']:"" ?>" >
				<input type="hidden" name="submit" value="<?php echo (isset($_GET['submit']))?$_GET['submit']:"" ?>" >
				<input type="hidden" name="presdoc_estado" value="<?php echo (isset($_GET['presdoc_estado']))?$_GET['presdoc_estado']:"" ?>" >
				<input type="submit" name="boton_buscar" class="botones" value="Buscar Prestador Docente" onClick="return ValidarJS(formulario);">&nbsp;&nbsp;&nbsp;&nbsp;
				<input type="hidden" name="accion" value="<?php echo (isset($_GET['accion']))?$_GET['accion']:$_SESSION['array_busqueda_basica_prestador_docente']['accion']?>" >				
				<input type="reset" name="boton_limpiar" class="botones" value="Limpiar">
			</td>
		</tr>
	</table>
	</form>
<?php
