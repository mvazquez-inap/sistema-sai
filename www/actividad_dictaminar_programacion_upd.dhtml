<?php require('./include.dhtml');
$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
$oDictamen = new cDictamen($conexion);
//----------------------------------------------------------------------------------------- 
$conexion->ManejoTransacciones("B");
$result=true;

if (isset($_POST['boton_alta'])) 

		if($oDictamen->AltaDatosProgramacion($_POST)) {
			FuncionesPHPLocal::RegistrarAcceso($conexion,"49101","act_codigo=".$_POST['act_codigo']."actprog_sec=".$_POST['actprog_sec'],$_SESSION['usuariocod']);
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de alta el dictamen y la programación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else 
			$result=false;

	elseif (isset($_POST['boton_eliminar'])) 
			if($oDictamen->BajaDatosProgramacion($_POST)) {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"49102","act_codigo=".$_POST['act_codigo']."actprog_sec=".$_POST['actprog_sec'],$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de baja el dictamen y la programación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else 
				$result=false;

	elseif (isset($_POST['boton_actualizar'])) 
			if($oDictamen->ModifDatosProgramacion($_POST)) {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"49103","act_codigo=".$_POST['act_codigo']."- actprog_sec=".$_POST['actprog_sec'],$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha modificado el dictamen y la programación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else 
				$result=false;
	
	else {
			$txt_sys_mail="Error validando la operación seleccionada.\nusuariocod=".$_SESSION['usuariocod'];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error validando la operación seleccionada.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			$result=false;
		}

if($result) {
	$conexion->ManejoTransacciones("C");
} else	
	$conexion->ManejoTransacciones("R");


if ($_SESSION['rolcod']==USUCURSOINAP || $_SESSION['rolcod']==USUACTINS ||
	$_SESSION['rolcod']==USUACTJUR || $_SESSION['rolcod']==USUACTEXT ) 
	$volver ="actividad_dictaminar_programacion.dhtml";
elseif ($_SESSION['rolcod']==USUAUTODESARROLLO)
	$volver ="actividad_autodesarrollo_dictaminar.dhtml";
elseif ($_SESSION['rolcod']==SUPERUSUARIO) { 
	switch ($_POST["tipoact_codigo"]) {
		case TIPOACTAUTODOCENTE:
		case TIPOACTAUTOEVASIS:
		case TIPOACTAUTOEVACT:
		case TIPOACTAUTOPUBLI:
		case TIPOACTAUTOASISTEC:
		case TIPOACTAUTOAAUTOFORM:
			$volver ="actividad_autodesarrollo_dictaminar.dhtml";
			break; 
		default:
			$volver ="actividad_dictaminar_programacion_modificar.dhtml";
			break; 
	}
}
?>
<br>
<div align="center"><a href="<?= $volver ?>" class="linkFondoBlanco">Volver</a></div>
<?php
$oEncabezados->PieMenuEmergente(); 
?>