<?php 
require_once('SysONTIPdf.dhtml');

class cResultadoComisionPDF extends cPDF {

	// Datos de la Notificacion
	var $array_datos = array();

	// Ctes para la impresion de la Notificacion
	var $ver_borde=0;	
	var $xContenido = 5;
	var $imagenLogo = 'images/escudo_secretaria.jpg';
	
	var $orientacionPagina = 'landscape';
	var $topMargen = 10;
	var $leftMargen = 10;
	var $rightMargen = 10;
	var $footerMargen = 15;
	var $anchoMaxTexto = 280;	
				
	public function __construct () {	    
		 $format = "A4";
		parent::__construct($this->orientacionPagina,'mm',$format);
	}	
	
	//------------------------------------------------------------------------
	function AddActa() {
		// Inicializa formato de la pagina 
		$this->AddPage($this->orientacionPagina);
		$this->SetMargins($this->leftMargen,$this->topMargen,$this->rightMargen);
		// Para que el pie tenga 0.5 por defecto son 2cm
		$this->SetAutoPageBreak(true,$this->footerMargen);
		// Inicializa datos 
		$this->array_datos = array('comi_codinap'=>'',
									'comi_acta_numero'=>'',
									'act_nombre'=>'',
									'comi_domicilio'=>'',
									'comi_detalle'=>'',		
									'cronograma' => array(),
									'prestador_docente' => array(),
									'datos_cabecera' => array(),									
									'datos_inscriptos' => array()
									);
	}	
	
	
	//------------------------------------------------------------------------
	function Set($campo,$valor) {
		$this->array_datos[$campo]=$valor;
	}
	//------------------------------------------------------------------------
	function Get($campo) {
		return ($this->array_datos[$campo]);
	}
	//------------------------------------------------------------------------
	function Header() {
		$this->SetFont('Arial','',10);
		//Move to the right
		$this->Cell(170);
		//Framed title
		$this->Cell(25,6,'Pág. '.$this->PageNo().'/{nb}',0,0,'C');
		//Line break
		$this->Ln(0);

	 }
	//------------------------------------------------------------------------
	function MostrarActa() {
	
		$this->SetFont('Arial','',8);
		$this->Image($this->imagenLogo,$this->lMargin+$this->xContenido,$this->tMargin+2,190,0);

		$ancho_fila_dato = $this->anchoMaxTexto;
		$alto_fila_dato =  6;

		$this->SetFont('Arial','BI',12);
		$this->SetXY($this->lMargin+$this->xContenido+20,$this->tMargin+3) ;
		$this->MultiCellMaxLine(120,$alto_fila_dato,"Jefatura de Gabinete de Ministros \nSecretaría de la Gestión Pública \nInstituto Nacional de la Administración Pública",
								$this->ver_borde,'L',0,3);
	
		// carátula
 		$this->Ln(4);	
		// datos generales
		$this->SetFont('Arial','B',10);
		
    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								"SISTEMA NACIONAL DE CAPACITACION\n ACTA VOLANTE",$this->ver_borde,'C',0,2);
 		$this->Ln(4);	

		$this->SetFont('Arial','B',10);
		if ($this->Get('comi_codinap') != "")
	    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								'COMISION: '.$this->Get('comi_codinap'),$this->ver_borde,'L',0,1);

		if ($this->Get('comi_acta_numero') != "")
	    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								'N° DE ACTA: '.$this->Get('comi_acta_numero'),$this->ver_borde,'L',0,1);

		if ($this->Get('act_nombre') != "")
	    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								'ACTIVIDAD: '.$this->Get('act_nombre'),$this->ver_borde,'L',0,1);

		if ($this->Get('comi_domicilio') != "")
	    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								'LUGAR DE REALIZACIÓN: '.$this->Get('comi_domicilio'),$this->ver_borde,'L',0,1);

		if ($this->Get('comi_detalle') != "")
	    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								''.$this->Get('comi_detalle'),$this->ver_borde,'L',0,1);
		// fin datos generales

		// hotario
 		$this->Line($this->GetX(),$this->GetY(),$this->GetX()+150,$this->GetY());	

    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								'HORARIO:',$this->ver_borde,'L',0,1);

		$this->SetFont('Arial','',10);

		$cronograma = $this->Get('cronograma');
		foreach ($cronograma as $indice=>$valor) {
	    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								date("d/m/Y",strtotime($valor['comifec_fecha']))." de ".$valor['comifec_hora_inicio']." a ".$valor['comifec_hora_fin'],$this->ver_borde,'L',0,1);
			}
		// fin hotario
		
 		// docente
		$this->Line($this->GetX(),$this->GetY(),$this->GetX()+150,$this->GetY());	
		$this->SetFont('Arial','B',10);

    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								'DOCENTE:',$this->ver_borde,'L',0,1);

		$this->SetFont('Arial','',10);

		 $prestador_docente = $this->Get('prestador_docente');

		foreach ($prestador_docente as $indice=>$valor) {
	    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
								$valor['campo_mostrar'],$this->ver_borde,'L',0,1);
			}
 		$this->Line($this->GetX(),$this->GetY(),$this->GetX()+150,$this->GetY());	
		// fin docente

		// cabecera
		$this->AddPage($this->orientacionPagina);
		$this->MostrarCabecera();

		// inscriptos
		$this->MostrarInscriptos();

		// pie de acta
		$this->Ln(10);
		$texto_final = "Se hace constar que sobre un total de __________________ alumnos, resultaron: ______________ aprobados, ______________ desaprobados, ______________ ausentes y ______________ libres.";	
		
		$lineas_texto = $this->WordWrap($texto_final,200);				

    	$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
							$texto_final,$this->ver_borde,'L',0,$lineas_texto);

		$yFirma = $this->Gety()+30;						
		$xFirma = $this->GetX()+20;
		$this->Line($xFirma,$yFirma,$xFirma+45,$yFirma);
		$this->SetFont('Arial','B',8);
		$this->SetXY($xFirma+15,$yFirma);
		$this->MultiCellMaxLine(15,$alto_fila_dato,
								'Docente',$this->ver_borde,'C',0,1);

		$xFirma = $this->GetX()+70;						
		$this->Line($xFirma,$yFirma,$xFirma+45,$yFirma);
		$this->SetFont('Arial','B',8);
		$this->SetXY($xFirma+15,$yFirma);
		$this->MultiCellMaxLine(15,$alto_fila_dato,
								'Docente',$this->ver_borde,'C',0,1);

		$xFirma = $this->GetX()+120;						
		$this->Line($xFirma,$yFirma,$xFirma+45,$yFirma);
		$this->SetFont('Arial','B',8);
		$this->SetXY($xFirma+7,$yFirma);
		$this->MultiCellMaxLine(30,$alto_fila_dato,
								'Coordinador INAP',$this->ver_borde,'C',0,1);
		
		

		
	}
	//------------------------------------------------------------------------
	function MostrarCabecera() {

		$this->AliasNbPages(); 

		$datos_cabecera = $this->Get('datos_cabecera');

		$this->SetFont('Arial','BI',12);
		if ($this->Get('comi_codinap') != "")
	    	$this->MultiCellMaxLine(0,10,
								'COMISION: '.$datos_cabecera['comi_codinap']."               ".'N° ACTA: '.$datos_cabecera['comi_acta_numero'],$this->ver_borde,'L',0,1);
	
		if ($this->Get('comi_codinap') != "")
	    	$this->MultiCellMaxLine(0,10,
								'ACTIVIDAD: '.$datos_cabecera['act_codinap']." - ".$datos_cabecera['act_nombre'],$this->ver_borde,'L',0,1);
							
	}
	
	//------------------------------------------------------------------------
	function MostrarInscriptos() {
	
			$this->SetFont('Arial','',10);
			$this->Ln(10);
		
			$datos_inscriptos = $this->Get('datos_inscriptos');

			 // colimnas
		    $columnas=array("N°","Apellido y Nombre","Organismo","CUIT / CUIL", "N", "G", "Evaluación"); 
		    $w=array(5,40,40,25,20,20,35);
			
			//Cabeceras
			$this->SetTextColor(0);
			for($i=0;$i<count($columnas);$i++)
				$this->Cell($w[$i],12,$columnas[$i],1,0,'C',0);
			$this->Ln();
			$this->SetTextColor(0);
			
			//Datos
			$n = 0;
			//print_r($datos_inscriptos);
			foreach($datos_inscriptos as $indice=>$valor)
			{
				$n++;
				$nombre = $valor['pers_apellido']." ".$valor['pers_nombre'];
				$lineas_nom = $this->WordWrap($nombre,40);				
				$lineas_org = $this->WordWrap($valor['jurisdnom'],40);

				
				$lineas = max($lineas_org, $lineas_nom);
				
				$this->Cell($w[0],6*$lineas,$n,'LR');
				$this->Cell($w[1],6*$lineas,$nombre,'LR');
				$this->Cell($w[2],6*$lineas,$valor['jurisdnom'],'LR');
				$this->Cell($w[3],6*$lineas,$valor['pers_cuilt'],'LR');
				$this->Cell($w[4],6*$lineas,$valor['escalafnivdesc'],'LR');				
				$this->Cell($w[5],6*$lineas,$valor['escalafgradodesc'],'LR');	
				$this->Cell($w[6],6*$lineas,$valor['eval_descripcion'],'LR');								
				$this->Ln();				
			    $this->Cell(array_sum($w),0,'','T');
				$this->Ln();
			
			}
			//Línea de cierre
			$this->Cell(array_sum($w),0,'','T');
	
	}
		
	//------------------------------------------------------------------------
	function Footer() { }
} // fin clase	
?>