	function ValidarFormDictamenPersonal() {	?>		
	function ValidarFormDictamenPersona(formulario,operacion) {
				
			// Pertinencia 	- [dic_pertinencia] 	- [OBLIG]
			if ((trim(formulario.dic_pertinencia.value)=="")) {
				alert("Debe ingresar la pertinencia");
				formulario.dic_pertinencia.focus();
				return false;
			}	

			
			 if (formulario.dic_pertinencia.value == '<?php echo SI ?>') {
				// Ponderador 	- [pondtipopond_codigo_cal_pres] 	- [OBLIG]
				if ((trim(formulario.pondtipopond_codigo_cal_pres.value)=="")) {
					alert("Debe ingresar el ponderador Calidad del prestador individual o institucional");
					formulario.pondtipopond_codigo_cal_pres.focus();
					return false;
				}	
		
				// Ponderador 	- [pondtipopond_codigo_int] 	- [OBLIG]
				if ((trim(formulario.pondtipopond_codigo_int.value)=="")) {
					alert("Debe ingresar el Ponderador de la Intensidad de la actividadl");
					formulario.pondtipopond_codigo_int.focus();
					return false;
				}	

				// Ponderador 	- [pondtipopond_codigo_proc_eva] 	- [OBLIG]
				if ((trim(formulario.pondtipopond_codigo_proc_eva.value)=="")) {
					alert("Debe ingresar el Ponderador Calidad del proceso evaluador");
					formulario.pondtipopond_codigo_proc_eva.focus();
					return false;
				}	
	
				// Créditos 	- [actcur_creditos] 	- [OBLIG]
				if (!ValidarContenido(formulario.act_creditos.value,'NumericoEntero') ) {
					alert("Los créditos ingresados deben ser un número entero");
					formulario.act_creditos.focus();
					return false;
				}	
				if (formulario.act_creditos.value<=0) {
					alert("Los créditos deben ser mayor que cero");
					formulario.act_creditos.focus();
					return false;
				}	
			}
			return true;
		}
<?php 	}	

//---------------------------------------------------------------------------------------------------------------------
function ObtenerDatosDictamenPersonal ($conexion,$oActividad,$act_codigo,$tipoact_codigo,$pers_codigo,
									   &$operacion_dictamen,&$operacion_programacion,
									   &$fila_ultimo_dictamen,&$fila_detalle,&$fila_dictamen_editable) {


$ok =true;
if (!$oActividad->TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,$fila_detalle,$es_modif_act) ) {

	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar la Actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"\nact_codigo=".$filaactividad['act_codigo']);
	$ok=false;	

} else {

	$fila_dictamen_editable=array();
	$fila_ultimo_dictamen=array();		

	// Obtengo los dictamenes
	$ArregloDatos['act_codigo']=$act_codigo;
	$ArregloDatos['tipoact_codigo']=$tipoact_codigo;		
	$ArregloDatos['pers_codigo']=$pers_codigo;		

	if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
		$txt_sys_mail="Error al buscar dictamen de la actividad.\nact_codigo=".$filaactividad['act_codigo'];
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
	} elseif ($numfilas!=0) { // Hay dictamenes para la actividad
		$fila_dictamen=mysqli_fetch_assoc($resultDictamenes);
		if ($fila_dictamen['dic_estado']==DICTAMENNUEVO || $fila_dictamen['dic_estado']==DICTAMENRECHAZADO)
			$fila_dictamen_editable=$fila_dictamen;
		$fila_ultimo_dictamen=$fila_dictamen;
	} 

	// Hay un único dictamen y es nuevo o rechazado
	$hay_dictamen = ($numfilas!=0);
	$hay_dictamen_editable = ($numfilas==1 && ($fila_ultimo_dictamen['dic_estado']==DICTAMENNUEVO || $fila_ultimo_dictamen['dic_estado']==DICTAMENRECHAZADO)) ;

	if (!$hay_dictamen) 
	   $operacion_dictamen= "A";
	elseif ($hay_dictamen_editable)    
		$operacion_dictamen= "M";
	 else 
		$operacion_dictamen= "V";

	if ($numfilas==0 || !($fila_ultimo_dictamen['dic_estado']==DICTAMENNUEVO || $fila_ultimo_dictamen['dic_estado']==DICTAMENRECHAZADO))
		$operacion_programacion = "A";
	else 
		$operacion_programacion = "M";	
}
return $ok;	
}
