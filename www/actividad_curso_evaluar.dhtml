//-----------------------------------------------------------------------------------------------
function MostrarGrillaSeleccion($conexion) {

	$oActividadCursoJurisdiccional = new cActividadCursoJurisdiccional($conexion);
	$ArregloDatos['actcur_estado']=ACTCURSOAPROBADO;
	$ArregloDatos['jurisdid_inap']=$_SESSION['jurisdid_inap'];
	$ArregloDatos['orderby']='act_nombre';
			
	$result = true;
	if(!$oActividadCursoJurisdiccional->BuscarActividadCurso($ArregloDatos,$numfilas,$result,$error,$errormail)){
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$result = false;			
	}

	if(!$result) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar actividades. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$error=true;											
	} else {
	
		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"FilasPagina"=>$numfilas,
			"NombrePaginaQuery"=>"pagina"
		);				
		
		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla('Actividades a Evaluar ');
		$oGrilla->SetearAnchoGrilla('90%');

		$miColumna0 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna0,'Código');
		$oGrilla->Setear('campo_grilla',$miColumna0,'act_codinap');
		$oGrilla->Setear('align_columna',$miColumna0,'left');
	
		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'Nombre Actividad');
		$oGrilla->Setear('campo_grilla',$miColumna1,'act_nombre');
		$oGrilla->Setear('align_columna',$miColumna1,'left');

/*		$miColumna2 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Aprobar');
		$oGrilla->Setear('ancho_columna',$miColumna2,'60');
		$oGrilla->Setear('url',$miColumna2,'actividad_curso_evaluar.dhtml');
		$oGrilla->Setear('url_ancla',$miColumna2,'Edicion');
		$oGrilla->Setear('imagen',$miColumna2,'images/aprobar.gif');
		$oGrilla->Setear('altImagen',$miColumna2,'Aprobar');						
		$oGrilla->AddParametrosURL($miColumna2,"act_codigo","act_codigo");
		$oGrilla->AddParametrosURL($miColumna2,"operacion","A","cte");

		$miColumna3 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Rechazar');
		$oGrilla->Setear('ancho_columna',$miColumna3,'60');
		$oGrilla->Setear('url',$miColumna3,'actividad_curso_evaluar.dhtml');
		$oGrilla->Setear('imagen',$miColumna3,'images/rechazar.gif');
		$oGrilla->Setear('altImagen',$miColumna3,'Rechazar');
		$oGrilla->AddParametrosURL($miColumna3,"act_codigo","act_codigo");
		$oGrilla->AddParametrosURL($miColumna3,"operacion","R","cte");
*/
		$miColumna2 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Seleccionar');
		$oGrilla->Setear('ancho_columna',$miColumna2,'60');
		$oGrilla->Setear('url',$miColumna2,'actividad_curso_evaluar.dhtml');
		$oGrilla->Setear('url_ancla',$miColumna2,'Edicion');
		$oGrilla->Setear('imagen',$miColumna2,'images/seleccionar.jpg');
		$oGrilla->Setear('altImagen',$miColumna2,'Seleccionar');						
		$oGrilla->AddParametrosURL($miColumna2,"act_codigo","act_codigo");
		$oGrilla->AddParametrosURL($miColumna2,"operacion","S","cte");

		if ($oGrilla->CargarGrilla($result)) {
			$oGrilla->MostrarGrilla();					
		} else {
			$error=true;					
			$txt_sys_mail = "Error Grilla='".$oGrilla->GetError();
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar actividades.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);

		}		
	}		
	
	return $result;
}
//-----------------------------------------------------------------------------------------------
// Inicio de pantalla
//-------------------
$result = true;
// Se define la acción
if (!isset($_GET['operacion'])) {
	$leyenda_operacion = "";
	$boton_operacion = "";		
	$operacion = "";
} else {
	switch ($_GET['operacion']) {		
/*	case "A" :
			$leyenda_operacion = "Aprobar";		
			$boton_operacion = "Aprobar";		
			$operacion = "A";				
			break;
	case "R" :
