// $wsdl_tablas = $servidor."sai/wsSai/wsTablasBasicas.php?wsdl";	
// $cliente_tablas = new nusoap_client($wsdl_tablas, 'wsdl');

// ----------------------------------------------------------------------------------------------------------------
if ($servidor=="10.1.10.173") { 	
	$WSDL_creditosPersonales = "http://10.1.10.173/sai/wsSai/wsCreditosPersonales.php?wsdl";	
	$WSDL_TablasBasicas = "http://10.1.10.173/sai/wsSai/wsTablasBasicas.php?wsdl";		
} else 	{
	$WSDL_creditosPersonales = $servidor."/wsSai/wsCreditosPersonales.php?wsdl";	
	$WSDL_TablasBasicas = $servidor."/wsSai/wsTablasBasicas.php?wsdl";		
}

$oWsCreditosPersonales = new cCreditosPersonalesINAP($WSDL_creditosPersonales,true);
$oWsTablasBasicas= new cTablasBasicasINAP($WSDL_TablasBasicas,true);
// ----------------------------------------------------------------------------------------------------------------
// Créditos totales
// ----------------------------------------------------------------------------------------------------------------
if (isset($_POST['creditosTotal']))
	$result = $oWsCreditosPersonales->getCreditosTotal($_POST['pers_cuit'],$_POST['fdesde'],$_POST['fhasta']);
// ----------------------------------------------------------------------------------------------------------------
if (isset($_POST['detalleCreditosTotal']))
	$result = $oWsCreditosPersonales->getDetalleCreditosTotal($_POST['pers_cuit'],$_POST['fdesde'],$_POST['fhasta']);

// ----------------------------------------------------------------------------------------------------------------
// Créditos por Formato
// ----------------------------------------------------------------------------------------------------------------
if (isset($_POST['creditosPorFormato']))
	$result = $oWsCreditosPersonales->getCreditosPorFormato($_POST['formact_codigo'],$_POST['pers_cuit'],$_POST['fdesde'],$_POST['fhasta']);
// ----------------------------------------------------------------------------------------------------------------
if (isset($_POST['detalleCreditosPorFormato']))
	$result = $oWsCreditosPersonales->getDetalleCreditosPorFormato($_POST['formact_codigo'],$_POST['pers_cuit'],$_POST['fdesde'],$_POST['fhasta']);

// ----------------------------------------------------------------------------------------------------------------
// Tablas del sistema
// ----------------------------------------------------------------------------------------------------------------
if (isset($_POST['sysTabFormatos']))
	$result = $oWsTablasBasicas->getTableFormatoActividad();

if (isset($_POST['sysTabTipoActividad']))
	$result = $oWsTablasBasicas->getTableTipoActividad();	

if (isset($_POST['sysTabResolucion']))
	$result = $oWsTablasBasicas->getTableResolucion();

// ----------------------------------------------------------------------------------------------------------------
if (isset($_POST['creditosTotal']) || isset($_POST['creditosPorFormato']))  { 
	
	// Capturo el error
	$error=$oWsCreditosPersonales->fault;
	$error_description=$oWsCreditosPersonales->getError();

	if ($error){
		echo '<br><strong>Error: </strong>';
		echo "(".$error_description['faultcode'].",'".$error_description['faultstring']."','".$error_description['detail']. "')";
		echo '<br>';
		die();
	} else {
		echo '<br>';
		echo '<h2>Resultado:</h2>';
		
?>		
		<table border="1" style="width:10%">
        <tr style="background-color:#999999; color:#FFFFFF; font-weight:bold; text-align:center;">
            <th style="width:10%">Créditos</th>          
        </tr>	
		<tr>
			<td style="text-align:center">
				<?php  echo utf8_decode($result['creditos']); ?>
			</td>
		</tr>		
		</table>	
<?php		
	}

}
// ----------------------------------------------------------------------------------------------------------------
if (isset($_POST['detalleCreditosTotal']) || isset($_POST['detalleCreditosPorFormato']) )  { 

	// Capturo el error
	$error=$oWsCreditosPersonales->fault;
	$error_description=$oWsCreditosPersonales->getError();
	
	if ($error) {
		echo '<br><strong>Error: </strong>';
		echo "(".$error_description['faultcode'].",'".$error_description['faultstring']."','".$error_description['detail']. "')";
		echo '<br>';
		die();
	} else {
		echo '<br>';		
		echo '<h2>Resultado:</h2>';
		$xml = iconv("ISO-8859-1","UTF-8//IGNORE",$result['resultado']);
		$xml2 = @simplexml_load_string($xml);

		// echo "<BR>CLIENTE:<BR>";
		// print_r($oWsCreditosPersonales);
		// echo "<br><br> XML: ".$xml ;

		if (is_object($xml2))
		{
			$cant_act_certificadas = count($xml2->actividades_certificadas->children());
			if ($cant_act_certificadas==0)	 	 { 
				echo '<span style="font-weight:bold">No se encontraron créditos de actividades del formato solicitado.</span>';
			} else	{
?>		
	        <table border="1" style="width:100%; font-family:Arial, Helvetica, sans-serif;   font-size:11px;" >
	        <tr style="background-color:#999999; color:#FFFFFF;text-align:center;font-weight:bold;">
	            <th style="width:5%">C&oacute;digo INAP</th>
	            <th style="width:40%">Actividad Nombre</th>
                <!--           <th style="width:5%">Tipo de Actividad</th> -->
	            <th style="width:5%">C&eacute;ditos</th>
	            <th style="width:8%">Realizada desde</th>
	            <th style="width:8%">Realizada hasta</th>                
	            <th style="width:9%">Expediente</th>
	            <th style="width:10%">N&uacute;mero de disposici&oacute;n</th>
	            <th style="width:10%">Fecha disposici&oacute;n</th>
	        </tr>	
	<?php
				foreach ($xml2->actividades_certificadas as $actividad) {
					foreach ($actividad as $datosactividad) {
	?>
					<tr>
						<td style="text-align:left">
							<?php  echo utf8_decode($datosactividad->act_codinap); ?>
						</td>
						<td style="text-align:left">
							<?php  echo utf8_decode($datosactividad->act_nombre); ?>
						</td>
                        <!-- 
						<td style="text-align:center">
							<?php  // echo utf8_decode($datosactividad->tipoact_codigo); ?>
						</td>
                        -->
						<td style="text-align:center">
							<?php  echo utf8_decode($datosactividad->total_creditos); ?>
						</td>
                        <td style="text-align:center">
							<?php echo FuncionesPHPLocal::ConvertirFecha(utf8_decode($datosactividad->fecha_inicio),'aaaa-mm-dd','dd/mm/aaaa'); ?>
						</td>
                        <td style="text-align:center">
							<?php echo FuncionesPHPLocal::ConvertirFecha(utf8_decode($datosactividad->fecha_fin),'aaaa-mm-dd','dd/mm/aaaa'); ?>
						</td>
						<td style="text-align:left">
							<?php  echo utf8_decode($datosactividad->exp_numero); ?>
						</td>
						<td style="text-align:center">
							<?php  echo utf8_decode($datosactividad->dis_numero); ?>
						</td>
                  		<td style="text-align:center">
							<?php  echo FuncionesPHPLocal::ConvertirFecha(utf8_decode($datosactividad->dis_fecha),'aaaa-mm-dd','dd/mm/aaaa'); ?>
						</td>

                        
	                  </tr>	 
	<?php				}
				}
			}
?>
	</table>
<?php			
		}		
	}
}

if ( isset($_POST['sysTabFormatos']) || isset($_POST['sysTabTipoActividad'])||isset($_POST['sysTabResolucion'])  )  { 	

	// Capturo el error
	$error=$oWsTablasBasicas->fault;
	$error_description=$oWsTablasBasicas->getError();

	if ($error) {
		echo '<br><strong>Error: </strong>';		
		echo "(".$error_description['faultcode'].",'".$error_description['faultstring']."','".$error_description['detail']. "')";
		echo '<br>';
		die();		
	} else {

		echo '<br>';		
		echo '<h2>Resultado:</h2>';
		$xml = iconv("ISO-8859-1","UTF-8//IGNORE",$result['resultado']);
		$xml2 = @simplexml_load_string($xml);
		
		// echo "<br><br> XML: ".$xml ;
		
		// echo "<BR>CLIENTE:<BR>";
		// print_r($oWsCreditosPersonales);

		if (is_object($xml2))
		{
			$cant_filas = count($xml2->tabla_elementos->children());
	
			if ($cant_filas==0)	 	 { 
				echo '<span style="font-weight:bold">No se encontraron elementos en la tabla.</span>';
			} else	{
?>		
	        <table border="1" style="width:40%">
	        <tr style="background-color:#999999; color:#FFFFFF; font-weight:bold; text-align:center;">
	            <th style="width:5%">C&oacute;digo</th>
	            <th style="">Descripci&oacute;n</th>	       
                
<?php 				if( isset($_POST['sysTabTipoActividad'])||isset($_POST['sysTabResolucion']) ) { ?>                     
					<th style="width:5%">C&oacute;digo Formato</th>
<?php 				} ?>
	        </tr>	
	<?php
				foreach ($xml2->tabla_elementos as $elemento) {
					foreach ($elemento as $elemento) {
	?>				<tr>
						<td style="text-align:left">
							<?php  echo utf8_decode($elemento->codigo); ?>
						</td>
						<td style="text-align:left">
							<?php  echo utf8_decode($elemento->descripcion); ?>
						</td>                        
<?php 				if( isset($_POST['sysTabTipoActividad'])||isset($_POST['sysTabResolucion']) ) { ?>                     
                        
                        <td style="text-align:left">
							<?php  echo utf8_decode($elemento->codigo_formato); ?>
						</td>
<?php 				} ?>
                        
                    </tr>	 
<?php					}
				}
			}
?>
	</table>
<?php			
		}		
	}
}	
