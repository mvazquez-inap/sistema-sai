	public function BusquedaAvanzada($datosbusqueda,&$tipo,&$resultado,&$numfilas)
	{
		$campo = " a.*, b.*  "; // pendiente , d.tabcampocatdesc as estado 
		if ($tipo==1)
			$campo = " COUNT(a.idart) as total ";
		
		$spnombre="sel_articulos_buscar";
		$sparam=array(
			'pcampos'=> $campo,
			'pxtitulo'=> 0,
			'ptitulo'=> "",
			'pxdesc_corta'=> 0,
			'pdesc_corta'=> "",
			'pxidpub'=> 0,
			'pidpub'=> "",
 			'pxidart'=>0,
 			'pidart'=>-1,		
			'pxdestacado'=>0,
 			'pdestacado'=>"",		
 			'pxmas_leido'=>0,
 			'pmas_leido'=>"",		
			'pxanio_edicion'=>0,
 			'panio_edicion'=>"",		
			'pxnumero_edicion'=>0,
 			'pnumero_edicion'=>"",
			'pxestadoart'=>0,
 			'pestadoart'=>-1,
			'pxestadopub'=>0,
 			'pestadopub'=>-1,	
			'porderby'=> "",
			'plimit'=> ""
			);
	
		if (isset ($datosbusqueda['titulo']) && $datosbusqueda['titulo']!="")
		{
			$sparam['ptitulo'] = $datosbusqueda['titulo'];
			$sparam['pxtitulo'] = 1;
		}	
		
		if (isset ($datosbusqueda['desc_corta']) && $datosbusqueda['desc_corta']!="")
		{
			$sparam['pdesc_corta'] = $datosbusqueda['desc_corta'];
			$sparam['pxdesc_corta'] = 1;
		}	
		
		if (isset ($datosbusqueda['idpub']) && $datosbusqueda['idpub']!="")
		{
			$sparam['pidpub'] = $datosbusqueda['idpub'];
			$sparam['pxidpub'] = 1;
		}
		
		if (isset ($datosbusqueda['idart']) && $datosbusqueda['idart']!="")
		{
			$sparam['pidart'] = $datosbusqueda['idart'];
			$sparam['pxidart'] = 1;
		}
		if (isset ($datosbusqueda['destacado']) && $datosbusqueda['destacado']!="")
		{
			$sparam['pdestacado'] = $datosbusqueda['destacado'];
			$sparam['pxdestacado'] = 1;
		}
		if (isset ($datosbusqueda['mas_leido']) && $datosbusqueda['mas_leido']!="")
		{
			$sparam['pmas_leido'] = $datosbusqueda['mas_leido'];
			$sparam['pxmas_leido'] = 1;
		}	
		if (isset ($datosbusqueda['anio_edicion']) && $datosbusqueda['anio_edicion']!="")
		{
			$sparam['panio_edicion'] = $datosbusqueda['anio_edicion'];
			$sparam['pxanio_edicion'] = 1;
		}		
		if (isset ($datosbusqueda['numero_edicion']) && $datosbusqueda['numero_edicion']!="")
		{
			$sparam['pnumero_edicion'] = $datosbusqueda['numero_edicion'];
			$sparam['pxnumero_edicion'] = 1;
		}	
		if (isset ($datosbusqueda['estadoart']) && $datosbusqueda['estadoart']!="")
		{
			$sparam['pestadoart'] = $datosbusqueda['estadoart'];
			$sparam['pxestadoart'] = 1;
		}	
		if (isset ($datosbusqueda['estadopub']) && $datosbusqueda['estadopub']!="")
		{
			$sparam['pestadopub'] = $datosbusqueda['estadopub'];
			$sparam['pxestadopub'] = 1;
		}	
		if (isset ($datosbusqueda['limit']) && $datosbusqueda['limit']!="")
		{
			$sparam['plimit'] = $datosbusqueda['limit'];
		}	
		if (isset ($datosbusqueda['orderby']) && $datosbusqueda['orderby']!="")
		{
			$sparam['porderby'] = $datosbusqueda['orderby'];
		}else {
			$sparam['porderby'] = 'orden desc';
		}	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se han podido obtener los registros por búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		return true;	
	}
	


