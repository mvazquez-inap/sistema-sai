<?php
switch ($_GET['formact_codigo']) {
	case FORMATOCURSO:
		if ($_GET['tipoact_codigo'] == TIPOACTCURSOINAP)
			$oActividad=new cActividadCursoInap($conexion);
		else
			$oActividad=new cActividadCursoJurisdiccional($conexion);

		$oActividadPersona=new cComisionPersona($conexion);
		break;

	case FORMATOEXT:
		$oActividad=new cActividadExterna($conexion);
		$oActividadPersona=new cActividadExternaPersona($conexion);
		$tipoact_codigo=TIPOACTEXTASIS;
		break;

	case FORMATOAUTO:
		$oActividad=new cActividadAutodesarrollo($conexion);
		$oActividadPersona=new cActividadAutodesarrolloPersona($conexion);
		break;

	case FORMATOEFORMAL:
		$oActividad=new cActividadEducacionFormal($conexion);
		$oActividadPersona=new cActividadEducacionFormalPersona($conexion);
		break;

}

$ok = true;
MostrarDatosAsignacion($conexion, $oActividad, $oActividadPersona,
						$_GET['act_codigo'], $_GET['formact_codigo'], $_GET['tipoact_codigo'],
					  	isset($_GET['actprog_sec'])?$_GET['actprog_sec']:"0", $_GET['pers_codigo'],
						isset($_GET['comi_codigo'])?$_GET['comi_codigo']:"0", $_GET['pers_codigo']);

//------------------------------------------------------------------------------------------
function MostrarDatosAsignacion($conexion, $oActividad, $oActividadPersona, $act_codigo, $formact_codigo,
								$tipoact_codigo, $actprog_sec, $pers_codigo, $comi_codigo) {

	// Debe existir la asignacion
	$oPersonas = new cPersonas($conexion);
	$escalafon = new cEscalafones($conexion);
	$jurisdicciones	 = new jurisdicciones;
	$oExpediente = new cExpediente($conexion);

	// Busco la persona
	if(!$oPersonas->TraerDatosPersona_xCod($pers_codigo,$datospersona,$es_modif)) {
		return false;
	} elseif (!$es_modif) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE, "La Persona no se encuentra en el sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	} else {

		$ArregloDatos = array();
		$ArregloDatos['act_codigo'] = $act_codigo;
		$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;

		// Dictamen personal o no
		if (($formact_codigo!=FORMATOAUTO  || ($formact_codigo==FORMATOAUTO && $tipoact_codigo==TIPOACTAUTOEVASIS)))
			$ArregloDatos['actprog_sec'] = $actprog_sec;
		else
			$ArregloDatos['pers_codigo'] = $pers_codigo;

/*		Antes ver
		if (($formact_codigo!=FORMATOAUTO  || ($formact_codigo==FORMATOAUTO && $tipoact_codigo==TIPOACTAUTOEVASIS)) && ($formact_codigo!=FORMATOCURSO))
			$ArregloDatos['actprog_sec'] = $actprog_sec;
		else
			$ArregloDatos['pers_codigo'] = $pers_codigo;

		if($formact_codigo==FORMATOCURSO)
			$ArregloDatos['actprog_sec'] = $actprog_sec;
*/

		// La actividad tiene que estar dictaminada
		/*if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result_dictamen,$error,$errormail) || $numfilas != 1) {

			$txt_sys_mail = "Se encontraron ".$numfilas." dictamenes para \nact_codigo=".$act_codigo;
			$txt_sys_mail .= "\ntipoact_codigo=".$tipoact_codigo;
			$txt_sys_mail .= "\nactprog_sec=".$actprog_sec;
			$txt_sys_mail .= "\npers_codigo=".$pers_codigo;

			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);

			//return false;

		} elseif ($numfilas == 1) {
*/
			// $fila_dictamen = mysql_fetch_assoc($result_dictamen);

			// Busco la asignacion
			// $ArregloDatos['act_codigo'] = $act_codigo;	 	    ya viene
			// $ArregloDatos['tipoact_codigo'] = $tipoact_codigo;	ya viene
			//  Ver es externa
			//if ($formact_codigo!=FORMATOCURSO)
			//	$ArregloDatos['actprog_sec'] = $actprog_sec;		ya viene

			if($formact_codigo!=FORMATOEFORMAL ) {
				if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result_dictamen,$error,$errormail) ) {
					$txt_sys_mail = "Error buscando dictamenes para \nact_codigo=".$act_codigo;
					$txt_sys_mail .= "\ntipoact_codigo=".$tipoact_codigo;
					$txt_sys_mail .= "\nactprog_sec=".$actprog_sec;
					$txt_sys_mail .= "\npers_codigo=".$pers_codigo;
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					return false;
				}
	
				if ($numfilas == 1)
					$fila_dictamen = mysqli_fetch_assoc($result_dictamen);
			}
			
			$ArregloDatos['pers_codigo'] = $pers_codigo;		  	// no viene para dictamenes no personales

			if($formact_codigo==FORMATOCURSO && $comi_codigo != 0) // Solo inap e jurisdiccionales
				$ArregloDatos['comi_codigo'] = $comi_codigo;
			if(!$oActividadPersona->BuscarActividadAsignadaPersona ($ArregloDatos, $numfilasAsignacion, $result, $error, $errormail)) {

				$txt_sys_mail = "Error buscando personas \nact_codigo=".$act_codigo;
				$txt_sys_mail .= "\ntipoact_codigo=".$tipoact_codigo;
				$txt_sys_mail .= "\nactprog_sec=".$actprog_sec;
				$txt_sys_mail .= "\npers_codigo=".$pers_codigo;
				$txt_sys_mail .= "\ncomi_codigo=".$comi_codigo;

				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;

			} elseif($numfilasAsignacion < 1 )	{

				$txt_sys_mail = "La persona no tiene asignada la actividad \nact_codigo=".$act_codigo;
				$txt_sys_mail .= "\ntipoact_codigo=".$tipoact_codigo;
				$txt_sys_mail .= "\nactprog_sec=".$actprog_sec;
				$txt_sys_mail .= "\npers_codigo=".$pers_codigo;
				$txt_sys_mail .= "\ncomi_codigo=".$comi_codigo;

				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"La persona no tiene asignada la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;

			} elseif ($numfilasAsignacion > 1) {

				$txt_sys_mail = "La persona tiene asignada la actividad una cantidad errónea de veces \nact_codigo=".$act_codigo;
				$txt_sys_mail .= "\ntipoact_codigo=".$tipoact_codigo;
				$txt_sys_mail .= "\nactprog_sec=".$actprog_sec;
				$txt_sys_mail .= "\npers_codigo=".$pers_codigo;
				$txt_sys_mail .= "\ncomi_codigo=".$comi_codigo;
				$txt_sys_mail .= "\ncantidad asignaciones=".$numfilasAsignacion;

				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"La persona tiene asignada la actividad más de una vez.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;

			} else {
				$fila_asignacion = mysqli_fetch_assoc($result);

				$jurisdnom="No trabaja en organismo público";

				if ((isset($fila_asignacion['jurisdid_apn']))  || (isset($fila_asignacion['orgapub_codigo'])))
					$oActividad->ObtenerOrganismoInstitucion(NULL,$fila_asignacion['jurisdid_apn'],$fila_asignacion['orgapub_codigo'],$jurisdnom_trabajo,$sector_org,$tipoorg_codigo,$campo_jurisdid);

				if ($formact_codigo!=FORMATOCURSO && $formact_codigo!=FORMATOEFORMAL) {
					
				    if($formact_codigo==FORMATOEXT && !isset($fila_asignacion['exp_codigo']) )
						$fila_asignacion['exp_numero'] = "";
					else 
					{						
						if (!$oExpediente->TraerDatosExpediente($fila_asignacion['exp_codigo'],$fila_expediente,$es_modif_exp)) {
							$txt_sys_mail="Error buscando los datos del expediente. \nexp_codigo=".$fila_asignacion['exp_codigo'];
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar detalles del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
							return false;
						} else {
							$fila_asignacion['jurisdid_inap'] = $fila_expediente['jurisdid_exp'];
							$fila_asignacion['exp_numero'] = $fila_expediente['exp_numero'];
						}
					}
				}
				
			} // BuscarActividadAsignadaPersona
	//	}  // BuscarActividadDictaminadaAvanzada
	} // TraerDatosPersona
?>
	<table width="100%" class="textoTablaDatoBorde" align="center" border="1" cellpadding="4" cellspacing="0">
