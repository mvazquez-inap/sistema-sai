		if ($numfilas>0) {
			$hay_otros_errores = true;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Existen personas inscriptas en la comisión que no tienen el resultado cargado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}		
*/
		// La comisión tiene definido el cronograma.
		$ArregloDatos=array("comi_codigo"=>$datos['comi_codigo']);	
		$oComisionCronograma = new cComisionCronograma($this->conexion);

		if (!$oComisionCronograma->BuscarComiCronograma($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\ncomi_codigo=".$comi_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando datos del cronograma.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		} elseif ($numfilas==0) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión debe tener definida la fecha de realización.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false; 
		}
		
		// La comisión tiene asignado por lo menos un docente. 
		$ArregloDatos=array("comi_codigo"=>$datos['comi_codigo']);	
		$oComisionPrestadorDocente = new cComisionPrestadorDocente($this->conexion);

		if (!$oComisionPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
 			$txt_sys_mail="Error al buscar docentes - \ncomi_codigo=".$datos['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al verificar la cantidad de docentes de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false; 
		} elseif ($numfilas==0) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión debe tener por lo menos un docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false; 
		}

		$datosvalidados = array();
		$datosvalidados['comi_codigo']=$datos['comi_codigo'];		
		
		if ($hay_otros_errores) 
			return false;

		return true;
			
	}
//-----------------------------------------------------------------------------------------------------	
	function ObtenerErroresCertificacionViejo($comi_codigo, &$array_errores) {

		$array_errores= array();

		$ArregloDatos=array("comi_codigo"=>$comi_codigo);	
		if(!$this->BuscarComision($ArregloDatos,$numfilas,$result_comi,$error,$errormail)) {
			return false;
		} elseif ($numfilas!=1) {
			$txt_sys_mail="Error en la cantidad de registros para la comisión (".$numfilas.")\ncomi_codigo=".$comi_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"El estado de la comisión no permite su certificación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		} else 
			$fila_comision = mysqli_fetch_assoc($result_comi);
		
		// Veo si existen alumnos sin definir el resultado volcado (Unico estado no final es cursando) 
		$ArregloDatos= array();
		$ArregloDatos['comi_codigo'] = $comi_codigo;
		$ArregloDatos['eval_codigo'] = EVALCURSANDO;		
		$ArregloDatos['orderby'] = 'pers_apellido,pers_nombre';		

		$oComisionPersona = new cComisionPersona($this->conexion);
		if (!$oComisionPersona->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\nvalor_buscado_".$comi_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscriptos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false; 
		}			
		
		if ($numfilas>0) {
			$array_errores['inscriptos_cursando'] = array();			
			while($fila_inscripto = mysqli_fetch_assoc($result)) {
				$array_errores['inscriptos_cursando'][]=$fila_inscripto['pers_codigo'];
			}			
		}
		
		// Ver si existen alumnos que ya tengan acreditada la actividad de la comisión
		$ArregloDatos= array();
		$ArregloDatos['comi_codigo'] = $comi_codigo;
		if (!$oComisionPersona->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas,$result_inscriptos_comi,$error,$errormail)) {
			$txt_sys_mail="\nvalor_buscado_".$comi_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscriptos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false; 
		}			

		$array_errores['inscriptos_ya_acreditados'] = array();			

		$ArregloDatos = array();
		$ArregloDatos['act_codigo'] = $fila_comision['act_codigo'];

		// Ver si tiene la actividada esa persona 										
		while ($fila_inscripto=mysqli_fetch_assoc($result_inscriptos_comi)) {
			
			// Busco si ya la tiene certificada x otra comision (ACTIVIDAD CURSO)
			$ArregloDatos['pers_codigo'] = $fila_inscripto['pers_codigo'];
			if (!$oComisionPersona->BuscarActividadPersonaCertificada($ArregloDatos,$numfilas,$result,$error,$errormail)) {
				$txt_sys_mail="\nvalor_buscado_".$datos['comi_codigo']."\nerror=".$errormail;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscriptos certificados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false; 
			}

			if ($numfilas!=0) {
				$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_inscripto['tipoact_codigo'],"'"),$tipo_act_descripcion,$numfilastipo,$errorcod); 
				$array_errores['inscriptos_ya_acreditados'][]= array('pers_codigo'=>$fila_inscripto['pers_codigo'],'tipoact_descripcion'=>$tipo_act_descripcion);
			}				

			// Busco si ya la tiene certificada x otro formato (ACTIVIDAD AUTODESARROLLO)
			$oActividadAutodesarrolloPersona = new cActividadAutodesarrolloPersona($this->conexion);
			if(!$oActividadAutodesarrolloPersona -> BuscarActividadPersonaCertificada($ArregloDatos, $numfilasAuto, $resultAuto, $error, $errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			} 
			if ($numfilasAuto != 0) {
				$fila_inscripto_auto=mysqli_fetch_assoc($resultAuto);
				$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_inscripto_auto['tipoact_codigo'],"'"),$tipo_act_descripcion,$numfilastipo,$errorcod); 
				$array_errores['inscriptos_ya_acreditados'][]= array('pers_codigo'=>$fila_inscripto['pers_codigo'],'tipoact_descripcion'=>$tipo_act_descripcion);
			}				
		}
		return true;
	} 
	
//-----------------------------------------------------------------------------------------------------	
function ObtenerErroresCertificacion($comi_codigo, &$array_errores, &$array_tipo_errores) {

	$array_tipo_errores=array(	'hay_error_certificacion'=>false, 			// errores
								'error_inscriptos_cursando'=>false,
								'error_acreditada_curso'=>false,
								'error_acreditada_autodesarrollo'=>false);

	// Datos a mostrar en caso de error
	$array_errores=array();
	$array_errores['inscriptos_ya_acreditados'] = array();			
	$array_errores['inscriptos_cursando'] = array();			


	$ArregloDatos=array("comi_codigo"=>$comi_codigo,"comi_estado"=>COMISIONCERRADA);	
	if(!$this->BuscarComision($ArregloDatos,$numfilas,$resulcomi,$error,$errormail)) {
		$txt_sys_mail="Error al buscar para la comisión CERRADA - \ncomi_codigo=".$comi_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	} elseif ($numfilas!=1) {
		$txt_sys_mail="Hay cero o más de un registros para la comisión (si fue seleccionada debería poder abrirse)\ncomi_codigo=".$comi_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la comisión no permite su certificación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	} 
	$fila_comision=mysqli_fetch_assoc($resulcomi);

	$oActividad = new cActividadCurso($this->conexion);
	
	// Obtengo el tipo dentro del formato curso de la actividad  - 
	$tipo_act_descripcion="";
	if ($oActividad->TieneFormatoTipo($fila_comision['act_codigo'],FORMATOCURSO,TIPOACTCURSOINAP,$tiene_formato_tipo)) 
		if ($tiene_formato_tipo)
			$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",TIPOACTCURSOINAP,"'"),$tipo_act_descripcion,$numfilastipo,$errorcod); 
		else 	
			$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",TIPOACTCURSOJURISD,"'"),$tipo_act_descripcion,$numfilastipo,$errorcod); 

	$oComisionPersona = new cComisionPersona($this->conexion);

	// Los inscriptos a la comisión no deben tener acreditada la actividad
	$verifico_inscripcion = true;
	
	if ($tiene_formato_tipo ) { 
	
		// obtengo el diseño de la actividad
		$oActividadCursoInap= new cActividadCursoInap($this->conexion);
		
		if (!$oActividadCursoInap->TraerDatosActividadCursoInap($fila_comision['act_codigo'],$filacurso,$es_modif))  {
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;		
		}

		if ($filacurso['actividad_curso_inap']['actdisinap_unico'] == NO) 		
			$verifico_inscripcion = false;
		
	}
	
	
	// Obtengo todos los inscriptos de la comisión 
	$ArregloDatos= array();
	$ArregloDatos['comi_codigo'] = $comi_codigo;
	if (!$oComisionPersona->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)) {
		$txt_sys_mail="\nvalor_buscado_".$comi_codigo."\nerror=".$errormail;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscriptos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false; 
	}			

	$ArregloDatos = array();
	$ArregloDatos['act_codigo'] = $fila_comision['act_codigo'];		

	// Armo todas las personas de la comision. (1)
	$arreglo_personas_inscriptas = array();
	$personas_inscriptas = "";

	while ($fila_inscripto=mysqli_fetch_assoc($result)) {
		$arreglo_personas_inscriptas[$fila_inscripto['pers_codigo']] = $fila_inscripto;
		$personas_inscriptas .= $fila_inscripto['pers_codigo'].",";			

		if ($fila_inscripto['eval_codigo'] == EVALCURSANDO) {
			$array_tipo_errores['error_inscriptos_cursando']=true;
			$array_errores['inscriptos_cursando'][]=$fila_inscripto['pers_codigo'];
		}	
	}	
	$personas_inscriptas = substr($personas_inscriptas, 0, -1);  		
	
	if ($array_tipo_errores['error_inscriptos_cursando']) {
		$array_tipo_errores['hay_error_certificacion']=true;
	}

	// Armo todas las evaluaciones que certifican 
	$spnombre="sel_evaluacion_orden";
	$spparam=array('porderby'=>"eval_descripcion");	
	if(!$this->conexion->ejecutarStoredProcedure("sel_evaluacion_orden",$spparam,$resultado,$numfilas,$errno)) {
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al cargar las evaluaciones.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}

	$evaluaciones = "";
	while ($fila_evaluacion=mysqli_fetch_assoc($resultado)) {
		if ($fila_evaluacion['eval_certifica']=="S") 
			$evaluaciones .= $fila_evaluacion['eval_codigo'].",";			
	}
	$evaluaciones = substr($evaluaciones, 0, -1);  		

	// (*) 	Busco los incriptos de la comision  (personas de 1) que tengan la actividad certificada (presente o aprobados)
	// 		la actividad en otra comisión a la actual.
	
	// comision - comision_incripto  
	$ArregloDatos = array();
	$ArregloDatos['comi_codigo'] = $fila_comision['comi_codigo'];
	$ArregloDatos['act_codigo'] = $fila_comision['act_codigo'];		
	$ArregloDatos['pers_codigo'] = $personas_inscriptas;
	$ArregloDatos['eval_codigo'] = $evaluaciones;
	
	
	if ($verifico_inscripcion) {
		// Busco Personas de la comisión (1) que tienen acreditada (certificada) la misma actividad en otra comisión. 
		if (!$oComisionPersona->BuscarPersonasValidasComisionCertificar($ArregloDatos,$numfilas,$result_inscriptos_curso,$error,$errormail)) {
			$txt_sys_mail="\ncomi_codigo".$fila_comision['comi_codigo']."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscriptos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false; 
		}			
		
		// Si el inscripto estaba cursando ver si termino por error o acumulo el error 
	
		// Si el inscripto esta en la busqueda (*) error termino o acumulo
		if ($numfilas!=0) {
			$array_tipo_errores['hay_error_certificacion']=true;
			$array_tipo_errores['error_acreditada_curso']=true;
			while ($fila=mysqli_fetch_assoc($result_inscriptos_curso)) {
				$array_errores['inscriptos_ya_acreditados'][] = array('pers_codigo'=>$fila['pers_codigo'],'tipoact_descripcion'=>$tipo_act_descripcion);
			}
		}
	} //if
		
	
	$oActividadAutodesarrolloPersona = new cActividadAutodesarrolloPersona($this->conexion);
	// (*)(*) Busco asignados si alguna de las pesonas inscriotas tiene acreditada la actividad de 
	// autodesarrollo (personas de 1) 
	
	// actividad_autodesarrollo - actividad_autodesarrollo - dictamen (estado DICTAMENACTIVO / pertinencia SI)
	// Ver si tiene la actividada esa persona en otro formato										
	$ArregloDatos = array();
	$ArregloDatos['act_codigo'] = $fila_comision['act_codigo'];		
	$ArregloDatos['pers_codigo'] = $personas_inscriptas;

	if (!$oActividadAutodesarrolloPersona->BuscarPersonasValidasComisionCertificar($ArregloDatos,$numfilas,$result_inscriptos_auto,$error,$errormail)) {
		$txt_sys_mail="\nact_codigo".$fila_comision['act_codigo']."\nerror=".$errormail;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando acreditaciones de autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false; 
	}			
	
	// Existen personas que tienen acreditada la actividad por autodesarrollo.
	if ($numfilas!=0) {
		$array_tipo_errores['hay_error_certificacion']=true;
		$array_tipo_errores['error_acreditada_autodesarrollo']=true;
		while ($fila=mysqli_fetch_assoc($result_inscriptos_auto)) {
			$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila['tipoact_codigo'],"'"),$tipo_act_descripcion,$numfilastipo,$errorcod); 
			$array_errores['inscriptos_ya_acreditados'][]= array('pers_codigo'=>$fila['pers_codigo'],'tipoact_descripcion'=>$tipo_act_descripcion);
		}
	}
	
	return true;
}
