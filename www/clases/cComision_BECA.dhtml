		if 	($rolcod == USUCURSOINAP )  { //  Si la actividad de la comision es curso INAP esta todo OK.
			 $ArregloDatos['tipoact_codigo']=TIPOACTCURSOINAP;
		} elseif ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO) {  //  Si la actividad de la comision es curso de la jurisdiccion del usuario logueado esta OK.
			 $ArregloDatos['jurisdid_inap']=$_SESSION['jurisdid_inap'];
 			 $ArregloDatos['tipoact_codigo']=TIPOACTCURSOJURISD;
		} 
		
		if(!$this->BuscarComisionAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al verificar el acceso a al comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;	
		}
		if ($numfilas >= 1) 
			return true;	

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para emitir el acta de la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}	


//-----------------------------------------------------------------------------------------------------	
	function TienePermisoInscribirWeb($comi_codigo) {

		// Valida el estado 
		if (!$this->TraerDatosComision($comi_codigo,$fila_comi,$es_modif)) 
			return false;

		$txt_sys_mail="\comi_codigo=".$comi_codigo;			
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error, no existe la Comisión para rectificar resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
		if (($fila_comi['comi_estado'] != COMISIONNUEVA) && ($fila_comi['comi_estado'] != COMISIONABIERTA))  {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La Comisión no se encuentra disponible para Inscribir agentes. <br>Consulte con su Coordinador Técnico de Capacitación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			die();
			return false;
		}
		
		
		// Valida que la comisión tenga habilitado inscripción web
		if ($fila_comi['comi_web'] != "S")  {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La Comisión no está habilitada para permitir la inscripción vía Web.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			die();
			return false;
		}
		
	
		return true;
	}	



//-----------------------------------------------------------------------------------------------------	
	function ArmarFiltroBuscador($datosFiltro,&$arraysalida) {
	
			$arraysalida=array();
			$arraysalida['act_nombre']=trim($datosFiltro['act_nombre']);
			
			$arraysalida['act_codinap']=trim($datosFiltro['act_codinap']);
			$arraysalida['comi_codinap']=trim($datosFiltro['comi_codinap']);
	
			$arraysalida['tipo_fecha']=$datosFiltro['tipo_fecha'];
				
			$arraysalida['comi_estado']=$datosFiltro['comi_estado'];
				
			if (isset($datosFiltro['comi_fecha_inicio'])) 
				$arraysalida['comi_fecha_inicio']=FuncionesPHPLocal::ConvertirFecha($datosFiltro['comi_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd');
				
			if (isset($datosFiltro['comi_fecha_fin'])) 
				$arraysalida['comi_fecha_fin']=FuncionesPHPLocal::ConvertirFecha($datosFiltro['comi_fecha_fin'],'dd/mm/aaaa','aaaa-mm-dd');
		
			if (isset($datosFiltro['presdoc_apeynom'])) 
				$arraysalida['apeynom']=trim($datosFiltro['presdoc_apeynom']);
			
			$arraysalida['tipoact_codigo']=$datosFiltro['tipoact_codigo'];

			$arraysalida['jurisdid_inap']=$datosFiltro['jurisdid_inap'];			
			
			$arraysalida['progcur_codigo']=$datosFiltro['progcur_codigo'];

			$arraysalida['areacur_codigo']=$datosFiltro['areacur_codigo'];
														
			$arraysalida['orderby']="act_nombre,act_codigo,comi_fecha_inicio";
			
			return true;			
	} 
}
?>