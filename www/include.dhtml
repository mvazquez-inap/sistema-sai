<?php
// magic_quotes_gpc was On and this app never calls stripslashes.
// Put that slash back on the request once, before password md5() and before
// SQL is concatenated. mysqli_real_escape_string then stores the same extra
// slash production stored. Rows read from MySQL are not in these arrays.
if (!function_exists('sai_apply_magic_quotes_gpc')) {
    function sai_apply_magic_quotes_gpc($value)
    {
        if (is_array($value)) {
            foreach ($value as $key => $item) {
                $value[$key] = sai_apply_magic_quotes_gpc($item);
            }
            return $value;
        }
        if (is_string($value)) {
            return addslashes($value);
        }
        return $value;
    }
}
if (!defined('SAI_MAGIC_QUOTES_GPC')) {
    define('SAI_MAGIC_QUOTES_GPC', true);
    if (!function_exists('get_magic_quotes_gpc') || !get_magic_quotes_gpc()) {
        $_GET = sai_apply_magic_quotes_gpc($_GET);
        $_POST = sai_apply_magic_quotes_gpc($_POST);
        $_COOKIE = sai_apply_magic_quotes_gpc($_COOKIE);
        $_REQUEST = sai_apply_magic_quotes_gpc($_REQUEST);
    }
}
set_include_path('/var/www/sys');
ini_set("mysql.trace_mode",0);
ini_set("memory_limit","128M");

