//----------------------------------------------------------------------------------------- 
// Permite cargar el formato y las etiquetas de un eje y

// Parámetros:
//		$eje: indica el eje sobre el que se va a aplicar las etiquetas. Debe ser habilitado con anterioridad el eje.
//		$comienzo: indica el valor con el que va a comenzar el eje y. Valor 
//		$fin: indica el valor con el que va a terminar el eje y
//		$paso: indica cada cuanto va a haber una etiqueta en el eje y. Expresado en unidades de comienzo y fin.
//		$unidadmedida: indica el tipo de formato que se va a aplicar a los textos, tanto en la etiqueta como en los puntos
//		$fuente,$tamanio,$color,$angulo: formato de las etiquetas
	
	function y_Etiquetas($eje,$comienzo,$fin,$paso,$unidadmedida,$fuente,$tamanio,$color,$angulo)
	{
		// el eje tiene que estar habilitado
		if(!in_array($eje,$this->EjesActivos))
		{
			$this->_SetearError(1,__FUNCTION__,__LINE__);
			return false;
		}
		
		// solo se permiten valores numericos como comienzo y fin
		if(!is_numeric($comienzo) || !is_numeric($fin))
		{
			$this->_SetearError(2,__FUNCTION__,__LINE__);
			return false;
		}
		
		// solo se permiten ejes ascendentes
		if($comienzo>=$fin)
		{
			$this->_SetearError(3,__FUNCTION__,__LINE__);
			return false;
		}
		
/*		// el paso debe ser multiplo en el rango comienzo->fin
		if(round(($fin-$comienzo)/$paso)*$paso!=($fin-$comienzo))
		{
			$this->_SetearError(4,__FUNCTION__,__LINE__);
			return false;
		}*/
		
		$multiplicador=1;
		if(is_float($paso))
			$multiplicador=pow(10,strlen(substr($paso-intval($paso),2)));

		if(((($fin-$comienzo)*$multiplicador) % ($paso*$multiplicador)) != 0)
		{
			$this->_SetearError(4,__FUNCTION__,__LINE__);
			return false;
		}
		
		// obtengo todos los metodos de la clase
		$metodos_clase = get_class_methods(get_class($this));
		$valorvalido=false;
		
		//recorro todos los metodos
		foreach($metodos_clase as $metodo)
		{
			// si el metodo es uno que define el tipo de punto
			if(substr($metodo,0,10)=="unidmedida")
			{
				// si el valor es el que me enviaron, entonces es valido
				if($this->$metodo() == $unidadmedida)
				{
					$valorvalido=true;
				}
			}
		}

		// el valor enviado como tipopunto no es valido
		if(!$valorvalido)
		{
			$this->_SetearError(22,__FUNCTION__,__LINE__);
			return false;
		}
		
		if(!$this->_VerificarFuente($this->dir_fuentes.$fuente))
			return false;

		if(!$this->_VerificarTamanio($tamanio))
			return false;

		if(!$this->_VerificarColor($color))
			return false;

		if(!$this->_VerificarAngulo($angulo))
			return false;
		
		$this->formato_etiq_y[$eje]["comienzo"]=$comienzo;
		$this->formato_etiq_y[$eje]["fin"]=$fin;
		$this->formato_etiq_y[$eje]["paso"]=$paso;
		$this->formato_etiq_y[$eje]["unidadmedida"]=$unidadmedida;
		$this->formato_etiq_y[$eje]["fuente"]=$this->dir_fuentes.$fuente;
		$this->formato_etiq_y[$eje]["tamanio"]=$tamanio;
		$this->formato_etiq_y[$eje]["color"]=$color;
		$this->formato_etiq_y[$eje]["angulo"]=$angulo;
		
		return true;
	} // fin de y_Etiquetas

//----------------------------------------------------------------------------------------- 
// Permite cargar la leyenda del eje y y su formato

// Parámetros:
//		$eje: indica el eje sobre el que se va a aplicar las leyendas. Debe ser habilitado con anterioridad el eje.
//		$textoleyenda: el texto que va a aparecer como leyenda del eje x
//		$fuente,$tamanio,$color: formato de la leyenda

	function y_Leyenda($eje,$textoleyenda,$fuente,$tamanio,$color)
	{
		// el eje tiene que estar habilitado
		if(!in_array($eje,$this->EjesActivos))
		{
			$this->_SetearError(1,__FUNCTION__,__LINE__);
			return false;
		}

		if(!$this->_VerificarFuente($this->dir_fuentes.$fuente))
			return false;

		if(!$this->_VerificarTamanio($tamanio))
			return false;

		if(!$this->_VerificarColor($color))
			return false;

		$this->leyenda_y[$eje]["texto"]=$textoleyenda;
		$this->leyenda_y[$eje]["fuente"]=$this->dir_fuentes.$fuente;
		$this->leyenda_y[$eje]["tamanio"]=$tamanio;
		$this->leyenda_y[$eje]["color"]=$color;
		
		return true;
	} // fin de x_Leyenda
	
