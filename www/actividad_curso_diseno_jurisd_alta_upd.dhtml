<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oActividadCursoJurisdiccional= new cActividadCursoJurisdiccional($conexion);
//----------------------------------------------------------------------------------------- 	
if (!$_SESSION['carga_inicial']) {
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Esta reintentando realizar una operación ya efectuada.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
} else {
	$conexion->ManejoTransacciones("B");
	if($oActividadCursoJurisdiccional->AltaDatosActividadCursoJurisdiccional($_POST,$act_codigo,$act_codinap)) {
		FuncionesPHPLocal::RegistrarAcceso($conexion,"38301","act_codigo=".$act_codigo,$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de alta el diseño del curso Jurisdiccional con el código ".$act_codinap,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
		$_SESSION['carga_inicial']=false;
	} else 
		$conexion->ManejoTransacciones("R");
}
?>	
    <br>
    <div align="center"><a href="actividad_curso_prestador_docente.dhtml?act_codigo=<?php echo $act_codigo?> " class="linkFondoBlanco">Actualizar Equipo de Prestadores Docentes</a></div>

	<br><div align="center"><a href="actividad_curso_diseno_jurisd_alta.dhtml" class="linkFondoBlanco">Volver</a></div>
<?php 
$oEncabezados->PieMenuEmergente();
?>