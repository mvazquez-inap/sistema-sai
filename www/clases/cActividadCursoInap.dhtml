//-----------------------------------------------------------------------------------------------------
	function ListarDisenoActividadPDF($act_codigo) {
		function GenerarActividadDiseno(&$pdf,$filacurso,$prestadores) {

			$pdf->AddAcividadDiseno();
			$pdf->Set('datos_actividad',$filacurso);
			$pdf->Set('datos_actividad_prestador',$prestadores);
			$pdf->Set('formact_codigo',FORMATOCURSO);
			$pdf->Set('tipoact_codigo',$filacurso['actividad_curso']['tipoact_codigo']);

		} // GenerarActa

		if (!$this->TraerDatosActividadCursoInap($act_codigo,$filacurso,$es_modif))  {
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} elseif (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		$descri="";
		if ($this->conexion->TraerCampo("programa_curso_inap","progcur_descripcion",array("progcur_codigo='",$filacurso['actividad_curso_inap']['progcur_codigo'],"'"),$descri,$numfilas,$errorcod))
			$filacurso['actividad_curso_inap'] += array('progcur_descripcion'=>$descri);

		$descri="";
		if ($this->conexion->TraerCampo("area_curso_inap","areacur_descripcion",array("areacur_codigo='",$filacurso['actividad_curso_inap']['areacur_codigo'],"'"),$descri,$numfilas,$errorcod))
			$filacurso['actividad_curso_inap'] +=  array('areacur_descripcion'=>$descri);

		$descri="";
		if ($this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$filacurso['actividad_curso']['actcur_estado'],"'"),$descri,$numfilas,$errorcod))
			$filacurso['actividad_curso'] += array('actcur_estado_desc'=>$descri);

		// Selecciono todos los prestadores asociados a la actividad.
		$oPrestadorDocente = new cPrestadorDocente($this->conexion);
		$ArregloDatos = array();
		$ArregloDatos['act_codigo']=$act_codigo;

		if(!$oPrestadorDocente->BuscarPrestadorDocentexActividad($ArregloDatos,$numfilas,$prestadores,$error,$errormail)) {
			$txt_sys_mail="\nact_codigo=".$act_codigo."\nerror=".$error;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}
		$pdf = new cActividadDisenoPDF();
		GenerarActividadDiseno($pdf,$filacurso,$prestadores);
		$pdf->MostrarActividadDiseno($this->conexion);
		$pdf->Output("disenoActividad.pdf","I");

		return true;
	}
