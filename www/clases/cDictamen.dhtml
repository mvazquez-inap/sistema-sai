					if (!$this->MostrarDatosProgramaciones($conexion, $oActividad, $fila_detalle['act_codigo'], $fila_detalle['tipoact_codigo'])) 
						$ok=false;
				?></td>
			</tr>
		</table>
	<?php 
		return $ok;
} 
