<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oActividadCursoJurisdiccional= new cActividadCursoJurisdiccional($conexion);
//----------------------------------------------------------------------------------------- 
?>
<script type="text/javascript">
	<?php $oActividadCursoJurisdiccional->ValidarFormAltaActividadCursoJurisdiccional(); ?>
</script>
<?php 
$filacurso=array();
$filacurso['act_codinap']=(isset($_POST['act_codinap_seleccion']))?$_POST['act_codinap_seleccion']:"";
$filacurso['act_codigo']=(isset($_POST['act_codigo']))?$_POST['act_codigo']:"";

if (isset($_POST['act_codinap_seleccion'])) {
	if($conexion->TraerCampo("actividad","act_codigo",array("act_codinap='",$_POST['act_codinap_seleccion'],"'"),$act_codigo,$numfilas,$errno))
		$filacurso['act_codigo']=htmlspecialchars($act_codigo,ENT_QUOTES);
}
$destino_formulario_interface="actividad_curso_diseno_jurisd_baja.dhtml";
?>
<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oActividadCursoJurisdiccional->PedirActividad($filacurso['act_codinap'],'formulario_seleccion','act_codinap_seleccion','Actualizar');  ?></td>
	</tr>
	</table>
</form>	
<?php
$es_modif=false;
$ok=false;
if ($filacurso['act_codigo']=="") {
	if(isset($_POST['act_codigo']) || isset($_POST['act_codinap_seleccion']) )
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
} else {
	
	if ($oActividadCursoJurisdiccional->TraerDatosActividadCursoJurisdiccional($filacurso['act_codigo'],$filacurso,$es_modif)) {
		if (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else { // Es actividad curso jurosdiccional
			if ($oActividadCursoJurisdiccional->TienePermisoBaja($filacurso['actividad']['act_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
					$oDictamen = new cDictamen($conexion);
					$ArregloDatos=array('act_codigo'=>$filacurso['actividad']['act_codigo']);
					$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
					if($error) 
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $errormail);
					else {
						if ($numfilas>0) 
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La actividad no puede ser eliminada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						else // No tiene dictamen
							$ok=true;		
					}		
			} // Tiene permiso el usuario sobre la actividad	
		}	// Se encontró la actividad con el formato esperado		
	} // No se produjo error al buscar la actividad con el formato esperado	

}

if ($ok) { 
	$destino_formulario_upd="actividad_curso_diseno_jurisd_baja_upd.dhtml";?>

	<form action="#" method="post" name="formulario_mostrar">
<?php	if(!$oActividadCursoJurisdiccional->MostrarDatosActividadCursoJurisdiccional($conexion,"V",$filacurso)){ 
	 	$ok=false;
	} else {		
?>	<br> <?php
		// Muestro los prestadores docentes de la actividad		
		$oActividadCursoJurisdiccional->MostrarPrestadoresActividad($conexion,$filacurso['actividad']['act_codigo']);
	}
?>	</form>		

<?php	if($ok) { ?>
		<br>
		<form action="<?php echo $destino_formulario_upd ?>" method="post" name="formulario">
		<table width="100%" class="textoTablaDato" align="center">
			<tr align="center">
				<td colspan="2" valign="top">
					<input type="submit" name="boton_confirma" class="botones" value="Confirma Baja">
					&nbsp;&nbsp;&nbsp;&nbsp;
					<input type="hidden" name="act_codigo" value="<?php echo ($es_modif)?htmlspecialchars($filacurso['actividad']['act_codigo'],ENT_QUOTES):""; ?>">
				</td>
			</tr>	
		</table>
	</form>	
<?php	} // ok 
} // fin ok
$oEncabezados->PieMenuEmergente(); 
//---------------------------------------------------------------------------------------
?>
