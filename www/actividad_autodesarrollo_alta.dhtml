<?php 
$operacion_evento = "A";
$tipoact_codigo	= "";

if (isset($_POST['act_codinap_seleccion'])) {
	
	$operacion = "M";			
	if($conexion->TraerCampo("actividad","act_codigo",array("act_codinap='",$_POST['act_codinap_seleccion'],"'"),$act_codigo,$numfilas,$errno))
		$filaauto['act_codigo']=htmlspecialchars($act_codigo,ENT_QUOTES);
	
	if ($oActividadAutodesarrollo->TraerDatosActividad($filaauto['act_codigo'],$filaact,$es_modif)) {
		$filaauto['actividad'] = $filaact;
		if (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok = false;
		}	// Se encontró la actividad con el formato esperado		
	} // No se produjo error al buscar la actividad con el formato esperado		

	if ($ok) {
		$act_codigo = $filaauto['act_codigo'];
		
		$oActividadAutodesarrollo -> ObtenerTipos($act_codigo, $tipos_auto);
		$oActividadCurso = new cActividadCurso($conexion);
		$oActividadCurso -> ObtenerTipos($act_codigo, $tipos_curso);
		$tiene_todos_auto = false;
		
		if (count($tipos_curso) > 0 && count($tipos_auto) > 0 && in_array(TIPOACTAUTODOCENTE,$tipos_auto)) 
			$tiene_todos_auto = true;
		
	
		if (count($tipos_auto) > 0 && ( (in_array(TIPOACTAUTOEVASIS,$tipos_auto) && in_array(TIPOACTAUTOEVACT,$tipos_auto)) || in_array(TIPOACTAUTODOCENTE,$tipos_auto) || in_array(TIPOACTAUTOPUBLI,$tipos_auto) || in_array(TIPOACTAUTOASISTEC,$tipos_auto) || in_array(TIPOACTAUTOAAUTOFORM,$tipos_auto) )) 
			$tiene_todos_auto = true;	
	
		$tiene_formato_curso = (count($tipos_curso)>0); 
		$tiene_formato_auto  = (count($tipos_auto)>0);

		if (!$tiene_formato_curso &&  !$tiene_formato_auto) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"A la actividad no se le puede asignar el formato de Autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
			$ok =  false;
		} elseif ($tiene_todos_auto) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La actividad ya tiene todos los tipos de Autodesarrollo asignados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
			$ok =  false;
		} 
		
		if ($tiene_formato_curso) {
			$operacion = "V";
			$tipoact_codigo = 1;
		}	
			
		if ($tiene_formato_auto) {
			$operacion_evento = "A";
			$operacion = "V";
			if (in_array(TIPOACTAUTOEVACT,$tipos_auto)) 
					$tipoact_codigo = TIPOACTAUTOEVACT;
			if (in_array(TIPOACTAUTOEVASIS,$tipos_auto)) 
					$tipoact_codigo = TIPOACTAUTOEVASIS;
		}		
		
	} // if OK
} else 	
	$operacion = "A";

	if ($ok) { ?>
		<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario" id="formulario">
	<?php		if($oActividadAutodesarrollo->MostrarDatoActividadAutodesarrollo($conexion,$operacion,$operacion_evento,$filaauto,$tipoact_codigo)) { ?>
			<table width="100%" class="textoTablaDato" align="center">
				<tr align="center">
					<td colspan="2" valign="top">
						<input type="hidden" name="es_nueva" value="<?php echo isset($_POST['act_codinap_seleccion'])? "no":"si"?>" />
						<input type="hidden" name="act_codigo" value="<?php echo isset($filaauto['act_codigo'])?$filaauto['act_codigo']:""  ?>" />
						<input type="submit" name="boton_confirma" class="botones" value="Confirma Alta" onClick="return ValidarFormAltaActividad(formulario,'A') &amp;&amp; ValidarFormAltaActividadAutodesarrollo(formulario,'A');">
						&nbsp;&nbsp;&nbsp;&nbsp;
					</td>
				</tr>	
			</table>
		<?php } ?>
		</form>	
<?php } // if ok 
$oEncabezados->PieMenuEmergente(); 
