	function ValidarFormAltaActividadExternaPersona(formulario,operacion) {

			// Expediente 	- [exp_codigo] 	- [OBLIG]
            /* Cambio no se tramita con expediente
			if ((trim(formulario.exp_codigo.value)=="")) {
				alert("Debe ingresar el Expediente");
				formulario.img_exp.focus();
				return false;
			}
			*/
			var fechainicio=ConvertirFecha(formulario.actext_act_fecha_inicio.value,'dd/mm/aaaa','aaaammdd');
			var fechafin=ConvertirFecha(formulario.actext_act_fecha_fin.value,'dd/mm/aaaa','aaaammdd');

			// Fecha de Inicio - [actext_act_fecha_inicio] - [OBLIG]
			if (formulario.actext_act_fecha_inicio.value=="" || !ValidarFecha(formulario.actext_act_fecha_inicio.value))
			{
				alert("La fecha de inicio no es válida");
				formulario.actext_act_fecha_inicio.focus();
				return false;
			}

			// La fecha de inicio debe ser posterior a la de inicio INAP
			if (fechainicio < '<?php echo ANOINICALINAP."0101" ?>') {
				alert("La fecha de inicio debe ser mayor o igual a <?php echo "01/01/".ANOINICALINAP ?>");
				formulario.actext_act_fecha_inicio.focus();
				return false;
			}

			var fecha_prog_inicio=ConvertirFecha(formulario.actprog_fecha_inicio.value,'aaaa-mm-dd','aaaammdd');
			var fecha_prog_fin=ConvertirFecha(formulario.actprog_fecha_fin.value,'aaaa-mm-dd','aaaammdd');

			// Fecha de Inicio tiene que estar dentro de la programación
			if (!(fechainicio>=fecha_prog_inicio && fechainicio <= fecha_prog_fin )) {
				alert("La fecha de inicio debe estar comprendida en la programación");
				formulario.actext_act_fecha_inicio.focus();
				return false;
			}

			// Fecha de Fin tiene que estar dentro de la programación
			if (!(fechafin>= fecha_prog_inicio && fechafin<= fecha_prog_fin )) {
				alert("La fecha de fin debe estar comprendida en la programación");
				formulario.actext_act_fecha_fin.focus();
				return false;
			}

			// Fecha de fin - [actext_act_fecha_fin] - [OBLIG]
			if (formulario.actext_act_fecha_fin.value=="" || !ValidarFecha(formulario.actext_act_fecha_fin.value)) {
				alert("La fecha de finalización no es válida");
				formulario.actext_act_fecha_fin.focus();
				return false;
			}

			// La fecha de fin debe ser posterior a la de inicio INAP
			if (fechafin< '<?php echo ANOINICALINAP."0101" ?>') {
				alert("La fecha de finalización mayor o igual a <?php echo "01/01/".ANOINICALINAP ?>");
				formulario.actext_act_fecha_fin.focus();
				return false;
			}

			// Fecha de Inicio >= Fecha de Fin
			if (fechainicio>fechafin) 	{
				alert("La fecha de finalización debe ser mayor o igual que la fecha de inicio");
				formulario.actext_act_fecha_inicio.focus();
				return false;
			}

			if (trim(formulario.nivest_codigo.value)==""){
				alert("Debe ingresar el Último nivel de estudios alcanzado");
				formulario.nivest_codigo.focus();
				return false;
			}

			if (trim(formulario.agentes_a_cargo.value)==""){
				alert("Debe ingresar la Cantidad de agentes a cargo");
				formulario.agentes_a_cargo.focus();
				return false;
			}

			if (trim(formulario.paiscod_revista.value)==""){
				alert("Debe ingresar el País de revista");
				formulario.paiscod_revista.focus();
				return false;
			}

			if (formulario.paiscod_revista.value == <?php echo ARGENTINA?> ) {
				if (trim(formulario.provinciacod_revista.value)==""){
					alert("Debe ingresar la provincia de revista");
					formulario.provinciacod_revista.focus();
					return false;
				}
			}


			// Situación escalafonaria    - [esc_agrup_niv_grado] 	- [OBLIG]
			if ((trim(formulario.esc_agrup_niv_grado.value)=="")){
				alert("Debe ingresar una situación escalafonaria válida");
				return false;
			}
			// El Agente debe ser SINEP
			if (formulario.esc_agrup_niv_grado.value.substr(0,4)!="<?php echo SINEP?>"){
				alert("Debe seleccionar un Agente SINEP");
				return false;
			}


			if (trim(formulario.jurisdid.value)==""){
				alert("Debe ingresar un Organismo donde trabaja el agente válido");
				formulario.jurisdid.focus();
				return false;
			}

			if (formulario.escalafon.value == "A") {
				if ((trim(formulario.agfunc_codigo.value)=="")){
					alert("Debe ingresar una función válida");
					formulario.agfunc_codigo.focus();
					return false;
				}
			}

		return true;
		}

		function SeleccionPais(formulario){
			var elSelect = document.getElementById('datos_provincia');
			if (formulario.paiscod_revista.value == <?php echo ARGENTINA ?>) {
				elSelect.style.display ="block";
			} else {
				elSelect.style.display ="none";
			}
		}

