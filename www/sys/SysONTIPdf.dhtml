<?php 
require_once('pdf/class.fpdf_table.php');

class cPDF extends FPDF_TABLE {

	var $array_estilos=array();
	var $estilo_actual=array();
	var $arreglo_tablas_default=array();

	public function __construct()
	{
		$this->FPDF_TABLE();
		$estilo="";
		$arregloatributos=array(  'BackgroundColor'=>"#FFFFFF",
								  'TextColor'=>"#000000",
								  'Font'=>array('family'=>"Arial",'weigth'=>'B',"size"=>12)
							    );
		$this->AddEstilo($estilo,$arregloatributos);
		
		$arreglotablas=$this->CargarEstilosTablasDefault();
		foreach ($arreglotablas as $clave=>$valor)
			$this->SetEstiloTablaDefault($clave,$valor);
		
	}
	
	
	
	function VerificarAltoHoja($altoMaxPag)
	{
		if ($this->GetY()>$altoMaxPag)
		{
			$x=$this->GetX();
			$this->AddPage();
			$this->SetY($this->tMargin);
			$this->SetX($x);
		}
	
	}

	
	
	
	
	
	

	//-----------------------------------------------------------------------------------------
	function CellXY($x,$y,$w,$h,$texto,$border=0,$ln=0,$align='',$fill=0,$link='') {
		//$this->CargarFormato();
		$this->SetXY($x,$y);
		//$this->Cell($w,$h,$texto,$this->Formato['Border'],$ln,$this->Formato['Align'],$this->Formato['Fill'],$this->Link);
		$this->Cell($w,$h,$texto,$border,$ln,$align,$fill,$link);
	}
	//-----------------------------------------------------------------------------------------
	
	
	





//----------------------------------------------------------------------------------------//
// FORMATO 
//----------------------------------------------------------------------------------------//


	//---------------------------------------//
	// FORMATO TABLAS
	//---------------------------------------//
	
	
	function SetEstiloTablaDefault($estilo_tabla,$array_estilo_tabla)
	{
		$this->arreglo_tablas_default[$estilo_tabla]=$array_estilo_tabla;
	}
	
	
	function SetEstiloDatoTabla(&$estilo_columna,$atributo,$dato_atributo)
	{
		$estilo_columna[$atributo]=$dato_atributo;
	}
	
	function GetEstiloTablaDefault($estilo_tabla)
	{
		return $this->arreglo_tablas_default[$estilo_tabla];
	}
	
	
	function CargarEstilosTablasDefault()
	{
	
		 $table_default_header_type = array(
						'WIDTH' => 6,
						'T_COLOR' => array(10,10,10),
						'T_SIZE' => 11,
						'T_FONT' => 'Arial',
						'T_ALIGN' => 'C',
						'V_ALIGN' => 'T',
						'T_TYPE' => 'B',
						'LN_SIZE' => 7,
						'BG_COLOR' => array(0,199,229),
						'BRD_COLOR' => array(0,92,177),
						'BRD_SIZE' => 0.2,
						'BRD_TYPE' => '1',
						'BRD_TYPE_NEW_PAGE' => '',
						'TEXT' => '',
						);
		 $table_default_data_type = array(
						'T_COLOR' => array(0,0,0),
						'T_SIZE' => 10,
						'T_FONT' => 'Arial',
						'T_ALIGN' => 'C',
						'V_ALIGN' => 'M',
						'T_TYPE' => '',
						'LN_SIZE' => 5,
						'BG_COLOR' => array(255,255,255),
						'BRD_COLOR' => array(0,0,0),
						'BRD_SIZE' => 0.1,
						'BRD_TYPE' => '1',
						'BRD_TYPE_NEW_PAGE' => '',
						);
		 $table_default_table_type = array(
						'TB_ALIGN' => 'L',
						'L_MARGIN' => 25,
						'BRD_COLOR' => array(0,0,0),
						'BRD_SIZE' => '0.4',
						);

		return array("table_default_header_type"=>$table_default_header_type,"table_default_data_type"=>$table_default_data_type,"table_default_table_type"=>$table_default_table_type);
	}
	
	//---------------------------------------//
	//***************************************//
	//---------------------------------------//
	
	
	
	
	function AddEstilo($estilo,$arregloatributos)
	{
		$this->array_estilos[$estilo]=$arregloatributos;
	}
	
	
	function GetEstilo($estilo)
	{
		return $this->array_estilos[$estilo];
	}
	
	
	function SetearFormato($estilo)
	{
	
		if ($estilo!=$this->estilo_actual)
		{
			$array_atributos=$this->GetEstilo($estilo);
			$this->estilo_actual=$estilo;
		}else
			$array_atributos=$this->GetEstilo($this->estilo_actual);
		
		
		$arreglocolores=$this->_ConvertirHexaRGB($array_atributos['BackgroundColor'],$arreglocolores);
		$this->SetFillColor($arreglocolores['r'],$arreglocolores['g'],$arreglocolores['b']);
		
		$arreglocolores=$this->_ConvertirHexaRGB($array_atributos['TextColor'],$arreglocolores);
		$this->SetTextColor($arreglocolores['r'],$arreglocolores['g'],$arreglocolores['b']);

		if (array_key_exists('DrawColor',$array_atributos))
		{
			$arreglocolores=$this->_ConvertirHexaRGB($array_atributos['DrawColor'],$arreglocolores);
			$this->SetDrawColor($arreglocolores['r'],$arreglocolores['g'],$arreglocolores['b']);
		}
		$this->SetFont($array_atributos['Font']['family'],$array_atributos['Font']['weigth'],$array_atributos['Font']['size']);
	}
	
	
	
	function GetRGBColor($color,&$r,&$g,&$b)	{
		switch ($color) {
			case "gris" : 
				$r=153;	$g=153;	$b=153;
				break;
			case "azul":
				$r=0; $g=0;	$b=255;
				break;
			case "rojo":
				$r=255;	$g=0; $b=0;
				break;
			case "magenta":
				$r=255; $g=0; $b=255;
				break;
			case "negro":
				$r=0; $g=0;	$b=0;
				break;
			case "blanco":
				$r=255; $g=255;	$b=255;
				break;
			case "cyan":
				$r=0; $g=255; $b=255;
				break;
			case "marron":
				$r=153; $g=0; $b=0;
				break;
			case "amarillo":
				$r=255; $g=0; $b=0;
				break;			
			case "aqua":
				$r=0; $g=255;$b=255;
				break;		
			case "lima":
				$r=0; $g=255; $b=255;
				break;			
			case "fuxia":
				$r=255;	$g=51; $b=153;
				break;
			case "violetaoscuro":
				$r=67; $g=0; $b=134;
				break;
			case "naranja":
				$r=255; $g=153;	$b=51;
				break;
			case "violeta":
				$r=204; $g=51; $b=255;
				break;
			case "plata":
				$r=229; $g=229;	$b=229;
				break;
			default:
				$r=0;$g=0;$b=0;
		}
	}
	
	
	
	
	function _ConvertirHexaRGB($color,&$arreglodevuelto)
	{
		$arreglodevuelto=array();
		if ($color[0] == '#')
			$color = substr($color, 1);
	
		if (strlen($color) == 6)
			list($r, $g, $b) = array($color[0].$color[1],
									 $color[2].$color[3],
									 $color[4].$color[5]);
		elseif (strlen($color) == 3)
			list($r, $g, $b) = array($color[0], $color[1], $color[2]);
		else
			return false;

		$arreglodevuelto[]=hexdec($r);
		$arreglodevuelto[]=hexdec($g);
		$arreglodevuelto[]=hexdec($b);
		
		return array('r'=>hexdec($r),'g'=>hexdec($g),'b'=>hexdec($b));
	}	
	
	
	
	
	
