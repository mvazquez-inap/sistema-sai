<?php require('./include.dhtml');
$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
//----------------------------------------------------------------------------------------- 
// Recibe: lista_cadena = codigo_dic_1+"_"+codigo_dic_2+....
function ListarDictamenes($conexion,$lista_cadena) {
	
	$filtroDatos=array();
	$filtroDatos['dictamen_en']=$lista_cadena;

	$oDictamen = new cDictamen($conexion);	

	if ($oDictamen->ObtenerDictamenesxFormato($filtroDatos,$resultDicActCurso, $numfilas_DicActCurso,
											$resultDicActExt,$numfilas_DicActExt, 
											$resultDicActAuto,$numfilas_DicActAuto) ){ 
	
		// Según el formato de dictámenes que haya qye lista listar
		if($numfilas_DicActCurso>0) {  
	
			if (!$oDictamen->AgregarDetalleDictamenActCurso($resultDicActCurso,
							$array_DictamenesActCursoInap,
							$array_DictamenesActCursoInstitucional,
							$array_DictamenesActCursoJurisdiccional))  
			return false;
	
			if (count($array_DictamenesActCursoInap)>0)  { 			?>
				<table width="98%" class="textoTablaDato" align="center" cellpadding="0" cellspacing="0" border="0">
					<tr>
						<td class="textoEtiquetaDatoResaltado">Dictámenes de Actividades Formato Curso INAP</td>					
					</tr>		
					<tr>
						<td><?php $oDictamen->ListarDictamenActCurso($array_DictamenesActCursoInap); ?></td>					
					</tr>		
					<tr>
						<td>&nbsp;</td>					
					</tr>				
				</table>
			<?php } // count($array_DictamenesActCursoInap) >0 
	
			if (count($array_DictamenesActCursoInstitucional)>0)  { ?>
				<table width="98%" class="textoTablaDato" align="center" cellpadding="0" cellspacing="0" border="0">
					<tr>
						<td class="textoEtiquetaDatoResaltado">Dictámenes de Actividades Formato Curso Institucional</td>					
					</tr>		
					<tr>
						<td><?php $oDictamen->ListarDictamenActCurso($array_DictamenesActCursoInstitucional); ?></td>					
					</tr>		
					<tr>
						<td>&nbsp;</td>					
					</tr>		
				</table>
			<?php } // count($array_DictamenesActCursoInstitucional) >0 
	
			 if (count($array_DictamenesActCursoJurisdiccional)>0)  { ?>
				<table width="98%" class="textoTablaDato" align="center" cellpadding="0" cellspacing="0" border="0">
					<tr>
						<td class="textoEtiquetaDatoResaltado">Dictámenes de Actividades Formato Curso Jurisdiccional</td>					
					</tr>		
					<tr>
						<td><?php $oDictamen->ListarDictamenActCurso($array_DictamenesActCursoJurisdiccional);?></td>					
					</tr>		
					<tr>
						<td>&nbsp;</td>					
					</tr>		
				</table>
		<?php } // count($array_DictamenesActCursoJurisdiccional) >0 	
		} // $numfilas_DicActCurso>0
		
		if($numfilas_DicActExt>0) {
		
			if (!$oDictamen->AgregarDetalleDictamenActExterna($resultDicActExt,$array_DictamenesActExt)) 
				return false;											
			?>
				<table width="98%" class="textoTablaDato" align="center" cellpadding="0" cellspacing="0" border="0">
					<tr>
						<td class="textoEtiquetaDatoResaltado">Dictámenes de Actividades Externas	</td>					
					</tr>				
					<tr> 
						<td><?php $oDictamen->ListarDictamenActExterna($array_DictamenesActExt); ?></td>					
					</tr>
					<tr>
						<td>&nbsp;</td>					
					</tr>					
				</table>
	<?php } // numfilas_DicActExt>0
		//--------------------------- Actividades de AUTODESARROLLO ---------------------------------
		if($numfilas_DicActAuto>0)  { 

			if (!$oDictamen->AgregarDetalleDictameActAutodesarrollo($resultDicActAuto,$array_DictamenesActAuto)) 
				return false;					
		?>
			<table width="98%" class="textoTablaDato" align="center" cellpadding="0" cellspacing="0" border="0">
				<tr>
					<td class="textoEtiquetaDatoResaltado">Acreditación de Actividades de Autodesarrollo </td>					
				</tr>	
				<tr>
					<td ><?php $oDictamen->ListarDictamenActAutodesarrollo($array_DictamenesActAuto); ?></td>					
				</tr>
				<tr>
					<td>&nbsp;</td>					
				</tr>					
			</table>	
	<?php 	} // ($numfilas_DicActAuto>0) 
	} else {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error obtener los dictámenes. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	} // ok obtener dictamen	
	return true;
} 		
//----------------------------------------------------------------------------------------- 
?>
