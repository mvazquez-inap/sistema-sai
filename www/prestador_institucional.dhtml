			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"El código no corresponde a una institución prestadora.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			?><br><br><br><div align="center"><a href="agente_modificar.dhtml" class="linkFondoBlanco">Volver</a></div><?php
			$esta_ok=false;
