<?php

$filacurso=array();
$filacurso['act_codinap']=(isset($_POST['act_codinap_seleccion']))?$_POST['act_codinap_seleccion']:"";
$filacurso['act_codigo']=(isset($_POST['act_codigo']))?$_POST['act_codigo']:"";

if ($filacurso['act_codigo'] == "")
	$filacurso['act_codigo']=(isset($_GET['act_codigo']))?$_GET['act_codigo']:"";

if (isset($_POST['act_codinap_seleccion'])) {
	if($conexion->TraerCampo("actividad","act_codigo",array("act_codinap='",$_POST['act_codinap_seleccion'],"'"),$act_codigo,$numfilas,$errno))
		$filacurso['act_codigo']=htmlspecialchars($act_codigo,ENT_QUOTES);
}
if ( isset($_POST['act_codigo']) || isset($_GET['act_codigo']) ) {
	if($conexion->TraerCampo("actividad","act_codinap",array("act_codigo='",$filacurso['act_codigo'],"'"),$act_codigo,$numfilas,$errno))
		$filacurso['act_codinap']=htmlspecialchars($act_codigo,ENT_QUOTES);
}

$destino_formulario_interface="actividad_curso_prestador_docente.dhtml";

$es_modif=false;
$ok=false;

// Nuevo
if($_SESSION['rolcod']==SUPERUSUARIO) {
	$oActividad = new cActividadCurso($conexion);
	if ($oActividad->TieneFormatoTipo($filacurso['act_codigo'],FORMATOCURSO,TIPOACTCURSOINAP,$tiene_formato_tipo)) {
		if ($tiene_formato_tipo)
			$oActividadCurso= new cActividadCursoInap($conexion);
		elseif ($oActividad->TieneFormatoTipo($filacurso['act_codigo'],FORMATOCURSO,TIPOACTCURSOJURISD,$tiene_formato_tipo))
			$oActividadCurso= new cActividadCursoJurisdiccional($conexion);
	}
}

// if (isset($_GET['act_codigo']) && isset($_GET['operacion'])=="B")
//	$filacurso['act_codigo']=(isset($_GET['act_codigo']))?$_GET['act_codigo']:"";

if ((isset($_POST['boton_cancela']) || $filacurso['act_codigo']=="" )) {
?>
	<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
		<table width="100%" class="textoTablaDato" align="center">
		<tr>
			<td><?php $oActividadCurso->PedirActividad($filacurso['act_codinap'],'formulario_seleccion','act_codinap_seleccion','ActualizarPrestadores'); ?></td>
		</tr>
		</table>
	</form>
<?php
if(($filacurso['act_codigo']!="" || $filacurso['act_codinap']!="") && !isset($_POST['boton_cancela']))

	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

} else {

	$es_modif=false;
	$error=false;

	if ($_SESSION['rolcod'] == USUCURSOINAP) {
		$oActividadCurso->TraerDatosActividadCursoInap($filacurso['act_codigo'],$filacurso,$es_modif);
	} elseif ($_SESSION['rolcod'] == COORDINADORTECNICO || $_SESSION['rolcod'] == USUORGANISMO || $_SESSION['rolcod'] == USUACTJUR) {
		$oActividadCurso->TraerDatosActividadCursoJurisdiccional($filacurso['act_codigo'],$filacurso,$es_modif);
	} elseif($_SESSION['rolcod']==SUPERUSUARIO) { // Nuevo

		if ($oActividad->TieneFormatoTipo($filacurso['act_codigo'],FORMATOCURSO,TIPOACTCURSOINAP,$tiene_formato_tipo)) {
			if ($tiene_formato_tipo) {
				$oActividadCurso->TraerDatosActividadCursoInap($filacurso['act_codigo'],$filacurso,$es_modif);
			} elseif ($oActividad->TieneFormatoTipo($filacurso['act_codigo'],FORMATOCURSO,TIPOACTCURSOJURISD,$tiene_formato_tipo)) {
				if ($tiene_formato_tipo) {
					$oActividadCurso->TraerDatosActividadCursoJurisdiccional($filacurso['act_codigo'],$filacurso,$es_modif);
				}
			}
		}
	}

	if (!$es_modif) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	} else {
		if ($oActividadCurso->TienePermisoModificarActividadPrestador($filacurso['actividad']['act_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']))
			$ok=true;
	} // Se encontró la actividad con el formato esperado

	if (!$ok) { ?>
		<br><br><div align="center"><a href="actividad_curso_prestador_docente.dhtml" class="linkFondoBlanco">Volver</a></div>
	<?php }
}
//------------------------------------------------------------------------------------

if ($ok) {

?>	<form action="#" method="post" name="formulario_datos_basicos">
	<table width="90%" class="textoTablaDato" align="center" cellpadding="0" cellspacing="0">
		<tr>
			<td>
				<fieldset class="bordeDetalleRegistro">
				<legend class="textoLeyendaDetalleRegistro">Datos Actividad </legend>
				<table width="100%" class="textoTablaDato" align="center" cellpadding="0" cellspacing="0">
					<tr>
						<td valign="top" width="35%" class='textoEtiqueta'>Nombre</td>
						<td class="textoEtiquetaDatoResaltado"><textarea cols="100" rows="2" class='inputReadonly' readonly='true' name="act_nombre" id="act_nombre"  style="width:350px" ><?php echo htmlspecialchars($filacurso['actividad']['act_nombre'],ENT_QUOTES); ?></textarea></td>
					</tr>
					<tr>
						<td valign="top" width="35%" class='textoEtiqueta'>Código INAP</td>
						<td class="textoEtiquetaDatoResaltado"><input type="text" name="act_codinap" id="act_codinap"  class='inputReadonly' readonly='true' size="21" maxlength="20" value="<?php echo htmlspecialchars($filacurso['actividad']['act_codinap'],ENT_QUOTES); ?>"></td>
					</tr>
				</table>
				</fieldset>
			</td>
		</tr>
	</table>
	</form>
	<br>
<?php
	$modulo_recarga= "actividad_curso_prestador_docente.dhtml";
	$result = true;
	//--------------------------
	// Se confirmo la operacion
	//--------------------------
	if (isset($_POST['boton_confirma'])) {

		$commit=true;
		$conexion->ManejoTransacciones("B");

		// Alta - Baja
		if ($commit) {

			switch($_POST['operacion']) {
			case 'I':
				if ($oActividadCursoPrestadorDocente->AltaDatosActividadCursoPrestadorDocente($_POST)) {
					FuncionesPHPLocal::RegistrarAcceso($conexion,"38501","act_codigo=".$filacurso['actividad']['act_codigo']." - presdoc_codigo=".$_POST['presdoc_codigo'],$_SESSION['usuariocod']);
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha asignado el Prestador Docente a la actividad. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else
					$commit=false;

				break;
			case 'B':
				if ($oActividadCursoPrestadorDocente->EliminarDatosActividadCursoPrestadorDocente($filacurso['actividad']['act_codigo'],$_POST['presdoc_codigo'])) {
					FuncionesPHPLocal::RegistrarAcceso($conexion,"38502","act_codigo=".$filacurso['actividad']['act_codigo']."- presdoc_codigo=".$_POST['presdoc_codigo'],$_SESSION['usuariocod']);
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha desasignado el Prestador Docente de la actividad. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else
					$commit=false;

				break;

			default:
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$commit=false;
			} // $switch

			if($commit)
				$conexion->ManejoTransacciones("C");
			else
				$conexion->ManejoTransacciones("R");
		}	// commit
	} // seteado el confirma

	//---------------------
	// Se define la acción
	//---------------------
	if (!isset($_GET['operacion'])) {
		$leyenda_operacion = "Agregar";
		$boton_operacion = "Agregar";
		$operacion = "I";
	} else {
		switch ($_GET['operacion']) {
		case "B" :
				$leyenda_operacion = "Eliminar";
				$boton_operacion = "Eliminar";
				$operacion = "B";
				break;
		default:
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error de operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result=false;
		}
	}
	//------- GRILLA VALORES A MODIFICAR
	if ($result)  {
	?>
		<table width="100%" class="textoTablaDato">
			<tr>
				<td align="center">
	<?php				if (!MostrarGrillaSeleccion($conexion,$modulo_recarga,$filacurso['actividad']['act_codigo']))
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar datos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	?>			</td>
			</tr>
		</table>
		<br>
<?php	}
	//------- DATOS DE UN REGISTRO
	if ( $result ) {
	?>
		<table width="90%"  border="0" align="center" cellspacing="0" cellpadding="0">
			<!-- DATOS A MODIFICAR -->
			<tr>
				<td>
					<fieldset class="bordeDetalleRegistro">
					<legend class="textoLeyendaDetalleRegistro">  Detalle del Registro  ( <?php echo $leyenda_operacion ?>  )</legend>
					<form action="<?php echo $modulo_recarga; ?>" method="post" name="formulario">
					<table width="100%" class="textoTablaDato" cellpadding="2" cellspacing="0">
							<tr>
								<td valign="top" class="textoEtiqueta" width="40%">
									<?php 	if($operacion!="B") { ?>
										<?php $oPrestadorDocente= new cPrestadorDocente($conexion);
											 $oPrestadorDocente->PedirPrestador('formulario','presdoc_codigo',"AsignarAEquipo",false);
										} else {
											$oPrestadorDocente=new cPrestadorDocente($conexion);
											$oPrestadorDocente->TraerDatosPrestadorDocente($_GET['presdoc_codigo'],$fila_prestador,$es_modif);
											$fila_prestador['idmostrar']=$fila_prestador['presdoc_apellido'].",".$fila_prestador['presdoc_nombre']."  ".(isset($fila_prestador['presdoc_cuilt'])?"(CUIT/CUIL=".$fila_prestador['presdoc_cuilt'].")":""); ?>

											Prestador Docente
											<input type="hidden" name="presdoc_codigo" id="presdoc_codigo" value="<?php echo $_GET['presdoc_codigo']?>" />
<?php										}
									?>
							  	</td>
								<td class="textoEtiqueta"><span id="idmostrar"></span>
									<?php 	if($operacion=="B") echo $fila_prestador['idmostrar']; ?>
								</td>
							</tr>

							<tr>
								<td colspan="2" align="center"></td>
							</tr>

							<tr>
								<td colspan="2" align="center">
									<input type="submit" name="boton_confirma" value="<?php echo $boton_operacion; ?>"
									onClick="if (<?= $_SESSION['rolcod']." == ".USUACTJUR ?>)
												return ValidarFormAltaActividadPrestadorDocenteCurso(formulario,'<?php echo $operacion ?>') &amp;&amp; confirm('¿Está seguro de incorporar el docente seleccionado al equipo docente de la Actidad?\n Confirmada la operación no podrá eliminarlo.')
											 else
											 	return ValidarFormAltaActividadPrestadorDocenteCurso(formulario,'<?php echo $operacion ?>');" class="botones" />
									<input type="submit" name="boton_cancela" value="Cancelar" class="botones" />
									<input type="hidden" name="operacion" id="operacion" value="<?php echo $operacion;?>" />
									<input type="hidden" name="act_codigo" id="act_codigo" value="<?php  echo $filacurso['actividad']['act_codigo'] ?>" />
								</td>
							</tr>
					</table>
					</form>
					</fieldset>
				</td>
				</tr>
			</table>

	<?php 	} // result
} // ok
$oEncabezados->PieMenuEmergente();
