//-------------------------------------------------------------------------------------
function MostrarDocentes($conexion,$ArregloDatos) {

	$oPrestadorDocente=new cPrestadorDocente($conexion);

	$numfilas=0;	
	if(!$oPrestadorDocente->BuscarPrestadorDocenteAvanzada($ArregloDatos, $numfilas, $resultPrestador, $error, $errormail)) {
		$txt_sys_mail = "Buscando Prestador Docente";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar las personas asignadas a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	} 

/*	if($numfilas > LIMITE_BUSQUEDA_MEDIANO)	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La b&uacute;squeda retorn&oacute; más de ".LIMITE_BUSQUEDA_MEDIANO." personas, deber&aacute; acotarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	} else*/
		if($numfilas==0) {
	
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se encontraron prestadores, que cumplan con la condición <br> y tengan asignadas actividades de formato. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	
		} elseif($numfilas>0) {  
	
			$opciones=array(
				"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
				"FilasPagina"=>30,
				"FormularioBotonera"=>"form_boton",		
				"NombrePaginaQuery"=>"pagina"
			);				
	
			if (isset($_GET["pagina"]))	{
				$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
				$opciones['QueryString']=$querystring;
			}

			$prestadores_seleccionados=array();					
			while ($fila_prestador = mysqli_fetch_assoc($resultPrestador)) {  
				$conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","PRESDOCESTADO","' and constantecod='",$fila_prestador['presdoc_estado'],"'"),$descri,$numfilas,$errorcod); 
				$prestadores_seleccionados[]= array( 'presdoc_codigo'=> $fila_prestador['presdoc_codigo'],
													'presdoc_cuilt' => $fila_prestador['presdoc_cuilt'],
													'presdoc_apellido' => $fila_prestador['presdoc_apellido'],
													'presdoc_nombre' => $fila_prestador['presdoc_nombre'],
													'presdoc_estado_desc'=>htmlspecialchars($descri,ENT_QUOTES),
													'presdoc_cuilt' => $fila_prestador['presdoc_cuilt']);
			} // while 
			
			$oGrilla = new cGrilla($opciones);
			$oGrilla->SetearTituloGrilla('Prestadores Docentes '."\n\n"."TOTAL DOCENTES:   ".count($prestadores_seleccionados));
			$oGrilla->SetearAnchoGrilla('95%');

			$miColumna1 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna1,'CUIT/CUIL/CDI');
			$oGrilla->Setear('campo_grilla',$miColumna1,'presdoc_cuilt');
			$oGrilla->Setear('align_columna',$miColumna1,'center');
			$oGrilla->Setear('ancho_columna',$miColumna1,'10');
			
			$miColumna2 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna2,'Apellido');
			$oGrilla->Setear('campo_grilla',$miColumna2,'presdoc_apellido');					
			$oGrilla->Setear('align_columna',$miColumna2,'left');

			$miColumna3 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna3,'Nombre');
			$oGrilla->Setear('campo_grilla',$miColumna3,'presdoc_nombre');
			$oGrilla->Setear('align_columna',$miColumna3,'left');

			$miColumna4 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna4,'Estado');
			$oGrilla->Setear('campo_grilla',$miColumna4,'presdoc_estado_desc');
			$oGrilla->Setear('align_columna',$miColumna4,'center');
	
			$miColumna5 = $oGrilla->AddColumna('popup');
			$oGrilla->Setear('ancho_columna',$miColumna5,'60');
			$oGrilla->Setear('imagen',$miColumna5,'images/verdetalle.gif');
			$oGrilla->Setear('altImagen',$miColumna5,'Ver detalle');		
			$oGrilla->Setear('titulo_columna',$miColumna5,'Detalle');
			$oGrilla->Setear('url',$miColumna5,'prestador_docente_ver_detalle.dhtml');
			$oGrilla->Setear('ventanaAnchoPopup',$miColumna5,'650');
			$oGrilla->Setear('ventanaAltoPopup',$miColumna5,'600');
			$oGrilla->Setear('ventanaVarxPopup',$miColumna5,'130');
			$oGrilla->Setear('ventanaVaryPopup',$miColumna5,'50');
			$oGrilla->AddParametrosURL($miColumna5,"presdoc_codigo",'presdoc_codigo');

			echo "<a name=Ira></a>";

			if ($oGrilla->CargarGrilla($prestadores_seleccionados)) {
				$oGrilla->MostrarGrilla();	
				echo "<br>";				
			} else {
				$txt_sys_mail = "Error Grilla='".$oGrilla->GetError();
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar los prestadores.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
				return false;
			}		
	}		

	return true;
} 
