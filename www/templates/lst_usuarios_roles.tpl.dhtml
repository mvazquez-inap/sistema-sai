				<a href="usuario_actualizar_roles.dhtml?usuariocod=<?php echo $row["usuariocod"]; ?>"><img src="images/editar.jpg" border="0" alt="Actualizar Roles"></a> 
			<?php } ?>	
		</td>
    </tr>
	
<?php	if (count($row["usuarioroles"])> 0) { ?>
	<tr style="height:26px;" >
		<td></td>
		<td colspan="4">
		<table border="0" class="textoAclaraciones">
		    <?php 	foreach ($row["usuarioroles"] as $row_rol):	 ?>
			<tr>
				<td width="45%" <?php echo ($row_rol["jurisdnom"]=="")?"colspan=2":"" ?>> <?php $this->_($row_rol["roldesc"]) ?></td>
				<?php if ($row_rol["jurisdnom"]!="") { ?>
					<td> <?php $this->_($row_rol["jurisdnom"]); ?></td>
				<?php } ?>	
			</tr>
			 <?php endforeach; ?>
		</table>		
		</td>
	</tr>
<?php } ?>	


<?php endforeach; ?>
</table>

