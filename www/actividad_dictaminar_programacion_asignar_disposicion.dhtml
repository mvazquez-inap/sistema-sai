$ok=true;
if ($operacion == "AD") {	// ASIGNAR DISPOSICIÓN

	if(!isset($_GET['dic_codigo'])) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El dictamen no se encuentra en el sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok = false;
	} else {

		if ($_GET['tipoact_codigo'] == TIPOACTCURSOINAP ||
				$_GET['tipoact_codigo'] == TIPOACTCURSOINST ||
				$_GET['tipoact_codigo'] == TIPOACTCURSOJURISD ||
				$_GET['tipoact_codigo'] == TIPOACTEXTASIS 	||
				$_GET['tipoact_codigo'] == TIPOACTAUTOEVASIS) {

				switch ($_GET['tipoact_codigo']) 		{
					case TIPOACTCURSOINAP:
						$tipoact_codigo=TIPOACTCURSOINAP;
						$formact_codigo=FORMATOCURSO;
						$oActividad= new cActividadCursoInap($conexion);
						break;
					case TIPOACTCURSOINST:
						$tipoact_codigo=TIPOACTCURSOINST;
						$formact_codigo=FORMATOCURSO;
						$oActividad= new cActividadCursoInstitucional($conexion);
						break;
					case TIPOACTCURSOJURISD:
						$tipoact_codigo=TIPOACTCURSOJURISD;
						$formact_codigo=FORMATOCURSO;
						$oActividad= new cActividadCursoJurisdiccional($conexion);
						break;
					case TIPOACTEXTASIS:
						$tipoact_codigo=TIPOACTEXTASIS;
						$formact_codigo=FORMATOEXT;
						$oActividad= new cActividadExterna($conexion);
						break;
					case TIPOACTAUTOEVASIS: // Solo para mero asistente
						$tipoact_codigo=TIPOACTAUTOEVASIS;
						$formact_codigo=FORMATOAUTO;
						$oActividad= new cActividadAutodesarrollo($conexion);
						break;
				}
				// Hay que chequear que la actividad tenga el formato esperado.
				if (!$oActividad->TieneFormatoTipo($_GET['act_codigo'],$formact_codigo,$tipoact_codigo,$tiene_formato_tipo)) {
					$txt_sys_mail="Error al determinar el formato - tipo de la actividad.\nact_codigo=".$_GET['act_codigo'];
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al dictaminar actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					$ok=false;
				} elseif (!$tiene_formato_tipo) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok=false;
				} else 	{
					// Obtengo los dictamenes
					$act_codigo=$_GET['act_codigo'];
					$dic_codigo=$_GET['dic_codigo'];

					$oDictamen= new cDictamen($conexion);

					if ($ok) {
							if ($oDictamen->ObtenerDatosParaAsignarDisposicion($conexion,$oActividad,$act_codigo,$tipoact_codigo,$dic_codigo,$fila_dictamen,$fila_detalle)) {

								if (!$oDictamen->TienePermisoAsignarDisposicion($_GET['act_codigo'],$fila_dictamen['actprog_sec'],$_SESSION['rolcod'])) {
									$ok = false;
								} elseif ($fila_detalle['act_estado']!=ACTAUTOACTIVO) {	// Verifica el estado de la actividad
									FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El estado de la Actividad no permite actualizar el dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
									$ok=false;
								} elseif ($fila_dictamen['dic_estado']!=DICTAMENACTIVO) {
									FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El estado del dictamen no le permite realizar la operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
									$ok=false;
								}  else  {
									?><a name="Edicion"></a><?php
									// Muestra los datos idem que para dictaminar pero solo se visualiza
									$ok = $oDictamen->MostrarDatosDictamenProgramacion($conexion,$oActividad,$fila_detalle,"V","V",$fila_dictamen);
									if ($ok) {
										$boton_operacion = "Asignar Disposición";
										$destino_formulario_upd="actividad_dictaminar_programacion_asignar_disposicion_upd.dhtml";
					?>
										<script type="text/javascript">
											<?php $oDictamen->ValidarFormAsignarDisposicion(); ?>
										</script>

										<form action="<?php echo $destino_formulario_upd ?>" method="post" name="formulario_seleccion">
										<table width="95%" class="textoTablaDato" align="center">
										<?php 	if ($ok) { ; 	?>
												<tr align="left">
													<td colspan="2">
													<?php 	$oDisposicion = new cDisposicion($conexion);
														$oDisposicion->PedirDisposicion($fila_dictamen['dis_numero'],$fila_dictamen['dis_codigo'],'formulario_seleccion','dis_numero','Actualizar',false);
													?>
													</td>
												</tr>
												<tr><td colspan="2">&nbsp;</td></tr>
												<tr align="center">
													<td colspan="2">
													<input type="submit" name="boton_actualizar"   value="Confirma <?php echo $boton_operacion?>" onClick="return confirm('¿Está seguro que desea asignar la Disposición?') &amp;&amp; ValidarFormAsignarDisposicion(formulario);" class="botones"  />
													<input type="hidden" name="act_codigo" value="<?php echo $fila_dictamen['act_codigo']?>" />
													<input type="hidden" name="dic_codigo" value="<?php echo $fila_dictamen['dic_codigo']?>" />
													<input type="hidden" name="tipoact_codigo" value="<?php echo $fila_dictamen['tipoact_codigo']?>" />
													<input type="hidden" name="actprog_sec" value="<?php echo $fila_dictamen['actprog_sec']?>" />
													<input type="hidden" name="operacion" value="<?php echo $operacion ?>" />
													</td>
												</tr>
										<?php 	}  // ok ?>
										</table>
									</form>
							<?php 		}  // ok
							} // TienePermisoAsignarDisposicion

						} else { //   $oDictamen->ObtenerDatosParaAsignarDisposicion

							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							$ok=false;

						} //   $oDictamen->ObtenerDatos
					}	// ok
				} // tien formato

		} else { // es AUTODESARROLLO NO ASIS

					$ok = true;
					$es_modif_agente = false;
					$operacion_dictamen = "V";
					$destino_formulario_upd="actividad_dictaminar_programacion_asignar_disposicion_upd.dhtml";
					// Busco la persona
					$oPersonas = new cPersonas($conexion);
					if ($ok) {
						if(!$oPersonas->TraerDatosPersona_xCod($_GET["pers_codigo"],$datospersona,$es_modif)) {
							$ok=false;
						} elseif (!$es_modif) {
								$mensaje = "La Persona no se encuentra en el sistema.";
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$mensaje,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								$ok=false;
							} elseif($datospersona['pers_estado'] == PERSONABAJA) {
								$error="La persona ingresada se encuentra dada de baja.<br>Deber&aacute; rehabilitar a la persona.";
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								$ok = false;
							}
					}

				// Verifico si la persona está asignada a la actividad
				$oActividadAutodesarrolloPersona = new cActividadAutodesarrolloPersona($conexion);
				if ($ok) {
					$ArregloDatos = array();
					$ArregloDatos['pers_codigo'] = $datospersona['pers_codigo'];
					$ArregloDatos['act_codigo'] = $_GET['act_codigo'];
					if(!$oActividadAutodesarrolloPersona->BuscarActividadAsignadaPersona ($ArregloDatos, $numfilasAsignacion, $result_asignacion, $error, $errormail)) {
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
						$ok = false;
					} elseif($numfilasAsignacion > 1)	{
						$error = "La persona ya tiene acreditada la actividad.";
						$errormail ="La persona tiene más de 1 tipo de actividad acreditada.\npers_codigo=".$ArregloDatos['pers_codigo']."\nact_codigo=".$ArregloDatos['act_codigo'];
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
						$ok = false;
						} elseif($numfilasAsignacion == 0)	{
							$error = "La persona no tiene asignada la actividad.";
							$errormail ="La persona no tiene asignada la actividad.\npers_codigo=".$ArregloDatos['pers_codigo']."\nact_codigo=".$ArregloDatos['act_codigo'];
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							$ok = false;
						} else {
								$tiene_asignacion = true;
								$fila_asignacion = mysqli_fetch_assoc($result_asignacion);
								$oExpediente = new cExpediente($conexion);
								if (!$oExpediente->TraerDatosExpediente($fila_asignacion['exp_codigo'],$fila_expediente,$es_modif_exp)) {
									$txt_sys_mail="Error buscando los datos del expediente. \nexp_codigo=".$fila_asignacion['exp_codigo'];
									FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar detalles del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
									$ok = false;
								} else {
									$fila_asignacion['jurisdid_inap'] = $fila_expediente['jurisdid_exp'];
									$fila_asignacion['exp_numero'] = $fila_expediente['exp_numero'];
								} //
						}
				}

					$oActividadAutodesarrollo = new cActividadAutodesarrollo($conexion);
					$oEscalafon = new cEscalafones($conexion);
					$jurisdicciones	 = new jurisdicciones;

					// Busco el dictamen
					$ArregloDatos = array();
					$ArregloDatos['act_codigo']=$_GET['act_codigo'];
					$ArregloDatos['tipoact_codigo']=$_GET['tipoact_codigo'];
					$ArregloDatos['pers_codigo']=$_GET['pers_codigo'];
					if (!$oActividadAutodesarrollo->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
						$txt_sys_mail="Error al buscar dictamen de la actividad.\nact_codigo=".$ArregloDatos['act_codigo']."\ntipoact_codigo=".$ArregloDatos['act_codigo']."\npers_codigo=".$ArregloDatos['pers_codigo'];
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
						$ok=false;
					}

					if ($ok) {
						if ($numfilas==1) {
							$tiene_dictamen = true;
							$fila_dictamen = mysqli_fetch_assoc($resultDictamenes);
							if ($fila_dictamen['dic_estado'] != DICTAMENACTIVO){
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El estado del Dictamen, no le permite actualizarlo",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								$ok=false;
							}
						}
						else
							$ok = false;
					}
					if ($ok) {

							if (!$oActividadAutodesarrollo->TraerDatosActividadDetalles($_GET['act_codigo'],$_GET['tipoact_codigo'],$fila_actividad,$es_modif_act) ) {

								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar la Actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"\nact_codigo=".$filaactividad['act_codigo']);
								$ok=false;

							} else {

								if (!$oActividadAutodesarrollo->MostrarDatosBasicosActividad ($conexion,$_GET['act_codigo'],$_GET['tipoact_codigo'])){
									FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar los datos de la Actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"\nact_codigo=".$filaactividad['act_codigo']);
									$ok=false;
								}
							?>
							<?php } ?>
