function ChequearTodos(chkbox) {
	for (var i=0;i < document.forms[0].elements.length;i++) {
	var elemento = document.forms[0].elements[i];
		if (elemento.type == "checkbox") {
			elemento.checked = chkbox.checked
		}
	}
}
</script>
