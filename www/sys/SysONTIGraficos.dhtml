<?php
class SysONTIGraficos
{
	var $EjesDisponibles;  // array con los ejes disponibles
	var $EjesActivos;  // array con los ejes activos

	var $tam_x;  // ancho del grafico total en pixel
	var $tam_y;  // alto del grafico total en pixel
	var $colorfondografint;  // color de fondo de la parte central del grafico
	var $colorfondo;  // color de fondo de todo el grafico
	
	var $datos;  // array con los datos del grafico. Por cada posicion, nuevo array => (etiq_x,valor en eje 1,valor en eje 2, etc)
	
	var $formato_etiq_x; // array con formato de las etiquetas en eje x 
	var $leyenda_x; // array con texto y formato de la leyenda del eje x
	
	// todas estas variables son array, donde la primer posicion indica a que eje hace referencia
	var $formato_etiq_y; // array con el formato de las etiquetas de un eje y
	var $leyenda_y; // array con el texto y formato de la leyenda de un eje y
	var $tipovisualizacion_y; // tipo de visualizacion (linea,punto,etc) de cada eje y
	var $formatolinea_y; // formato de linea de cada eje y
	var $formatopunto_y;  // formato de los puntos de cada eje y
	var $formatobarra_y;  // formato de barra de cada eje y
	
	var $dir_fuentes; // directorio donde se encuentran los archivos ttf
	
	var $erroractual; // guardo los datos del ultimo error que se produjo
	var $errortextos; // un array donde guardo el texto del error
	
//----------------------------------------------------------------------------------------- 
// Constructor de la clase. 
// Define tamanio del grafico y el color de fondo. 
// Inicializa con valores por default las otras variables de la clase

	function SysONTIGraficos($tam_x,$tam_y,$colorfondografint,$colorfondo=array(255,255,255))
	{
		$this->dir_fuentes="./fonts/";

		$this->erroractual=array("codigo"=>0,"funcion"=>"","linea"=>0);
		$this->_InicializarTextosError();
		
		// estas 3 variables son solo internas al constructor.
		// si se agregan mas variables por default, ver habilitareje
		$colordefault=array(0,0,0);
		$fuentedefault=$this->dir_fuentes."verdana.ttf";
		$tamaniodefault=8;
		$angulodefault=0;
		
			
		$this->EjesDisponibles=array(1,2);
		$this->EjesActivos=array(1);
		
		if(!is_int($tam_x) || $tam_x<=0)
			$this->tam_x=100;
		else
			$this->tam_x=$tam_x;
			
		if(!is_int($tam_y) || $tam_y<=0)
			$this->tam_y=100;
		else
			$this->tam_y=$tam_y;
		
		if(!$this->_VerificarColor($colorfondografint))
			$this->colorfondografint=array(0,0,0);
		else
			$this->colorfondografint=$colorfondografint;
			
		if(!$this->_VerificarColor($colorfondo))
			$this->colorfondo=array(0,0,0);
		else
			$this->colorfondo=$colorfondo;
		
		
		$this->datos=array();
		
		$this->formato_etiq_x=array("fuente"=>$fuentedefault,"tamanio"=>$tamaniodefault,"color"=>$colordefault,"angulo"=>$angulodefault);
		$this->leyenda_x=array("texto"=>"Leyenda Eje x","fuente"=>$fuentedefault,"tamanio"=>$tamaniodefault,"color"=>$colordefault);
		
		// cualquier default que se agregue aca, agregarlo tambien en la funcion de habilitar eje
		$this->formato_etiq_y=array();
		$this->formato_etiq_y[1]=array("comienzo"=>0,"fin"=>100,"paso"=>10,"unidadmedida"=>$this->UNIDMEDIDAUNIDAD(),"fuente"=>$fuentedefault,"tamanio"=>$tamaniodefault,"color"=>$colordefault,"angulo"=>$angulodefault);
		$this->leyenda_y=array();
		$this->leyenda_y[1]=array("texto"=>"Leyenda Eje Y1","fuente"=>$fuentedefault,"tamanio"=>$tamaniodefault,"color"=>$colordefault);
		$this->tipovisualizacion_y=array();
		$this->tipovisualizacion_y[1]=$this->TIPOVISUALIZPUNTO()+$this->TIPOVISUALIZLINEA();
		$this->formatolinea_y=array();
		$this->formatolinea_y[1]=array("color"=>$colordefault,"grosor"=>1);
		$this->formatopunto_y=array();
		$this->formatopunto_y[1]=array("tipopunto"=>$this->TIPOPUNTOPUNTO(),"mostrarvalor"=>false,"fuente"=>$fuentedefault,"tamanio"=>$tamaniodefault,"color"=>$colordefault);
		$this->formatobarra_y=array();
		$this->formatobarra_y[1]=array("color"=>$colordefault,"grosor"=>6);
		

	} // fin del constructor
	
//-----------------------------------------------------------------------------------------
//							 PUBLICAS	
//----------------------------------------------------------------------------------------- 
	
//----------------------------------------------------------------------------------------- 
// Permite cargar el formato y las etiquetas del eje x, definiendo las claves de acceso para cargar los valores de los ejes y

// Parámetros:
//		$arr_etiquetas: un array asociativo donde la clave define los puntos de acceso para cargar despues los valores en y
//					y en valor el texto que se va a mostrar
//		$fuente,$tamanio,$color: formato de las etiquetas

	function x_Etiquetas($arr_etiquetas,$fuente="",$tamanio="",$color="",$angulo="")
	{
		if(!is_array($arr_etiquetas))
		{
			$this->_SetearError(21,__FUNCTION__,__LINE__);
			return false;
		}

		// recorre $arr_etiquetas y va guardando los valores en datos
		foreach($arr_etiquetas as $clave => $valor)
		{
			$this->datos[$clave][0]=$valor; // en la primer posicion guardo el texto de la etiqueta
		}
		
		// si se agregan mas parametros para el formato, agregar los valores por default en el constructor
		if ($fuente!='')
		{
			if(!$this->_VerificarFuente($this->dir_fuentes.$fuente))
				return false;

			$this->formato_etiq_x["fuente"]=$this->dir_fuentes.$fuente;
		}
		if ($tamanio!='')
		{
			if(!$this->_VerificarTamanio($tamanio))
				return false;

			$this->formato_etiq_x["tamanio"]=$tamanio;
		}
		if ($color!='')
		{
			if(!$this->_VerificarColor($color))
				return false;

			$this->formato_etiq_x["color"]=$color;
		}
		if ($angulo!='')
		{
			if(!$this->_VerificarAngulo($angulo))
				return false;

			$this->formato_etiq_x["angulo"]=$angulo;
		}
		
		return true;
	} // fin de x_Etiquetas


//----------------------------------------------------------------------------------------- 
// Permite cargar la leyenda del eje x y su formato

// Parámetros:
//		$textoleyenda: el texto que va a aparecer como leyenda del eje x
//		$fuente,$tamanio,$color: formato de la leyenda

	function x_Leyenda($textoleyenda,$fuente,$tamanio,$color)
	{
		if(!$this->_VerificarFuente($this->dir_fuentes.$fuente))
			return false;

		if(!$this->_VerificarTamanio($tamanio))
			return false;

		if(!$this->_VerificarColor($color))
			return false;

		$this->leyenda_x["texto"]=$textoleyenda;
		$this->leyenda_x["fuente"]=$this->dir_fuentes.$fuente;
		$this->leyenda_x["tamanio"]=$tamanio;
		$this->leyenda_x["color"]=$color;
		
		return true;
	} // fin de x_Leyenda
	
//----------------------------------------------------------------------------------------- 
// Permite la habilitacion de un eje y

// Parámetros:
//		$eje: indica el eje que se va a habilitar. Debe estar como valor dentro de EjesDisponibles

	function y_HabilitarEje($eje)
	{
		// mismas variables que en el constructor
		$colordefault=array(0,0,0);
		$fuentedefault=$this->dir_fuentes."verdana.ttf";
		$tamaniodefault=8;
		$angulodefault=0;

		if(!in_array($eje,$this->EjesDisponibles))
		{
			$this->_SetearError(5,__FUNCTION__,__LINE__);
			return false;
		}
		
		$this->EjesActivos[]=$eje;
		$this->formato_etiq_y[$eje]=array("comienzo"=>0,"fin"=>100,"paso"=>10,"unidadmedida"=>$this->UNIDMEDIDAUNIDAD(),"fuente"=>$fuentedefault,"tamanio"=>$tamaniodefault,"color"=>$colordefault,"angulo"=>$angulodefault);
		$this->leyenda_y[$eje]=array("texto"=>"Leyenda Eje Y".$eje,"fuente"=>$fuentedefault,"tamanio"=>$tamaniodefault,"color"=>$colordefault);
		$this->tipovisualizacion_y[$eje]=$this->TIPOVISUALIZPUNTO()+$this->TIPOVISUALIZLINEA();
		$this->formatolinea_y[$eje]=array("color"=>$colordefault,"grosor"=>1);
		$this->formatopunto_y[$eje]=array("tipopunto"=>$this->TIPOPUNTOPUNTO(),"mostrarvalor"=>false,"fuente"=>$fuentedefault,"tamanio"=>$tamaniodefault,"color"=>$colordefault);
	
//		$this->tieney2=$valor;
//		$this->tipovisualizacion_y[$eje]=$this->TIPOVISUALIZPUNTO()+$this->TIPOVISUALIZLINEA();
		
		return true;
	} // fin de y_TieneEjeSecundario
	
