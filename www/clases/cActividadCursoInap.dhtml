<?php
//-----------------------------------------------------------------------------------------
class cActividadCursoInap extends cActividadCurso {
	public function __construct($conexion) {
		parent::__construct($conexion);
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,&$datosresult,&$es_modif) {
		if (!$this->TraerDatosActividadCursoInap($act_codigo,$datosresult_detalle,$es_modif)) {
			return false;
		} else {
			$datosresult['act_codigo']=$datosresult_detalle['actividad']['act_codigo'];
			$datosresult['act_formato']=FORMATOCURSO;
			$datosresult['tipoact_codigo']=TIPOACTCURSOINAP;
			$datosresult['act_nombre']=$datosresult_detalle['actividad']['act_nombre'];
			$datosresult['act_codinap']=$datosresult_detalle['actividad']['act_codinap'];
			if (isset($datosresult_detalle['actividad']['dis_numero']))
				$datosresult['dis_numero']=$datosresult_detalle['actividad']['dis_numero'];
			$datosresult['act_duracionhs']=$datosresult_detalle['actividad_curso_inap']['actdisinap_duracionhs'];
			$datosresult['act_estado']=$datosresult_detalle['actividad_curso']['actcur_estado'];
			$datosresult['act_creditos']=$datosresult_detalle['actividad_curso']['actcur_creditos'];
			$datosresult['jurisdid_inap']=$datosresult_detalle['actividad_curso']['jurisdid_inap'];
			$datosresult['univ_codigo']=$datosresult_detalle['actividad_curso_inap']['univ_codigo'];
			return true;
		}
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadCursoInap($act_codigo,&$datosresult,&$es_modif) {

		// Si se hay error al ejecutar algún SQL retorna error, sino si no encuentra
		// la actividad o la actividad curso no es Curso INAP, retorna que es_modif=false
		// pues no se encontro una actividad curso inap con el codigo enviado

		$datosresult=array();
		$es_modif = false;


		if (!$this->TraerDatosActividad($act_codigo,$result_actividad,$es_modif_act))
			return false;

		if ($es_modif_act) {

			$datosresult['actividad']=$result_actividad; // Datos de la actividad

			if (!$this->TraerDatosActividadCurso($act_codigo,$result_actividad_curso,$es_modif_act_curso))
				return false;


			if ($es_modif_act_curso) { // Datos de la actividad curso
				$datosresult['actividad_curso']=$result_actividad_curso;
				// Verifico que sea una actividad curso INAP
				if ($datosresult['actividad_curso']['tipoact_codigo'] != TIPOACTCURSOINAP) {
					$es_modif=false;
				}
				$sparam=array('pact_codigo'=>$act_codigo);
				$spnombre="sel_actividad_curso_diseno_inap_xact_codigo";
				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
				{
					$errormail="\nact_codigo".$act_codigo;
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
				if ($numfilas == 1)	{
					$datosresult['actividad_curso_inap']= mysqli_fetch_assoc($resultado);
					$es_modif = true;
				}
			} // $es_modif_act_curso


		} // $es_modif_act

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function AltaDatosActividadCursoInap($datos,&$act_codigo_nuevo, &$act_codinap) {

		$datosvalidados=array();
		$this->_AguparDatosPost($datos,$datos_agrup,false);

		$datoscurso['actividad']=$datos_agrup['actividad'];
		$datoscurso['actividad_curso']=$datos_agrup['actividad_curso'];

		if(!$this->AltaDatosActividadCurso($datoscurso,$act_codigo_nuevo, $act_codinap))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38101","act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);

		if(!$this->_DatosValidosAltaActividadCursoInap($datos_agrup['actividad_curso_inap'],$datosvalidados))
			return false;

		$spnombre="ins_actividad_curso_diseno_inap";
		$spparam=array('pact_codigo'=>$act_codigo_nuevo,
					  'pprogcur_codigo'=>$datosvalidados['progcur_codigo'],
					  'pareacur_codigo'=>$datosvalidados['areacur_codigo'],
					  'puniv_codigo'=>$datosvalidados['univ_codigo'],
					  'pactdisinap_fundamentacion'=>$datosvalidados['actdisinap_fundamentacion'],
					  'pactdisinap_contribucion'=>$datosvalidados['actdisinap_contribucion'],
					  'pactdisinap_perfil'=>$datosvalidados['actdisinap_perfil'],
					  'pactdisinap_objetivos'=>$datosvalidados['actdisinap_objetivos'],
					  'pactdisinap_contenido'=>$datosvalidados['actdisinap_contenido'],
					  'pactdisinap_modaldesc'=>$datosvalidados['actdisinap_modaldesc'],
					  'pactdisinap_eval'=>$datosvalidados['actdisinap_eval'],
					  'pactdisinap_evalinstru'=>$datosvalidados['actdisinap_evalinstru'],
					  'pactdisinap_requiaprobacion'=>$datosvalidados['actdisinap_requiaprobacion'],
					  'pactdisinap_duracionhs'=>$datosvalidados['actdisinap_duracionhs'],
					  'pactdisinap_duraciondetalle'=>$datosvalidados['actdisinap_duraciondetalle'],
					  'pactdisinap_lugar'=>$datosvalidados['actdisinap_lugar'],

					  'pactdisinap_metodologia'=>$datosvalidados['actdisinap_metodologia'],
					  'pactdisinap_bibliografia'=>$datosvalidados['actdisinap_bibliografia'],
					  'pactdisinap_perfil_instructor'=>$datosvalidados['actdisinap_perfil_instructor'],

					  'pactdisinap_planrecursos'=>"---",
					  'pactdisinap_plancontenidos'=>"---",
					  'pactdisinap_planestrategias'=>"---",

					  'pactdisinap_origen'=>$datosvalidados['actdisinap_origen'],

					  'pactdisinap_unico'=>$datosvalidados['actdisinap_unico'],
					  'pactdisinap_beca'=>$datosvalidados['actdisinap_beca'],
					  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad Curso INAP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function EliminarDatosActividadCursoInap($act_codigo) {

		if(!$this->_DatosValidosEliminarActividadCursoInap($act_codigo,$datosvalidados))
			return false;

		$spnombre="del_actividad_curso_diseno_inap";
		$spparam=array('pact_codigo'=>$act_codigo);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la Actividad Curso INAP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if(!$this->EliminarDatosActividadCurso($act_codigo))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38102","act_codigo=".$act_codigo,$_SESSION['usuariocod']);

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function ModifDatosActividadCursoInap($datos)	{

		$this->_AguparDatosPost($datos,$datos_agrup,true);

		$datoscurso['actividad']=$datos_agrup['actividad'];
		$datoscurso['actividad_curso']=$datos_agrup['actividad_curso'];

		if(!$this->ModifDatosActividadCurso($datoscurso))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38103","act_codigo=".$datos_agrup['actividad']['act_codigo'],$_SESSION['usuariocod']);

		if(!$this->_DatosValidosModifActividadCursoInap($datos_agrup['actividad_curso_inap'],$datosvalidados))
			return false;

		$spnombre="upd_actividad_curso_diseno_inap";
		$spparam=array('pact_codigo'=>$datosvalidados['act_codigo'],
			   		  'pprogcur_codigo'=>$datosvalidados['progcur_codigo'],
					  'pareacur_codigo'=>$datosvalidados['areacur_codigo'],
					  'puniv_codigo'=>$datosvalidados['univ_codigo'],
					  'pactdisinap_fundamentacion'=>$datosvalidados['actdisinap_fundamentacion'],
					  'pactdisinap_contribucion'=>$datosvalidados['actdisinap_contribucion'],
					  'pactdisinap_perfil'=> $datosvalidados['actdisinap_perfil'],
					  'pactdisinap_objetivos'=>$datosvalidados['actdisinap_objetivos'],
					  'pactdisinap_contenido'=>$datosvalidados['actdisinap_contenido'],
					  'pactdisinap_modaldesc'=>$datosvalidados['actdisinap_modaldesc'],
					  'pactdisinap_eval'=>$datosvalidados['actdisinap_eval'],
					  'pactdisinap_evalinstru'=>$datosvalidados['actdisinap_evalinstru'],
					  'pactdisinap_requiaprobacion'=>$datosvalidados['actdisinap_requiaprobacion'],
					  'pactdisinap_duracionhs'=>$datosvalidados['actdisinap_duracionhs'],
					  'pactdisinap_duraciondetalle'=>$datosvalidados['actdisinap_duraciondetalle'],
					  'pactdisinap_lugar'=>$datosvalidados['actdisinap_lugar'],

   					  'pactdisinap_metodologia'=>$datosvalidados['actdisinap_metodologia'],
					  'pactdisinap_bibliografia'=>$datosvalidados['actdisinap_bibliografia'],
					  'pactdisinap_perfil_instructor'=>$datosvalidados['actdisinap_perfil_instructor'],

					  'pactdisinap_planrecursos'=>$datosvalidados['actdisinap_planrecursos'],
					  'pactdisinap_plancontenidos'=>$datosvalidados['actdisinap_plancontenidos'],
					  'pactdisinap_planestrategias'=>$datosvalidados['actdisinap_planestrategias'],

					  'pactdisinap_origen'=>$datosvalidados['actdisinap_origen'],

					  'pactdisinap_unico'=>$datosvalidados['actdisinap_unico'],
					  'pactdisinap_beca'=>$datosvalidados['actdisinap_beca'],

		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\nact_codigo='.$datosvalidados['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la Actividad Curso INAP.".$errno,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function ValidarFormAltaActividadCursoInap() {

	// Incluir las validaciones javascript de las 3 tablas.
	$this->ValidarFormAltaActividad();
	$this->ValidarFormAltaActividadCurso();
?>


	function SeleccionBeca(formulario, divbeca, divactividad){
		var elSelectBeca= document.getElementById(divbeca);
		var elSelectActividad = document.getElementById(divactividad);
			if (formulario.actdisinap_beca.value =="si") {
				elSelectBeca.style.display ="block";
				elSelectActividad.style.display ="none";
			} else {
				if (formulario.actdisinap_beca.value =="no") {
					elSelectBeca.style.display ="none";
					elSelectActividad.style.display ="block";
				} else {
					elSelectBeca.style.display ="none";
					elSelectActividad.style.display ="none";
				}
			}
	}



	function ValidarFormAltaActividadCursoInap(formulario,operacion) {


	if (formulario.actdisinap_beca.value =="si") {
			// Universidad							- [univ_codigo] 				- [OBLIG]
			if ((trim(univ_codigo)=="")) {
				alert("Debe ingresar la Universidad");
				formulario.univ_codigo.focus();
				return false;
			}

	} else {
			// Programa							- [progcur_codigo] 				- [OBLIG]
			if ((trim(formulario.progcur_codigo.value)=="")) {
				alert("Debe ingresar el programa inap");
				formulario.progcur_codigo.focus();
				return false;
			}

			// Área								- [areacur_codigo] 				- [OBLIG]
			if ((trim(formulario.areacur_codigo.value)=="")) {
				alert("Debe ingresar el área inap");
				formulario.areacur_codigo.focus();
				return false;
			}

			// Fundamentación 					- [actdisinap_fundamentacion] 	- [OBLIG]
			if ((trim(formulario.actdisinap_fundamentacion.value)=="")) {
				alert("Debe ingresar la fundamentación");
				formulario.actdisinap_fundamentacion.focus();
				return false;
			}

			// Contribución esperada 			- [actdisinap_contribucion] 	- [OBLIG]
			if ((trim(formulario.actdisinap_contribucion.value)=="")) {
				alert("Debe ingresar la contribución esperada");
				formulario.actdisinap_contribucion.focus();
				return false;
			}

			// Perfil del participante 			- [actdisinap_perfil] 			- [OBLIG]
			if ((trim(formulario.actdisinap_perfil.value)=="")) {
				alert("Debe ingresar el perfil del participante");
				formulario.actdisinap_perfil.focus();
				return false;
			}

			// Objetivos 						- [actdisinap_objetivos] 		- [OBLIG]
			if ((trim(formulario.actdisinap_objetivos.value)=="")) {
				alert("Debe ingresar los objetivos");
				formulario.actdisinap_objetivos.focus();
				return false;
			}

			// Contenido 						- [actdisinap_contenido] 		- [OBLIG]
			if ((trim(formulario.actdisinap_contenido.value)=="")) {
				alert("Debe ingresar el contenido");
				formulario.actdisinap_contenido.focus();
				return false;
			}

			// Metodologia							- [actdisinap_metodologia] 			- [OBLIG]
			if ((trim(formulario.actdisinap_metodologia.value)=="")) {
				alert("Debe ingresar las estrategias metodológicas y recursos didácticos.");
				formulario.actdisinap_metodologia.focus();
				return false;
			}

			// Descripción de la modalidad 		- [actdisinap_modaldesc] 		- [OBLIG]
			if ((trim(formulario.actdisinap_modaldesc.value)=="")) {
				alert("Debe ingresar la modalidad");
				formulario.actdisinap_modaldesc.focus();
				return false;
			}

			// Bibliografia							- [actdisinap_bibliografia] 			- [OBLIG]
			if ((trim(formulario.actdisinap_bibliografia.value)=="")) {
				alert("Debe ingresar la bibliografía");
				formulario.actdisinap_bibliografia.focus();
				return false;
			}

			// Evaluación de los aprendizajes 	- [actdisinap_eval] 			- [OBLIG]
			if ((trim(formulario.actdisinap_eval.value)=="")) {
				alert("Debe ingresar la evaluación de los aprendizajes");
				formulario.actdisinap_eval.focus();
				return false;
			}

			// Instrumentos para la evaluación 	- [actdisinap_evalinstru] 		- [OPCIONAL]

			// Requisitos de Asistencia y aprobación			- [actdisinap_requiaprobacion] 	- [OBLIG]
			if ((trim(formulario.actdisinap_requiaprobacion.value)=="")) {
				alert("Debe ingresar los requisitos de Asistencia y aprobación");
				formulario.actdisinap_requiaprobacion.focus();
				return false;
			}

			// Duración	en hs. - [actdisinap_duracionhs] 	- [OBLIG]
			if (!ValidarContenido(formulario.actdisinap_duracionhs.value,'NumericoEntero') ) {
				alert("La duración en hs. debe ser un número entero");
				formulario.actdisinap_duracionhs.focus();
				return false;
			}
			if (formulario.actdisinap_duracionhs.value<=0) {
				alert("La duración en hs. debe ser mayor que cero");
				formulario.actdisinap_duracionhs.focus();
				return false;
			}

			// Detalle sobre la duración	 	- [actdisinap_duraciondetalle] 	- [OBLIG]
			if ((trim(formulario.actdisinap_duraciondetalle.value)=="")) {
				alert("Debe ingresar el detalle de la duración");
				formulario.actdisinap_duraciondetalle.focus();
				return false;
			}

			// Lugar 							- [actdisinap_lugar] 			- [OBLIG]
			if ((trim(formulario.actdisinap_lugar.value)=="")) {
				alert("Debe ingresar el lugar");
				formulario.actdisinap_lugar.focus();
				return false;
			}

			// Perfil del instructor				- [actdisinap_perfil_instructor] 			- [OBLIG]
			if ((trim(formulario.actdisinap_perfil_instructor.value)=="")) {
				alert("Debe ingresar el perfil del instructor");
				formulario.actdisinap_perfil_instructor.focus();
				return false;
			}


			/*
			// Plan de Clase - Recursos				- [actdisinap_planrecursos] 			- [OBLIG]
			if ((trim(formulario.actdisinap_planrecursos.value)=="")) {
				alert("Debe ingresar el Plan de Clase - Recursos");
				formulario.actdisinap_planrecursos.focus();
				return false;
			}

			// Plan de Clase - Contenidos				- [actdisinap_plancontenidos] 			- [OBLIG]
			if ((trim(formulario.actdisinap_plancontenidos.value)=="")) {
				alert("Debe ingresar el Plan de Clase - Contenidos");
				formulario.actdisinap_plancontenidos.focus();
				return false;
			}

			// Plan de Clase - Estrategias				- [actdisinap_planestrategias] 			- [OBLIG]
			if ((trim(formulario.actdisinap_planestrategias.value)=="")) {
				alert("Debe ingresar el Plan de Clase - Estrategias");
				formulario.actdisinap_planestrategias.focus();
				return false;
			}
			*/

			// tipo de inscripción 	- [actdisinap_unico] 	- [OBLIG]
			if ((trim(formulario.actdisinap_unico.value)=="")) {
				alert("Debe ingresar el tipo de inscripción");
				formulario.actdisinap_unico.focus();
				return false;
			}

			if ((trim(formulario.actdisinap_unico.value)=="<?php echo NO?>")) {
				return confirm("Atención: se podrá inscribir a un mismo agente en varias comisiones de esta actividad. ¿Esta seguro?");
			}

			// Origen				- [actdisinap_origen] 			- [OBLIG]
			if ((trim(formulario.actdisinap_origen.value)=="")) {
				alert("Debe ingresar el Origen de la demanda");
				formulario.actdisinap_origen.focus();
				return false;
			}

		} // if (formulario.actdisinap_beca.value =="si") {
		}
<?php }
