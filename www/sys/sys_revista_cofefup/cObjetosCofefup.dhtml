			$salida.='	<li> <a href="'.PAG_ART_AMPLIADO.'?idart='.$registro['idart'].'">'.$registro['titulo']."</a></li> " ;
		}			
		$salida.='	</ul>
				</div>';
		
		
	 	
	 	echo $salida;
	}
