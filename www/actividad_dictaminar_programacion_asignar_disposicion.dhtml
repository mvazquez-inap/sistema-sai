										<tr>
											<td width="30%"  valign="middle" class='textoEtiqueta'>Tipo de Participaci&oacute;n</td>
											<td class="textoEtiquetaDatoResaltado">
											<?php
												$spnombre = "sel_tipo_participacion_xtipoact_codigo_orden";
												$spparam = array();
												$spparam['porderby'] = "tipopart_descripcion";
												$spparam['ptipoact_codigo'] = $fila_asignacion['tipoact_codigo'];
												if(!$conexion->BuscarRegistroxClave($spnombre,$spparam,array("tipopart_codigo"=>$fila_asignacion["tipopart_codigo"]),$resultado,$filatipo,$numfilasmatcheo,$errno))							{
