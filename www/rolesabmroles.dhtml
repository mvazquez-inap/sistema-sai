<?php
$i = 1;
while($filagrupo=mysqli_fetch_assoc($resultado))
{
	echo "datos_grilla[".$i."]=new Array();\n";
	echo "datos_grilla[".$i."][0]=new Array(";
	
	if(!$conexion->ejecutarStoredProcedure("sel_roles_xrolesactualizados",array('prolcodactualiza'=>$filagrupo['rolcod'],'porderby'=>"rolcod"),$resulrol,$numfilas,$errno)) die();

	$codigosel=array();
	while($filarol=mysqli_fetch_assoc($resulrol))
		$codigosel[]=$filarol["rolcod"];
	
	if(count($codigosel)>0)
		echo "'".implode("','",$codigosel)."'";
	
	echo ");\n";
	$i++;
}
?>
</script>

