				}
					break;


			case "MenuMeses":

				$m = 12;

				if ($this->anio!="")
					if ($this->anio<date("Y"))
						$m=12;
				$i = $m;

				if ($this->anio=="")
					$this->anio=date("Y");
				if ($this->anio<1)
					$this->anio=date("Y");


				$aux=1;
				$encontradoanio=false;
				$ultmes = 0;

				while(!$encontradoanio || $aux<5)
