<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oPrestadorDocente = new cPrestadorDocente($conexion);
//----------------------------------------------------------------------------------------- 
?>
<script type="text/javascript">
	<?php $oPrestadorDocente->ValidarFormAltaPrestadorDocente(); ?>
</script>
<script type="text/javascript" src="calendar/calendar.js"></script>
<script type="text/javascript" src="calendar/calendar-setup.js"></script>
<script type="text/javascript" src="calendar/calendar-es.js"></script>

<?php 
$filaprestador=array();
$filaprestador['presdoc_codigo']=(isset($_POST['presdoc_codigo']))?$_POST['presdoc_codigo']:"";

if (isset($_GET['presdoc_codigo']))
	$filaprestador['presdoc_codigo'] = $_GET['presdoc_codigo'];

?>
<form action="prestador_docente_modificar.dhtml" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oPrestadorDocente->PedirPrestador('formulario_seleccion','presdoc_codigo','Modificar'); ?></td>
	</tr>
	</table>
</form>	
<?php
$es_modif=false;
$ok=false;
if ($filaprestador['presdoc_codigo']=="") {
	if(isset($_POST['presdoc_codigo']))
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El prestador docente no se encuentra en el sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
} else {
	if ($oPrestadorDocente->TienePermisoModificar($filaprestador['presdoc_codigo'], $_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
		$oPrestadorDocente->TraerDatosPrestadorDocente($filaprestador['presdoc_codigo'],$filaprestador,$es_modif);
	   	$ok=true;			
	}	
}
if ($ok) { 
	$destino_formulario="prestador_docente_modificar_upd.dhtml";
?>	<form action="<?php echo $destino_formulario?>" method="post" name="formulario">
<?php		if($oPrestadorDocente->MostrarDatoPrestadorDocente($conexion,"M",$filaprestador)){ ?>
		<table width="100%" class="textoTablaDato" align="center">
			<tr align="center">
				<td colspan="2" valign="top">
					<input type="submit" name="boton_confirma" class="botones" value="Confirma Actualización" onClick="return ValidarFormAltaPrestadorDocente(formulario,'M'); ">
					&nbsp;&nbsp;&nbsp;&nbsp;
					<input type="hidden" name="presdoc_codigo" value="<?php echo ($es_modif)?htmlspecialchars($filaprestador['presdoc_codigo'],ENT_QUOTES):""; ?>">
				</td>
			</tr>	
		</table>
<?php 		} // MostrarDatoPrestadorDocente ?>
	</form>
<?php
} // fin ok
$oEncabezados->PieMenuEmergente(); 
?>