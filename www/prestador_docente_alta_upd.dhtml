<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
$oPrestadorDocente = new cPrestadorDocente($conexion);

//----------------------------------------------------------------------------------------- 	

	$conexion->ManejoTransacciones("B");

	if($oPrestadorDocente->AltaDatosPrestadorDocente($_POST, $presdoc_codigo))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"36101","presdoc_codigo=".$presdoc_codigo,$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de Alta el Prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

		$conexion->ManejoTransacciones("C");
		?>
		<br><div align="center"><a href="prestador_docente_areas.dhtml?presdoc_codigo=<?php echo $presdoc_codigo?>" class="linkFondoBlanco">Actualizar Areas del Prestador Docente</a></div>
		<br><br><div align="center"><a href="prestador_docente_modificar.dhtml?presdoc_codigo=<?php echo $presdoc_codigo?>" class="linkFondoBlanco">Continuar Modificando datos del Prestador</a></div>
		<?php
	}
	else {
		$conexion->ManejoTransacciones("R");
	}
?>		
		<br><br><div align="center"><a href="prestador_docente_alta.dhtml" class="linkFondoBlanco">Volver</a></div>
<?php 
	
$oEncabezados->PieMenuEmergente();
?>
