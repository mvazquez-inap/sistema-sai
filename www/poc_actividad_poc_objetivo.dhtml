<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oPoc = new cPoc($conexion);
$oPocActividad= new cPocActividad($conexion);
$oPocObjetivo= new cPocObjetivo($conexion);
$oPocPocObjetivoPocArea= new cPocPocObjetivoPocArea($conexion);
$oPocActividadPocObjetivo= new cPocActividadPocObjetivo($conexion);
//----------------------------------------------------------------------------------------- 
$commit=true;
$errorinformable=true;

if (isset($_POST['boton_actualizar'])){
		
		$pocact_codigo=$_POST['pocact_codigo'];
		$poc_codigo=$_POST['poc_codigo'];

		//LLENAMOS EL ARREGLO DE LOS DATOS TRAIDOS DEL POST
		$OpcionSelec=array();

		foreach ($_POST as $nombre_var => $valor_var) 	{
			if (empty($valor_var)) {
				$vacio[$nombre_var] = $valor_var;
			} else {
				$post[$nombre_var] = $valor_var;
				$opcion = substr($nombre_var,0,9);
				
				if ($opcion=="checkobj_") {
					$OpcionSelec[]=substr($nombre_var,9,strlen($nombre_var)-6);
				}
			}
		}
		//FIN LLENAR DATOS
		
		if(!$oPocActividadPocObjetivo->BuscarRelacionXPocActividad($pocact_codigo,$query))	{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Error en la búsqueda de relaciones entre la Actividad y el Objetivo por código de actividad. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		$arreglo=array();
		while ($fila=mysqli_fetch_assoc($query))	
			$arreglo[]=$fila['pocobj_codigo'];

		$arrayponer=array_diff($OpcionSelec,$arreglo);
		$arraysacar=array_diff($arreglo,$OpcionSelec);
		
		$conexion->ManejoTransacciones("B");
		
		$result=true;

		//INSERTAR ARREGLOPONER
		foreach ($arrayponer as $pocobj_codigo)	{
			if(!$oPocActividadPocObjetivo->InsertarPocActividadPocObjetivo($pocact_codigo,$pocobj_codigo,$poc_codigo))	{	
				break;
				$result=false;
			} else {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"37501","pocact_codigo=".$pocact_codigo." - pocobj_codigo=".$pocobj_codigo,$_SESSION['usuariocod']);
			}	
		}
		//FIN INSERTAR

		//ELIMINAR ARREGLOSACAR
		foreach ($arraysacar as $pocobj_codigo)	{
			if(!$oPocActividadPocObjetivo->EliminarPocActividadPocObjetivo($pocact_codigo,$pocobj_codigo,$poc_codigo))	{	
				break;
				$result=false;
			} else {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"37502","pocact_codigo=".$pocact_codigo." - pocobj_codigo=".$pocobj_codigo,$_SESSION['usuariocod']);
			}	
		}
		//FIN ELIMINAR
		
		if ($result) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han actualizado las relaciones entre los objetivos y la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$conexion->ManejoTransacciones("C");
		} else 	{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Se ha producido un error al actualizar la relación .",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$conexion->ManejoTransacciones("R");
		}
}
//--------------------------------------------------------------------------------------------------
