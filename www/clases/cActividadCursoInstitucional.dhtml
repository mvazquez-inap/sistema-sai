//-----------------------------------------------------------------------------------------------------	
	function MostrarDatoActividadCursoInstitucional($conexion,$operacion,$filacurso=array()) {

	$result=true;
		
	// si queda esta opcion no mandar la conexion
	if ($operacion=="A") {
	   $es_modif = false;
	} elseif ($operacion=="M" || $operacion=="V") {   
	   	$es_modif = true;
	   } else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en la llamada, operación inválida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
	   }

	$jurisdicciones	= new jurisdicciones;
	if(!$jurisdicciones->BuscarRaizTipoOrg(TABGRALES_TIPOORG_NAC_EJ,array(),TABGRALES_TS_ARRAY,$nodo_jurisd,array(),$CodError)) {
		$txt_sys_mail="Error buscando la raiz del árbol de jurisdicciones.";
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar el organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
	}
					
	if ($es_modif) {
		$jurisdnom="";
		if (isset($filacurso['actividad_curso_institucional']['orgapri_codigo'])) 
			$sector_org = ORGANISMO_PRIVADO;		
		elseif (isset($filacurso['actividad_curso_institucional']['jurisdid_apn'])) {
				$tipoorg_codigo = ORGANISMO_APN;
				$sector_org = ORGANISMO_PUBLICO;
				$jurisdid = 'jurisdid_apn';
				
				if ($jurisdicciones->SelectJurisdxID($filacurso['actividad_curso_institucional']['jurisdid_apn'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError)) 
					$jurisdnom=htmlspecialchars($fila_jurisd[$filacurso['actividad_curso_institucional']['jurisdid_apn']]['jurisdnom'],ENT_QUOTES);
				else {
					$txt_sys_mail="\njurisdid_apn=".$filacurso['actividad_curso_institucional']['jurisdid_apn'];
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar el organismo público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					return false;
				}						
				
			} elseif (isset($filacurso['actividad_curso_institucional']['orgapub_codigo'])) {
					$tipoorg_codigo = ORGANISMO_NO_APN;		
					$sector_org = ORGANISMO_PUBLICO;
					$jurisdid = 'orgapub_codigo';				
					
					$ArregloDatos= array();
					$ArregloDatos['clave']=$filacurso['actividad_curso_institucional']["orgapub_codigo"];		
		
					$oTablaOrganismoPublico= new cTablaOrganismoPublico($this->conexion);
					if (!$oTablaOrganismoPublico->BuscarEnTabla($ArregloDatos,$numfilas,$result,$error,$errormail) || $numfilas!=1 ) {
						$txt_sys_mail="\norgapub_codigo=".$ArregloDatos['clave']."\nerror=".$errormail;
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar el organismo público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
						return false;
					} else {			
						$filaret=mysqli_fetch_assoc($result);			
							$jurisdnom = $filaret['orgapub_nombre'];
					}	
			} else {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, no tiene definido el organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		
	}	else  {		// No es modificacion
			$jurisdnom="";
			$jurisdid="jurisdid_apn";
			$tipoorg_codigo = ORGANISMO_APN;
			$sector_org = ORGANISMO_PUBLICO;
	}	// es_modif				

