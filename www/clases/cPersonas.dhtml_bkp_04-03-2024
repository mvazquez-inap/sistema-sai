			return false;
		}
		$datosvalidados["pers_email"]=($datos['pers_email']!="")?$datos["pers_email"]:"NULL";

		
		
		// Fecha nacimiento- [pers_fechanac] 	- [OBLIG]
		if (trim($datos['pers_fechanac'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['pers_fechanac'],"FechaDDMMAAAA"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de nacimiento no es válida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
