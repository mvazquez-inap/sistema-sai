	}
} // fin esta la persona

if ( isset($_POST['sysTabFormato']) || isset($_POST['sysTabTipoActividad'])||isset($_POST['sysTabResolucion'])  )  { 	

	// Capturo el error
	$error=$oWsTablasBasicas->fault;
	$error_description=$oWsTablasBasicas->getError();

	if ($error) {
		
		echo '<br><strong>Error: </strong>';		
		echo "(".$error_description['faultcode'].",'".$error_description['faultstring']."','".$error_description['detail']. "')";
		echo '<br>';
		die();		
	
	} else {

		echo '<br>';		
		echo '<h3>Información de Créditos:</h3>';
		$xml = iconv("ISO-8859-1","UTF-8//IGNORE",$result['resultado']);
