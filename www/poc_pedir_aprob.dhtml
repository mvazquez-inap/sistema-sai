if ( isset($_POST['boton_confirma']) ) 	{
	$commit=true;
	$conexion->ManejoTransacciones("B");
	// Alta - Baja - Modificación
	if ($oPoc->PedirAprobacionPoc($_POST['poc_codigo'],$_SESSION['jurisdid_inap'],$_SESSION['rolcod'])) 
	{
		$operacion_mensaje = "PEDIDO DE APROBACION (POC)";			
		FuncionesPHPLocal::RegistrarAcceso($conexion,"37203","poc_codigo=".$_POST['poc_codigo'],$_SESSION['usuariocod']);
		$oPoc->ArmarMensajePedidoAprobacion($_POST,$mensaje);
		$asunto = SISTEMA." - Pedido de Confirmación Carga de POC";
		
		if (FuncionesPHPLocal::MandarMail($conexion,USUACTJUR,$_SESSION['jurisdid_inap'],$asunto,$mensaje)) 
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"En unos momentos el Coordinador Institucional recibirá un correo electrónico <BR> con la solicitud de la Confirmación de Carga.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		else 
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El correo electrónico con la solicitud no fue enviado,<BR> notifique la solicitud al Coordinador Institucional por otra via.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

//		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha efectuado el Fin de Carga del POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		
	} else {
		$arraymensajepantalla="No se ha podido efectuar el Fin de Carga del POC";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$commit=false;
	}
	 
	if($commit)
		$conexion->ManejoTransacciones("C");
	else
		$conexion->ManejoTransacciones("R");
} // 	if ( isset($_POST['boton_confirma']) ) 

