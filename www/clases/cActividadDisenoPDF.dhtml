			$this->Ln(4);		                                                                                                                                                  

			$dato['rotulo']="Nombre";
			$dato['valor']=$this->array_datos['datos_actividad']['actividad']['act_nombre'];
			$this->MultiCellEstilo("style_Subtitulo",$ancho_fila_dato,$alto_fila_dato+5,$dato['rotulo'],$this->ver_borde,'L',0,0);
			$this->SetX($this->GetX()+5);
			$this->MultiCellEstilo("style_TextoComun",$ancho_fila_dato-5,$alto_fila_dato,$dato['valor'],$this->ver_borde,'L',0,0);

			$dato['rotulo']="Código INAP";
			$dato['valor']=$this->array_datos['datos_actividad']['actividad']['act_codinap'];
			$this->CellEstilo("style_Subtitulo",30,$alto_fila_dato+5,$dato['rotulo'],$this->ver_borde,0,'L');
			$this->CellEstilo("style_TextoComun",30,$alto_fila_dato+5,$dato['valor'],$this->ver_borde,0,'L');
			$this->SetX($this->GetX()+5);

			$dato['rotulo']="Estado";
			$dato['valor']= $this->array_datos['datos_actividad']['actividad_autodesarrollo']['actauto_estado_desc'];
			$this->CellEstilo("style_Subtitulo",20,$alto_fila_dato+5,$dato['rotulo'],$this->ver_borde,0,'L');
			$this->MultiCellEstilo("style_TextoComun",$ancho_fila_dato-85,$alto_fila_dato+5,$dato['valor'],$this->ver_borde,'L',0,1);

			$dato_mostrar[]	 = array ('rotulo' => "Tipo de Actividad", 'valor' => $this->array_datos['datos_actividad']['actividad_autodesarrollo']['tipoact_descripcion']);			
			$dato_mostrar[]	 = array ('rotulo' => "Duración (Hs.)", 'valor' => $this->array_datos['datos_actividad']['actividad_autodesarrollo']['actauto_duracionhs']);			

			if ($this->array_datos['datos_actividad']['actividad_autodesarrollo']['es_evento']) {
			
				$dato_mostrar[]	 = array ('rotulo' => "Detalle sobre la duración", 'valor' => $this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['actautoeven_duraciondetalle']);			
				$dato_mostrar[]	 = array ('rotulo' => "Dirección", 'valor' => $this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['actautoeven_direccion']);			
				$dato_mostrar[]	 = array ('rotulo' => "Pais", 'valor' => $this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['paisnom']);			

				if (isset($this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['provincianom']))
					$dato_mostrar[]	 = array ('rotulo' => "Provincia", 'valor' => $this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['provincianom']);			

				if (isset($this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['orgapub_codigo'])) 	
					$organismo=$this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['orgapub_nombre'];
				elseif (isset($this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['orgapri_codigo']))
					$organismo=$this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['orgapri_nombre'];
				else 
					$organismo=$this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['jurisd_apn_nombre'];

				$dato_mostrar[]	 = array ('rotulo' => "Organismo", 'valor' => $organismo);		
				$dato_mostrar[]	 = array ('rotulo' => "Observaciones", 'valor' =>$this->array_datos['datos_actividad']['actividad_autodesarrollo_evento']['actautoeven_obs']);							

			} // evento

		} // formato actividad autodesarrollo

		// Se muestra cada item definido
		foreach ($dato_mostrar as $i => $dato) {	
			$this->MultiCellEstilo("style_Subtitulo",$ancho_fila_dato,$alto_fila_dato+5,$dato['rotulo'],$this->ver_borde,'L',0,0);
			$this->SetX($this->GetX()+5);
			$this->MultiCellEstilo("style_TextoComun",$ancho_fila_dato-5,$alto_fila_dato,$dato['valor'],$this->ver_borde,'L',0,0);
		}

		if ($this->array_datos['tipoact_codigo']==TIPOACTCURSOINAP  || $this->array_datos['tipoact_codigo']==TIPOACTCURSOJURISD)
			$this->_MostrarPrestadores();		

	}
	//----------------------------------------------------------------------------------------
	function _MostrarPrestadores()
	{

		$ancho_fila_dato = $this->anchoMaxTexto;
		$alto_fila_dato =  6;

		$this->MultiCellEstilo("style_Subtitulo",$ancho_fila_dato,$alto_fila_dato+5,"Prestadores Docentes",$this->ver_borde,'L',0,0);
		$this->SetX($this->GetX()+5);

		$header_type=array();
		$header_subtype = $this->GetEstiloTablaDefault("table_default_header_type");
	
		$i=0;			
		$ancho=20;
		$header_type[$i] = $this->GetEstiloTablaDefault("table_default_header_type");
		$this->SetEstiloDatoTabla($header_type[$i],"TEXT","CUIT/CUIL");
		$this->SetEstiloDatoTabla($header_type[$i],"WIDTH",$ancho);
		$color=$this->_ConvertirHexaRGB("#DFDFDF",$arreglocolores);
		$this->SetEstiloDatoTabla($header_type[$i],"BG_COLOR",$arreglocolores);
					
		$i=1;			
		$ancho=70;
		$header_type[$i] = $this->GetEstiloTablaDefault("table_default_header_type");
		$this->SetEstiloDatoTabla($header_type[$i],"TEXT","APELLIDO Y NOMBRE");
		$this->SetEstiloDatoTabla($header_type[$i],"WIDTH",$ancho);
		$color=$this->_ConvertirHexaRGB("#DFDFDF",$arreglocolores);
		$this->SetEstiloDatoTabla($header_type[$i],"BG_COLOR",$arreglocolores);
			
		$ancho=floor(($this->anchoMaxTexto-20)/2);
		$this->Table_Init(2, true, true);	

		$table_subtype = $this->GetEstiloTablaDefault("table_default_table_type");
		
		$this->SetEstiloDatoTabla($table_subtype,"L_MARGIN",10);
		$this->Set_Table_Type($table_subtype);
		
		for ($i=0; $i<2; $i++) 
			$this->SetEstiloDatoTabla($header_type[$i],"WIDTH",$ancho);
		
		$this->Set_Header_Type($header_type);
	
		$j=0;
		$data_subtype = $this->GetEstiloTablaDefault("table_default_data_type");
		
		$data_type = array();
		for ($i=0; $i<2; $i++) 
		{	
			$data_type[$i] = $data_subtype;
			$this->SetEstiloDatoTabla($data_type[$i],"WIDTH",25);
		}
		$this->Set_Data_Type($data_type);
		
		// $arreglotitulos=array();
		$fila_tabla_data=array();
		$this->InicializarColumnasConDatosVacios($fila_tabla_data,2);

		$tienedatos=false;
		while ($fila_prestador=mysqli_fetch_assoc($this->array_datos['datos_actividad_prestador'])) {
		 	$tienedatos=true;		 	
		 	
		 	$fila_tabla_data[0]['TEXT'] = $this->TextoWindows1252($fila_prestador['presdoc_cuilt']);
			$fila_tabla_data[1]['TEXT'] = $this->TextoWindows1252($fila_prestador['presdoc_apellido'].",".$fila_prestador['presdoc_nombre']); 
		 	
		 	$tabla_data[]=$fila_tabla_data;
		}
		
		if ($tienedatos)
		{		
			$this->Draw_Header();
			// $this->Draw_Data($arreglotitulos);
			
			foreach($tabla_data as $fila_data) {
				$this->Draw_Data($fila_data);
			}
			
			$this->Draw_Table_Border();
			
		}
		
	}
	//----------------------------------------------------------------------------------------	
	function InicializarColumnasConDatosVacios(&$data,$columnas)
	{
		for ($i=0; $i<$columnas; $i++) 
		{	
			$data[$i]['TEXT'] = "";
		}
	}
	//----------------------------------------------------------------------------------------
	function Footer() { 

		$ancho_fila_dato = $this->anchoMaxTexto;
		$alto_fila_dato =  6;          
		$this->SetY(-15); 
		$this->SetFont('Arial','I',8);
		$arreglocolores=$this->_ConvertirHexaRGB("#3D005F",$arreglocolores);
		$this->SetTextColor($arreglocolores['r'],$arreglocolores['g'],$arreglocolores['b']);	     
		$this->CellEstilo("",$ancho_fila_dato,$alto_fila_dato,"SAI - Sistema de Acreditación",$this->ver_borde,0,'L');
		$this->SetY(-15); 
		$this->CellEstilo("",$ancho_fila_dato,$alto_fila_dato,"Pág.".$this->PageNo()."/{nb}",$this->ver_borde,0,'R');
		$this->SetY(-15); 
		$this->Ln(4);
		$this->CellEstilo("",$ancho_fila_dato,$alto_fila_dato,"Fecha Impresión:".date("d/m/Y H:i:s")." Hs.",$this->ver_borde,0,'L');

	}		
	
} // fin clase	
?>
