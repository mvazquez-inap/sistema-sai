//-----------------------------funcion grilla----------------------------------------------
function MostrarGrillaSeleccion($conexion,$presdoc_codigo) 
{	
	$oActividad = new cActividad($conexion);
	$oPrestadorDocente = new cPrestadorDocente($conexion);
	$oDictamen = new cDictamen($conexion);					
	
	$ArregloDatos= array();
	$ArregloDatos['presdoc_codigo']=$presdoc_codigo;

	if(!$oPrestadorDocente->BuscarPrestadorDocentexActividad($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
		$txt_sys_mail="\nerror=".$error;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}


	if($numfilas>0)
	{
		$i=1;
		$arrayresult = array();
		while ($fila=mysqli_fetch_assoc($resultado))	{
		
			if (!$oActividad->TraerDatosActividad($fila['act_codigo'],$filaact,$es_modif)) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
			}
			
			// busco las fecha de programación 
			// traigo los dictámenes DICTAMENACTIVO de la actividad
			$ArregloDatosDic = array();
			$ArregloDatosDic += array("act_codigo"=>$fila['act_codigo']);	
			//$ArregloDatosDic += array("dic_estado"=>DICTAMENACTIVO);							

			$oDictamen->BuscarDictamen($ArregloDatosDic,$numfilasdic,$array_resultado_dictamen,$error,$errormail);
			$fecha = "";
			foreach ($array_resultado_dictamen as $clave=>$valor) {
				if ($valor['dic_estado'] == DICTAMENACTIVO)
					if(isset($valor['actprog_fecha_inicio']))	
						$fecha .= FuncionesPHPLocal::ConvertirFecha($valor['actprog_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa')." a ".FuncionesPHPLocal::ConvertirFecha($valor['actprog_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa')."\n\r"; 
					else 
						$fecha .="";
			}	
			
			$arrayresult[$i]['act_codinap']= $filaact['act_codinap'];
			$arrayresult[$i]['act_nombre']= $filaact['act_nombre'];
			$arrayresult[$i]['fecha']= $fecha;			
			$i++;
		}
	}
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>$numfilas
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
			
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'CÓDIGO INAP');
	$oGrilla->Setear('campo_grilla',$miColumna1,'act_codinap');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	
	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'NOMBRE');
	$oGrilla->Setear('campo_grilla',$miColumna2,'act_nombre');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'PROGRAMACIONES');
	$oGrilla->Setear('ancho_columna',$miColumna3,'180');
	$oGrilla->Setear('campo_grilla',$miColumna3,'fecha');
	$oGrilla->Setear('align_columna',$miColumna3,'center');


	if (!$oGrilla->CargarGrilla($arrayresult))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
//----------------------------------------------------------------------------------------- 
