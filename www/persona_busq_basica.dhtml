<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccion($conexion,$ArregloDatos, &$estado_leyenda) {

	$oPersonas = new cPersonas($conexion);

	switch ($_SESSION['array_busqueda_basica_persona']['accion'] ) {

		case "Actualizar" :
		case "Inscripcion" :
			$ArregloDatos['pers_estado'] = PERSONAACTIVA ;
			$estado_leyenda = " ACTIVO ";
			break;

		case "Rehabilitar" :
			$ArregloDatos['pers_estado'] = PERSONABAJA ;
			$estado_leyenda = " BAJA ";
			break;

		case "Dictaminar" :
		case "PedirAprobacion" :
		case "Todos" :		
			$estado_leyenda = " BAJA o ACTIVO ";
			break;	
	}
	
	
	if(!$oPersonas->BuscarPersonas($ArregloDatos,$numfilas,$result,$error,$errormail)){
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}			
	
	if ($numfilas >=LIMITE_BUSQUEDA_CHICO) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda retornó demasiadas filas, ajuste el criterio de búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}

	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda no retornó resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}
	
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>10
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
	
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'CUIT');
	$oGrilla->Setear('campo_grilla',$miColumna1,'pers_cuilt');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	$oGrilla->Setear('ancho_columna',$miColumna1,'100');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Apellido');
	$oGrilla->Setear('campo_grilla',$miColumna2,'pers_apellido');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna3,'pers_nombre');
	$oGrilla->Setear('align_columna',$miColumna3,'left');
	
	$miColumna4 = $oGrilla->AddColumna('addValor');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Seleccionar');
	$oGrilla->Setear('imagen',$miColumna4,'images/seleccionar.jpg');
	$oGrilla->Setear('ancho_columna',$miColumna4,'80');
	$oGrilla->Setear('altImagen',$miColumna4,'Seleccionar');
	$oGrilla->Setear('idtextboxAddValor',$miColumna4,$_SESSION['array_busqueda_basica_persona']['idtextboxAddValor']);
	
	if (!$_SESSION['array_busqueda_basica_persona']['submit']) {
		$oGrilla->Setear('submitAddValor',$miColumna4,'no');
		$oGrilla->Setear('documentAddValor',$miColumna4,'window.opener.document');
		$oGrilla->Setear('nombreContenidoAddValor',$miColumna4,'pers_cuilt');
		$oGrilla->Setear('idtextoContenidoAddValor',$miColumna4,'pers_cuilt');
	} else {
		$oGrilla->Setear('submitAddValor',$miColumna4,'si');
		$oGrilla->Setear('nombreFormularioSubmitAddValor',$miColumna4,$_SESSION['array_busqueda_basica_persona']['formulario']);
	}	
	
	$oGrilla->AddParametrosAddValor($miColumna4,'pers_cuilt');

	if (!$oGrilla->CargarGrilla($result))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
//----------------------------------------------------------------------------------------- 
?>
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 TRANSITIONAL//EN"> 
<html>
<head>
<title>Búsqueda &nbsp;</title>
