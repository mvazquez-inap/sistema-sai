<script type="text/javascript">
function cambiarPertinencia (docu,form,idDiv) {

	var elSelect = docu.getElementById(idDiv);
	if (form.dic_pertinencia.value == '<?php echo SI?>') {
		elSelect.style.display ="block";
	} else {
		elSelect.style.display ="none";	
	}		
	return true;
}
//-----------------------------------------------------------------------------------------------------
function buscarActividadPersona(formulario,divPersona,pers_cuilt,act_codigo,formact_codigo,tipoact_codigo) {

	var item_obj = EncontrarObjeto(divPersona);
	var objAguarde = EncontrarObjeto('idAguarde');	
	if (objAguarde != null)
		objAguarde.innerHTML='Aguarde ...';	
	
	item_obj.innerHTML="";
	
	var ajax=nuevoAjax();
	var datos="pers_cuilt="+trim(pers_cuilt)+"&act_codigo="+act_codigo;
	    datos=datos+"&formact_codigo="+formact_codigo+"&tipoact_codigo="+tipoact_codigo;
	
	var archivo = "actividad_dictaminar_persona_ajax.dhtml";
	ajax.open("POST",archivo,true);
	ajax.onreadystatechange=function() {
		if (ajax.readyState==4) {	
			if (objAguarde != null)
				objAguarde.innerHTML='';	
			item_obj.innerHTML=ajax.responseText;	
			return true;
		}
	}	

	ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded'); 
	ajax.send(datos);		
	return false;
}
//-----------------------------------------------------------------------------------------------------
</script>
