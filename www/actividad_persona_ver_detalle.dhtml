									break;
								
							}
						echo htmlspecialchars($observacioones,ENT_QUOTES)."&nbsp";	?>
					</tr>
				<?php } ?>
			<?php } ?>
		<?php } else { ?>
			<tr>
				<td valign="top" class="textoEtiqueta" width="30%" colspan="2">La persona no es un Agente</td>
			</tr>
		<?php } ?>

		<?php if ($formact_codigo==FORMATOCURSO) { ?>
			<tr>
				<td valign="top" width="30%" class='textoEtiqueta'>Resultado Evaluación </td>
				<td class="textoEtiquetaDatoResaltado">
					<?php
					$conexion->TraerCampo("evaluacion","eval_descripcion",array("eval_codigo='",$fila_asignacion['eval_codigo'],"'"),$eval_desc,$numfilas,$errorcod);
					echo htmlspecialchars($eval_desc,ENT_QUOTES);
					?>
				</td>
			</tr>
			<tr>
				<td valign="top" width="30%" class='textoEtiqueta'>C&oacute;digo de Comisi&oacute;n INAP</td>
				<td class="textoEtiquetaDatoResaltado">
					<?php
					$oComision = new cComision($conexion);
					$oComision->TraerDatosComision($fila_asignacion['comi_codigo'],$fila_comision,$es_modif);
					echo htmlspecialchars($fila_comision['comi_codinap'],ENT_QUOTES);
					?>
				</td>
			</tr>

			<tr>
				<td valign="top" width="30%" class='textoEtiqueta'>Fecha de la Comisi&oacute;n INAP</td>
				<td class="textoEtiquetaDatoResaltado">
					<?php
		            echo 	FuncionesPHPLocal::ConvertirFecha($fila_comision['comi_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa').
							' al '.
						  	FuncionesPHPLocal::ConvertirFecha($fila_comision['comi_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa');
					?>
				</td>
			</tr>

			<tr>
				<td valign="top" width="30%" class='textoEtiqueta'>Estado Comisi&oacute;n</td>
				<td class="textoEtiquetaDatoResaltado">
					<?php
					$conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","COMISIONESTADO","' and constantecod='",$fila_comision['comi_estado'],"'"),$estado_desc,$numfilas,$errorcod);
					echo htmlspecialchars($estado_desc,ENT_QUOTES);
					?>
				</td>
			</tr>
		<?php } ?>
	</table>
<?php	} ?>
</body>
</html>