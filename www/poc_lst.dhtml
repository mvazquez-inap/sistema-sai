<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
$oPoc = new cPoc($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoConsulta();

//----------------------------------------------------------------------------------------------------------------------------
function armarArrayParametros($str_param,&$param) { 

	$param = array();
	$vparam = array();
	$vparam = explode("#",$str_param); 
	
	foreach($vparam as $i=>$v) {
		list($input,$valor)=explode("=",$v);					
		$param[$input]=$valor;
	}
}
//----------------------------------------------------------------------------------------- 
?>
<div align="left">
<table border="0" cellspacing="0" width="750" cellpadding="2">
    <tr> <td>

<?php  require ('templates/rpt_imprimir.tpl.dhtml');  ?>
	<br/><br/>
<?php 
//----------------------------------------------------------------------------------------------------------------------------
	// Recibe por POST el código de listado y los parámetros que inician con param_
	
	$cod_listado=$_POST['cod_listado'];
	// armo parametro para el listado
	$str_param="";
	
	// Todos los parametros a enviar al listado vienen en el post en variables con nombre param_
	$separador = "#";
	foreach ($_POST as $nombre => $valor) {		// Le saco el param
		if (substr($nombre,0,5)=='param') {
			$nombre_enviado=substr($nombre,6);
			$str_param.=($nombre_enviado."=".$valor).$separador;
		}	
	}		
	$str_param=substr($str_param,0,-1);		// cadena de parametros separados por #
											// poc_codigo=30#pocact_codigo=10
	switch ($cod_listado) {
	
		case 1:				// Diseño básico del Poc
	
			armarArrayParametros($str_param,$param);
			
			$oPoc = new cPoc($conexion);
			if(!$oPoc->ListarDisenoPoc($param['poc_codigo'])) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al listar el poc.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			}
			break;

		case 2:				// Diseño básico del Poc x Objetivo
	
			armarArrayParametros($str_param,$param);
			$oPoc = new cPoc($conexion);
			if(!$oPoc->ListarDisenoPoc($param['poc_codigo'],$param['pocobj_codigo'])) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al listar el poc.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			}
			break;
	
		default:				
	
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No esta definido el listado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			break;
	
	}

?>
   	</td>
    </tr>
  </table>
</div>
<?php
$oEncabezados->PieConsulta();
?>