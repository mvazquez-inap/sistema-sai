			} else //  Cualquier error es informado en BorrarDisposicion
				$commit=false;
			break;	

		default: 
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en la operación",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
