function LitarDireccionElectronicaDP($idconexion,$titulo,$fila_datos_privados,$no_error) {
$no_error=true;
?>
<table border=0 cellpadding=0 cellspacing=7 style="width:100%" class="textoTablaDato">
	<tr class="textoGrupoTitulo">
	  <td colspan="3"> <?php echo $titulo; ?>  </td>
	</tr>

	<?php for ($i=1;$i<=3;$i++) {
		if($fila_datos_privados["usudp_email".$i]!="") {
	?>	<tr>
			<td nowrap class="textoEtiqueta">Email:</td>
			<td><?php echo htmlspecialchars($fila_datos_privados["usudp_email".$i],ENT_QUOTES); ?></td>	
		</tr>
	<?php } 
	 } 
	 if($fila_datos_privados['usudp_web1']!="") {
	?>	<tr>
		  <td nowrap class="textoEtiqueta">Web:</td>
		  <td><?php echo "<a href='".$fila_datos_privados['usudp_web1']."' class='linkTablaDatoChico'>".$fila_datos_privados['usudp_web1']."</a>"?> </td>
		</tr>
	<?php } ?>
</table>
<?php } 
//---------------------------------------------------------------------------
// Lo usa ventana texto y funciones cargo
//---------------------------------------------------------------------------
// Muestra la estructura jerárquica inferior a jurisdactual, sin incluirse a si misma
function MostrarJerarquiaDescendente($objJurisdicciones,$operacion,$jurisdactual){
?>
	<table style="width:100%" class="textoTablaDato" cellpadding="0" cellspacing="0"> 
<?php	if ($objJurisdicciones->SubArbolDependiente($jurisdactual['jurisdid'],1,array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'porderby'=>'jurisdarbolorden'),TABGRALES_TS_ARRAY,$subArbolDep,array(),$NumFilas,$CodError)) {?>	
		<tr>
			<td> 		
<?php			    if ($NumFilas > 1) { // Siempre da por lo menos la jurisdicción que se busca ?>
				  <p><?php echo "Organismos dependientes:"; ?> </p> 
<?php			    } ?>
				<ul style="border:0"> 
		<?php		foreach ($subArbolDep as $clave => $valor) {
					if ($jurisdactual['jurisdid'] != $valor['jurisdid']) {
					  if (isset($_GET['menuizquierdo'])) { // para el portal
						$link="menuizquierdo=".$_GET['menuizquierdo'];
						$link.="&amp;"."jurisdid=".$valor['jurisdid'];
					  }	else 
  						$link="jurisdid=".$valor['jurisdid'];
 					  
					  
					  if ($operacion=="v") { ?> 		 
								<li style="vertical-align:middle;" class="itemListaLinkEstructura"><a href="<?php echo "buscar_estructura.dhtml?".$link; ?>" class="linkEstructura"><?php echo htmlspecialchars($valor['jurisdnom'],ENT_QUOTES) ?></a> 
					<?php 	} else {  ?>
								<li style="vertical-align:middle;" class="itemListaEstructura"><?php echo htmlspecialchars($valor['jurisdnom'],ENT_QUOTES); 
						} ?>	
		<?php			}	
				} ?>		
				</ul> 	
			</td>
		</tr>
<?php	} else { ?>						
		<tr>
			<td><?php MostrarMensaje_viejo($idconexion,MSG_ERRSOSP,"Error en el código de organismo enviado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);	?> </td>
		</tr>
<?php	}		?>
	
	</table>
<?php
} // fin - MostrarJerarquiaDescendente

//---------------------------------------------------------------------------
// Muestra la estructura jerárquica superior a jurisdactual, sin incluirse a si misma
function MostrarJerarquiaAscendente($objJurisdicciones,$operacion,$jurisdactual,$cant_niveles,$titulo=""){
?>
	<table width="100%" class="textoTablaDato" cellpadding="0" cellspacing="0"> 
<?php		
	if ($objJurisdicciones->RamaAscendente($jurisdactual['jurisdid'],$cant_niveles,array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'porderby'=>'jurisdarbolorden'),TABGRALES_TS_ARRAY,$RamaAsc,array(),$NumFilas,$CodError)) {
		if ($NumFilas > 1) { // Siempre da por lo menos la jurisdicción que se busca
?>			<tr align="left">
				<td class="textoEtiqueta"><?php echo $titulo; ?></td>
			</tr>		
<?php		} ?>		
		<tr>
		<td align="left"> <?php
		$i=0;
		foreach ($RamaAsc as $clave=>$valor) {
			$i++;			
			if ($jurisdactual['jurisdid'] != $valor['jurisdid']) {				
				  if (isset($_GET['menuizquierdo'])) {
					$querystring="menuizquierdo=".$_GET['menuizquierdo'];
					$querystring.="&amp;"."jurisdid=".$valor['jurisdid'];
				 } else 		
					$querystring="jurisdid=".$valor['jurisdid'];

				if ($operacion=="v") {			
					echo "<ul><li style='margin-left:-25px;vertical-align:middle' class='itemListaLinkEstructuraSuperior'>".$i.".";
			?> 		<a class="linkEstructura" href="<?php echo "buscar_estructura.dhtml?".$querystring ?>"> <?php echo htmlspecialchars($valor['jurisdnom'],ENT_QUOTES) ?></a>
			<?php 	} else {
					echo "<ul><li style='margin-left:-25px;vertical-align:middle' class='itemListaLinkEstructuraSuperior'>".$i.".";
					echo htmlspecialchars($valor['jurisdnom'],ENT_QUOTES)?> 
			<?php  }
		}	
	} 		
    $j=0;	
	for ($j;$j<$i-1;$j++) // Tiene la jurisdicción actual
		echo "</li></ul>";

?>		</td>
	</tr>

<?php	} else { ?>						
		<tr>
			<td><?php	MostrarMensaje_viejo($idconexion,MSG_ERRSOSP,"Error en el código de organismo enviado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO); ?> </td>
		</tr>
<?php	}		?>
	</table>
<?php
} // fin - MostrarJerarquiaAscendente

//---------------------------------------------------------------------------
// Carga en la sesión la versión actual de Jurisdicciones
function CargarVersionJurisdicciones($idconexion){

		$param=array();
		if (($result=ejecutarStoredProcedure($idconexion,"sel_jurisdiccion_version",$param))<0
		|| mysqli_num_rows($result)!=1 ) {
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar las jurisdicciones.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>"Se ha producido un error al seleccionar la versión de jurisdicciones.");			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;
		}	
		

		$fila_version = mysqli_fetch_assoc($result);
		$_SESSION['jurisversion_actual'] = $fila_version['jurisversion_actual'];

		return true;


}


?>