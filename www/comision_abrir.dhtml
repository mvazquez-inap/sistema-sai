<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oComision= new cComision($conexion);
//----------------------------------------------------------------------------------------- 
$filacomision=array();
$filacomision['comi_codinap']=(isset($_POST['comi_codinap_seleccion']))?$_POST['comi_codinap_seleccion']:"";
$filacomision['comi_codigo']=(isset($_POST['comi_codigo']))?$_POST['comi_codigo']:"";

if (isset($_POST['comi_codinap_seleccion'])) {
	if($conexion->TraerCampo("comision","comi_codigo",array("comi_codinap='",$_POST['comi_codinap_seleccion'],"'"),$comi_codigo,$numfilas,$errno))
		$filacomision['comi_codigo']=htmlspecialchars($comi_codigo,ENT_QUOTES);
}

$destino_formulario_interface="comision_abrir.dhtml";
?>
<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oComision->PedirComision($filacomision['comi_codinap'],'formulario_seleccion','comi_codinap_seleccion','Actualizar'); ?></td>
	</tr>
	</table>
</form>	
<?php
$es_modif=false;
$ok=false;

if ($filacomision['comi_codigo']=="") {

	if ( isset($_POST['comi_codigo']) || isset($_POST['comi_codinap_seleccion']) )
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

} else {

	if ($oComision->TraerDatosComision($filacomision['comi_codigo'],$filacomision,$es_modif)) {
		if (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else { 
			if ($oComision->TienePermisoModificar($filacomision['comi_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
				// La comisión tiene definido el cronograma.
				$ArregloDatos=array("comi_codigo"=>$filacomision['comi_codigo']);	
				$oComisionCronograma = new cComisionCronograma($conexion);
		
				if (!$oComisionCronograma->BuscarComiCronograma($ArregloDatos,$numfilas,$result,$error,$errormail)) {
					$txt_sys_mail="\comi_codigo=".$comi_codigo."\nerror=".$errormail;
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos del cronograma.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				} elseif ($numfilas==0) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La comisión debe tener definida la fecha de realización.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else { 
					// La comisión tiene asignado por lo menos un docente. 
					$ArregloDatos=array("comi_codigo"=>$filacomision['comi_codigo']);	
					$oComisionPrestadorDocente = new cComisionPrestadorDocente($conexion);
					if (!$oComisionPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
						$txt_sys_mail="Error al buscar docentes - \ncomi_codigo=".$datos['comi_codigo'];
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar docentes de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					} elseif ($numfilas==0) {
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La comisión debe tener por lo menos un docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					} else 					
						$ok=true;
				}	
			} // Tiene permiso el usuario sobre la comision
		}	// Se encontró la actividad con el formato esperado		
	} // No se produjo error al buscar la actividad con el formato esperado		
} // seleccion de actividad

if ($ok) { 
	$destino_formulario_upd="comision_abrir_upd.dhtml";
?>	<form action="<?php echo $destino_formulario_upd ?>" method="post" name="formulario">
		<div style="width:95%; margin-left:10px" align="left" class="textoAtencion">Verifique todos los datos de la comisión antes de su apertura, luego de la misma NO podrá modificar los datos básicos, ni el cronograma, ni los docentes. </div>
		<div style="width:95%" align="right"><a href="comision_modificar.dhtml?comi_codigo=<?= $filacomision['comi_codigo'] ?>">Ir a la Comisi&oacute;n</a></div>
<?php		if($oComision->MostrarDatosComision($conexion,"V",$filacomision)){ ?>
			<table width="100%" class="textoTablaDato" align="center">
				<tr align="center">
					<td colspan="2" valign="top">
						<input type="submit" name="boton_confirma" class="botones" value="Abrir Comisión">
						&nbsp;&nbsp;&nbsp;&nbsp;
						<input type="hidden" name="comi_codigo" value="<?php echo htmlspecialchars($filacomision['comi_codigo'],ENT_QUOTES); ?>">
					</td>
				</tr>	
			</table>
<?php 		} // MostrarDatosComision ?>
	</form>	
<?php	
} // fin ok
$oEncabezados->PieMenuEmergente(); 
?>