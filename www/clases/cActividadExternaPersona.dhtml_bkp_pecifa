		$fechainicio_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['actext_act_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd');
		$fechafin_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['actext_act_fecha_fin'],'dd/mm/aaaa','aaaa-mm-dd');
