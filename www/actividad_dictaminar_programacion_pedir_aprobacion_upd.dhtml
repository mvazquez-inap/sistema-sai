<?php require('./include.dhtml');
$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
$oDictamen = new cDictamen($conexion);
//----------------------------------------------------------------------------------------- 	
$conexion->ManejoTransacciones("B");
$result=true;

if(!$oDictamen->PedirAprobacionDictamen($_POST))
	$result=false;

if($result) {	
	if ($_POST['operacion'] == "P") {
		$operacion_mensaje = "PEDIDO DE APROBACION (Dictamen)";			
		FuncionesPHPLocal::RegistrarAcceso($conexion,"49006","act_codigo=".$_POST["act_codigo"]."- dic_codigo=".$_POST["dic_codigo"],$_SESSION['usuariocod']);
	}	
	
	$oDictamen->ArmarMensajePedidoAprobacion($_POST,$mensaje);
	$asunto = SISTEMA." - Pedido de Aprobación de Dictamen";

	if (FuncionesPHPLocal::MandarMail($conexion,COORDINADORINAP,$_SESSION['jurisdid_inap'],$asunto,$mensaje)) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"En unos momentos el Coordinador INAP recibirá un correo electrónico <BR> con la solicitud de aprobación requerida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	} else {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El correo electrónico con la solicitud de aprobación del dictámen no fue enviado,<br> notifique al Coordinador INAP por otra via.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	}

	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha efectuado el pedido de aprobación del dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	$conexion->ManejoTransacciones("C");

} else	
	$conexion->ManejoTransacciones("R");

if ($_SESSION['rolcod']==USUCURSOINAP || $_SESSION['rolcod']==USUACTINS ||
	$_SESSION['rolcod']==USUACTJUR || $_SESSION['rolcod']==USUACTEXT ) 
	$volver ="actividad_dictaminar_programacion_pedir_aprobacion.dhtml"."?exp_codigo=".$_POST['exp_codigo']."&amp;";
elseif ($_SESSION['rolcod']==USUAUTODESARROLLO)
	$volver ="actividad_dictaminar_autodesarrollo_pedir_aprobacion.dhtml"."?";
?>		
<br><br><div align="center"><a href="<?=$volver ?>volver=si" class="linkFondoBlanco">Volver</a></div>
<?php $oEncabezados->PieMenuEmergente(); ?>