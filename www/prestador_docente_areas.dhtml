	</form>
<?php
	$modulo_recarga= "prestador_docente_areas.dhtml";
	$result = true;

	//--------------------------
	// Se confirmo la operacion 
	//--------------------------
	if (isset($_POST['boton_confirma'])) {
	
		$commit=true;
		$conexion->ManejoTransacciones("B");
	
		// Alta - Baja - Modificación
		if ($commit) {
	
			switch($_POST['operacion']) {
	
			case 'I': 				
			
				if ($oPrestadorDocenteArea->AltaDatosPrestadorDocenteArea($_POST)) {
					FuncionesPHPLocal::RegistrarAcceso($conexion,"36201","presdoc_codigo=".$_POST['presdoc_codigo']."- areacon_gen_esp_codigo=".$_POST['area_con_gen_esp'],$_SESSION['usuariocod']);
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha insertado el área seleccionada. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else  
					$commit=false;
				break;	
			
			case 'B': 
			
				if ($oPrestadorDocenteArea->EliminarDatosPrestadorDocenteArea($_POST)) {
					FuncionesPHPLocal::RegistrarAcceso($conexion,"36202","presdoc_codigo=".$_POST['presdoc_codigo']."\nareacon_gen_esp_codigo=".$_POST['areacon_codigo']."_".$_POST['areagen_codigo'].$_POST['areaesp_codigo'],$_SESSION['usuariocod']);
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha eliminado el área seleccionada. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else  
					$commit=false;
				break;	
				
			default: 
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$commit=false;
			} // $switch
			
			if($commit)
				$conexion->ManejoTransacciones("C");
			else
				$conexion->ManejoTransacciones("R");
		}	// commit
	} // seteado el confirma 
	
	//--------------------
	// Se define la acción
	//--------------------
	if (!isset($_GET['operacion'])) {
		$leyenda_operacion = "Agregar";
		$boton_operacion = "Agregar";		
		$operacion = "I";
	} else {
		switch ($_GET['operacion']) {		
		case "B" :
				$leyenda_operacion = "Eliminar";		
				$boton_operacion = "Eliminar";		
				$operacion = "B";				
				break;
		default:
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error de operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result=false;
		}
	}
	//------- GRILLA VALORES A MODIFICAR 
	if ($result)  { 	?>
		<table width="100%" class="textoTablaDato">
			<tr> 
				<td align="center">						
	<?php				if (!MostrarGrillaSeleccion($conexion,$modulo_recarga,$filaprestador['presdoc_codigo']))
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar datos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	?>			</td>
			</tr>	
		</table>
		<br>
<?php	}
	//------- DATOS DE UN REGISTRO
