<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oActividadCursoJurisdiccional = new cActividadCursoJurisdiccional($conexion);
//-----------------------------------------------------------------------------------------------
$conexion->ManejoTransacciones("B");
$result=true;

if(!$oActividadCursoJurisdiccional->PedirAprobacionActividadCursoJurisdiccional($_POST['act_codigo']))
	$result=false;

if($result) {
	if ($_POST['operacion'] == "P") {
		$operacion_mensaje = "PEDIDO DE APROBACION (Actividad)";			
		FuncionesPHPLocal::RegistrarAcceso($conexion,"38601","act_codigo=".$_POST["act_codigo"],$_SESSION['usuariocod']);
	}
	$oActividadCursoJurisdiccional->ArmarMensajePedidoAprobacion($_POST,$mensaje);

	$conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$_SESSION['jurisdid_inap'],"'"),$jurisdnom,$numfilas,$errno);
	$asunto = SISTEMA." - Pedido de Confirmación Carga de Actividad POC - ".$jurisdnom;
	if (FuncionesPHPLocal::MandarMail($conexion,USUACTJUR,$_SESSION['jurisdid_inap'],$asunto,$mensaje)) 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"En unos momentos Coordinador Institucional recibirá un correo electrónico <BR> con la solicitud de aprobación requerida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	else 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El correo electrónico con la solicitud de aprobación no fue enviado, <BR> notifique la solicitud al Coordinador Institucional por otra via.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha efectuado el pedido de aprobación de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	$conexion->ManejoTransacciones("C");

} else	
	$conexion->ManejoTransacciones("R");
?>
	<br><div align="center"><a href="actividad_curso_pedir_aprobacion.dhtml" class="linkFondoBlanco">Volver</a></div>

<?php $oEncabezados->PieMenuEmergente(); ?>