<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
//---------------------------------------------------------------------------------------------------------
$destino_formulario_interface="actividad_menu_lst.dhtml";

$fila_actividad['act_codinap']=(isset($_POST['act_codinap_seleccion']))?$_POST['act_codinap_seleccion']:"";
$fila_actividad['act_codigo']=(isset($_POST['act_codigo']))?$_POST['act_codigo']:"";
if (isset($_POST['act_codinap_seleccion'])) {
	if($conexion->TraerCampo("actividad","act_codigo",array("act_codinap='",$_POST['act_codinap_seleccion'],"'"),$act_codigo,$numfilas,$errno))
		$fila_actividad['act_codigo']=htmlspecialchars($act_codigo,ENT_QUOTES);
}

switch ($_SESSION['rolcod']) {
	case USUCURSOINAP:
		$formact_codigo=FORMATOCURSO;
		$oActividad= new cActividadCursoInap($conexion);
		$tipoact_codigo=TIPOACTCURSOINAP;
		break;
	case USUACTINS:
		$formact_codigo=FORMATOCURSO;
		$oActividad= new cActividadCursoInstitucional($conexion);
		$tipoact_codigo=TIPOACTCURSOINST;
		break;
	case COORDINADORTECNICO:
	case USUORGANISMO:
	case USUACTJUR:
		$formact_codigo=FORMATOCURSO;
		$oActividad= new cActividadCursoJurisdiccional($conexion);
		$tipoact_codigo=TIPOACTCURSOJURISD;
		break;
	case USUAUTODESARROLLO:
		$formact_codigo=FORMATOAUTO;
		$oActividad= new cActividadAutodesarrollo($conexion);
		$tipoact_codigo=TIPOACTAUTODOCENTE; // se asigna cualquier tipo de AUTODESARROLLO
		break;
	case USUACTEXT:
		$formact_codigo=FORMATOEXT;
		$oActividad= new cActividadExterna($conexion);
		$tipoact_codigo=TIPOACTEXTASIS;
		break;
}
?>
<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oActividad->PedirActividad($fila_actividad['act_codinap'],'formulario_seleccion','act_codinap_seleccion','Imprimir'); ?> </td>
	</tr>
	</table>
</form>	
<?php

$ok = false;
if ($fila_actividad['act_codigo']=="") {

	if ( isset($_POST['act_codigo']) || isset($_POST['act_codinap_seleccion']) )
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

} else {


	$tiene_formato_auto = false;
	if (!$oActividad->TieneFormato($fila_actividad['act_codigo'],FORMATOAUTO,$tiene_formato_auto)) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error verificar formatos de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
		$ok =  false;
	} 
	if (!$tiene_formato_auto) {

	if(!$oActividad->TieneFormatoTipo($fila_actividad['act_codigo'],$formact_codigo,$tipoact_codigo,$tipook))		
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al determinar el tipo de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		elseif ($tipook) 
		 		$ok = true;				
			else 
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad con el formato a listar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	} else 
		$ok = true;


	if ($ok) { ?>
		<br>
		<ul style="vertical-align:middle; margin-top:16px; text-align:left"> 
	<?php	 switch ($tipoact_codigo) {
			 case TIPOACTCURSOINAP:
			 case TIPOACTCURSOJURISD:
			 case TIPOACTCURSOINST:
				?>
				<li>
				<a class="linkListadoMenu" href='javascript:void(0)' onClick="Popup('actividad_diseno_lst.dhtml?act_codigo=<?php echo $fila_actividad['act_codigo']."&amp; tipoact_codigo=".$tipoact_codigo ?>','ventana_descripciones',650,450,screen.availWidth-700,screen.availHeight-500,'yes');">
				  Ver diseño de la actividad 
				</a> 
				</li>
				<?php
				break;
			 case TIPOACTEXTASIS:
			 case TIPOACTAUTODOCENTE:
			 case TIPOACTAUTOEVASIS:
			 case TIPOACTAUTOEVACT:
			 case TIPOACTAUTOPUBLI:
			 case TIPOACTAUTOASISTEC:	 	 	 
			 case TIPOACTAUTOAAUTOFORM:	 
				?>
				<li>
				<a class="linkListadoMenu" href='javascript:void(0)' onClick="Popup('actividad_detalle_lst.dhtml?act_codigo=<?php echo $fila_actividad['act_codigo']."&amp; tipoact_codigo=".$tipoact_codigo ?>','ventana_descripciones',650,450,screen.availWidth-700,screen.availHeight-500,'yes');">
				  Ver detalle de la actividad 
				</a> 
				</li>
				<?php
				break;
		}
		?>	
		</ul>
	<?php
	} // if ok
}
$oEncabezados->PieMenuEmergente(); 
?>