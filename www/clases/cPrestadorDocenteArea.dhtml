class cPrestadorDocenteArea 
{
	var $conexion;

	public function __construct($conexion) {
		$this->conexion = &$conexion;
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosDocenteArea($presdoc_codigo,&$datosresult,&$es_modif){
		echo "<br>Falta implementar.";
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function AltaDatosPrestadorDocenteArea($datos) {
		
		if(!$this->_DatosValidosAltaPrestadorDocenteArea($datos,$datosvalidados))
			return false;
	
		$oPrestadorDocente=new cPrestadorDocente($this->conexion);
		
		if(!$oPrestadorDocente->TraerDatosPrestadorDocente($datosvalidados['presdoc_codigo'],$filaprestador,$es_modif))  {
			$error="Error al buscar el prestador docente.";
			$errormail="Error al buscar el prestador docente en tabla presador_docente \n presdoc_codigo=".$datosvalidados['presdoc_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		
		// Si el prestador tiene estado inactivo (no tenia areas) tiene que pasar a activo.
		if($filaprestador['presdoc_estado']==PRESDOCINACTIVO) { 
			if (!$oPrestadorDocente->ActivarDatosPrestadorDocente($datosvalidados['presdoc_codigo'])) 
				return false;
			else 
				FuncionesPHPLocal::RegistrarAcceso($this->conexion,"36109","\npresdoc_codigo=".$datosvalidados['presdoc_codigo'],$_SESSION['usuariocod']);
		}
				
		$spnombre="ins_prestador_docente_area_especifica";
		$spparam=array(
			'ppresdoc_codigo'=>$datosvalidados['presdoc_codigo'],
			'pareagen_codigo'=>$datosvalidados['areagen_codigo'],
			'pareaesp_codigo'=>$datosvalidados['areaesp_codigo'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo agregar el área específica al prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosPrestadorDocenteArea($datos) {
	
		if(!$this->_DatosValidosEliminarPrestadorDocenteArea($datos,$datosvalidados))
			return false;

		$spnombre="del_prestador_docente_area_especifica";
		$spparam=array(
			'ppresdoc_codigo'=>$datosvalidados['presdoc_codigo'],
			'pareagen_codigo'=>$datosvalidados['areagen_codigo'],
			'pareaesp_codigo'=>$datosvalidados['areaesp_codigo'],
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod)) 
			return false;					  	 	

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosPrestadorDocenteAreaTodas($presdoc_codigo) {

			$spnombre="del_prestador_docente_area_especifica_xpresdoc_codigo";
			$spparam=array(
				'ppresdoc_codigo'=> $presdoc_codigo
			);

			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod)) 
				return false;					  	 	
	
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"36202","Global / presdoc_codigo=".$presdoc_codigo,$_SESSION['usuariocod']);

		return true;
	}	
