					</tr>
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Sexo</td>
						<td class="textoEtiquetaDatoResaltado">
						<?php $conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","SEXO","' and constantecod='",$filaprestador['presdoc_sexo'],"'"),$descri,$numfilascaracter,$errorcod); 
							echo $descri;
						?>
						</td>
					</tr>
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Pais de Origen </td>
