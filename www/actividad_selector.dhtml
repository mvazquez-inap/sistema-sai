<?php


if (isset($_POST['boton_buscar'])) {
	$_SESSION['array_busqueda_basica_actividad']=array();
	$_SESSION['array_busqueda_basica_actividad']['destino']=$_POST['destino'];
	$_SESSION['array_busqueda_basica_actividad']['formulario']=$_POST['formulario'];
	$_SESSION['array_busqueda_basica_actividad']['submit']=$_POST['submit'];
	$_SESSION['array_busqueda_basica_actividad']['tipoact_codigo']=$_POST['tipoact_codigo'];
	$_SESSION['array_busqueda_basica_actividad']['accion']=$_POST['accion'];


	$_SESSION['filtro_busqueda']=array();
	$_SESSION['filtro_busqueda']['act_codinap']=trim($_POST['act_codinap']);
	$_SESSION['filtro_busqueda']['act_nombre']=trim($_POST['act_nombre']);
}
if (!isset($_SESSION['array_busqueda_basica_actividad'])) {
	$_SESSION['array_busqueda_basica_actividad']=array();
	$_SESSION['filtro_busqueda']=array();
}


if(isset($_POST['boton_buscar']) || isset($_GET['pagina']) ) {

	MostrarGrillaSeleccion($conexion,$_SESSION['filtro_busqueda'],$estado_leyenda);
?>
