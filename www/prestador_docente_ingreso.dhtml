<script type="text/javascript" language="javascript">


//--------------------------------------------------------------------------------------//
//---------------------------------- Inscribir AJAX ------------------------------------//
//--------------------------------------------------------------------------------------//

function CargarDatos(formulario,comi_codigo,act_codigo,borraraccion) {

	var item_obj = EncontrarObjeto("divComision");
	var objAguarde = EncontrarObjeto('idAguarde');	
	//if (objAguarde != null)
		//objAguarde.innerHTML='Aguarde ...';	
	if (borraraccion)	
		$('accion').innerHTML = "";
	item_obj.innerHTML="";
	
	var ajax=nuevoAjax();
	var datos="comi_codigo="+comi_codigo+"&act_codigo="+act_codigo;

	var archivo = "prestador_docente_ajax.dhtml";
	ajax.open("POST",archivo,true);
	ajax.onreadystatechange=function() {
		if (ajax.readyState==4) {	
			//if (objAguarde != null)
				//objAguarde.innerHTML='';	
			item_obj.innerHTML=ajax.responseText;
			return true;
		
		}
	};
	ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded'); 
	ajax.send(datos);	
		
	return false;
}

//--------------------------------------------------------------------------------------//


function Limpiar(formulario,comi_codigo) {

	$('buscado').value = "";
	BuscarPersona(formulario,comi_codigo);
}


function BuscarPersona(formulario,comi_codigo) {

	

	var ajax=nuevoAjax();
	var datos="comi_codigo="+comi_codigo+"&buscado="+$('buscado').value;
	var archivo = "prestador_docente_web_busqueda.dhtml";
	ajax.open("POST",archivo,true);
	ajax.onreadystatechange=function() {
		if (ajax.readyState==4) {	
			$('ListadoInscriptos').innerHTML = ajax.responseText;
	
			return true;
		}
	};
	ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded'); 
	ajax.send(datos);		
	return false;
}

//--------------------------------------------------------------------------------------//
//---------------------------------------JS---------------------------------------------//
//--------------------------------------------------------------------------------------//

function CambioComboEval(docu,cambio_eval_codigo_name) {

	var objCambioEval = docu.getElementById(cambio_eval_codigo_name);

	objCambioEval.value = 1; 
	return true;
}

//--------------------------------------------------------------------------------------//

function CambiarEvaluacion (docu, formulario, eval_codigo) {

	if (eval_codigo == "") {
		alert ("Debe ingresar la evaluación");
		return false;
	}
	
	for (var i=0; i< document.forms[formulario].elements.length; i++)  {
		var e= document.forms[formulario].elements[i];
		if ( e.name.substr(0,12) == "eval_codigo_" )  {
			e.value = eval_codigo;
			CambioComboEval(docu,"cambio_"+e.name);
		}
	}
	return true;
}

//--------------------------------------------------------------------------------------//
//--------------------------------------------------------------------------------------//
//--------------------------------------------------------------------------------------//

</script>

