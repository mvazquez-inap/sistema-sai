//-----------------------------------------------------------------------------------------------------	
	function ModifDatosPrestadorDocente($datos)	{

		if(!$this->_DatosValidosModifPrestadorDocente($datos,$datosvalidados))
			return false;
			
	
		$spnombre="upd_prestador_docente";
		$spparam=array(
			'ppresdoc_codigo'=> $datosvalidados['presdoc_codigo'], 
			'ppresdoc_nombre'=> $datosvalidados['presdoc_nombre'],
			'ppresdoc_apellido'=> $datosvalidados['presdoc_apellido'],
			'ppresdoc_sexo'=> $datosvalidados['presdoc_sexo'],
			'ppresdoc_origen_pais_codigo'=> $datosvalidados['presdoc_origen_pais_codigo'],
			'ppresdoc_eventual'=> $datosvalidados['presdoc_eventual'],
			'ppresdoc_cuilt'=> $datosvalidados['presdoc_cuilt'],
			'ppresdoc_caracter_alta'=> $datosvalidados['presdoc_caracter_alta'],
			'ppresdoc_falta'=> FuncionesPHPLocal::ConvertirFecha($datosvalidados['presdoc_falta'],'dd/mm/aaaa','aaaa-mm-dd'), 
			'ppresdoc_falta_prov'=> FuncionesPHPLocal::ConvertirFecha($datosvalidados['presdoc_falta_prov'],'dd/mm/aaaa','aaaa-mm-dd'), 
			'ppresdoc_falta_def'=> ($datosvalidados['presdoc_falta_def'] != "NULL")?FuncionesPHPLocal::ConvertirFecha($datosvalidados['presdoc_falta_def'],'dd/mm/aaaa','aaaa-mm-dd'):"NULL", 				
			'ppresdoc_presentacion'=> $datosvalidados['presdoc_presentacion'],
			'ppresdoc_telefono'=> $datosvalidados['presdoc_telefono'],
			'ppresdoc_celular'=> $datosvalidados['presdoc_celular'],
			'ppresdoc_email'=> $datosvalidados['presdoc_email'],
			'ppresdoc_calle'=> $datosvalidados['presdoc_calle'],
			'ppresdoc_numero'=> $datosvalidados['presdoc_numero'],
			'ppresdoc_piso'=> $datosvalidados['presdoc_piso'],
			'ppresdoc_cp'=> $datosvalidados['presdoc_cp'],
			'ppresdoc_prov_codigo'=> $datosvalidados['presdoc_prov_codigo'],
			'ppresdoc_part_loca_descripcion'=> $datosvalidados['presdoc_part_loca_descripcion'],			
			'ppresins_codigo'=> $datosvalidados['presins_codigo'],
			'pjurisdid_apn'=> $datosvalidados['jurisdid_apn'],
			'pjurisdid_origen'=> $datosvalidados['jurisdid_origen'],
			'porgapub_codigo'=> $datosvalidados['orgapub_codigo'],
			'ppresdoc_cargo'=> $datosvalidados['presdoc_cargo'],			
			'ppresdoc_eve_organismo'=> $datosvalidados['presdoc_eve_organismo'],		
			'ppresdoc_max_nivel_estudio'=> $datosvalidados['presdoc_max_nivel_estudio'],		
			'ppresdoc_ult_titulo'=> $datosvalidados['presdoc_ult_titulo'],		
			'ppresdoc_ult_titulo_institucion'=> $datosvalidados['presdoc_ult_titulo_institucion'],		
			'ppresdoc_ult_titulo_ano'=> $datosvalidados['presdoc_ult_titulo_ano'],		
			'ppresdoc_ido_competencias'=> $datosvalidados['presdoc_ido_competencias'],		
			'ppresdoc_ido_instituciones'=> $datosvalidados['presdoc_ido_instituciones'],		
			'ppresdoc_cv'=> $datosvalidados['presdoc_cv'],				
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar el prestador. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} else {


		// borro todos los tipos de postulación que tiene el docente
		if(!$this->Baja_Pres_Doc_Tipo_Postulacion($datosvalidados['presdoc_codigo'])) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo eliminar los tipos de postulación del docente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} else {
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"36302","Global / presdoc_codigo=".$datosvalidados['presdoc_codigo'],$_SESSION['usuariocod']);
		}

		// agrego los tipos de postulación seleccionados
		foreach ($datosvalidados["tipopos"] as $clave => $valor) {
			if(!$this->Alta_Pres_Doc_Tipo_Postulacion($datosvalidados['presdoc_codigo'],$valor,$errno)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo agregar el tipo de postulación al docente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			} else {
				FuncionesPHPLocal::RegistrarAcceso($this->conexion,"36301","presdoc_codigo=".$datosvalidados['presdoc_codigo']."tipopos_codido=".$valor,$_SESSION['usuariocod']);
			}
		}				


		
		}
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function EvaluarPrestadorDocente($presdoc_codigo,$operacion,$datos,&$datosvalidados) {

		if(!$this->_DatosValidosEvaluarPrestadorDocente($presdoc_codigo,$operacion,$datos,$datosvalidados))
			return false;
	
		if ($operacion == "A") {
			$estado = PRESDOCACTIVO;
		} else {
			$estado = PRESDOCRECHAZADO;	
		}
	
		$spnombre="upd_prestador_docente_evaluar_xpresdoc_codigo_presdoc_estado";
		$spparam=array(
			'ppresdoc_codigo'=> $presdoc_codigo, 
			'ppresdoc_caracter_alta'=> $datosvalidados['presdoc_caracter_alta'],
			'ppresdoc_estado'=> $estado,	
			'ppresdoc_falta_prov'=> date("Y/m/d"),
			'ppresdoc_falta_def'=> ($datosvalidados['presdoc_caracter_alta']==PRESDOCDEFINITIVO)?date("Y/m/d"):"NULL",
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar la evaluación del prestador docente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function PedirAprobacionPrestadorDocente($presdoc_codigo) {

		if(!$this->_DatosValidosPedidoAprobacionPrestadorDocente($presdoc_codigo))
			return false;

		$spnombre="upd_prestador_docente_cambio_estado_xpresdoc_codigo";
		$spparam=array(
			'ppresdoc_estado'=>PRESDOCPENDIENTEAPROBACION,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'ppresdoc_codigo'=> $presdoc_codigo
			);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al realizar el pedido de aprobación del Prestador Docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoModificar($presdoc_codigo,$rolcod,$jurisdid) {
	
		if(!$this->TraerDatosPrestadorDocente($presdoc_codigo,$filaprestador,$es_modif))  {
			$error="Error al buscar el prestador docente.";
			$errormail="Error al buscar el prestador docente en tabla presador_docente \n presdoc_codigo=".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		
		if (!$es_modif) {
			$error="Error no se encontró el prestador docente.";
			$errormail="Error no se encontró el prestador docente \n presdoc_codigo=".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} 
		
		if($rolcod==COORDINADORTECNICO || $rolcod==USUORGANISMO) {  
			
			if ($filaprestador['jurisdid_origen']==$jurisdid) {
