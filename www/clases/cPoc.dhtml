	}

//-----------------------------------------------------------------------------------------------------	
	function PocSP($pocrol,$pocjuris,&$spnombre,&$spparam)
	{
		if ( ($pocrol== COORDINADORTECNICO) || ($pocrol== USUORGANISMO) )
		{
			$poc_estado1=POCNUEVO;
			$poc_estado2=POCRECHAZADO;
			$spnombre="sel_poc_xjurisdid_inap_xestado_nuevo_recha";
			$spparam =array('porderby'=>"poc_ano",'pjurisdid_inap'=>$pocjuris,'ppoc_estado1'=>$poc_estado1,'ppoc_estado2'=>$poc_estado2);
		}
		elseif($pocrol== USUACTJUR)
		{
			$poc_estado=POCAPROBADO;
			$spnombre="sel_poc_xjurisdid_inap_xestado_aprob";
			$spparam =array('porderby'=>"poc_ano",'pjurisdid_inap'=>$pocjuris,'ppoc_estado'=>$poc_estado);
		}
		else
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"El usuario no tiene los permisos suficientes. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function AltaPoc($datos) {
		if(!$this->_DatosValidosAltaPoc($datos,$datosvalidados))
			return false;
		
		$spnombre="ins_poc";
		$spparam=array(
			'ppoc_ano'=>$datosvalidados["poc_ano"] ,
			'ppoc_obs'=>$datosvalidados["poc_obs"] ,			
			'pjurisdid_inap'=>$_SESSION["jurisdid_inap"] ,			
			'ppoc_estado'=>POCNUEVO ,
			'pultmodusuario'=>$_SESSION['usuariocod'] ,
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);			
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		{
			$error="Error al agregar el poc.";
			$errormail="Error al insertar en la tabla poc".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		
		return true;
	}		
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAltaPoc($datos,&$datosvalidados)	{
		$datosvalidados=array();
		//Verifico q no exista otro poc para esa jurisdiccion para el mismo año
		if(!$this->BuscarAnoPocxJurisdiccion($datos,$datosvalidados))
			return false;
		if(!$this->_DatosValidosComunesPoc($datos,$datosvalidados))
			return false;
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function ModifDatosPoc($datos)	{
		$ArregloDatos=array();
		$ArregloDatos['poc_ano']= $datos['poc_ano'];
		$ArregloDatos['jurisdid_inap']= $_SESSION['jurisdid_inap'];
		if(!$this->BuscarPoc($ArregloDatos,$numfilas,$resultado,$error,$errormail))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"El código no corresponde a un poc.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		else
			$datospoc=mysqli_fetch_assoc($resultado);
		if(!$this->_DatosValidosModifPoc($datospoc,$datosvalidados))
			return false;

		$spnombre="upd_poc";
		$spparam=array(
			'ppoc_codigo'=> $datosvalidados['poc_codigo'], 
			'ppoc_obs'=> $datos['poc_obs'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar el poc. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifPoc($datos,&$datosvalidados)	{
		if(($datos['poc_estado']!=POCNUEVO) && ($datos['poc_estado']!=POCRECHAZADO)) {
			$arraymensajepantalla="El estado del Poc no permite realizar modificaciones";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	
		$datosvalidados['poc_codigo']=$datos['poc_codigo'];
		$datosvalidados['poc_obs']=$datos['poc_obs'];
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosPoc($datos) { //$poc_codigo
	
		$ArregloDatos=array();
		$ArregloDatos['poc_ano']= $datos['poc_ano'];
		$ArregloDatos['jurisdid_inap']= $_SESSION['jurisdid_inap'];
		if(!$this->BuscarPoc($ArregloDatos,$numfilas,$resultado,$error,$errormail))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"El código no corresponde a un poc.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		else
			$datospoc=mysqli_fetch_assoc($resultado);

		if(!$this->_DatosValidosEliminarPoc($datospoc,$datosvalidados))
			return false;

		if(!$this->_BajaCascada($datosvalidados['poc_codigo']))	// Baja física de las areas que tiene asociadas
			return false;
			
		$spnombre="del_poc";
		$spparam=array('ppoc_codigo'=> $datosvalidados['poc_codigo']);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod)) 
			return false;					  	 	
		
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosEliminarPoc($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if(($datos['poc_estado']!=POCNUEVO) && ($datos['poc_estado']!=POCRECHAZADO)) {
			$arraymensajepantalla="El estado del Poc no permite realizar modificaciones";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados+=array('poc_codigo'=>$datos['poc_codigo']);
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _BajaCascada($poc_codigo) {

		$sigo=true;
		//Verificar si existe relacion "poc"-"poc_actividad" 
		//y "poc_actividad"-"poc_actividad_actividad"(no tendrian q existir por el estado en el q estoy)
		//pero si existe no tengo q borrar NADA, y si no existe, sí elimino todo.
		
		$oPocActividadActividad=new cPocActividadActividad($this->conexion);
	
		if (!$oPocActividadActividad->BuscarRelacionconPoc_Actividad($poc_codigo)) {
			return false;
			$sigo=false;
		}
 		
		if($sigo) {
					
			//Eliminar "poc_poc_objetivo_poc_area"
			$oPocPocObjetivoPocArea=new cPocPocObjetivoPocArea($this->conexion);
		
			if (!$oPocPocObjetivoPocArea->EliminarDatosPocPocObjetivoPocAreaTodas($poc_codigo))
				return false;
				
			//Eliminar "poc_actividad_poc_objetivo"
			//Para esto debo obtener los "poc_actividad" con ese poc_codigo y con eso, obtener los 
			// "poc_actividad_poc_objetivo" con ese pocact_codigo
			$oPocActividadPocObjetivo=new cPocActividadPocObjetivo($this->conexion);
		
			if (!$oPocActividadPocObjetivo->EliminarDatosPocActividadPocObjetivoTodas($poc_codigo))
				return false;
				
			//Eliminar "poc_actividad"
			$oPocActividad=new cPocActividad($this->conexion);
		
			if (!$oPocActividad->EliminarDatosPocActividadTodas($poc_codigo))
				return false;
		} //fin de: if($sigo)
		
		return true;	
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosComunesPoc($datos,&$datosvalidados)	{
		// Valido el año	  
		$datosvalidados=array();
		if (trim($datos['poc_anos']) == "") {
			$arraymensajepantalla="Debe ingresar el año del Poc";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		if (!FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['poc_anos'],"NumericoEntero"))
		{
			$arraymensajepantalla="Debe ingresar un año válido";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		//hacer el año siguiente al actual
		//$fechaactual=date;
		$anoactual= date("Y");
		$anosigactual=$anoactual + 1;
		if (($datos['poc_anos'] <= POCANODESDE) || ($datos['poc_anos'] > $anosigactual))
		{
			$arraymensajepantalla="El año del Poc debe ser mayor a ".POCANODESDE." y menor o igual al año siguiente al actual.";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["poc_ano"]=$datos["poc_anos"];
		$datosvalidados["poc_obs"]=$datos["poc_obs"];

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function BuscarAnoPocxJurisdiccion($datos,&$datosvalidados)	{
		//Verifico q no exista otro poc para esa jurisdiccion para el mismo año
		$spnombre="sel_ano_poc_xjurisdiccion";
		$spparam=array(
					"ppoc_ano"=>$datos["poc_anos"],
					"pjurisdid_inap"=>$_SESSION["jurisdid_inap"],
					);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Se produjo un error al obtener los datos de escalafones. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		if($numfilas!=0)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Ya existe un poc para el año " .$datos["poc_anos"]. ".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["poc_ano"]=$datos["poc_anos"];
		$datosvalidados["jurisdid_inap"]=$_SESSION["jurisdid_inap"];
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function TraerDatosPoc($codigo,&$datosresult, &$es_modif) {
			
		$es_modif = false;		

		$sparam=array('ppoc_codigo' =>$codigo);
		$spnombre="sel_poc_xpoc_cod";	

		if(!($this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno)) )
		{
			$error="Error al buscar poc.";
			$errormail="Error al buscar al poc en la tabla poc. ".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}
		return true;
	}
