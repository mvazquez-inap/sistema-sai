$sql= "


UPDATE `actividad_curso_diseno_inap` SET `actdisinap_perfil` = 'Personal responsable de las secretarías privadas que asiste a las autoridades y a los niveles de conducción de las organizaciones.
El curso esta dirigido, principalmente, a: personal que revista en la planta permanente del escalafón SINEP, agrupamiento GENERAL, en los niveles:
-C, D y E que aspiran a cumplir requisitos para la promoción al TRAMO INTERMEDIO Y AVANZADO.' where `act_codigo` =9188 LIMIT 1 ;


";




$query=mysqli_query($idconexion, $sql) or die("Error SQL[= ".$sql."] Error:".mysqli_error($idconexion));
$filas_afectadas = mysqli_affected_rows($idconexion);


