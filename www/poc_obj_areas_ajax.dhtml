$oPocObjetivo = new cPocObjetivo($conexion);
$oPocObjetivoArea = new cPocPocObjetivoPocArea($conexion);
//----------------------------------------------------------------------------------------- 	


$poc_codigo=$_GET['poc_codigo'];
$pocobj_codigo=$_GET['pocobj_codigo'];
//Valido q exista el "pocobj_codigo" en la tabla "poc_objetivo"
$ArregloDatosObj['pocobj_codigo']=$pocobj_codigo;
if (!$oPocObjetivo->BuscarPocObjetivo($ArregloDatosObj,$numfilas,$resultado,$error,$errormail)) {
		$txt_sys_mail="Error al seleccionar el Objetivo.";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar el Objetivo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		die();
	}

if ($numfilas!=1) {
		$txt_sys_mail="Error al seleccionar el Objetivo.";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar el Objetivo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		die();
}
$fila_objetivo=mysqli_fetch_assoc($resultado);
echo  "var pocobj_descripcion='".FuncionesPHPLocal::ReemplazarComillas($fila_objetivo['pocobj_descripcion'])."';\n";



$ArregloDatos['poc_codigo']=$poc_codigo;
$ArregloDatos['pocobj_codigo']=$pocobj_codigo;
if (!$oPocObjetivoArea->BuscarPocPocObjetivoPocArea($ArregloDatos,$numfilas,$resultado,$error,$errormail))
	echo $erromail;



echo "datos_grilla=new Array();\n";
echo "datos_grilla[0]=new Array(";

$codigosel=array();
while($filadatos=mysqli_fetch_assoc($resultado))
	$codigosel[]=$filadatos["pocarea_codigo"];

if(count($codigosel)>0)
	echo "'".implode("','",$codigosel)."'";

echo ");\n";

