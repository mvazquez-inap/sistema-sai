<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
?>
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 TRANSITIONAL//EN"> 
<html>
<head>
<title>Historial del Prestador Docente</title>
<link rel="stylesheet" type="text/css" href="estilos.css">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
</head>
<body>
<script language="javascript" src="<?php echo DIR_JSComunes ?>funcionesjs.js" type="text/javascript"></script>
<?php
	$oPrestadorDocente = new cPrestadorDocente($conexion);

	$filaprestador=array();
	$filaprestador['presdoc_codigo']=(isset($_GET['presdoc_codigo']))?$_GET['presdoc_codigo']:"";

	if (isset($_POST['boton_confirma'])) {
	
		$conexion->ManejoTransacciones("B");
	
		if($oPrestadorDocente->ModifHistorialPrestadorDocente($_POST))
		{
			FuncionesPHPLocal::RegistrarAcceso($conexion,"36110","presdoc_codigo=".$_POST['presdoc_codigo'],$_SESSION['usuariocod']);
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha modificado el historial del Prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	
			$conexion->ManejoTransacciones("C");
			?>
			<br><br><div align="center"><a href="prestador_docente_historial_popup.dhtml?presdoc_codigo=<?php echo $_POST['presdoc_codigo']?>" class="linkFondoBlanco">Continuar Modificando datos de historial del Prestador</a></div>
			<?php
		}
		else {
			$conexion->ManejoTransacciones("R");
		}

		
	
	} else {
		$ok = true;
		if(!$oPrestadorDocente->TraerDatosPrestadorDocente($filaprestador['presdoc_codigo'],$fila_prestador_docente,$es_modif)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error el buscar el Prestador Docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			 $ok = false; 
		}
		
		if(!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"El Prestador Docente no se encuentra.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			 $ok = false; 
		}
		
		if ($ok) { 
			$destino_formulario="prestador_docente_historial_popup.dhtml";
		?>	<form action="<?php echo $destino_formulario?>" method="post" name="formulario">
		<?php		if($oPrestadorDocente->MostrarHistorialPrestadorDocente($conexion,$es_modif,$fila_prestador_docente)){ ?>
				<table width="100%" class="textoTablaDato" align="center">
					<tr align="center">
						<td colspan="2" valign="top">
							<input type="submit" name="boton_confirma" class="botones" value="Actualizar" >
							&nbsp;&nbsp;&nbsp;&nbsp;
							<input type="button" name="boton_cerrar" class="botones" onClick="javascript:window.close()" value="Cerrar" >							
							<input type="hidden" name="presdoc_codigo" value="<?php echo ($es_modif)?htmlspecialchars($fila_prestador_docente['presdoc_codigo'],ENT_QUOTES):""; ?>">
						</td>
					</tr>	
				</table>
		<?php 		} // MostrarHistorialPrestadorDocente ?>	 
		</form>
	<?php }  // if isset($_POST['boton_confirma']) { ?>

<?php } ?>
</body>
</html>