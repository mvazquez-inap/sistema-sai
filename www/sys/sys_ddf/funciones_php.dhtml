//----------------------------------------------------------------------------------------- 
function CnvCadenatoNombre($cadena) {

 // Primera letra en mayúscula, pueden ser caracteres especiales válidos  
 // para los nombres.
 
 // NO se implementa la segunda parte a minuscula 
 // Porque, hay que considerar excepciones de apellido o nombre 
 //

  $array_chr_especiales=array('á','é','í','ó','ú','ü','ñ');
  $array_chr_especiales_mayuscula=array('Á','É','Í','Ó','Ú','Ü','Ñ');
  
  $cadena_trans=trim($cadena);
// $cadena_trans=strtolower($cadena);
  
  // Todas las especiales pasan a su versión en minuscula
  // for ($i=0; $i<count($array_chr_especiales_mayuscula);$i++)
  //	 $cadena_trans=str_replace($array_chr_especiales_mayuscula[$i],$array_chr_especiales[$i],$cadena_trans);
  
  // Remplazo el primero por mayúscula, tengo en cuenta que puede ser 
  // un caracter especial. 
  if (strlen($cadena_trans)>=1) {
     $primer_caracter=strtoupper(substr($cadena_trans,0,1));
     $cadena_trans=substr($cadena_trans,1,strlen($cadena_trans));
	 $pos=array_search($primer_caracter,$array_chr_especiales); 
	 if ($pos)
		 $cadena_trans=$array_chr_especiales_mayuscula[$pos].$cadena_trans;
     else
		 $cadena_trans=$primer_caracter.$cadena_trans;
 }		
  
 return $cadena_trans;
}
//----------------------------------------------------------------------------------------- 
function ObtenerBrowser(&$info) {

	$browser = array (
	   "MSIE",            // parent
	   "OPERA",
	   "MOZILLA",        // parent
	   "NETSCAPE",
	   "FIREFOX",
	   "SAFARI"
	);
	
	$info[browser] = "OTHER";
	foreach ($browser as $parent) {
	   $s = strpos(strtoupper($_SERVER['HTTP_USER_AGENT']), $parent);
	   $f = $s + strlen($parent);
	   $version = substr($_SERVER['HTTP_USER_AGENT'], $f, 5);
	   $version = preg_replace('/[^0-9,.]/','',$version);
	   
	   if (strpos(strtoupper($_SERVER['HTTP_USER_AGENT']), $parent)) {
	   $info[browser] = $parent;
	   $info[version] = $version;
	   }
	}
}
