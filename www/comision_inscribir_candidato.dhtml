function MostrarGrillaSeleccion($conexion,$comi_codinap) {

		$oActividad = new cActividad($conexion);
		$oComision= new cComision($conexion);
		$oComisionPersonaCandidato= new cComisionPersonaCandidato($conexion);
		$escalafon = new cEscalafones($conexion);
		$jurisdicciones	 = new jurisdicciones;

				
		$ArregloDatos=array("comi_codinap"=>$comi_codinap,"comi_estado"=>COMISIONABIERTA.",".COMISIONNUEVA);	
							
		if(!$oComision->BuscarComision($ArregloDatos,$numfilas,$resulcomi,$error,$errormail)) {
			$txt_sys_mail="Error al buscar para la comisión ABIERTA - \ncomi_codigo=".$_POST['comi_codinap_seleccion'];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} elseif ($numfilas!=1) {
			$txt_sys_mail="Hay más de un registro para la comisión\ncomi_codigo=".$_POST['comi_codinap_seleccion'];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se puede inscribir en la Comisión porque no una una comisión NUEVA o ABIERTA.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return true;
		}
		$fila_comision = mysqli_fetch_assoc($resulcomi);

			switch ($_SESSION['rolcod']) {
				case USUCURSOINAP:
					$ArregloDatos=array("comi_codigo"=>$fila_comision['comi_codigo'],
										"cpc_estado"=>CANDIDATO_APROBADO);	
					$titulo = "Candidatos enviados a Inscribir";
					$leyenda_boton = "Inscribir Candidatos Seleccionados";
					break;
			
				case COORDINADORTECNICO:
				case USUORGANISMO:
					$oActividadCurso = new cActividadCurso($conexion); 
					$ArregloDatos = array();
					if ($oActividadCurso->TieneFormatoTipo($fila_comision['act_codigo'],FORMATOCURSO,TIPOACTCURSOINAP,$tiene_formato_tipo)) {
						if ($tiene_formato_tipo) {
							$titulo = "Candidatos para enviar a INAP";
							$leyenda_boton = "Enviar a INAP los Candidatos Seleccionados";		
						}
						$ArregloDatos=array("comi_codigo"=>$fila_comision['comi_codigo'],
										"cpc_estado"=>CANDIDATO_SIN_EVALUAR,
										"jurisdid_inap"=>$_SESSION["jurisdid_inap"]
										);	
					}
					if ($oActividadCurso->TieneFormatoTipo($fila_comision['act_codigo'],FORMATOCURSO,TIPOACTCURSOJURISD,$tiene_formato_tipo_jur)) {
						
						if ($tiene_formato_tipo_jur) {
							
							$titulo = "Candidatos para Evaluar";
							$leyenda_boton = "Inscribir Candidatos Seleccionados";					
						}
						$ArregloDatos=array("comi_codigo"=>$fila_comision['comi_codigo'],
										"cpc_estado"=>CANDIDATO_SIN_EVALUAR,
										"cpc_estado2"=>CANDIDATO_APROBADO,
										"jurisdid_inap"=>$_SESSION["jurisdid_inap"],
										"jurisdid_inap2"=>$_SESSION["jurisdid_inap"]
										);	
					}
					
										
					break;
					
				case USUUNIVERSIDAD:
					
					$ArregloDatos=array("comi_codigo"=>$fila_comision['comi_codigo'],
										"cpc_estado"=>CANDIDATO_SIN_EVALUAR_UNIVERSIDAD
										);	
					$titulo = "Candidatos a Becas para enviar a INAP";
					$leyenda_boton = "Enviar a INAP los Candidatos Seleccionados";					
					
					break;					
			}
			$ArregloDatos["leyenda"] = $titulo;
			$ArregloDatos["orderby"] = "jurisdid_inap ASC";;
			$_SESSION['filtro_busqueda'] = $ArregloDatos;
			
		if(!$oComisionPersonaCandidato->TraerDatosInscripcion($ArregloDatos,$result_candidatos,$numfilas_candidatos)) {
				$error="Error al buscar los datos de inscripción.";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
		}

			
		if ($numfilas_candidatos >=LIMITE_BUSQUEDA_MEDIANO*6) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda retornó demasiadas filas, ajuste el criterio de búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;			
		}


		?> <p class="textoDatoBold" align="center">Si desea inscribir candidatos vía Web haga click <a href="<?php echo "https://".$_SERVER['SERVER_NAME']."/inscripcion_web.dhtml?comi_codigo=".$fila_comision['comi_codigo']?>" target="_blank">aquí</a></p> <?php
	if($numfilas_candidatos>0) {  ?>
	
