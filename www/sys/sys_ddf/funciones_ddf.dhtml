// --------------------------------------------------------------------------------------
// Dado un arreglo
// 1-Creo una tabla temporal de resultado de la busqueda, con los datos que 
//   vienen en el arreglo. 
// 2-Ordeno (SQL) y limitando los registros a los requeridos
// 3-Retorno un arreglo con el resultado obtenido en (2)
function OrdenSql($idconexion,$sqlCreate,$nomTable,$array_entrada,&$array_salida,$orden,
				  $numero_pagina,$resu_x_pag,&$CodError)	{

	if ($numero_pagina <=0)
	    return false;
	
	$array_salida=array();
	
	_CrearTableTemp($idconexion,$sqlCreate,$CodError);
	
	if (!$CodError) {
		foreach ($array_entrada as $clave=>$valor) {
			_InsertTablaTemp($idconexion,$nomTable,$valor,$CodError);
			if ($CodError)
				return false;
		}
	}

   // Selecciono ordenado y limitado    
   	$inicio=($numero_pagina-1)*$resu_x_pag;
   
   	$param=array('ptabla'=>$nomTable,'porderby'=>$orden, 'plimit' =>"limit ".$inicio.",".$resu_x_pag);
   	$query=ejecutarStoredProcedure($idconexion,'sel_tabla_order_limit',$param);

   	if($query<0) 
		return false;

	if (mysqli_num_rows($query)>0) {
	   while ($fila_dato=mysqli_fetch_assoc($query)) {
			$array_salida[]=$fila_dato;
	   }
	}   

   return $CodError;
}
//---------------------------------------------------------------------------
// Entrada:	datos_entrada (arrelgo): (valor1, valor2, .... )
// 			estructura_datos_entrada (arrelgo):( (nombre_1, tipo_sql_1), (nombre_2, tipo_sql_2), ... )
//			orden (string): como quiero el orden del arreglo.
// Salida:  datos_salida (arrelgo)

// La lognitud de cada uno de los registros de datos_entrada debería
// ser igual que la longitud de estructura_datos_entrada.

// Los campos de orden deben estar incluidos 
// ---------------------------------------------------------------------------
// 1- Creo una tabla temporal.
// 2- Le agrego los datos de entrada.
// 3- Ordeno la tabla.
// 2- Limito la salida, a la pagina solicitada.
function OrdenSql_2($idconexion,$datos_entrada,
					$estructura_datos_entrada,
					&$datos_salida,$orden,
				    $numero_pagina=-1,$resu_x_pag=-1,&$CodError)	{
	
	$CodError=false;
	// Debe tener por lo menos un campo.
	if (count($estructura_datos_entrada)==0) {
		$array_msg_pantalla=array("formato" => FMT_TEXTO);	
		$array_msg_pantalla+=array("texto" => "Se ha producido un error ordenando los datos de salida.");
		$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
		$array_msg_mail+=array("texto" => $array_msg_pantalla['texto']."\r\n"."Estructura del sql temporal a crear");
		MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
		$CodError=true;
		return false;
	}

	// Creo la tabla
	$nombretabla='tmpTabla';
	$sqlCreate="CREATE TEMPORARY TABLE IF NOT EXISTS ".$nombretabla." (";;
	foreach ($estructura_datos_entrada as $clave=>$valor) {
		$sqlCreate.=$valor['campo_nombre'].' '.$valor['campo_tipo'].',';
	}
	$sqlCreate=substr($sqlCreate,0, strlen($sqlCreate)-1);
	$sqlCreate.=") TYPE=INNODB COMMENT='Salida Temporal';";

	if(!mysqli_query($idconexion, $sqlCreate))	{
		$CodError=mysqli_errno($idconexion);
		$array_msg_pantalla=array("formato" => FMT_TEXTO);	
		$array_msg_pantalla+=array("texto" => "Se ha producido un error ordenando los datos de salida.");
		$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
		$array_msg_mail+=array("texto" => $array_msg_pantalla['texto']."\n\n"."Creando la tabla temporal: error=".$CodError);
		MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
		return false;
	} 
	
	// Inserta los datos en la tabla temporal
	$array_salida=array();
	foreach ($datos_entrada as $clave=>$valor) {
		_InsertTablaTemp($idconexion,$nombretabla,$valor,$CodError);
		if ($CodError)
			return false;
	}

	// Si es < 0 asuma todas las páginas.
	if ($numero_pagina<=0) 
		$limit="";
	else {
	   	$inicio=($numero_pagina-1)*$resu_x_pag;
		$limit="limit ".$inicio.",".$resu_x_pag;
	}
	
    // Selecciono ordenado y limitado en caso necesario   
   	$param=array('ptabla'=>$nombretabla,'porderby'=>$orden, 'plimit' =>$limit);
   	$query=ejecutarStoredProcedure($idconexion,'sel_tabla_order_limit',$param);

   	if($query<0) 
		return false;

	if (mysqli_num_rows($query)>0) {
	   while ($fila_dato=mysqli_fetch_assoc($query)) {
			$datos_salida[]=$fila_dato;
	   }
	}

   return $CodError;
}
// --------------------------------------------------------------------------------------
function _CrearTableTemp($conexion,$sqlCreate,&$CodError)	{

	if(!mysqli_query($conexion, $sqlCreate))	{
		$CodError=mysqli_errno($conexion);
		$array_msg_pantalla=array("formato" => FMT_TEXTO);	
		$array_msg_pantalla+=array("texto" => "Se ha producido un error ordenando los datos de salida.");
		$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
		$array_msg_mail+=array("texto" => $array_msg_pantalla['texto']."\n\n"."Creando la tabla temporal: error=".$CodError);
		MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
	} 
	return true;
}
//-----------------------------------------------------------------------------
function _InsertTablaTemp($conexion,$nombretabla,$arraydatos,&$CodError){
	
	$sqlnombrecampo="";
	$sqlvalorcampo="";
	
	foreach($arraydatos as $nombrecampo => $valorcampo)	{
		$sqlnombrecampo.=$nombrecampo.",";
		$sqlvalorcampo.="'".mysqli_real_escape_string($conexion, $valorcampo)."',";
	}
	
	$sqlnombrecampo=substr($sqlnombrecampo,0,strlen($sqlnombrecampo)-1);
	$sqlvalorcampo=substr($sqlvalorcampo,0,strlen($sqlvalorcampo)-1);
	
	$sql="INSERT INTO ".$nombretabla." (";
	$sql.=$sqlnombrecampo;
	$sql.=") VALUES (";
	$sql.=$sqlvalorcampo;
	$sql.=");";

	if(!mysqli_query($conexion, $sql)) {
		$CodError=mysqli_errno($conexion);
		$array_msg_pantalla=array("formato" => FMT_TEXTO);	
		$array_msg_pantalla+=array("texto" => "Se ha producido ordenando la salida.");
		$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
		$array_msg_mail+=array("texto" => $array_msg_pantalla['texto']."\n\n"."Insertando en la tabla temporal: error=".$CodError."sql=".$sql);
		MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
		return false;
	}
	
	return true;
}
// ---------------------------------------------------------------------------------------------------------------- 
// Arma una lista in con los tipos de Organismo que dependen del poder 
// Ejecutivo Nacional.
function InTipoOrgDepEjeNacional($objJurisdicciones) {

	$objJurisdicciones->BuscarRaizTipoOrg(TABGRALES_TIPOORG_NAC_EJ,array(),TABGRALES_TS_ARRAY,$nodo_jurisd,array(),$CodError);
	// Resetea el puntero al primer elemento y retorna el primer elemento.
	reset($nodo_jurisd); 
	$jurisd_raiz = current($nodo_jurisd);

	// Tipos de Organismo dependientes de Ejecutivo Nacional		
	// $jurisd_raiz['jurisdid']
	if (!$objJurisdicciones->BuscarTipoOrgSubArbolDependiente($jurisd_raiz['jurisdid'],JURISD_TODOSLOSNIVELES,array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$array_tipo_org,array(),$NumFilas,$CodError) )
		return false;

	foreach ($array_tipo_org as $keyTipoOrg=>$valorTipoOrg) {
		$array_tipoOrg_ids[] = $valorTipoOrg['tipoorgid'];
	}

	$in_tipo_org=array();
	$in_tipo_org=ArrayToArray_Delimitado($array_tipoOrg_ids," tipoorgid in (",",",")");

	return $in_tipo_org;
}

//----------------------------------------------------------------------------------------- 
function VerificarEsDependiente ($idconexion,$jurisdlogeado,$result,&$error) {
	$error = false;
	$jurisdid="0";
	
	while ($fila_jurisdid=mysqli_fetch_assoc($result)) {
		$jurisdid.=", ".$fila_jurisdid['jurisdid'];
	}
			
	$param=array('pjurisdsafid'=>$jurisdlogeado,'pjurisdid'=>$jurisdid);
	if (($result=ejecutarStoredProcedure($idconexion,"sel_jurisdiccion_ddf_x_jurisdid_jurisdsafid",$param))<0) {
		MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Error seleccionando el organismo saf.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TABLA,3);
		$error = true;
	}	

	if (mysqli_num_rows($result)==0) 
		return false;
	else 
		return true;
}
