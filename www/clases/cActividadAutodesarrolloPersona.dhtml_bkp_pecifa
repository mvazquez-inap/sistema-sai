	function  EliminarDatosActividadAutodesarrolloPersona ($datos) {

		$datosvalidados=array();
		if(!$this->_DatosValidosEliminarActividadAutodesarrolloPersona($datos,$datosvalidados))
			return false;

		// Si hay dictamen que se puede borrar porque se valida nuevo o rechazado
		if ($datosvalidados['tipoact_codigo']!=TIPOACTAUTOEVASIS) {
			if ($datosvalidados['tiene_dictamen']) {
				$spnombre="del_actividad_autodesarrollo_dictamen";
				$spparam=array(
					'pact_codigo'=>$datosvalidados['act_codigo'],
					'ppers_codigo'=>$datosvalidados['pers_codigo']
				);
				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la asignación de la persona a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}

				$oDictamen = new cDictamen($this->conexion);
				if($oDictamen->BajaDatosDictamen($datosvalidados)) {
					FuncionesPHPLocal::RegistrarAcceso($this->conexion,"49002","dic_codigo=".$datosvalidados['dic_codigo']."\nusuariocod=".$_SESSION['usuariocod']);
				} else
					return false;

			} // $datosvalidados['tiene_dictamen']
		}

		// Borro la asignación
		$spnombre="del_actividad_autodesarrollo_persona";
		$spparam=array(
			'pact_codigo'=>$datosvalidados['act_codigo'],
			'ptipoact_codigo'=>$datosvalidados['tipoact_codigo'],
			'pactprog_sec'=>($datosvalidados['tipoact_codigo']==TIPOACTAUTOEVASIS)?$datosvalidados['actprog_sec']:0,
			'ppers_codigo'=>$datosvalidados['pers_codigo']
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la asignación de la persona a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}
