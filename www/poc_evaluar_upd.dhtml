			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"En unos momentos Coordinador Técnico recibirá un correo electrónico <BR> con el requerimiento de rectificación de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El correo electrónico con la evaluación de la actividad no fue enviado, <br>notifique al Coordinador Técnico por otra via.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}	
	}
	FuncionesPHPLocal::RegistrarAcceso($conexion,"37303","pocact_codigo=".$_GET['pocact_codigo'],$_SESSION['usuariocod']);
	
