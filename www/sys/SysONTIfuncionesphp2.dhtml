//----------------------------------------------------------------------------------------- 
//

	function ArrayToArray($ArrayValores,$TextoComienzo,$Separador,$TextoFinal)
	{
		$ArrayFinal=array();
		$ArrayFinal[]=$TextoComienzo;
		
		foreach($ArrayValores as $valor)
		{
			$ArrayFinal[]=$valor;
			$ArrayFinal[]=$Separador;
		}
		
		$ArrayFinal[count($ArrayFinal)-1]=$TextoFinal;
		
		return $ArrayFinal;
		
	}
} // Fin clase self
