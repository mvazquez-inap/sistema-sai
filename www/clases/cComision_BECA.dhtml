//-----------------------------------------------------------------------------------------------------	
	function TraerDatosCaratulaActa($ArregloDatos,&$datos_caratula) {
		$ok = true;

		$oActividad = new cActividad($this->conexion);
		if (!$this->TraerDatosComision($ArregloDatos['comi_codigo'],$filacomision,$es_modif)) {
			if (!$es_modif) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
			}
		}
	
		if ($ok) {
			if ($oActividad->TraerDatosActividad($filacomision['act_codigo'],$filaact,$es_modif)) {
				if (!$es_modif) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok = false;
				}	// Se encontró la actividad 
			} // N se produjo error al buscar la actividad
		}	
		
		
		if ($ok) {
			if(!$this->conexion->TraerCampo("sede","sede_descripcion",array("sede_codigo='",$filacomision['sede_codigo'],"'"),$sededesc,$numfilas,$errorcod))
				return false;
	
			$oActividadCurso = new cActividadCurso($this->conexion);
			$oActividadCursoInap = new cActividadCursoInap ($this->conexion);
		
			$tipoinap=$oActividadCursoInap->EsActividadCursoTipo($filacomision['act_codigo'],TIPOACTCURSOINAP,$error,$errormsg);
		
			$datos_caratula['es_curso_inap']=false;		
			if ($tipoinap) {
				if ($oActividadCursoInap->TraerDatosActividadCursoInap($filacomision['act_codigo'],$filacurso,$es_modif)) {
					if (!$es_modif) {
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					} else {
						$datos_caratula['es_curso_inap']=true;		
						if ($this->conexion->TraerCampo("programa_curso_inap","progcur_descripcion",array("progcur_codigo='",$filacurso['actividad_curso_inap']['progcur_codigo'],"'"),$descri,$numfilas,$errorcod)) 
							$datos_cabecera['progcur_descripcion'] = htmlspecialchars($descri,ENT_QUOTES); 
					}
				}
			}	
				
			// busco organismo del curso		
			if (!$oActividadCurso->TraerDatosActividadCurso($filacomision['act_codigo'],$fila_actividad_curso,$es_modif_act_curso)) 
				return false;
	
			$txt_sys_mail="\nact_codigo=".$filacomision['act_codigo'];		
			if (!$es_modif_act_curso)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			} 
	
			if(!$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$fila_actividad_curso['jurisdid_inap'],"'"),$jurisdnom,$numfilas,$errorcod))
				return false;
	
			$datos_caratula['jurisdnom'] = $jurisdnom;
		
		
			$datos_caratula['datos'] = array(
						'comi_codinap' => $filacomision['comi_codinap'],						
						'comi_acta_numero' => $filacomision['comi_acta_numero'],
						'act_nombre' => $filaact['act_nombre'],
						'sede' => $sededesc,						
						'comi_domicilio' => $filacomision['comi_domicilio'],
						'comi_detalle' => $filacomision['comi_detalle']
			);
				
			$ArregloDatos= array();
			$ArregloDatos['porderby'] = "comifec_fecha, comifec_hora_inicio, comifec_hora_fin";
			$ArregloDatos['comi_codigo'] = $filacomision['comi_codigo'];

			$oComisionCronograma = new cComisionCronograma($this->conexion);
			if (!$oComisionCronograma->BuscarComiCronograma($ArregloDatos,$numfilas,$result_cronograma,$error,$errormail)) {
				$txt_sys_mail="\ncomi_codigo=".$comi_codigo."\nerror=".$errormail;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando datos del cronograma de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				$ok =  false;			
			}			

			if (count($result_cronograma) == 0) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión debe tener definida la fecha de realización.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok =  false;							
			}
			if ($ok) {
				$datos_caratula['cronograma'] = $result_cronograma;
		
				$ArregloDatos= array();
				$ArregloDatos['porderby'] = "";
				$ArregloDatos['comi_codigo'] = $filacomision['comi_codigo'];

				$oComisionPrestadorDocente=new cComisionPrestadorDocente($this->conexion);
				if (!$oComisionPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos,$numfilas_presdoc,$resultado_presdoc,$error,$errormail)) {
					$errormail="\ncomi_codigo=".$ArregloDatos['comi_codigo'];		
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar el Prestador Docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					$ok =  false;			
				}

				if ($numfilas_presdoc == 0) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión debe tener por lo menos un docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok =  false;							
				}
				if ($ok) {
					$datos_caratula['prestador_docente'] = array();
					while ($fila_presdoc = mysqli_fetch_assoc($resultado_presdoc)) {
						$datos_caratula['prestador_docente'][] = array('campo_mostrar'=>$fila_presdoc['campo_mostrar']);
					}
				}
			
			}
			
			
			
		}
		
		return $ok;
	}

//-----------------------------------------------------------------------------------------------------	
	function TraerDatosCabeceraActa($ArregloDatos,&$datos_cabecera) {
		$ok = true;
		$oActividad = new cActividad($this->conexion);
		if (!$this->TraerDatosComision($ArregloDatos['comi_codigo'],$filacomision,$es_modif)) {
			if (!$es_modif) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
			}
		}
	
		if ($ok) {
			if ($oActividad->TraerDatosActividad($filacomision['act_codigo'],$filaact,$es_modif)) {
				if (!$es_modif) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok = false;
				}	// Se encontró la actividad 
			} // N se produjo error al buscar la actividad
		}	
		
		if ($ok) {
			$datos_cabecera = array(
						'comi_codigo' => $filacomision['comi_codigo'],
						'comi_codinap' => $filacomision['comi_codinap'],						
						'comi_acta_numero' => $filacomision['comi_acta_numero'],
						'act_nombre' => $filaact['act_nombre'],
						'act_codinap' => $filaact['act_codinap']
			);
		}
		
		return $ok;
	}
	
	
