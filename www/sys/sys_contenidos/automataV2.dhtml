<?php

//----------------------------------------------------------------------------------------- 
// Comienzo de Clases

if(!defined("DIR_PAGESTATICA"))
	define("DIR_PAGESTATICA","");

class cPagina
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $str_inicial_noticias="<!-- Inicio Noticia -->";
	var $str_sin_noticias="<!-- Sin Noticias -->";
	var $str_final_noticias="<!-- Fin Noticia -->";
	
	var $pagcod;
	var $pagtitle;
	var $pagcodcargatitulo;
	var $plantcod;
	var $noticampliada=false;
	var $impresion=false;
	
	/*Variable que indica si estas o no en el administrador*/
	var $es_admin;
	var $es_admin_online;
	var $pagina_bloqueada=false;
	
	var $accesos_admin = array();

	function cPagina($conexion,$comentarios=false,$es_admin=false,$es_admin_online=false,$accesos_admin=array())
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error = "";
		$this->comentarios=$comentarios;
		$this->es_admin = $es_admin;
		$this->es_admin_online = $es_admin_online;
		$this->accesos_admin = $accesos_admin;
	}
	
	// Recibe el codigo de pagina a mostrar.
	// Setea 
	function Setear($parametros)
	{
		$this->pagcod=$parametros["pagcod"];

		$spnombre="sel_paginas_xpagcod";
		$spparam=array("ppagcod"=>$this->pagcod);
	
		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filapagina=mysqli_fetch_assoc($query);
			
			$this->plantcod=$filapagina["plantcod"];
			$this->pagtitle=$filapagina["pagtitle"];
			$this->pagcodcargatitulo=$filapagina["pagcodcargatitulo"];
	
			if ($filapagina['usuariobloqueo']==$_SESSION['usuariocod'])
				$this->pagina_bloqueada=true;

			
		} // Fin de encontró la pagina
		else
		{
			$this->msg_error.="El código de página es inexistente o contiene un error. Pagina: ".$this->pagcod."<br>";
			return false;
		}
		
		if(isset($parametros["impresion"]))		
			$this->impresion=$parametros["impresion"];
			
		if(isset($parametros["noticampliada"]))
			$this->noticampliada=$parametros["noticampliada"];
			
		return true;
	}
	
	function Mostrar(&$salida)
	{
		$salida="";
		$seprodujoerror=false;
	
		if($this->pagcod==0)
		{
			$this->msg_error.="Pagina no inicializada. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}

		if($this->comentarios)
			$salida.="<!-- Pagina: ".$this->pagcod." -->\n";
		
		$spnombre="sel_plantillas_xplantcod";
		$spparam=array("pplantcod"=>$this->plantcod);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$this->msg_error.="Plantilla no encontrada. ".$this->pagcod."<br>";
			return false;
		}
		
		$filaplantilla=mysqli_fetch_assoc($query);
		
		$partes=array();
		//cSepararHTML::ProcesarHTML($filaplantilla["planthtml"],$partes);
		
		if(!$this->impresion)		
		{
			if ($this->es_admin_online)
				cSepararHTML::ProcesarHTML($filaplantilla["planthtmladmin"],$partes);
			else
				cSepararHTML::ProcesarHTML($filaplantilla["planthtml"],$partes);
		}
		else		
		{
			if(is_null($filaplantilla["planthtmlimp"]))
				return false;

			cSepararHTML::ProcesarHTML($filaplantilla["planthtmlimp"],$partes);

		}

		if($this->comentarios)
			$salida.="<!-- Plantilla: ".$this->plantcod." -->\n";

		foreach($partes as $comando)		
		{
			// si es un comando
			if(is_array($comando))
			{
				// si no existe la clase para dar soporte al comando
				if($comando["Tipo"]=="Campo")
				{
					if($comando["Nombre"]=="title")
						$salida.=$this->pagtitle;
					
					elseif($comando['Nombre']=="pagcodcargatitulo")	
					{	
						if ($this->pagcodcargatitulo)
							$salida.="mostrartitulo";
						else
							$salida.="ocultartitulo";
							
					}elseif($comando["Nombre"]=="paginajs"){
						$salida.='<script type="text/javascript">';
						$salida.=' var pagina='.$this->pagcod.';';
						$salida.='</script>';
					}elseif($comando["Nombre"]=="codigopagina")
					{
						$salida.=$this->pagcod;
					}else{
						$this->msg_error.="Campo ".$comando["Nombre"]." no encontrado en página: ".$this->pagcod."<br>";
						return false;
					}
				}
				elseif($comando["Tipo"]=="Preferencias")
				{
						
					if ($comando["Nombre"]=="Lista")
					{
						$salida.='<ul id="preferent_list">';
						foreach($this->accesos_admin as $acciones)
						{
							$salida.='	<li>';
							$salida.='		<a href="'.$acciones['href'].'" title="'.$acciones['titulo'].'" onclick="'.$acciones['funcion'].'" target="'.$acciones['target'].'">';
							$salida.='			'.$acciones['nombre'];
							$salida.='		</a>';
							$salida.='	</li>';
						}
						$salida.='</ul>';
					}
				}
				elseif(!class_exists($comando["Tipo"]))
				{
					$this->msg_error.="Clase ".$comando["Tipo"]." no encontrada en página: ".$this->pagcod."<br>";
					return false;
				}
				else
				{
					$comando["pagcod"]=$this->pagcod;
					$comando["plantcod"]=$this->plantcod;
					$comando["noticampliada"]=$this->noticampliada;

					$componente=new $comando["Tipo"]($this->conexionobjeto,$this->comentarios,$this->es_admin,$this->es_admin_online,$this->pagina_bloqueada);
					if($componente->Setear($comando))
					{
						if(!$componente->Mostrar($salida))
							$seprodujoerror=true;
					}
					else
						$seprodujoerror=true;
						
					$this->msg_error.=$componente->RetornarMsgError();
				}
			}
			else
				$salida.=$comando;
		}

		if($this->comentarios) 
			$salida.="<!-- /Plantilla: ".$this->plantcod." -->\n";

		return !$seprodujoerror;
	}
	
	function ProcesarNoticias(&$salida,$modifnotic,$noticampliada=false)
	{
		$seprodujoerror=false;

		if($noticampliada!==false)
			$this->noticampliada=$noticampliada;

		cSepararHTML::ProcesarHTML($salida,$partes);

		$salidatemp="";
		foreach($partes as $comando)		
		{
			// si es un comando
			if(is_array($comando))
			{
				if($comando["Tipo"]=="cDatosNoticiasDin")
				{				
					$spnombre="sel_datos_noticias_xdatoid_original";
					$spparam=array("pdatoid"=>$comando["DatoID"],"poriginal"=>$modifnotic);

					if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
					{
						$this->msg_error.="DatosNoticias no encontrado. DatoID: ".$comando["DatoID"]."<br>";
						return false;
					}							
					if($numfilas==0)
						$salidatemp.=$this->str_sin_noticias;
					else
					{
						$noticias_mostradas=0;
						while($filanot=mysqli_fetch_assoc($query))
						{
							$comando1=array();
							$comando1["pagcod"]=$this->pagcod;
							$comando1["notcod"]=$filanot["notcod"];
							$comando1["visualizcod"]=$filanot["visualizcod"];
							$comando1["parametros"]=$filanot["parametros"];
							$comando1["datoid"]=$filanot["datoid"];
							$comando1["ordennoticia"]=$filanot["ordennoticia"];
							$comando1["modifnotic"]=$modifnotic;
						
							$componente=new cVisualizaNoticia($this->conexionobjeto,$this->comentarios,$this->es_admin);
							if($componente->Setear($comando1))
							{
								if(!$componente->Mostrar($salidatemp,$noticias_mostradas))
									$seprodujoerror=true;
							}
							else
								$seprodujoerror=true;
								
							$this->msg_error.=$componente->RetornarMsgError();
						}
						if($noticias_mostradas==0)
							$salidatemp.=$this->str_sin_noticias;
					}
				}
				elseif($comando["Tipo"]=="cMostrarNoticiaAmpliadaDin")
				{	

					$comando1=array();
					$comando1["pagcod"]=$this->pagcod;
					$comando1["noticampliada"]=$this->noticampliada;
					$comando1["modifnotic"]=$modifnotic;
				
					$componente=new cMostrarNoticiaAmpliadaDin($this->conexionobjeto,$this->comentarios);
					if($componente->Setear($comando1))
					{
						if(!$componente->Mostrar($salidatemp))
							$seprodujoerror=true;
					}
					else
						$seprodujoerror=true;

					$this->msg_error.=$componente->RetornarMsgError();
				}
				else
				{
					$array_temp=array();
					foreach($comando as $clave=>$valor)
						$array_temp[]=$clave."='".$valor."'";
					$salidatemp.="$$".implode(" ",$array_temp)."$$";
				}
			}
			else
				$salidatemp.=$comando;
		}
		
		if(!$this->EliminarLibreriasSinNoticias($salidatemp))
			$seprodujoerror=true;
		
		$salida=$salidatemp;
		
		return !$seprodujoerror;
	}
	
	function EliminarLibreriasSinNoticias(&$salidatemp)
	{
		$seprodujoerror=false;

		while(($posicion=strpos($salidatemp,$this->str_sin_noticias))!==false && !$seprodujoerror)
		{
			$pos_inicial=FuncionesPHPPortal::strepos(substr($salidatemp,0,$posicion),$this->str_inicial_noticias);
			$pos_final=strpos($salidatemp,$this->str_final_noticias,$posicion+1);

			if($pos_inicial===false || $pos_final===false)
			{
				$seprodujoerror=true;
				$this->msg_error.="Error en las etiquetas de inicio o fin de noticias<br>";
			}
			else
				$salidatemp=substr($salidatemp,0,$pos_inicial-1).substr($salidatemp,$pos_final+strlen($this->str_final_noticias)+1);
			
		}

		return !$seprodujoerror;
	}
	
	function RetornarMsgError()
	{
		return $this->msg_error;
	}
	
	function MostrarErrorGeneral()
	{
		echo "Error en Página";
	}
} // Fin clase cPagina


//----------------------------------------------------------------------------------------- 
class cPlantZona
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $pagcod;
	var $plantcod;
	var $plantzonacod;
	var $noticampliada=false;
	var $recarga_pagina = false;
	
	var $es_admin;
	var $es_admin_online;
	var $pagina_bloqueada;

	function cPlantZona($conexion,$comentarios=false,$es_admin=false,$es_admin_online=false,$pagina_bloqueada=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error = "";
		$this->comentarios = $comentarios;
		$this->es_admin = $es_admin;
		$this->es_admin_online = $es_admin_online;
		$this->pagina_bloqueada = $pagina_bloqueada;
	}
	
	function Setear($parametros)
	{
		$this->pagcod=$parametros["pagcod"];
		$this->plantcod=$parametros["plantcod"];
		$this->noticampliada=$parametros["noticampliada"];

		$spnombre="sel_plantzonas_xplantcod_plantzonanombre";
		$spparam=array("pplantcod"=>$this->plantcod,"pplantzonanombre"=>$parametros["Nombre"]);
	
		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filaobjeto=mysqli_fetch_assoc($query);
			
			$this->plantzonacod=$filaobjeto["plantzonacod"];
			
		} // Fin de encontró plantzona
		else
		{
			$this->msg_error.="PlantZona no encontrado. Pagina: ".$this->pagcod." / PlantZonaNombre: ".$parametros["Nombre"]."<br>";
			return false;
		}		
		
		return true;
		
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
	
		if($this->plantzonacod==0)
		{
			$this->msg_error.="PlantZona no inicializada. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";	
			return false;
		}
		
		$spnombre="sel_paginas_librerias_xpagcod_plantzonacod";
		$spparam=array("ppagcod"=>$this->pagcod,"pplantzonacod"=>$this->plantzonacod);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
		{
			$this->msg_error.="Paginas-Librerias error. Pagina: ".$this->pagcod." - PlantZona: ".$this->plantzonacod."<br>";
			return false;
		}
		/*
		elseif($numfilas<1)
		{
			$this->msg_error.="Paginas-Librerias error. No hay librerias. Pagina: ".$this->pagcod." - PlantZona: ".$this->plantzonacod."<br>";
			return false;
		}*/
		
		if($this->comentarios)
			$salida.="<!-- PlantZona: ".$this->plantzonacod." -->\n";

		if ($this->pagina_bloqueada && $this->es_admin_online && !$this->recarga_pagina)
		{
			$salida .= '<div id="plantzona_'.$this->plantzonacod.'" class="plantzona">';
			
			if($numfilas==0)
				$salida .= '&nbsp;';
		}
		if ($this->pagina_bloqueada && $this->es_admin_online && $this->recarga_pagina)
		{
			if($numfilas==0)
				$salida .= '&nbsp;';
		}
		// Tabla interna para que las librerias queden una abajo de la otra
//		$salida.="<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n"; // Modificacion div
	
		$comando=array();
		$comando["pagcod"]=$this->pagcod;
		$comando["plantcod"]=$this->plantcod;
		$comando["plantzonacod"]=$this->plantzonacod;
		$comando["noticampliada"]=$this->noticampliada;
		
		while($filalibreria=mysqli_fetch_assoc($query))
		{
//			$salida.="<tr><td>\n"; // Modificacion div
			if ($this->pagina_bloqueada && $this->es_admin_online)
			{
				$codigolib = $this->plantzonacod."_".$filalibreria["libcod"]."_".$filalibreria["secuencia"]."_".$filalibreria["orden"];
				$salida .= '<div id="Libreria_'.$codigolib.'" class="libreria_movimiento">';
				$salida .= '<div class="libreria_movimiento_mover">';
				$salida .= '<div id="Min_'.$codigolib.'" class="minimizar">Minimizar</div>';
				$salida .= '<div id="Max_'.$codigolib.'" style="display:none" class="maximizar">Maximizar</div>';
				$salida .= '<div class="movimiento">Mover</div>';
				$salida .= '<div style="clear:both"></div>';
				$salida .= '</div>';
				$salida .= '<script type="text/javascript">'.chr(13);
				$salida .= "$('#Min_".$codigolib."').bind(".chr(13);
				$salida .= "'click',".chr(13);
				$salida .= "function()".chr(13);
				$salida .= "{".chr(13);
				$salida .= "$('#contenido_".$codigolib."').slideUp('slow');".chr(13);
				$salida .= "$(this).hide();".chr(13);
				$salida .= "$('#Max_".$codigolib."').show();".chr(13);
				$salida .= "}".chr(13);
				$salida .= ");".chr(13);


				$salida .= "$('#Max_".$codigolib."').bind(".chr(13);
				$salida .= "'click',".chr(13);
				$salida .= "function()".chr(13);
				$salida .= "{".chr(13);
				$salida .= "$('#contenido_".$codigolib."').slideDown('slow');".chr(13);
				$salida .= "$(this).hide();".chr(13);
				$salida .= "$('#Min_".$codigolib."').show();".chr(13);
				$salida .= "}".chr(13);
				$salida .= ");".chr(13);
				


				$salida .= '</script>'.chr(13);
				$salida .= '<div class="libreria_movimiento_contenido" id="contenido_'.$codigolib.'">';


			}
			// muestro sólo si no estoy en noticia ampliada o, si lo estoy, si está seteada la bandera de mostrar noticia
			if(!is_array($comando["noticampliada"]) || $filalibreria["mostrar_noticia"]=="S")
			{
				$comando["libcod"]=$filalibreria["libcod"];
				$comando["secuencia"]=$filalibreria["secuencia"];
				$comando["parametros"]=$filalibreria["parametros"];
				
				$componente=new cLibreria($this->conexionobjeto,$this->comentarios,$this->es_admin);
				if($componente->Setear($comando))
				{
					if(!$componente->Mostrar($salida))
						$seprodujoerror=true;
				}
				else
					$seprodujoerror=true;
				
				$this->msg_error.=$componente->RetornarMsgError();
			}
				
			if ($this->pagina_bloqueada && $this->es_admin_online)
			{
				$salida .= '<div style="text-align:right; margin:0 10px 10px 0;">';
				$salida .= '<a href="javascript:void(0)" title="Editar Libreria" onclick="EditarLibreria('.$this->pagcod.','.$this->plantzonacod.','.$filalibreria["libcod"].','.$filalibreria["secuencia"].')">';
				$salida .= '<img src="images/ed_libreria.gif" alt="Editar Libreria" />';
				$salida .= '</a>&nbsp;&nbsp;&nbsp;&nbsp;';
				$salida .= '<a href="javascript:void(0)" title="Eliminar Libreria" onclick="return EliminarLibreriaCompleta('.$this->pagcod.','.$this->plantzonacod.','.$filalibreria["libcod"].','.$filalibreria["secuencia"].','.$filalibreria["orden"].')">';
				$salida .= '<img src="images/cross.gif" alt="Eliminar Libreria" />';
				$salida .= '</a>';
				$salida .= '</div>';
			$salida .= '	</div>'; // libreria contenido movimiento
			$salida .= '</div>';
			}
//			$salida.="</td></tr>\n"; // Modificacion div
		}
//		$salida.="</table>\n"; // Modificacion div
		
		if ($this->pagina_bloqueada && $this->es_admin_online && !$this->recarga_pagina)
		{	
			$salida .= '</div>';
		}
		if($this->comentarios)
			$salida.="<!-- /PlantZona: ".$this->plantzonacod." -->\n";
		
		return !$seprodujoerror;
	}
	
	function RetornarMsgError()
	{
		return $this->msg_error;
	}
	
} // Fin clase cPlantZona


//----------------------------------------------------------------------------------------- 
class cLibreria
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $pagcod;
	var $plantcod;
	var $plantzonacod;
	var $libcod;
	var $secuencia;
	var $parametros;

	var $noticampliada=false;
	
	var $es_admin;

	function cLibreria($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin = $es_admin;
	}
	
	function Setear($parametros)
	{
		$this->pagcod=$parametros["pagcod"];
		$this->plantcod=$parametros["plantcod"];
		$this->plantzonacod=$parametros["plantzonacod"];
		$this->libcod=$parametros["libcod"];
		$this->secuencia=$parametros["secuencia"];
		$this->parametros="";

		$this->noticampliada=$parametros["noticampliada"];

		if($parametros["parametros"]!="" && !is_null($parametros["parametros"]))
		{			
			if(!cSepararHTML::ProcesarParametros($parametros["parametros"],$this->parametros))
			{
				$this->msg_error.="Error en los parámetros de una librería. Pagina: ".$this->pagcod." / PlantZona: ".$this->plantzonacod." / Libreria: ".$this->libcod."<br>";
				return false;
			}
		}
		
		return true;	
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		
		if($this->libcod==0)
		{
			$this->msg_error.="Libreria no inicializada. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		$spnombre="sel_libestructuras_xlibcod";
		$spparam=array("plibcod"=>$this->libcod);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
		{
			$this->msg_error.="LibEstructuras error. Pagina: ".$this->pagcod." / PlantZona: ".$this->plantzonacod." / Libreria: ".$this->libcod."<br>";
			return false;
		}
		
		if($this->comentarios)
			$salida.="<!-- Secuencia: ".$this->secuencia." Libreria: ".$this->libcod." -->\n";

		while($filalibestruc=mysqli_fetch_assoc($query))
		{
			$cantrepeticiones=1;
			
			//Si es una estructura repetible, busco cuantas filas hay cargadas. Sino, dejo por default 1
			if($filalibestruc["libestrucrepetible"]=="S")
			{
				$spnombre="sel_maxfila_paginas_datos";
				$spparam=array("ppagcod"=>$this->pagcod,"pplantzonacod"=>$this->plantzonacod,"psecuencia"=>$this->secuencia,"plibestruccod"=>$filalibestruc["libestruccod"]);
			
				if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$querycantfila,$numfilas,$errno))
				{
					$this->msg_error.="LibEstructuras error - Obtener Cant Filas. Pagina: ".$this->pagcod." / PlantZona: ".$this->plantzonacod." / Libreria: ".$this->libcod."<br>";
					return false;
				}
				
				$filacantfila=mysqli_fetch_assoc($querycantfila);
				if(is_null($filacantfila["maxfila"]))
					$cantrepeticiones=0;
				else
					$cantrepeticiones=$filacantfila["maxfila"];
				
			}
			
			for($numfila=1;$numfila<=$cantrepeticiones;$numfila++)
			{
				$partes=array();
				cSepararHTML::ProcesarHTML($filalibestruc["libestruchtml"],$partes);
		
				foreach($partes as $comando)		
				{
					if(is_array($comando))
					{
						// Si es un parámetro
						if($comando["Tipo"]=="Parametro")
						{
							// Si el valor está seteado, imprimo ese, sino, imprimo el valor por default
							if(isset($this->parametros[$comando["Nombre"]]))
								$salida.=$this->parametros[$comando["Nombre"]]; 
							else
							{
								if($comando["Nombre"]=="ancla")
								{
									for($anclarand=1;$anclarand<=10;$anclarand++)
										$salida.=chr(rand(65,90));
								}
								elseif(isset($comando["Default"]))
									$salida.=$comando["Default"]; 
							}
						}
						elseif($comando["Tipo"]=="cMostrarNoticiaAmpliada")
						{
							$salida.="$$"."Tipo='cMostrarNoticiaAmpliadaDin' Nombre='MostrarNoticia'"."$$";
						}
						// Si es un comando y no existe la clase
						elseif(!class_exists($comando["Tipo"]))
						{					
							$this->msg_error.="Clase ".$comando["Tipo"]." no encontrada en pagina: ".$this->pagcod." / PlantZona: ".$this->plantzonacod." / Libreria: ".$this->libcod."<br>";
							return false;	
						}
						else
						{
							
							$comando["pagcod"]=$this->pagcod;
							$comando["plantcod"]=$this->plantcod;
							$comando["plantzonacod"]=$this->plantzonacod;
							$comando["libcod"]=$this->libcod;
							$comando["secuencia"]=$this->secuencia;
							$comando["libestruccod"]=$filalibestruc["libestruccod"];
							$comando["libestrucvencecont"]=$filalibestruc["libestrucvencecont"];
							$comando["fila"]=$numfila;

							$comando["noticampliada"]=$this->noticampliada;
		
							$componente=new $comando["Tipo"]($this->conexionobjeto,$this->comentarios,$this->es_admin);

							if($componente->Setear($comando))
							{
								if(!$componente->Mostrar($salida))
									$seprodujoerror=true;
							}
							else
								$seprodujoerror=true;
							
							$this->msg_error.=$componente->RetornarMsgError();
						}
					}
					else
						$salida.=$comando;
				} // fin del for que recorre $partes
			} // fin del for por cantidad de filas para un libestruc
		} // fin del while que recorre todas las estructuras de una libreria

		if($this->comentarios)
			$salida.="<!-- /Secuencia: ".$this->secuencia." Libreria: ".$this->libcod." -->\n";
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}
} // Fin clase cLibreria


//----------------------------------------------------------------------------------------- 
class cLibZona
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $pagcod;
	var $plantcod;
	var $plantzonacod;
	var $libcod;
	var $secuencia;
	var $libestruccod;
	var $fila;
	var $libestrucvencecont;
	var $libzonacod;


	var $es_admin;

	function cLibZona($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{	
		$this->pagcod=$parametros["pagcod"];
		$this->plantcod=$parametros["plantcod"];
		$this->plantzonacod=$parametros["plantzonacod"];
		$this->libcod=$parametros["libcod"];
		$this->secuencia=$parametros["secuencia"];	
		$this->libestruccod=$parametros["libestruccod"];
		$this->fila=$parametros["fila"];
		$this->libestrucvencecont=$parametros["libestrucvencecont"];
		
		$spnombre="sel_libzonas_xlibcod_libestruccod_libzonanom";
		$spparam=array("plibcod"=>$this->libcod,"plibestruccod"=>$this->libestruccod,"plibzonanom"=>$parametros["Nombre"]);
	
		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filaobjeto=mysqli_fetch_assoc($query);
			
			$this->libzonacod=$filaobjeto["libzonacod"];
			
		} // Fin de encontró libzona
		else
		{
			$this->msg_error.="LibZona no encontrado. Pagina: ".$this->pagcod." / PlantZona: ".$this->plantzonacod." / Libreria: ".$this->libcod." / LibEstructura: ".$this->libestruccod." / LibZona: ".$parametros["Nombre"]."<br>";
			return false;
		}		
		
		return true;	
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		
		if($this->libzonacod==0)
		{
			$this->msg_error.="LibZona no inicializada. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		$spnombre="sel_paginas_datos_xpagcod_plantzonacod_secuencia_libestruccod_libzonacod_fila";
		$spparam=array("ppagcod"=>$this->pagcod,"pplantzonacod"=>$this->plantzonacod,"psecuencia"=>$this->secuencia,"plibestruccod"=>$this->libestruccod,"plibzonacod"=>$this->libzonacod,"pfila"=>$this->fila);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || ($numfilas!=0 && $numfilas!=1))
		{
			$this->msg_error.="LibZona error. Pagina: ".$this->pagcod." / PlantZona: ".$this->plantzonacod." / Secuencia: ".$this->secuencia." / LibEstruc: ".$this->libestruccod." / LibZona: ".$this->libzona." / Fila: ".$this->fila."<br>";
			return false;
		}

		if($this->comentarios)
			$salida.="<!-- LibEstruc: ".$this->libestruccod." LibZona: ".$this->libzonacod." Fila: ".$this->fila." -->\n";

		// existe un contenido
		if($filadato=mysqli_fetch_assoc($query))
		{
			$valor["datoid"]=$filadato["datoid"];
			$valor["libestrucvencecont"]=$this->libestrucvencecont;

			if(!class_exists($filadato["clase"]))
			{					
				$this->msg_error.="Clase ".$filadato["clase"]." no encontrada en pagina: ".$this->pagcod." / PlantZona: ".$this->plantzonacod." / Secuencia: ".$this->secuencia." / LibEstruc: ".$this->libestruccod." / LibZona: ".$this->libzonacod." / Fila: ".$this->fila."<br>";
				return false;
			}
			else
			{
				$componente=new $filadato["clase"]($this->conexionobjeto,$this->comentarios,$this->es_admin);
				if($componente->Setear($valor))
				{
					if(!$componente->Mostrar($salida))
						$seprodujoerror=true;
				}
				else
					$seprodujoerror=true;
				
				$this->msg_error.=$componente->RetornarMsgError();
			}
		}

		if($this->comentarios)
			$salida.="<!-- /LibEstruc: ".$this->libestruccod." LibZona: ".$this->libzonacod." Fila: ".$this->fila." -->\n";
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

} // Fin clase cLibZona


//----------------------------------------------------------------------------------------- 
class cDatosContenidos
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $datoid;
	var $libestrucvencecont;

	var $es_admin;

	function cDatosContenidos($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->datoid=$parametros["datoid"];
		$this->libestrucvencecont=$parametros["libestrucvencecont"];
	
		$spnombre="sel_datos_contenidos_xdatoid";
		$spparam=array("pdatoid"=>$this->datoid);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas==0)
		{
			$this->msg_error.="DatosContenidos no encontrado. DatoID: ".$this->datoid."<br>";
			return false;
		}		
		
		return true;	
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		
		if($this->datoid==0)
		{
			$this->msg_error.="DatoID no inicializado. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}

		$spnombre="sel_datos_contenidos_xdatoid";
		$spparam=array("pdatoid"=>$this->datoid);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas==0)
		{
			$this->msg_error.="DatoID error. DatoID: ".$this->datoid."<br>";
			return false;
		}

		if($this->comentarios)
			$salida.="<!-- DatoID: ".$this->datoid." -->\n";

		while($filadato=mysqli_fetch_assoc($query))
		{
			$salida.=$filadato["textoanterior"];
		
			$comando=array();
			$comando["contcod"]=$filadato["contcod"];
			$comando["visualizcod"]=$filadato["visualizcod"];
			$comando["parametros"]=$filadato["parametros"];
			$comando["libestrucvencecont"]=$this->libestrucvencecont;
			
			$componente=new cVisualizaContenido($this->conexionobjeto,$this->comentarios,$this->es_admin);
			if($componente->Setear($comando))
			{
				if(!$componente->Mostrar($salida))
					$seprodujoerror=true;
			}
			else
				$seprodujoerror=true;
				
			$this->msg_error.=$componente->RetornarMsgError();
			
			$salida.=$filadato["textoposterior"];
		}

		if($this->comentarios)
			$salida.="<!-- /DatoID: ".$this->datoid." -->\n";
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

} // Fin clase cDatosContenidos

//----------------------------------------------------------------------------------------- 
class cDatosObjetos
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $datoid;
	var $libestrucvencecont;


	var $es_admin;

	function cDatosObjetos($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->datoid=$parametros["datoid"];
		$this->libestrucvencecont=$parametros["libestrucvencecont"];
	
		$spnombre="sel_datos_objetos_xdatoid";
		$spparam=array("pdatoid"=>$this->datoid);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas==0)
		{
			$this->msg_error.="DatosObjetos no encontrado. DatoID: ".$this->datoid."<br>";	
			return false;
		}		
		
		return true;	
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		
		if($this->datoid==0)
		{
			$this->msg_error.="DatoID no inicializado. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		$spnombre="sel_datos_objetos_xdatoid";
		$spparam=array("pdatoid"=>$this->datoid);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas==0)
		{
			$this->msg_error.="DatoID error. DatoID: ".$this->datoid."<br>";
			return false;
		}

		if($this->comentarios)
			$salida.="<!-- DatoID: ".$this->datoid." -->\n";

		while($filadato=mysqli_fetch_assoc($query))
		{
			$salida.=$filadato["textoanterior"];
		
			$comando=array();
			$comando["pagcod"]=(isset($_GET["pagina"])?$_GET["pagina"]:"0");
			$comando["plantcod"]=0;
			$comando["Nombre"]=$filadato["datoid"]." / ".$filadato["ordenobjeto"];
			$comando["datoid"]=$filadato["datoid"];
			$comando["ordenobjeto"]=$filadato["ordenobjeto"];
			
			$componente=new cObjetos($this->conexionobjeto,$this->comentarios,$this->es_admin);
			if($componente->Setear($comando))
			{
				if(!$componente->Mostrar($salida))
					$seprodujoerror=true;
			}
			else
				$seprodujoerror=true;
				
			$this->msg_error.=$componente->RetornarMsgError();
			
			$salida.=$filadato["textoposterior"];
		}
		
		if($this->comentarios)
			$salida.="<!-- /DatoID: ".$this->datoid." -->\n";
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

} // Fin clase cDatosObjetos

//----------------------------------------------------------------------------------------- 
class cDatosNoticias
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $parametros;
	
	var $datoid;

	var $es_admin;

	function cDatosNoticias($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->parametros=$parametros;
		
		return true;
	}

	function Mostrar(&$salida)
	{
		$seprodujoerror=false;

		$spnombre="sel_paginas_datos_xdatoid";
		$spparam=array("pdatoid"=>$this->parametros["datoid"]);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$this->msg_error.="DatosID no encontrado (".__LINE__."). DatoID: ".$this->parametros["datoid"]."<br>";	
			return false;
		}
		$fila=mysqli_fetch_assoc($query);

		if(!is_null($fila["pagoriginal"]))
		{

			$spnombre="sel_paginas_datos_xpagcod_plantzonacod_secuencia_libestruccod_libzonacod_fila";
			$spparam=array("ppagcod"=>$fila["pagoriginal"],"pplantzonacod"=>$fila["plantzonacod"],"psecuencia"=>$fila["secuencia"],"plibestruccod"=>$fila["libestruccod"],"plibzonacod"=>$fila["libzonacod"],"pfila"=>$fila["fila"]);
		
			if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas>1)		
			{
				$this->msg_error.="DatosID no encontrado (".__LINE__."). DatoID: ".$this->parametros["datoid"]."<br>";	
				return false;
			}

			if($numfilas!=1)
				return true;
			
			$fila=mysqli_fetch_assoc($query);

			$this->parametros["datoid"]=$fila["datoid"];
		}

		$salida.="$$"."Tipo='cDatosNoticiasDin' Nombre='cDatosNoticias' DatoID='".$this->parametros["datoid"]."'"."$$";

		return !$seprodujoerror;
	}
	
	function RetornarMsgError()
	{
		return $this->msg_error;
	}
	
}

//----------------------------------------------------------------------------------------- 
class cVisualizaContenido
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $contcod;
	var $visualizcod;
	var $libestrucvencecont;
	var $parametros;

	var $es_admin;

	function cVisualizaContenido($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->contcod=$parametros["contcod"];
		$this->visualizcod=$parametros["visualizcod"];
		$this->parametros=$parametros["parametros"];
		$this->libestrucvencecont=$parametros["libestrucvencecont"];

		return true;
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		
		if($this->visualizcod==0 || $this->contcod==0)
		{
			$this->msg_error.="Contcod/Visualizcod no inicializados. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		$spnombre="sel_contenidos_xcontcod";
		$spparam=array("pcontcod"=>$this->contcod);

		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$this->msg_error.="Contenidos error. Contcod: ".$this->contcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		$filacontenido=mysqli_fetch_assoc($query);
		
		if($filacontenido["contcopiadoen"]!=NULL) // El contenido se está modificando
		{
			$spparam=array("pcontcod"=>$filacontenido["contcopiadoen"]);
	
			if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
			{
				$this->msg_error.="Contenidos error. Contcod: ".$this->contcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
				return false;
			}
			$filacontenido=mysqli_fetch_assoc($query);
		}
		

		$spnombre="sel_imagenes_ximgcod";
		$spparam=array("pimgcod"=>$filacontenido["contimagen"]);

		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$this->msg_error.="Imagen error. Contcod: ".$this->contcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		$filaimagen=mysqli_fetch_assoc($query);

		// Si hay que tener en cuenta la fecha de venc y el contenido está vencido, salgo
		if($this->libestrucvencecont=="S" && $filacontenido["contfvenc"]!="" && $filacontenido["contfvenc"]<date('Y-m-d H:i:s'))
			return true;
		
		$spnombre="sel_visualizaciones_xvisualizcod";
		$spparam=array("pvisualizcod"=>$this->visualizcod);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$queryv,$numfilasv,$errno) || $numfilasv!=1)
		{
			$this->msg_error.="Visualizaciones error. Contcod: ".$this->visualizcod." /  Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		$filavisualizacion=mysqli_fetch_assoc($queryv);

		$partes=array();
		cSepararHTML::ProcesarHTML($filavisualizacion["visualizhtml"],$partes);

		if($this->comentarios)
			$salida.="<!-- Visualiza: ".$this->visualizcod." Contcod: ".$this->contcod." -->\n";

		foreach($partes as $comando)		
		{
			// si es un comando
			if(is_array($comando))
			{
				// si tengo que mostrar el valor de un campo
				if($comando["Tipo"]=="Campo")
				{
					
					if(isset($filacontenido[$comando["Nombre"]]))
					{
						$conv_SGML=false;
						if($comando["Nombre"]=="contdesccorta" || $comando["Nombre"]=="contcopete" || $comando["Nombre"]=="contdesclarga")
							$conv_SGML=true;
						
						$campo=new cVisualizaCampo($this->conexionobjeto,$this->comentarios,$this->es_admin);
						if($campo->Setear(array("ContCampo"=>$filacontenido[$comando["Nombre"]],"conv_SGML"=>$conv_SGML)))
						{
							if(!$campo->Mostrar($salida))
								$seprodujoerror=true;
						}
						else
							$seprodujoerror=true;
							
						$this->msg_error.=$campo->RetornarMsgError();
					}
					else
					{
						$this->msg_error.="Campo ".$comando["Nombre"]." no encontrado o vacio en pagina: ".$_GET["pagina"]." / Contenido: ".$this->contcod." / Visualizacion: ".$this->visualizcod."<br>";
						$seprodujoerror=true;
					}
				}
				elseif($comando["Tipo"]=="Imagen")
				{
					if(isset($filacontenido[$comando["Nombre"]]))
					{
//						$salida.=str_replace(array(" ","ó","ñ"),array("%20","%F3","%F1"),htmlentities($filaimagen["imgubic"],ENT_QUOTES)); 
						$salida.=FuncionesPHPPortal::ConvertirStringParaURL($filaimagen["imgubic"]); 
					}
					else
					{
						$this->msg_error.="Imagen ".$comando["Nombre"]." no encontrado o vacio en pagina: ".$_GET["pagina"]." / Contenido: ".$this->contcod." / Visualizacion: ".$this->visualizcod."<br>";
						$seprodujoerror=true;
					}
				}
				elseif($comando["Tipo"]=="cLinks")
				{
					$componente=new cLinks($this->conexionobjeto,$this->comentarios,$this->es_admin);
					if($componente->Setear(array("contcod"=>$filacontenido["contcod"])))
					{
						if(!$componente->Mostrar($salida))
							$seprodujoerror=true;
					}
					else
						$seprodujoerror=true;
					
					$this->msg_error.=$componente->RetornarMsgError();
					
				}
				elseif($comando["Tipo"]=="Parametro")
				{
					$paramvisualiz=array();
					
					if($this->parametros!="" && !is_null($this->parametros))
					{			
						if(!cSepararHTML::ProcesarParametros($this->parametros,$paramvisualiz))
						{
							$this->msg_error.="Error en los parámetros de una visualizacion. Contcod: ".$this->contcod." / Visualizcod: ".$this->visualizcod."<br>";
							$seprodujoerror=true;
						}
					}

					// Si el valor está seteado, imprimo ese, sino, imprimo el valor por default
					if(isset($paramvisualiz[$comando["Nombre"]]))
						$salida.=$paramvisualiz[$comando["Nombre"]]; 
					else
					{
						if(isset($comando["Default"]))
							$salida.=$comando["Default"]; 
					}
				}
				else
				{					
					$this->msg_error.="Clase ".$comando["Tipo"]." no soportada en pagina: ".$_GET["pagina"]." / Contenido: ".$this->contcod." / Visualizacion: ".$this->visualizcod."<br>";
					$seprodujoerror=true;
				}
			}
			else
				$salida.=$comando;
		}

		if($this->comentarios)
			$salida.="<!-- /Visualiza: ".$this->visualizcod." Contcod: ".$this->contcod." -->\n";
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

} // Fin clase cVisualizaContenido

//----------------------------------------------------------------------------------------- 
class cVisualizaNoticia
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $pagcod;
	var $notcod;
	var $visualizcod;
	var $parametros;
	var $datoid;
	var $ordennoticia;
	var $modifnotic;
	var $es_admin;

	function cVisualizaNoticia($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->pagcod=$parametros["pagcod"];
		$this->notcod=$parametros["notcod"];
		$this->visualizcod=$parametros["visualizcod"];
		$this->parametros=$parametros["parametros"];
		$this->datoid=$parametros["datoid"];
		$this->ordennoticia=$parametros["ordennoticia"];
		$this->modifnotic=$parametros["modifnotic"];
		return true;
	}
	
	
	function Mostrar(&$salida,&$noticias_mostradas)
	{
		$seprodujoerror=false;
		
		if($this->visualizcod==0 || $this->notcod==0)
		{
			$this->msg_error.="Notcod/Visualizcod no inicializados. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		$spnombre="sel_noticias_xnotcod";
		$spparam=array("pnotcod"=>$this->notcod);

		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$this->msg_error.="Noticias error. Notcod: ".$this->notcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		$filanoticia=mysqli_fetch_assoc($query);

		// Si la noticia está vencida, salgo
		//if($filanoticia["notfvenc"]!="" && $filanoticia["notfvenc"]<=date('Y-m-d H:i:s'))
			//return true;

		if($this->modifnotic=="S" && $filanoticia["notestado"]!=NOTAPROB)
			return true;

		if($this->modifnotic!="S")
		{
			if($filanoticia["notcopiadoen"]!=NULL) // El contenido se está modificando
			{
				$spparam=array("pnotcod"=>$filanoticia["notcopiadoen"]);
		
				if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
				{
					$this->msg_error.="Noticias error. Notcod: ".$this->notcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
					return false;
				}
				$filanoticia=mysqli_fetch_assoc($query);
			}
		}
		
		if(!is_null($filanoticia["imgcod"]))
		{
			$spnombre="sel_noticias_imagenes_ximgcod";
			$spparam=array("pimgcod"=>$filanoticia["imgcod"]);
	
			if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
			{
				$this->msg_error.="Imagen error. Notcod: ".$this->notcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
				return false;
			}
			$filaimagen=mysqli_fetch_assoc($query);
		}

		$spnombre="sel_noticias_visualizaciones_xvisualizcod";
		$spparam=array("pvisualizcod"=>$this->visualizcod);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$queryv,$numfilasv,$errno) || $numfilasv!=1)
		{
			$this->msg_error.="Visualizaciones error. Visualizcod: ".$this->visualizcod." /  Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		$filavisualizacion=mysqli_fetch_assoc($queryv);

		// $partes=array();
		// cSepararHTML::ProcesarHTML($filavisualizacion["visualizhtml"],$partes);

		// -------- 
		// Version de automata con visualización de noticias con condicionales, van 4 líneas abajo.
		// versión previa van las dos líneas de ariba que estan comentadas
		// --------  
		$partes=array();
		cSepararHTML::PreProcesarHTML($filanoticia,$filavisualizacion["visualizhtml"],$html);
		$partes=array();
		cSepararHTML::ProcesarHTML($html,$partes);
		// --------
		
		if($this->comentarios)
			$salida.="<!-- Visualiza: ".$this->visualizcod." Noticia: ".$this->notcod." -->\n";

		foreach($partes as $comando)		
		{
			// si es un comando
			
			if(is_array($comando))
			{
								
				// si tengo que mostrar el valor de un campo
				if($comando["Tipo"]=="Campo")
				{					
					if(isset($filanoticia[$comando["Nombre"]]))
					{
						$conv_SGML=false;
						if($comando["Nombre"]=="contdesccorta" || $comando["Nombre"]=="contcopete" || $comando["Nombre"]=="contdesclarga")
							$conv_SGML=true;
						$campo=new cVisualizaCampo($this->conexionobjeto,$this->comentarios,$this->es_admin);
						if($campo->Setear(array("ContCampo"=>$filanoticia[$comando["Nombre"]],"conv_SGML"=>$conv_SGML)))
						{
							if(!$campo->Mostrar($salida))
								$seprodujoerror=true;
						}
						else
							$seprodujoerror=true;
							
						$this->msg_error.=$campo->RetornarMsgError();
					}
					else
					{
						$this->msg_error.="Campo ".$comando["Nombre"]." no encontrado o vacio en pagina: ".$_GET["pagina"]." / Visualizacion: ".$this->visualizcod."<br>";
						$seprodujoerror=true;
					}
				}elseif($comando["Tipo"]=="Fecha")
				{
					$salida.=FuncionesPHPPortal::ConvertirFecha($filanoticia[$comando["Nombre"]],"aaaa-mm-dd","dd/mm/aaaa");
				}
				elseif($comando["Tipo"]=="FechaTexto") 					// Modificado xxx respecto produccion 
				{
					$salida.= FuncionesPHPPortal::ObtenerTextoFecha($filanoticia[$comando["Nombre"]]);					
				}
				elseif($comando["Tipo"]=="Imagen")
				{
					if(isset($filanoticia[$comando["Nombre"]]))
					{
						$salida.=FuncionesPHPPortal::ConvertirStringParaURL($filaimagen["imgubic"]); 
					}
					else
					{
						$this->msg_error.="Imagen ".$comando["Nombre"]." no encontrado o vacio en pagina: ".$_GET["pagina"]." / Visualizacion: ".$this->visualizcod."<br>";
						$seprodujoerror=true;
					}
				}
				elseif($comando["Tipo"]=="NoticiaAmpliada")
				{
					$salida.="&middot; <a href=\"paginas.dhtml?pagina=".$this->pagcod."&amp;datoid=".$this->datoid."&amp;ordennoticia=".$this->ordennoticia."\" target=\"_self\">Más información</a>";
				
				}
				elseif($comando["Tipo"]=="Parametro")
				{
					$paramvisualiz=array();
					//echo "<br> sacar 3 paso visualiza noticia";
					if($this->parametros!="" && !is_null($this->parametros))
					{			
					//	echo "<br> sacar 3.5 paso visualiza noticia";
						
					//	echo "<br> parametros";						
					//	print_r($this->parametros);
						
					//	echo "<br> paramvisualiz";
					//	print_r($paramvisualiz);
						
						if(!cSepararHTML::ProcesarParametros($this->parametros,$paramvisualiz))
						{
							$this->msg_error.="Error en los parámetros de una visualizacion. Notcod: ".$this->notcod." / Visualizcod: ".$this->visualizcod."<br>";
							$seprodujoerror=true;
						}
					}

					//echo "<br> sacar 4 paso visualiza noticia";
					// Si el valor está seteado, imprimo ese, sino, imprimo el valor por default
					if(isset($paramvisualiz[$comando["Nombre"]]))
						$salida.=$paramvisualiz[$comando["Nombre"]]; 
					else
					{
						if(isset($comando["Default"]))
							$salida.=$comando["Default"]; 
					}
				}
				else
				{					
					$this->msg_error.="Clase ".$comando["Tipo"]." no soportada en pagina: ".$_GET["pagina"]." / Noticia: ".$this->notcod." / Visualizacion: ".$this->visualizcod."<br>";
					$seprodujoerror=true;
				}
			}
			else
				$salida.=$comando;
		}

		if($this->comentarios)
			$salida.="<!-- /Visualiza: ".$this->visualizcod." Noticia: ".$this->notcod." -->\n";
		
		$noticias_mostradas++;
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

} // Fin clase cVisualizaContenido





//----------------------------------------------------------------------------------------- 
class cVisualizaCampo
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $es_admin;
	
	var $ContCampo="";
	var $conv_SGML=false;

	var $CONV_SGML_IN=array("“","”","–","-","’","•","…","€");
	var $CONV_SGML_OUT=array("&#8220;","&#8221;","&ndash;","&ndash;","&rsquo;","&bull;","&hellip;","&euro;");

	function cVisualizaCampo($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->ContCampo=$parametros["ContCampo"];
		$this->conv_SGML=$parametros["conv_SGML"];

		return true;
	}
	
	
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		
		$partes=array();
		cSepararHTML::ProcesarHTML($this->ContCampo,$partes);
		foreach($partes as $comando)		
		{
			// si es un comando
			if(is_array($comando))
			{
				if($comando["Tipo"]=="Link")
				{
					if (!isset($comando["target"]))
						$comando["target"]="_blank";
						
					$pos = strpos($comando["URL"],"mailto:");
					if ($pos !== false)	
					{
						$mail = substr($comando["URL"],7);
						$comando["URL"] = "mailto:".FuncionesPHPPortal::EncriptarMail($mail);
					}
					$salida.="<a href='".$comando["URL"]."' target='".$comando["target"]."'>";

					$texto=htmlentities($comando["Texto"],ENT_QUOTES);
					$texto=str_replace($this->CONV_SGML_IN,$this->CONV_SGML_OUT,$texto); 
					
					$salida.=$texto;
					$salida.="</a>";
				}
				elseif($comando["Tipo"]=="Bold")
					$salida.="<strong>";
				elseif($comando["Tipo"]=="BoldFin")
					$salida.="</strong>";
				elseif($comando["Tipo"]=="Italic")
					$salida.="<em>";
				elseif($comando["Tipo"]=="ItalicFin")
					$salida.="</em>";
				elseif($comando["Tipo"]=="Underline")
					$salida.="<u>";
				elseif($comando["Tipo"]=="UnderlineFin")
					$salida.="</u>";
				elseif($comando["Tipo"]=="Bullet")
					$salida.="&nbsp;&nbsp;&nbsp;&#8226; ";
				elseif($comando["Tipo"]=="ImagenLinkExterno")
					$salida.="<img src=\"/contenido/portal/img/ico_link_externo.gif\" width=\"10\" height=\"8\" alt=\"\" /> ";
				elseif($comando["Tipo"]=="H3")
					$salida.="<h3>";
				elseif($comando["Tipo"]=="H3Fin")
					$salida.="</h3>";
				else
				{					
					$this->msg_error.="Clase ".$comando["Tipo"]." no soportada en pagina: ".$_GET["pagina"]."<br>";
					$seprodujoerror=true;
				}
			}
			else
			{
				$comando=nl2br(htmlentities($comando,ENT_QUOTES));
				if($this->conv_SGML)
					$comando=str_replace($this->CONV_SGML_IN,$this->CONV_SGML_OUT,$comando); 
								
				$salida.=$comando; 
			}
		}

		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

} // Fin clase cVisualizaCampo

//----------------------------------------------------------------------------------------- 
class cLinks
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $es_admin;

	var $contcod;

	function cLinks($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->contcod=$parametros["contcod"];

		return true;
	}
	
	function Mostrar(&$salida)
	{
		if($this->contcod==0)
		{
			$this->msg_error.="Contcod no inicializado. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		$spnombre="sel_cont_link_orden";
		$spparam=array("pcontcod"=>$this->contcod,"porderby"=>"contlinkcod");

		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
		{
			$this->msg_error.="ContenidosLinks error. Contcod: ".$this->contcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		while($filacontlink=mysqli_fetch_assoc($query))
		{
			$salida.="<br /><a href='".$filacontlink["contlink"]."'>".$filacontlink["contlinktexto"]."</a>";
		}
		
		return true;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

} // Fin clase cLinks

//----------------------------------------------------------------------------------------- 
class cObjetos
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $es_admin;

	var $dinamico=false;
	
	var $pagcod;
	var $plantcod;
	var $objetocod;
	var $parametros;
	
	var $cargaobjeto = true;

	function cObjetos($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->pagcod=$parametros["pagcod"];
		$this->plantcod=$parametros["plantcod"];
		
		// si está seteado datoid, entonces estoy en un dato
		if(isset($parametros["datoid"]))
		{
			$spnombre="sel_datos_objetos_xdatoid_ordenobjeto";
			$spparam=array("pdatoid"=>$parametros["datoid"],"pordenobjeto"=>$parametros["ordenobjeto"]);
		}
		// si está seteado libcod, entonces estoy en una libreria
		elseif(isset($parametros["libcod"]) && !isset($parametros['Codigo']))
		{
			$spnombre="sel_paginas_librerias_objetos_xpagcod_plantzonacod_secuencia_nombreobjeto";
			$spparam=array("ppagcod"=>$this->pagcod,"pplantzonacod"=>$parametros["plantzonacod"],"psecuencia"=>$parametros["secuencia"],"pnombreobjeto"=>$parametros["Nombre"]);
		}elseif(isset($parametros['Codigo']))
		{
			$spnombre="sel_objetos_xobjetocod";
			$spparam=array("pobjetocod"=>$parametros['Codigo']);
		}else
		{ // el objeto está a nivel plantilla
			$spnombre="sel_paginas_objetos_xpagcod_nombreobjeto";
			$spparam=array("ppagcod"=>$this->pagcod,"pnombreobjeto"=>$parametros["Nombre"]);
		}

		if (isset($parametros['CargaDefault']) && $parametros['CargaDefault']=="S")
		{
			
			$spnombrepag="sel_paginas_xpagcod";
			$spparampag=array("ppagcod"=>$this->pagcod);
			if($this->conexionobjeto->ejecutarStoredProcedure($spnombrepag,$spparampag,$querypag,$numfilaspag,$errno) && $numfilaspag==1)
			{
				$filapagina=mysqli_fetch_assoc($querypag);
				if ($filapagina[$parametros['Campo']]==0)
					$this->cargaobjeto = false;
			}	
		}

		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filaobjeto=mysqli_fetch_assoc($query);
			$this->objetocod=$filaobjeto["objetocod"];
			if(isset($filaobjeto["parametros"]) && $filaobjeto["parametros"]!="" && !is_null($filaobjeto["parametros"]))
			{			
				if(!cSepararHTML::ProcesarParametros($filaobjeto["parametros"],$this->parametros))
				{
					$this->msg_error.="Error en los parámetros de un objeto. Pagina: ".$parametros["pagcod"]." - Objeto: ".$parametros["Nombre"]."<br>";
					return false;
				}
			}
		} // Fin de encontró el objeto
		else
		{
			$this->cargaobjeto=false;
			return true;
			//$this->msg_error.="Objeto No Encontrado. Pagina: ".$parametros["pagcod"]." - Objeto: ".$parametros["Nombre"]."<br>";
			//return false;
		}		
	
		if(isset($parametros["Dinamico"]) && $parametros["Dinamico"]=="S")
			$this->dinamico=true;
			
		return true;
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		
		if (!$this->cargaobjeto)
			return true;
		
		if($this->objetocod==0)
		{
			$this->msg_error.="Objeto No Encontrado. Pagina: ".$this->pagcod." - Objeto: ".$this->objetocod."<br>";
			return false;
		}
		
		$spnombre="sel_objetos_xobjetocod";
		$spparam=array("pobjetocod"=>$this->objetocod);
	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$this->msg_error.="Objeto No Encontrado. Pagina: ".$this->pagcod." - Objeto: ".$this->objetocod."<br>";
			return false;
		}
		
		$filaobjeto=mysqli_fetch_assoc($query);

		if($this->comentarios)
			$salida.="<!-- Objeto: ".$this->objetocod." -->\n";
		//echo htmlspecialchars($filaobjeto["objetohtml"],ENT_QUOTES)."<br><br>";
		if($this->dinamico)
		{
			$salida.=$filaobjeto["objetohtml"];
			//echo htmlspecialchars($filaobjeto["objetohtml"],ENT_QUOTES)."<br><br>";
		}
		else
		{
			$partes=array();
			cSepararHTML::ProcesarHTML($filaobjeto["objetohtml"],$partes);
	
			foreach($partes as $comando)		
			{
				// si es un comando
				if(is_array($comando))
				{
					if($comando["Tipo"]=="Parametro")
					{
						if(isset($this->parametros[$comando["Nombre"]]))
							$salida.=$this->parametros[$comando["Nombre"]]; 
						else
							if(isset($comando["Default"]))
								$salida.=$comando["Default"]; 
					}
					elseif(!class_exists($comando["Tipo"]))
					{					
						$this->msg_error.="Clase ".$comando["Tipo"]." no encontrada en página: ".$this->pagcod." / Objeto: ".$this->objetocod."<br>";
						$seprodujoerror=true;
					}
					else
					{
						$componente=new $comando["Tipo"]($this->conexionobjeto,$this->comentarios,$this->es_admin);
						$comando['pagcod'] = $this->pagcod;
						if($componente->Setear($comando))
						{
							if(!$componente->Mostrar($salida))
								$seprodujoerror=true;
						}
						else
							$seprodujoerror=true;
					}
				}
				else
					$salida.=$comando;
			}
		}

		if($this->comentarios)
			$salida.="<!-- /Objeto: ".$this->objetocod." -->\n";

		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}
	
}

class cMostrarNoticiaAmpliadaDin
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $es_admin;
	
	var $pagcod;
	var $noticampliada=false;
	var $modifnotic;

	function cMostrarNoticiaAmpliadaDin($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{	
		$this->pagcod=$parametros["pagcod"];
		$this->noticampliada=$parametros["noticampliada"];
		$this->modifnotic=$parametros["modifnotic"];
				
		return true;	
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		$noticias_mostradas=0;
		
		if(is_array($this->noticampliada))
		{
			$spnombre="sel_datos_noticias_xdatoid_ordennoticia";
			$spparam=array("pdatoid"=>$this->noticampliada["datoid"],"pordennoticia"=>$this->noticampliada["ordennoticia"],"poriginal"=>$this->modifnotic);
	
			if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
			{
				$this->msg_error.="DatoID error. DatoID: ".$this->noticampliada["datoid"]."<br>";
				return false;
			}
			$fila=mysqli_fetch_assoc($query);

			$comando=array();
			$comando["pagcod"]=$this->pagcod;
			$comando["notcod"]=$fila["notcod"];
			$comando["visualizcod"]=$fila["visualiznotampcod"];
			$comando["parametros"]="";
			$comando["datoid"]="";
			$comando["ordennoticia"]="";
			$comando["modifnotic"]=$this->modifnotic;

			$componente=new cVisualizaNoticia($this->conexionobjeto,$this->comentarios,$this->es_admin);
			if($componente->Setear($comando))
			{
				if(!$componente->Mostrar($salida,$noticias_mostradas))
					$seprodujoerror=true;
			}
			else
				$seprodujoerror=true;

			$this->msg_error.=$componente->RetornarMsgError();
		}
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

}


//----------------------------------------------------------------------------------------- 
class cPaginaEstatica
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $es_admin;
	
	var $pagina;

	function cPaginaEstatica($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->pagina=DIR_PAGESTATICA.$parametros["Pagina"];

		return true;
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		$contenido="";

		if($this->comentarios)
			$salida.="<!-- Pagina Estatica: ".$this->pagina." -->\n";

		if(!is_readable($this->pagina))
		{
			$this->msg_error.="Archivo ".$this->pagina." no se puede leer.<br>";
			$seprodujoerror=true;
		}

		if (!$seprodujoerror && !$contenido=file_get_contents($this->pagina))
		{
			$this->msg_error.="Error al obtener el contenido del archivo ".$this->pagina."<br>";
			$seprodujoerror=true;
		}
		
		$salida.=$contenido;

		if($this->comentarios)
			$salida.="<!-- /Pagina Estatica: ".$this->pagina." -->\n";
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}
		
}


//----------------------------------------------------------------------------------------- 
class cRuta
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $es_admin;
	
	var $pagcod;
	var $con_link=true;
	var $idioma="ESP";
	var $pag_inicio=1;

	function cRuta($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		
		$this->pagcod=$parametros["pagcod"];
		if(isset($parametros["con_link"]))
			$this->con_link=$parametros["con_link"];
		if(isset($parametros["Idioma"]))
			$this->idioma=$parametros["Idioma"];
		if(isset($parametros["pagInicio"]))
			$this->pag_inicio=$parametros["pagInicio"];	

		return true;
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		$ruta=array();

		$ruta[]="<a href='paginas.dhtml?pagina=".$this->pag_inicio."' title=\"Link a Inicio\">Inicio</a>";
		if(!$this->_ObtenerRuta($this->pagcod,0,$ruta))
			return false;

		//array_pop($ruta);

		$rutastr=implode(" > ",$ruta);
		
		$salida.=$rutastr;
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}
	
	function _ObtenerRuta($pagcod,$orden,&$ruta)
	{
		if(is_null($pagcod) || $pagcod=="")
			return true;

		if($orden>10)
		{
			$this->msg_error.="La ruta excede el limite. Pagcod: ".$this->pagcod."<br>";
			return false;
		}	

		$spnombre="sel_paginas_xpagcod";
		$spparam=array("ppagcod"=>$pagcod);
	
		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filapagina=mysqli_fetch_assoc($query);

			if(!$this->_ObtenerRuta($filapagina["pagsuperior"],$orden+1,$ruta))
				return false;

			
			if($orden==0 || !$this->con_link)
			{	
				$ruta[]="<strong>".$filapagina["pagnomarbol"]."</strong>";
			}else
			{
				if($filapagina["pagnomarbol"]=="Principal" && $this->idioma=="ING")
					$filapagina["pagnomarbol"]="Home";
					
				$ruta[]="<a href='paginas.dhtml?pagina=".$pagcod."' title=\"Link a ".$filapagina["pagnomarbol"]."\">".$filapagina["pagnomarbol"]."</a>";
			}
			

		} // Fin de encontró la pagina
		else
		{
			$this->msg_error.="El código de página es inexistente o contiene un error. Pagina: ".$this->pagcod."<br>";
			return false;
		}	
		
		return true;	
	
	}
	
}


//----------------------------------------------------------------------------------------- 
class cMenu
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $es_admin;
	
	var $pagcod;
	var $con_link = true;
	var $idioma="ESP";
	var $accion="";
	var $pagcodbusqueda="";

	function cMenu($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->pagcod=$parametros["pagcod"];
		if(isset($parametros["con_link"]))
			$this->con_link=$parametros["con_link"];
		if(isset($parametros["Idioma"]))
			$this->idioma=$parametros["Idioma"];
			
		if(isset($parametros['PaginaDefault']) && $parametros['PaginaDefault']!="")
			$this->pagcod=$parametros['PaginaDefault'];
		if(isset($parametros['PaginaSeleccionar']) && $parametros['PaginaSeleccionar']!="")
			$this->pagcodbusqueda=$parametros['PaginaSeleccionar'];

		$this->accion = $parametros['Subtipo'];

		return true;
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		$ruta=array();

		
		switch($this->accion)
		{
			case 'MenuSeleccion':
				if(!$this->_BuscarSuperior($this->pagcod,$seleccion))
					return false;
				if ($seleccion == $this->pagcodbusqueda)
					$salida.=" class=\"seleccionado\" ";
			break;
		}
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}
	
	
	function _BuscarSuperior($pagcod,&$superior)
	{
		if(is_null($pagcod) || $pagcod=="")
			return true;

		$spnombre="sel_paginas_xpagcod";
		$spparam=array("ppagcod"=>$pagcod);
	
		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filapagina=mysqli_fetch_assoc($query);
			$superior = $pagcod;
			if(!$this->_BuscarSuperior($filapagina["pagsuperior"],$superior))
				return false;

			
		} // Fin de encontró la pagina
		else
		{
			$this->msg_error.="El código de página es inexistente o contiene un error. Pagina: ".$this->pagcod."<br>";
			return false;
		}	
		
		return true;	
	
	}
	
}


