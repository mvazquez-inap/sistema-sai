//----------------------------------------------------------------------------------------- 
// Genera una password nueva para ser enviada al prestador

// Parámetros de Entrada:
//		usuariocuit/usuariomail: datos a buscar en la base

// Retorna:
//		nuevapwd: la clave nueva generada por el sistema
//		la función retorna true o false si se pudo ejecutar con éxito o no
	
	function OlvidoPassword($usuariocuit,$usuarioemail,&$nuevapwd)
	{		
	
		$ArregloDatos= array();
		$ArregloDatos['presdoc_cuilt']=$usuariocuit;
	
		if(!$this->BuscarPrestadorDocente($ArregloDatos,$numfilas,$resultado,$error,$errormail) || $numfilas != 1) {
			$txt_sys_mail="\npresdoc_cuilt=".$usuariocuit."\nerror=".$error;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			echo "<br><br>";
			echo "<div align='center'><a href='prestador_docente_web.dhtml' class='textoTablaDato linkFondoBlanco'>Volver a inicio</a></div>";
			
			return false;			
		}
		
		$fila_prestador = mysqli_fetch_assoc($resultado);
		
		if ($fila_prestador["presdoc_email"] == $usuarioemail) { 
	
			if($fila_prestador["presdoc_estado"]>PRESDOCACTIVO)
			{
				echo "<br><br><br><br>";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No se pudo enviar una contraseña nueva. Su usuario no se encuentra activo - '".htmlspecialchars($usuariocuit,ENT_QUOTES)."'/'".htmlspecialchars($usuarioemail,ENT_QUOTES)."'",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				echo "<br><br>";
				echo "<div align='center'><a href='".$_SERVER['PHP_SELF']."' class='textoTablaDato linkFondoBlanco'>Volver a ingresar los datos</a></div>";
				return false;
			}
			else
			{ // se puede generar la nueva contraseña
				$nuevapwd=FuncionesPHPLocal::GenerarPassword(6);
				
				$spnombreusu='upd_presatodpassword_xusuariocod';
				$spparamusu=array('ppresdoc_password'=>md5($nuevapwd),'pultmodusuario'=>0,'pultmodfecha'=>date('Y/m/d H:i:s'),'ppresdoc_codigo'=>$fila_prestador["presdoc_codigo"]);
			
				if(!$this->conexion->ejecutarStoredProcedure($spnombreusu,$spparamusu,$nousar,$numfilas,$errno) || $numfilas!=1)
				{
					echo"<p>&nbsp;</p>";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en modificación de prestador docente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}	
				else
				{
					echo "<br><br><br><br>";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se envió su nueva contraseña al mail. El envío puede demorar unos minutos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					echo "<br><br>";
					echo "<div align='center'><a href='prestador_docente_web.dhtml' class='textoTablaDato linkFondoBlanco'>Volver a inicio</a></div>";
					FuncionesPHPLocal::RegistrarAcceso($this->conexion,'023807',"presdoc_codigo=".$fila_prestador["presdoc_codigo"]." - presdoc_cuilt=".$fila_prestador["presdoc_cuilt"],0);	
				}
	
			} // fin de se puede enviar la nueva contraseña
		} else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
			echo "<br><br>";
			echo "<div align='center'><a href='prestador_docente_web.dhtml' class='textoTablaDato linkFondoBlanco'>Volver a inicio</a></div>";
		
			return false;
		}
		
		return true;
	}




} // class
?>