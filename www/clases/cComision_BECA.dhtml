//--------------------------------------------------------------------------------------------------------
function ImprimirActaVolante ($datos_caratula, $datos_cabecera, $datos_inscriptos, $formato) {

	function GenerarActa(&$pdf,$datos_caratula,$datos_cabecera,$datos_inscriptos) {
	
		$pdf->AddActa();
		$pdf->Set('comi_codinap',$datos_caratula['datos']['comi_codinap']);
		$pdf->Set('comi_acta_numero',$datos_caratula['datos']['comi_acta_numero']);		
		$pdf->Set('act_nombre',$datos_caratula['datos']['act_nombre']);
		$pdf->Set('sede',$datos_caratula['datos']['sede']);
		$pdf->Set('comi_domicilio',$datos_caratula['datos']['comi_domicilio']);
		$pdf->Set('comi_detalle',$datos_caratula['datos']['comi_detalle']);
		$pdf->Set('cronograma',$datos_caratula['cronograma']);
		$pdf->Set('prestador_docente',$datos_caratula['prestador_docente']);
		$pdf->Set('datos_cabecera',$datos_cabecera);			
		$pdf->Set('datos_inscriptos',$datos_inscriptos);	
		if ($datos_caratula['es_curso_inap'])
			$pdf->Set('jurisdnom','Curso organizado por INAP');
		else
			$pdf->Set('jurisdnom',$datos_caratula['jurisdnom']);
	
	} // GenerarActa

	$pdf = new cActaPDF();
	GenerarActa($pdf,$datos_caratula,$datos_cabecera,$datos_inscriptos); 
	$pdf->MostrarActa($this->conexion,$formato);
	$pdf->Output("acta.pdf","I");

	return true;
}

//-----------------------------------------------------------------------------------------------------	
	function MostrarInscriptosEvaluar($conexion,$comi_codigo) {
	?>
	<script language="javascript" type="text/javascript">
	
	function CambioComboEval(docu,cambio_eval_codigo_name) {

		var objCambioEval = docu.getElementById(cambio_eval_codigo_name);

		objCambioEval.value = 1; 
		return true;
	}
	//-----------------------------------------------------------
	function CambiarEvaluacion (docu, formulario, eval_codigo) {
	
		if (eval_codigo == "") {
			alert ("Debe ingresar la evaluación");
			return false;
		}
		
		for (var i=0; i< document.forms[formulario].elements.length; i++)  {
			var e= document.forms[formulario].elements[i];
			if ( e.name.substr(0,12) == "eval_codigo_" )  {
				e.value = eval_codigo;
				CambioComboEval(docu,"cambio_"+e.name);
			}
		}
		return true;
	}
	</script>
<?php
//----------------------------------------------------------------------------
	$ok = true;

	if (isset($_POST['boton_confirma'])) {

		// Validación 
		$oComisionPersona =	new cComisionPersona($conexion);
		$ok_actualiza = true;
		foreach($_POST as $clave=>$valor) {
		
			if (substr($clave,0, 12) =="eval_codigo_") {
			
				$pers_codigo = substr($clave,12);
				
				if (isset($_POST['cambio_eval_codigo_'.$pers_codigo]) && $_POST['cambio_eval_codigo_'.$pers_codigo]==1)  {

					$datos_evaluacion = array(	'comi_codigo'=>$comi_codigo,
												'pers_codigo'=>$pers_codigo,
												'eval_codigo'=>$valor
					);
					
					$conexion->ManejoTransacciones("B");
					if ($oComisionPersona->ModifDatosComisionVolcarResultados($datos_evaluacion)) {
						FuncionesPHPLocal::RegistrarAcceso($conexion,"50404","pers_codigo=".$datos_evaluacion['pers_codigo']." - comi_codigo=".$comi_codigo." - eval_codigo=".$datos_evaluacion['eval_codigo'],$_SESSION['usuariocod']);
						$conexion->ManejoTransacciones("C");
					} else {
						$conexion->ManejoTransacciones("R");
						$ok_actualiza = false;
					}

				}	// cambio la evaluacion
			} // es un combo de evaluacion
			
		} // for each 

		// solo se muestra el mensaje de OK, porque el error lo informa ModifDatosComisionVolcarResultados
		if ($ok_actualiza) 
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Se han actualizado los datos de Evaluación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	
	}
	$limite_filtro = 200;
	if (!isset($_POST['buscado']) && !isset($_GET['pagina']) ) {
		$_SESSION['array_busqueda_tabla']['valor_buscado']="";
		$_SESSION['array_busqueda_tabla']['filtro_desde']=1;
		$_SESSION['array_busqueda_tabla']['filtro_hasta']=$limite_filtro;
	} 

	if (isset($_POST['buscado'])) {
		$_SESSION['array_busqueda_tabla']['valor_buscado']=$_POST['buscado'];
		$_SESSION['array_busqueda_tabla']['filtro_desde']=($_POST['filtro_desde']>0)?$_POST['filtro_desde']:1;
		$_SESSION['array_busqueda_tabla']['filtro_hasta']=($_POST['filtro_hasta']>0)?$_POST['filtro_hasta']:$limite_filtro;
	}


	if (!$this->TraerDatosComision($comi_codigo,$filacomision,$es_modif)) {
		$txt_sys_mail="\nvalor_buscado_".$comi_codigo."\nerror=".$errormail;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		$ok = false;
	}
	
	

	if ($ok) {
		$ArregloDatos= array();
		$ArregloDatos['ppers_apellido'] = $_SESSION['array_busqueda_tabla']['valor_buscado'];
		$ArregloDatos['pfiltro_desde'] = $_SESSION['array_busqueda_tabla']['filtro_desde']-1;
		$ArregloDatos['pfiltro_hasta'] = $_SESSION['array_busqueda_tabla']['filtro_hasta']-$_SESSION['array_busqueda_tabla']['filtro_desde']+1;
		$ArregloDatos['porderby'] = "pers_apellido, pers_nombre";
		$ArregloDatos['pcomi_codigo'] = $comi_codigo;
			
		if (!$this->BuscarComisionInscriptosFiltro($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\nvalor_buscado_".$comi_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			$ok = false;			
		}			
	}		
		
	if ($ok) {
?>

