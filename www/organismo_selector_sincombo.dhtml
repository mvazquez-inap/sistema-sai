                </div>
            <?php
                $margen++;
            }
        
            ?>
            <br>
            
            <table width="95%" class="textotabla" border="1" cellpadding="2" cellspacing="2" align="center">
            <?php
                if(!$jurisdicciones->SubArbolDependiente($jurisdid_inicio,1,array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$array_jurisd,array(),$NumFilas,$CodError))
                {
                    FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"No se pudieron obtener los organismos dependientes de '".$jurisdid_inicio."'. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TABLA,"cantcols"=>2));
                    die();
                }
                //elimino el primer elemento, manteniendo las claves
                unset($array_jurisd[key($array_jurisd)]);
            
                foreach($array_jurisd as $jurisdid=>$datos_jurisd)	{
            ?>
                <tr>
                    <td width="90%" class="textoEtiquetaDato">
                        <?php echo htmlspecialchars($datos_jurisd["jurisdnom"],ENT_QUOTES) ?>
                    </td>
                    <td width="5%">
            <?php
                    if(count($datos_jurisd["IDHijos"])>0) {
                        $querystring = "";
                        $querystring.="inicio=".$jurisdid;
                        $querystring.="&amp;tipoorg_codigo=".$_GET['tipoorg_codigo'];	
                        $querystring.="&amp;destino=".$_GET['destino'];		
                        $querystring.="&amp;texto=".$_GET['texto'];		
                        
                        if (isset($_GET['tipo_seleccionado'])) {
                            $querystring.="&amp;tipo_seleccionado=".$_GET['tipo_seleccionado'];	
                            $querystring.="&amp;tipo_organismo=".$_GET['tipo_organismo'];										
                        }												
            ?>
                        <a href="<?php echo $_SERVER['PHP_SELF']."?".$querystring ?>" title="Ver Dependencias"><img src="images/bajar.png" border="0" alt="Ver Dependencias" align="middle"></a>
         <?php		
                    }
            ?>		
                    </td>
                    <td width="5%">
                        <a href="javascript:void(0)" onClick="addValorPopupTipo(window.opener.document,'<?php echo $_GET['destino']?>','<?php echo $jurisdid ?>','<?php echo htmlspecialchars($datos_jurisd["jurisdnom"],ENT_QUOTES);?>','tipoorg_codigo','<?php echo ORGANISMO_APN ?>','<?php echo $_GET['texto']?>');window.close();" title="Seleccionar"> <img src="images/activar.jpg" alt="Seleccionar" border="0"></a>
                    </td>
                </tr>
            
            <?php	}	// foreach ?>	
            
            </table>
<?php

        } //if (isset($_POST['bot_buscar'])) 

    } else { 	//	($_GET['tipoorg_codigo'] != "ORGANISMO_APN") 
    
        if (($_GET['tipoorg_codigo'] == ORGANISMO_NO_APN)) {
            $spnombre = "sel_organismo_publico_xestado_orden";
            $spparam = array("porgapub_estado"=>ESTADOACTIVO, "porderby"=>"orgapub_nombre");
                        
            $nombrelista="org_codigo";			
            $onClick="addValorPopupTipo(window.opener.document,\"jurisdid\",".$nombrelista.".options[".$nombrelista.".selectedIndex].value,"
                      .$nombrelista.".options[".$nombrelista.".selectedIndex].text,\"tipoorg_codigo\","
                      .ORGANISMO_NO_APN.",\"".$_GET['texto']."\");window.close();";
                      
            Armar_Lista_Buscador($conexion, $spnombre, $spparam, "formulario", "org_codigo","orgapub_codigo", "orgapub_nombre", "","Ingrese el organismo o parte de su nombre",$regactual,12,"", "width:600px",false,$onClick);
        }
        
    } // if ($_GET['tipoorg_codigo'] == "ORGANISMO_APN")?>
</form>
