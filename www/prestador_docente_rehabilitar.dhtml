									<input type="text" size="11" maxlength="11" name="presdoc_cuilt" class="inputReadonly" readonly="true" value="<?php echo ($es_modif) ? htmlspecialchars($filaprestador['presdoc_cuilt'],ENT_QUOTES):""; ?>" />						
								</td>
							</tr>
					<?php } ?>					
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Apellido</td>
						<td class="textoEtiquetaDatoResaltado"><input type="text" name="presdoc_apellido" id="presdoc_apellido" size="31" maxlength="30" class="inputReadonly" readonly="true" value="<?php echo ($es_modif) ? htmlspecialchars($filaprestador['presdoc_apellido'],ENT_QUOTES):""; ?>"></td>
