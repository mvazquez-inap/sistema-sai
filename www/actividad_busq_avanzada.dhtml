				}
			break;
			
			case "si":
				if(!$oActividadAutodesarrollo->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultActAuto,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar 4.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$result = false;			
				}
			break;
			
			case "todo":
				if(!$oActividadAutodesarrollo->BuscarActividadAutodesarrolloSinDictamen($ArregloDatos,$numfilas,$resultActAuto,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar 3.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$result = false;			
				}
				if(!$oActividadAutodesarrollo->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultActAuto2,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar 4.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$result = false;			
				}				
			break;
		}
	
		if(!$result) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar actividades. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;											
		} else {
			while ($filaActAuto = mysqli_fetch_assoc($resultActAuto)) {
			
				if (in_array($filaActAuto['act_codinap'],$act_codinap)) {
					$clave = array_search ($filaActAuto['act_codinap'],$act_codinap);
					$arrayAct[$clave]['Auto'] = 'si';
			 	} else {		
					$actauto_creditos = "---";		
					switch ($filaActAuto['tipoact_codigo']) {
						case TIPOACTAUTOEVASIS : 
							if (!$oActividadAutodesarrollo->TraerDatosActividadAutodesarrolloEvento($filaActAuto['act_codigo'],$filaautodesarrollo,$es_modif)) {
								$ok=false;		
							}	
							$actauto_creditos = $filaautodesarrollo['actividad_autodesarrollo_evento']['actautoeven_creditos_asistencia'];
						break;
	
						case TIPOACTAUTOEVACT : 
						case TIPOACTAUTODOCENTE : 
						case TIPOACTAUTOPUBLI : 
						case TIPOACTAUTOASISTEC : 
						case TIPOACTAUTOAAUTOFORM : 
							$actauto_creditos = "por persona";		
						break;
						
					}
					$arrayAct[] = array("act_codinap"=>$filaActAuto['act_codinap'],"act_nombre"=>$filaActAuto['act_nombre'],"act_codigo" => $filaActAuto['act_codigo'],"tipoact_codigo"=>$filaActAuto['tipoact_codigo'],"formact_codigo"=>FORMATOAUTO,"actcur_creditos"=>"---","actauto_creditos"=>$actauto_creditos,"actext_creditos"=>"---","actform_creditos"=>"---","dic_codigo"=>(isset($filaActAuto['dic_codigo']))?$filaActAuto['dic_codigo']:"","Curso"=>"no","Auto"=>"si","Ext"=>"no","Formal"=>"no","fecha_desde_hasta"=>"---");
				}	
			}
			
			if ($_SESSION['array_busqueda_actividad']['con_dictamen'] == "todo"){	
			
				while ($filaActAuto = mysqli_fetch_assoc($resultActAuto2)) {
				
					if (in_array($filaActAuto['act_codinap'],$act_codinap)) {
						$clave = array_search ($filaActAuto['act_codinap'],$act_codinap);
						$arrayAct[$clave]['Auto'] = 'si';
				 	} else {		
						$actauto_creditos = "---";		
						switch ($filaActAuto['tipoact_codigo']) {
							case TIPOACTAUTOEVASIS : 
								if (!$oActividadAutodesarrollo->TraerDatosActividadAutodesarrolloEvento($filaActAuto['act_codigo'],$filaautodesarrollo,$es_modif)) {
									$ok=false;		
								}	
								$actauto_creditos = $filaautodesarrollo['actividad_autodesarrollo_evento']['actautoeven_creditos_asistencia'];
							break;
		
							case TIPOACTAUTOEVACT : 
							case TIPOACTAUTODOCENTE : 
							case TIPOACTAUTOPUBLI : 
							case TIPOACTAUTOASISTEC : 
							case TIPOACTAUTOAAUTOFORM : 
								$actauto_creditos = "por persona";		
							break;
							
						}
						$arrayAct[] = array("act_codinap"=>$filaActAuto['act_codinap'],"act_nombre"=>$filaActAuto['act_nombre'],"act_codigo" => $filaActAuto['act_codigo'],"tipoact_codigo"=>$filaActAuto['tipoact_codigo'],"formact_codigo"=>FORMATOAUTO,"actcur_creditos"=>"---","actauto_creditos"=>$actauto_creditos,"actext_creditos"=>"---","dic_codigo"=>(isset($filaActAuto['dic_codigo']))?$filaActAuto['dic_codigo']:"","Curso"=>"no","Auto"=>"si","Ext"=>"no","fecha_desde_hasta"=>"---");
					}	
				}
			}
		}
	}
	
	$act_codinap = array();
	foreach ($arrayAct as $llave => $fila) {
	   $act_codinap[$llave]  = $fila['act_codinap'];
	}

	if ($arregloBuscar['buscaExt']) {
	
		switch ($_SESSION['array_busqueda_actividad']['con_dictamen']){
			
			case "no":
				if(!$oActividadExterna->BuscarActividadExternaSinDictamen($ArregloDatos,$numfilas,$resultActExt,$error,$errormail)){
