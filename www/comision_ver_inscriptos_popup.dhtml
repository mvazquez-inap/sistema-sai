<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
$oPersonas = new cPersonas($conexion);
$oComision= new cComision($conexion);

//----------------------------------------------------------------------------------------- 
	function MostrarGrillaSeleccion($oComision,$comi_codigo) {

		$ArregloDatos= array();
		$ArregloDatos['ppers_apellido'] = "";		
		$ArregloDatos['porderby'] = "pers_apellido, pers_nombre";
		$ArregloDatos['pcomi_codigo'] = $comi_codigo;
			
		if (!$oComision->BuscarComisionInscriptos($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\nvalor_buscado_".$comi_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		}			
		
		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"NombrePaginaQuery"=>"pagina",
			"FilasPagina"=>15
		);
		
		if (isset($_GET['pagina']))	{
			$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
			$opciones['QueryString']=$querystring;
		}
		
		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla("Personas Inscriptas en la Comisión. "."\n\n"."TOTAL INSCRIPTOS:   ".$numfilas);	
		$oGrilla->SetearAnchoGrilla('90%');
		

		$miColumna3 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Apellido');
		$oGrilla->Setear('campo_grilla',$miColumna3,'pers_apellido');
		$oGrilla->Setear('align_columna',$miColumna3,'left');

		$miColumna2 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Nombre');
		$oGrilla->Setear('campo_grilla',$miColumna2,'pers_nombre');
		$oGrilla->Setear('align_columna',$miColumna2,'left');

		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'CUIT/CUIL');
		$oGrilla->Setear('campo_grilla',$miColumna1,'pers_cuilt');
		$oGrilla->Setear('align_columna',$miColumna1,'left');


		$miColumna4 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna4,'Evaluación');
		$oGrilla->Setear('campo_grilla',$miColumna4,'eval_descripcion');
		$oGrilla->Setear('align_columna',$miColumna4,'left');

		$miColumna5 = $oGrilla->AddColumna('popup');
		$oGrilla->Setear('ancho_columna',$miColumna5,'60');
		$oGrilla->Setear('imagen',$miColumna5,'images/verdetalle.gif');
		$oGrilla->Setear('altImagen',$miColumna5,'Ver detalle Dictamen');		
		$oGrilla->Setear('titulo_columna',$miColumna5,'Detalle');
		$oGrilla->Setear('url',$miColumna5,'actividad_persona_ver_detalle.dhtml');
		$oGrilla->Setear('ventanaAnchoPopup',$miColumna5,'650');
		$oGrilla->Setear('ventanaAltoPopup',$miColumna5,'450');
		$oGrilla->Setear('ventanaVarxPopup',$miColumna5,'130');
		$oGrilla->Setear('ventanaVaryPopup',$miColumna5,'50');
		$oGrilla->AddParametrosURL($miColumna5,"pers_codigo",'pers_codigo');
		$oGrilla->AddParametrosURL($miColumna5,"comi_codigo",'comi_codigo');
		$oGrilla->AddParametrosURL($miColumna5,"act_codigo",'act_codigo');		
		$oGrilla->AddParametrosURL($miColumna5,"tipoact_codigo",'tipoact_codigo');
		$oGrilla->AddParametrosURL($miColumna5,"actprog_sec",'actprog_sec');
		$oGrilla->AddParametrosURL($miColumna5,"formact_codigo",FORMATOCURSO,"cte");


		if (!$oGrilla->CargarGrilla($result))
			return false;
			
		$oGrilla->MostrarGrilla();

		return true;
	} 		



?>
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 TRANSITIONAL//EN"> 
<html>
<head>
<title>Ventana de Detalles &nbsp;</title>
<link rel="stylesheet" type="text/css" href="estilos.css">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
</head>
<body>
<script language="javascript" src="<?php echo DIR_JSComunes ?>funcionesjs.js" type="text/javascript"></script>
<br>
<?php
$ok=false;

	if ($_GET['comi_codigo']=="") {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	} else {
		if ($oComision->TraerDatosComision($_GET['comi_codigo'],$filacomision,$es_modif)) {
			if (!$es_modif) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else { 
					$ok=true;
			} 
				
		}	// Se encontró la comisión	
	} // No se produjo error al buscar la comisión

	if ($ok) {
		if (!MostrarGrillaSeleccion($oComision,$_GET['comi_codigo']))
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar datos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	}
			
?>
<br><br><div align="center"><a href="javascript:window.close()" class="linkFondoBlanco">Volver</a></div>
</body>
</html>