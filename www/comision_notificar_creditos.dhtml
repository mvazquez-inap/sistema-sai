					<a href='javascript:void(0)' onClick="Popup('persona_busq_basica.dhtml?formulario=formulario_filtros&amp;destino=pers_cuilt&amp;estado=&amp;volver=1&amp;submit=0&amp;accion=Todos','ventana_descripciones',630,360,screen.availWidth-650,screen.availHeight-420,'yes');"><img src="images/searchsai.jpg" alt="Buscar" border="0" style="vertical-align:-5px"></a>
