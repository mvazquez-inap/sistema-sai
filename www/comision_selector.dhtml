					$estado_leyenda = "NUEVA o ABIERTA o CERRADA o CERTIFICADA";
				break; 
				
				case "Actualizar Jurisdiccional":				
					$ArregloDatos['comi_estado']  = COMISIONABIERTA.",".COMISIONNUEVA.",".COMISIONCERRADA.",".COMISIONCERTIFICADA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "NUEVA o ABIERTA o CERRADA o CERTIFICADA";
				break; 				
				
				case "Inscribir":				
					$ArregloDatos['comi_estado']  = COMISIONABIERTA.",".COMISIONNUEVA.",".COMISIONCERRADA.",".COMISIONCERTIFICADA;					
					//$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP.",".TIPOACTCURSOJURISD;		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "NUEVA o ABIERTA o CERRADA o CERTIFICADA";
				break; 
				
				case "Rectificar Resultados":				
					$ArregloDatos['comi_estado']  = COMISIONABIERTA.",".COMISIONNUEVA.",".COMISIONCERRADA.",".COMISIONCERTIFICADA;					
					//$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP.",".TIPOACTCURSOJURISD;		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "NUEVA o ABIERTA o CERRADA o CERTIFICADA";
				break; 
				
				
			}		
			break; 


		
		case USUORGANISMO: 
		case COORDINADORTECNICO: 

			switch ($_SESSION['array_busqueda_basica_comision']['accion']) {						

				case "Actualizar":				
					$estado_leyenda = "NUEVA o ABIERTA";
					$ArregloDatos['comi_estado']  = COMISIONABIERTA.",".COMISIONNUEVA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc ,c.comi_codinap";						
					$estado_leyenda = "NUEVA o ABIERTA";
				break;

				case "Cerrar":				
					$ArregloDatos['comi_estado'] = COMISIONABIERTA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "ABIERTA";
				break; 

				case "Certificar":				
					$ArregloDatos['comi_estado'] = COMISIONCERRADA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "CERRADA";
				break; 
	
				case "Inscribir":				
					$ArregloDatos['comi_estado']  = COMISIONABIERTA.",".COMISIONNUEVA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc ,c.comi_codinap";						
					$estado_leyenda = "NUEVA o ABIERTA";
				break;

				case "Rectificar":				
					$ArregloDatos['comi_estado']=COMISIONCERRADA;				
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc ,c.comi_codinap";						
					$estado_leyenda = "CERRADA";
				break;

				case "Volcar Resultados":	
					$ArregloDatos['comi_estado']  = COMISIONABIERTA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "ABIERTA";
				break; 

				case "Emitir Acta":		
					$ArregloDatos['comi_estado']  = COMISIONABIERTA.",".COMISIONNUEVA.",".COMISIONCERRADA.",".COMISIONCERTIFICADA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "NUEVA, ABIERTA, CERRADA o CERTIFICADA";
				break; 

				case "Rectificar Resultados":				
					$ArregloDatos['comi_estado']=COMISIONCERRADA;				
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc ,c.comi_codinap";						
					$estado_leyenda = "CERRADA";
				break;

				case "Notificar Creditos":				
					$ArregloDatos['comi_estado']=COMISIONCERTIFICADA;				
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc ,c.comi_codinap";						
					$estado_leyenda = "CERTIFICADA";
				break;

				case "Candidato":				
					$ArregloDatos['comi_estado']  = COMISIONABIERTA.",".COMISIONNUEVA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP;		
					$ArregloDatos['comi_web'] = "S";		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "NUEVA, ABIERTA";
				break; 
				
			} 
			break; 
	}	
	
	$oComision = new cComision($conexion);
	if(!$oComision->BuscarComisionAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;	
	}	

	if ($numfilas >=LIMITE_BUSQUEDA_CHICO) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda retornó demasiadas filas, ajuste el criterio de búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}
	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda no retornó resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}

	$array_result = array();
	while ($fila_result = mysqli_fetch_array($result)) {
		
		$fila_result['actprog_fecha_desde_hasta'] = $fila_result['actprog_fecha_inicio_ddmmaaaa']."\na\n".$fila_result['actprog_fecha_fin_ddmmaaaa'];
			// FuncionesPHPLocal::ConvertirFecha($fila_result['actprog_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa')."\na\n".
			// FuncionesPHPLocal::ConvertirFecha($fila_result['actprog_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa');
				
		if (isset($fila_result['comi_fecha_inicio']))
			$fila_result['comi_fecha_desde_hasta'] = $fila_result['comi_fecha_inicio_ddmmaaaa']."\na\n".$fila_result['comi_fecha_fin_ddmmaaaa'];
			//	FuncionesPHPLocal::ConvertirFecha($fila_result['comi_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa')."\na\n".
			//	FuncionesPHPLocal::ConvertirFecha($fila_result['comi_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa');
		else
			$fila_result['comi_fecha_desde_hasta'] = "Indefinido";

		$array_result[]=$fila_result;
		$fila_result=array();
	}

	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FormularioBotonera"=>"formulario_boton_2",				
		"FilasPagina"=>10
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}

	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Código INAP');
	$oGrilla->Setear('campo_grilla',$miColumna1,'comi_codinap');
	$oGrilla->Setear('align_columna',$miColumna1,'left');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Actividad Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna2,'act_nombre');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna31 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna31,'Vigencia');
	$oGrilla->Setear('ancho_columna',$miColumna31,'80');
	$oGrilla->Setear('campo_grilla',$miColumna31,'actprog_fecha_desde_hasta');
	$oGrilla->Setear('align_columna',$miColumna31,'center');

	$miColumna32 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna32,'Realización');
	$oGrilla->Setear('ancho_columna',$miColumna32,'80');
	$oGrilla->Setear('campo_grilla',$miColumna32,'comi_fecha_desde_hasta');
	$oGrilla->Setear('align_columna',$miColumna32,'center');
	
	// Agregado 
	$miColumna33 = $oGrilla->AddColumna('popup');
	$oGrilla->Setear('ancho_columna',$miColumna33,'60');
	$oGrilla->Setear('imagen',$miColumna33,'images/verdetalle.gif');
	$oGrilla->Setear('altImagen',$miColumna33,'Ver detalle comisión');		
	$oGrilla->Setear('titulo_columna',$miColumna33,'Detalle');
	$oGrilla->Setear('url',$miColumna33,'comision_ver_detalle_popup.dhtml');
	$oGrilla->Setear('ventanaNombre',$miColumna33,'ventana_detalle_comision');
	$oGrilla->Setear('ventanaAnchoPopup',$miColumna33,'680');
	$oGrilla->Setear('ventanaAltoPopup',$miColumna33,'500');
	$oGrilla->Setear('ventanaVarxPopup',$miColumna33,'120');
	$oGrilla->Setear('ventanaVaryPopup',$miColumna33,'50');
	$oGrilla->AddParametrosURL($miColumna33,"comi_codigo",'comi_codigo');

	$miColumna4 = $oGrilla->AddColumna('addValor');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Seleccionar');
	$oGrilla->Setear('imagen',$miColumna4,'images/seleccionar.jpg');
	$oGrilla->Setear('altImagen',$miColumna4,'Seleccionar');

	$oGrilla->Setear('idtextboxAddValor',$miColumna4,$_SESSION['array_busqueda_basica_comision']['destino']);

	if (!$_SESSION['array_busqueda_basica_comision']['submit']) {
		$oGrilla->Setear('submitAddValor',$miColumna4,'no');
		$oGrilla->Setear('documentAddValor',$miColumna4,'window.opener.document');
		$oGrilla->Setear('nombreContenidoAddValor',$miColumna4,'comi_codinap');
		$oGrilla->Setear('idtextoContenidoAddValor',$miColumna4,'comi_codinap');
	} else {
		$oGrilla->Setear('submitAddValor',$miColumna4,'si');
		$oGrilla->Setear('nombreFormularioSubmitAddValor',$miColumna4,$_SESSION['array_busqueda_basica_comision']['formulario']);
	}

	$oGrilla->AddParametrosAddValor($miColumna4,'comi_codinap');
	$oGrilla->Setear('ancho_columna',$miColumna4,'20%');

	if (!$oGrilla->CargarGrilla($array_result))
		return false;
		
	$oGrilla->MostrarGrilla();
} 		
