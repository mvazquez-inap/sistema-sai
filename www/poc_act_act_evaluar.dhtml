<script language="javascript"  type="text/javascript">
function ConfirmaEvaluacion(formulario, operacion) {           																												

	if (operacion=="A") 
		var msg='¿Está seguro que desea confirmar la carga?';
	else 
		var msg='¿Está seguro que desea rectificar la carga?';

	if (confirm(msg)) {
		formulario.operacion.value = operacion;
		return true
	}

	return false;
}
</script>
<?php 
//--------------------------------------------------------------------------------------------------------------------------------
function MostrarGrillaActDisActPoc($conexion,$ArregloDatos,&$numfilas_pendientes) {

	$oPocActividadActividad = new cPocActividadActividad($conexion);				
	$filtro = array('act_codigo'=>$ArregloDatos['act_codigo'],
					'poc_codigo'=>$ArregloDatos['poc_codigo'],					
					'pocactact_estado'=>POCACTIVIDADACTIVIDADPEDAPROB,				
					'orderby'=>'pocact_nombre_tentativo',
					);
	
	if (!$oPocActividadActividad->BuscarPocActividadActividad($filtro,$numfilas_pendientes,$result_act_asignadas,$error,$errormail)) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
		return false;
	}
	
	$actividades_asignadas = array();
	$resultado = array();
	
	while ($fila_act = mysqli_fetch_assoc($result_act_asignadas)) {
		$conexion->TraerCampo("constantes_grales","constantedesc",
									array("constantetipo='","POCACTIVIDADACTIVIDADESTADO","' and constantecod='",$fila_act['pocactact_estado'],"'"),
									$pocactact_estado_desc,$numfilas,$errorcod); 

		$resultado[] = array('pocact_codigo'=> $fila_act['pocact_codigo'],		
		  					 'pocact_nombre_tentativo'=> $fila_act['pocact_nombre_tentativo'],
							 'pocactact_estado'=> $fila_act['pocactact_estado'],
							 'pocactact_estado_desc'=> $pocactact_estado_desc,
 							 'poc_codigo'=> $fila_act['poc_codigo'],
							 );	
							 
		$actividades_asignadas[] = $fila_act['pocact_codigo'];
	}
	
	// Actividad_poc APROBADA
	$oPocActividad= new cPocActividad($conexion);
	
	$filtro = array('poc_codigo'=>$ArregloDatos['poc_codigo'],'pocact_estado'=>POCACTIVIDADAPROBADA);
	if(!$oPocActividad->BuscarPocActividad($filtro,$numfilas,$resultado_pocact,$error,$errormail)) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar las actividades del POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error la actividad poc no se encuentra confirmada.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	} 
	
	while ($fila_act_poc  = mysqli_fetch_assoc($resultado_pocact)) {
		$actividades_poc[] = $fila_act_poc;
	}
	
	if (count($resultado) == 0 ) {
		$mensaje_sin_datos = "No se encontraron asociaciones factibles de confirmación / rectificación <br> de Carga entre la Actividad Curso y las Actividad POC";		
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$mensaje_sin_datos,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}

	if (count($resultado) >0 ) {

		$opciones=array(
			"FilasPagina"=>count($resultado),
		);
		
		$operacion = "E";
		$titulo_grilla = "Actividades POC asociadas a la Actividad Curso pendientes de Confirmación de Carga";

		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla($titulo_grilla);
		$oGrilla->SetearAnchoGrilla('90%');
		
		$miColumna2 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Nombre');
		$oGrilla->Setear('campo_grilla',$miColumna2,'pocact_nombre_tentativo');
		$oGrilla->Setear('align_columna',$miColumna2,'left');

		$miColumna3 = $oGrilla->AddColumna('popup');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Detalle');
		$oGrilla->Setear('ancho_columna',$miColumna3,'55');
		$oGrilla->Setear('imagen',$miColumna3,'images/verdetalle.gif');
		$oGrilla->Setear('altImagen',$miColumna3,'Ver Detalle Actividad POC');
		$oGrilla->Setear('url',$miColumna3,'poc_actividad_ver_dis.dhtml');
		$oGrilla->Setear('ventanaAnchoPopup',$miColumna3,'680');
		$oGrilla->Setear('ventanaAltoPopup',$miColumna3,'500');
		$oGrilla->Setear('ventanaVarxPopup',$miColumna3,'120');
		$oGrilla->Setear('ventanaVaryPopup',$miColumna3,'50');
		$oGrilla->AddParametrosURL($miColumna3,"poc_codigo",$ArregloDatos['poc_codigo'],'cte');
		$oGrilla->AddParametrosURL($miColumna3,"pocact_codigo",'pocact_codigo');

		if (!$oGrilla->CargarGrilla($resultado))
			return false;
			
		$oGrilla->MostrarGrilla();
		echo "<br>";
	}
}
