			} else  //  Cualquier error es informado en AltaDisposicion
				$commit=false;

			break;	
			
		case 'M': 
			if ($oDisposicion->ModifDatosDisposicion($_POST)) {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"39703","dis_codigo=".$_POST['dis_codigo'],$_SESSION['usuariocod']);
