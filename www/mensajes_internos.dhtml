//--------------------------------------------------------------------------------------------------------------------------------
function esMensajeNuevo($array_fila_grilla) {
	if ( $array_fila_grilla['msg_estado'] == $array_fila_grilla['mensajenuevo'])  
		return true;
	else 
		return false;
}


//--------------------------------------------------------------------------------------------------------------------------------
function esMensajeLeido($array_fila_grilla) {
	if ( $array_fila_grilla['msg_estado'] == $array_fila_grilla['mensajeleido'])  
		return true;
	else 
		return false;
}




//-------------------------------------------------------------------------------------
function MostrarMensajes($conexion,$ArregloDatos) {

		$oMensajesInternos = new cMensajesInternos($conexion);
		if (!$oMensajesInternos ->BuscarMensajesInternos($ArregloDatos,$numfilas_msg,$result_msg,$error,$errormail))
		{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en la búsqueda de Mensajes internos. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if ($numfilas_msg ==0) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No hay mensajes internos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}


		$i=0;
		while ($fila_mensaje = mysqli_fetch_assoc($result_msg)) {
			$arrayresult[$i]['msg_estado'] = $fila_mensaje['msg_estado'];
			$arrayresult[$i]['msg_fecha'] = date("d/m/Y H:i",strtotime($fila_mensaje['msg_fecha']));
			$arrayresult[$i]['msg_asunto'] = $fila_mensaje['msg_asunto'];			
			$arrayresult[$i]['msg_codigo'] = $fila_mensaje['msg_codigo'];					
			$arrayresult[$i]['mensajenuevo'] = $oMensajesInternos->MENSAJENUEVO;								
			$arrayresult[$i]['mensajeleido'] = $oMensajesInternos->MENSAJELEIDO;				
			
			$i++;
		}
		
		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"NombrePaginaQuery"=>"pagina",
			"FilasPagina"=>TAMANO_PAGINA_30
		);
		
		if (isset($_GET['pagina']))	{
			$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
			$opciones['QueryString']=$querystring;
		}

		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearAnchoGrilla('90%');

		$miColumna1 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('condicion_visualizar_columna',$miColumna1,'esMensajeNuevo');
		$oGrilla->Setear('ancho_columna',$miColumna1,'60');
		$oGrilla->Setear('imagen',$miColumna1,'images/email_nuevo.gif');
		$oGrilla->Setear('altImagen',$miColumna1,'Ver detalle');		
		$oGrilla->Setear('titulo_columna',$miColumna1,'Nuevo');
		$oGrilla->Setear('onClick_function',$miColumna1,'abrirMensaje');
		$oGrilla->Setear('url',$miColumna1,'javascript:void(0)');
		$oGrilla->AddParametrosURL($miColumna1,"msg_codigo",'msg_codigo');
		$oGrilla->SetId($miColumna1,'sobre_','msg_codigo');

		$miColumna2 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Fecha');
		$oGrilla->Setear('campo_grilla',$miColumna2,'msg_fecha');
		$oGrilla->Setear('align_columna',$miColumna2,'left');
		
		$miColumna3 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Asunto');
		$oGrilla->Setear('campo_grilla',$miColumna3,'msg_asunto');
		$oGrilla->Setear('align_columna',$miColumna3,'left');
		

		$miColumna4 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('condicion_visualizar_columna',$miColumna4,'esMensajeLeido');
		$oGrilla->Setear('ancho_columna',$miColumna4,'60');
		$oGrilla->Setear('imagen',$miColumna4,'images/verdetalle.gif');
		$oGrilla->Setear('altImagen',$miColumna4,'Ver detalle');		
		$oGrilla->Setear('titulo_columna',$miColumna4,'Detalle');
		$oGrilla->Setear('onClick_function',$miColumna4,'abrirMensaje');
		$oGrilla->Setear('url',$miColumna4,'javascript:void(0)');
		$oGrilla->AddParametrosOnClick($miColumna4,"msg_codigo",'var');
		$oGrilla->SetId($miColumna4,'lupa_','msg_codigo');
		

		$miColumna5 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna5,'Eliminar');
		$oGrilla->Setear('ancho_columna',$miColumna5,'60');
		$oGrilla->Setear('url',$miColumna5,"mensajes_internos.dhtml");
		$oGrilla->Setear('imagen',$miColumna5,'images/borrar.jpg');
		$oGrilla->Setear('altImagen',$miColumna5,'Eliminar');
		$oGrilla->AddParametrosURL($miColumna5,"msg_codigo","msg_codigo");
		$oGrilla->AddParametrosURL($miColumna5,"operacion","B","cte");
	
		if (!$oGrilla->CargarGrilla($arrayresult)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al mostrar mensajes. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		
			return false;
		}

		$oGrilla->MostrarGrilla();

		return true;
}

	if (isset($_POST['boton_filtrar'])) {
	
		$ok=true;	
	
		$_SESSION['filtro_busqueda']=array();
		$_SESSION['filtro_busqueda']['msg_nivel_mensaje']=trim($_POST['msg_nivel_mensaje']);
		$_SESSION['filtro_busqueda']['msg_archivo_ejec']=trim($_POST['msg_archivo_ejec']);
		$_SESSION['filtro_busqueda']['msg_funcion']=trim($_POST['msg_funcion']);
		$_SESSION['filtro_busqueda']['msg_usuariocod_origen']=trim($_POST['msg_usuariocod_origen']);

		
		$_SESSION['filtro_busqueda']['msg_ip_origen']=trim($_POST['msg_ip_origen']);
		
		if ($_SESSION['rolcod'] == ADMIONTI) 
			$_SESSION['filtro_busqueda']['msg_tipo_origen']=$oMensajesInternos ->MENSAJE_TIPO_ORIGEN_SISTEMA;
		else 
			$_SESSION['filtro_busqueda']['msg_tipo_origen']=$oMensajesInternos ->MENSAJE_TIPO_ORIGEN_USUARIO;
	
		$_SESSION['filtro_busqueda']['msg_usuariocod_destino']=$_SESSION['usuariocod'];

		// se es DESARROLLO busca todos los mensajes
		if (RUN_ACTUAL == RUN_DESARROLLO) {
			$_SESSION['filtro_busqueda']['msg_usuariocod_destino']="";
			$_SESSION['filtro_busqueda']['msg_tipo_origen'] = "";
		}	


	
		if (isset($_POST['msg_fecha_inicio'])) 
			$_SESSION['filtro_busqueda']['msg_fecha_inicio']=FuncionesPHPLocal::ConvertirFecha($_POST['msg_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd');
			
		if (isset($_POST['comi_fecha_fin'])) 
			$_SESSION['filtro_busqueda']['msg_fecha_fin']=FuncionesPHPLocal::ConvertirFecha($_POST['msg_fecha_fin'],'dd/mm/aaaa','aaaa-mm-dd');
		
		$_SESSION['filtro_busqueda']['orderby']="msg_fecha DESC";
	}	

	if (isset($_POST['boton_filtrar']) || isset($_GET['pagina']) ) {  ?>

        <table width="100%" class="textoTablaDato" align="center">
            <tr align="center">
                <td valign="top">
                <?php  MostrarMensajes($conexion,$_SESSION['filtro_busqueda']); ?>
                </td>
            </tr>
        </table>
        <br />
        <div align="center"><a href="mensajes_internos.dhtml" class="linkFondoBlanco">Volver a Buscar</a></div>
        <br />
        <?php   
	

	} else { 
	
			if (isset($_GET['operacion'])) {
			switch ($_GET['operacion']) {		
			case "B" :
					$leyenda_operacion = "Eliminar";		
					$boton_operacion = "Eliminar";		
					$operacion = "B";				
					break;
			default:
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error de operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$result=false;
			}

			$ok = true;
			$ArregloDatos = array();
			$ArregloDatos['msg_codigo'] = $_GET['msg_codigo'];
	
			if (!$oMensajesInternos ->BuscarMensajesInternos($ArregloDatos,$numfilas_msg,$result_msg,$error,$errormail))
			{
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en la búsqueda de Mensajes internos. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
				

			}
			if (!$oMensajesInternos ->CambioEstado($_GET['msg_codigo'],$oMensajesInternos->MENSAJELEIDO,$error,$errormail))
			{
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al cambiar el estado del mensaje. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
			} 

			if ($ok && ($numfilas_msg ==1)) {
				$fila_mensaje = mysqli_fetch_assoc($result_msg);	
				
			?><p class="textonombreclave"> Ha seleccionado el siguiente mensaje para <?php echo $leyenda_operacion?></p>

				<form action="mensajes_internos_upd.dhtml" method="post" name="formulario">
