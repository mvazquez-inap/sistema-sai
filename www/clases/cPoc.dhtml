<?php
class cPoc
{
var $conexion;
	// Función para la conexión
	public function __construct($conexion)
	{
		$this->conexion = &$conexion;
	}	

//-----------------------------------------------------------------------------------------------------	
	function PocEstadoJurid($pocjuris,$estadosIN,&$spnombre,&$sparam)
	{
		$sparam=array('pxpoc_ano'=>0);
		$sparam+=array('pxpoc_codigo'=>0);
		$sparam+=array('pxjurisdid_inap'=>1);
		$sparam+=array('pxpoc_estado'=>1);
		
		$sparam+=array('ppoc_ano' =>"");
		$sparam+=array('ppoc_codigo' =>"");
		$sparam+=array('pjurisdid_inap' =>$pocjuris);
		$sparam+=array('ppoc_estado' =>$estadosIN);
		$sparam+=array('porderby' =>"poc_ano");
		$spnombre="sel_poc_xdatos";
	}
//-----------------------------------------------------------------------------------------------------	
	function AñosSP($pocjuris,&$spnombre,&$spparam)
	{
		$spnombre="sel_anos_validos";
		$spparam =array('porderby'=>"poc_ano",'ppoc_estado'=> POCNUEVO,'ppoc_estadodos'=> POCRECHAZADO,'pjurisdid_inap'=>$pocjuris);
	}
//-----------------------------------------------------------------------------------------------------	
	function PocEstados($pocjuris,&$spnombre,&$spparam)
	{
		$spnombre="sel_poc_xjurisdid_inap_xestado_nuevo_recha_aprob";
		$spparam =array('porderby'=>"poc_ano",'ppoc_estado'=> POCNUEVO,'ppoc_estadodos'=> POCRECHAZADO,'ppoc_estadotres'=> POCAPROBADO,'pjurisdid_inap'=>$pocjuris);
	}
//-----------------------------------------------------------------------------------------------------	
	function PocEstadosActEstados($pocjuris,&$spnombre,&$spparam)
	{
		$spnombre="sel_poc_xjurisdid_inap_xestadopoc_xestadoact";
		$spparam =array('porderby'=>"poc_ano",'ppoc_estado'=> POCPENDIENTEAPROBACION,'ppoc_estadodos'=> POCAPROBADO,'ppocact_estado'=> POCACTIVIDADPEDAPROB,'pjurisdid_inap'=>$pocjuris);
	}	
//-----------------------------------------------------------------------------------------------------	
	function Pocxcodigo($poc_codigo,$juris,&$numfilas)
	{
		$spnombre="sel_poc_xpoc_codigo_xestado_nuevo_recha_xjuris";
		$spparam =array('ppoc_codigo'=>$poc_codigo,'pjurisdid_inap'=>$juris,'ppoc_estado'=> POCNUEVO,'ppoc_estadodos'=> POCRECHAZADO);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\npoc_codigo='.$poc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el Poc. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function PocxcodigoConPedAprob($poc_codigo,$juris,&$numfilas)
	{
		$spnombre="sel_poc_xpoc_codigo_xestado_pendaprob_xjuris";
		$spparam =array('ppoc_codigo'=>$poc_codigo,'pjurisdid_inap'=>$juris,'ppoc_estado'=> POCPENDIENTEAPROBACION);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\npoc_codigo='.$poc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el Poc. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}
		return true;
	}

