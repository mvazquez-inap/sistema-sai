    <?php foreach ($this->result as $row): ?>
    <tr style="height:26px">
		<td align="right" class="textoEtiquetaDatoResaltado">
			<?php $this->_($row["usuarioCUIT"]); ?>
		</td>
		<td class="textoEtiquetaDatoResaltado"> 
			<?php $this->_($row["usuarionombrecompleto"]); ?>
		</td>
		<td class="textoEtiquetaDatoResaltado"> 
			<?php $this->_($row["usuarioestadodesc"]); ?>
		</td>		
		<td class="textoEtiquetaDatoResaltado">
			<?php $this->_($row["usuarioemail"]); ?>
		</td>
		<td align="center" class="textoEtiquetaDatoResaltado">
			<?php	if ($row["usuarioestado"] != USUARIOBAJA) { ?>
				<a href="usuario_actualizar_roles.dhtml?usuariocod=<?php echo $row["usuariocod"]; ?>"><img src="images/editar.jpg" border="0" alt="Actualizar Roles"></a> 
			<?php } ?>
		</td>
    </tr>

<?php	foreach ($row["usuarioroles"] as $row_rol):	 // va a ser uno solo 
		if ($row_rol ["rolcod"]==COORDINADORTECNICO ) {?>
			<tr style="height:26px;">
				<td></td>
				<td colspan="4">
				<table border="0">
							<tr>
							<td>Organismo:</td>
							<td><?php echo $row_rol["jurisdnom"] ?></td>
						</tr>
						<tr>
							<td>Dirección:</td>
							<td><?php echo $row_rol["usuroljur_domicilio"] ?></td>
						</tr>
						<tr>
							<td>Teléfono:</td>
							<td><?php echo $row_rol["usuroljur_telefono"] ?></td>
						</tr>	
						<tr>
							<td>Fax:</td>
							<td><?php echo $row_rol["usuroljur_fax"] ?></td>
						</tr>				
				</table>		
				</td>
			</tr>
		<?php } 	
		if ($row_rol ["rolcod"]==USUORGANISMO) {?>
			<tr style="height:26px;">
				<td></td>
				<td colspan="4">
				<table border="0">
							<tr>
							<td>Organismo:</td>
							<td><?php echo $row_rol["jurisdnom"] ?></td>
						</tr>
				</table>		
				</td>
			</tr>
		<?php } 
	endforeach; ?>			
<?php endforeach; ?>
</table>

<table width="95%" class="textoTablaDato" border="0" cellpadding="0" cellspacing="0" align="center">
	<tr>
		<td class='colorTitulosGrupo textoTituloGrupo'>
