<?php class cTablaSede extends cTablaSysDesc {

	public function __construct($conexion) {
		
		$array_campos=array('clave'=> 'sede_codigo',
							'estado'=>'sede_estado',
							'descripcion'=>array('nombre_campo'=>'sede_descripcion', 'long_campo'=>40 ,'titulo_campo'=>'Sede'),
							'fecha_alta'=>'sede_falta',
							'fecha_baja'=>'sede_fbaja');

		parent::__construct($conexion,"sede",$array_campos);
		$this->SetearTituloTabla('Sede de la comisión');
	
		// Array con los cógigos de operaciones a ser registradas
		$array_log=array('ins'=>'35201', 'upd'=>'35203', 'del'=>'35202','chg_estado'=>'35204');
		$this->SetearLogs($array_log);

		// Array con las tablas en las que se busca para determinar si la baja es física o lógica.
		$this->SetearTablasTipoBaja(array(array('nom_tabla'=>'comision','campo_tabla'=>'sede_codigo')));
	}		
} ?>