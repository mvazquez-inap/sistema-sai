//------------------------------------------------------------------------------------------------
function CargoFormato() {
	// Se carga el array de Formatos
	<?php 
		if(!$conexion->ejecutarStoredProcedure("sel_formato_actividad_orden",array('porderby'=>"formact_descripcion"),$resultado,$numfilas,$errno))	{
			$txt_sys_mail="Error al buscar el formato.";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar el Formato de Actividades.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$i=0;
		while ($fila_form = mysqli_fetch_assoc($resultado)){
				echo "vec_form[".$i."]=new Array('".$fila_form['formact_codigo']."','".htmlspecialchars($fila_form['formact_descripcion'],ENT_QUOTES)."');\n\t";			
			$i++;
		}
	?>
}
//------------------------------------------------------------------------------------------------
function CargoTipo() {
	// Se carga el array de Tipos
	<?php 	if(!$conexion->ejecutarStoredProcedure("sel_tipo_actividad_orden",array('porderby'=>"tipoact_descripcion"),$resultado,$numfilas,$errno))	{
			$txt_sys_mail="Error al buscar el formato.";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar el Formato de Actividades.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$i=0;
		while ($fila_tipo = mysqli_fetch_assoc($resultado)){
				echo "vec_tipo[".$i."]=new Array('".$fila_tipo['tipoact_codigo']."','".$fila_tipo['formact_codigo']."','".htmlspecialchars($fila_tipo['tipoact_descripcion'],ENT_QUOTES)."');\n\t";			
			$i++;
		}
	?>
}
//------------------------------------------------------------------------------------------------
function CambioFormato(formato,tipo)	{
	var ii;
	var ObjFormato = eval('document.getElementById("'+formato+'")');
	var ObjTipo = eval('document.getElementById("'+tipo+'")');

	while (ObjTipo.length > 0)
		ObjTipo[0] = null;
	
	var form = ObjFormato[ObjFormato.selectedIndex].value;
	ObjTipo.options[0] = new Option("-- Todos los Tipos", '*');

	for(ii = 0; ii < vec_tipo.length; ii++)
		if (vec_tipo[ii][1] == form)
			ObjTipo.options[ObjTipo.options.length] = new Option(vec_tipo[ii][2], vec_tipo[ii][0]);

	ObjTipo.options[0].selected=true	
}
//------------------------------------------------------------------------------------------------
</script>
