		// Determino si el agente existe, si se graban o no los datos laborales del último registro
		if(!$oAgentes->TraerDatosAgente($datosvalidados["pers_cuilt"],$datosagente,$es_modif_agente)) {
			$txt_sys_mail="\npers_cuilt=".$datosvalidados["pers_cuilt"];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		$datosvalidados['es_modif_agente'] = false;
		if ($es_modif_agente && isset($datos['grabar_datos_agente']) )
			$datosvalidados['es_modif_agente'] = true;

		$datosvalidados['hay_agente'] = $es_modif_agente;
		$datosvalidados['pers_codigo'] = $datospersona['pers_codigo'];

		// Valida Escalafon
		$oEscalafon = new cEscalafones($this->conexion);
		if (!$oEscalafon->ValidarEscalafon($datos['esc_agrup_niv_grado'], $datosvalidados) ) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error seleccionando la persona a asignar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// El Agente debe ser SINEP
		if ($datosvalidados['escalafcod'] != SINEP) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error debe seleccionar un Agente SINEP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// La funcion q graba el agente lo necesita todo junto
		$datosvalidados["datos_agente"]["esc_agrup_niv_grado"]=$datos['esc_agrup_niv_grado'];

		// Solo para SINEP, verificar la función de la persona
		// si no es SINEP => ERROR
		if ($datosvalidados['escalafcod']==SINEP) {
			$oTablaAgenteTipoFuncion = new cTablaAgenteTipoFuncion($this->conexion);
			$oTablaAgenteTipoFuncion -> TablaDescriptoresSP($spnombre,$spparam);
			$arraybusq=array("agfunc_codigo"=>$datos["agfunc_codigo"]);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,$arraybusq,$query,$filaret,$numfilasmatcheo,$errorcod) || $numfilasmatcheo!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección de la función del agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["agfunc_codigo"]=$datos["agfunc_codigo"];

		} else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La persona seleccionada no es un Agente de SINEP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
			//	$datosvalidados['agfunc_codigo'] = "NULL";
		}

		$datosvalidados["datos_agente"]["agfunc_codigo"]=$datosvalidados['agfunc_codigo'];

		$datosvalidados["datos_agente"]["tipoorg_codigo"]=$datos['tipoorg_codigo'];

		// Organismo publico donde trabaja
		if ($datos["tipoorg_codigo"]!=ORGANISMO_APN && $datos["tipoorg_codigo"]!=ORGANISMO_NO_APN) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en el tipo de Organismo Público donde trabaja.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if ($datos["tipoorg_codigo"]==ORGANISMO_APN) {

			$jurisdicciones	 = new jurisdicciones;
			if(!$jurisdicciones->BuscarRaizTipoOrg(TABGRALES_TIPOORG_NAC_EJ,array(),TABGRALES_TS_ARRAY,$nodo_jurisd,array(),$CodError)) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"No se pudo obtener la raiz de jurisdicciones. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

			$nodo_raiz = current($nodo_jurisd);
			if ($datos['jurisdid'] == $nodo_raiz['jurisdid']) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error en la selección del Organismo Público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

			if (!$jurisdicciones->SelectJurisdxID($datos['jurisdid'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$numfilas,$CodError) || $numfilas!=1) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del Organismo Público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["jurisdid_apn"]=$datos['jurisdid'];
			$datosvalidados["orgapub_codigo"]="NULL";
			// El que graba agente lo necesita en jurisdid
			$datosvalidados["datos_agente"]["jurisdid"]=$datos['jurisdid'];
		}
		if ($datos["tipoorg_codigo"]==ORGANISMO_NO_APN) {
			$oTablaOrganismoPublico = new cTablaOrganismoPublico($this->conexion);
			$oTablaOrganismoPublico -> TablaDescriptoresSP($spnombre,$spparam);
			$arraybusq=array("orgapub_codigo"=>$datos["jurisdid"]);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,$arraybusq,$query,$filaret,$numfilas,$errorcod) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del Organismo Público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["orgapub_codigo"]=$datos['jurisdid'];
			$datosvalidados["jurisdid_apn"]="NULL";
			// El que graba agente lo necesita en jurisdid
			$datosvalidados["datos_agente"]["jurisdid"]=$datos['jurisdid'];
		}

		$datosvalidados['actformpers_obs'] = $datos['actformpers_obs'];

		// Organismo de Coordinacion
		$datosvalidados['jurisdid_inap'] = $datos['jurisdid_coordinacion'];


		// La función q graba el agente necesita en jurisdid_coordinacion cuando en realidad el nombre
		// del campo es jurisd_inap.
		$datosvalidados["datos_agente"]["jurisdid_coordinacion"]=$datosvalidados['jurisdid_inap'];


		return true;
	}


} // class
?>