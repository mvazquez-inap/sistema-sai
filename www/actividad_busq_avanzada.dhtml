		} else {
			while ($filaActFormal = mysqli_fetch_assoc($resultActFormal)) {
				if (in_array($filaActFormal['act_codinap'],$act_codinap)) {
					$clave = array_search ($filaActFormal['act_codinap'],$act_codinap);
