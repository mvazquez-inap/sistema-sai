<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccion($conexion,$ArregloDatos,&$estado_leyenda) {


	$oPrestadorDocente= new cPrestadorDocente($conexion);
	$ArregloDatos['orderby']='presdoc_apellido, presdoc_nombre';	

	switch ($_SESSION['array_busqueda_basica_prestador_docente']['accion'] ) {

	case "Rehabilitar" :
		$ArregloDatos['presdoc_estado'] = PRESDOCBAJA;	
		$estado_leyenda = "ELIMINADOS";
		break;

	case "AsignarAEquipo" :
			$ArregloDatos['presdoc_estado'] = PRESDOCACTIVO;	
			$estado_leyenda = "ACTIVO";
			break;
	
	case "Eliminar" :
		switch ($_SESSION['rolcod']) {
			case COORDINADORTECNICO: 
			case USUORGANISMO: 
				$ArregloDatos['presdoc_estado'] = PRESDOCNUEVO.",".PRESDOCRECHAZADO;	
				$estado_leyenda = "NUEVOS o RECHAZADOS";
				$ArregloDatos['jurisdid_origen'] = $_SESSION['jurisdid_inap'];					
				break;
			case ADMICURSO: 
			case USUCURSO: 
				$ArregloDatos['presdoc_estado'] = PRESDOCACTIVO.",".PRESDOCINACTIVO;	
				$estado_leyenda = "ACTIVOS o INACTIVOS - SIN ÁREAS";
				break;
		}		
		break;

	case "Modificar" :
		switch ($_SESSION['rolcod']) {
			case COORDINADORTECNICO: 
			case USUORGANISMO: 
				$ArregloDatos['presdoc_estado'] = PRESDOCNUEVO.",".PRESDOCRECHAZADO;	
				$estado_leyenda = "NUEVOS o RECHAZADOS";
				$ArregloDatos['jurisdid_origen'] = $_SESSION['jurisdid_inap'];					
				break;
			case ADMICURSO: 
			case USUCURSO: 
				$ArregloDatos['presdoc_estado'] = PRESDOCACTIVO.",".PRESDOCINACTIVO;	
				$estado_leyenda = "ACTIVOS o INACTIVOS - SIN ÁREAS";
				break;
		}		
		break;


	case "Areas" :
		switch ($_SESSION['rolcod']) {
			case COORDINADORTECNICO: 
			case USUORGANISMO: 
				$ArregloDatos['presdoc_estado'] = PRESDOCNUEVO.",".PRESDOCRECHAZADO;	
				$ArregloDatos['jurisdid_origen'] = $_SESSION['jurisdid_inap'];	
				$estado_leyenda = "NO EVENTUALES NUEVOS o RECHAZADOS";
				break;
			case ADMICURSO: 
			case USUCURSO: 
				$ArregloDatos['presdoc_estado'] = PRESDOCACTIVO.",".PRESDOCINACTIVO;	
				$estado_leyenda = "NO EVENTUALES ACTIVOS o INACTIVOS - SIN ÁREAS";
				break;
		}		
		break;

	}
			
	if(!$oPrestadorDocente->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)){
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}			
	
	$array_result=array();	
	while ($fila_prestador=mysqli_fetch_assoc($result)) {
		$fila_prestador['idmostrar']=$fila_prestador['presdoc_apellido'].",".$fila_prestador['presdoc_nombre']."  ".(isset($fila_prestador['presdoc_cuilt'])?"(CUIT/CUIL=".$fila_prestador['presdoc_cuilt'].")":"");
		$array_result[] = $fila_prestador;
	}
	
	if ($numfilas >=LIMITE_BUSQUEDA_CHICO) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda retornó demasiadas filas, ajuste el criterio de búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}

	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda no retornó resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}
	
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>15
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
	
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'CUIT/CUIL');
	$oGrilla->Setear('campo_grilla',$miColumna1,'presdoc_cuilt');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	$oGrilla->Setear('ancho_columna',$miColumna1,'20%');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Apellido');
	$oGrilla->Setear('campo_grilla',$miColumna2,'presdoc_apellido');
	$oGrilla->Setear('align_columna',$miColumna2,'left');
	$oGrilla->Setear('ancho_columna',$miColumna2,'30%');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna3,'presdoc_nombre');
	$oGrilla->Setear('align_columna',$miColumna3,'left');
	$oGrilla->Setear('ancho_columna',$miColumna3,'30%');

	$miColumna4 = $oGrilla->AddColumna('addValor');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Seleccionar');
	$oGrilla->Setear('imagen',$miColumna4,'images/seleccionar.jpg');
	$oGrilla->Setear('altImagen',$miColumna4,'Seleccionar');
	$oGrilla->Setear('idtextboxAddValor',$miColumna4,$_SESSION['array_busqueda_basica_prestador_docente']['idtextboxAddValor']);
	
	if (!$_SESSION['array_busqueda_basica_prestador_docente']['submit']) {
		$oGrilla->Setear('submitAddValor',$miColumna4,'no');
		$oGrilla->Setear('documentAddValor',$miColumna4,'window.opener.document');
		$oGrilla->Setear('nombreContenidoAddValor',$miColumna4,'idmostrar');
		$oGrilla->Setear('idtextoContenidoAddValor',$miColumna4,'idmostrar');
	} else {
		$oGrilla->Setear('submitAddValor',$miColumna4,'si');
		$oGrilla->Setear('nombreFormularioSubmitAddValor',$miColumna4,$_SESSION['array_busqueda_basica_prestador_docente']['formulario']);
	}
	
	$oGrilla->AddParametrosAddValor($miColumna4,'presdoc_codigo');
	$oGrilla->Setear('ancho_columna',$miColumna4,'20%');
	
	if (!$oGrilla->CargarGrilla($array_result))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
//----------------------------------------------------------------------------------------- 
?>
