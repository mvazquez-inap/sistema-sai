//-----------------------------------------------------------------------------------------------------	
	function DescargarExcel()	{

		$ArregloDatos= array();
		$ArregloDatos['presins_estado']=ESTADOACTIVO;
		$ArregloDatos['orderby'] = "";
		
		if (!$this->BuscarPrestadorInstitucional($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando datos exportar a excel.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;			
		}	

		$result_array=array();
		while ( $fila=mysqli_fetch_assoc($result)  ) {

			$numfilas=0; 		
			if (!$this->conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$fila["presins_ra_prov_codigo"],"'"),$provincianom,$numfilas,$errorcod) || ($numfilas !=1) )
			{
				$txt_sys_mail="\n provinciacod=".$fila["presins_ra_prov_codigo"];
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Se produjo un error al buscar la provincia.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				$result=false;
			}

		/*	$numfilas=0; 		
			if (!$this->conexion->TraerCampo("partidos","partidonom",array("partidocod='",$fila["presins_ra_part_codigo"],"' and provinciacod='",$fila["presins_ra_prov_codigo"],"'"),$partidonom,$numfilas,$errorcod)  ||  ($numfilas !=1)  )
			{
				$txt_sys_mail="\n provinciacod=".$fila["presins_ra_prov_codigo"]." \n partidocod=".$fila["presins_ra_part_codigo"];
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Se produjo un error al buscar el partido.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				$result=false;
			}
			$numfilas=0; 		
			if (!$this->conexion->TraerCampo("localidades","localidadnom",array("localidadcod='",$fila["presins_ra_loca_codigo"],"' and provinciacod='",$fila["presins_ra_prov_codigo"],"' and partidocod='",$fila["presins_ra_part_codigo"],"'"),$localidadnom,$numfilas,$errorcod)  || ($numfilas !=1) )
			{
				$txt_sys_mail="\n provinciacod=".$fila["presins_ra_prov_codigo"]." \n partidocod=".$fila["presins_ra_part_codigo"]."\n localidadcod=".$fila["presins_ra_loca_codigo"];
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Se produjo un error al buscar la localidad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				$result=false;
			}
		*/
			$fila+=array('presins_ra_prov_desc'=> $provincianom);
		/*	$fila+=array('presins_ra_part_desc'=> $partidonom);
			$fila+=array('presins_ra_loca_desc'=> $localidadnom);*/

			$result_array[]=$fila;
		}
		
		$nombrearchivo="prestador_institucional.xls";  
		
		$oExcel= new cEscribirExcel($nombrearchivo);
		$oExcel->AddHoja('prestador_institucional');
		$oExcel->EsconderGrillas();
		$oExcel->PaginaHorizontal();
		$oExcel->FormatoColumna (1,60); // nombre
										// Responsable academico
		$oExcel->FormatoColumna (2,30); // apellido
		$oExcel->FormatoColumna (3,30); // nombre
		$oExcel->FormatoColumna (4,30); // domicilio
		$oExcel->FormatoColumna (5,10); // CP
		$oExcel->FormatoColumna (6,20); // provincia

/*		$oExcel->FormatoColumna (7,30); // partido
		$oExcel->FormatoColumna (8,30); // localidad*/
		
		$oExcel->FormatoColumna (7,60); // partido_localidad_desc
		$oExcel->FormatoColumna (8,15);  // telefono
		$oExcel->FormatoColumna (9,30); // mail
	
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor",22);
		$oExcel->CargarDatosVariasCeldas (0,0,0,9,'Prestadores Institucionales',true);
		$oExcel->CargarDatosVariasCeldas (1,0,1,1,'',true);
		$oExcel->CargarDatosVariasCeldas (1,2,1,9,'Responsable Académico',true);
		
		// Titulos de las columnas
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");
	
		$oExcel->CargarDatos (2,0,"Código",true);
		$oExcel->CargarDatos (2,1,"Nombre Institución",true);
		$oExcel->CargarDatos (2,2,"Apellido",true);
		$oExcel->CargarDatos (2,3,"Nombre",true);
		$oExcel->CargarDatos (2,4,"Domicilio",true);
		$oExcel->CargarDatos (2,5,"CP",true);
		$oExcel->CargarDatos (2,6,"Provincia",true);
/*		$oExcel->CargarDatos (2,7,"Partido",true);
		$oExcel->CargarDatos (2,8,"Localidad",true); */
		$oExcel->CargarDatos (2,7,"Partido/Localidad",true);
		$oExcel->CargarDatos (2,8,"Teléfono",true);
		$oExcel->CargarDatos (2,9,"Mail",true);
				
		$arrayclaves=array(	'presins_codigo','presins_nombre','presins_ra_apellido','presins_ra_nombre',
							'presins_ra_domicilio','presins_ra_cp','presins_ra_prov_desc',
							'presins_ra_part_loca_descripcion','presins_ra_telefono','presins_ra_email' );

		$i=3;
		foreach ($result_array as $datos) {
			$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,array());	
			$i++;
		}
		
		$oExcel->Enviar();

	}
} 
