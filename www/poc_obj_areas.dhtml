<SCRIPT LANGUAGE="JavaScript" type="text/javascript">
var campos_linea=new Array("lst|listaareasizq[]|listaareasder[]");
var datos_grilla=new Array();

function FXBuscar(frm,datos,metodo,archivo,idelemento,idtitulo,titulo,codigoobjetivo) {
	if (frm.poc_codigo.selectedIndex!=0)
	{
		var datosmetodo=null;
		var contenedor=document.getElementById(idelemento);
		contenedor.innerHTML='';
		var ajax=nuevoAjax();
		if (metodo=="GET")
			ajax.open(metodo,archivo+"?"+datos,true);
		else
		{	
			datosmetodo=datos;
			ajax.open(metodo,archivo,true);
		}
		ajax.onreadystatechange=function() {
			if (ajax.readyState==4) 
			{	
				eval (ajax.responseText);

				contenedor.innerHTML="";
				CambiarPropiedad("listaareasizq[]","","disabled",false);
				CambiarPropiedad("listaareasder[]","","disabled",false);
				
				frm.botonalta.disabled=false;
				CambiarPropiedad("listaareasizq[]","","disabled",false);
				
			//	var obj = EncontrarObjeto('listaareasder[]');
			//	alert(obj.disabled);
				
				if (datos_grilla.length>1)
					CambiarPropiedad("listaareasder[]","","disabled",false);	
				
				frm.botonalta.disabled=false;

			//	alert(campos_linea);
			// 	CargarDatosModificar('CARGAR',frm,campos_linea,datos_grilla,idtitulo,titulo);
					  
				frm.pocobj_codigo.value=codigoobjetivo;
				frm.pocobj_descripcion.value=pocobj_descripcion;
				
				if (titulo=='Eliminar Objetivo') {
					CambiarPropiedad("listaareasizq[]","","disabled",true);
					CambiarPropiedad("listaareasder[]","","disabled",true);			
				}
			}
		}
		ajax.send(datosmetodo);
	} else {
		alert ("Debe Seleccionar un POC");
	}	
}
</script>
