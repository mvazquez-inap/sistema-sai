function Fila_contenido_grupo_final_php() {

	ObtenerBrowser($browser);
	if ($browser['browser']=="MSIE") {
	   echo "</td>";
	   echo "</tr>";
	} else {
	   echo "</div>";
	   echo "</td>";
	   echo "</tr>";
	}
}
//-----------------------------------------------------------------------------
function Fila_contenido_grupo_inicio_php($idFila,$visible) {

	echo "<!-- Fila con datos contenido -->";
	ObtenerBrowser($browser);
	if ($browser['browser']=="MSIE") {
		  if ($visible=="SI")
			  echo "<tr id='".$idFila."' style='display:block';>";
		  else	
			  echo "<tr id='".$idFila."' style='display:none';>";	  
	
		  echo "<td colspan=2 style='padding:9px 10px 14px 10px;'>";

	} else {

	    echo "<tr>";

		if ($visible=="SI")
		   echo "<td colspan=2 style='padding:9px 10px 14px 10px;'><div id='".$idFila."' style=''>";
		else   
	       echo "<td colspan=2 style='padding:9px 10px 14px 10px;'><div id='".$idFila."' style='visibility:hidden;position:absolute'>";
	}	
}	   

//------------------------------------------------------------------------------------------------
function GrabarEstadistica($idconexion,$tipoesta_id, $codigo_tramite)
{
		$estadistica_valida = true;
		
		if ($_SERVER['REMOTE_ADDR'] == $_SERVER['SERVER_ADDR']) 
			$estadistica_valida = false;		
		// google
		if (preg_match("#Googlebot#",$_SERVER['HTTP_USER_AGENT']))
			$estadistica_valida = false;		

		// htdig
		if (preg_match("#htdi#",$_SERVER['HTTP_USER_AGENT']))
			$estadistica_valida = false;		

		// MSN 
		if (preg_match("#msnbot#",$_SERVER['HTTP_USER_AGENT']))
			$estadistica_valida = false;		
		
		// sin sesión inicializada
		if ($tipoesta_id == 0 || $tipoesta_id == "")					
			$estadistica_valida = false;		

						
		if ($estadistica_valida) {
			$archivonom = $_SERVER['PHP_SELF'];
			$archivonom=substr(strrchr($archivonom,'/'),1);
	
			$param=array('pesta_numeroip'=>$_SERVER['REMOTE_ADDR']);		
			$param+=array('pesta_pagina'=>$archivonom);		
			$param+=array('pesta_fecha'=>date('Y/m/d H:i:s'));		
			$param+=array('ptipoesta_id'=>$tipoesta_id);		
			$param+=array('pcodigo_tramite'=>$codigo_tramite);		
			$result = true;
			if(($resultado=ejecutarStoredProcedure($idconexion,"ins_estadistica",$param))<0) {
				$array_msg_pantalla=array("formato" => FMT_TEXTO);	
				$array_msg_pantalla+=array("texto" => "Se ha producido un error al grabar estadísticas" );
				$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']);
				MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
				$result = false;
			}
		}
		//no se usa result
}


function ConvertirEnlaces($campo) {

	$a=array();
	$n=preg_match_all('/##(.*?);*(.*?)##/',$campo,$a);
	$cant_expresiones = count($a[0]);
	for ($i=0;$i< $cant_expresiones;$i++){

		$hipervinculo = $a[0][$i];
		$terminos = explode (";", $hipervinculo);  
		$cantidad = count($terminos);

		if ($cantidad == 2){
			if  (preg_match("\x01".(expresion_url)."\x01", str_replace("##","",$terminos[0]))){
				$enlace = "<a href=\"".str_replace("##","",$terminos[0])."\" target=\"_blank\">". str_replace("##","",$terminos[1])."</a>";			
			}else {
				$enlace = $terminos[0]."; ". $terminos[1];	
			}

		}else{
			if  ( preg_match("\x01".(expresion_url)."\x01", str_replace("##","",$terminos[0]))){
				$enlace = "<a href=\"".str_replace("##","",$terminos[0])."\" target=\"_blank\">". str_replace("##","",$terminos[0])."</a>";			
			}else{
				$enlace = $terminos[0]." ". $terminos[0];			
			}
		}
		$campo = str_replace($hipervinculo,$enlace,$campo);
	}
	$campo = str_replace("##","",$campo);


	return $campo."<br>";
}

function ConvertirEnlaceImprimir($campo) {

	$a=array();
	$n=preg_match_all('/##(.*?);*(.*?)##/',$campo,$a);
	$cant_expresiones = count($a[0]);
	for ($i=0;$i< $cant_expresiones;$i++){
		$hipervinculo = $a[0][$i];
		$terminos = explode (";", $hipervinculo);  
		$cantidad = count($terminos);

			if  (preg_match("\x01".(expresion_url)."\x01", str_replace("##","",$terminos[0]))){
				$enlace = str_replace("##","",$terminos[0]);			
			}else {
				$enlace = $terminos[0];	
			}
		$campo = str_replace($hipervinculo,$enlace,$campo);
	}
		$campo = str_replace("##","",$campo);
	return $campo;
}


