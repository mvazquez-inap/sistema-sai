			return false;
		}
	
		return true;	
	}
//-----------------------------------------------------------------------------------------------------	
	function AltaDatosProgramacion($datos) {

		$oActividad = new cActividadCurso($this->conexion);
		
		$datos+=array('dic_pertinencia'=>SI);	// Son siempre pertinentes
		
		// creo/copio dictamen
		if ($datos['operacion_dictamen'] == "M" || $datos['operacion_dictamen'] == "A") {
			if($this->AltaDatosDictamen($datos,$dic_codigo)) {
				FuncionesPHPLocal::RegistrarAcceso($this->conexion,"49001","dic_codigo=".$dic_codigo,$_SESSION['usuariocod']);
			} else 
				return false;
		} elseif ($datos['operacion_dictamen'] == "V") {
				if($this->CopiarDatosDictamen($datos,$dic_codigo)) {
					FuncionesPHPLocal::RegistrarAcceso($this->conexion,"49001","dic_codigo=".$dic_codigo,$_SESSION['usuariocod']);
				} else 
					return false;
		}
		$datos['dic_codigo'] = $dic_codigo;
	
		switch ($_SESSION['rolcod']) {
			case USUCURSOINAP:
				$oActividad= new cActividadCursoInap($this->conexion);
				break;
			case USUACTINS:
				$oActividad= new cActividadCursoInstitucional($this->conexion);
				break;
			case USUACTJUR:
				$oActividad= new cActividadCursoJurisdiccional($this->conexion);
				break;
			case USUACTEXT:
				$oActividad= new cActividadExterna($this->conexion);
				break;	
			case USUAUTODESARROLLO: // Solo para mero
				$oActividad= new cActividadAutodesarrollo($this->conexion);
				break;	
		}
		$oActividad->ActualizarCreditos($datos['act_codigo'],$datos['act_creditos']);

		// creo programación
		if(!$this->_DatosValidosAltaProgramacion($datos,$datosvalidados))
			return false;
		
		$spnombre="ins_actividad_programacion";
		$spparam=array(
			'pact_codigo'=> $datosvalidados['act_codigo'],
			'pactprog_sec'=> $datosvalidados['actprog_sec'],
			'pactprog_fecha_inicio'=>  FuncionesPHPLocal::ConvertirFecha($datosvalidados['actprog_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd'),
			'pactprog_fecha_fin'=>  FuncionesPHPLocal::ConvertirFecha($datosvalidados['actprog_fecha_fin'],'dd/mm/aaaa','aaaa-mm-dd'),
			'pdic_codigo'=> $datosvalidados['dic_codigo'],
			'pexp_codigo'=> $datosvalidados['exp_codigo'],
			'pactprog_obs'=> $datosvalidados['actprog_obs'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);
			
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Programación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
	
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function BajaDatosProgramacion($datos) {

		if(!$this->_DatosValidosBajaProgramacion($datos,$datosvalidados))
			return false;
	
		$spnombre="del_actividad_programacion";
		$spparam=array(
			'pact_codigo'=> $datosvalidados['act_codigo'],
			'pactprog_sec'=> $datosvalidados['actprog_sec']		
			);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad Curso Institucional.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	
		if($this->BajaDatosDictamen($datos)) {
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"49002","dic_codigo=".$datosvalidados['dic_codigo'],$_SESSION['usuariocod']);
		} else 
			return false;

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function ModifDatosProgramacion($datos) {
	
		$datos+=array('dic_pertinencia'=>SI);	// Son siempre pertinentes

		if(!$this->_DatosValidosModifProgramacion($datos,$datosvalidados))
			return false;
		$spnombre="upd_actividad_programacion";
		$spparam=array(
			'pdic_codigo'=> $datosvalidados['dic_codigo'],
			'pexp_codigo'=> $datosvalidados['exp_codigo'],
			'pactprog_fecha_inicio'=>  FuncionesPHPLocal::ConvertirFecha($datosvalidados['actprog_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd'),
			'pactprog_fecha_fin'=>  FuncionesPHPLocal::ConvertirFecha($datosvalidados['actprog_fecha_fin'],'dd/mm/aaaa','aaaa-mm-dd'),
			'pactprog_obs'=> $datosvalidados['actprog_obs'],
			'pact_codigo'=> $datosvalidados['act_codigo'],
			'pactprog_sec'=> $datosvalidados['actprog_sec'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la Programación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	
		if ($datos['operacion_dictamen'] == "M") {
			
			if($this->ModifDatosDictamen($datos)) {
				FuncionesPHPLocal::RegistrarAcceso($this->conexion,"49103","dic_codigo=".$datosvalidados['dic_codigo'],$_SESSION['usuariocod']);
			} else 
				return false;
		
			switch ($_SESSION['rolcod']) {
				case USUCURSOINAP:
					$oActividad= new cActividadCursoInap($this->conexion);
					break;
				case USUACTINS:
					$oActividad= new cActividadCursoInstitucional($this->conexion);
					break;
				case USUACTJUR:
					$oActividad= new cActividadCursoJurisdiccional($this->conexion);
					break;
				case USUACTEXT:
					$oActividad= new cActividadExterna($this->conexion);
					break;	
				case USUAUTODESARROLLO: // Es sólo para mero
					$oActividad= new cActividadAutodesarrollo($this->conexion);
					break;	
				case SUPERUSUARIO:		
					switch ($datos["tipoact_codigo"]) {
						case TIPOACTCURSOINAP:
							$oActividad= new cActividadCursoInap($this->conexion);
							break; 
		
						case TIPOACTAUTOEVASIS:
							$oActividad= new cActividadAutodesarrollo($this->conexion);
							break; 

						case TIPOACTEXTASIS:
							$oActividad= new cActividadExterna($this->conexion);
							break; 

					}
				}
				
			$oActividad->ActualizarCreditos($datos['act_codigo'],$datos['act_creditos']);
		}
	
		return true;
	}
