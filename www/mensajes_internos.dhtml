                    <tr>
                        <td class='textoEtiqueta' width="20%" align="left">Asunto</td>
                      <td colspan="2" class="textoEtiquetaDatoResaltado" align="left"><?php echo htmlspecialchars($fila_mensaje['msg_asunto'],ENT_QUOTES) ?></td>  
                    </tr>  
                    <tr>
                        <td class='textoEtiqueta' width="20%" align="left">De</td>
                      <td colspan="2" class="textoEtiquetaDatoResaltado" align="left"><?php echo htmlspecialchars($fila_mensaje['msg_usuariocod_origen'],ENT_QUOTES) ?></td>  
                    </tr>  
                    <tr>
                        <td class='textoEtiqueta' width="20%" align="left">Mensaje</td>
                      <td colspan="2" class="textoEtiquetaDatoResaltado" align="left"><?php echo nl2br(htmlspecialchars($fila_mensaje['msg_mensaje'],ENT_QUOTES)) ?></td>  
                    </tr>  

                    <tr>
	                    <td colspan="2" align="center">
							<input type="submit" name="boton_confirma" class="botones" value="<?php echo $boton_operacion?>" />                        
							<input type="hidden" name="operacion" id="operacion" value="<?php echo $operacion;?>" />
							<input type="hidden" name="msg_codigo" id="msg_codigo" value="<?php echo $fila_mensaje['msg_codigo'] ?>" />				  
                            
                        </td>
                    </tr>
                    <tr>
	                    <td colspan="2" align="center">
							<a href="mensajes_internos.dhtml" class="linkFondoBlanco">Volver a Buscar</a>
                        </td>
                    </tr>

                </table>				
                
                
                
                </form>
				
			<?php	
				
			}	
			
		} else {
			
		?>
				<div align="right" style="width:97%">
					<a href="ingreso.dhtml" class="linkfondoblanco textoaclaraciones">Volver</a>
