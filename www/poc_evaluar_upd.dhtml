echo"<br>";
echo "//// POST ////";
print_r ($_POST);*/
//----------------------------------------------------------------------------------------- 	
$conexion->ManejoTransacciones("B");
$result=true;
//----------------------------------------------------------------------------------------- 	
if($_GET['operacion']=='A') {
	if(!$oPocActividad->AprobacionPocActividad($_GET['poc_codigo'],$_GET['pocact_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']))
		$result=false;
}
elseif($_GET['operacion']=='R') {
	if(!$oPocActividad->RechazarPocActividad($_GET['poc_codigo'],$_GET['pocact_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']))
		$result=false;
}
else
	$result=false;
if($result) {

	if($_GET['operacion']=='A') {
		//$operacion_mensaje = "APROBACION (Actividad del Poc)";	
		$oPocActividad->ArmarMensajeAprobacionActividad($_GET,$mensaje);
		$asunto = SISTEMA." - Confirmación Carga Actividad POC";
		if (FuncionesPHPLocal::MandarMail($conexion,COORDINADORTECNICO,$_SESSION['jurisdid_inap'],$asunto,$mensaje)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"En unos momentos el Coorfinador Técnico recibirá un correo electrónico <BR> con la Confirmación de la carga de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El correo electrónico con la evaluación de la actividad no fue enviado,<br> notifique al Coordinador Técnico por otra via.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}	
	} elseif($_GET['operacion']=='R') {
		//$operacion_mensaje = "RECHAZO (Actividad del Poc)";			
		$oPocActividad->ArmarMensajeRechazoActividad($_GET,$mensaje);
		$asunto = SISTEMA." - Se requiere rectificar la carga de la Actividad POC";
