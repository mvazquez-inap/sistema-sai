//-------------------------------------------------------------------------------------
function MostrarComisiones($conexion,$ArregloDatos) {

	if (isset($ArregloDatos['tipoact_codigo']) && $ArregloDatos['tipoact_codigo']!="")   
		$array_tipos = array($ArregloDatos['tipoact_codigo']); 	
	else 
		$array_tipos = array(TIPOACTCURSOINAP,TIPOACTCURSOJURISD); 	

	$oComsion=new cComision($conexion);	
	
	$numfilas=0;

	// paso los parámetros a un arreglo auxiliar para eliminar las fechas si es que se selecciona algún filtro por fechas
	$ArregloDatosFechas = $ArregloDatos;
	
	if ($ArregloDatos['tipo_fecha'] != "no_filtra") {
		$ArregloDatosFechas['comi_fecha_inicio'] ="";
		$ArregloDatosFechas['comi_fecha_fin'] ="";
	}
	
	// se busca por prestador docente	
	if (isset($ArregloDatos['apeynom']) && $ArregloDatos['apeynom']!="") {   
			if(!$oComsion->BuscarComisionPresDocAvanzada($ArregloDatosFechas, $numfilas, $resultComision, $error, $errormail)) {
				$txt_sys_mail = "Error al buscar comisiones por Nobre y apellido"; // 
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar comisiones.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			} 
	} else {
			if(!$oComsion->BuscarComisionAvanzada($ArregloDatosFechas, $numfilas, $resultComision, $error, $errormail)) {
				$txt_sys_mail = "Error al buscar comisiones Avanzadas por Nobre y apellido"; // "\ntipoact_codigo=$tipoact_codigo";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar comisiones.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			} 
	
	}
			
			
 		if($numfilas==0) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se encontraron comisiones, que cumplan con la condición",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} elseif($numfilas>0) {  
			$opciones=array(
				"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
				"FilasPagina"=>10,
				"NombrePaginaQuery"=>"pagina"
			);				
	
			if (isset($_GET["pagina"]))	{
				$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
				$opciones['QueryString']=$querystring;
			}

			$comsiones_seleccionadas = array();					
			while ($fila_comision = mysqli_fetch_assoc($resultComision)) {  
			
				$se_muestra = false;
				switch ($ArregloDatos['tipo_fecha']) {
					
					case "dia":
							$spnombre="sel_comision_fecha_xcomi_codigo_comifec_fecha_comifec";
							$spparam_fecha=array('pcomi_codigo'=>$fila_comision['comi_codigo'],'pcomifec_fecha'=>$ArregloDatos['comi_fecha_inicio']);
							if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam_fecha,$resultado,$numfilas,$errno))	{
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar el cronograma de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								$error = true;
							} 
							if (!$error && $numfilas == 1) 
								$se_muestra = true;
							break;

					case "inicio":
							$spnombre="sel_comision_xcomi_codigo_fechainicio";
							$spparam_fecha=array('pcomi_codigo'=>$fila_comision['comi_codigo'],'pcomi_fecha_inicio'=>$ArregloDatos['comi_fecha_inicio'],'pcomi_fecha_fin'=>$ArregloDatos['comi_fecha_fin']);
							if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam_fecha,$resultado,$numfilas,$errno))	{
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar el cronograma de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								$error = true;
							} 
							if (!$error && $numfilas == 1) 
								$se_muestra = true;
							break;


					case "fin":
							$spnombre="sel_comision_xcomi_codigo_fechafin";
							$spparam_fecha=array('pcomi_codigo'=>$fila_comision['comi_codigo'],'pcomi_fecha_inicio'=>$ArregloDatos['comi_fecha_inicio'],'pcomi_fecha_fin'=>$ArregloDatos['comi_fecha_fin']);
							if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam_fecha,$resultado,$numfilas,$errno))	{
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar el cronograma de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								$error = true;
							} 
							if (!$error && $numfilas == 1) 
								$se_muestra = true;
					
					break;

					case "no_filtra":
						$se_muestra = true;
					break;
							
				
				}
				
				
				if ($se_muestra) {
					$conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_comision['tipoact_codigo'],"'"),$tipoact_descripcion,$numfilas,$errorcod); 
					$fila_comision['tipoact_descripcion']=$tipoact_descripcion;
					
					// $fila_comision['fecha_desde_hasta'] = isset($fila_comision['comi_fecha_inicio'])?$fila_comision['comi_fecha_inicio']."\na\n".$fila_comision['comi_fecha_fin']:"Indefinida";
					// Cambio x formato fechas						
					$fila_comision['fecha_desde_hasta'] = isset($fila_comision['comi_fecha_inicio_ddmmaaaa'])?$fila_comision['comi_fecha_inicio_ddmmaaaa']."\na\n".$fila_comision['comi_fecha_fin_ddmmaaaa']:"Indefinida";
					$comsiones_seleccionadas[]=$fila_comision;
				}
				
									
			} // while $fila_comision = mysql_fetch_assoc($resultComision)
			
			if(count($comsiones_seleccionadas) > LIMITE_BUSQUEDA_MEDIANO)	{
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La b&uacute;squeda retorn&oacute; más de ".LIMITE_BUSQUEDA_MEDIANO." comisiones, deber&aacute; acotarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else { 
			
				$oGrilla = new cGrilla($opciones);
				$oGrilla->SetearTituloGrilla('Comisiones');
				$oGrilla->SetearAnchoGrilla('95%');
	
				$miColumna3 = $oGrilla->AddColumna('txt');
				$oGrilla->Setear('titulo_columna',$miColumna3,'Actividad ');
				$oGrilla->Setear('campo_grilla',$miColumna3,'act_nombre');
				$oGrilla->Setear('align_columna',$miColumna3,'left');
	
				$miColumna1 = $oGrilla->AddColumna('txt');
				$oGrilla->Setear('titulo_columna',$miColumna1,'Código Comisión INAP');
				$oGrilla->Setear('campo_grilla',$miColumna1,'comi_codinap');
				$oGrilla->Setear('align_columna',$miColumna1,'left');
				$oGrilla->Setear('ancho_columna',$miColumna1,'100');
				
				$miColumna2 = $oGrilla->AddColumna('txt');
				$oGrilla->Setear('titulo_columna',$miColumna2,'Tipo de Actividad');
				$oGrilla->Setear('campo_grilla',$miColumna2,'tipoact_descripcion');
				$oGrilla->Setear('align_columna',$miColumna2,'center');
				$oGrilla->Setear('ancho_columna',$miColumna2,'80');
		
				$miColumna6 = $oGrilla->AddColumna('txt');
				$oGrilla->Setear('titulo_columna',$miColumna6,'Realización');
				$oGrilla->Setear('campo_grilla',$miColumna6,'fecha_desde_hasta');
				$oGrilla->Setear('align_columna',$miColumna6,'center');
				$oGrilla->Setear('ancho_columna',$miColumna6,'80');
		
				$miColumna5 = $oGrilla->AddColumna('popup');
				$oGrilla->Setear('ancho_columna',$miColumna5,'60');
				$oGrilla->Setear('imagen',$miColumna5,'images/verdetalle.gif');
				$oGrilla->Setear('altImagen',$miColumna5,'Ver detalle');		
				$oGrilla->Setear('titulo_columna',$miColumna5,'Detalle');
				$oGrilla->Setear('url',$miColumna5,'comision_ver_detalle_popup.dhtml');
				$oGrilla->Setear('ventanaAnchoPopup',$miColumna5,'650');
				$oGrilla->Setear('ventanaAltoPopup',$miColumna5,'450');
				$oGrilla->Setear('ventanaVarxPopup',$miColumna5,'130');
				$oGrilla->Setear('ventanaVaryPopup',$miColumna5,'50');
				$oGrilla->AddParametrosURL($miColumna5,"comi_codigo",'comi_codigo');
	
				$miColumna6 = $oGrilla->AddColumna('popup');
				$oGrilla->Setear('ancho_columna',$miColumna6,'60');
				$oGrilla->Setear('imagen',$miColumna6,'images/personas.jpg');
				$oGrilla->Setear('altImagen',$miColumna6,'Ver inscriptos');		
				$oGrilla->Setear('titulo_columna',$miColumna6,'Ver inscriptos');
				$oGrilla->Setear('url',$miColumna6,'comision_ver_inscriptos_popup.dhtml');
				$oGrilla->Setear('ventanaAnchoPopup',$miColumna6,'650');
				$oGrilla->Setear('ventanaAltoPopup',$miColumna6,'500');
				$oGrilla->Setear('ventanaVarxPopup',$miColumna6,'130');
				$oGrilla->Setear('ventanaVaryPopup',$miColumna6,'50');
				$oGrilla->AddParametrosURL($miColumna6,"comi_codigo",'comi_codigo');
	
	
	
					
				if ($oGrilla->CargarGrilla($comsiones_seleccionadas)) {
					$oGrilla->MostrarGrilla();	
				} else {
					$txt_sys_mail = "Error Grilla='".$oGrilla->GetError();
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar las comisiones.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
					return false;
				}		
			}	
		
	}		

	return true;
} 
