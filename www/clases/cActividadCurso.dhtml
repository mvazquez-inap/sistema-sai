<?php
//-----------------------------------------------------------------------------------------
class cActividadCurso extends cActividad {

	public function __construct($conexion) {
		parent::__construct($conexion);
	}
//-----------------------------------------------------------------------------------------
	function TieneTipo($act_codigo,$tipoact_codigo,&$tiene_tipo)	{

		$tiene_tipo=$this->EsActividadCursoTipo($act_codigo,$tipoact_codigo,$error,$errormsg);
		if ($error) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		    return false;
		}
	    return true;
	}
	//-----------------------------------------------------------------------------------------------------
	 function ObtenerTipos($act_codigo,&$array_tipos)	{

			$ArregloDatos = array();
			$ArregloDatos['act_codigo'] = $act_codigo;

			if(!$this->BuscarActividadCurso($ArregloDatos,$numfilas,$resultActCurso,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al obtener los tipos de Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

			while ($fila_resultCurso = mysqli_fetch_assoc($resultActCurso)) {
				$array_tipos[]+= $fila_resultCurso['tipoact_codigo'];
			}
			return true	;
	}

//-----------------------------------------------------------------------------------------
	function EsActividadCursoTipo($act_codigo,$tipoact_codigo,&$error,&$errormsg)	{

		// La actividad debe existir y ser formato curso
		$error=false;
		if (!$this->TraerDatosActividadCurso($act_codigo,$result_actividad_curso,$es_modif_act_curso)) {
			$error=true;
			return false;
		}

		if (!$es_modif_act_curso) {
			$errormsg="Error al buscar la Actividad Curso.";
			//FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;
			return false;
		}

		return ($result_actividad_curso['tipoact_codigo'] == $tipoact_codigo);
	}

//-----------------------------------------------------------------------------------------------------
// Toma el tipo de la actividad curso enviada y crea un objeto del tipo correspondiente.

function newActividadCursoTipo($act_codigo, &$oActividadCurso) {

	$error = false;
	$tiene_formato_tipo = false;
	$oActividadCurso = new cActividadCurso($this->conexion);

	if ($this->TieneFormatoTipo($act_codigo,FORMATOCURSO,TIPOACTCURSOINAP,$tiene_formato_tipo)) {
		if ($tiene_formato_tipo) {
			$oActividadCurso = new cActividadCursoInap($this->conexion);
		} elseif ($oActividadCurso->TieneFormatoTipo($act_codigo,FORMATOCURSO,TIPOACTCURSOJURISD,$tiene_formato_tipo))  {
				if ($tiene_formato_tipo) {
					$oActividadCurso = new cActividadCursoJurisdiccional($this->conexion);
				} elseif ($oActividadCurso->TieneFormatoTipo($act_codigo,FORMATOCURSO,TIPOACTCURSOINST,$tiene_formato_tipo))  {
						if ($tiene_formato_tipo) {
							$oActividadCurso = new cActividadCursoInstitucional($this->conexion);
						}
				}
			} else
				$error = true;
	} else
		$error = true;

	if ($error)	{
		$txt_sys_mail= "Error al crear un objeto del formato de la actividad curso: \nact_codigo =".$act_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al crear la actividad curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
		return false;
	}
}
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadCurso($act_codigo,&$datosresult,&$es_modif){

		$datosresult=array();
		$es_modif = false;
		$sparam=array('pact_codigo'=>$act_codigo);
		$spnombre="sel_actividad_curso_xact_codigo";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$errormail="\nact_codigo=".$act_codigo."\nerror=.".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function AltaDatosActividadCurso($datos, &$act_codigo_nuevo,&$act_codinap) {

		switch($datos['actividad_curso']['tipoact_codigo']) {
			case TIPOACTCURSOINAP:
				$prefijo = "IN";
				break;
			case TIPOACTCURSOJURISD:
				$prefijo = "JU";
				break;
			case TIPOACTCURSOINST:
				$prefijo = "IS";
				break;
		}

		if(!$this->AltaDatosActividad($datos['actividad'],$act_codigo_nuevo, true, $prefijo, $act_codinap))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38001","act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);

		if(!$this->_DatosValidosAltaActividadCurso($datos['actividad_curso'],$datosvalidados))
			return false;

		$spnombre="ins_actividad_curso";
		$spparam=array(
			'pact_codigo'=>$act_codigo_nuevo,
			'pjurisdid_inap'=> $datosvalidados['jurisdid_inap'],
			'ptipoact_codigo'=> $datosvalidados['tipoact_codigo'],
			'pactcur_creditos'=> $datosvalidados['actcur_creditos'],
			'pactcur_estado'=> $datosvalidados['actcur_estado'],
			'pactcur_obs'=> $datosvalidados['actcur_obs'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo dar de alta la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function EliminarDatosActividadCurso($act_codigo) {

		if(!$this->_DatosValidosEliminarActividadCurso($act_codigo,$datosvalidados))
			return false;

		// Eliminar la asociación entre la actividad y los docentes.
		if($datosvalidados['tipoact_codigo']==TIPOACTCURSOINAP || $datosvalidados['tipoact_codigo']==TIPOACTCURSOJURISD) {
			$oActividadCursoPrestadorDocente = new cActividadCursoPrestadorDocente($this->conexion);
			if (!$oActividadCursoPrestadorDocente->EliminarDatosActividadCursoPrestadorDocenteTodos($act_codigo))
				return false;
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38502","Global / act_codigo=".$act_codigo,$_SESSION['usuariocod']);
		}

		// Eliminar actividad_curso
		$spnombre="del_actividad_curso";
		$spparam=array('pact_codigo'=>$act_codigo);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail="Error al eliminar el diseño curso.\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if(!$this->EliminarDatosActividad($act_codigo,FORMATOCURSO))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38002","act_codigo=".$act_codigo,$_SESSION['usuariocod']);

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function ModifDatosActividadCurso($datos)	{

		if(!$this->ModifDatosActividad($datos['actividad']))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38003","act_codigo=".$datos['actividad']['act_codigo'],$_SESSION['usuariocod']);

		if(!$this->_DatosValidosModifActividadCurso($datos['actividad_curso'],$datosvalidados))
			return false;

		$spnombre="upd_actividad_curso";
		$spparam=array(
			'pact_codigo'=> $datosvalidados['act_codigo'],
			'pactcur_obs'=> $datosvalidados['actcur_obs'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo modificar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function ActualizarCreditos($act_codigo,$act_creditos) {

		$spnombre="upd_actividad_curso_asigno_creditos_xact_codigo";
		$spparam=array(
			'pact_codigo'=> $act_codigo,
			'pactcur_creditos'=> $act_creditos,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar los créditos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			if ($numfilas != 1) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar los créditos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function TienePermisoModificar($act_codigo,$rolcod,$jurisdid) {

		// Valida el estado con rol y la jurisdicción, NO valida si tiene o no dictamen la actividad.
		if (!$this->TraerDatosActividadCurso($act_codigo,$fila_actividad_curso,$es_modif_act_curso))
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;
		if (!$es_modif_act_curso)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Curso a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		if 	($rolcod == USUCURSOINAP || $rolcod == USUACTINS)  {
			if ($fila_actividad_curso['actcur_estado'] == ACTCURSOACTIVO)
				return true;
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), no le permite modificarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		} elseif ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO) {
			 if ($fila_actividad_curso['jurisdid_inap'] == $jurisdid) {
					if ($fila_actividad_curso['actcur_estado'] == ACTCURSONUEVO || $fila_actividad_curso['actcur_estado'] == ACTCURSORECHAZADO)
						return true;
					else {
						$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), no le permite modificarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
						return false;
					}
			 } else {
 				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene acceso a modificar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		} elseif ($rolcod == SUPERUSUARIO) {
			return true;
		}

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
//-----------------------------------------------------------------------------------------------------
	function MostrarDatosActividadAsignable($conexion,$act_codigo,$formact_codigo,$tipoact_codigo,$actprog_sec) {

		$oDictamen = new cDictamen($conexion);
		$ok = true;

		$ArregloDatos['act_codigo'] = $act_codigo;
		$ArregloDatos['actprog_sec']=$actprog_sec;
		
		if ($_SESSION['rolcod'] != SUPERUSUARIO) {
			$ArregloDatos['dic_estado'] = DICTAMENACTIVO;
			$ArregloDatos['formact_codigo'] = $formact_codigo;
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;
		}

		if(!$this->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\nact_codigo=".$ArregloDatos['act_codigo']."\nformact_codigo=".$ArregloDatos['formact_codigo']."\ntipoact_codigo=".$ArregloDatos['tipoact_codigo']."\nactprog_sec=".(isset($ArregloDatos['actprog_sec'])?$ArregloDatos['actprog_sec']:"")."\nerror=".$errormail;
			$txt_sys_mail.= "\n error en BuscarActividadDictaminadaAvanzada";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"No se ha encontrado el dictamen de la actividad seleccionada.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			$ok = false;
		}
		if ($numfilas != 1 && $_SESSION['rolcod'] != SUPERUSUARIO) {
			$txt_sys_mail="\nact_codigo=".$ArregloDatos['act_codigo']."\nformact_codigo=".$ArregloDatos['formact_codigo']."\ntipoact_codigo=".$ArregloDatos['tipoact_codigo']."\nactprog_sec=".(isset($ArregloDatos['actprog_sec'])?$ArregloDatos['actprog_sec']:"")."\nerror=".$errormail;
			$txt_sys_mail.="\nnumfilas=".$numfilas;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"El dictamen de la programación no esta activo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			$ok = false;
		}

		if ($ok) {
			$filaauto = mysqli_fetch_assoc($result);
			
?>			<fieldset class="bordeDetalleRegistro">
