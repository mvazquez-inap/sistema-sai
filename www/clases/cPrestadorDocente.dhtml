	function PaisSP(&$spnombre,&$spparam)	{
		$spnombre="sel_paises_xestado";
		$spparam = array("ppaisestado"=>ESTADOACTIVO, "porderby"=>"paisnom");
	}
//-----------------------------------------------------------------------------------------------------	
	function  ArmarMensajeEvaluar ($presdoc_codigo, $operacion, &$mensaje) {

		$result = true;
		if(!$this->TraerDatosPrestadorDocente($presdoc_codigo,$filaprestador,$es_modif))  {
			$error="Error al buscar el prestador docente.";
			$errormail="Error al buscar el prestador docente en tabla presador_docente \npresdoc_codigo=".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$result =  false;
		}
	
		if ($result) {
			$mensaje = " INAP ha ".$operacion." la incorporación al Registro de Prestadores docentes de \n";
			$mensaje .= " Apellido:   ".$filaprestador['presdoc_apellido']."\n";	;		
			$mensaje .= " Nombre:   ".$filaprestador['presdoc_nombre']."\n";	
		
			if ($filaprestador['presdoc_cuilt'] != NULL )
				$mensaje .= " CUIT / CUIL:   ".$filaprestador['presdoc_cuilt']."\n";	;			
		}
				
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function  ArmarMensajePedidoAprobacion($presdoc_codigo,&$mensaje) {

		$result = true;
		if(!$this->TraerDatosPrestadorDocente($presdoc_codigo,$filaprestador,$es_modif))  {
			$error="Error al buscar el prestador docente.";
			$errormail="Error al buscar el prestador docente en tabla presador_docente \npresdoc_codigo=".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$result =  false;
		}
	
		if ($result) {
			$mensaje = "  El Coordinador técnico ha solicitado la incorporación al Registro de Prestadores Docentes de\n";
			$mensaje .= " Apellido:   ".$filaprestador['presdoc_apellido']."\n";	;		
			$mensaje .= " Nombre:   ".$filaprestador['presdoc_nombre']."\n";	
			if ($filaprestador['presdoc_cuilt'] != NULL )
				$mensaje .= " CUIT / CUIL:   ".$filaprestador['presdoc_cuilt']."\n";	;			
			$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$_SESSION['jurisdid_inap'],"'"),$jurisdnom,$numfilas,$errno);
			$mensaje .= " Organismo de Coordinación: ".$jurisdnom."\n";				
		}
	}	

