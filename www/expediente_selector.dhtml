				<input type="hidden" name="destino" value="<?php echo (isset($_GET['destino']))?$_GET['destino']:$_SESSION['array_busqueda_basica_expediente']['idtextboxAddValor']?>" >
				<input type="hidden" name="submit" value="<?php echo (isset($_GET['submit']))?$_GET['submit']:$_SESSION['array_busqueda_basica_expediente']['submit']?>" >
				<input type="hidden" name="accion" value="<?php echo (isset($_GET['accion']))?$_GET['accion']:$_SESSION['array_busqueda_basica_expediente']['accion']?>" >				
