// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
$oDictamen=new cDictamen($conexion);
?>
<script type="text/javascript">
//----------------------------------------------------------------------------------------- 
var max_fila_seleccionados = 0;   	// Cantidad de seleccionados en cada momento
var MAX_SELECCIONADOS = 30;			// Cantidad máxima permitida de Seleccionados
//----------------------------------------------------------------------------------------- 
function newNodoFilaTitulos(idTabla){	
	var newFila=document.getElementById(idTabla).insertRow(-1);
	newFila.name='id_titulos';
	newFila.id='id_titulos';

//	newFila.style.backgroundColor="#3D005F";
//	alert(newFila.className);
//	newFila.style.setAtribute('backgroundColor',"#3D005F");
	newFila.className='colorTitulosGrupo textoTituloGrupo';
	newFila.align="center";

	newFila.appendChild(document.createElement("td"));	
	var theText = document.createTextNode('Expediente');
	newFila.lastChild.appendChild(theText);

	newFila.appendChild(document.createElement("td"));	
	var theText = document.createTextNode('Código INAP');
	newFila.lastChild.appendChild(theText);

	newFila.appendChild(document.createElement("td"));	
	var theText = document.createTextNode('Actividad');
	newFila.lastChild.appendChild(theText);

	if(idTabla=='tabla_seleccionados_programacion') {
		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode('Vigencia Desde');
		newFila.lastChild.appendChild(theText);
	
		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode('Vigencia Hasta');
		newFila.lastChild.appendChild(theText);
	} else {
		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode('Tipo');
		newFila.lastChild.appendChild(theText);

		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode('Destinatario');
		newFila.lastChild.appendChild(theText);
	}
	newFila.appendChild(document.createElement("td"));	
	var theText = document.createTextNode('');
	newFila.lastChild.appendChild(theText);

}
//---------------------------------------------------------------------
function newNodoFila(idTabla,dic_codigo){	

	if(max_fila_seleccionados+1>MAX_SELECCIONADOS) {
		alert('La cantidad máxima de dictámenes a seleccionar es de '+MAX_SELECCIONADOS);
		return;
	}

	var fila = EncontrarObjeto("id_fila_dic_seleccionada_"+dic_codigo);
	if(fila != null) {
		alert('Ya se encontraba seleccionado el dictamen.');
	} else { 
	
		var item_obj = EncontrarObjeto("id_fila_dic_seleccionable_"+dic_codigo);
		var exp_numero=item_obj.cells[1].innerHTML;
		var act_codinap=item_obj.cells[2].innerHTML;
		var act_nombre=item_obj.cells[3].innerHTML;
		var actprog_fecha_inicio=item_obj.cells[4].innerHTML;
		var actprog_fecha_fin=item_obj.cells[5].innerHTML;
			
		var newFila=document.getElementById(idTabla).insertRow(-1);
		max_fila_seleccionados++;
		newFila.name='id_fila_dic_seleccionada_'+dic_codigo;
		newFila.id='id_fila_dic_seleccionada_'+dic_codigo;		

		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode(exp_numero);
		newFila.lastChild.appendChild(theText);
	
		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode(act_codinap);
		newFila.lastChild.appendChild(theText);
	
		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode(act_nombre);
		newFila.lastChild.appendChild(theText);
	
		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode(actprog_fecha_inicio);
		newFila.lastChild.appendChild(theText);
	
		newFila.appendChild(document.createElement("td"));	
		var theText = document.createTextNode(actprog_fecha_fin);
		newFila.lastChild.appendChild(theText);
	
		newFila.appendChild(document.createElement("td"));	
		var theButton = document.createElement('input');
		theButton.type='image';
		theButton.name='eliminar_'+dic_codigo;
		theButton.src='images/menos.jpg';	
		theButton.alt='Eliminar Selección';	
		theButton.value='Eliminar Selección';
		theButton.onclick=function(){deleteFila('id_fila_dic_seleccionada_'+dic_codigo) };
		newFila.lastChild.appendChild(theButton);
	}	
	return;
}
//-----------------------------------------------------------------
function newAllFila(formulario,idTabla ) {

	var item_name,item_obj,i;
	var len=eval('window.document.'+formulario+'.length');	
	for(i=0;i<len;i++) {
		item_name=eval('window.document.'+formulario+'.elements[i].name');
		if (item_name.substr(0,9)=='checkbox_') {
			item_obj = EncontrarObjeto(item_name);
			if (item_obj.checked==true) {		
				newNodoFila(idTabla,item_name.substr(9,item_name.length-1));
			} // if - item_obj.checked
		}	// if - item_name.substr(0,9)=='checkbox_'
	} // for
}
//-----------------------------------------------------------------
function cambiarChecks(formulario,idCheck) {
	var item_name,item_obj,i,objChequeados;
	var len=eval('window.document.'+formulario+'.length');	
	for(i=0;i<len;i++) {
		item_name=eval('window.document.'+formulario+'.elements[i].name');
		if (item_name.substr(0,9)=='checkbox_') {
			item_obj = EncontrarObjeto(item_name);
			objChequeados = EncontrarObjeto(idCheck);
			item_obj.checked=objChequeados.checked;
			//item_obj.checked=window.document.formulario.checkbox_todos.checked;
		}	//if
	} // for
}
//-----------------------------------------------------------------
function deleteFila(idFila) {
	var objFila  = EncontrarObjeto(idFila);
	objFila.parentNode.removeChild(objFila);
	max_fila_seleccionados--;		
}
//-----------------------------------------------------------------
function deleteAllFila(idTabla) {
	var objTabla = EncontrarObjeto(idTabla);	
	if (objTabla != null) {
		var cant_filas=objTabla.rows.length;	
		for (i=1;i<cant_filas ;i++) {			// En la 0 esta el titulo
			deleteFila(objTabla.rows[1].id);
		}	
	}	
}
//-----------------------------------------------------------------
function newFila(idTabla, dic_codigo) {
	var objFila = EncontrarObjeto(idTabla);
	newNodoFila(idTabla, dic_codigo);
}
//-----------------------------------------------------------------
function buscarSeleccionables(formulario,divlistaSeleccionables,exp_numero,	act_codinap,act_nombre,formact_codigo,tipoact_codigo,con_dispo,dis_numero) {
		
	var item_obj = EncontrarObjeto(divlistaSeleccionables);
	var objAguarde = EncontrarObjeto('idAguarde');	
	objAguarde.innerHTML='Aguarde ...';	
	item_obj.innerHTML="";

	var ajax=nuevoAjax();
	var datos="exp_numero="+trim(exp_numero)+"&act_codinap="+trim(act_codinap);
		datos=datos+"&con_dispo="+con_dispo+"&dis_numero="+trim(dis_numero);
	    datos=datos+"&act_nombre="+trim(act_nombre)+"&formact_codigo="+formact_codigo+"&tipoact_codigo="+tipoact_codigo;

	var archivo = "actividad_dictamen_visualiz_ajax.dhtml";
//	var direccion= archivo+"?"+datos;  x GET

	ajax.open("POST",archivo,true);
//	ajax.open("GET",direccion,true); x GET
	ajax.onreadystatechange=function() {
		if (ajax.readyState==4) {	
			objAguarde.innerHTML='';	
			item_obj.innerHTML=ajax.responseText;	
			return true;
		}
	}	
//	ajax.send(null);	x GET
	ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded'); // x GET NO VA
	ajax.send(datos);		

	objAguarde.innerHTML='';	
	return false;
}
//------------------------------------------------------------------------------
function armarListaDictamenes(){
	var objTabla = EncontrarObjeto('tabla_seleccionados_programacion');	
	var i, cadena ;
	cadena="";
	for (i=1;i<objTabla.rows.length;i++) {
		cadena = cadena + objTabla.rows[i].id.substr(25)+"_";
	}	
	
	objTabla = EncontrarObjeto('tabla_seleccionados_autodesarrollo');	
	if (objTabla!=null) {
		for (i=1;i<objTabla.rows.length;i++) {
			cadena = cadena + objTabla.rows[i].id.substr(25)+"_";
		}	
	}	
 	return cadena.substr(0,+(cadena.length-1));
}
