//-----------------------------------------------------------------------------------------------------	
	function BuscarPrestadorInstitucional($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxpresins_codigo'=>0);
		$sparam+=array('pxpresins_nombre'=>0);
		$sparam+=array('pxpresins_estado'=>0);
		$sparam+=array('ppresins_codigo' =>"");
		$sparam+=array('ppresins_nombre' =>"");
		$sparam+=array('ppresins_estado' =>"-1");
		$sparam+=array('porderby' =>"presins_nombre");

		if (isset ($ArregloDatos['presins_codigo']))
		{
			if ($ArregloDatos['presins_codigo']!="")
			{	
				$sparam['ppresins_codigo']= $ArregloDatos['presins_codigo'];
				$sparam['pxpresins_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['presins_nombre']))
		{
			if ($ArregloDatos['presins_nombre']!="")
			{	
				$sparam['ppresins_nombre']= $ArregloDatos['presins_nombre'];
				$sparam['pxpresins_nombre']= 1;
			}
		}
		if (isset ($ArregloDatos['presins_estado']))
		{
			if ($ArregloDatos['presins_estado']!="")
			{	
				$sparam['ppresins_estado']= $ArregloDatos['presins_estado'];
				$sparam['pxpresins_estado']= 1;
			}
		}
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_prestador_institucional_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el Prestador Institucional.";
			$errormail="Error al buscar el Prestador Institucional.".$errno;
			return false;
		}

		return true;
	}
