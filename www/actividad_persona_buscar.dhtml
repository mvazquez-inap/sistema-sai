<script type="text/javascript">
//------------------------------------------------------------------------------------------------
var vec_tipo = new Array();
cargarTipoActividad(); // Carga arreglo con tipos.	vec_tipo
//------------------------------------------------------------------------------------------------
function cargarTipoActividad() {	<?php 
	if(!$conexion->ejecutarStoredProcedure("sel_tipo_actividad_orden",array('porderby'=>"tipoact_descripcion"),$resultado,$numfilas,$errno))	{
		$txt_sys_mail="Error al buscar el tipo.";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar el Tipo de Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$i=0;
	while ($fila_tipo = mysqli_fetch_assoc($resultado)){
		echo "vec_tipo[".$i."]=new Array('".$fila_tipo['formact_codigo']."','".$fila_tipo['tipoact_codigo']."','".htmlspecialchars($fila_tipo['tipoact_descripcion'],ENT_QUOTES)."');\n\t";			
		$i++;
	}
?>
}
//------------------------------------------------------------------------------------------------
function CantTipoxFormato(formact_codigo) {	
	var cant=0;
	for (i=0; i<vec_tipo.length; i++) {
		if (vec_tipo[i][0] == formact_codigo) {
			cant++;
		}	
	}
	return cant;
}
//------------------------------------------------------------------------------------------------
function CambioFormato(formact_codigo,tipoact_codigo)	{

	var objTipo = EncontrarObjeto(tipoact_codigo);	
	var i;
	
	while(objTipo.length>0)
		objTipo[0] = null;

	objTipo.options[0] = new Option("-- Seleccione Tipo de Actividad",'');
 	
	for(i = 0; i < vec_tipo.length; i++)
		if (vec_tipo[i][0] == formact_codigo)
			objTipo.options[objTipo.options.length] = new Option(vec_tipo[i][2], vec_tipo[i][1]);

	objTipo.options[0].selected=true	
}
//------------------------------------------------------------------------------------------------
function Validar(formulario) {
	var es_personal = !(formulario.formact_codigo.value!=<?php echo FORMATOAUTO ?> || (formulario.formact_codigo.value==<?php echo FORMATOAUTO ?> && formulario.tipoact_codigo.value==<?php echo TIPOACTAUTOEVASIS ?>));

	if (!es_personal) { 	
		// Fecha de Inicio
		if (formulario.actprog_fecha_inicio.value!="" && !ValidarFecha(formulario.actprog_fecha_inicio.value))	{
			alert("La fecha de inicio de la programación no es válida");
			formulario.actprog_fecha_inicio.focus();
			return false;
		}
		// Fecha de fin
		if (formulario.actprog_fecha_fin.value!="" && !ValidarFecha(formulario.actprog_fecha_fin.value)) {
			alert("La fecha de finalización de la programación no es válida");
			formulario.actprog_fecha_fin.focus();
			return false;
		}
		// Si se seleccionan ambas, Fecha de Inicio >= Fecha de Fin 
		if (formulario.actprog_fecha_inicio.value!="" && formulario.actprog_fecha_fin.value!="") {
			var fechainicio=ConvertirFecha(formulario.actprog_fecha_inicio.value,'dd/mm/aaaa','aaaammdd');
			var fechafin=ConvertirFecha(formulario.actprog_fecha_fin.value,'dd/mm/aaaa','aaaammdd');
			if (fechainicio>fechafin) 	{
				alert("La fecha de finalización debe ser mayor o igual que la fecha de inicio");
				formulario.actprog_fecha_inicio.focus();
				return false;
			}
		}
			
	}  else {

		// Valido cuit
		if(formulario.pers_cuilt.value!="" && !ValidarContenido(formulario.pers_cuilt.value,"CUIT"))	{
			alert("El CUIT/CUIL/CDI no es válido");
			formulario.pers_cuilt.focus();
			return false;	
		}
	}
	return true;
}
//------------------------------------------------------------------------------------------------
function DetalleDictamen(cambio,formact_codigo,tipoact_codigo)	{

	var idDetalleNOPersonal = document.getElementById('datos_programacion');
	if (cambio=='cambio_tipo') { 
		if (formact_codigo==""  
			||  ((formact_codigo!= <?php echo FORMATOAUTO ?> && formact_codigo!= <?php echo FORMATOEFORMAL ?>) || (formact_codigo==<?php echo FORMATOAUTO ?> && tipoact_codigo==<?php echo TIPOACTAUTOEVASIS ?>))) {
			CambiarEstado_Visibilidad('datos_programacion','visible');
		} else {
			CambiarEstado_Visibilidad('datos_programacion','invisible');
		}
		
		
	} else { // cambia el formato
	
		if (formact_codigo==""  
					|| formact_codigo!= <?php echo FORMATOEFORMAL ?>) {
			CambiarEstado_Visibilidad('datos_programacion','visible');	
		} else {
			CambiarEstado_Visibilidad('datos_programacion','invisible');	
		}
	}	
	
	if (formact_codigo==""  ||  formact_codigo != <?php echo FORMATOEFORMAL ?> )
		CambiarEstado_Visibilidad('idTablaFiltrosDictamen','visible');
	else
		CambiarEstado_Visibilidad('idTablaFiltrosDictamen','invisible');

	
	
} 
