	function BorrarDatosPers($pers_codigo)
	{
		if(!$this->_DatosValidosBorrarDatosPers($pers_codigo,$datosvalidados))
			return false;


		$esAgente = $this->PersonaEsAgente($datosvalidados["pers_codigo"]);
		$esActividad_autodesarrollo_persona = $this->PersonaEsActividadAautodesarrolloPersona($datosvalidados["pers_codigo"]);
		$esActividad_autodesarrollo_dictamen = $this->PersonaEsActividadAautodesarrolloDictamen($datosvalidados["pers_codigo"]);
		$esActividad_externa_persona= $this->PersonaEsActividadExternaPersona($datosvalidados["pers_codigo"]);
		$esComision_persona= $this->PersonaEsComisionPersona($datosvalidados["pers_codigo"]);

		if (!$esActividad_autodesarrollo_persona && !$esActividad_autodesarrollo_dictamen && !$esActividad_autodesarrollo_dictamen && !$esActividad_externa_persona && !$esComision_persona) {
		

			//baja física
		
			if ($esAgente) {
				$spnombre="del_agente_xpers_codigo";
				$spparam=array(
					'ppers_codigo'=>$datosvalidados["pers_codigo"]
				);			
		
				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
				{
					$error="Error al eliminar los datos laborales.";
					$errormail="Error al eliminar en la tabla agente".$errno;
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}

			}
				
			$spnombre="del_persona_xpers_codigo";
			$spparam=array(
				'ppers_codigo'=>$datosvalidados["pers_codigo"]
			);			
		
		} else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"La persona se encuentra registrada en alguna actividad INAP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
			return false;
		/*
				//baja lógica
				$spnombre="upd_persona_cambio_estado_xpers_codigo";
				$spparam=array(
					'ppers_codigo'=>$datosvalidados["pers_codigo"] ,
					'ppers_estado'=>PERSONABAJA ,						
					'pultmodusuario'=>$_SESSION['usuariocod'] ,
					'pultmodfecha'=> date("Y/m/d H:i:s")
					);			
					
		*/			
		}
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		{
			$error="Error al eliminar la persona.";
