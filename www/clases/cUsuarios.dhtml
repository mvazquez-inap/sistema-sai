			<td class="textoEtiquetaDatoResaltado" width="20%">
				<input type="text" name="<?php echo $inputName ?>" id="<?php echo $inputName ?>" size="11" maxlength="11" class='textoInput' value="<?php echo  trim($cuit) ;?>">					
			</td>

			<td class="textoEtiquetaDato" width="5%" align="left">
					<a href='javascript:void(0)' onClick="Popup('usuario_selector.dhtml?formulario=<?php echo $formularioName ?>&amp;destino=<?php echo $inputName ?>&amp;estado=&amp;volver=1','ventana_descripciones',630,360,screen.availWidth-650,screen.availHeight-420,'yes');"><img src="images/searchsai.jpg" alt="Buscar" border="0" style="vertical-align:-5px"></a>
			</td>
			
			<td class="textoEtiqueta">
				<input type="submit" name="<?php echo $confirmName ?>" value="Confirma" onClick="return ValidarIngresoCuit(<?php echo $formularioName ?>);" class="botones" />
			</td>
			</tr>	
		</table>	
	<?php 
		unset($_SESSION['array_busqueda_basica_usuario']); 
	} 
