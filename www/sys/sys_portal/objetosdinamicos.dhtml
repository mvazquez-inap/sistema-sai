//----------------------------------------------------------------------------------------- 
class cObjetosDinamicos
{
	var $msg_error;
	var $pagina;
	
	function cObjetosDinamicos()
	{
		$this->msg_error = "";
	}

	function Setear($parametros)
	{
		$this->pagina=$parametros["pagina"];
		return true;
	}
	
	function Mostrar($codigohtml,&$salida)
	{
		$salida="";
		$seprodujoerror=false;

		$partes=array();
		cSepararHTML::ProcesarHTML($codigohtml,$partes);

		foreach($partes as $comando)		
		{
			// si es un comando
			if(is_array($comando))
			{
				// si no existe la clase para dar soporte al comando
				if(!class_exists($comando["Tipo"]))
				{
					$this->msg_error.="Clase ".$comando["Tipo"]." no encontrada";
					return false;
				}
				else
				{
					$componente=new $comando["Tipo"]();
					if($componente->Setear($comando+array("pagina"=>$this->pagina)))
					{
						if(!$componente->Mostrar($salida))
							$seprodujoerror=true;
					}
					else
						$seprodujoerror=true;
						
					$this->msg_error.=$componente->RetornarMsgError();
				}
			}
			else
				$salida.=$comando;
		}

		return !$seprodujoerror;
	}
}

