					indicemodulo=elemento;
			}
			if(indicemodulo>-1)
			{		
				if (grilla[indiceroljuris][2][indicemodulo][1]=='F')
					formulario.checkbox_<?=$filamodulos['modulocod']?>.disabled=true;
			}
		<?php }
	?>
	}

	return true;
}

