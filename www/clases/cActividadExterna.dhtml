	function MostrarDatoActividadExterna($conexion,$operacion,$fila_actividad=array()) {

	$result=true;
		
	// si queda esta opcion no mandar la conexion
	if ($operacion=="A") {
	   $es_modif = false;
	} elseif ($operacion=="M" || $operacion=="V") {   
	   	$es_modif = true;
	   } else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en la llamada, operación inválida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
	   }

	$jurisdicciones	= new jurisdicciones;
	if(!$jurisdicciones->BuscarRaizTipoOrg(TABGRALES_TIPOORG_NAC_EJ,array(),TABGRALES_TS_ARRAY,$nodo_jurisd,array(),$CodError)) {
		$txt_sys_mail="Error buscando la raiz del árbol de jurisdicciones.";
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar el organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
	}

	$ok = true;
 	if ($es_modif) {
		$ok=$this->ObtenerOrganismoInstitucion($fila_actividad['actividad_externa']['orgapri_codigo'],
										    $fila_actividad['actividad_externa']['jurisdid_apn'],
										    $fila_actividad['actividad_externa']['orgapub_codigo'],				
										    $jurisdnom,$sector_org,$tipoorg_codigo,$jurisdid);
	} else {

		$jurisdnom="";
		$jurisdid="jurisdid_apn";
		$tipoorg_codigo = ORGANISMO_APN;
		$sector_org = ORGANISMO_PUBLICO;
	}

	if ($ok) {	

		// El codigo va el generado en caso de mofificacion, visualización en otro caso se ignora porque
		// se va a generar automáticamente
?>		
	<!-- Datos comunes de actividad -->
	<table width="100%" class="textoTablaDato" align="center" cellpadding="2">
		<tr>
			<td colspan="2" >
				<fieldset class="bordeDetalleRegistro">
				<legend class="textoLeyendaDetalleRegistro">Datos Actividad </legend>
				<table width="100%" class="textoTablaDato" align="center">
				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Nombre</td>
					<td class="textoEtiquetaDatoResaltado">
					<textarea cols="100" rows="2" class=<?php echo ($operacion=="V")?"'inputReadonly' readonly='true'":"'textoInput'" ?>  onblur="PasarAMayusculas('act_nombre')" id="act_nombre"  name="act_nombre" style="width:400px" ><?php echo ($es_modif)?htmlspecialchars($fila_actividad['actividad']['act_nombre'],ENT_QUOTES):""; ?></textarea>
					<?php  if (!$es_modif) { ?>
					 		<input type="hidden" name="act_codinap" id="act_codinap" size="21" maxlength="20" value="<?php echo ($es_modif)?htmlspecialchars($fila_actividad['actividad']['act_codinap'],ENT_QUOTES):"##"; ?>"> 
					<?php  } ?>					
					</td>
				</tr>				
				<?php  if ($es_modif) { ?>
					<tr>
						<td valign="top" width="15%" class='textoEtiqueta'>Código INAP</td>
						<td class="textoEtiquetaDatoResaltado">
							<input type="text" name="act_codinap" id="act_codinap" class="inputReadonly" readonly="readonly" size="21" maxlength="20" value="<?=htmlspecialchars($fila_actividad['actividad']['act_codinap'],ENT_QUOTES)?>">
						</td>
					</tr>
				<?php  } ?>					
				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Observación</td>
					<td class="textoEtiquetaDatoResaltado">
					<textarea cols="100" rows="5" name="act_obs"  id="act_obs" class=<?php echo ($operacion=="V")?"'inputReadonly' readonly='true'":"'textoInput'" ?>  style="width:400px" ><?php echo ($es_modif)?htmlspecialchars($fila_actividad['actividad']['act_obs'],ENT_QUOTES):"" ?></textarea>
					</td>
				</tr>
				</table>
				</fieldset> 
			</td>
		</tr>
	</table>
	
	<!-- Varia según el formato (Externa)-->
	<table width="100%" class="textoTablaDato" align="center" cellpadding="2">
		<tr>
			<td colspan="2" >
				<fieldset class="bordeDetalleRegistro">
				<legend class="textoLeyendaDetalleRegistro">Datos Actividad Externa </legend>
				<table width="100%" class="textoTablaDato" align="center">
				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Observación</td>
					<td class="textoEtiquetaDatoResaltado">
						<textarea  rows="5" cols="100" name="actext_obs" id="actext_obs" class=<?php echo ($operacion=="V")?"'inputReadonly' readonly='true'":"'textoInput'" ?> style="width:400px"><?php echo ($es_modif)?htmlspecialchars($fila_actividad['actividad_externa']['actext_obs'],ENT_QUOTES):"" ?></textarea>
					</td>
				</tr>
				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Duración</td>
					<td class="textoEtiquetaDatoResaltado"><input type="text" name="actext_duracionhs" id="actext_duracionhs" class=<?php echo ($operacion=="V")?"'inputReadonly' readonly='true'":"'textoInput'" ?> size="5" maxlength="5" value="<?php echo ($es_modif)?htmlspecialchars($fila_actividad['actividad_externa']['actext_duracionhs'],ENT_QUOTES):""; ?>">&nbsp;&nbsp;hora/s</td>
				</tr>
				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Detalle sobre la duración</td>
					<td class="textoEtiquetaDatoResaltado">
					<textarea cols="100" rows="5" name="actext_duraciondetalle"  id="actext_duraciondetalle" class=<?php echo ($operacion=="V")?"'inputReadonly' readonly='true'":"'textoInput'" ?> style="width:400px" ><?php echo ($es_modif)?htmlspecialchars($fila_actividad['actividad_externa']['actext_duraciondetalle'],ENT_QUOTES):"" ?></textarea>
					</td>
				</tr>

				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Tipo de Certificaci&oacute;n</td>
					<td class="textoEtiquetaDatoResaltado">
<?php					if ($operacion=="V") {
						if ($conexion->TraerCampo("tipo_certificacion","tipocert_descripcion",array("tipocert_codigo='",$fila_actividad['actividad_externa']['tipocert_codigo'],"'"),$descri,$numfilas,$errorcod)) 
				?>			<input name="tipocert_codigo" id="tipocert_codigo" class='inputReadonly' readonly='readonly' style="width:400px" value="<?php echo htmlspecialchars($descri,ENT_QUOTES)?>" />
				<?php	} else {				
