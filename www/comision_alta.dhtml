<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oComision = new cComision($conexion);
//----------------------------------------------------------------------------------------- 
?>
<script type="text/javascript">
<?php  $oComision->ValidarFormAltaComision(); ?>
</script>
<?php 
$destino_formulario_selector="comision_alta.dhtml";
$ok = true;
$_SESSION['carga_inicial']=true;

// Crear actividad segun el usuario logeado
switch ($_SESSION['rolcod']) {
	case USUCURSOINAP:
		$oActividadCurso = new cActividadCursoInap($conexion); 
		$formact_codigo=FORMATOCURSO;
		$tipoact_codigo=TIPOACTCURSOINAP;
		break;
	case USUORGANISMO:
	case COORDINADORTECNICO:
		$oActividadCurso = new cActividadCursoJurisdiccional($conexion); 
		$formact_codigo=FORMATOCURSO;
		$tipoact_codigo=TIPOACTCURSOJURISD;
		break;
}		
?>
<form action="<?php echo $destino_formulario_selector ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<?php $oActividadCurso->PidoActividadProgramacion('formulario_seleccion','act_codigo','formact_codigo','tipoact_codigo','actprog_sec','AltaComision'); ?>		
</form>	
<br />
<?php	
$act_seleccionada_ok = false;

if (isset($_POST['act_codigo'])) {

  $act_codigo=$_POST['act_codigo'];
  $tipoact_codigo=$_POST['tipoact_codigo'];
  $formact_codigo=$_POST['formact_codigo'];
  $actprog_sec=$_POST['actprog_sec'];

  $act_seleccionada_ok = true; 

} elseif (isset($_GET['act_codigo'])) { 
	
	$act_codigo=$_GET['act_codigo'];
	$tipoact_codigo=$_GET['tipoact_codigo'];
	$formact_codigo=$_GET['formact_codigo'];
	$actprog_sec=$_GET['actprog_sec'];

    $act_seleccionada_ok = true; 
} 
if ($act_seleccionada_ok) {
	if ($oActividadCurso->MostrarDatosActividadAsignable($conexion,$act_codigo,$formact_codigo,$tipoact_codigo,$actprog_sec)) {
		$destino_formulario_upd="comision_alta_upd.dhtml";	?>	
		<form action="<?php echo $destino_formulario_upd ?>" method="post" name="formulario">
	<?php		if($oComision->MostrarDatosComision($conexion,"A")) { ?>
				<table width="100%" class="textoTablaDato" align="center">
					<tr align="center">
						<td colspan="2" valign="top">
							<input type="submit" name="boton_confirma" class="botones" value="Confirma Alta" onClick="return ValidarFormAltaComision(formulario,'A');"> 
							<input type="hidden" name="act_codigo" value="<?php echo htmlspecialchars($act_codigo,ENT_QUOTES) ?>" />
							<input type="hidden" name="actprog_sec" value="<?php echo htmlspecialchars($actprog_sec,ENT_QUOTES) ?>" />
							&nbsp;&nbsp;&nbsp;&nbsp;
						</td>
					</tr>	
				</table>
	<?php 	 	} // MostrarDatosComision ?>
		</form>		
<?php	}	
} // act_seleccionada_ok
$oEncabezados->PieMenuEmergente(); 
?>