	function DescargarExcelActividad()	{


	$oActividad = new cActividad($this->conexion);
	$oDictamen = new cDictamen($this->conexion);					

	$ArregloDatos1= array();
	$ArregloDatos1['orderby']="presdoc_apellido";

	if(!$this->BuscarPrestadorDocentexActividad($ArregloDatos1,$numfilas,$resultado_presdoc,$error,$errormail)) {
		$txt_sys_mail="\nerror=".$error;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}

	$arrayresult = array();
	$i=1;
	$presdoc_actual = "*";
	while ($fila_presdoc = mysqli_fetch_assoc($resultado_presdoc)) { 

		if ($fila_presdoc['presdoc_codigo'] != $presdoc_actual) { 
			$presdoc_actual = $fila_presdoc['presdoc_codigo'];
			
	
	
            $ArregloDatos= array();
            $ArregloDatos['presdoc_codigo']=$fila_presdoc['presdoc_codigo'];
        
            if(!$this->BuscarPrestadorDocentexActividad($ArregloDatos,$numfilas_poract,$resultado_poract,$error,$errormail)) {
                $txt_sys_mail="\nerror=".$error;
                FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
                return false;			
            }
        
    
            if($numfilas_poract>0)
            {
                
                while ($fila_poract=mysqli_fetch_assoc($resultado_poract))	{
                
                    if (!$oActividad->TraerDatosActividad($fila_poract['act_codigo'],$filaact,$es_modif)) {
                        FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
                        $ok = false;
                    }
                    
                    // busco las fecha de programación 
                    // traigo los dictámenes DICTAMENACTIVO de la actividad
                    $ArregloDatosDic = array();
                    $ArregloDatosDic += array("act_codigo"=>$fila_poract['act_codigo']);	
                    //$ArregloDatosDic += array("dic_estado"=>DICTAMENACTIVO);							
        
                    $oDictamen->BuscarDictamen($ArregloDatosDic,$numfilasdic,$array_resultado_dictamen,$error,$errormail);
                    $fecha = "";
                    foreach ($array_resultado_dictamen as $clave=>$valor) {
                        if ($valor['dic_estado'] == DICTAMENACTIVO)
                            $fecha .= FuncionesPHPLocal::ConvertirFecha($valor['actprog_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa')." a ".FuncionesPHPLocal::ConvertirFecha($valor['actprog_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa'); 
                    }	
                    
                    $arrayresult[$i]['presdoc_cuilt']= $fila_presdoc['presdoc_cuilt'];
                    $arrayresult[$i]['presdoc_apellido']= $fila_presdoc['presdoc_apellido'];
                    $arrayresult[$i]['presdoc_nombre']= $fila_presdoc['presdoc_nombre'];
                    
                    $arrayresult[$i]['act_codinap']= $filaact['act_codinap'];
                    $arrayresult[$i]['act_nombre']= $filaact['act_nombre'];
                    $arrayresult[$i]['fecha']= $fecha;			
                    $i++;
                }
            }
            
             } 
	}	
	
	

		
		
		$nombrearchivo="prestador_docente_actividad.xls";  
		
		$oExcel= new cEscribirExcel($nombrearchivo);
		$oExcel->AddHoja('prestador_docente_actividad');
		$oExcel->EsconderGrillas();
		$oExcel->PaginaHorizontal();
		$oExcel->FormatoColumna (0,15); // cuilt
		$oExcel->FormatoColumna (1,20); // apellido
		$oExcel->FormatoColumna (2,20); // nombre
		$oExcel->FormatoColumna (3,10); // act_codinap
		$oExcel->FormatoColumna (4,60); // Actividad
		$oExcel->FormatoColumna (5,20); // Programaciones


		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor",22);
// 		Sacamos titulo		
		$i=-1;
		
// 		$i++;		
//		$oExcel->CargarDatosVariasCeldas ($i,0,0,5,'Prestadores Docentes',true);

		// Titulos de las columnas
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");

		$i++;
		$oExcel->CargarDatos ($i,0,"Cuit/Cuil",true);
		$oExcel->CargarDatos ($i,1,"Apellido",true);
		$oExcel->CargarDatos ($i,2,"Nombre",true);
		$oExcel->CargarDatos ($i,3,"Código INAP",true);
		$oExcel->CargarDatos ($i,4,"Actividad",true);
		$oExcel->CargarDatos ($i,5,"Programaciones",true);		
				
		$arrayclaves=array(	'presdoc_cuilt','presdoc_apellido','presdoc_nombre',
							'act_codinap','act_nombre', 'fecha');
		$i++;
		foreach ($arrayresult as $datos) {
			$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,array());	
			$i++;
		}
		
		$oExcel->Enviar();
	}	
	
//-----------------------------------------------------------------------------------------------------	
	function DescargarExcelComision()	{

	$oComision = new cComision($this->conexion);
	$oPrestadorDocente = new cComisionPrestadorDocente($this->conexion);
	

	$ArregloDatos= array();
	$ArregloDatos['orderby']="presdoc_apellido";

	if(!$oPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos,$numfilas_presdoc,$resultado_presdoc,$error,$errormail)) {
		$txt_sys_mail="\nerror=".$error;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}
	$arrayresult = array();
	$i=1;
	$presdoc_actual = "*";
	while ($fila_presdoc = mysqli_fetch_assoc($resultado_presdoc)) { 
	

		if ($fila_presdoc['presdoc_codigo'] != $presdoc_actual) { 
			$presdoc_actual = $fila_presdoc['presdoc_codigo'];

			$this->TraerDatosPrestadorDocente($fila_presdoc['presdoc_codigo'],$filaprestador,$es_modif);

			$ArregloDatos2= array();
			$ArregloDatos2['presdoc_codigo']=$presdoc_actual;
		
			if(!$oPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos2,$numfilas_porcomi,$resultado_porcomi,$error,$errormail)) {
				$txt_sys_mail="\nerror=".$error;
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;			
			}
		
			if($numfilas_porcomi>0)
			{
				
				
				while ($fila_comi=mysqli_fetch_assoc($resultado_porcomi))	{

						
					$ArregloDatosComision=array("comi_codigo"=>$fila_comi['comi_codigo']);	
		
					if(!$oComision->BuscarComisionAvanzada($ArregloDatosComision, $numfilasComision, $resultComision, $error, $errormail)) {
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						$ok = false;
					}

					if ($numfilasComision == 1) { 
							$fila_comision = mysqli_fetch_assoc($resultComision);
		
							$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_comision['tipoact_codigo'],"'"),$tipoact_descripcion,$numfilas_ta,$errorcod); 
		
							$arrayresult[$i]['presdoc_cuilt']=$filaprestador['presdoc_cuilt'];
							$arrayresult[$i]['presdoc_apellido']=$filaprestador['presdoc_apellido'];
							$arrayresult[$i]['presdoc_nombre']=$filaprestador['presdoc_nombre'];
							
							$arrayresult[$i]['act_codinap']=$fila_comision['act_codinap'];
							$arrayresult[$i]['tipoact_descripcion']=$tipoact_descripcion;
							$arrayresult[$i]['fecha_desde_hasta'] = isset($fila_comision['comi_fecha_inicio_ddmmaaaa'])?$fila_comision['comi_fecha_inicio_ddmmaaaa']." a ".$fila_comision['comi_fecha_fin_ddmmaaaa']:"Indefinida";
							$arrayresult[$i]['comi_codinap']= $fila_comision['comi_codinap'];
							$arrayresult[$i]['act_nombre']= $fila_comision['act_nombre'];
							$i++;
							
							
					}		
							
							
					
				}
			}	
		}	
	}
	

		
		
		$nombrearchivo="prestador_docente_comision.xls";  
		
		$oExcel= new cEscribirExcel($nombrearchivo);
		$oExcel->AddHoja('prestador_docente_comision');
		$oExcel->EsconderGrillas();
		$oExcel->PaginaHorizontal();
		$oExcel->FormatoColumna (0,15); // cuilt
		$oExcel->FormatoColumna (1,20); // apellido
		$oExcel->FormatoColumna (2,20); // nombre
		$oExcel->FormatoColumna (3,10); // act_codinap
		$oExcel->FormatoColumna (4,60); // act_nombre
		$oExcel->FormatoColumna (5,20); // comi_codinap
		$oExcel->FormatoColumna (6,20); // tipoact_descripcion
		$oExcel->FormatoColumna (7,25); // fecha_desde_hasta
		


		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor",22);
// 		Sacamos titulo		
		$i=-1;
		
// 		$i++;		
//		$oExcel->CargarDatosVariasCeldas ($i,0,0,5,'Prestadores Docentes',true);

		// Titulos de las columnas
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");

		$i++;
		$oExcel->CargarDatos ($i,0,"Cuit/Cuil",true);
		$oExcel->CargarDatos ($i,1,"Apellido",true);
		$oExcel->CargarDatos ($i,2,"Nombre",true);
		$oExcel->CargarDatos ($i,3,"Código INAP",true);
		$oExcel->CargarDatos ($i,4,"Actividad",true);
		$oExcel->CargarDatos ($i,5,"Código Comisión INAP",true);
		$oExcel->CargarDatos ($i,6,"Tipo de Actividad",true);
		$oExcel->CargarDatos ($i,7,"Realización",true);		
				
		$arrayclaves=array(	'presdoc_cuilt','presdoc_apellido','presdoc_nombre',
							'act_codinap','act_nombre', 'comi_codinap', 'tipoact_descripcion', 'fecha_desde_hasta');
		$i++;
		foreach ($arrayresult as $datos) {
			$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,array());	
			$i++;
		}
		
		$oExcel->Enviar();
	}		
