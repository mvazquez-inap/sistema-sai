//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAltaDisposicion($datos,&$datosvalidados)	{
		
		$datosvalidados=array();

		// Verifico que el número de disposicion no exista.
		$ArregloDatos=array();
		$ArregloDatos['dis_numero_exacto']=$datos["dis_numero"];

		if(!$this->BuscarDisposicion($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error buscando la disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		}				
		if ($numfilas>=1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe el <br> número de disposición:".$datos["dis_numero"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		}		
		$datosvalidados["dis_numero"]=$datos["dis_numero"];

		// Valido que los datos comunes sean válidos
		if (!$this->_DatosValidosComunesDisposicion($datos,$datosvalidados))
		   return false; 

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosEliminarDisposicion($dis_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoBaja($dis_codigo,$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		
		// La baja es física o no se puede realizar la baja (el mensaje es informativo)
		if (!$this->PosibleBajaFisica($dis_codigo))	{		
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha eliminado la disposición, pues existen dictámenes asociados a la misma.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;					  	 				
		}	
		$datosvalidados+=array('dis_codigo'=>$dis_codigo);
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifDisposicion($datos,&$datosvalidados)	{

		if (!$this->TienePermisoModificar($datos['dis_codigo'],$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		$datosvalidados['dis_codigo']=$datos['dis_codigo'];

		// Verifico que el número de disposicion no exista.
		$ArregloDatos=array();
		$ArregloDatos['dis_numero_exacto']=$datos["dis_numero"];
		if(!$this->BuscarDisposicion($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando la disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		}				
		if ($numfilas>1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe el <br> número de disposición:".$datos["dis_numero"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		} elseif ($numfilas==1) {	// hay una disposición que no es el el que se esta modificando			   
		   $fila_exp=mysqli_fetch_assoc($result);
		   if ($fila_exp['dis_codigo']!= $datos['dis_codigo']) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe el <br> número de disposición:".$datos["dis_numero"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
				return false;							   
		   }
		}
		$datosvalidados["dis_numero"]=$datos["dis_numero"];

		if (!$this->_DatosValidosComunesDisposicion($datos,$datosvalidados))
		   return false; 

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosComunesDisposicion($datos,&$datosvalidados)	{

		if (trim($datos['dis_numero'])=="") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el número del disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}	
		$datosvalidados['dis_numero']=$datos['dis_numero'];

		// Fecha de protocolización
		if (trim($datos['dis_fecha'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['dis_fecha'],"FechaDDMMAAAA"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de la disposición no es vádida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}
		$fecha_actual_AAAAMMDD=date("Y/m/d");
		$fechaincioinap="01/01/".ANOINICALINAP;
		$fechaincioinap_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($fechaincioinap,'dd/mm/aaaa','aaaa-mm-dd');
		$fecha_disposicion=FuncionesPHPLocal::ConvertirFecha($datos['dis_fecha'],'dd/mm/aaaa','aaaa-mm-dd');

		// La fecha de la disposicion no puede ser mayor a la actual o menor a la de indico de inap
		if ($fecha_disposicion < $fechaincioinap_AAAAMMDD || $fecha_disposicion > $fecha_actual_AAAAMMDD )
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de la disposición debe ser menor o igual a la actual y mayor o igual a ".$fechaincioinap,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}
		$datosvalidados['dis_fecha']=$datos['dis_fecha'];
		$datosvalidados['dis_obs']=$datos['dis_obs'];
		
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
} // class
?>