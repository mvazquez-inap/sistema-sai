	function BuscarActividadDictaminadaAvanzada($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{
	
		// Retorna también datos de la programacion, dictamen, expediente y disposición
		$sparam=array('pxact_nombre'=>0);
		$sparam+=array('pxact_codigo'=>0);
		$sparam+=array('pxact_codinap'=>0);
		$sparam+=array('pxtipoact_codigo'=>0);		
		$sparam+=array('pxactext_estado'=>0);
		$sparam+=array('pxexp_numero'=>0);
		$sparam+=array('pxdis_numero'=>0);
		$sparam+=array('pxdic_estado'=>0);
		$sparam+=array('pxdic_codigo'=>0);
		$sparam+=array('pxdis_codigo'=>0);
		$sparam+=array('pxcon_dispo'=>0);
		$sparam+=array('pxsin_dispo'=>0);
		$sparam+=array('pxactprog_sec'=>0);
		$sparam+=array('pxactprog_fecha_inicio'=>0);
		$sparam+=array('pxactprog_fecha_fin'=>0);
		$sparam+=array('pxdic_esta_visado_no'=>0);
		$sparam+=array('pxdic_esta_visado_si'=>0);

		$sparam+=array('pact_nombre'=>"");
		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('pact_codinap'=>"");
		$sparam+=array('ptipoact_codigo'=>"-1");
		$sparam+=array('pactext_estado'=>"-1");
		$sparam+=array('pexp_numero'=>"");
		$sparam+=array('pdis_numero'=>"");
		$sparam+=array('pdic_estado'=>"-1");
		$sparam+=array('pdic_codigo'=>"-1");
		$sparam+=array('pdis_codigo'=>"-1");
		$sparam+=array('pactprog_sec'=>"");
		$sparam+=array('pactprog_fecha_inicio'=>"");
		$sparam+=array('pactprog_fecha_fin'=>"");

		$sparam+=array('porderby'=>"act_nombre");		
		
		if (isset($ArregloDatos['act_codigo'])) {
			if ($ArregloDatos['act_codigo']!="") {	
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['act_nombre']))	{
			if ($ArregloDatos['act_nombre']!="")
			{	
				$sparam['pact_nombre']= $ArregloDatos['act_nombre'];
				$sparam['pxact_nombre']= 1;
			}
		}	
		if (isset ($ArregloDatos['act_codinap']))	{
			if ($ArregloDatos['act_codinap']!="")
			{	
				$sparam['pact_codinap']= $ArregloDatos['act_codinap'];
				$sparam['pxact_codinap']= 1;
			}
		}	
		if (isset($ArregloDatos['tipoact_codigo']))		{
			if ($ArregloDatos['tipoact_codigo']!="")
			{	
				$sparam['ptipoact_codigo']= $ArregloDatos['tipoact_codigo'];
				$sparam['pxtipoact_codigo']= 1;
			}
		}				
		if (isset($ArregloDatos['dic_estado']))		{
			if ($ArregloDatos['dic_estado']!="")
			{	
				$sparam['pdic_estado']= $ArregloDatos['dic_estado'];
				$sparam['pxdic_estado']= 1;
			}
		}	
		if (isset($ArregloDatos['actext_estado']))		{
			if ($ArregloDatos['actext_estado']!="")
			{	
				$sparam['pactext_estado']= $ArregloDatos['actext_estado'];
				$sparam['pxactext_estado']= 1;
			}
		}	
		if (isset ($ArregloDatos['exp_numero']))	{
			if ($ArregloDatos['exp_numero']!="")
			{	
				$sparam['pexp_numero']= $ArregloDatos['exp_numero'];
				$sparam['pxexp_numero']= 1;
			}
		}		
		if (isset ($ArregloDatos['dis_numero']))	{
			if ($ArregloDatos['dis_numero']!="")
			{	
				$sparam['pdis_numero']= $ArregloDatos['dis_numero'];
				$sparam['pxdis_numero']= 1;
			}
		}	
		if (isset ($ArregloDatos['dis_codigo']))	{
			if ($ArregloDatos['dis_codigo']!="")
			{	
				$sparam['pdis_codigo']= $ArregloDatos['dis_codigo'];
				$sparam['pxdis_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['dic_codigo']))	{
			if ($ArregloDatos['dic_codigo']!="")
			{	
				$sparam['pdic_codigo']= $ArregloDatos['dic_codigo'];
				$sparam['pxdic_codigo']= 1;
			}
		}	
		// Mandar 	1 x con disposición  
		// 			0 x sin disposición  
		if (isset ($ArregloDatos['con_disposicion'])) {
			if ($ArregloDatos['con_disposicion']!="")  {	
				$sparam['pxcon_dispo']=($ArregloDatos['con_disposicion'])?"1":"0";				
			}
		}	
		if (isset ($ArregloDatos['sin_disposicion'])) {
			if ($ArregloDatos['sin_disposicion']!="")  {	
				$sparam['pxsin_dispo']= ($ArregloDatos['sin_disposicion'])?"1":"0";				
			}
		}		
		if (isset ($ArregloDatos['actprog_sec'])) {
			if ($ArregloDatos['actprog_sec']!="") {	
				$sparam['pactprog_sec']= $ArregloDatos['actprog_sec'];
				$sparam['pxactprog_sec']= 1;
			}
		}	
		if (isset($ArregloDatos['actprog_fecha_inicio']))	{
			if ($ArregloDatos['actprog_fecha_inicio']!="")
			{	
				$sparam['pactprog_fecha_inicio']= $ArregloDatos['actprog_fecha_inicio'];
				$sparam['pxactprog_fecha_inicio']= 1;
			}
		}	
		if (isset($ArregloDatos['actprog_fecha_fin']))	{
			if ($ArregloDatos['actprog_fecha_fin']!="")
			{	
				$sparam['pactprog_fecha_fin']= $ArregloDatos['actprog_fecha_fin'];
				$sparam['pxactprog_fecha_fin']= 1;
			}
		}	
		if (isset ($ArregloDatos['orderby']))	{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		if (isset($ArregloDatos['dic_esta_visado']) && $ArregloDatos['dic_esta_visado']!="")	{
				$sparam['pxdic_esta_visado_si']= $ArregloDatos['dic_esta_visado'];
				$sparam['pxdic_esta_visado_no']= $ArregloDatos['dic_esta_visado'];
		}


		if (isset ($ArregloDatos['orderby']))	{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}
		$spnombre="sel_actividad_externa_dictaminada_avanzada_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar actividades dictaminadas.";
			$errormail="Error al ejecutar una búsqueda avanzada de actividades dictaminadas.".$errno;
			return false;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function ListarDisenoActividadPDF($act_codigo) {

		function GenerarActividadDiseno(&$pdf,$filaexterna) {
	
			$pdf->AddAcividadDiseno();
			$pdf->Set('datos_actividad',$filaexterna);		
			$pdf->Set('formact_codigo',FORMATOEXT);
			$pdf->Set('tipoact_codigo',$filaexterna['actividad_externa']['tipoact_codigo']);
		
		} // GenerarActa
	
		if (!$this->TraerDatosActividadExterna($act_codigo,$filaexterna,$es_modif))  {
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;		
		} elseif (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;		
		}
	
		$descri="";
		if( $this->conexion->TraerCampo("tipo_certificacion","tipocert_descripcion",array("tipocert_codigo='",$filaexterna['actividad_externa']['tipocert_codigo'],"'"),$descri,$numfilas,$errorcod)) 
			$filaexterna['actividad_externa'] += array('tipocert_descripcion'=>$descri);
	
		$descri="";
		if(isset($filaexterna['actividad_externa']['jurisdid_apn'])) { 
			$jurisdicciones	 = new jurisdicciones;					
			if ($jurisdicciones->SelectJurisdxID($filaexterna['actividad_externa']['jurisdid_apn'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError))  						
				$filaexterna['actividad_externa'] += array('jurisdid_apn_nombre'=>$fila_jurisd[$filaexterna['actividad_externa']['jurisdid_apn']]['jurisdnom']);					
		}
		
		$descri="";
		if( isset($filaexterna['actividad_externa']['orgapub_codigo'] ) && $this->conexion->TraerCampo("organismo_publico","orgapub_nombre",array("orgapub_codigo='",$filaexterna['actividad_externa']['orgapub_codigo'],"'"),$descri,$numfilas,$errorcod)) 
			$filaexterna['actividad_externa'] += array('orgapub_nombre'=>$descri);
	
		$descri="";
		if( isset($filaexterna['actividad_externa']['orgapri_codigo'] ) && $this->conexion->TraerCampo("organismo_privado","orgapri_nombre",array("orgapri_codigo='",$filaexterna['actividad_externa']['orgapri_codigo'],"'"),$descri,$numfilas,$errorcod)) 
			$filaexterna['actividad_externa'] += array('orgapri_nombre'=>$descri);
	
		$descri	= "";	
		if($this->conexion->TraerCampo("paises","paisnom",array("paiscod='",$filaexterna['actividad_externa']['pais_codigo'],"'"),$descri,$numfilas,$errorcod))
			$filaexterna['actividad_externa'] += array('paisnom'=>$descri);
	
		if ($filaexterna['actividad_externa']['pais_codigo'] == ARGENTINA) { 
			$descri	= "";	
			if ($this->conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$filaexterna['actividad_externa']['prov_codigo'],"'"),$descri,$numfilas,$errorcod))
				$filaexterna['actividad_externa'] += array('provincianom'=>$descri);		
		}
		
	 	$descri="";
	 	if ($this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$filaexterna['actividad_externa']['actext_estado'],"'"),$descri,$numfilas,$errorcod)) 
	 		$filaexterna['actividad_externa'] += array('actext_estado_desc'=>$descri);
	 
		$pdf = new cActividadDisenoPDF();
		GenerarActividadDiseno($pdf,$filaexterna); 
		$pdf->MostrarActividadDiseno($this->conexion);
		$pdf->Output("disenoActividad.pdf","I");
	
		return true;
	}		
//-----------------------------------------------------------------------------------------------------	
	function ListarDisenoActividad($act_codigo) {
	// Se define en las subclases 
	$ok=true;
 	if (!$this->TraerDatosActividadExterna($act_codigo,$filaexterna,$es_modif))
   		$ok=false;		
	
	if (!$es_modif) {
		$txt_sys_mail="\nact_codigo=".$act_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		$ok=false;		
	}
