				$sparam['pxexp_codigo']= 1;
			}
		}

		if (isset ($ArregloDatos['dis_codigo']))
		{
			if ($ArregloDatos['dis_codigo']!="")
			{
				$sparam['pdis_codigo']= $ArregloDatos['dis_codigo'];
				$sparam['pxdis_codigo']= 1;
			}
		}

		if (isset ($ArregloDatos['dic_codigo']))
		{
			if ($ArregloDatos['dic_codigo']!="")
			{
				$sparam['pdic_codigo']= $ArregloDatos['dic_codigo'];
				$sparam['pxdic_codigo']= 1;
			}
