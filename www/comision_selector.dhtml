				case "Candidato":				
					$ArregloDatos['comi_estado']  = COMISIONABIERTA.",".COMISIONNUEVA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP;		
					$ArregloDatos['comi_web'] = "S";		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "NUEVA, ABIERTA";
				break; 

				case "Rectificar":				
					$ArregloDatos['comi_estado'] = COMISIONCERRADA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP;		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
					$estado_leyenda = "CERRADA";
				break; 

				case "Volcar Resultados":	
					$ArregloDatos['comi_estado']  = COMISIONABIERTA;					
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP;		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
