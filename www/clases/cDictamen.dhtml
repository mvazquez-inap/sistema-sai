		return false;
	}
	
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoModificarProgramacion($act_codigo, $actprog_sec) {

		// verifico que la programación exista
		if (!$this->TraerDatosActividadProgramacion($act_codigo, $actprog_sec, $fila_progact, $es_modif) ) 
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo."\nactprog_sec=".$actprog_sec;		
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Programacion a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
		
		// busco el estado del dictamen para determinar el estado de la programación
		if (!$this->TraerDatosDictamen($fila_progact['dic_codigo'], $fila_dictamen, $es_modif) ) 
			return false;

		$txt_sys_mail="\ndic_codigo=".$fila_progact['dic_codigo'];		
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe el dictamen para la programación a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
		if ($_SESSION["rolcod"] != SUPERUSUARIO) {
			if ($fila_dictamen['dic_estado'] == DICTAMENNUEVO || $fila_dictamen['dic_estado'] == DICTAMENRECHAZADO ) 
				return true;		
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","DICTAMENESTADO","' and constantecod='",$fila_dictamen['dic_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado del Dictamen (".$descri."), no le permite modificar la programación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;		
			}
		} else 
			return true;		
		
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar la Programación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}			
