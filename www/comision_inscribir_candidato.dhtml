			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar datos 2.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

		 ?>
		 <input type="hidden" name="tipoact_codigo" id="tipoact_codigo" value="<?php echo $tipoact_codigo?>" />
