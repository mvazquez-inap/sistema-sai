	                        <td style="text-align:center">
								<?php echo FuncionesPHPLocal::ConvertirFecha(utf8_decode($datosactividad->fecha_inicio),'aaaa-mm-dd','dd/mm/aaaa'); ?>
							</td>
	                        <td style="text-align:center">
								<?php echo FuncionesPHPLocal::ConvertirFecha(utf8_decode($datosactividad->fecha_fin),'aaaa-mm-dd','dd/mm/aaaa'); ?>
							</td>
							<td style="text-align:left">
								<?php  echo utf8_decode($datosactividad->exp_numero); ?>
							</td>
							<td style="text-align:center">
								<?php  echo utf8_decode($datosactividad->dis_numero); ?>
							</td>
	                  		<td style="text-align:center">
								<?php  echo FuncionesPHPLocal::ConvertirFecha(utf8_decode($datosactividad->dis_fecha),'aaaa-mm-dd','dd/mm/aaaa'); ?>
							</td>
	
	                        
		                  </tr>	 
		<?php				}
					}
				}
	?>
		</table>
	<?php			
			}		
