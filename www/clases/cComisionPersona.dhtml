<?php class cComisionPersona extends cComision {

	function ValidarFormAltaInscribirAlumno()	{
?>		
		function ValidarVacantes(formulario, comi_codigo) {
				var ajax2=nuevoAjax();
				var variables="?comi_codigo="+comi_codigo;
				var direccion= "comision_validar_vacantes_ajax.dhtml"+variables;
				var ejecutook=false;
				
				ajax2.open("GET",direccion,true);
				ajax2.onreadystatechange=function() {
					if (ajax2.readyState==4) {	
						if (ajax2.responseText.substr(0,15)=="//tienepermisos") 	{	
							eval (ajax2.responseText);
							if (!ejecutook){
								if (confirm ('Ya se ha superado el total de vacantes y la sobreventa en la inscripción. ¿Desea inscribir a la persona?'))
									document.formulario.submit();
							} else {
								document.formulario.submit();
								return true;
							}
						} else {	
							return false;
						}
					}
				}		
				ajax2.send(null);		
				return false;
		}

		function ValidarFormAltaInscribirAlumno (formulario, operacion) {
		
			if (formulario.tipo_individual_con_org[0].checked) {

				// Situación escalafonaria    - [esc_agrup_niv_grado] 	- [OBLIG]
				if ((trim(formulario.esc_agrup_niv_grado.value)=="")){
					alert("Debe ingresar una situación escalafonaria válida");
					return false;
				}	

				if (trim(formulario.jurisdid.value)==""){
					alert("Debe ingresar un Organismo donde trabaja el agente válido");
					formulario.jurisdid.focus();
					return false;
				}	

				if (formulario.escalafon.value == "A") {
					if ((trim(formulario.agfunc_codigo.value)=="")){
						alert("Debe ingresar una función válida");
						formulario.agfunc_codigo.focus();
						return false;
					}	
					
				}

			}	
					
			if (trim(formulario.jurisdid_coordinacion.value)==""){
				alert("Debe ingresar un Organismo del Coordinador T\u00e9cnico de Capacitaci\u00f3n válido");
				formulario.jurisdid_coordinacion.focus();
				return false;
			}	
	
			if(formulario.pers_email.value!="" && !ValidarContenido(formulario.pers_email.value,"Email"))
			{
				alert("Debe ingresar un mail válido");
				formulario.pers_email.focus();
				return false;	
			}
			
			if (trim(formulario.nivest_codigo.value)==""){
				alert("Debe ingresar el Último nivel de estudios alcanzado");
				formulario.nivest_codigo.focus();
				return false;
			}	

			if (trim(formulario.agentes_a_cargo.value)==""){
				alert("Debe ingresar la Cantidad de agentes a cargo");
				formulario.agentes_a_cargo.focus();
				return false;
			}	
			
			if (trim(formulario.paiscod_revista.value)==""){
				alert("Debe ingresar el País de revista");
				formulario.paiscod_revista.focus();
				return false;
			}				
						
			if (formulario.paiscod_revista.value == <?php echo ARGENTINA?> ) {
				if (trim(formulario.provinciacod_revista.value)==""){
					alert("Debe ingresar la provincia de revista");
					formulario.provinciacod_revista.focus();
					return false;
				}
			}		
						
			if (operacion == "I")
				ValidarVacantes(formulario,formulario.comi_codigo.value);
			else 
				document.formulario.submit();
				
			return true;
		}

		//-----------------------------------------------------------------------------------------------------	
		function SeleccionTieneOrganismo(formulario, seccion ){
			var elSelect = document.getElementById(seccion);
			if (formulario.tipo_individual_con_org[0].checked) {
				elSelect.style.display ="block";
			} else {
				elSelect.style.display ="none";
			}
		}
		
		//-----------------------------------------------------------------------------------------------------	
		function LimpioOrganismoIndividual(docu,jurisdid,jurisdnom,jurisdid_coordinacion,es_orga_publico) {
			if(es_orga_publico == '<?php echo NO ?>') {		
				var elValor=docu.getElementById(jurisdid);
				SetearTexto(jurisdid,'',docu);
				var elValor=docu.getElementById(jurisdnom);
				SetearTexto(jurisdnom,'',docu);
				var elSel=docu.getElementById(jurisdid_coordinacion);
                elSel.selectedIndex = -1;
				elSel.value = <?php echo NO_CORRESPONDE ?>;
			}		
		}	
		
	
	
	function SeleccionPais(formulario){
		var elSelect = document.getElementById('datos_provincia');
		if (formulario.paiscod_revista.value == <?php echo ARGENTINA ?>) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";
		}
	}	
	
		
		
<?php	}
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoInscribir($comi_codigo,$rolcod,$jurisdid) {

		// Valida el estado con rol y la jurisdicción
		if (!$this->TraerDatosComision($comi_codigo,$fila_comi,$es_modif)) 
			return false;

		$txt_sys_mail="\comi_codigo=".$comi_codigo;			
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error, no existe la Comisión para inscribir alumno.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
		
		
	 if($rolcod==SUPERUSUARIO){
	
					if($fila_comi['comi_estado']==COMISIONCERTIFICADA){
					$titulo = "Inscribir persona en Comision Certificada";
					}
					if($fila_comi['comi_estado']==COMISIONCERRADA){
					$titulo = "Inscribir persona en Comision Cerrada";
					}
					if($fila_comi['comi_estado']==COMISIONNUEVA){
					$titulo = "Inscribir persona en Comision Nueva";
					}
					if($fila_comi['comi_estado']==COMISIONABIERTA){
					$titulo = "Inscribir persona en Comision Abierta";
					}
					
			  ?> 
			  <br />
			  <div align="center" style="font-weight:bold; color:#666666">
				  <?php echo "$titulo"?>
			  </div> 
			  <br />
			  
		<?php	 
		  if($fila_comi['comi_estado']==COMISIONCERTIFICADA || $fila_comi['comi_estado']==COMISIONCERRADA){
				$numfilas=0;
				$ArregloDatos = array();
				$ArregloDatos['comi_estado']=COMISIONCERTIFICADA.",".COMISIONCERRADA;
				$ArregloDatos['act_codigo']=$fila_comi['act_codigo'];
				$ArregloDatos['comi_codigo']=$fila_comi['comi_codigo'];
		    }else{
					$ArregloDatos = array();
					$ArregloDatos['comi_estado']=COMISIONNUEVA.",".COMISIONABIERTA;
					$ArregloDatos['act_codigo']=$fila_comi['act_codigo'];
					$ArregloDatos['comi_codigo']=$fila_comi['comi_codigo'];
			}//cierre del else			
		
	 }// cierre del if
	 
	 
	 
	 
		if($rolcod!=SUPERUSUARIO){
			if ($fila_comi['comi_estado'] != COMISIONNUEVA && $fila_comi['comi_estado'] != COMISIONABIERTA)  {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","COMISIONESTADO","' and constantecod='",$fila_comi['comi_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El estado de la Comisión (".$descri."), no le permite inscribir alumnos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}
		
		if($rolcod!=SUPERUSUARIO){
			$numfilas=0;
			$ArregloDatos = array();
			$ArregloDatos['comi_estado']=COMISIONNUEVA.",".COMISIONABIERTA;
			$ArregloDatos['act_codigo']=$fila_comi['act_codigo'];
			$ArregloDatos['comi_codigo']=$fila_comi['comi_codigo'];
		}	
		
		if 	($rolcod == USUCURSOINAP )  { //  Si la actividad de la comision es curso INAP esta todo OK.
			 $ArregloDatos['tipoact_codigo']=TIPOACTCURSOINAP;
		} elseif ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO) {  //  Si la actividad de la comision es curso de la jurisdiccion del usuario logueado esta OK.
			 $ArregloDatos['jurisdid_inap']=$_SESSION['jurisdid_inap'];
 			 $ArregloDatos['tipoact_codigo']=TIPOACTCURSOJURISD;
		} 
		
		if(!$this->BuscarComisionAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al verificar el acceso a al comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;	
		}
		if ($numfilas >= 1) 
			return true;	

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para inscribir alumnos en la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}	

//-----------------------------------------------------------------------------------------------------	
	function TienePermisoRectificarInscripcion($comi_codigo,$rolcod,$jurisdid) {

		// Valida el estado con rol y la jurisdicción
		if (!$this->TraerDatosComision($comi_codigo,$fila_comi,$es_modif)) 
			return false;

		$txt_sys_mail="\comi_codigo=".$comi_codigo;			
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error, no existe la Comisión para rectificar la inscripción.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 

		if ($fila_comi['comi_estado'] != COMISIONCERRADA)  {
			$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","COMISIONESTADO","' and constantecod='",$fila_comi['comi_estado'],"'"),$descri,$numfilas,$errorcod);
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El estado de la Comisión (".$descri."), no le permite rectificar la inscripción de alumnos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		$numfilas=0;
		$ArregloDatos = array();
		$ArregloDatos['comi_estado']=COMISIONCERRADA;
		$ArregloDatos['act_codigo']=$fila_comi['act_codigo'];
		$ArregloDatos['comi_codigo']=$fila_comi['comi_codigo'];
		
		if 	($rolcod == USUCURSOINAP )  { //  Si la actividad de la comision es curso INAP esta todo OK.
			 $ArregloDatos['tipoact_codigo']=TIPOACTCURSOINAP;
		} elseif ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO) {  //  Si la actividad de la comision es curso de la jurisdiccion del usuario logueado esta OK.
			 $ArregloDatos['jurisdid_inap']=$_SESSION['jurisdid_inap'];
 			 $ArregloDatos['tipoact_codigo']=TIPOACTCURSOJURISD;
		} 
		
		if(!$this->BuscarComisionAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al verificar el acceso a al comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;	
		}
		if ($numfilas == 1) 
			return true;	

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para rectificar la inscripción de alumnos en la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}	

//-----------------------------------------------------------------------------------------------------	
	function  VerificarInscripcionPersona ($comi_codigo, $pers_codigo, &$puede_inscribir, &$mensaje_no_inscripcion) {
		
		$puede_inscribir = true;

		// obtengo la actividad de la Comisión
		if (!$this->TraerDatosComision($comi_codigo,$fila_comi,$es_modif)) {
			$txt_sys_mail="\ncomi_codigo=".$comi_codigo."\npers_codigo=".$pers_codigo;			
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, al traer los datos de la Comisión para verificar la inscripción.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		if (!$es_modif)	{
			$txt_sys_mail="\ncomi_codigo=".$comi_codigo."\npers_codigo=".$pers_codigo;			
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, no existe la Comisión para verificar la inscripción.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 

		$act_codigo = $fila_comi['act_codigo'];

		// obtengo el diseño de la actividad
		$oActividadCursoInap= new cActividadCursoInap($this->conexion);
		
		if (!$oActividadCursoInap->TraerDatosActividadCursoInap($act_codigo,$filacurso,$es_modif))  {
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;		
		}
		

		$ArregloDatos = array();
		$ArregloDatos['act_codigo'] = $act_codigo;		
		$ArregloDatos['pers_codigo'] = $pers_codigo;		
		
		// busco a la persona en todas las comisiones de la actividad
		// SOLO si hay que validar inscripción única
		
		if ($filacurso["actividad_curso"]["tipoact_codigo"] == TIPOACTCURSOINAP) { 
		
				if ($filacurso['actividad_curso_inap']['actdisinap_unico'] == SI) {		
				
					
					if (!$this->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
						$error="Error al buscar la Persona  en Actividad Curso.";
						$errormail="Error al buscar la Persona  en Actividad Curso.".$error."\ncomi_codigo=".$comi_codigo."\npers_codigo=".$pers_codigo;		
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
						return false; 
					}
				
					while (($fila_inscripcion = mysqli_fetch_assoc($resultado)) && ($puede_inscribir)) {
			
						if (!$this->conexion->TraerCampo("comision","comi_estado",array("comi_codigo='",$fila_inscripcion['comi_codigo'],"'"),$comi_estado,$numfilas,$errorcod)) {
							$error="Error al buscar el estado de la Comisión.";
							$errormail="\ncomi_codigo = ".$fila_inscripcion['comi_codigo']."\npers_codigo=".$pers_codigo;
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
							return false;
						}
					
						if ($comi_estado != COMISIONCERTIFICADA) {
							$puede_inscribir = false;	
							$mensaje_no_inscripcion = "La persona ya tiene asignada esta Actividad en la Comisión con Código INAP: ".$fila_inscripcion['comi_codinap']."<br>"."Dicha Comisión no se ha certificado.";		
							
						} else {
							if ($fila_inscripcion['eval_certifica'] == "S" ) {
								$puede_inscribir = false;	
								$mensaje_no_inscripcion = "La persona ya tiene acreditada esta Actividad <br/> en la Comisión con Código INAP: ".$fila_inscripcion['comi_codinap'];		
							}
						
						}
					
			
					} // while
				
				} // if 
		} // if 
				
		// Buscamos la persona y la actividad en autodesarrollo (ArregloDatos)

		$oActividadAutodesarrolloPersona = new cActividadAutodesarrolloPersona($this->conexion);
		if(!$oActividadAutodesarrolloPersona->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos, $numfilas, $resultado, $error, $errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} 		

		$oDictamen = new cDictamen($this->conexion);		
		while (($fila_inscripcion = mysqli_fetch_assoc($resultado)) && ($puede_inscribir)) {
			
	//		print_r($fila_inscripcion);
			if (!isset($fila_inscripcion['dic_codigo'])) {
				$puede_inscribir = false;	
				$mensaje_no_inscripcion = "La persona ya tiene asignada esta Actividad <br>en formato Autodesarrollo Código INAP: ".$fila_inscripcion['act_codinap'];		

			} else {

					if (!$oDictamen->TraerDatosDictamen($fila_inscripcion['dic_codigo'], $fila_dictamen, $es_modif) ) {
						$error="Error al buscar el dictamen.";
						$errormail="\ndic_codigo = ".$fila_inscripcion['dic_codigo'];
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
						return false;
					} 		

					if (!$es_modif) {
						$error="Error no se encuentra el dictamen.";
						$errormail="\ndic_codigo = ".$fila_inscripcion['dic_codigo'];
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
						return false;
			
					} else {

						if ( ($fila_dictamen['dic_estado'] == DICTAMENNUEVO) || 
							($fila_dictamen['dic_estado'] == DICTAMENPENDIENTEAPROBACION) || 
							($fila_dictamen['dic_estado'] == DICTAMENRECHAZADO) ) {
								$puede_inscribir = false;	
								$mensaje_no_inscripcion = "La persona ya tiene asignada esta Actividad <br>en formato Autodesarrollo Código INAP: ".$fila_inscripcion['act_codinap']."<br>"."Dicha Actividad no se ha certificado.";		
						} else {
							if (($fila_dictamen['dic_estado'] == DICTAMENACTIVO) && ($fila_dictamen['dic_pertinencia'] == SI)) {
								$puede_inscribir = false;	
								$mensaje_no_inscripcion = "La persona ya tiene certificada esta Actividad <br>en formato Autodesarrollo Código INAP: ".$fila_inscripcion['act_codinap'];		
							}
						}
						
					} // if
			}

		} // while
		
		return true;
	}
