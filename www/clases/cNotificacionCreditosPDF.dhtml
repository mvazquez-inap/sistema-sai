<?php 
require_once('SysONTIPdf.dhtml');

class cNotificacionCreditosPDF extends cPDF {

	// Datos de la Notificacion
	var $array_datos = array();

	// Ctes para la impresion de la Notificacion
	var $ver_borde=0;	
	var $xContenido = 5;
	var $imagenLogo = 'images/escudo_secretaria.jpg';
	
	var $orientacionPagina = 'portrait';
	var $topMargen = 10;
	var $leftMargen = 10;
	var $rightMargen = 10;
	var $footerMargen = 15;
	var $anchoMaxTexto = 180;	
				
	public function __construct () {	    
		 $format = "A4";
		parent::__construct($this->orientacionPagina,'mm',$format);
	}	
	
	//------------------------------------------------------------------------
	function AddNotificacionCreditos() {
		// Inicializa formato de la pagina 
		$this->AddPage($this->orientacionPagina);
		$this->SetMargins($this->leftMargen,$this->topMargen,$this->rightMargen);
		// Para que el pie tenga 0.5 por defecto son 2cm
		$this->SetAutoPageBreak(true,$this->footerMargen);
		// Inicializa datos 
		$this->array_datos = array('act_nombre'=>'',
									'jurisdnom'=>'',
									'programa'=>'',
									'comi_codinap'=>'',
									'comi_acta_numero'=>'',
									'comi_fecha_inicio'=>'',
									'comi_fecha_fin'=>'',
									'sede'=>'',
									'comi_domicilio'=>'',
									'comi_detalle'=>'',
									'actcur_creditos'=>'',
									'pers_cuilt'=>'',
									'nombre_completo'=>'',
									'jurisdnom_persona'=>'',									
									'escalafon'=>'',
									'nivel'=>'',
									'tramo'=>'',
									'grado'=>'',
									'evaluacion'=>'',
									'dis_numero'=>'');
	}	
	//------------------------------------------------------------------------
	function Set($campo,$valor) {
		$this->array_datos[$campo]=$valor;
	}
	//------------------------------------------------------------------------
	function Get($campo) {
		return ($this->array_datos[$campo]);
	}
	//------------------------------------------------------------------------
	function Header() { }
	//------------------------------------------------------------------------
	function MostrarNotifiacion($formato) {
	
		$this->SetFont('Arial','',8);
		$this->Image($this->imagenLogo,$this->lMargin+$this->xContenido,$this->tMargin+2,190,0);

			$ancho_fila_dato = 180;
			$alto_fila_dato =  6;
	
	/*		$this->SetFont('Arial','BI',12);
			$this->SetXY($this->lMargin+$this->xContenido+20,$this->tMargin+3) ;
			$this->MultiCellMaxLine(120,$alto_fila_dato,"Jefatura de Gabinete de Ministros \nSecretaria de la Gestión Pública \nInstituto Nacional de la Administración Pública",
									$this->ver_borde,'L',0,3);
	*/
			$this->SetFont('Arial','BI',12);
			$this->Ln(30);	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									"SISTEMA NACIONAL DE CAPACITACION\n CONSTANCIA DE REALIZACIÓN DE ACTIVIDAD",$this->ver_borde,'C',0,2);
			$this->Ln(4);	
	
			$this->SetFont('Arial','',10);
			if ($this->Get('programa') != "")
				$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'PROGRAMA: '.$this->Get('programa'),$this->ver_borde,'L',0,1);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'ORGANISMO: '.$this->Get('jurisdnom'),$this->ver_borde,'L',0,1);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'ACTIVIDAD NOMBRE: '.$this->Get('act_nombre'),$this->ver_borde,'L',0,2);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'DISPOSICION: '.$this->Get('dis_numero'),$this->ver_borde,'L',0,1);

			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'DURACIÓN DE LA ACTIVIDAD: '.$this->Get('act_duracion_detalle'),$this->ver_borde,'L',0,1);

			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'VALORACIÓN DE LA ACTIVIDAD EN CASO DE CORRESPONDER: '.$this->Get('actcur_creditos'),$this->ver_borde,'L',0,1);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'COMISION: '.$this->Get('comi_codinap').str_repeat(' ',5)." N° ACTA:".$this->Get('comi_acta_numero'),$this->ver_borde,'L',0,1);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'COMIENZO: '.$this->Get('comi_fecha_inicio').
									str_repeat(' ',5).'FINALIZACION: '.$this->Get('comi_fecha_fin'),$this->ver_borde,'L',0,1);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'LUGAR: '.'SEDE: '.$this->Get('sede').' '.$this->Get('comi_domicilio').' '.$this->Get('comi_detalle'),$this->ver_borde,'L',0,1);
	
			
			$this->Ln(5);
	
			$this->SetFont('Arial','IB',10);
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									"DATOS DE LA PERSONA",$this->ver_borde,'L',0,1);
	
			$this->SetFont('Arial','',10);
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'CUIT/CUIL/CDI:'.$this->Get('pers_cuilt'),$this->ver_borde,'L',0,1);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'APELLIDO Y NOMBRE:'.$this->Get('nombre_completo'),$this->ver_borde,'L',0,1);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'ORGANISMO: '.$this->Get('jurisdnom_persona'),$this->ver_borde,'L',0,1);

			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'ESCALAFON: '.$this->Get('escalafon'),$this->ver_borde,'L',0,1);

			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'NIVEL: '.$this->Get('nivel'),$this->ver_borde,'L',0,1);

			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'TRAMO: '.$this->Get('tramo'),$this->ver_borde,'L',0,1);
	
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'GRADO: '.$this->Get('grado'),$this->ver_borde,'L',0,1);
		
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'EVALUACION:'.$this->Get('evaluacion'),$this->ver_borde,'L',0,1);
		
			$this->Ln(5);
			$yFirma = $this->Gety()+10;						
			$xFirma = $this->GetX()+30;
			$this->Line($xFirma,$yFirma,$xFirma+45,$yFirma);
			$this->SetFont('Arial','B',8);
			$this->SetXY($xFirma+15,$yFirma);
			$this->MultiCellMaxLine(15,$alto_fila_dato,
									'Firma',$this->ver_borde,'C',0,1);
	
			$xFirma = $this->GetX()+90;						
			$this->Line($xFirma,$yFirma,$xFirma+45,$yFirma);
			$this->SetFont('Arial','B',8);
			$this->SetXY($xFirma+15,$yFirma);
			$this->MultiCellMaxLine(15,$alto_fila_dato,
									'Firma',$this->ver_borde,'C',0,1);
	
			$this->Ln(5);
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'Buenos Aires, '.str_repeat(' ',10).' de ',$this->ver_borde,'L',0,1);
			
			$this->MultiCellMaxLine($ancho_fila_dato,$alto_fila_dato,
									'Recibido:',$this->ver_borde,'L',0,1);
		
			$xFirma = $this->GetX()+20;						
			$yFirma = $this->Gety()+2;						
			$this->Line($xFirma,$yFirma,$xFirma+45,$yFirma);
	}
	//------------------------------------------------------------------------
	function Footer() { }
} // fin clase	
?>
