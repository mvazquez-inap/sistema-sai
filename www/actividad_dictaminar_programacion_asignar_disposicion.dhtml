						</td>
					</tr>
					<tr>
						<td width="30%"  valign="middle" class='textoEtiqueta'>Observaciones</td>
						<td class="textoEtiquetaDatoResaltado">
						<textarea cols="100" rows="5" name="actautodic_obs"  id="actautodic_obs"  class='inputReadonly' readonly  style="width:400px"><?php echo ($operacion_dictamen != "A")?htmlspecialchars($fila_dictamen_editable['actautodic_obs'],ENT_QUOTES):"" ?></textarea>						</td>
					  </tr>
					<tr>
						<td valign="top" width="55%" class='textoEtiqueta'>Pertinencia</td>
						<td class="textoEtiquetaDatoResaltado">
						<?php
						$valores_combo[1]['dic_pertinencia'] = SI;
						$valores_combo[2]['dic_pertinencia'] = NO;
						$querystring ="";
						$formulario = "formulario_actividad";
