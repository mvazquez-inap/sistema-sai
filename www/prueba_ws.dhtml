// ----------------------------------------------------------------------------------------------------------------
// Creo los clientes
// ----------------------------------------------------------------------------------------------------------------

// Cambiar IP, local
$servidor="10.1.10.173"; 
// $servidor="127.0.0.1"; 
// $servidor="http://sai-testing.sgp.gov.ar"; 

// $wsdl_credPersonal = $servidor."sai/wsSai/wsCreditosPersonales.php?wsdl";	
