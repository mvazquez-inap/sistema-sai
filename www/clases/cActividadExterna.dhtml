<?php
//----------------------------------------------------------------------------------------- 
class cActividadExterna extends cActividad {

	public function __construct($conexion) {
		parent::__construct($conexion);
	}
//-----------------------------------------------------------------------------------------
	function TieneTipo($act_codigo,$tipoact_codigo,&$tiene_tipo)	{

		$tiene_tipo=$this->EsActividadExternaTipo($act_codigo,$tipoact_codigo,$error,$errormsg);
		if ($error) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		    return false;
		}
		return true;
	}
	//-----------------------------------------------------------------------------------------------------	
	 function ObtenerTipos($act_codigo,&$array_tipos)	{
	 
			$ArregloDatos = array();
			$ArregloDatos['act_codigo'] = $act_codigo;
		
			if(!$this->BuscarActividadExterna($ArregloDatos,$numfilas,$resultActExterna,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}
	 		
			while ($fila_resultExterna = mysqli_fetch_assoc($resultActExterna)) {
				$array_tipos[]+= $fila_resultExterna['tipoact_codigo'];
			}
			return true	; 
	}
	
//-----------------------------------------------------------------------------------------
	function EsActividadExternaTipo($act_codigo,$tipoact_codigo,&$error,&$errormsg)	{
	
		// La actividad debe existir y ser formato externa
		$error=false;
		$errormsg="";
		if (!$this->TraerDatosActividadExterna($act_codigo,$result_actividad,$es_modif_act_ext) ) {
			$errormsg="Error al buscar la Actividad Externa.";
			$error=true;
			return false;
		} 		
		
		if (!$es_modif_act_ext) {
			$errormsg="Error al buscar la Actividad Externa.";
			$error=true;
			return false;		
		}
		
		return ($result_actividad['actividad_externa']['tipoact_codigo'] == $tipoact_codigo);
	}		

//-----------------------------------------------------------------------------------------
	function TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,&$datosresult,&$es_modif) {

		if (!$this->TraerDatosActividadExterna($act_codigo,$datosresult_detalle,$es_modif)) {
			return false;
		} else {
			$datosresult['act_codigo']=$datosresult_detalle['actividad']['act_codigo'];
			$datosresult['act_formato']=FORMATOEXT;
			$datosresult['tipoact_codigo']=TIPOACTEXTASIS;			
			$datosresult['act_nombre']=$datosresult_detalle['actividad']['act_nombre'];
			$datosresult['act_codinap']=$datosresult_detalle['actividad']['act_codinap'];
			$datosresult['act_duracionhs']=$datosresult_detalle['actividad_externa']['actext_duracionhs'];
			$datosresult['act_estado']=$datosresult_detalle['actividad_externa']['actext_estado'];
			$datosresult['act_creditos']=$datosresult_detalle['actividad_externa']['actext_creditos'];
			$datosresult['jurisdid_inap']=0;
			return true;
		}
	}	
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadExterna($act_codigo,&$datosresult,&$es_modif) {
		
		// Si se hay error al ejecutar algún SQL retorna error, sino si no encuentra
		// la actividad o la actividad no es Externa, retorna que es_modif=false
		// pues no se encontro una actividad externa con el codigo enviado

		$datosresult=array();
		$es_modif = false;		

		if (!$this->TraerDatosActividad($act_codigo,$result_actividad,$es_modif_act)) 
			return false;

		$datosresult['actividad'] = $result_actividad;

		if ($es_modif_act) {
		
			$ArregloDatos = array();
			$ArregloDatos['act_codigo'] = $act_codigo;
		
			if(!$this->BuscarActividadExterna($ArregloDatos,$numfilas,$resultActExterna,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

			if ($numfilas == 1)	{
				$datosresult['actividad_externa']= mysqli_fetch_assoc($resultActExterna);
				$es_modif = true;
			}
			
		} // $es_modif_act

		return true;
	}
//----------------------------------------------------------------------------------------- 
	function AltaDatosActividadExterna($datos,&$act_codigo_nuevo,&$act_codinap) {

		$datosvalidados=array();		
		$this->_AguparDatosPost($datos,$datos_agrup,false);	
		
		$datos_actividad['actividad']=$datos_agrup['actividad'];
		$datos_actividad['actividad_externa']=$datos_agrup['actividad_externa'];		
	
		if(!$this->AltaDatosActividad($datos_actividad['actividad'],$act_codigo_nuevo,true,"EX",$act_codinap))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38001","act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);

		if(!$this->_DatosValidosAltaActividadExterna($datos_actividad['actividad_externa'],$datosvalidados))
			return false;

		$spnombre="ins_actividad_externa";
		$spparam=array('pact_codigo'=>$act_codigo_nuevo,
					  'ptipoact_codigo'=>$datosvalidados['tipoact_codigo'],
					  'pactext_duracionhs'=>$datosvalidados['actext_duracionhs'],
					  'pactext_duraciondetalle'=>$datosvalidados['actext_duraciondetalle'],
					  'pactext_creditos'=>0,
					  'ppais_codigo'=>$datosvalidados['pais_codigo'],
					  'pprov_codigo'=>$datosvalidados['prov_codigo'],
					  'pactext_direccion'=>$datosvalidados['actext_direccion'],
			  		  'porgapri_codigo'=>$datosvalidados['orgapri_codigo'],
			  		  'pjurisdid_apn'=>$datosvalidados['jurisdid_apn'],
  					  'porgapub_codigo'=>$datosvalidados['orgapub_codigo'],
					  'ptipocert_codigo'=>$datosvalidados['tipocert_codigo'],	
			  		  'pactext_obs'=>$datosvalidados['actext_obs'],
			  		  'pactext_estado'=>ACTEXTERNAACTIVO,
		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad Externa.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosActividadExterna($act_codigo) {

		if(!$this->_DatosValidosEliminarActividadExterna($act_codigo,$datosvalidados))
			return false;

		$spnombre="del_actividad_externa";
		$spparam=array('pact_codigo'=>$act_codigo);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la Actividad Externa.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		if(!$this->EliminarDatosActividad($act_codigo,FORMATOEXT)) 
			return false;

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function ModifDatosActividadExterna($datos)	{

		$this->_AguparDatosPost($datos,$datos_agrup,true);	

		$datos_actividad['actividad']=$datos_agrup['actividad'];
		$datos_actividad['actividad_externa']=$datos_agrup['actividad_externa'];		
		
		if(!$this->ModifDatosActividad($datos_actividad['actividad']))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38003","act_codigo=".$datos_actividad['actividad']['act_codigo'],$_SESSION['usuariocod']);

		if(!$this->_DatosValidosModifActividadExterna($datos_agrup['actividad_externa'],$datosvalidados))
			return false;
			
		$spnombre="upd_actividad_externa";
		$spparam=array('pact_codigo'=>$datosvalidados['act_codigo'], 
					  'pactext_duracionhs'=>$datosvalidados['actext_duracionhs'],
					  'pactext_duraciondetalle'=>$datosvalidados['actext_duraciondetalle'],
					  'ppais_codigo'=>$datosvalidados['pais_codigo'],
					  'pprov_codigo'=>$datosvalidados['prov_codigo'],
					  'pactext_direccion'=>$datosvalidados['actext_direccion'],
			  		  'porgapri_codigo'=>$datosvalidados['orgapri_codigo'],
			  		  'pjurisdid_apn'=>$datosvalidados['jurisdid_apn'],
			  		  'pactext_obs'=>$datosvalidados['actext_obs'],
					  'porgapub_codigo'=>$datosvalidados['orgapub_codigo'],
					  'ptipocert_codigo'=>$datosvalidados['tipocert_codigo'],					  
			  		  'pactext_estado'=>ACTEXTERNAACTIVO,
		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\nact_codigo='.$datosvalidados['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la Actividad Externa.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function ActualizarCreditos($act_codigo,$act_creditos) {
	
		$spnombre="upd_actividad_externa_asigno_creditos_xact_codigo";
		$spparam=array(
			'pact_codigo'=> $act_codigo,
			'pactext_creditos'=> $act_creditos,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar los créditos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			if ($numfilas != 1) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar los créditos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function ValidarFormAltaActividadExterna() {	

	$this->ValidarFormAltaActividad(); 
?>		
	function ValidarFormAltaActividadExterna(formulario,operacion) {

			// Duración	en hs. - [actext_duracionhs] 	- [OBLIG]
			if (!ValidarContenido(formulario.actext_duracionhs.value,'NumericoEntero') ) {
				alert("La duración en hs. debe ser un número entero");
				formulario.actext_duracionhs.focus();
				return false;
			}	
			if (formulario.actext_duracionhs.value <= 0) {
				alert("La duración en hs. debe ser mayor que cero");
				formulario.actext_duracionhs.focus();
				return false;
			}	

			if ((trim(formulario.tipocert_codigo.value)=="")) {
				alert("Debe ingresar un tipo de certificación");
				formulario.tipocert_codigo.focus();
				return false;
			}	

			// Detalle sobre la duración	 	- [actext_duraciondetalle] 	- [OPCIONAL]
			
			// Pais								- [pais_codigo] 	- [OBLIG]
			if ((trim(formulario.pais_codigo.value)=="")) {
				alert("Debe ingresar un pais");
				formulario.pais_codigo.focus();
				return false;
			}	

			// Provincia						- [prov_codigo] 	- [OBLIG] / Si es Argentina
			if ((trim(formulario.pais_codigo.value)== <?php echo ARGENTINA?>)){
				if ((trim(formulario.prov_codigo.value)=="")){
					alert("Debe ingresar una provincia");
					formulario.prov_codigo.focus();
					return false;
				}					
			}
			
			// Direccion 							- [actext_direccion] [OPCIONAL]

			// Sector del Organismo
			if (!formulario.tipo_institucion[0].checked   && !formulario.tipo_institucion[1].checked) {
				alert("Debe seleccionar el sector del organismo");
				formulario.tipo_institucion[0].focus();
				return false;
			}
			

			// Organismo 											[OBLIG]
			if (formulario.tipo_institucion[0].checked ) {			// Organismo Público
				if (trim(formulario.jurisdid.value)=="") {
					alert("Debe seleccionar el organismo público");
					formulario.jurisdid.focus();
					return false;
				}
			}  
			if (formulario.tipo_institucion[1].checked ) {			// Organismo Privado
				if (trim(formulario.orgapri_codigo.value)=="") {
					alert("Debe seleccionar el organismo privado");
					formulario.orgapri_codigo.focus();
					return false;
				}
			}  			
			
			return true;
		}				
//-----------------------------------------------------------------------------------------------------	
	function SeleccionPais(formulario) {
		var elSelect = document.getElementById('datos_provincia');
		if (formulario.pais_codigo.value == <?php echo ARGENTINA ?>) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";
		}
	}
//-----------------------------------------------------------------------------------------------------	
	function SeleccionTipoInstitucion(valorlogico,seccion_mostrar,seccion_ocultar ){

		var elSelectMostrar = document.getElementById(seccion_mostrar);
		var elSelectOcultar = document.getElementById(seccion_ocultar);

			if (valorlogico) {
				elSelectMostrar.style.display ="block";
				elSelectOcultar.style.display ="none";			
			} else {
				elSelectMostrar.style.display ="none";
				elSelectOcultar.style.display ="block";			
			}				
	}

<?php } 
