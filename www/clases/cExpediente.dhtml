//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAltaExpediente($datos,&$datosvalidados)	{
		
		$datosvalidados=array();

		// Verifico que el número de expediente no exista.
		$ArregloDatos=array();
		$ArregloDatos['exp_numero_exacto']=$datos["exp_numero"];
		if(!$this->BuscarExpediente($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error buscando el expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		}				
		if ($numfilas>=1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe el <br> número de expediente:".$datos["exp_numero"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		}		
		$datosvalidados["exp_numero"]=$datos["exp_numero"];

		if( ($_SESSION['rolcod'] == USUCURSOINAP || $_SESSION['rolcod'] == USUACTINS) && $datos['jurisdid_exp']!=JURISDID_JEFATURA) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la jurisdicción del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		} elseif( ($_SESSION['rolcod'] == USUACTJUR ) && $datos['jurisdid_exp']!=$_SESSION['jurisdid_inap']) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la jurisdicción del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		} else {
			$spparam=array("porderby"=>'jurisdnom');			
			$arraybusq=array('jurisdid'=>$datos['jurisdid_exp']);
			if(!$this->conexion->BuscarRegistroxClave('sel_jurisdiccion_inap_sin_no_corresponde_xorderby',$spparam,$arraybusq,$query,$filaret,$numfilas,$errorcod) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del Organismo del Coordinador T&eacute;cnico de Capacitaci&oacute;n.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		}
		$datosvalidados['jurisdid_exp']=$datos['jurisdid_exp'];

		// Valido que los datos comunes sean válidos
		if (!$this->_DatosValidosComunesExpediente($datos,$datosvalidados))
		   return false; 


		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosEliminarExpediente($exp_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoBaja($exp_codigo,$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		
		// La baja es física o no se puede realizar la baja (el mensaje es informativo)
		if (!$this->PosibleBajaFisica($exp_codigo))	{		
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha eliminado el expediente, pues existen datos asociados al mismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;					  	 				
		}
		$datosvalidados+=array('exp_codigo'=>$exp_codigo);
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifExpediente($datos,&$datosvalidados)	{

		if (!$this->TienePermisoModificar($datos['exp_codigo'],$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		$datosvalidados['exp_codigo']=$datos['exp_codigo'];

		// Verifico que el número de expediente no exista.
		$ArregloDatos=array();
		$ArregloDatos['exp_numero_exacto']=$datos["exp_numero"];
		if(!$this->BuscarExpediente($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando la expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		}				
		if ($numfilas>1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe el <br> número de expediente:".$datos["exp_numero"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;			
		} elseif ($numfilas==1) {	// hay un expediente que no es el el que se esta modificando			   
		   $fila_exp=mysqli_fetch_assoc($result);
		   if ($fila_exp['exp_codigo']!= $datos['exp_codigo']) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe el <br>  número de expediente:".$datos["exp_numero"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
				return false;							   
		   }
		}
		$datosvalidados["exp_numero"]=$datos["exp_numero"];

		if (!$this->_DatosValidosComunesExpediente($datos,$datosvalidados))
		   return false; 

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosComunesExpediente($datos,&$datosvalidados)	{

		if (trim($datos['exp_numero'])=="") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el número del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}	
		$datosvalidados['exp_numero']=$datos['exp_numero'];

		// Fecha de Inicio
		if (trim($datos['exp_fecha_inicio'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['exp_fecha_inicio'],"FechaDDMMAAAA"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de inicio del expediente no es vádida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}

		// Fecha de Ingreso
		if (trim($datos['exp_fecha_ingreso'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['exp_fecha_ingreso'],"FechaDDMMAAAA"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de ingreso del expediente no es vádida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}

		// El expediente no puede tener en una fecha posterior a la actual.
		$fechainicio=FuncionesPHPLocal::ConvertirFecha($datos['exp_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd');
		$fechaingreso=FuncionesPHPLocal::ConvertirFecha($datos['exp_fecha_ingreso'],'dd/mm/aaaa','aaaa-mm-dd');
	
		$fecha_actual_AAAAMMDD=date("Y/m/d");

		$fechaincioinap="01/01/".ANOINICALINAP;
		$fechaincioinap_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($fechaincioinap,'dd/mm/aaaa','aaaa-mm-dd');

		// Ninguna de las dos fechas puede superar la incial para la acreditacion 
		if ($fechainicio < $fechaincioinap_AAAAMMDD || $fechainicio > $fecha_actual_AAAAMMDD )
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de inicio debe ser menor o igual a la actual y mayor o igual a ".$fechaincioinap,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}
		if ($fechaingreso < $fechaincioinap_AAAAMMDD || $fechaingreso > $fecha_actual_AAAAMMDD)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de ingreso debe ser menor o igual a la actual y mayor o igual a ".$fechaincioinap,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}		
		
		// Fecha de Ingreso >= Fecha de Inicio
		if ($fechainicio > $fechaingreso)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de ingreso debe ser mayor o igual que la fecha de inicio.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}

		$datosvalidados['exp_fecha_inicio']=$datos['exp_fecha_inicio'];
		$datosvalidados['exp_fecha_ingreso']=$datos['exp_fecha_ingreso'];
		$datosvalidados['exp_obs']=$datos['exp_obs'];
		
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
} // class
?>