<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oUsuario=new cUsuarios($conexion);
$oRol=new cRoles($conexion);

//----------------------------------------------------------------------------------------- 	
// Inicio de pantalla
$filausuario=array();
$filausuario['usuarioCUIT']=(isset($_POST['usuarioCUIT']))?$_POST['usuarioCUIT']:"";
$filausuario['usuariocod']=(isset($_GET['usuariocod']))?$_GET['usuariocod']:"";

if (isset($_POST['usuarioCUIT']) ) {
	if($conexion->TraerCampo("usuarios","usuariocod",array("usuariocuit='",$_POST['usuarioCUIT'],"'"),$usuariocod,$numfilas,$errno))
		$filausuario['usuariocod']=htmlspecialchars($usuariocod,ENT_QUOTES);
}
if (isset($_GET['usuariocod']) ) {
	if($conexion->TraerCampo("usuarios","usuariocuit",array("usuariocod='",$_GET['usuariocod'],"'"),$usuariocuit,$numfilas,$errno))
		$filausuario['usuarioCUIT']=htmlspecialchars($usuariocuit,ENT_QUOTES);
}
?>
<form action="usuario_baja.dhtml" method="post" name="formulario_cuit" id="formulario_cuit">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oUsuario->PedirCuit($filausuario['usuarioCUIT'],'formulario_cuit','usuarioCUIT','botoningresoCUIT'); ?></td>
	</tr>
	</table>
</form>	

<?php 
if ($filausuario['usuariocod']=="") {
	if (isset($_GET['usuariocod']) || isset($_POST['usuarioCUIT']))
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El usuario no se encuentra en el sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
} else {

	if(!$oRol->RolesDeUnUsuario($filausuario['usuariocod'],$numfilasroles,$resultadoroles))
		die();
	
	$oUsuario->TraerDatosUsuario($filausuario['usuariocod'],$filausuario,false);

	$puedeborrarusuario=($numfilasroles==0);

	if($puedeborrarusuario) { 	?>	
		<form action="usuario_baja_upd.dhtml?usuariocod=<?php echo $filausuario['usuariocod'] ?>" method="post">
			<table class="textoTablaDato"  width="100%" align="center" >
				<tr>
					<td> 
					<?php 	$oUsuario->MostrarDatosBasicosUsuarios($filausuario);?>
					</td>
				</tr>
				<tr>
					<td> <?php 
						if(!($filausuario['usuarioestado'] == USUARIOACT  || $filausuario['usuarioestado'] == USUARIONUEVO)) 
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El usuario no esta activo en el sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));				
						else { ?>							
							<p align="center"><input type="submit" name="boton_borrar" value="Borrar Usuario" class="botones">	</p>					
						<?php ;}  ?>
					</td>
				</tr>
			</table>
		</form>
		<?php
	} else 	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El usuario tiene roles asignados, para eliminarlo no debe tener ningún rol asociado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));			
	}
} 
$oEncabezados->PieMenuEmergente();
?>