<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
//----------------------------------------------------------------------------------------- 
$oPonderadorDictamen = new cPonderadorDictamen($conexion);
if (isset($_POST['pondtipopond_codigo_cal_pres'])) 	
	$pondtipopond_codigo_cal_pres=$_POST['pondtipopond_codigo_cal_pres']; 
else 
	$pondtipopond_codigo_cal_pres=0; 

if (isset($_POST['pondtipopond_codigo_int'])) 
	$pondtipopond_codigo_int=$_POST['pondtipopond_codigo_int']; 
else 
	$pondtipopond_codigo_int=0; 

if (isset($_POST['pondtipopond_codigo_proc_eva'])) 
	$pondtipopond_codigo_proc_eva=$_POST['pondtipopond_codigo_proc_eva']; 
else 
	$pondtipopond_codigo_proc_eva=0;

if (!isset($_POST['tipopart_codigo'])) {
	$act_duracionhs=isset($_POST['act_duracionhs'])?$_POST['act_duracionhs']:0;
	$creditos = $oPonderadorDictamen->CalculoCreditos($act_duracionhs,$pondtipopond_codigo_cal_pres,$pondtipopond_codigo_int,$pondtipopond_codigo_proc_eva);
} else {
	$creditos = $oPonderadorDictamen->CalculoCreditosPublicaciones($_POST['tipopart_codigo'],$_POST['escalaftramocod'],$_POST['escalafnivcod'],$pondtipopond_codigo_cal_pres,
										$pondtipopond_codigo_int,$pondtipopond_codigo_proc_eva,$total,$porcentaje);
	
	echo "var total_base_creditos=".$total.";\n";
	echo "var porcentaje_base_creditos=".$porcentaje.";\n";
}

echo "var creditos_total=".$creditos.";\n";
?>