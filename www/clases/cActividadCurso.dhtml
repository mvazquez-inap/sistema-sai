			if ($ArregloDatos['act_nombre']!="")
			{
				$sparam['pact_nombre']= $ArregloDatos['act_nombre'];
				$sparam['pxact_nombre']= 1;
			}
		}
		if (isset ($ArregloDatos['act_codinap']))	{
			if ($ArregloDatos['act_codinap']!="")
			{
				$sparam['pact_codinap']= $ArregloDatos['act_codinap'];
				$sparam['pxact_codinap']= 1;
			}
		}
		if (isset($ArregloDatos['jurisdid_inap']))	{
			if ($ArregloDatos['jurisdid_inap']!="")
			{
				$sparam['pjurisdid_inap']= $ArregloDatos['jurisdid_inap'];
				$sparam['pxjurisdid_inap']= 1;
			}
		}
		if (isset($ArregloDatos['tipoact_codigo']))		{
			if ($ArregloDatos['tipoact_codigo']!="")
			{
				$sparam['ptipoact_codigo']= $ArregloDatos['tipoact_codigo'];
				$sparam['pxtipoact_codigo']= 1;
			}
		}
		if (isset($ArregloDatos['dic_estado']))		{
			if ($ArregloDatos['dic_estado']!="")
			{
				$sparam['pdic_estado']= $ArregloDatos['dic_estado'];
				$sparam['pxdic_estado']= 1;
			}
		}
		if (isset($ArregloDatos['actcur_estado']))		{
			if ($ArregloDatos['actcur_estado']!="")
			{
				$sparam['pactcur_estado']= $ArregloDatos['actcur_estado'];
				$sparam['pxactcur_estado']= 1;
			}
		}
		if (isset ($ArregloDatos['exp_numero']))	{
			if ($ArregloDatos['exp_numero']!="")
			{
				$sparam['pexp_numero']= $ArregloDatos['exp_numero'];
				$sparam['pxexp_numero']= 1;
			}
		}
		if (isset ($ArregloDatos['dis_numero']))	{
			if ($ArregloDatos['dis_numero']!="")
			{
				$sparam['pdis_numero']= $ArregloDatos['dis_numero'];
				$sparam['pxdis_numero']= 1;
			}
		}
		if (isset ($ArregloDatos['dis_codigo']))	{
			if ($ArregloDatos['dis_codigo']!="")
			{
				$sparam['pdis_codigo']= $ArregloDatos['dis_codigo'];
				$sparam['pxdis_codigo']= 1;
			}
		}
		if (isset ($ArregloDatos['dic_codigo']))	{
			if ($ArregloDatos['dic_codigo']!="")
			{
				$sparam['pdic_codigo']= $ArregloDatos['dic_codigo'];
				$sparam['pxdic_codigo']= 1;
			}
		}
		// Mandar 	1 x con disposición
		// 			0 x sin disposición
		if (isset ($ArregloDatos['con_disposicion'])) {
			if ($ArregloDatos['con_disposicion']!="")  {
				$sparam['pxcon_dispo']= ($ArregloDatos['con_disposicion'])?"1":"0";
			}
		}
		if (isset ($ArregloDatos['sin_disposicion'])) {
			if ($ArregloDatos['sin_disposicion']!="")  {
				$sparam['pxsin_dispo']= ($ArregloDatos['sin_disposicion'])?"1":"0";
			}
		}
		if (isset ($ArregloDatos['actprog_sec'])) {
			if ($ArregloDatos['actprog_sec']!="") {
				$sparam['pactprog_sec']= $ArregloDatos['actprog_sec'];
				$sparam['pxactprog_sec']= 1;
			}
		}
		if (isset($ArregloDatos['actprog_fecha_inicio']))	{
			if ($ArregloDatos['actprog_fecha_inicio']!="")
			{
				$sparam['pactprog_fecha_inicio']= $ArregloDatos['actprog_fecha_inicio'];
				$sparam['pxactprog_fecha_inicio']= 1;
			}
		}
		if (isset($ArregloDatos['actprog_fecha_fin']))	{
			if ($ArregloDatos['actprog_fecha_fin']!="")
			{
				$sparam['pactprog_fecha_fin']= $ArregloDatos['actprog_fecha_fin'];
				$sparam['pxactprog_fecha_fin']= 1;
			}
		}


		if (isset($ArregloDatos['progcur_codigo']))	{
			if ($ArregloDatos['progcur_codigo']!="")
			{
				$sparam['pprogcur_codigo']= $ArregloDatos['progcur_codigo'];
				$sparam['pxprogcur_codigo']= 1;
			}
		}

		if (isset($ArregloDatos['areacur_codigo']))	{
			if ($ArregloDatos['areacur_codigo']!="")
			{
				$sparam['pareacur_codigo']= $ArregloDatos['areacur_codigo'];
				$sparam['pxareacur_codigo']= 1;
			}
		}

		if (isset($ArregloDatos['actdisinap_beca']))	{
			if ($ArregloDatos['actdisinap_beca']!="")
			{
				$sparam['pactdisinap_beca']= $ArregloDatos['actdisinap_beca'];
				$sparam['pxactdisinap_beca']= 1;
			}
		}


		if (isset($ArregloDatos['dic_esta_visado']) && $ArregloDatos['dic_esta_visado']!="")	{
				$sparam['pxdic_esta_visado_si']= $ArregloDatos['dic_esta_visado'];
				$sparam['pxdic_esta_visado_no']= $ArregloDatos['dic_esta_visado'];
		}

		if (isset ($ArregloDatos['orderby']))	{
			if ($ArregloDatos['orderby']!="")
			{
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_actividad_curso_dictaminada_avanzada_xdatos";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar actividades dictaminadas.";
			$errormail="Error al ejecutar una búsqueda avanzada de actividades dictaminadas.".$errno;
			return false;
		}
		return true;
	}
