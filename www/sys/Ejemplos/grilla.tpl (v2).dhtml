<?php require('grilla.inc.dhtml'); ?>
<div align="center">
<table width="<?php $this->_($this->ancho)?>" class="<?php echo $glb_grilla['estilo']['textoTablaDato'] ?>" border="0" cellpadding="0" cellspacing="0" align="center">
	<tr>
	    <td class='<?php echo $glb_grilla['estilo']['textoTitulo'] ?>' align="left">
			<?php  $this->_($this->TituloListado)  ?>
		</td>
	</tr>
</table>
<?php if ($glb_grilla['botonera_posicion']=='arriba') { ?>
<?php 		if (($this->DeshabilitarBtsAdelante!="disabled") || ($this->DeshabilitarBtsAtras!="disabled")) { ?>		
			<table width="<?php $this->_($this->ancho)?>" border="0" cellpadding="0" cellspacing="0" align="center">
				<tr>
					<td class='<?php echo $glb_grilla['estilo']['textoFilaPaginado'] ?>'> 
						<?php	include $this->loadTemplate($glb_grilla['tpl_botones']); ?> 
					</td> 
				</tr>
			</table>
<?php 		} ?>
<?php } ?>
<table width="<?php  $this->_($this->ancho) ?>" class="<?php echo $glb_grilla['estilo']['textoTablaDato'] ?>" border="1" cellpadding="1" cellspacing="1" align="center">
	<tr class='<?php echo $glb_grilla['estilo']['textoColumnasTitulo'] ?>'>
	<?php foreach ($this->columnas as $row) { ?>
		<td align="center" <?php if (isset ($row['ancho_columna'])) echo "width='".$row['ancho_columna']."'"?>>
			<?php $this->_($row["titulo_columna"]); ?>
		</td>
	<?php } ?>
	</tr>
	
	<?php 
	foreach ($this->result as $row_dato) { 
	?>
	<tr>
		<?php foreach ($this->columnas as $row_columna) {	?>
			<td align="<?php echo (isset ($row_columna['align_columna']))?$row_columna['align_columna']:'center'?>" <?php if (isset ($row_columna['ancho_columna'])) echo "width='".$row_columna['ancho_columna']."'"?>>
			<?php 
				if ( !isset($row_columna['condicion_visualizar_columna']) || call_user_func($row_columna['condicion_visualizar_columna'], $row_dato ) ) {
			
					switch ($row_columna["tipo"]) {

					case "txt" : 

						$this->_($row_dato[$row_columna["campo_grilla"]]); 
						// Nuevo respecto a los chicos.
						if ($row_dato[$row_columna["campo_grilla"]]=="")
						  echo "&nbsp;";
						break;
						
					case "link":
						
						// Define el enlace url, debe haber por lo menos un parametro
						$enlace = $row_columna["url"];
						$array_querystring=array();
						$primero = true;
						foreach ($row_columna["parametros"] as $parametro) {
							$enlace .= (($primero)?"?":"&amp;").$parametro["para_nombre"]."=";
							$enlace .= ($parametro["para_tipo"]=="cte")?$parametro["para_dato"]:$row_dato[$parametro["para_dato"]];
							$array_querystring[$parametro["para_nombre"]]=($parametro["para_tipo"]=="cte")?$parametro["para_dato"]:$row_dato[$parametro["para_dato"]];
							$primero = false;
						}

						if(isset($row_columna['funcion_md5']))
						{
							call_user_func_array($row_columna['funcion_md5'], array($row_columna["url"], $array_querystring, &$querystring_nousar, &$md5 ));
							$enlace .= (($primero)?"?":"&amp;")."md5=".$md5;
						}

						// Define la leyenda del enlace
						if ($row_columna["leyenda_param"]["tipo_param"] == "cte" )
							$leyenda = $row_columna["leyenda_param"]["valor"];							
						else 
							$leyenda = $row_dato[$row_columna["leyenda_param"]["valor"]];															
					
					?> <a href="<?php echo $enlace ?>" class='<?php echo $glb_grilla['estilo']['textoLink'] ?>'><?php echo $leyenda?></a><?php
					
						break;	
					
					case "linkimg" :
					
						// Define el enlace url de la imagen, debe haber por lo menos un parametro
						$enlace = $row_columna["url"];
						$array_querystring=array();
						$primero = true;
						foreach ($row_columna["parametros"] as $parametro) {
							$enlace .= (($primero)?"?":"&amp;").$parametro["para_nombre"]."=";
							$enlace .= ($parametro["para_tipo"]=="cte")?$parametro["para_dato"]:$row_dato[$parametro["para_dato"]];
							$array_querystring[$parametro["para_nombre"]]=($parametro["para_tipo"]=="cte")?$parametro["para_dato"]:$row_dato[$parametro["para_dato"]];
							$primero = false;
						}
						
						if(isset($row_columna['funcion_md5']))
						{
							call_user_func_array($row_columna['funcion_md5'], array($row_columna["url"], $array_querystring, &$querystring_nousar, &$md5 ));
							$enlace .= (($primero)?"?":"&amp;")."md5=".$md5;
						}

						//define la imagen
						$imagen = $row_columna["imagen"];

						?>
						<a href="<?php echo $enlace ?>"> 
							<img src="<?php echo $imagen ?>" alt="<?php echo $row_columna["altImagen"]?>" border="0" />
						</a>
						<?php
					
						break;

					case "addValor" :
					
						// Es un único parametro						
						foreach ($row_columna["parametros"] as $parametro) {
							if ($parametro["para_tipo"]=="cte") 
								$codigo=$parametro["para_dato"];	
							else 
								$codigo=$row_dato[$parametro["para_dato"]];
						}

						$imagen = $row_columna["imagen"];
						
						if (isset($row_columna["documentAddValor"]))
							$ventana=$row_columna["documentAddValor"];
						else
							$ventana='window.opener.document';
	
						$accion_submit="";
						if ( isset($row_columna["submitAddValor"]) && ($row_columna["submitAddValor"]=='si'))
							$accion_submit = $ventana.".".$row_columna["nombreFormularioSubmitAddValor"].".submit()";
						
						// Nuevo (modificado x error) - $row_columna["nombreContenidoAddValor"] por $row_dato[$row_columna["nombreContenidoAddValor"]] en el valor que se pasa 
						
					 ?>	
						<a href=javascript:void(0) onClick="addValorPopup(<?php echo $ventana ?>,'<?php echo $row_columna["idtextboxAddValor"] ?>', '<?php echo $codigo ?>', '<?php echo isset($row_columna["nombreContenidoAddValor"])?$row_dato[$row_columna["nombreContenidoAddValor"]]:""  ?>','<?php  echo isset($row_columna["idtextoContenidoAddValor"])?$row_columna["idtextoContenidoAddValor"]:"" ?>');<?php echo $accion_submit ?>;window.close();"> 
							<img src="<?php echo $imagen ?>" alt="<?php echo $row_columna["altImagen"]?>" border="0" />
						</a>
					<?php
						break;

					case "popup" :

						// Nuevo (modificado)
				
						// Se podría parametrizar más
						$enlace = $row_columna["url"];
						$array_querystring=array();
						$primero = true;

						// Define el enlace url del popup, debe haber por lo menos un parametro
						foreach ($row_columna["parametros"] as $parametro) {
							$enlace .= (($primero)?"?":"&amp;").$parametro["para_nombre"]."=";
							$enlace .= ($parametro["para_tipo"]=="cte")?$parametro["para_dato"]:$row_dato[$parametro["para_dato"]];
							$array_querystring[$parametro["para_nombre"]]=($parametro["para_tipo"]=="cte")?$parametro["para_dato"]:$row_dato[$parametro["para_dato"]];
							$primero = false;
						}

						if(isset($row_columna['funcion_md5']))
						{
							call_user_func_array($row_columna['funcion_md5'], array($row_columna["url"], $array_querystring, &$querystring_nousar, &$md5 ));
							$enlace .= (($primero)?"?":"&amp;")."md5=".$md5;
						}
												
						// Define la leyenda 
						if (isset($row_columna["leyenda_param"])) {							
							if ($row_columna["leyenda_param"]["tipo_param"] == "cte" )
								$leyenda = $row_columna["leyenda_param"]["valor"];							
							else 
								$leyenda = $row_dato[$row_columna["leyenda_param"]["valor"]];															
						} else 
								$leyenda ="";

						$ancho= (isset($row_columna['ventanaAnchoPopup']))?$row_columna['ventanaAnchoPopup']:430;
						$alto = (isset($row_columna['ventanaAltoPopup']))?$row_columna['ventanaAltoPopup']:360;
						$varx = (isset($row_columna['ventanaVarxPopup']))?$row_columna['ventanaVarxPopup']:"screen.availWidth-450";
						$vary = (isset($row_columna['ventanaVaryPopup']))?$row_columna['ventanaVaryPopup']:"screen.availHeight-420";

						?>
						<a href=javascript:void(0) onClick="Popup('<?php echo $enlace ?>','ventana_descripciones',<?php echo $ancho ?>,<?php echo $alto; ?>,<?php echo $varx ?>,<?php echo $vary ?>,'yes');" class='<?php echo $glb_grilla['estilo']['textoLink'] ?>'> 
							<?php if (isset($row_columna["imagen"])) {?> 
									<img src="<?php echo $row_columna["imagen"] ?>" alt="<?php echo $row_columna["altImagen"]?>" border="0" />
							<?php } 
								echo $leyenda ;
							?>
						</a>
						<?php							
					}
				}	else // El explorer no muestra bien los bordes si no hay nada
					  echo "&nbsp;";								
?>							
			</td>
		<?php } ?>
	</tr>
<?php } ?>
</table>
<?php if ($glb_grilla['botonera_posicion']=='abajo') { ?>
<?php 		if (($this->DeshabilitarBtsAdelante!="disabled") || ($this->DeshabilitarBtsAtras!="disabled")) { ?>		
			<table width="<?php $this->_($this->ancho)?>" border="0" cellpadding="0" cellspacing="0" align="center">
				<tr>
					<td class='<?php echo $glb_grilla['estilo']['textoFilaPaginado'] ?>'> 
						<?php	include $this->loadTemplate($glb_grilla['tpl_botones']); ?> 
					</td> 
				</tr>
			</table>
<?php 		} ?>
<?php } ?>
</div>