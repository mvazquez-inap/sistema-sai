require_once('sys_ddf/ctes_grales.dhtml');
require_once('sys_ddf/funciones_ddf.dhtml');

if (RUN_ACTUAL==RUN_DESARROLLO) {
	ini_set("display_errors",1);
	ini_set("mysql.trace_mode",0);
