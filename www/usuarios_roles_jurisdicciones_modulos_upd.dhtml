			}
			
			else
				formulario.checkbox_<?=$filamodulos['modulocod']?>.disabled=true;
		<?php }
	?>
		
	}
	var indiceroljurisd;
	indiceroljurisd=-1;
	for(i=1;i<datos_grilla.length;i++)
	{
		if (datos_grilla[i][indicerolcod]==rol && datos_grilla[i][indicejurisdid]==jurisd)
			indiceroljurisd=i;
	}
	if (indiceroljurisd>-1)
	{<?php
		$spnombremodulos="sel_modulos_gruposmod_modulos_orden";
		$spparammodulos=array('porderby'=>"modulocod");
		$conexion->ejecutarStoredProcedure($spnombremodulos,$spparammodulos,$querymodulos,$numfilas,$errorcod);
