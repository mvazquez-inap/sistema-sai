<script type="text/javascript">
function ArmaComboArea(tipo,area_codigo,idCombo,idAguarde) {

	var archivo="obtener_areas_ajax.dhtml";		
	var datos="tipo_area="+tipo;
		datos+="&area_codigo="+area_codigo;

	var contenedor=document.getElementById(idAguarde);
	contenedor.innerHTML='Aguarde, cargando área ...';
	
	var objCombo=document.getElementById(idCombo);
	
	var ajax=nuevoAjax();
	ajax.open("POST",archivo,true);

	ajax.onreadystatechange=function() {
		if (ajax.readyState==4) {	
//			if (ajax.responseText.substr(0,15)=="//tienepermisos") 	{				
				objCombo.innerHTML=ajax.responseText;
				contenedor.innerHTML='';
//			} else {	
//				objCombo.innerHTML="Ud. no tiene los permisos";
//				contenedor.innerHTML='';
//			}
				
		}
	}

	ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
	ajax.send(datos);		
}	
//-----------------------------------------------------------------------------------
function VaciarCombo(doc, objCombo) {

	if (!doc)
		doc = objCombo.document;

	while(objCombo.length>0)
		objCombo.remove(0);

	var opt = doc.createElement('OPTION');
		opt.value = 0;
		opt.text = "-- Todas ";
		
	objCombo.options.add(opt);						
}
//-----------------------------------------------------------------------------------
function SeleccionCaracterAlta(formulario, nom_fechadef) {

	if (formulario.presdoc_caracter_alta[0].checked) {
		CambiarEstado_Visibilidad(nom_fechadef,'invisible');
	} else {	
		CambiarEstado_Visibilidad(nom_fechadef,'visible');

	}
}
//------------------------------------------------------------------------------------------------
function Validar(formulario) {

	if(formulario.presdoc_cuilt.value!="" && !ValidarContenido(formulario.presdoc_cuilt.value,"CUIT"))	{
		alert("El CUIT/CUIL/CDI no es válido");
		formulario.presdoc_cuilt.focus();
		return false;	
	}
			
/*	if(formulario.presdoc_estado.value!="")	{
		alert("El estado no es válido");
		formulario.presdoc_estado.focus();
		return false;	
	}

	if(formulario.presins_codigo.value!="")	{
		alert("La instirución  no es válida");
		formulario.presins_codigo.focus();
		return false;	
	}
*/
	if (formulario.presdoc_falta_desde.value!="" && !ValidarFecha(formulario.presdoc_falta_desde.value)) {
		alert("La fecha de carga (DESDE) del prestador docente es inválida");
		formulario.presdoc_falta_desde.focus();
		return false;
	}
	if (formulario.presdoc_falta_hasta.value!="" && !ValidarFecha(formulario.presdoc_falta_hasta.value)) {
		alert("La fecha de carga (HASTA) del prestador docente es inválida");
		formulario.presdoc_falta_hasta.focus();
		return false;
	}

	if (formulario.presdoc_falta_desde.value!="" && formulario.presdoc_falta_hasta.value!="") {
		var fecha1=ConvertirFecha(formulario.presdoc_falta_desde.value,'dd/mm/aaaa','aaaammdd');
		var fecha2=ConvertirFecha(formulario.presdoc_falta_hasta.value,'dd/mm/aaaa','aaaammdd');
		if (fecha1>fecha2) 	{
			alert("La fecha de carga (DESDE) debe ser menor que la fecha de carga (HASTA)");
			formulario.presdoc_falta_desde.focus();
			return false;
		}
	}

	if (formulario.presdoc_falta_prov_desde.value!="" && !ValidarFecha(formulario.presdoc_falta_prov_desde.value)) {
		alert("La fecha de alta provisoria (DESDE) es inválida");
		formulario.presdoc_falta_prov_desde.focus();
		return false;
	}
	if (formulario.presdoc_falta_prov_hasta.value!="" && !ValidarFecha(formulario.presdoc_falta_prov_hasta.value)) {
		alert("La fecha de alta provisoria (HASTA) es inválida");
		formulario.presdoc_falta_prov_hasta.focus();
		return false;
	}

	if (formulario.presdoc_falta_prov_desde.value!="" && formulario.presdoc_falta_prov_hasta.value!="") {
		var fecha1=ConvertirFecha(formulario.presdoc_falta_prov_desde.value,'dd/mm/aaaa','aaaammdd');
		var fecha2=ConvertirFecha(formulario.presdoc_falta_prov_hasta.value,'dd/mm/aaaa','aaaammdd');
		if (fecha1>fecha2) 	{
			alert("La fecha de alta provisoria (DESDE) debe ser menor que la fecha provisoria (HASTA)");
			formulario.presdoc_falta_prov_desde.focus();
			return false;
		}
	}

	if (formulario.presdoc_falta_def_desde.value!="" && !ValidarFecha(formulario.presdoc_falta_def_desde.value)) {
		alert("La fecha de alta de definitiva (DESDE) es inválida");
		formulario.presdoc_falta_def_desde.focus();
		return false;
	}
	if (formulario.presdoc_falta_def_hasta.value!="" && !ValidarFecha(formulario.presdoc_falta_def_hasta.value)) {
		alert("La fecha de alta de definitiva (HASTA) es inválida");
		formulario.presdoc_falta_def_hasta.focus();
		return false;
	}
	
	if (formulario.presdoc_falta_def_desde.value!="" && formulario.presdoc_falta_def_hasta.value!="") {
		var fecha1=ConvertirFecha(formulario.presdoc_falta_def_desde.value,'dd/mm/aaaa','aaaammdd');
		var fecha2=ConvertirFecha(formulario.presdoc_falta_def_hasta.value,'dd/mm/aaaa','aaaammdd');
		if (fecha1>fecha2) 	{
			alert("La fecha de alta definitiva (DESDE) debe ser menor que la fecha definitiva (HASTA)");
			formulario.presdoc_falta_def_desde.focus();
			return false;
		}
	}

	// Ver por ahi viene bien para el caso de inconsistencias 
/*	if (formulario.presdoc_falta_prov_desde.value!="" && formulario.presdoc_falta_def.value!="") {
		var fecha1=ConvertirFecha(formulario.presdoc_falta_prov.value,'dd/mm/aaaa','aaaammdd');
		var fecha2=ConvertirFecha(formulario.presdoc_falta_def.value,'dd/mm/aaaa','aaaammdd');
		if (fecha1>fecha2) 	{
			alert("La fecha de alta provisoria debe ser mayor que la definitiva");
			formulario.presdoc_falta_prov.focus();
			return false;
		}
	}
*/

/*	if(formulario.areacon_codigo.value!="")	{
		alert("El área contextual no corresponde a un área válida");
		formulario.areacon_codigo.focus();
		return false;	
	}
	
	if(formulario.areagen_codigo.value!="")	{
		alert("El área general no corresponde a un área válida");
		formulario.areagen_codigo.focus();
		return false;	
	}
	
	if(formulario.areaesp_codigo.value!="")	{
		alert("El área específica no corresponde a un área válida");
		formulario.areaesp_codigo.focus();
		return false;	
	}	
*/	

	return true;
}
