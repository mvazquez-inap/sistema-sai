<?php
require('./include.dhtml');
header('Content-Type: text/html; charset=utf-8');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

//--------------------------------------------------------------------------------------------------------------------------------------------------------
$oPoc = new cPoc($conexion);
$ArregloDatos = array( "poc_codigo"=>$_POST['poc_codigo']);

$error = false;
if (!$oPoc->BuscarPoc($ArregloDatos,$numfilas,$result_poc,$error,$errormail)) {
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
	$error = true;
}
if (!$error) {
	$fila_poc = mysqli_fetch_assoc($result_poc);
	$descri="";
		if ($conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","POCESTADO","' and constantecod='",$fila_poc['poc_estado'],"'"),$descri,$numfilas,$errorcod))
			echo $descri;	
		echo "&nbsp;&nbsp;";
 		$spnombre="sel_constantes_grales_xsistemanom_constantetipo";
		$spparam = array('pconstantetipo'=>"POCESTADO",
		 'psistemanom'=>SISTEMA);							
		FuncionesPHPLocal::ArmarCombo_SinSalto_BD($conexion,$spnombre,$spparam,"formulario_filtros","poc_estado","constantecod","constantedesc","","-- Seleccione Nuevo Estado",$fila_estado,$sel_estado,1,"",$style="width:250px",false,false);
}

