//------------------------------------------------------------------------------------------------
function armarquerystring($clavecombo)
{
	// si existe en el get la variable $clavecombo, la elimino
	if(isset($_GET[$clavecombo]))
	{
		return substr($_SERVER['QUERY_STRING'],0,strpos($_SERVER['QUERY_STRING'],$clavecombo)-1);
	} else
	{
		return $_SERVER['QUERY_STRING'];
	}
}

