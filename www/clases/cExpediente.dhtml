//----------------------------------------------------------------------------------------- 
class cExpediente {

	var $conexion;
	public function __construct($conexion,$formato=FMT_TEXTO) {
		$this->conexion = &$conexion;
		$this->formato = $formato;
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosExpediente($exp_codigo,&$datosresult,&$es_modif){
	
		$datosresult=array();
		$es_modif = false;		
		$sparam=array('pexp_codigo'=>$exp_codigo);
		$spnombre="sel_expediente_xexp_codigo";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))	{
			$errormail="\nexp_codigo=".$exp_codigo."\nerror=".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el Expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function ObtenerSPClave(&$spnombre,&$spparam,$codigo) {
		$spnombre="sel_expediente_xexp_codigo";
		$spparam=array('pexp_codigo'=>$codigo);
	}
//-----------------------------------------------------------------------------------------------------	
	function AltaDatosExpediente($datos) {

		if(!$this->_DatosValidosAltaExpediente($datos,$datosvalidados))
			return false;
	
		// El que valida determina el jurisdicccion y estado según el usuario que da el alta
		$spnombre="ins_expediente";
		$spparam=array(
			'pexp_numero'=>$datosvalidados['exp_numero'],
			'pjurisdid_exp'=>$datosvalidados['jurisdid_exp'],
			'pexp_fecha_inicio'=>FuncionesPHPLocal::ConvertirFecha($datosvalidados['exp_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd'),
			'pexp_fecha_ingreso'=>FuncionesPHPLocal::ConvertirFecha($datosvalidados['exp_fecha_ingreso'],'dd/mm/aaaa','aaaa-mm-dd'),
			'pexp_obs'=>$datosvalidados['exp_obs'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=>date("Y/m/d H:i:s")
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo dar de alta el Expediente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}
	
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function PosibleBajaFisica($exp_codigo) {

		// actividad_autodesarrollo_dictamen para actividades autodesarrollo
		if(!$this->conexion->TraerCampo('actividad_autodesarrollo_persona','exp_codigo',array("exp_codigo='",$exp_codigo,"'"),$dato,$numfilas,$errno)) {
			$error="Error al intentar la baja.";
			$errormail="Error al determinar si puede ser realizada la baja física del expediente (actividad_autodesarrollo_persona). error=".$errno."exp_codigo='".$exp_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$errormail);
			return false;	
	    } elseif ($numfilas!=0) {
			return false;	
		}

		// actividad_programacion para actividades curso
		if(!$this->conexion->TraerCampo('actividad_programacion','exp_codigo',array("exp_codigo='",$exp_codigo,"'"),$dato,$numfilas,$errno)) {
			$error="Error al intentar la baja.";
			$errormail="Error al determinar si puede ser realizada la baja física del expediente (actividad_programacion). error=".$errno."exp_codigo='".$exp_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$errormail);
			return false;	
	    } elseif ($numfilas!=0) {
			return false;	
		}

		// actividad_externa_persona para actividades externas
		if(!$this->conexion->TraerCampo('actividad_externa_persona','exp_codigo',array("exp_codigo='",$exp_codigo,"'"),$dato,$numfilas,$errno)) {
			$error="Error al intentar la baja.";
			$errormail="Error al determinar si puede ser realizada la baja física del expediente (actividad_externa_persona). error=".$errno."exp_codigo='".$exp_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$errormail);
			return false;	
	    } elseif ($numfilas!=0) {
			return false;	
		}
		
		return true;
	}
