<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oPrestadorDocenteComision= new cComisionPrestadorDocente($conexion);
//----------------------------------------------------------------------------------------- 
function Validarphp($conexion,&$datosvalidados) {

	$datosvalidados=array();
	if($_POST['comi_codigo']=="") {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en la selección de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
		
	// Tengo que obtener la actividad de la comision
	$oComision= new cComisionPrestadorDocente($conexion);		
	$ArregloDatos=array("comi_codigo"=>$_POST['comi_codigo'],"comi_estado"=>COMISIONNUEVA.",".COMISIONABIERTA);	

	if ($_SESSION['rolcod'] == SUPERUSUARIO)
		$ArregloDatos=array("comi_codigo"=>$_POST['comi_codigo'],"comi_estado"=>COMISIONNUEVA.",".COMISIONABIERTA.",".COMISIONCERRADA.",".COMISIONCERTIFICADA);	
	
	
	if(!$oComision->BuscarComision($ArregloDatos,$numfilas,$resulcomi,$error,$errormail)) {
		$txt_sys_mail="Error al buscar para la comisión NUEVA - \ncomi_codigo=".$_POST['comi_codigo'];
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	} elseif ($numfilas!=1) {
		$txt_sys_mail="Hay más de un registro para la comisión\ncomi_codigo=".$_POST['comi_codigo'];
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
	$fila_comision = mysqli_fetch_assoc($resulcomi);
	$datosvalidados["act_codigo"]=$fila_comision['act_codigo'];
	$datosvalidados["comi_codigo"]=$_POST['comi_codigo'];

	if(isset($_POST['listaprestadoresabajo']))
		$arrayfinal=$_POST['listaprestadoresabajo'];
	else
		$arrayfinal=array();

	$arrayinicial=array();
	if(!$oComision->BuscarComisionPrestadorDocente(array("comi_codigo"=>$datosvalidados['comi_codigo']),$numfilas,$resulprestadores,$error,$errormail)) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar prestadores.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}

	while($filaprestador=mysqli_fetch_assoc($resulprestadores))
		$arrayinicial[]=$filaprestador['presdoc_codigo'];

/*	echo "<br>Array inicial =";
	print_r($arrayinicial);

	echo "<br>Array final =";
	print_r($arrayfinal);
*/
	$arraysacar=array_diff($arrayinicial,$arrayfinal);
	$arrayponer=array_diff($arrayfinal,$arrayinicial);

	$datosvalidados["prestadoressacar"]=$arraysacar;
	$datosvalidados["prestadoresponer"]=$arrayponer;

    // Los prestadores que se agregan deben estar en el equipo docente de la actividad.
	// foreach ($_POST['listaprestadoresabajo'] as $presdoc_codigo ) {
	foreach ($datosvalidados['prestadoresponer'] as $i=>$presdoc_codigo ) {
		$spparam = array( "pact_codigo"=>$datosvalidados['act_codigo'],
						  "pactpres_estado"=>ACTPRESDOCACTIVO);
		if(!$conexion->BuscarRegistroxClave("sel_equipo_prestadores_docentes_xact_codigo_estado",$spparam,				  
				  array("presdoc_codigo"=>$presdoc_codigo),$resultado,$filaret,$numfilasmatcheo,$errno)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al verificar el docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		if($numfilasmatcheo==0)	{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"El docente no se encuentra activo en el equipo de prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	}

/*	echo "<br> Array sacar=";	
	print_r($datosvalidados["prestadoressacar"]);

	echo "<br> Array poner=";
	print_r($datosvalidados["prestadoresponer"]);
*/		
	return true;
}
//----------------------------------------------------------------------------------------- 	
	$result=true;
	
	if(isset($_POST['botonalta']) && !Validarphp($conexion,$datosvalidados))	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"040099","",$_SESSION['usuariocod']);	
		$result=false;
	}

	if ($result) {
		if(isset($_POST['botonalta'])) {
			$conexion->ManejoTransacciones("B");
			foreach($datosvalidados["prestadoresponer"] as $presdoc_codigo)	{
				$ArregloDatos=array('comi_codigo'=>$datosvalidados['comi_codigo'],'act_codigo'=>$datosvalidados['act_codigo'],'presdoc_codigo'=>$presdoc_codigo);				
				if (!$oPrestadorDocenteComision->AltaDatosComisionPrestadorDocente($ArregloDatos)) {	
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al actualizar los prestadores de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$result=false;
					break;
			}
			FuncionesPHPLocal::RegistrarAcceso($conexion,'50301',"comi_codigo=".$datosvalidados['comi_codigo']."-"."presdoc_codigo=".$presdoc_codigo,$_SESSION['usuariocod']);
		}

		if($result) {
			foreach($datosvalidados["prestadoressacar"] as $presdoc_codigo) 	{
				if (!$oPrestadorDocenteComision->EliminarDatosComisionPrestadorDocente($datosvalidados['comi_codigo'],$presdoc_codigo)) {	
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al actualizar los prestadores de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$result=false;
					break;
				}
				FuncionesPHPLocal::RegistrarAcceso($conexion,'50302',"comi_codigo=".$datosvalidados['comi_codigo']."-"."presdoc_codigo=".$presdoc_codigo,$_SESSION['usuariocod']);
			}
		}
		
		if($result) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se actualizaron los docentes de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$conexion->ManejoTransacciones("C");
		} else
			$conexion->ManejoTransacciones("R");
	}
}
?>
	<br><br><div align="center"><a href="comision_docente.dhtml" class="linkFondoBlanco">Volver</a></div>

<?php $oEncabezados->PieMenuEmergente(); ?>