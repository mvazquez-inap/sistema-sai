			</tr>
			<tr>
				<td class='textoEtiqueta' width="30%" align="left">Nombre</td>
				<td class="textoEtiquetaDatoResaltado" align="left"><input type="text"  class="textoInput" size="30" maxlength="30" name="pers_nombre" disabled="disabled" value="<?php echo ($es_modif)?$datospersona['pers_nombre']:""?>" /></td>
			</tr>
            
        	<tr>
				<td class='textoEtiqueta' width="30%" align="left">Email</td>
				<td class="textoEtiquetaDatoResaltado" align="left"><input type="text" name="pers_email" id="pers_email"  class='textoInput' size="32"  maxlength="100"  value="<?php echo ($es_modif)?$datospersona['pers_email']:""?>" /></td>
			</tr>

		</table>
