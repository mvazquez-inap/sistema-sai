//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccion($oActividadCursoInstitucionalPersona, $act_codigo) {

	$ArregloDatos= array();
	$ArregloDatos['act_codigo'] = $act_codigo;
	$ArregloDatos['orderby'] = "pers_apellido, pers_nombre";
	
	if (!$oActividadCursoInstitucionalPersona->BuscarActividadAsignadaPersona($ArregloDatos,$numfilas,$result,$error,$errormail)) {
		$txt_sys_mail="\nact_codigo".$act_codigo."\nerror=".$errormail;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}			
	
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>15
	);
	

	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
	
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla("Personas Asignados a la Actividad. "."\n\n"."TOTAL:   ".$numfilas);	
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Apellido');
	$oGrilla->Setear('campo_grilla',$miColumna3,'pers_apellido');
	$oGrilla->Setear('align_columna',$miColumna3,'left');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna2,'pers_nombre');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'CUIT/CUIL');
	$oGrilla->Setear('campo_grilla',$miColumna1,'pers_cuilt');
	$oGrilla->Setear('align_columna',$miColumna1,'left');


	$miColumna5 = $oGrilla->AddColumna('popup');
	$oGrilla->Setear('ancho_columna',$miColumna5,'60');
	$oGrilla->Setear('imagen',$miColumna5,'images/imprimir.gif');
	$oGrilla->Setear('altImagen',$miColumna5,'Imprimir');		
	$oGrilla->Setear('titulo_columna',$miColumna5,'Imprimir');
	$oGrilla->Setear('url',$miColumna5,'constancias_certificacion_creditos_download.dhtml');
	$oGrilla->Setear('ventanaAnchoPopup',$miColumna5,'650');
	$oGrilla->Setear('ventanaAltoPopup',$miColumna5,'450');
	$oGrilla->Setear('ventanaVarxPopup',$miColumna5,'130');
	$oGrilla->Setear('ventanaVaryPopup',$miColumna5,'50');
	$oGrilla->AddParametrosURL($miColumna5,"tipo",4,"cte");
	$oGrilla->AddParametrosURL($miColumna5,"act_codigo",'act_codigo');
	$oGrilla->AddParametrosURL($miColumna5,"pers_codigo",'pers_codigo');

	if (!$oGrilla->CargarGrilla($result))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
