						<tr>
							<td valign="top" width="15%" class='textoEtiqueta'>Código INAP</td>
							<td class="textoEtiquetaDatoResaltado"><input type="text" name="act_codinap" id="act_codinap"  class="inputReadonly" readonly="readonly" size="21" maxlength="20" value="<?php echo htmlspecialchars($filaexterna['act_codinap'],ENT_QUOTES) ?>">
							</td>
						</tr>
						<tr>
							<td valign="top" width="25%" class='textoEtiqueta'>Tipo de Actividad</td>
							<td class="textoEtiquetaDatoResaltado">	<?php 
								$conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$filaexterna['tipoact_codigo'],"'"),$tipoact_descripcion,$numfilas,$errno);
