 	 	break;
	 case TIPOACTAUTODOCENTE:
	 case TIPOACTAUTOEVASIS:
	 case TIPOACTAUTOEVACT:
	 case TIPOACTAUTOPUBLI:
	 case TIPOACTAUTOASISTEC:	 	 	 
	 case TIPOACTAUTOAAUTOFORM:	 	 	 	 
 	 	 $oActividad = new cActividadAutodesarrollo($conexion);
 	 	break;
	 }

