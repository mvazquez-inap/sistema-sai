//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifDictamenPersonal($datos,&$datosvalidados) {

		if (!$this->TienePermisoModificarDictamenPersonal($datos['dic_codigo'])) {
			return false; 
		}
	
		if (!$this->_DatosValidosComunesDictamenPersonal($datos,$datosvalidados))
		   return false; 
		
		return true;
	}
	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosComunesDictamenPersonal($datos,&$datosvalidados) {

		// Pertinencia 	- [dic_pertinencia] 	- [OBLIG]
		if(!($datos['dic_pertinencia'] == SI ||$datos['dic_pertinencia'] == NO) )	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la pertinencia. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados['dic_pertinencia'] = $datos['dic_pertinencia'];

		if ($datos['dic_pertinencia'] == SI) {
			
			// Ponderador 	- [pondtipopond_codigo_cal_pres] 	- [OBLIG]
			$oPonderadorDictamen = new cPonderadorDictamen($this->conexion);
			$oPonderadorDictamen->PonderadorValoresSP(TIPOPONDCALPRESTADOR,$spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("pondtipopond_codigo"=>$datos['pondtipopond_codigo_cal_pres']),$resultado,$fila,$numfilas,$errno) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el ponderador.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["pondtipopond_codigo_cal_pres"]=$datos['pondtipopond_codigo_cal_pres'];
	
			// Ponderador 	- [pondtipopond_codigo_int] 	- [OBLIG]
			$oPonderadorDictamen->PonderadorValoresSP(TIPOPONDINTENSIDAD,$spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("pondtipopond_codigo"=>$datos['pondtipopond_codigo_int']),$resultado,$fila,$numfilas,$errno) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el ponderador.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["pondtipopond_codigo_int"]=$datos['pondtipopond_codigo_int'];
	
			// Ponderador 	- [pondtipopond_codigo_proc_eva] 	- [OBLIG]
			$oPonderadorDictamen->PonderadorValoresSP(TIPOPONDCALPROCESO,$spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("pondtipopond_codigo"=>$datos['pondtipopond_codigo_proc_eva']),$resultado,$fila,$numfilas,$errno) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el ponderador.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["pondtipopond_codigo_proc_eva"]=$datos['pondtipopond_codigo_proc_eva'];
	
			// Créditos 	- [act_creditos] 	- [OBLIG]
			if (!FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['act_creditos'],"NumericoEntero"))
			{
				$arraymensajepantalla="Debe ingresar la cantidad de créditos";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
			if ($datos['act_creditos'] <= 0)
			{
				$arraymensajepantalla= "La cantidad de créditos tiene que ser mayor a 0";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["act_creditos"]=$datos['act_creditos'];

		} else {
			$datosvalidados["pondtipopond_codigo_cal_pres"] = 3;
			$datosvalidados["pondtipopond_codigo_int"] = 6;
			$datosvalidados["pondtipopond_codigo_proc_eva"] = 9;						
			$datosvalidados["act_creditos"]="0";
		}		
		$datosvalidados["dic_observaciones"]=isset($datos['dic_observaciones'])?$datos['dic_observaciones']:"";
		$datosvalidados["act_codigo"]=$datos["act_codigo"];
		$datosvalidados["dic_codigo"]=$datos["dic_codigo"];
		$datosvalidados["pers_codigo"]=$datos["pers_codigo"];		
		$datosvalidados["actautodic_obs"]=$datos["actautodic_obs"];				
		
		return true;	
	}	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosComunesDictamen($datos,&$datosvalidados) {
		
		// Siempre viene porque en programacion se lo agregamos.
		if ((isset($datos['dic_pertinencia']) && ($datos['dic_pertinencia'] == SI))) {
		
			// Ponderador 	- [pondtipopond_codigo_cal_pres] 	- [OBLIG]
			$oPonderadorDictamen = new cPonderadorDictamen($this->conexion);
			$oPonderadorDictamen->PonderadorValoresSP(TIPOPONDCALPRESTADOR,$spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("pondtipopond_codigo"=>$datos['pondtipopond_codigo_cal_pres']),$resultado,$fila,$numfilas,$errno) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el ponderador.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["pondtipopond_codigo_cal_pres"]=$datos['pondtipopond_codigo_cal_pres'];
	
			// Ponderador 	- [pondtipopond_codigo_int] 	- [OBLIG]
			$oPonderadorDictamen->PonderadorValoresSP(TIPOPONDINTENSIDAD,$spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("pondtipopond_codigo"=>$datos['pondtipopond_codigo_int']),$resultado,$fila,$numfilas,$errno) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el ponderador.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["pondtipopond_codigo_int"]=$datos['pondtipopond_codigo_int'];
	
			// Ponderador 	- [pondtipopond_codigo_proc_eva] 	- [OBLIG]
			$oPonderadorDictamen->PonderadorValoresSP(TIPOPONDCALPROCESO,$spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("pondtipopond_codigo"=>$datos['pondtipopond_codigo_proc_eva']),$resultado,$fila,$numfilas,$errno) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el ponderador.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["pondtipopond_codigo_proc_eva"]=$datos['pondtipopond_codigo_proc_eva'];
	
			// Créditos 	- [act_creditos] 	- [OBLIG]
			if (!FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['act_creditos'],"NumericoEntero"))
			{
				$arraymensajepantalla="Debe ingresar la cantidad de créditos";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
			if ($datos['act_creditos'] <= 0)
			{
				$arraymensajepantalla= "La cantidad de créditos tiene que ser mayor a 0";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		}
		if ((isset($datos['dic_pertinencia']) && ($datos['dic_pertinencia'] == NO))) {
			$datosvalidados["pondtipopond_codigo_cal_pres"] = 3;
			$datosvalidados["pondtipopond_codigo_int"] = 6;
			$datosvalidados["pondtipopond_codigo_proc_eva"] = 9;						
			$datosvalidados["act_creditos"]="0";
		}
		
		
		$datosvalidados["dic_observaciones"]=isset($datos['dic_observaciones'])?$datos['dic_observaciones']:"";
		$datosvalidados["act_creditos"]=$datos['act_creditos'];
		$datosvalidados["act_codigo"]=$datos["act_codigo"];
		$datosvalidados["dic_codigo"]=$datos["dic_codigo"];
		
		if (isset($datos["dic_pertinencia"])) 
			$datosvalidados["dic_pertinencia"]=$datos["dic_pertinencia"];			
		return true;	
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosComunesProgramacion($datos,&$datosvalidados) {

		// Fecha Inicio- [actprog_fecha_inicio] 	- [OBLIG]
		if (trim($datos['actprog_fecha_inicio'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['actprog_fecha_inicio'],"FechaDDMMAAAA"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de incio de la programación no es válida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$fechaincio_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['actprog_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd');

		// Fecha Fin- [actprog_fecha_fin] 	- [OBLIG]
		if (trim($datos['actprog_fecha_fin'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['actprog_fecha_fin'],"FechaDDMMAAAA"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de fin de la programación no es válida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$fechafin_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['actprog_fecha_fin'],'dd/mm/aaaa','aaaa-mm-dd');

		// La fecha de fin no puede ser mayor a la fecha de inicio
		if ($fechafin_AAAAMMDD < $fechaincio_AAAAMMDD)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de inicio debe ser menor o igual a la fecha de fin.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
				
		// para cada intervalo valido que fechaincio_AAAAMMDD > actprog_fecha_fin y  fechafin_AAAAMMDD < actprog_fecha_inicio	
		$ok = true;
		
		$spnombre = "sel_actividad_programacion_act_codigo";
		$spparam = array('pact_codigo'=>$datos['act_codigo'],'porderby'=>"actprog_sec");
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno)) {	
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando las programaciones.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result=false;
		}
		
		while (($fila_actprog = mysqli_fetch_assoc($query)) && ($ok)) {
			if ($datos['operacion_programacion'] == "A" || $fila_actprog['actprog_sec'] != $datos['actprog_sec']) { // excluyo la programación actual
				$fechalimiteinicio_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($fila_actprog['actprog_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa');
				$fechalimitefin_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($fila_actprog['actprog_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa');
				$fechalimiteinicio_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($fechalimiteinicio_AAAAMMDD,'dd/mm/aaaa','aaaa-mm-dd');
				$fechalimitefin_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($fechalimitefin_AAAAMMDD,'dd/mm/aaaa','aaaa-mm-dd');

				if (!($fechaincio_AAAAMMDD > $fechalimitefin_AAAAMMDD || $fechafin_AAAAMMDD < $fechalimiteinicio_AAAAMMDD) )
					$ok = false;
			}
		}


		if (!$ok) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La fecha de la programación se superpone <br>con alguna programación ingresada previamente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;		
		}

		// la programación tiene que estar abarcando a todas las comisiones
		// esto se puede dar solo cuando SUPERUSUARIO modifica las fechas de programación
		if ($_SESSION["rolcod"] == SUPERUSUARIO) {
		
			$ArregloDatos=array(	
							'act_codigo'=>$datos['act_codigo'],
							'tipoact_codigo'=>TIPOACTCURSOINAP,										
							);
			$this->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
			if($error) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			} else { 
					if ($numfilas > 0) { 
						$oComision= new cComision($this->conexion);
						
						$fecha_ok = true;
						foreach ($array_resultado as $clave=>$valor) { 
							$ArregloDatos=array();
							$ArregloDatos['act_codigo']=$datos['act_codigo'];
							if(!$oComision->BuscarComision($ArregloDatos,$numfilas,$result_comision,$error,$errormail)){
								FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error al buscar las comisiones de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;
							}
							
	
							while ($fila_comision = mysqli_fetch_assoc($result_comision)) {
							
							
								// Fecha comprendida en la programación
	
								if(!(FuncionesPHPLocal::FechasOrdenadas(date("d/m/Y",strtotime($valor['actprog_fecha_inicio'])),date("d/m/Y",strtotime($fila_comision['comi_fecha_inicio'])),date("d/m/Y",strtotime($valor['actprog_fecha_fin'])))
									&& FuncionesPHPLocal::FechasOrdenadas(date("d/m/Y",strtotime($valor['actprog_fecha_inicio'])),date("d/m/Y",strtotime($fila_comision['comi_fecha_fin'])),date("d/m/Y",strtotime($valor['actprog_fecha_fin']))))
									)
									$fecha_ok = false;
	
								// comparo con los datos del formulario
								if(!(FuncionesPHPLocal::FechasOrdenadas($datos['actprog_fecha_inicio'],date("d/m/Y",strtotime($fila_comision['comi_fecha_inicio'])),$datos['actprog_fecha_fin'])
									&& FuncionesPHPLocal::FechasOrdenadas($datos['actprog_fecha_inicio'],date("d/m/Y",strtotime($fila_comision['comi_fecha_fin'])),$datos['actprog_fecha_fin']))
									)
									$fecha_ok = false;
	
							} // while	
						} //foreach
						if (!$fecha_ok){
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error. La programaciones deben abarcar las fechas de las comisiones.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							return false;
						}
					} // if
					
			}	//if					
		
		} // if ($_SESSION["rolcod"] == SUPERUSUARIO) {
		
	
		$oActividadCurso = new cActividadCurso($this->conexion);
		$oActividadCursoJurisdiccional = new cActividadCursoJurisdiccional ($this->conexion);

		if ($oActividadCursoJurisdiccional->EsActividadCursoTipo($datos['act_codigo'],TIPOACTCURSOJURISD,$error,$errormsg)) {
		
			// Al menos una de las relaciones Act Poc / Poc de Poc incluídos en la vigencia deben estar aprobadar
			
			// obtengo todos los Años de vigencia
			$a_inicio = substr($datos['actprog_fecha_inicio'],6,4);
			$a_fin = substr($datos['actprog_fecha_fin'],6,4);
			$total_relaciones_aprobadas = 0;
			for ($a = $a_inicio; $a<=$a_fin;$a++){
			
				// por cada año, busco las Act Poc relacionadas APROBADAS
				
				$oPoc = new cPoc($this->conexion);
				$ArregloDatos = array(
								'poc_ano'=>$a,
								'jurisdid_inap'=>$_SESSION['jurisdid_inap'],
								'poc_estado'=>POCAPROBADO 
								);
	
				if(!$oPoc->BuscarPoc($ArregloDatos,$numfilas_poc,$resultado_poc,$error,$errormail)) 
				{
					$txt_sys_mail="\npoc_codigo_".$a."\nerror=".$errormail;
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					return false;			
				}
				else
				{ 
					if ($numfilas_poc == 1) {
				
						$fila_poc=mysqli_fetch_assoc($resultado_poc);
						
						// busco todas las Act Poc / Act aprobadas				
						$oPocActividadActividad = new cPocActividadActividad($this->conexion);				
					
						$filtro = array( 
										'poc_codigo'=>$fila_poc['poc_codigo'],
										'act_codigo'=>$datos['act_codigo'],							
										'pocactact_estado'=>POCACTIVIDADACTIVIDADAPROBADA						
										);
						
						if (!$oPocActividadActividad->BuscarPocActividadActividad($filtro,$numfilas_act_asignadas,$result_act_asignadas,$error,$errormail)) {
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
							return false;
						}
						
						$total_relaciones_aprobadas += $numfilas_act_asignadas;
	
					}
	
				}
		
			}
	
			if ($total_relaciones_aprobadas == 0 && $_SESSION['rolcod']!=SUPERUSUARIO) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La actividad a dictaminar no tiene relaciones Aprobadas con Actividades del POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;		
			}
		}	

		$datosvalidados['actprog_fecha_inicio'] = $datos['actprog_fecha_inicio'];
		$datosvalidados['actprog_fecha_fin'] = $datos['actprog_fecha_fin'];		

		// Dictamen 	- [dic_codigo] 	- [OBLIG]
		$oDictamen = new cDictamen($this->conexion);
		$oDictamen->ObtenerSPClave($spnombre,$spparam,$datos['dic_codigo']);
		
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("dic_codigo"=>$datos['dic_codigo']),$resultado,$fila,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el dictamen asociado a la programación. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["dic_codigo"]=$datos['dic_codigo'];		

		// Expediente 	- [exp_codigo] 	- [OBLIG]
		$oExpediente = new cExpediente($this->conexion);
		$oExpediente->ObtenerSPClave($spnombre,$spparam,$datos['exp_codigo']);
		
		
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("exp_codigo"=>$datos['exp_codigo']),$resultado,$fila,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el expediente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["exp_codigo"]=$datos['exp_codigo'];		
		$datosvalidados["act_codigo"]=$datos["act_codigo"];
		$datosvalidados["actprog_obs"]=$datos["actprog_obs"];		
		return true;
	
		
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosPedidoAprobacionDictamen($datos)	{

		switch ($_SESSION['rolcod']) {
			case USUCURSOINAP:
				$oActividad= new cActividadCursoInap($this->conexion);
				$tipoact_codigo=TIPOACTCURSOINAP;
				$formact_codigo=FORMATOCURSO;		
				break;
			case USUACTINS:
				$oActividad= new cActividadCursoInstitucional($this->conexion);
				$tipoact_codigo=TIPOACTCURSOINST;
				$formact_codigo=FORMATOCURSO;
				break;
			case USUACTJUR:
				$oActividad= new cActividadCursoJurisdiccional($this->conexion);
				$tipoact_codigo=TIPOACTCURSOJURISD;
				$formact_codigo=FORMATOCURSO;
				break;
			case USUACTEXT:
				$oActividad= new cActividadExterna($this->conexion);
				$formact_codigo=FORMATOEXT;
				$tipoact_codigo=TIPOACTEXTASIS;
				break;	
			case USUAUTODESARROLLO: // Es sólo para mero
				$oActividad= new cActividadAutodesarrollo($this->conexion);
				$formact_codigo=FORMATOAUTO;
				$tipoact_codigo=TIPOACTAUTOEVASIS;
				break;		
		}

		// valido que el tipo de activdad corresponad al del usuario logeado
		if ($tipoact_codigo!=$datos['tipoact_codigo']) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Ud. no tiene acceso para solicitar la el pedido de aprobación del dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// Obtengo dictamenes de la actividad del tipo a pedir aprobacion
		$ArregloDatos['act_codigo']=$datos['act_codigo'];
		$ArregloDatos['tipoact_codigo']=$datos['tipoact_codigo'];		
		$ArregloDatos['dic_estado']=DICTAMENNUEVO.",".DICTAMENRECHAZADO;
		if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} 
		if ($numfilas!=1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Se encontró una cantidad errónea de dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} 		
		$fila_dictamen_a_pedir_aprob = mysqli_fetch_assoc($resultDictamenes);
		if ($fila_dictamen_a_pedir_aprob['dic_codigo'] != $datos['dic_codigo']) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No se encontró el dictamen a solicitar la aprobación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		
		// valida que el dictamen tenga el estado correcto y que la programacion de la actividad
		// con la secuencia
		if (!$this->TienePermisoPedirAprobacionDictamen($datos['act_codigo'],$datos['actprog_sec'])) {
			return false;
		}		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosPedidoAprobacionDictamenPersonal($datos)	{

/*
		// NO HACE FALTA VALIDAR PORQUE ES LA PRECONDICIÓN PARA LLAMAR A ESTA RUTINA
		// valido que el tipo de activdad corresponad al del usuario logeado
		if ($tipoact_codigo!=$datos['tipoact_codigo']) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Ud. no tiene acceso para solicitar la el pedido de aprobación del dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
*/

		$oActividad= new cActividadAutodesarrollo($this->conexion);

		// Obtengo dictamenes de la actividad del tipo a pedir aprobacion
		$ArregloDatos['act_codigo']=$datos['act_codigo'];
		$ArregloDatos['tipoact_codigo']=$datos['tipoact_codigo'];		
		$ArregloDatos['dic_codigo']=$datos['dic_codigo'];				
		$ArregloDatos['dic_estado']=DICTAMENNUEVO.",".DICTAMENRECHAZADO;
		if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} 
		if ($numfilas!=1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Se encontró una cantidad errónea de dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} 		
		$fila_dictamen_a_pedir_aprob = mysqli_fetch_assoc($resultDictamenes);
		if ($fila_dictamen_a_pedir_aprob['dic_codigo'] != $datos['dic_codigo']) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No se encontró el dictamen a solicitar la aprobación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		
		// valida que el dictamen tenga el estado correcto y que la programacion de la actividad
		// con la secuencia
/*		if (!$this->TienePermisoPedirAprobacionDictamenPersonal($datos['act_codigo'],$datos['actprog_sec'])) {
			return false;
		}		
*/		
		return true;
	}

