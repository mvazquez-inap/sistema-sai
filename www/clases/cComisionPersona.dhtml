	function TienePermisoNotificarCreditos($comi_codigo,$rolcod,$jurisdid) {

		// Valida el estado con rol y la jurisdicción
		if (!$this->TraerDatosComision($comi_codigo,$fila_comi,$es_modif)) 
			return false;

		$txt_sys_mail="\comi_codigo=".$comi_codigo;			
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error, no existe la Comisión para notificar créditos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 

		if ($fila_comi['comi_estado'] != COMISIONCERTIFICADA)  {
			$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","COMISIONESTADO","' and constantecod='",$fila_comi['comi_estado'],"'"),$descri,$numfilas,$errorcod);
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El estado de la Comisión (".$descri."), no le permite notificar créditos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		$numfilas=0;
		$ArregloDatos = array();
		$ArregloDatos['comi_estado']=COMISIONCERTIFICADA;
		$ArregloDatos['act_codigo']=$fila_comi['act_codigo'];
		$ArregloDatos['comi_codigo']=$fila_comi['comi_codigo'];
		
		if 	($rolcod == USUCURSOINAP )  { //  Si la actividad de la comision es curso INAP esta todo OK.
			 $ArregloDatos['tipoact_codigo']=TIPOACTCURSOINAP;
		} elseif ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO) {  //  Si la actividad de la comision es curso de la jurisdiccion del usuario logueado esta OK.
			 $ArregloDatos['jurisdid_inap']=$_SESSION['jurisdid_inap'];
 			 $ArregloDatos['tipoact_codigo']=TIPOACTCURSOJURISD;
		} 
		
		if(!$this->BuscarComisionAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al verificar el acceso a al comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;	
		}
		if ($numfilas == 1) 
			return true;	

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No tiene permisos para notificar créditos de la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
			
	
	}	
		
//-----------------------------------------------------------------------------------------
	function BuscarActividadAsignadaPersona($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxact_codigo'=>0);
		$sparam+=array('pxpers_codigo'=>0);
		$sparam+=array('pxactprog_sec'=>0);
		$sparam+=array('pxeval_codigo'=>0);
		$sparam+=array('pxeval_certifica'=>0);
		$sparam+=array('pxcomi_codigo'=>0);
		
		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('ppers_codigo'=>"");
		$sparam+=array('pactprog_sec'=>"");
		$sparam+=array('peval_codigo'=>"-1");
		$sparam+=array('peval_certifica'=>"-1");
		$sparam+=array('pcomi_codigo'=>"-1");
		
		$sparam+=array('porderby'=>"act_codigo");

		if (isset ($ArregloDatos['act_codigo']))
		{
			if ($ArregloDatos['act_codigo']!="")
			{	
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['pers_codigo']))
		{
			if ($ArregloDatos['pers_codigo']!="")
			{	
				$sparam['ppers_codigo']= $ArregloDatos['pers_codigo'];
				$sparam['pxpers_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['actprog_sec']))
		{
			if ($ArregloDatos['actprog_sec']!="")
			{	
				$sparam['pactprog_sec']= $ArregloDatos['actprog_sec'];
				$sparam['pxactprog_sec']= 1;
			}
		}		
		if (isset ($ArregloDatos['eval_codigo']))
		{
			if ($ArregloDatos['eval_codigo']!="")
			{	
				$sparam['peval_codigo']= $ArregloDatos['eval_codigo'];
				$sparam['pxeval_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['eval_certifica']))
		{
			if ($ArregloDatos['eval_certifica']!="")
			{	
				$sparam['eval_certifica']= $ArregloDatos['eval_certifica'];
				$sparam['pxeval_certifica']= 1;
			}
		}	
		if (isset ($ArregloDatos['comi_codigo']))
		{
			if ($ArregloDatos['comi_codigo']!="")
			{	
				$sparam['pcomi_codigo']= $ArregloDatos['comi_codigo'];
				$sparam['pxcomi_codigo']= 1;
			}
		}	

		if (isset ($ArregloDatos['orderby'])) {
			if ($ArregloDatos['orderby']!="") {	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}
		
		$spnombre="sel_actividad_curso_persona_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar la Persona en Actividad Curso.";
			$errormail="Error al buscar la Persona en Actividad Curso.".$errno;
			return false;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------
	function BuscarPersonasValidasComisionCertificar($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{
		
		$spnombre="sel_personas_validas_certificacion_comision";	
		$sparam = array();
		$sparam['pcomi_codigo'] = $ArregloDatos['comi_codigo'];
		$sparam['pact_codigo'] = $ArregloDatos['act_codigo'];		
		$sparam['ppers_codigo'] = $ArregloDatos['pers_codigo'];
		$sparam['peval_codigo'] = $ArregloDatos['eval_codigo'];
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar la Persona para Certificar.";
			$errormail="Error al buscar la Persona para Certificar".$errno;
			return false;
		}
		return true;
	}	
//--------------------------------------------------------------------------------------------------------
	function ObtenerNotificacionCabecera($ArregloDatos, &$datos_cabecera) {

		$oActividad = new cActividad($this->conexion);
		$oActividadCurso = new cActividadCurso($this->conexion);
		$oActividadCursoInap = new cActividadCursoInap ($this->conexion);
		$oActividadCursoJurisdiccional = new cActividadCursoJurisdiccional ($this->conexion);		
		

		$comi_codigo = $ArregloDatos['comi_codigo'];		

		if (!$this->TraerDatosComision($comi_codigo,$filacomision,$es_modif)) {
			if (!$es_modif) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return  false;
			}
		}
		if ($oActividad->TraerDatosActividad($filacomision['act_codigo'],$filaact,$es_modif)) {
			if (!$es_modif) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return  false;
			}	// Se encontró la actividad 
		} // N se produjo error al buscar la actividad
		
		$datos_cabecera = array();
		
		$act_codigo = $filaact['act_codigo'];
		
		// busco programa	
		$tipoinap=$oActividadCursoInap->EsActividadCursoTipo($act_codigo,TIPOACTCURSOINAP,$error,$errormsg);
		if ($error) {
			$errormail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} /* elseif(!$tipoinap) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} */
		$datos_cabecera['es_curso_inap']=false;		
		
		
		if ($tipoinap) {
			
			// 09/2015  VER
			
			if ($oActividadCursoInap->TraerDatosActividadCursoInap($filacomision['act_codigo'],$filacurso,$es_modif)) {
				if (!$es_modif) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else {
					$datos_cabecera['es_curso_inap']=true;		
					if ($this->conexion->TraerCampo("programa_curso_inap","progcur_descripcion",array("progcur_codigo='",$filacurso['actividad_curso_inap']['progcur_codigo'],"'"),$descri,$numfilas,$errorcod)) 
						$datos_cabecera['progcur_descripcion'] = htmlspecialchars($descri,ENT_QUOTES); 
				}
			}
			$datos_cabecera['act_duracionhs'] = $filacurso['actividad_curso_inap']['actdisinap_duracionhs'];
			
			
		}	
		else // 09/2015 VER
		{
			
			$tipoinap=$oActividadCursoInap->EsActividadCursoTipo($act_codigo,TIPOACTCURSOJURISD,$error,$errormsg);
			if ($error) {
				$errormail="\nact_codigo=".$act_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			
			if ($tipoinap) {
			
				if ($oActividadCursoJurisdiccional->TraerDatosActividadCursoJurisdiccional($filacomision['act_codigo'],$filacurso,$es_modif)) {
					if (!$es_modif) {
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					} else {
						$datos_cabecera['es_curso_jurisdiccional']=true;		
					//	if ($this->conexion->TraerCampo("programa_curso_inap","progcur_descripcion",array("progcur_codigo='",$filacurso['actividad_curso_inap']['progcur_codigo'],"'"),$descri,$numfilas,$errorcod)) 
					//		$datos_cabecera['progcur_descripcion'] = htmlspecialchars($descri,ENT_QUOTES); 
					}
	
					$datos_cabecera['act_duracionhs']= $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_duracionhs'];

				}


			
			}


			

		}
			
		// busco organismo del curso		
		if (!$oActividadCurso->TraerDatosActividadCurso($act_codigo,$fila_actividad_curso,$es_modif_act_curso)) 
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;		
		if (!$es_modif_act_curso)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 

		if(!$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$fila_actividad_curso['jurisdid_inap'],"'"),$jurisdnom,$numfilas,$errorcod))
			return false;

		$datos_cabecera['jurisdnom'] = $jurisdnom;
		$datos_cabecera['act_nombre'] = $filaact['act_nombre'];
		$datos_cabecera['act_codinap'] = $filaact['act_codinap'];		
		$datos_cabecera['comi_codinap'] = $filacomision['comi_codinap'];
		$datos_cabecera['actcur_creditos'] = $fila_actividad_curso['actcur_creditos'];
		$datos_cabecera['comi_acta_numero'] = $filacomision['comi_acta_numero'];
		$datos_cabecera['comi_fecha_inicio'] = $filacomision['comi_fecha_inicio'];
		$datos_cabecera['comi_fecha_fin'] = $filacomision['comi_fecha_fin'];
		$datos_cabecera['comi_domicilio'] = $filacomision['comi_domicilio'];		
		$datos_cabecera['comi_detalle'] = $filacomision['comi_detalle'];		

		if(!$this->conexion->TraerCampo("sede","sede_descripcion",array("sede_codigo='",$filacomision['sede_codigo'],"'"),$sededesc,$numfilas,$errorcod))
			return false;
		
		$datos_cabecera['sede'] = $sededesc;		
		
		// Hay que obtener la disposicion
		$ArregloDatos['act_codigo']	= $filacomision['act_codigo'];
		$ArregloDatos['actprog_sec'] = $filacomision['actprog_sec'];
		if(!$oActividadCurso->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando disposición a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;								
		}	
		
		if ($numfilas==1)	{
			$fila_dictamen = mysqli_fetch_assoc($result);
			$datos_cabecera['dis_numero'] = $fila_dictamen['dis_numero'];		
		} else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando disposición a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;								
		}


		return true;		
	}	
//--------------------------------------------------------------------------------------------------------
	function ObtenerNotificacionInscriptos($ArregloDatos, &$datos_inscriptos) {

		$oPersonas = new cPersonas($this->conexion);		
		if(!$this->BuscarActividadAsignadaPersonaAvanzada ($ArregloDatos, $numfilas, $resultPersonas, $error, $errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar las personas asignadas a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
			return false;
		} 


		$datos_inscriptos = array();
		$cont = 0;
				
		while ($fila_persona = mysqli_fetch_assoc($resultPersonas)) {

			if(!$oPersonas->TraerDatosPersona_xCod($fila_persona["pers_codigo"],$datospersona,$es_modif)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la persona.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			} 
		
			// nivel y grado
			
			$escalafon = "--";
			$escalafonnivel = "--";
			$escalafontramo = "--";	
			$escalafongrado = "--";			
			if (isset($fila_persona['escalafcod']) && $fila_persona['escalafcod'] == SINEP || $fila_persona['escalafcod'] == SINAPA) {		
				if (!$this->conexion->TraerCampo("escalafones","escalafdesc",array("escalafcod='",$fila_persona['escalafcod'],"'"),$escalafon,$numfilas,$errorcod))
					return false;
				if (!$this->conexion->TraerCampo("escalafones_niveles","escalafnivdesc",array("escalafnivcod='",$fila_persona['escalafnivcod'],"'"),$escalafonnivel,$numfilas,$errorcod))
					return false;
				if (!$this->conexion->TraerCampo("escalafones_tramos","escalaftramodesc",array("escalaftramocod='",$fila_persona['escalaftramocod'],"'"),$escalafontramo,$numfilas,$errorcod))
					return false;
				if (!$this->conexion->TraerCampo("escalafones_grados","escalafgradodesc",array("escalafgradocod='",$fila_persona['escalafgradocod'],"'"),$escalafongrado,$numfilas,$errorcod))
					return false;
			}					

			// evaluación
			$evaluacion="";
			if (!$this->conexion->TraerCampo("evaluacion","eval_descripcion",array("eval_codigo='",$fila_persona['eval_codigo'],"'"),$evaluacion,$numfilas,$errorcod))
				return false;

			// Organismo donde trabaja
			$jurisdnom="";
			$oActividad = new cActividad($this->conexion);
			$oActividad->ObtenerOrganismoInstitucion(NULL,
													$fila_persona['jurisdid_apn'],
													$fila_persona['orgapub_codigo'],				
													$jurisdnom,$sector_org,$tipoorg_codigo,$campo,false, false);

			if ($jurisdnom == "") 
				$jurisdnom = "---";

			$cont++; // número de orden
			$datos_inscriptos[] = array(
						'pers_orden' => $cont,
						'pers_cuilt'=> $datospersona['pers_cuilt'],
						'pers_apellido'=> $datospersona['pers_apellido'],
						'pers_nombre'=> $datospersona['pers_nombre'],
						'escalafdesc'=> $escalafon,
						'escalafnivdesc'=> $escalafonnivel,
						'escalaftramodesc'=> $escalafontramo,
						'escalafgradodesc'=> $escalafongrado,						
						'pers_nombre'=> $datospersona['pers_nombre'],
						'eval_descripcion'=> $evaluacion,
						'jurisdnom'=> $jurisdnom,
						'jurisdid_inap'=> $fila_persona['jurisdid_inap'],			
						'jurisd_inap_nombre'=> $fila_persona['jurisd_inap_nombre']			
					
			);
		}

		return true;	
	}		
//--------------------------------------------------------------------------------------------------------
function ImprimirNotificacionCreditos ($datos_cabecera, $datos_inscriptos, $formato) {

	function InicializarNotifiacionCreditos(&$pdf,$datos_cabecera,$datos_inscriptos) { 	// No se usa ahora

		$pdf->AddNotificacionCreditos();
		
		$pdf->Set('act_nombre',$datos_cabecera['act_nombre']);
		if ($datos_cabecera['es_curso_inap']) {
			$pdf->Set('jurisdnom','Curso organizado por INAP');
			$pdf->Set('programa',$datos_cabecera['progcur_descripcion']);
		} else {
			$pdf->Set('jurisdnom',$datos_cabecera['jurisdnom']);
			$pdf->Set('programa',"");
		}
	
		$pdf->Set('comi_codinap',$datos_cabecera['comi_codinap']);
		$pdf->Set('comi_acta_numero',$datos_cabecera['comi_acta_numero']);		
		$pdf->Set('comi_fecha_inicio',FuncionesPHPLocal::ConvertirFecha($datos_cabecera['comi_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa'));
		$pdf->Set('comi_fecha_fin',FuncionesPHPLocal::ConvertirFecha($datos_cabecera['comi_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa'));

		$pdf->Set('comi_domicilio',$datos_cabecera['comi_domicilio']);
		$pdf->Set('comi_detalle',$datos_cabecera['comi_detalle']);		
		$pdf->Set('sede',$datos_cabecera['sede']);		

		$pdf->Set('actcur_creditos',$datos_cabecera['actcur_creditos']);
		$pdf->Set('dis_numero',$datos_cabecera['dis_numero']);		

		$pdf->Set('pers_cuilt',$datos_inscriptos['pers_cuilt']);
		$pdf->Set('nombre_completo',$datos_inscriptos['pers_apellido'].",".$datos_inscriptos['pers_nombre']);
		$pdf->Set('jurisdnom_persona',$datos_inscriptos['jurisdnom']);
		$pdf->Set('escalafon',$datos_inscriptos['escalafdesc']);
		$pdf->Set('nivel',$datos_inscriptos['escalafnivdesc']);
		$pdf->Set('tramo',$datos_inscriptos['escalaftramodesc']);
		$pdf->Set('grado',$datos_inscriptos['escalafgradodesc']);
		$pdf->Set('evaluacion',$datos_inscriptos['eval_descripcion']);	

	} 
	//--------------------------------------------------------------------------------------------------------
	function InicializarNotifiacionCreditosTabla(&$pdf,$datos_cabecera,$datos_documentos,$datos_inscriptos) {

		$pdf->AddNotificacionCreditos();
		$pdf->Set('act_nombre',$datos_cabecera['act_nombre']);
		if ($datos_cabecera['es_curso_inap']) {
			$pdf->Set('jurisdnom','Curso organizado por INAP');
			$pdf->Set('programa',$datos_cabecera['progcur_descripcion']);
			$pdf->Set('imagen',"images/escudo_secretaria.jpg");			
			$pdf->Set('titulo',"CONSTANCIA DE REALIZACIÓN DE ACTIVIDAD");						
			
		} else {
			$pdf->Set('jurisdnom',$datos_cabecera['jurisdnom']);
			$pdf->Set('programa',"");
			$pdf->Set('imagen',"");						
			$pdf->Set('titulo',"CONSTANCIA DE REALIZACIÓN DE ACTIVIDAD JURISDICCIONAL");						
		}		

		if (count($datos_documentos)>0) {	// si hay mas de 1 son cada uno de los campos de un registro
		
			$firmante="";
			
			$array_firma=array();
			
			if (trim($datos_documentos['dto_sello_linea1'])!="")
				$array_firma[]=trim($datos_documentos['dto_sello_linea1']);

			if (trim($datos_documentos['dto_sello_linea2'])!="")
				$array_firma[]=trim($datos_documentos['dto_sello_linea2']);

			if (trim($datos_documentos['dto_sello_linea3'])!="")
				$array_firma[]=trim($datos_documentos['dto_sello_linea3']);
				
			foreach($array_firma as $i=>$valor) 
				$firmante.=$valor."\n";

			// Saco el último enter	
			if (strlen($firmante)!=0)
				$firmante=substr($firmante,0,strlen($firmante)-1);
			 
			$pdf->Set('firmante',$firmante);
	    	$pdf->Set('linea_encabezado',$datos_documentos['dto_linea_encabezado']);
	    	$pdf->Set('linea_nota',$datos_documentos['dto_linea_nota'] );
		}
		
		$pdf->Set('comi_codinap',$datos_cabecera['comi_codinap']);
		$pdf->Set('comi_acta_numero',$datos_cabecera['comi_acta_numero']);		
		$pdf->Set('comi_fecha_inicio',FuncionesPHPLocal::ConvertirFecha($datos_cabecera['comi_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa'));
		$pdf->Set('comi_fecha_fin',FuncionesPHPLocal::ConvertirFecha($datos_cabecera['comi_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa'));

		$pdf->Set('comi_domicilio',$datos_cabecera['comi_domicilio']);
		$pdf->Set('comi_detalle',$datos_cabecera['comi_detalle']);		
		$pdf->Set('sede',$datos_cabecera['sede']);		

		$pdf->Set('actcur_creditos',$datos_cabecera['actcur_creditos']);
		
		$pdf->Set('act_duracionhs',$datos_cabecera['act_duracionhs']);
		$pdf->Set('dis_numero',$datos_cabecera['dis_numero']);		
		
		$pdf->Set('datos_cabecera',$datos_cabecera);			
		$pdf->Set('datos_inscriptos',$datos_inscriptos);			
		
	} // fin funcion
	
	//--------------------------------------------------------------------------------------------------------
	$nro_notificacion=0;	

/*	if (($formato == "S")) {

		$pdf = new cNotificacionCreditosPDF();
		foreach ($datos_inscriptos as $indice=>$valor) {
			InicializarNotifiacionCreditos($pdf,$datos_cabecera,$valor); 
			$pdf->MostrarNotifiacion($formato);
			$nro_notificacion++;		
		}

	} else {
*/	
		// Obtengo las constantes de notificación  (firma-linea encabezado-nota)
		$datos_documentos=array();

		$oDatosDocumentos = new cDatosDocumentos($this->conexion);
		$ArregloDatos=array('jurisdid_inap'=>$_SESSION['jurisdid_inap'],
							'dto_default'=>SI);

		if(!$oDatosDocumentos->BuscarDatosDocumentos($ArregloDatos, $numfilas, $resultDatos, $error, $errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar datos para la constancia de realización.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
			return false;
		} 

		if ($numfilas==1) 
			$datos_documentos=mysqli_fetch_assoc($resultDatos);			

		$pdf = new cNotificacionCreditosTablaPDF($formato);
		InicializarNotifiacionCreditosTabla($pdf, $datos_cabecera, $datos_documentos, $datos_inscriptos); 
		$pdf->MostrarNotifiacion($formato);
		$nro_notificacion++;		
			
//	}
	
	if ($nro_notificacion>=1)
		$pdf->Output("notifiacion.pdf","I");

	return true;
}
//--------------------------------------------------------------------------------------------------------
function BuscarActividadPersonaCertificada($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{
	
	// En arreglo deberia venir una persona y/o actividad y/o comision (menos prob)
	$ArregloDatos['eval_certifica'] = array('"','S','"'); 	// Busco las que certifican
	$ArregloDatos['comi_estado'] = COMISIONCERTIFICADA; 	// 
	
	if (!$this->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
		$error="Error al buscar la Persona Certificada en Actividad Curso.";
		$errormail="Error al buscar la Persona Certificada en Actividad Curso.".$errno;
		return false; 
	}
	return true;	
}
