	function DescargarExcelDisenoActividad($act_codigo, &$oExcel, $nuevo_excel=true) {

		 if (!$this->TraerDatosActividadCursoInap($act_codigo,$filacurso,$es_modif)) {
		 	FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pueden obtener los datos de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		 }

		if ($nuevo_excel) {
			$nombrearchivo="actividad.xls";
			$oExcel= new cEscribirExcel($nombrearchivo);
		}

		$oExcel->AddHoja('Actividad');
		$ancho_columna['leyenda']=30;
		$ancho_columna['valor']=70;

		$oExcel->FormatoColumna (0,$ancho_columna['leyenda']);
		$oExcel->FormatoColumna (1,$ancho_columna['valor']);

		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor",22);
		$oExcel->CargarDatosVariasCeldas (0,0,0,1,'Detalle de la Actividad Curso INAP',true);

		// Titulos de las columnas
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");

		$arrayclaves=array('leyenda','valor');

		$array_datos[]  = array('leyenda' => "Actividad",
								'valor' => $filacurso['actividad']['act_nombre']);
		$array_datos[]  = array('leyenda' => "Código de Actividad",
								'valor' => $filacurso['actividad']['act_codinap']);

		$oExcel->BorrarFormato("");
		$oExcel->AddFormato ("Tamaño",8);
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("VAlign","vcenter");
		$formato_leyenda=$oExcel->GetFormato();

		$oExcel->BorrarFormato("");
		$oExcel->AddFormato ("Tamaño",8);
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("FgColor","blanco");
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("VAlign","vcenter");
		$formato_dato=$oExcel->GetFormato();

		foreach ($arrayclaves as $clave => $valor) {
			if ($valor == 'leyenda')
	 			$arrayformato[$valor]=$formato_leyenda;
			else
	 			$arrayformato[$valor]=$formato_dato;
		}

		// Programa
		if (!$this->conexion->TraerCampo("programa_curso_inap","progcur_descripcion",array("progcur_codigo='",$filacurso['actividad_curso_inap']['progcur_codigo'],"'"),$descri_programa,$numfilas,$errorcod)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado el programa.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$array_datos[]  = array('leyenda' => "Programa",
								'valor' => $descri_programa);

		// Área
		if (!$this->conexion->TraerCampo("area_curso_inap","areacur_descripcion",array("areacur_codigo='",$filacurso['actividad_curso_inap']['areacur_codigo'],"'"),$descri_area,$numfilas,$errorcod)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado el área.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$array_datos[]  = array('leyenda' => "Area",
								'valor' => $descri_area);
		$array_datos[]  = array('leyenda' => "Fundamentación",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_fundamentacion']);
		$array_datos[]  = array('leyenda' => "Contribución esperada",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_contribucion']);
		$array_datos[]  = array('leyenda' => "Perfil del participante",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_perfil']);
		$array_datos[]  = array('leyenda' => "Objetivos",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_objetivos']);
		$array_datos[]  = array('leyenda' => "Contenido",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_contenido']);
		$array_datos[]  = array('leyenda' => "Metodología",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_metodologia']);
		$array_datos[]  = array('leyenda' => "Descripción de la modalidad",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_modaldesc']);
		$array_datos[]  = array('leyenda' => "Bibliografía",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_bibliografia']);
		$array_datos[]  = array('leyenda' => "Evaluación de los aprendizajes",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_eval']);
		$array_datos[]  = array('leyenda' => "Instrumentos para la evaluación",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_evalinstru']);
		$array_datos[]  = array('leyenda' => "Requisitos de Asistencia y aprobación",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_requiaprobacion']);
		$array_datos[]  = array('leyenda' => "Duración (Hs.)",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_duracionhs']);
		$array_datos[]  = array('leyenda' => "Detalle sobre la duración)",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_duraciondetalle']);
		$array_datos[]  = array('leyenda' => "Lugar",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_lugar']);
		$array_datos[]  = array('leyenda' => "Perfil Instructor",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_perfil_instructor']);

/*		$array_datos[]  = array('leyenda' => "Recursos",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_planrecursos']);
		$array_datos[]  = array('leyenda' => "Contenidos",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_plancontenidos']);
		$array_datos[]  = array('leyenda' => "Estrtegias",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_planestrategias']);
*/
		$array_datos[]  = array('leyenda' => "Origen de la demanda",
								'valor' => $filacurso['actividad_curso_inap']['actdisinap_origen']);

		$fila_datos = array();

		foreach ($array_datos as $i => $valor) {
			$fila_datos['leyenda'] = $array_datos[$i]['leyenda'];
			$fila_datos['valor'] = $array_datos[$i]['valor'];
			// Saco los /r que no se lo banca el excel.
			$fila_datos['valor']=str_replace("\r\n","\n", $array_datos[$i]['valor']);
			$oExcel->CargarGrilla ($fila_datos,2+$i,0,$arrayclaves,$arrayformato);
		}

		if ($nuevo_excel)
			$oExcel->Enviar();

	}
//-----------------------------------------------------------------------------------------------------
	function _AguparDatosPost($datos,&$datos_agrup,$es_modif)	{

		//-----------------------------------------------------------
		$datos_agrup['actividad']=array('act_codinap'=>$datos['act_codinap'],
										'act_nombre'=>$datos['act_nombre'],
										'act_obs'=>$datos['act_obs']);
		if ($es_modif)
			$datos_agrup['actividad']+=array('act_codigo'=>$datos['act_codigo']);
		else
			$datos_agrup['actividad']+=array('formact_codigo'=>FORMATOCURSO);

		//-------------------------------------------------------------
		$datos_agrup['actividad_curso']=array('actcur_obs'=>$datos['actcur_obs']);
		if ($es_modif)
			$datos_agrup['actividad_curso']+=array('act_codigo'=>$datos['act_codigo']);
		else {
		 	$datos_agrup['actividad_curso']+=array('tipoact_codigo'=>TIPOACTCURSOINAP);
		 	$datos_agrup['actividad_curso']+=array('actcur_creditos'=>0);
			$datos_agrup['actividad_curso']+=array('jurisdid_inap'=>0);
			$datos_agrup['actividad_curso']+=array('actcur_estado'=>ACTCURSOACTIVO);
		}
		//--------------------------------------------------------------
		$datos_agrup['actividad_curso_inap']=array(
						  'progcur_codigo'=>$datos['progcur_codigo'],
						  'areacur_codigo'=>$datos['areacur_codigo'],
						  'univ_codigo'=>$datos['univ_codigo'],
						  'actdisinap_fundamentacion'=>$datos['actdisinap_fundamentacion'],
						  'actdisinap_contribucion'=>$datos['actdisinap_contribucion'],
						  'actdisinap_perfil'=>$datos['actdisinap_perfil'],
						  'actdisinap_objetivos'=>$datos["actdisinap_objetivos"],
						  'actdisinap_contenido'=>$datos['actdisinap_contenido'],
						  'actdisinap_modaldesc'=>$datos['actdisinap_modaldesc'],
						  'actdisinap_eval'=>$datos['actdisinap_eval'],
						  'actdisinap_evalinstru'=>$datos['actdisinap_evalinstru'],
						  'actdisinap_requiaprobacion'=>$datos['actdisinap_requiaprobacion'],
						  'actdisinap_duracionhs'=>$datos['actdisinap_duracionhs'],
						  'actdisinap_duraciondetalle'=>$datos['actdisinap_duraciondetalle'],
						  'actdisinap_lugar'=>$datos['actdisinap_lugar'],

				  		  'actdisinap_metodologia'=>$datos['actdisinap_metodologia'],
						  'actdisinap_bibliografia'=>$datos['actdisinap_bibliografia'],
						  'actdisinap_perfil_instructor'=>$datos['actdisinap_perfil_instructor'],

						  'actdisinap_planrecursos'=>$datos['actdisinap_planrecursos'],
						  'actdisinap_plancontenidos'=>$datos['actdisinap_plancontenidos'],
						  'actdisinap_planestrategias'=>$datos['actdisinap_planestrategias'],

						  'actdisinap_origen'=>$datos['actdisinap_origen'],

						  'actdisinap_unico'=>$datos['actdisinap_unico'],
						  'actdisinap_beca'=>$datos['actdisinap_beca']

		);
		if ($es_modif)
			$datos_agrup['actividad_curso_inap']+=array('act_codigo'=>$datos['act_codigo']);
		else {
		 	$datos_agrup['actividad_curso_inap']+=array('actdisinap_duracionhs'=>0);
		}
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosAltaActividadCursoInap($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->_DatosValidosComunesActividadCursoInap($datos,$datosvalidados))
		   return false;

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosEliminarActividadCursoInap($act_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoBaja($act_codigo,$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false;
		}

		// Es una actividad curso inap
		$tipook=$this->EsActividadCursoTipo($act_codigo,TIPOACTCURSOINAP,$error,$errormsg);
		if ($error) {
			$errormail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif(!$tipook) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}


		// Verificar que la actividad no tenga dictamen.
		$oDictamen = new cDictamen($this->conexion);
		$ArregloDatos=array();
		$ArregloDatos=array('act_codigo'=>$act_codigo);
		$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
		if ($error)  {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif ($numfilas>0 && $_SESSION['rolcod']!=SUPERUSUARIO) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La actividad no puede ser modificada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados['act_codigo'] = $act_codigo;

		/*
		// Para estar asociada a un poc debería tener dictamen y no lo tiene
		// No debe estar asociada la actividad a ningun POC
		$oPocActividadActividad=new cPocActividadActividad($this->conexion);
		$ArregloDatos=array();
		$ArregloDatos['act_codigo']=$act_codigo;
		if (!$oPocActividadActividad->BuscarPocActividadActividad($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas>=1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La actividad esta asociada a un POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		*/

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosModifActividadCursoInap($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoModificar($datos['act_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false;
		}

		if (!$this->_DatosValidosComunesActividadCursoInap($datos,$datosvalidados))
		   return false;

		$tipook = $this->EsActividadCursoTipo($datos['act_codigo'],TIPOACTCURSOINAP,$error,$errormsg);
		if ($error) {
			$errormail="\nact_codigo=".$datos['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif(!$tipook) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}

		$datosvalidados+=array('act_codigo'=>$datos['act_codigo']);

		// Verificar que la actividad no tenga dictamen.
		$oDictamen = new cDictamen($this->conexion);
		$ArregloDatos=array();
		$ArregloDatos=array('act_codigo'=>$datos['act_codigo']);
		$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
		if ($error)  {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif ($numfilas>0 && $_SESSION['rolcod']!=SUPERUSUARIO) { //  el superusuario puede actualizarla mas alla que tenga dictamen
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La actividad no puede ser modificada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosComunesActividadCursoInap($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if ($datos["actdisinap_beca"] == "si") {

			$oTablaUniversidad = new cTablaUniversidad($this->conexion);
			$oTablaUniversidad -> TablaDescriptoresSP($spnombre,$spparam);
			$arraybusq=array("univ_codigo"=>$datos["univ_codigo"]);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,$arraybusq,$query,$filaret,$numfilasmatcheo,$errorcod) || $numfilasmatcheo!=1)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección de la Universidad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["univ_codigo"]=$datos["univ_codigo"];
			$datosvalidados["actdisinap_beca"]=$datos["actdisinap_beca"];

			// datos de actividad curso que se inicializar
			$datosvalidados["progcur_codigo"]="NULL";
			$datosvalidados["areacur_codigo"]="NULL";
			$datosvalidados["actdisinap_fundamentacion"]="---";
			$datosvalidados["actdisinap_contribucion"]="---";
			$datosvalidados["actdisinap_perfil"]="---";
			$datosvalidados["actdisinap_objetivos"]="---";
			$datosvalidados["actdisinap_contenido"]="---";
			$datosvalidados["actdisinap_modaldesc"]="---";
			$datosvalidados["actdisinap_eval"]="---";
			$datosvalidados["actdisinap_evalinstru"]="---";
			$datosvalidados["actdisinap_requiaprobacion"]="---";
			$datosvalidados["actdisinap_duracionhs"]="---";
			$datosvalidados["actdisinap_duraciondetalle"]="---";
			$datosvalidados["actdisinap_lugar"]="---";
			$datosvalidados["actdisinap_metodologia"]="---";
			$datosvalidados["actdisinap_bibliografia"]="---";
			$datosvalidados["actdisinap_perfil_instructor"]="---";
			$datosvalidados["actdisinap_planrecursos"]="---";
			$datosvalidados["actdisinap_plancontenidos"]="---";
			$datosvalidados["actdisinap_planestrategias"]="---";
			$datosvalidados["actdisinap_origen"]="---";
			$datosvalidados["actdisinap_unico"]="si";



		} else {
			$datosvalidados["univ_codigo"]="NULL";
			$datosvalidados["actdisinap_beca"]=$datos["actdisinap_beca"];

			// Programa							- [progcur_codigo] 				- [OBLIG]
			$oTablaProgramaCursoInap = new cTablaProgramaCursoInap($this->conexion);
			$oTablaProgramaCursoInap -> TablaDescriptoresSP($spnombre,$spparam);
			$arraybusq=array("progcur_codigo"=>$datos["progcur_codigo"]);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,$arraybusq,$query,$filaret,$numfilasmatcheo,$errorcod) || $numfilasmatcheo!=1)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del programa INAP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["progcur_codigo"]=$datos["progcur_codigo"];

			// Área								- [areacur_codigo] 				- [OBLIG]
			$oTablaAreaCursoInap = new cTablaAreaCursoInap($this->conexion);
			$oTablaAreaCursoInap -> TablaDescriptoresSP($spnombre,$spparam);
			$arraybusq=array("areacur_codigo"=>$datos["areacur_codigo"]);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,$arraybusq,$query,$filaret,$numfilasmatcheo,$errorcod) || $numfilasmatcheo!=1)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del área INAP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["areacur_codigo"]=$datos["areacur_codigo"];

			// Fundamentación 					- [actdisinap_fundamentacion] 	- [OBLIG]
			if (trim($datos['actdisinap_fundamentacion']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la fundamentación de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_fundamentacion"]=$datos["actdisinap_fundamentacion"];

			// Contribución esperada 			- [actdisinap_contribucion] 	- [OBLIG]
			if (trim($datos['actdisinap_contribucion']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la contribución esperada de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_contribucion"]=$datos["actdisinap_contribucion"];

			// Perfil del participante 			- [actdisinap_perfil] 			- [OBLIG]
			if (trim($datos['actdisinap_perfil']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el perfil de los participantes de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_perfil"]=$datos["actdisinap_perfil"];

			// Objetivos 						- [actdisinap_objetivos] 		- [OBLIG]
			if (trim($datos['actdisinap_objetivos']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar los objetivos de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_objetivos"]=$datos["actdisinap_objetivos"];

			// Contenido 						- [actdisinap_contenido] 		- [OBLIG]
			if (trim($datos['actdisinap_contenido']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar los contenido de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_contenido"]=$datos["actdisinap_contenido"];

			// Metodologia							- [actdisinap_metodologia] 			- [OBLIG]
			if (trim($datos['actdisinap_metodologia']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar las estrategias metodológicas y recursos didácticos",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_metodologia"]=$datos["actdisinap_metodologia"];

			// Descripción de la modalidad 		- [actdisinap_modaldesc] 		- [OBLIG]
			if (trim($datos['actdisinap_modaldesc']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la modalidad de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_modaldesc"]=$datos["actdisinap_modaldesc"];

			// Bibliografia 							- [actdisinap_bibliografia] 			- [OBLIG]
			if (trim($datos['actdisinap_bibliografia']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la Bibliografía.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_bibliografia"]=$datos["actdisinap_bibliografia"];

			// Evaluación de los aprendizajes 	- [actdisinap_eval] 			- [OBLIG]
			if (trim($datos['actdisinap_eval']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la evaluación de los aprendizajes de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_eval"]=$datos["actdisinap_eval"];

			// Instrumentos para la evaluación 	- [actdisinap_evalinstru] 		- [OPCIONAL]
			$datosvalidados["actdisinap_evalinstru"]=$datos["actdisinap_evalinstru"];

			// Requisitos de Asistencia y aprobación			- [actdisinap_requiaprobacion] 	- [OBLIG]
			if (trim($datos['actdisinap_requiaprobacion']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar los requisitos de Asistencia y aprobación de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_requiaprobacion"]=$datos["actdisinap_requiaprobacion"];

			// Duración	en horas 		- [actdisinap_duracionhs] 	- [OBLIG]
			if (!FuncionesPHPLocal::ValidarContenido($this->conexion, $datos['actdisinap_duracionhs'],'NumericoEntero') || $datos['actdisinap_duracionhs'] <=0 ) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La duración en hs. de la Actividad debe ser un número entero mayor que cero.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_duracionhs"]=$datos["actdisinap_duracionhs"];

			// Detalle sobre la duración	 	- [actdisinap_duraciondetalle] 	- [OBLIG]
			if (trim($datos['actdisinap_duraciondetalle']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el detalle de la duración de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_duraciondetalle"]=$datos["actdisinap_duraciondetalle"];

			// Lugar 							- [actdisinap_lugar] 			- [OBLIG]
			if (trim($datos['actdisinap_lugar']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el lugar de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_lugar"]=$datos["actdisinap_lugar"];

			// Perfil del Instructor 							- [actdisinap_perfil_instructor] 			- [OBLIG]
			if (trim($datos['actdisinap_perfil_instructor']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el perfil del instructor de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_perfil_instructor"]=$datos["actdisinap_perfil_instructor"];

			/*
			// Plan de Clases - Recursos 							- [actdisinap_planrecursos] 			- [OBLIG]
			if (trim($datos['actdisinap_planrecursos']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el Plan de Clases - Recursos 	 de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_planrecursos"]=$datos["actdisinap_planrecursos"];

			// Plan de Clases - contenidos 							- [actdisinap_plancontenidos] 			- [OBLIG]
			if (trim($datos['actdisinap_plancontenidos']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el Plan de Clases - contenidos de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_plancontenidos"]=$datos["actdisinap_plancontenidos"];

			// Plan de Clases - Estretegias						- [actdisinap_planestrategias] 			- [OBLIG]
			if (trim($datos['actdisinap_planestrategias']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el Plan de Clases - Estretegias de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_planestrategias"]=$datos["actdisinap_planestrategias"];
			*/

			$datosvalidados["actdisinap_plancontenidos"]="NULL";
			$datosvalidados["actdisinap_planrecursos"]="NULL";
			$datosvalidados["actdisinap_planestrategias"]="NULL";

			// Origen 						- [actdisinap_origen] 			- [OBLIG]
			if (trim($datos['actdisinap_origen']) == "") {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar Origen de la demanda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["actdisinap_origen"]=$datos["actdisinap_origen"];




			// Tipo inscripción - [actdisinap_unico] 	- [OBLIG]
			if(!($datos['actdisinap_unico'] == SI ||$datos['actdisinap_unico'] == NO) )	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el tipo de inscripción. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados['actdisinap_unico'] = $datos['actdisinap_unico'];
		} // if ($datos["actdisinap_beca"] == "si") {

		return true;
	}

} // class
