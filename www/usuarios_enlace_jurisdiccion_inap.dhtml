	function ValidarCuit(formulario){
		if (formulario.usuarioCUIT.value=="")
		{
			alert("Debe ingresar el CUIT/CUIL/CDI del usuario");
			formulario.usuarioCUIT.focus();
			return false;
		}
		if(!ValidarContenido(formulario.usuarioCUIT.value,'CUIT'))
		{
			alert("El CUIT/CUIL/CDI de usuario no es válido");
			formulario.usuarioCUIT.focus();
			return false;
		}
		return true;
	}
	
