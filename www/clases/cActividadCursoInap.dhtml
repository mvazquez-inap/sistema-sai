	function MostrarDatoActividadCursoInap($conexion,$operacion,$filacurso=array()) {

	// si queda esta opcion no mandar la conexion
	if ($operacion=="A") {
	   $es_modif = false;
	} elseif ($operacion=="M" || $operacion=="V") {
	   	$es_modif = true;
	   } else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en la llamada, operación inválida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
	   }

	// deberia mandarle el fomulario
	?>
	<!-- Datos comunes de actividad -->
	<table width="100%" class="textoTablaDato" align="center" cellpadding="2">
		<tr>
			<td colspan="2" >
				<fieldset class="bordeDetalleRegistro">
