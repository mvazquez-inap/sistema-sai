	function ValidarFormAltaPrestadorDocente()
	{
?>		

	function VerificarExistenciaCUILT(formulario,valor_buscado,codigo_buscado) {
	
		var ajax=nuevoAjax();
		var variables="?tipo=DO&valor_buscado="+valor_buscado+"&valor_codigo_unico="+codigo_buscado;
		var direccion= "verifico_existencia_codigo_ajax.dhtml"+variables;
		if (valor_buscado=='') {
			alert('El número de CUIT/CUIL no puede quedar en blanco.');
			return false;				
		}
		
		ajax.open("GET",direccion,true);
		ajax.onreadystatechange=function() {
			if (ajax.readyState==4) {	
				if (ajax.responseText.substr(0,15)=="//tienepermisos") 	{				
					eval (ajax.responseText);
					if (!ejecutook){	

						alert('Ya existe un Prestador Docente con el número de CUIT/CUIL ingresado.');
						formulario.presdoc_cuilt.value = "";
						formulario.presdoc_cuilt.focus();
						return false;
					} else {
						alert('No hay prestadores docentes con el número de CUIT/CUIL ingresado, puede continuar la carga.');
						return true;
					}
				} else {	
					alert (ajax.responseText);
					return false;
				}
			}
		}	
		ajax.send(null);		
		return false;
	}

		function ValidarFormAltaPrestadorDocente(formulario,operacion) {
		//-----datos básicos----------------------------------------------------------------
			if (!ValidarContenido(formulario.presdoc_apellido.value,"AlfabeticoPuro") || (trim(formulario.presdoc_apellido.value)=="")){
				alert("Debe ingresar un apellido válido");
				formulario.presdoc_apellido.focus();
				return false;
			}	
			if (!ValidarContenido(formulario.presdoc_nombre.value,"AlfabeticoPuro") || (trim(formulario.presdoc_nombre.value)=="")){
				alert("Debe ingresar un nombre válido");
				formulario.presdoc_nombre.focus();
				return false;
			}	
			if ((!formulario.presdoc_sexo[0].checked) && (!formulario.presdoc_sexo[1].checked))
			{
				alert("Debe seleccionar el sexo");
				return false;
			}
			
			if ((trim(formulario.presdoc_origen_pais_codigo.value)=="")){
				alert("Debe ingresar un pais de origen");
				formulario.presdoc_origen_pais_codigo.focus();
				return false;
			}	


<?php 		if ($_SESSION['rolcod']==ADMICURSO || $_SESSION['rolcod']==USUCURSO) { ?>

			if ((!formulario.presdoc_caracter_alta[0].checked) && (!formulario.presdoc_caracter_alta[1].checked))
			{
				alert("Debe seleccionar el caracter de alta");
				return false;
			}

			// Fecha de Alta Provisorio
			if (formulario.presdoc_caracter_alta[0].checked || formulario.presdoc_caracter_alta[1].checked) {
				if (formulario.presdoc_falta_prov.value=="" || !ValidarFecha(formulario.presdoc_falta_prov.value))
				{
					alert("La fecha de alta provisorio no es válida");
					formulario.presdoc_falta_prov.focus();
					return false;
				}
			}

			// Fecha de Alta Definitivo
			if (formulario.presdoc_caracter_alta[1].checked) {
				if (formulario.presdoc_falta_def.value=="" || !ValidarFecha(formulario.presdoc_falta_def.value))
				{
					alert("La fecha de alta definitivo no es válida");
					formulario.presdoc_falta_def.focus();
					return false;
				}
				
				var fechainicio=ConvertirFecha(formulario.presdoc_falta_prov.value,'dd/mm/aaaa','aaaammdd');
				var fechafin=ConvertirFecha(formulario.presdoc_falta_def.value,'dd/mm/aaaa','aaaammdd');
				if (fechainicio>fechafin) 	{
					alert("La fecha de alta definitiva debe ser mayor o igual que la fecha de alta provisoria");
					formulario.presdoc_falta_def.focus();
					return false;
				}
				
			}
			
			
<?php 		} ?>		


			// Fecha de Carga
			if (formulario.presdoc_falta.value=="" || !ValidarFecha(formulario.presdoc_falta.value))
			{
				alert("La fecha de carga del prestador no es válida");
				formulario.presdoc_falta.focus();
				return false;
			}

			if ((!formulario.presdoc_eventual[0].checked) && (!formulario.presdoc_eventual[1].checked))
			{
				alert("Debe seleccionar el tipo de prestador");
				return false;
			}

	
			
		//-----datos prestador  eventual----------------------------------------------------------------
			
			if (formulario.presdoc_eventual[0].checked)  {

				if ((trim(formulario.presdoc_eve_organismo.value)=="")){
					alert("Debe ingresar el Organismo donde trabaja");
					formulario.presdoc_eve_organismo.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_eve_cargo.value)=="")){
					alert("Debe ingresar un Cargo/Función");
					formulario.presdoc_eve_cargo.focus();
					return false;
				}	

				if (!ValidarContenido(formulario.presdoc_eve_email.value,"Email")){
					alert("El correo electrónico no es válido");
					formulario.presdoc_eve_email.focus();
					return false;
				}	


			
			}
			
			

		//-----datos prestador no eventual----------------------------------------------------------------
			
			if (formulario.presdoc_eventual[1].checked)  {
			
				if ((trim(formulario.presdoc_cuilt.value)=="")){
					alert("Debe ingresar un CUIT");
					formulario.presdoc_cuilt.focus();
					return false;
				}	

				if (!ValidarContenido(formulario.presdoc_cuilt.value,"CUIT")){
					alert("El CUIT/CUIL/CDI no es válido");
					formulario.presdoc_cuilt.focus();
					return false;
				}	

			
            
				if ((trim(formulario.presdoc_password.value)=="")){
					alert("Debe ingresar la contraseña");
					formulario.presdoc_password.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_password2.value)=="")){
					alert("Debe ingresar la confirmación de la contraseña");
					formulario.presdoc_password2.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_password.value)!=trim(formulario.presdoc_password2.value))){
					alert("Las contraseñas no coinciden");
					formulario.presdoc_password.focus();
					return false;
				}	

								
				if ((!formulario.presdoc_presentacion[0].checked) && (!formulario.presdoc_presentacion[1].checked))
				{
					alert("Debe seleccionar el tipo de presentación");
					return false;
				}
					
				if (formulario.presdoc_presentacion[0].checked && formulario.tipo_individual_con_org[0].checked) {
					if ((trim(formulario.jurisdid.value)=="")){
						alert("Debe ingresar un organismo donde trabaja");
						formulario.jurisdid.focus();
						return false;
					}	
				}

				if (formulario.presdoc_presentacion[1].checked) {
					if ((trim(formulario.presins_codigo.value)=="")){
						alert("Debe ingresar una Institución Prestadora");
						formulario.presins_codigo.focus();
						return false;
					}	
				}
	
				if (formulario.tipo_individual_con_org[0].checked) {
					if ((trim(formulario.presdoc_cargo.value)=="")){
						alert("Debe ingresar un Cargo/Función");
						formulario.presdoc_cargo.focus();
						return false;
					}	
				}
				
				
				if ((trim(formulario.presdoc_telefono.value)=="")){
					alert("Debe ingresar un teléfono");
					formulario.presdoc_telefono.focus();
					return false;
				}	
			
				if (!ValidarContenido(formulario.presdoc_email.value,"Email")){
					alert("El correo electrónico no es válido");
					formulario.presdoc_email.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_calle.value)=="")){
					alert("Debe ingresar una calle");
					formulario.presdoc_calle.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_numero.value)=="")){
					alert("Debe ingresar un número de la calle");
					formulario.presdoc_numero.focus();
					return false;
				}	
				
				if ((trim(formulario.presdoc_piso.value)=="")){
					alert("Debe ingresar un piso");
					formulario.presdoc_piso.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_cp.value)=="")){
					alert("Debe ingresar un Código Postal");
					formulario.presdoc_cp.focus();
					return false;
				}	
	

				if ((trim(formulario.presdoc_prov_codigo.value)=="")){
					alert("Debe ingresar una provincia");
					formulario.presdoc_prov_codigo.focus();
					return false;
				}	
				
				if ((trim(formulario.presdoc_part_loca_descripcion.value)=="")){
					alert("Debe ingresar Partido / Localidad");
					formulario.presdoc_part_loca_descripcion.focus();
					return false;
				}	
					
				// Tiene que seleccionarse por lo menos 1 tipo de postulación
				cant = 0;
				todos=document.getElementsByTagName('input');
			    for (var i=0; i< todos.length; i++) {
				if((todos[i].name.substr(0,8) == "tipopos_") && (todos[i].checked))
					cant++;
				}
				if (cant == 0)	{
					alert("Debe seleccionar algún Tipo de Postulación");
					formulario.tipopos_1.focus();
					return false;
				}			

				// Tiene que seleccionarse 1 tipo de formación
				cant = 0;
				todos=document.getElementsByTagName('input');
			    for (var i=0; i< todos.length; i++) {
				if((todos[i].name.substr(0,13) == "nivest_codigo") && (todos[i].checked))
					cant++;
				}
				if (cant != 1)	{
					alert("Debe seleccionar un Nivel de Estudios");
					return false;
				}			

				if ((trim(formulario.presdoc_ult_titulo.value)=="")){
					alert("Debe ingresar el último título alcanzado");
					formulario.presdoc_ult_titulo.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_ult_titulo_institucion.value)=="")){
					alert("Debe ingresar la institución educativa");
					formulario.presdoc_ult_titulo_institucion.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_ult_titulo_ano.value)=="")){
					alert("Debe ingresar el año de egreso educativa");
					formulario.presdoc_ult_titulo_ano.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_ult_titulo_ano.value)=="")){
					alert("Debe ingresar el año de egreso educativa");
					formulario.presdoc_ult_titulo_ano.focus();
					return false;
				}	

				if ((trim(formulario.presdoc_ido_competencias.value)=="")){
					alert("Debe ingresar las competencias");
					formulario.presdoc_ido_competencias.focus();
					return false;
				}	
				
				if ((trim(formulario.presdoc_ido_instituciones.value)=="")){
					alert("Debe ingresar la Institución / Organismo");
					formulario.presdoc_ido_instituciones.focus();
					return false;
				}	
				
				if ((trim(formulario.presdoc_cv.value)=="")){
					alert("Debe ingresar el resumen del CV de egreso educativa");
					formulario.presdoc_cv.focus();
					return false;
				}	



		}			
	}
//-----------------------------------------------------------------------------------------------------	
	function SeleccionPais(formulario ){
		var elSelect = document.getElementById('datos_provincia');
		if (formulario.presdoc_pais_codigo.value == <?php echo ARGENTINA?>) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";
		}
	}
//-----------------------------------------------------------------------------------------------------	
	function SeleccionTipoPrestador(formulario, seccion, seccion_ev ){
		var elSelect = document.getElementById(seccion);
		var elSelectEv = document.getElementById(seccion_ev);		
		if (formulario.presdoc_eventual[0].checked) {
			elSelect.style.display ="none";
			elSelectEv.style.display ="block";			
		} else {
			elSelect.style.display ="block";
			elSelectEv.style.display ="none";						
		}
	}
//-----------------------------------------------------------------------------------------------------	
	function SeleccionTieneOrganismo(formulario, seccion ){
		var elSelect = document.getElementById(seccion);
		if (formulario.tipo_individual_con_org[0].checked) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";
		}
	}

//-----------------------------------------------------------------------------------------------------	
	function SeleccionCaracterAlta(formulario, seccionprov, secciondef){
		var elSelectProv = document.getElementById(seccionprov);
		var elSelectDef = document.getElementById(secciondef);		
		if (formulario.presdoc_caracter_alta[0].checked) {
			CambiarPropiedad(seccionprov,"","disabled",false);
			CambiarPropiedad(secciondef,"","disabled",true);
		} else {
			CambiarPropiedad(seccionprov,"","disabled",false);
			CambiarPropiedad(secciondef,"","disabled",false);
		}
	}
	
	

//-----------------------------------------------------------------------------------------------------	
	function SeleccionTipoPresentacion(formulario, seccion_ind, seccion_ins ){
		var elSelectInd = document.getElementById(seccion_ind);
		var elSelectIns = document.getElementById(seccion_ins);
	
			if (formulario.presdoc_presentacion[0].checked) {
				elSelectInd.style.display ="block";
				elSelectIns.style.display ="none";			
			} else {
				if (formulario.presdoc_presentacion[1].checked) {
					elSelectInd.style.display ="none";
					elSelectIns.style.display ="block";			
				} else {
					elSelectInd.style.display ="none";
					elSelectIns.style.display ="none";			
				}	
			}			
	}
//-----------------------------------------------------------------------------------------------------	
	function LimpioOrganismoIndividual(docu,jurisdid,jurisdnom,es_orga_publico) {
		if(es_orga_publico == '<?php echo NO ?>') {		
			var elValor=docu.getElementById(jurisdid);
			SetearTexto(jurisdid,'',docu);
			var elValor=docu.getElementById(jurisdnom);
			SetearTexto(jurisdnom,'',docu);
		}		
	}	
//-----------------------------------------------------------------------------------------------------	
	function  ValidarDNIenCUIT (formulario) {
		if (formulario.presdoc_cuilt.value.substr(2,8) != formulario.presdoc_dni.value ) {
			return confirm ("El DNI no se corresponde con el CUIT ingresado. ¿Confirma los datos?")
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
function ValidarFormPrestadorDocenteEvaluar(formulario,operacion) {

	if (operacion=="A") {
		if ((!formulario.presdoc_caracter_alta[0].checked) && (!formulario.presdoc_caracter_alta[1].checked))
		{
			alert("Debe seleccionar el caracter de alta");
			return false;
		}
	}	
	return true;
}

//-----------------------------------------------------------------------------------------------------	
function ContarCaracteres(field, max) {
	if (field.value.length > max) {
		alert('Solo puede ingresar hasta '+max+' caracteres (2 páginas de texto)');
		field.value = field.value.substring(0, max);
	}
}

//-----------------------------------------------------------------------------------------------------	
function ValidarFormVencimientoPrestadorDocente(formulario) {

	if (formulario.fecha_inicio.value=="" || !ValidarFecha(formulario.fecha_inicio.value))
	{
		alert("La fecha de inicial no es válida");
		formulario.fecha_inicio.focus();
		return false;
	}

	if (formulario.fecha_fin.value=="" || !ValidarFecha(formulario.fecha_fin.value))
	{
		alert("La fecha final no es válida");
		formulario.fecha_fin.focus();
		return false;
	}
	
	
	var fechainicio=ConvertirFecha(formulario.fecha_inicio.value,'dd/mm/aaaa','aaaammdd');
	var fechafin=ConvertirFecha(formulario.fecha_fin.value,'dd/mm/aaaa','aaaammdd');
	if (fechainicio>fechafin) 	{
		alert("La fecha final debe ser mayor o igual que la fecha inicial");
		formulario.fecha_inicio.focus();
		return false;
	}



	return true;
}

<?php }
//-----------------------------------------------------------------------------------------------------	
	function BuscarPrestadorDocente($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxcuilt'=>0);
		$sparam+=array('pxcuilt_exacto'=>0);		
		$sparam+=array('pxcodigo'=>0);
		$sparam+=array('pxnombre'=>0);
		$sparam+=array('pxapellido'=>0);
		$sparam+=array('pxestado'=>0);
		$sparam+=array('pxpresins_codigo'=>0);
		$sparam+=array('pxjurisdid_origen'=>0);
		$sparam+=array('pxeventual'=>0);		
		
		$sparam+=array('ppresdoc_cuilt' =>"");
		$sparam+=array('ppresdoc_cuilt_exacto' =>"");		
		$sparam+=array('ppresdoc_codigo' =>"");
		$sparam+=array('ppresdoc_nombre' =>"");
		$sparam+=array('ppresdoc_apellido' =>"");
		$sparam+=array('ppresdoc_estado' =>"-1");
		$sparam+=array('ppresins_codigo' =>"");		
		$sparam+=array('pjurisdid_origen'=>"");
		$sparam+=array('porderby' =>"presdoc_cuilt");
		$sparam+=array('ppresdoc_eventual' =>"");

		if (isset ($ArregloDatos['presdoc_cuilt']))
		{
			if ($ArregloDatos['presdoc_cuilt']!="")
			{	
				$sparam['ppresdoc_cuilt']= $ArregloDatos['presdoc_cuilt'];
				$sparam['pxcuilt']= 1;
			}
		}

		if (isset ($ArregloDatos['presdoc_cuilt_exacto']))
		{
			if ($ArregloDatos['presdoc_cuilt_exacto']!="")
			{	
				$sparam['ppresdoc_cuilt_exacto']= $ArregloDatos['presdoc_cuilt_exacto'];
				$sparam['pxcuilt_exacto']= 1;
			}
		}

		if (isset ($ArregloDatos['presdoc_codigo']))
		{
			if ($ArregloDatos['presdoc_codigo']!="")
			{	
				$sparam['ppresdoc_codigo']= $ArregloDatos['presdoc_codigo'];
				$sparam['pxcodigo']= 1;
			}
		}	

		if (isset ($ArregloDatos['presdoc_nombre']))
		{
			if ($ArregloDatos['presdoc_nombre']!="")
			{	
				$sparam['ppresdoc_nombre']= $ArregloDatos['presdoc_nombre'];
				$sparam['pxnombre']= 1;
			}
		}
		if (isset ($ArregloDatos['presdoc_apellido']))
		{
			if ($ArregloDatos['presdoc_apellido']!="")
			{	
				$sparam['ppresdoc_apellido']= $ArregloDatos['presdoc_apellido'];
				$sparam['pxapellido']= 1;
			}
		}
		if (isset ($ArregloDatos['presdoc_estado']))
		{
			if ($ArregloDatos['presdoc_estado']!="")
			{	
				$sparam['ppresdoc_estado']= $ArregloDatos['presdoc_estado'];
				$sparam['pxestado']= 1;
			}
		}

		if (isset ($ArregloDatos['jurisdid_origen']))
		{
			if ($ArregloDatos['jurisdid_origen']!="")
			{	
				$sparam['pjurisdid_origen']= $ArregloDatos['jurisdid_origen'];
				$sparam['pxjurisdid_origen']= 1;
			}
		}

		
		if (isset ($ArregloDatos['presins_codigo']))
		{
			if ($ArregloDatos['presins_codigo']!="")
			{	
				$sparam['ppresins_codigo']= $ArregloDatos['presins_codigo'];
				$sparam['pxpresins_codigo']= 1;
			}
		}

		if (isset ($ArregloDatos['presdoc_eventual']))
		{
			if ($ArregloDatos['presdoc_eventual']!="")
			{	
				$sparam['ppresdoc_eventual']= $ArregloDatos['presdoc_eventual'];
				$sparam['pxeventual']= 1;
			}
		}
	
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_prestador_docente_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el Prestador Docente.";
			$errormail="Error al buscar el Prestador Docente.".$errno;
			return false;
		}

		return true;
	}
	
//-----------------------------------------------------------------------------------------------------	
	function BuscarPrestadorDocenteVencimiento($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam = $ArregloDatos;
		$spnombre="sel_prestador_docente_vencimiento";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar los Prestadores Docentes a vencer.";
			$errormail="Error al buscar los Prestadores Docentes a vencer.".$errno;
			return false;
		}

		return true;
	}	

//-----------------------------------------------------------------------------------------------------	
	function DescargarExcel()	{

		$ArregloDatos['presdoc_estado']=PRESDOCACTIVO;
		$ArregloDatos['orderby']='presdoc_apellido, presdoc_nombre';
		
		if(!$this->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;			
		}
		$i=0;
		while ($filaresult=mysqli_fetch_assoc($result))
		{
			$arrayresult[$i]['presdoc_cuilt']= $filaresult['presdoc_cuilt'];
			$arrayresult[$i]['presdoc_apellido']= $filaresult['presdoc_apellido'];
			$arrayresult[$i]['presdoc_nombre']= $filaresult['presdoc_nombre'];
			$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","PRESDOCCARACTER","' and constantecod='",$filaresult['presdoc_caracter_alta'],"'"),$caracterdesc,$numfilascaracter,$errorcod);
			$arrayresult[$i]['presdoc_caracter_alta']= $caracterdesc;
			$arrayresult[$i]['presdoc_falta_prov'] = FuncionesPHPLocal::ConvertirFecha($filaresult['presdoc_falta_prov'],'aaaa-mm-dd','dd/mm/aaaa');
			$arrayresult[$i]['presdoc_falta_def'] = FuncionesPHPLocal::ConvertirFecha($filaresult['presdoc_falta_def'],'aaaa-mm-dd','dd/mm/aaaa');
			
			$i++;
			
		}
		$nombrearchivo="prestador_docente.xls";  
		
		$oExcel= new cEscribirExcel($nombrearchivo);
		$oExcel->AddHoja('prestador_docente');
		$oExcel->EsconderGrillas();
		$oExcel->PaginaHorizontal();
		$oExcel->FormatoColumna (0,20); // cuilt
		$oExcel->FormatoColumna (1,30); // apellido
		$oExcel->FormatoColumna (2,30); // nombre
		$oExcel->FormatoColumna (3,10); // caracter
		$oExcel->FormatoColumna (4,20); // fecha de alta provisorio
		$oExcel->FormatoColumna (5,20); // fecha de alta definitivo


		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor",22);
// 		Sacamos titulo		
		$i=-1;
		
// 		$i++;		
//		$oExcel->CargarDatosVariasCeldas ($i,0,0,5,'Prestadores Docentes',true);

		// Titulos de las columnas
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");

		$i++;
		$oExcel->CargarDatos ($i,0,"Cuit/Cuil",true);
		$oExcel->CargarDatos ($i,1,"Apellido",true);
		$oExcel->CargarDatos ($i,2,"Nombre",true);
		$oExcel->CargarDatos ($i,3,"Caracter",true);
		$oExcel->CargarDatos ($i,4,"Fecha de Alta Provisorio",true);
		$oExcel->CargarDatos ($i,5,"Fecha de Alta Definitivo",true);		
				
		$arrayclaves=array(	'presdoc_cuilt','presdoc_apellido','presdoc_nombre',
							'presdoc_caracter_alta','presdoc_falta_prov', 'presdoc_falta_def');
		$i++;
		foreach ($arrayresult as $datos) {
			$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,array());	
			$i++;
		}
		
		$oExcel->Enviar();
	}
