//----------------------------------------------------------------------------------------- 
// Genera una tabla temporal con todos los campos de la tabla de tipos de organismo 

// Parámetros de Entrada:
//		conexion: la conexión con la base de datos sobre la cual va a quedar la tabla temporal
//		nombretabla: el nombre con el que se va a generar la tabla temporal

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no
//MODIFICADA
//PEND: Actualizar a la ultima version de la tabla, eliminar constraint, agregar catnom
	function _CrearTipoOrgTemp($conexion,$nombretabla,&$CodError)
	{
		$sql="
			CREATE TEMPORARY TABLE IF NOT EXISTS `".$nombretabla."` (
			  `versionid` int(10) unsigned NOT NULL default '0',
			  `torgid` int(10) unsigned NOT NULL default '0',
			  `catid` int(10) unsigned default '0',
			  `catnom` varchar(150) default NULL,
			  `torgnom` varchar(150) default NULL,
			  `torgcod` varchar(50) default NULL,
			  `torgnivel` tinyint(3) unsigned NOT NULL default '0',
			  `torgcte` varchar(50) default NULL,
			  `torgraizarbol` int(10) unsigned default NULL,
			  `torgfalta` datetime default NULL,
			  `torgfbaja` datetime default NULL,
			  `versionidinicial` int(10) unsigned NOT NULL default '0',
			  `ultmodusuario` int(10) unsigned NOT NULL default '0',
			  `ultmodfecha` datetime default NULL,
			  PRIMARY KEY  (`versionid`,`torgid`),
			  UNIQUE KEY `versionid` (`versionid`,`catid`,`torgcod`),
			  UNIQUE KEY `catid` (`versionid`,`catid`,`torgnom`),
			  KEY `versionidinicial` (`versionidinicial`)
			) TYPE=InnoDB COMMENT='Tipos de Organismos';
			";

		if(!mysqli_query($conexion, $sql))
		{
			$CodError=mysqli_errno($conexion);

			$subjectmail="";
			if(defined('SISTEMAMOSTRAR'))
				$subjectmail=SISTEMAMOSTRAR;
			elseif(defined('SISTEMA'))
				$subjectmail=SISTEMA;				
			$subjectmail.=" - Error en el sistema";
			$textomail ="Se produjo un error: \n";
			$textomail.="Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n\n";
			$textomail.="No se pudo crear Tabla Tipos de Organismos Temporal \n";
			$textomail.="Conexión      ".$conexion." \n";
			$textomail.="Nombre tabla  ".$nombretabla." \n";
			$textomail.="Error MySql   ".$CodError." - ".mysqli_error($conexion)." \n";

			FuncionesPHP::MandarMail($this->conexion,$this->conexion->admigeneral,"",$subjectmail,$textomail);
		
			return false;
		}
		
		return true;
	}

//----------------------------------------------------------------------------------------- 
// Inserta datos en una tabla

// Parámetros de Entrada:
//		conexion: la conexión con la base de datos donde está la tabla a ser cargada
//		nombretabla: el nombre de la tabla sobre la cual se van a ingresar el registro
//		arraydatos: array asociativo que tiene los nombre de sus campos y sus valores para un registro de la tabla

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no
//MODIFICADA		
	function _InsertTablaTemp($conexion,$nombretabla,$arraydatos,&$CodError)
	{
		$sqlnombrecampo=array();
		$sqlvalorcampo=array();
		
		foreach($arraydatos as $nombrecampo => $valorcampo)
		{
			$sqlnombrecampo[]=$nombrecampo;
			if(is_null($valorcampo))
				$sqlvalorcampo[]="NULL";
			else
				$sqlvalorcampo[]="'".mysqli_real_escape_string($conexion, $valorcampo)."'";
		}
		
//		$sqlnombrecampo=substr($sqlnombrecampo,0,strlen($sqlnombrecampo)-1);
//		$sqlvalorcampo=substr($sqlvalorcampo,0,strlen($sqlvalorcampo)-1);
		
		$sql="INSERT INTO ".$nombretabla." (";
		$sql.=implode(",",$sqlnombrecampo);
		$sql.=") VALUES (";
		$sql.=implode(",",$sqlvalorcampo);
		$sql.=");";

		if(!mysqli_query($conexion, $sql))
		{
			$CodError=mysqli_errno($conexion);
			
			$subjectmail="";
			if(defined('SISTEMAMOSTRAR'))
				$subjectmail=SISTEMAMOSTRAR;
			elseif(defined('SISTEMA'))
				$subjectmail=SISTEMA;				
			$subjectmail.=" - Error en el sistema";
			$textomail ="Se produjo un error: \n";
			$textomail.="Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n\n";
			$textomail.="No se pudo insertar en Tabla Temporal \n";
			$textomail.="Conexión      ".$conexion." \n";
			$textomail.="Nombre tabla  ".$nombretabla." \n";
			$textomail.="Error MySql   ".$CodError." - ".mysqli_error($conexion)." \n";

			FuncionesPHP::MandarMail($this->conexion,$this->conexion->admigeneral,"",$subjectmail,$textomail);

			return false;
		}
		
		return true;
	}
	
	
	
	
	
}
