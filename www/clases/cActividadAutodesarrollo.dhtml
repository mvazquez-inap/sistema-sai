	//-----------------------------------------------------------------------------------------
	function TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,&$datosresult,&$es_modif) {
		if (!$this->TraerDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo,$datosresult_detalle,$es_modif)) {
			return false;
		} else {
			$datosresult['act_codigo']=$datosresult_detalle['actividad']['act_codigo'];
			$datosresult['act_formato']=FORMATOAUTO;
			$datosresult['tipoact_codigo']=$tipoact_codigo;			
			$datosresult['act_nombre']=$datosresult_detalle['actividad']['act_nombre'];
			$datosresult['act_codinap']=$datosresult_detalle['actividad']['act_codinap'];
			$datosresult['act_duracionhs']=$datosresult_detalle['actividad_autodesarrollo']['actauto_duracionhs'];
			$datosresult['act_estado']=$datosresult_detalle['actividad_autodesarrollo']['actauto_estado'];
			$datosresult['act_creditos']=($tipoact_codigo==TIPOACTAUTOEVASIS)?$datosresult_detalle['actividad_autodesarrollo_evento']['actautoeven_creditos_asistencia']:"x persona";
			$datosresult['jurisdid_inap']=0;
			return true;
		}
	}	
	//-----------------------------------------------------------------------------------------
	function TraerDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo,&$datosresult,&$es_modif) {
		
		// Si se hay error al ejecutar algún SQL retorna error, sino si no encuentra
		// la actividad o la actividad no es Autodesarrollo, retorna que es_modif=false
		// pues no se encontro una actividad autodesarrollo con el codigo enviado

		$datosresult=array();
		$es_modif = false;		
		$es_modif_act=false;
		
		if (!$this->TraerDatosActividad($act_codigo,$result_actividad,$es_modif_act)) 
			return false;

		$datosresult['actividad'] = $result_actividad;

		if ($es_modif_act) {
			$ArregloDatos = array();
			$ArregloDatos['act_codigo'] = $act_codigo;
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;			
			if(!$this->BuscarActividadAutodesarrollo($ArregloDatos,$numfilas,$resultActAuto,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$result = false;			
			}

			if ($numfilas == 1)	{
				$datosresult['actividad_autodesarrollo'] = mysqli_fetch_assoc($resultActAuto);
				$es_modif = true;
			}

			$ArregloDatos = array();
			$ArregloDatos['act_codigo'] = $act_codigo;
	
			if(!$this->BuscarActividadAutodesarrolloEvento($ArregloDatos,$numfilas,$resultActAuto,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$result = false;			
			}

			if ($numfilas == 1)	{
				$datosresult['actividad_autodesarrollo_evento']= mysqli_fetch_assoc($resultActAuto);
				$es_modif = true;
			}
			
		} // $es_modif_act

		return true;
	}
	//-----------------------------------------------------------------------------------------
	function TraerDatosActividadAutodesarrolloEvento($act_codigo,&$datosresult,&$es_modif) {
		
		// Si se hay error al ejecutar algún SQL retorna error, sino si no encuentra
		// la actividad o la actividad no es Autodesarrollo, retorna que es_modif=false
		// pues no se encontro una actividad autodesarrollo con el codigo enviado

		$es_modif = false;		

		$ArregloDatos = array();
		$ArregloDatos['act_codigo'] = $act_codigo;
		if(!$this->BuscarActividadAutodesarrolloEvento($ArregloDatos,$numfilas,$resultActAutoEvento,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result = false;			
		}

		if ($numfilas == 1)	{
			$datosresult['actividad_autodesarrollo_evento']=mysqli_fetch_assoc($resultActAutoEvento);
			$es_modif = true;
		}
		return true;
	}

	//-----------------------------------------------------------------------------------------
	function TraerDatosActividadAutodesarrolloPersona($act_codigo, $pers_codigo,&$datosresult,&$es_modif) {
		
		// Si se hay error al ejecutar algún SQL retorna error, sino si no encuentra
		// la actividad o la actividad no es Autodesarrollo, retorna que es_modif=false
		// pues no se encontro una actividad autodesarrollo con el codigo enviado

		$es_modif = false;		

			$ArregloDatos = array();
			$ArregloDatos['act_codigo'] = $act_codigo;
			$ArregloDatos['pers_codigo'] = $pers_codigo;			
				if(!$this->BuscarActividadAutodesarrolloPersona($ArregloDatos,$numfilas,$resultActAutoPersona,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$result = false;			
				}

				if ($numfilas == 1)	{
					$datosresult['actividad_autodesarrollo_persona']= mysqli_fetch_assoc($resultActAutoPersona);
					$es_modif = true;
				}

		return true;
	}
	//-----------------------------------------------------------------------------------------
	function ListarDisenoActividadPDF($act_codigo,$tipoact_codigo) {

		function GenerarActividadDiseno(&$pdf,$filaautodesarrollo) {
	
			$pdf->AddAcividadDiseno();
			$pdf->Set('datos_actividad',$filaautodesarrollo);		
			$pdf->Set('formact_codigo',FORMATOAUTO);
			$pdf->Set('tipoact_codigo',$filaautodesarrollo['actividad_autodesarrollo']['tipoact_codigo']);
		
		} // GenerarActa
		
		$ok=true;
	 	if (!$this->TraerDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo,$filaautodesarrollo,$es_modif))
	   		$ok=false;		
		
		if (!$es_modif) {
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			$ok=false;		
		}
		$autodesarrollo_evento = false;
		$autodesarrollo_persona = false;				
		switch ($tipoact_codigo) {
			case TIPOACTAUTOEVASIS : 
			case TIPOACTAUTOEVACT : 
				$autodesarrollo_evento = true;
				if (!$this->TraerDatosActividadAutodesarrolloEvento($act_codigo,$filaautodesarrollo,$es_modif))
					$ok=false;		
			break;
		}
	
		$filaautodesarrollo['actividad_autodesarrollo'] += array('es_evento'=>$autodesarrollo_evento);
		$descri="";
	 	if ($this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$filaautodesarrollo['actividad_autodesarrollo']['actauto_estado'],"'"),$descri,$numfilas,$errorcod)) 
	 		$filaautodesarrollo['actividad_autodesarrollo'] += array('actauto_estado_desc'=>$descri);
	 
		$descri="";
		if($this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$tipoact_codigo,"'"),$descri,$numfilas,$errorcod))
			$filaautodesarrollo['actividad_autodesarrollo'] += array('tipoact_descripcion'=>$descri);
	
		if ($autodesarrollo_evento) {
			$descri="";
			if (isset($filaautodesarrollo['actividad_autodesarrollo_evento']['orgapri_codigo'])) 
				if($this->conexion->TraerCampo("organismo_privado","orgapri_nombre",array("orgapri_codigo='",$filaautodesarrollo['actividad_autodesarrollo_evento']['orgapri_codigo'],"'"),$descri,$numfilas,$errorcod)) 			
					$filaautodesarrollo['actividad_autodesarrollo_evento'] += array('orgapri_nombre'=>$descri);
				
			if (isset($filaautodesarrollo['actividad_autodesarrollo_evento']['jurisdid_apn'])) {
				$jurisdicciones	 = new jurisdicciones;
				if ($jurisdicciones->SelectJurisdxID($filaautodesarrollo['actividad_autodesarrollo_evento']['jurisdid_apn'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError))  
					$filaautodesarrollo['actividad_autodesarrollo_evento'] += array('jurisd_apn_nombre'=>$fila_jurisd[$filaautodesarrollo['actividad_autodesarrollo_evento']['jurisdid_apn']]['jurisdnom']);					
			}
			
			$descri="";	
			if (isset($filaautodesarrollo['actividad_autodesarrollo_evento']['orgapub_codigo'])) 
				if ($this->conexion->TraerCampo("organismo_publico","orgapub_nombre",array("orgapub_codigo='",$filaautodesarrollo['actividad_autodesarrollo_evento']['orgapub_codigo'],"'"),$descri,$numfilas,$errorcod)) 		
					$filaautodesarrollo['actividad_autodesarrollo_evento'] += array('orgapub_nombre'=>$descri);			
			
			$descri	= "";	
			if($this->conexion->TraerCampo("paises","paisnom",array("paiscod='",$filaautodesarrollo['actividad_autodesarrollo_evento']['pais_codigo'],"'"),$descri,$numfilas,$errorcod))
				$filaautodesarrollo['actividad_autodesarrollo_evento'] += array('paisnom'=>$descri);
		
			if ($filaautodesarrollo['actividad_autodesarrollo_evento']['pais_codigo'] == ARGENTINA) { 
				$descri	= "";	
				if ($this->conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$filaautodesarrollo['actividad_autodesarrollo_evento']['prov_codigo'],"'"),$descri,$numfilas,$errorcod))
					$filaautodesarrollo['actividad_autodesarrollo_evento'] += array('provincianom'=>$descri);		
			}
		} // es evento	
	 	
		$pdf = new cActividadDisenoPDF();
		GenerarActividadDiseno($pdf,$filaautodesarrollo); 
		$pdf->MostrarActividadDiseno($this->conexion);
		$pdf->Output("disenoActividad.pdf","I");
	
		return true;
	}	
