<SCRIPT type="text/javascript">
//  Comienzo -->
// -------------------------------------------------------------------------------------------------
function SelObj(formname,selname,textname,str) {
	this.formname = formname;
	this.selname = selname;
	this.textname = textname;
	this.select_str = str || '';
	this.selectArr = new Array();
	this.initialize = initialize;
	this.bldInitial = bldInitial;
	this.bldUpdate = bldUpdate;
}
// -------------------------------------------------------------------------------------------------
function initialize(formulario,selname) {

	if (this.select_str =='') {

		for(var i=0;i<document.forms[formulario][selname].options.length;i++) {

			this.selectArr[i] = document.forms[formulario][selname].options[i];
			this.select_str += document.forms[formulario][selname].options[i].value+":"+
			document.forms[formulario][selname].options[i].text;

			if (i<document.forms[formulario][selname].options.length-1)
				this.select_str += ",";
		}

	} else {

		var tempArr = this.select_str.split(',');
		for(var i=0;i<tempArr.length;i++) {
			var prop = tempArr[i].split(':');
			this.selectArr[i] = new Option(prop[1],prop[0]);
		}

	}
	return;
}
// -------------------------------------------------------------------------------------------------
function bldInitial(formulario,selname) {
	
	this.initialize(formulario,selname);
	for(var i=0;i<this.selectArr.length;i++) {
		document.forms[formulario][selname].options[i] = this.selectArr[i];
	}	

	document.forms[formulario][selname].options.length = this.selectArr.length;
	return;
}
// -------------------------------------------------------------------------------------------------
function bldUpdate(formulario,selname) {

	var pattern1;
	var str = document.forms[formulario][this.textname].value.replace('^\\s*','');
	
	
	if(str == '') {
		this.bldInitial(formulario,selname); 
		return;
	}
	
	this.initialize(formulario,selname);
	var j = 0;

	pattern1 = new RegExp(""+str+"","i");
	
	for(var i=0;i<this.selectArr.length;i++)
		if(pattern1.test(this.selectArr[i].text)) 
			document.forms[formulario][selname].options[j++] = this.selectArr[i];

	document.forms[formulario][selname].options.length = j;

	if(j==1) {
		document.forms[formulario][selname].options[0].selected = true;
	}

}
// -------------------------------------------------------------------------------------------------
function setUp() {
	obj1 = new SelObj('formulario','org_codigo','inputNombreOrganismo');
	obj1.bldInitial('formulario','org_codigo'); 
}
// -------------------------------------------------------------------------------------------------
//  Fin -->
</SCRIPT>
