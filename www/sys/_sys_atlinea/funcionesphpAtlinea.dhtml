//----------------------------------------------------------------------------------------- 
// Genera una password aleatoria del largo ingresado

	function GenerarPassword($largo)
	{
		$nuevapwd="";
		
		for($i=1;$i<=$largo;$i++)
			$nuevapwd.=chr(rand(65,90));
			
		return $nuevapwd;
		
	}

//----------------------------------------------------------------------------------------- 
// Retorna el querystring y el md5 correspondiente

	function ArmarLinkMD5($pagina,$parametros,&$get,&$md5)
	{
		$codigospagina["rpt_peticion_detalle.dhtml"]="COD1948";
		$codigospagina["peticion_derivar.dhtml"]="COD5197";
		$codigospagina["peticion_finalizar.dhtml"]="COD4097";
		$codigospagina["datos_solicitante.dhtml"]="COD5498";
	
		$get_array=array();
		$get="";
		$codigo="";
		$md5="";
		
		if(!isset($codigospagina[$pagina]) || count($parametros)<1)
			return false;
		
		foreach($parametros as $nombparam => $valparam)
		{
			$get_array[]=$nombparam."=".$valparam;
			$codigo.=$valparam;
		}
		
		$codigo.=$codigospagina[$pagina];
		$codigo.=$_SESSION["usuariocod"];
		
		$md5=md5($codigo);
	
		$get=implode("&amp;",$get_array);
		$get.="&amp;md5=".$md5;
		
		return true;
	}	


	function base64_encoder_multi(&$val,$key) 
	{
	  if (is_array($val)) 
	  	array_walk($val,array('FuncionesPHPAtlinea','base64_encoder_multi'));
	  else 
		 $val = base64_encode($val);
	}

	function base64_cleaner_multi(&$val,$key) 
	{
	  if (is_array($val)) 
	  	array_walk($val,array('FuncionesPHPAtlinea','base64_cleaner_multi'));
	  else 
		 $val = base64_decode($val);
	}

	function base64_unserialize(&$item, $key)
	{
		$item = unserialize($item);
		if(is_array($item))
			array_walk($item,array('FuncionesPHPAtlinea','base64_cleaner_multi'));
	}

	
	function HacerPedidoABackEnd($tipo_pedido,$param,&$respuesta)
	{
		require_once "HTTP/Request.php";

		$respuesta="";
	
		$req =& new HTTP_Request("");
		$req->setMethod(HTTP_REQUEST_METHOD_POST);
		$req->addPostData("codigo_verificacion_servidores", "52HcE498eCd43La9");
		
		$req->addPostData("tipo_pedido", $tipo_pedido);
		switch($tipo_pedido)
		{
			case "BACKEND_GruposTemas":
			case "BACKEND_JurisdHabil":
			case "BACKEND_JurisdMasRelev":
			case "BACKEND_JurisdMasVisit":
			case "BACKEND_MediosRespuesta":
			case "BACKEND_TiposDocumentos":
			case "BACKEND_Ubicaciones":
			case "BACKEND_Provincias":
			case "BACKEND_NivEstudio":
			case "BACKEND_Ocupaciones":
				break;
			case "BACKEND_Temas_xGrptemacod":
				$req->addPostData("grptemacod", $param["grptemacod"]);
				break;
			case "BACKEND_Temas_xJurisdid":
				$req->addPostData("jurisdid", $param["jurisdid"]);
				break;
			case "BACKEND_Paises_sin_Argentina":
				$req->addPostData("codigo_arg", $param["codigo_arg"]);
				break;
			case "BACKEND_Temas_xtemacod":
				$req->addPostData("temacod", $param["temacod"]);
				break;
			case "BACKEND_MesaAyuda_Asignada":
				$req->addPostData("temacod", $param["temacod"]);
				break;
			case "BACKEND_Nueva_Peticion":
				$req->addPostData("session_serialize", $param["session_serialize"]);
				break;
			case "BACKEND_Peticiones_xPeticcod":
				$req->addPostData("peticcod", $param["peticcod"]);
				break;
			case "BACKEND_DatosPersonales_xPeticcod":
				$req->addPostData("peticcod", $param["peticcod"]);
				break;
			case "BACKEND_PeticInstancias_Ciudadano_xPeticcod":
				$req->addPostData("peticcod", $param["peticcod"]);
				break;
			case "BACKEND_Mesaayuda_xMesaayudacod":
				$req->addPostData("mesaayudacod", $param["mesaayudacod"]);
				break;

			default:
				return false;
		}
		
		$req->setURL(URL_PEDIDO_BACKEND);
		
		if (!PEAR::isError($req->sendRequest())) 
		{
			$respuesta=$req->getResponseBody();	
			if(substr($respuesta,0,2)!="OK")	
				return false;

			$respuesta=substr($respuesta,3);

			if($respuesta!="")
			{
				$respuesta=explode(SINC_SEPARADOR_ARRAYS,$respuesta);
				array_walk($respuesta,array('FuncionesPHPAtlinea','base64_unserialize'));
			}
			else
				$respuesta=array();
		}
		else
			 return false;
	
		return true;
	}

	function BuscarRegistroArray($conexion,$respuesta_backend_grptemas,$arraybusq,&$filaret,&$numfilasmatcheo)
	{
		$filaret=array();

		$numfilasmatcheo=0;
		foreach($respuesta_backend_grptemas as $fila)
		{
			foreach ($arraybusq as $clave => $valor)
			{
				$matcheo=true;
				if (!isset($fila[$clave]))
				{
					$arraymensajepantalla =array();	
					$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
					$arraymensajemail+=array("texto" => "Problema en BuscarRegistroArray.  No existe '".$clave."'. ");
					FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);

					return false;
				}

				if($fila[$clave]!=$valor)
				{
					$matcheo=false;
					break;
				}
			} // for each arraybusq
			if($matcheo)
			{
				$filaret=$fila;
				$numfilasmatcheo++;
			}
		} // while del query
		if($numfilasmatcheo!=1)
			$filaret=array();
	
		return true;
	}

} // class FuncionesPHPAtlinea

