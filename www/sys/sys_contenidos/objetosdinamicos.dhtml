				}
				$salida.="</div>\n";
				$salida.= "<div class=\"txtLetraChica\" align=\"right\">Suministrado por el Servicio Meteorológico Nacional</div>\n";


				break;

			case "DatosActCiudades":

				$salida.="<div style=\"padding:0px 5px\">\n";
				foreach($this->OtrasCiudades as $prov)
				{
					$salida.="<div class=\"titBloque01\" style=\"margin:8px 0px\"><a name='".$prov[1]."'></a>".$prov[0]."</div>\n";

					for($ciud_i=2;$ciud_i<count($prov);$ciud_i++)
					{
						$datos=$prov[$ciud_i];
						$this->_ObtenerDatosAct($datos[1],$temperatura,$sensterm,$icono,$humedad);

						$textopron="";
						$textopron=$this->_ConvertirMayuscula($this->cont_archivo_pron[$datos[2]][$datos[3]][0][7]);


						$salida.= "<div class=\"bgcolordestacada clearfix\" style=\"margin:8px 0px\">\n";
						$salida.= "	<div style=\"float:left; padding:3px; text-align:center;\" class=\"caja_pron_prim_col\">\n";
						if($icono!="")
							$salida.= "		<img src=\"".$icono."\" alt=\"Clima\" title=\"Clima\" width=\"24\" height=\"25\" />\n";
						$salida.= "	</div>\n";
						$salida.= "	<div style=\"float:left; padding:6px;\" class=\"bgcolorcelesteclaro caja_pron_segunda_col\">\n";
						$salida.= "		<div class=\"txtIndice\" style=\"margin-left:0px; margin-bottom:6px; \">\n";
						$salida.= "			<div style=\"float:left;  white-space:nowrap; margin-left:0px;\" class=\"titIndice\">".$datos[0]."</div>\n";
						$salida.= "			<div style=\"float:right; width:40px; white-space:nowrap; text-align:right;\">".$humedad."</div>\n";
						$salida.= "			<div style=\"float:right; width:60px; white-space:nowrap; text-align:right;\">".$sensterm."</div>\n";
						$salida.= "			<div style=\"float:right; width:55px; white-space:nowrap; text-align:right;\">".$temperatura."</div>\n";
						$salida.= "			<div class=\"clearboth\"></div>\n";
						$salida.= "		</div>\n";
						$salida.= "		<div class=\"txtStandard\" >".$textopron."</div>\n";
						$salida.= "	</div>\n";
						$salida.= "	<div class=\"clearboth\"></div>\n";
						$salida.= "</div>\n";
					}
				}
				$salida.="</div>\n";
				$salida.= "<div class=\"txtLetraChica\" align=\"right\">Suministrado por el Servicio Meteorológico Nacional</div>\n";



				break;
		}

		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

	function _LeerArchivoPron()
	{
		$this->cont_archivo_pron=array();

		if(!($contenido_original=file(DIR_PAGESTATICA."info_externa/PronCiu.txt")))
			return false;

		$i=2;
		while($i<count($contenido_original))
		{
			$linea=explode("|",substr(trim($contenido_original[$i]),0,-1));
			if(!isset($linea[4]))
				error_log("Fallo Pronostico: ".$contenido_original[$i]);
			$this->cont_archivo_pron[$linea[0]][$linea[1]][$linea[4]]=$linea;
			$i++;
		}

		return true;
	}

	function _LeerArchivoDatAct()
	{
		$this->cont_archivo_datact=array();

		if(!($contenido_original=file(DIR_PAGESTATICA."info_externa/total.txt")))
			return false;

		$i=0;
		while($i<count($contenido_original))
		{
			$linea=explode(";",substr(trim($contenido_original[$i]),0,-2));
			$this->cont_archivo_datact[$linea[0]]=$linea;
			$i++;
		}

		return true;
	}

	function _ConvertirMayuscula($texto)
	{
		$texto=mb_strtolower($texto);
		$arr_texto=explode(".",$texto);
		$arr_texto = array_map("trim", $arr_texto);
		$arr_texto = array_map("ucfirst", $arr_texto);
		$texto=implode(". ",$arr_texto);

		return $texto;
	}

	function _ObtenerDatosAct($ciudad,&$temperatura,&$sensterm,&$icono,&$humedad)
	{
		$temperatura="";
		$sensterm="&nbsp;";
		$icono="";
		$humedad="";

		if(isset($this->cont_archivo_datact[$ciudad]) && trim($this->cont_archivo_datact[$ciudad][3])!="Sin información disponibl")
		{
			$datosact=$this->cont_archivo_datact[$ciudad];

			$temperatura="T: ".str_replace(".",",",$datosact[5])."&deg;";
			if($datosact[6]!="No se calcula")
				$sensterm="ST: ".$datosact[6]."&deg;";
			$icono=$this->iconos[$datosact[10]];
			$humedad="H: ".$datosact[7]."%";
		}

		return true;
	}

}

//-----------------------------------------------------------------------------------------
class cFeriados
{
	var $SubTipo;
	var $NumPaginaAnio;
	var $msg_error;
	var $es_admin;
	var $xml;
	var $pagina;

	function cFeriados($es_admin=false)
	{
		require_once('minixml-1.3.0/minixml.inc.php');
		require_once('SOAP/Type/dateTime.php');

		$this->msg_error = "";
		$this->es_admin = $es_admin;
		$this->xml = new MiniXMLDoc();
	}

	function Setear($parametros)
	{
		$this->SubTipo=$parametros["SubTipo"];
		$this->NumPaginaAnio=$parametros["NumPaginaAnio"];
		$this->pagina=$parametros["pagina"];

		switch($this->SubTipo)
		{
			case "FeriadosMes":
				if(!$this->_LeerArchivoMes())
					return false;
				break;
			case "FeriadosAnio":
				if(!$this->_LeerArchivoAnio())
					return false;
				break;
		}

		return true;
	}

	function Mostrar(&$salida)
	{
		$DateTimeSOAP=new SOAP_Type_dateTime();

		$seprodujoerror=false;

		switch($this->SubTipo)
		{
			case "FeriadosMes":

				$xmlRoot =& $this->xml->getRoot();
				$feriadods=& $xmlRoot->getElementByPath('/FeriadoDS');
				$feriados =& $feriadods->getAllChildren();

				$salida.= "<div class=\"bgcolordestacada clearfix\">\n";
				$salida.= "	<div style=\"float:left; width:25px; padding:3px; text-align:center;\">\n";
				$salida.= "		<img src=\"/contenido/portal/img/calendario_feriados.jpg\" alt=\"Calendario\" title=\"Calendario\" width=\"24\" height=\"25\" />\n";
				$salida.= "	</div>\n";
				$salida.= "	<div style=\"float:left; width:223px; padding:6px;\" class=\"bgcolorcelesteclaro\">\n";
				$salida.= "	    <div class=\"titCaja\" style=\"margin-bottom:5px; \">FERIADOS DEL MES</div>";
				foreach($feriados as $feriado)
				{
					$nodo_xml=$feriado->getElementByPath('/ID');
					$id_xml=html_entity_decode($nodo_xml->getValue());
					$nodo_xml=$feriado->getElementByPath('/Descripcion');
					$texto_xml=html_entity_decode($nodo_xml->getValue());
					$nodo_xml=$feriado->getElementByPath('/FechaOrigen');
					$fecha_xml=ReemplazarTextoFechas(date("d \de F",$DateTimeSOAP->toUnixtime($nodo_xml->getValue())));

					$salida.= "		<div class=\"titIndice\" style=\"margin-left:0px; \">".$fecha_xml." - ".$texto_xml."</div>\n";

					$salida.= "		<div id=\"feriados_".$id_xml."\" >";
					$salida.= "		     <a href=\"javascript:MostrarOcultar('feriados_".$id_xml."','feriados_".$id_xml."_info');\" class=\"txtStandard\" >&middot; Mas información</a>";
					$salida.= "		</div>";
					// agregado de noscript
					$salida.= "		 <noscript>";
					$salida.= "		<div class=\"txtStandard\">";
					$nodo_xml=$feriado->getElementByPath('/Trasladable');
					if($nodo_xml->getValue()=="true")
					{
						$nodo_xml=$feriado->getElementByPath('/FechaEfectiva');
						$fecha_xml=ReemplazarTextoFechas(date("d \de F",$DateTimeSOAP->toUnixtime($nodo_xml->getValue())));
						$salida.= "		<div class=\"txtStandard\">&middot; Feriado Trasladable al ".$fecha_xml."</div>\n";
					}
					else
						$salida.= "		<div class=\"txtStandard\">&middot; Feriado Inamovible</div>\n";
					$nodo_xml=$feriado->getElementByPath('/TipoDescripcion');
					$tipodesc_xml=html_entity_decode($nodo_xml->getValue());
					$salida.= "		<div class=\"txtStandard\">&middot; ".$tipodesc_xml."</div>\n";
					$salida.= "		</div>";
					$salida.= "		 </noscript>";
					// fin agregado de noscript

					$salida.= "		<div class=\"txtStandard\" id=\"feriados_".$id_xml."_info\" style='visibility: hidden; Position:absolute; '>";
					$nodo_xml=$feriado->getElementByPath('/Trasladable');
					if($nodo_xml->getValue()=="true")
					{
						$nodo_xml=$feriado->getElementByPath('/FechaEfectiva');
						$fecha_xml=ReemplazarTextoFechas(date("d \de F",$DateTimeSOAP->toUnixtime($nodo_xml->getValue())));
						$salida.= "		<div class=\"txtStandard\">&middot; Feriado Trasladable al ".$fecha_xml."</div>\n";
					}
					else
						$salida.= "		<div class=\"txtStandard\">&middot; Feriado Inamovible</div>\n";
					$nodo_xml=$feriado->getElementByPath('/TipoDescripcion');
					$tipodesc_xml=html_entity_decode($nodo_xml->getValue());
					$salida.= "		<div class=\"txtStandard\">&middot; ".$tipodesc_xml."</div>\n";
					$salida.= "		<div>&middot; <a href=\"javascript:MostrarOcultar('feriados_".$id_xml."_info','feriados_".$id_xml."');\" class=\"txtStandard\" >Ocultar información</a></div>";
					$salida.= "		</div>";
					$salida.= "		<div style=\"margin-bottom:10px; \"></div>\n";
				}
				//-----------------------------------//
				//ABRE POPUP CON LOS FERIADOS DEL AÑO DEL WEBSERVICE
				//$salida.= "		<div class=\"txtStandard\"><a href=\"javascript:void(0)\" onclick=\"window.open('/contenido/portal/paginas_imp.dhtml?pagina=".$this->NumPaginaAnio."','FeriadosAnio','menubar=no,location=no,toolbar=no,status=no,scrollbars=yes,directories=no,width=635,height=600')\">&middot; Ver todos los feriados del año.</a></div>\n";
				// VA DIRECTO A LA PAGINA DEL MINISTERIO DEL INTERIOR
				$salida.= "		<div class=\"txtStandard\"><a href='http://www.mininterior.gov.ar/servicios/feriados2008.asp' target='_blank'>&middot; Ver todos los feriados del año.</a></div>\n";
				//-----------------------------------//
				$salida.= "		<div class=\"txtLetraChica\" align=\"right\">Información provista por el <a href='http://www.mininterior.gov.ar/servicios/feriados.asp' target='_blank'>Ministerio del Interior.</a></div>\n";
				$salida.= "	</div>\n";
				$salida.= "	<div class=\"clearboth\"></div>\n";
				$salida.= "</div>\n";


				break;
			case "FeriadosAnio":
				$xmlRoot =& $this->xml->getRoot();
				$feriadods=& $xmlRoot->getElementByPath('/FeriadoDS');
				$feriados =& $feriadods->getAllChildren();
				$mes_anterior="";

				foreach($feriados as $feriado)
				{
					$nodo_xml=$feriado->getElementByPath('/Descripcion');
					$texto_xml=html_entity_decode($nodo_xml->getValue());
					$nodo_xml=$feriado->getElementByPath('/FechaOrigen');
					$fecha_xml=ReemplazarTextoFechas(date("d \de F",$DateTimeSOAP->toUnixtime($nodo_xml->getValue())));

					$mes_actual=ReemplazarTextoFechas(date("F",$DateTimeSOAP->toUnixtime($nodo_xml->getValue())));
					if($mes_actual!=$mes_anterior)
					{
						$salida.="<div class=\"titBloque01\" style=\"margin:12px 0px 4px 0px\">".$mes_actual."</div>\n";
						$mes_anterior=$mes_actual;
					}
					else
						$salida.="<div class=\"titBloque01\" style=\"padding:6px 0px\"></div>\n";

					$salida.= "<div class=\"bgcolordestacada clearfix\" >\n";
					$salida.= "	<div style=\"float:left; padding:3px; text-align:center;\" class=\"caja_pron_prim_col\"></div>\n";
					$salida.= "	<div style=\"float:left; padding:0px 6px; width:543px;\" class=\"bgcolorcelesteclaro caja_pron_segunda_col\">\n";
					$salida.="<p class=\"titBloque02\">".$fecha_xml." - ".$texto_xml."</p>\n";
					$nodo_xml=$feriado->getElementByPath('/Trasladable');
					if($nodo_xml->getValue()=="true")
					{
						$nodo_xml=$feriado->getElementByPath('/FechaEfectiva');
						$fecha_xml=ReemplazarTextoFechas(date("d \de F",$DateTimeSOAP->toUnixtime($nodo_xml->getValue())));
						$salida.= "		<p class=\"txtStandard\">Feriado Trasladable al ".$fecha_xml."</p>\n";
					}
					else
						$salida.= "		<p class=\"txtStandard\">Feriado Inamovible</p>\n";
					$nodo_xml=$feriado->getElementByPath('/TipoDescripcion');
					$tipodesc_xml=html_entity_decode($nodo_xml->getValue());
					$salida.= "		<p class=\"txtStandard\">".$tipodesc_xml."</p>\n";

					$salida.="</div>\n</div>\n";
				}
				$salida.= "		<div class=\"txtLetraChica\" align=\"right\">Información provista por el <a href='http://www.mininterior.gov.ar/servicios/feriados.asp' target='_blank'>Ministerio del Interior.</a></div>\n";

				$salida.= "		<div style=\"font-size:1px; height:10px;\"></div>\n";
				$salida.= "		<ul style=\"list-style-type: none;padding: 0;margin: 0;	width: 350px;\">\n";
				$salida.= "			<li class=\"txtStandard\" style=\"text-align:left;float:left;width:175px;height: 26px;\"><img src=\"/contenido/portal/img/ico_imprimir.gif\" alt=\"Imprimir\" style=\"vertical-align:middle; display:inline\" /><a href=\"javascript:void(0)\" onclick=\"window.print();\" class=\"txtVolverArriba\" > Imprimir esta p&aacute;gina </a></li>\n";
				$salida.= "			<li class=\"txtStandard\" style=\"text-align:right;float:left;width:175px;height: 26px;\"><img src=\"/contenido/portal/img/ico_email_2.gif\" alt=\"Recomendar\" style=\"vertical-align:middle; display:inline\" /><a href=\"mailto:?subject=Portal%20argentina.gov.ar&amp;body=Te%20recomiendo%20visitar%20este%20sitio:%20http://www.argentina.gov.ar/contenido/portal/pagina_imp.dhtml=".$this->pagina."\" class=\"txtVolverArriba\" > Enviar por e-mail</a></li>\n";
				$salida.= "		</ul>\n";
				$salida.= "		<div class=\"clearboth\"></div>\n";

				break;
		}

		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

	function _LeerArchivoMes()
	{
		if(!($contenido_original=file_get_contents(DIR_PAGESTATICA."info_externa/feriados_mes.xml")))
			return false;

		$this->xml->fromString($contenido_original);

		return true;
	}

	function _LeerArchivoAnio()
	{
		if(!($contenido_original=file_get_contents(DIR_PAGESTATICA."info_externa/feriados_anio.xml")))
			return false;

		$this->xml->fromString($contenido_original);

		return true;
	}


}

function ReemplazarTextoFechas($texto)
{
	// reemplazo meses
	$texto = preg_replace("#January#","Enero",$texto);
	$texto = preg_replace("#February#","Febrero",$texto);
	$texto = preg_replace("#March#","Marzo",$texto);
	$texto = preg_replace("#April#","Abril",$texto);
	$texto = preg_replace("#May#","Mayo",$texto);
	$texto = preg_replace("#June#","Junio",$texto);
	$texto = preg_replace("#July#","Julio",$texto);
	$texto = preg_replace("#August#","Agosto",$texto);
	$texto = preg_replace("#September#","Septiembre",$texto);
	$texto = preg_replace("#October#","Octubre",$texto);
	$texto = preg_replace("#November#","Noviembre",$texto);
	$texto = preg_replace("#December#","Diciembre",$texto);

	// reemplazo meses cortos
	$texto = preg_replace("#Jan#","Ene",$texto);
	$texto = preg_replace("#Apr#","Abr",$texto);
	$texto = preg_replace("#Aug#","Ago",$texto);
	$texto = preg_replace("#Dec#","Dic",$texto);

	// reemplazo días
	$texto = preg_replace("#Monday#","Lunes",$texto);
	$texto = preg_replace("#Tuesday#","Martes",$texto);
	$texto = preg_replace("#Wednesday#","Miércoles",$texto);
	$texto = preg_replace("#Thursday#","Jueves",$texto);
	$texto = preg_replace("#Friday#","Viernes",$texto);
	$texto = preg_replace("#Saturday#","Sábado",$texto);
	$texto = preg_replace("#Sunday#","Domingo",$texto);

	// reemplazo dias cortos
	$texto = preg_replace("#Mon#","Lun",$texto);
	$texto = preg_replace("#Tue#","Mar",$texto);
	$texto = preg_replace("#Wed#","Mié",$texto);
	$texto = preg_replace("#Thu#","Jue",$texto);
	$texto = preg_replace("#Fri#","Vie",$texto);
	$texto = preg_replace("#Sat#","Sáb",$texto);
	$texto = preg_replace("#Sun#","Dom",$texto);

	return $texto;
}


function ObetenerTextoMes($m) {
	switch ($m) {
		case 1: $month_text = "Enero"; break;
		case 2: $month_text = "Febrero"; break;
		case 3: $month_text = "Marzo"; break;
		case 4: $month_text = "Abril"; break;
		case 5: $month_text = "Mayo"; break;
		case 6: $month_text = "Junio"; break;
		case 7: $month_text = "Julio"; break;
		case 8: $month_text = "Agosto"; break;
		case 9: $month_text = "Septiembre"; break;
		case 10: $month_text = "Octubre"; break;
		case 11: $month_text = "Noviembre"; break;
		case 12: $month_text = "Diciembre"; break;
	}
	return ($month_text);
}




/*------------------------------------------------------------------------------------*/
/*------------------------------------------------------------------------------------*/
/*------------------------------------------------------------------------------------*/

class cMenuDinamico
{
	var $conexionobjeto;
	var $msg_error;
	var $es_admin;

	var $pagcod;
	var $con_link = true;
	var $idioma="ESP";
	var $accion="";
	var $pagcodbusqueda="";

	var $carpetadireccion = "";

	function cMenuDinamico($es_admin=false)
	{
		$this->conexionobjeto = new accesoBDPortal(SERVIDORBD,USUARIOBD,CLAVEBD);
		$this->conexionobjeto->SeleccionBD(BASEDATOS);
		$this->msg_error = "";
		$this->es_admin = $es_admin;
	}

	function Setear($parametros)
	{
		if(isset($parametros['PaginaDefault']) && $parametros['PaginaDefault']!="")
			$this->pagcod=$parametros['PaginaDefault'];
		elseif (isset($_GET['pagina']))
			$this->pagcod=$_GET['pagina'];


		if(isset($parametros['PaginaSeleccionar']) && $parametros['PaginaSeleccionar']!="")
			$this->pagcodbusqueda=$parametros['PaginaSeleccionar'];

		$this->accion = $parametros['Subtipo'];

		if(isset($parametros['CarpetaOrigen']) && $parametros['CarpetaOrigen']!="")
			$this->carpetadireccion = $parametros['CarpetaOrigen'];

		return true;
	}

	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		$ruta=array();
		//print_r($this);
		switch($this->accion)
		{
			case 'MenuSuperiorMasHijos':
				$spnombre="sel_paginas_xpagcod";
				$spparam=array("ppagcod"=>$this->pagcod);
				if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
				{
						$filapagina=mysqli_fetch_assoc($query);
						$pagcodarbol = $this->pagcod;
						if ($filapagina['pagoriginal']!="")
							$pagcodarbol = $filapagina['pagoriginal'];

						$arregloarbol = array();

						if(!$this->ArmarArbolSuperior($pagcodarbol,$arregloarbol))
							return false;

						$menusuperior="";
						foreach($arregloarbol as $pagcod => $arreglopaginas)
						{
							$ultimonivel=0;
							$nivelseleccion = -1;
							if(!$this->_MostrarRamaSuperior($arreglopaginas,0,$nivelseleccion,$ultimonivel,$menusuperior))
								return false;
						}
						$salida.="<div class=\"menulateral\">".chr(13);
						$salida.=$menusuperior;
						$salida.="</div>".chr(13);
				}
			break;

			case 'MenuHijos':
				/*RESUELTO OBJETO DINAMICO*/

				$spnombre="sel_paginas_xpagcod";
				$spparam=array("ppagcod"=>$this->pagcod);
				if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
				{
					$filapagina=mysqli_fetch_assoc($query);

					if(!$this->_MostrarHijos($this->pagcod,0,$ruta))
						return false;

					$rutastr=implode("  ",$ruta);
					$salida.="<h3>";
					$salida.="<a href='".$this->carpetadireccion."paginas.dhtml?pagina=".$filapagina['pagcod']."' title=\"Link a ".$filapagina["pagtitle"]."\">".$filapagina["pagnomarbol"]."</a>".chr(13);
					$salida.="</h3>";
					$salida.="<div class=\"menulateral\">".chr(13);
					$salida.=$rutastr.chr(13);
					$salida.="</div>".chr(13);
				}
			break;

			case 'MenuSeleccion':
				if(!$this->_BuscarSuperior($this->pagcod,$pagcodsuperior))
					return false;

				$spnombre="sel_paginas_xpagcod";
				$spparam=array("ppagcod"=>$pagcodsuperior);


				if ($pagcodsuperior == $this->pagcodbusqueda)
					$salida.=" class=\"seleccionado\" ";
				elseif($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
				{
					$datospagsuperior = mysqli_fetch_assoc($query);

					if ($datospagsuperior['pagoriginal']!="")
						$pagcodsuperior = $datospagsuperior['pagoriginal'];

					if ($pagcodsuperior == $this->pagcodbusqueda)
						$salida.=" class=\"seleccionado\" ";
				}
			break;


			case 'MapaSitio':
				$spnombre="sel_paginas_xpagcod";
				$spparam=array("ppagcod"=>$this->pagcod);
				if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
				{
					$filapagina=mysqli_fetch_assoc($query);
					$salida.="<div class=\"mapasitio clearfix\">";
					$salida.="<ul class=\"clearfix\">";
					$salida.="<li class=\"titulo\">".chr(13);
					$salida.="<a href='".$this->carpetadireccion."paginas.dhtml?pagina=".$filapagina['pagcod']."' title=\"Link a ".$filapagina["pagtitle"]."\">".$filapagina["pagnomarbol"]."</a>".chr(13);
					$arreglohijos = array();
					if (!$this->ArmarArbol($this->pagcod,$arreglohijos))
						return false;
					$ultimonivel=0;
					$menusuperior="";
					$nivelseleccion = -1;
					if(!$this->_MostrarRamaSuperior($arreglohijos,0,$nivelseleccion,$ultimonivel,$menusuperior))
						return false;
					if ($menusuperior!="")
					{
						$salida.="<div>".chr(13);
						$salida.=$menusuperior;
						$salida.="</div>".chr(13);
					}
					$salida.="</li>".chr(13);
					$salida.="</ul>".chr(13);
					$salida.="</div>".chr(13);
				}
			break;
		}
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}


	function ArmarArbolSuperior($pagcod,&$arregloarbol)
	{
		$spnombre="sel_paginas_xpagcod";
		$spparam=array("ppagcod"=>$pagcod);
		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filapagina=mysqli_fetch_assoc($query);
			$spparam=array("ppagcod"=>$pagcod);
			$spparam+=array("pporderby"=>"pagordenmenu, pagnomarbol");
			if ($this->es_admin)
			{
				$spnombre="sel_paginas_pagsuperior_modif";
			}else
			{
				$spnombre="sel_paginas_pagsuperior_activas";
				$spparam += array("ppagestado"=>70);
			}
			if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) && $numfilas!=0)
			{
				while($fila = mysqli_fetch_assoc($resultado))
				{
					$pagcod = $filapagina['pagcod'];
					if ($this->es_admin)
					{
						if ($filapagina['pagcopiadoen']!="")
							$pagcod = $filapagina['pagcopiadoen'];
					}
					$arregloarbol[$pagcod][$fila['pagcod']] = $fila;
					if (array_key_exists($fila['pagcod'],$arregloarbol))
					{
						$arregloarbol[$pagcod][$fila['pagcod']]['subarbol'] = $arregloarbol[$fila['pagcod']];
						unset($arregloarbol[$fila['pagcod']]);
					}
				}

			}
			if ($filapagina['pagsuperior']!="")
			{
				$superior = $filapagina['pagsuperior'];
				if ($this->es_admin)
				{
					if ($filapagina['pagoriginal']!="")
						$superior = $filapagina['pagoriginal'];
				}
				if (!$this->ArmarArbolSuperior($superior,$arregloarbol))
					return false;
			}
		}

		return true;
	}


	function _MostrarRamaSuperior($arreglopaginas,$nivel,&$nivelseleccion,&$ultimonivel,&$menusuperior)
	{

		if (count($arreglopaginas)>0)
		{
			$menusuperior.="<ul class=\"clearfix\">";
			$i=1;
			foreach ($arreglopaginas as $paginas)
			{
				$borde = "";
				if ($nivel==$ultimonivel)
				{
					if (count($arreglopaginas)==1)
					{
						if (array_key_exists("subarbol",$paginas) && count($paginas['subarbol'])>0)
							$ultimonivel++;
						else
							$borde = " style=\"border:none;\"";
					}elseif($i==count($arreglopaginas))
					{
						$mostrarborde = false;
						if (array_key_exists("subarbol",$paginas))
						{
							foreach($paginas['subarbol'] as $hijos)
							{
								if ($hijos['pagcodcargamenu']==1)
									$mostrarborde = true;
							}
						}
						if ((!array_key_exists("subarbol",$paginas) || count($paginas['subarbol'])==0) || !$mostrarborde)
							$borde = " style=\"border:none;\"";
						else
							$ultimonivel++;
					}

				}

				$mostrarmenu = true;
				$paginaseleccion = $this->pagcod;

				if ($mostrarmenu)
				{
					//if (array_key_exists("subarbol",$paginas) && count($paginas['subarbol'])>0)
						//$seleccion = " class=\"seleccionado\"";
					//else
					$seleccion = "";

					if ($paginaseleccion==$paginas['pagcod'])
					{
						//$seleccion = " class=\"seleccionado hijos\"";
						$seleccion = " class=\"seleccionado\"";
						$nivelseleccion = $nivel;
					}

					if ($nivel!=0 && $nivelseleccion==0 && $nivelseleccion!=-1)
						$seleccion = " class=\"seleccionadohijos\"";

					//if ($paginaseleccion == $paginas['pagcod'])
						//$seleccion = " class=\"seleccionado\"";

					$menusuperior.="<li>".chr(13);
					$menusuperior.="<a ".$seleccion." ".$borde." href='".$this->carpetadireccion."paginas.dhtml?pagina=".$paginas['pagcod']."' title=\"Link a ".$paginas["pagtitle"]."\">".$paginas["pagnomarbol"]."</a>".chr(13);

					if (array_key_exists("subarbol",$paginas) && count($paginas['subarbol'])>0)
					{
						$nivel++;
						if ($paginas["pagcodcargamenuinf"]==1)
							if (!$this->_MostrarRamaSuperior($paginas['subarbol'],$nivel,$nivelseleccion,$ultimonivel,$menusuperior))
								return false;
						$nivel--;
					}
					$i++;
					$menusuperior.="</li>";
				}
			}
			$menusuperior.="</ul>";
		}
		return true;

	}


	function ObtenerNivel($pagcod,&$nivel)
	{
		$spnombre="sel_paginas_xpagcod";
		$spparam=array("ppagcod"=>$pagcod);
		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filapagina=mysqli_fetch_assoc($query);
			if ($filapagina['pagsuperior']!="")
			{
				$nivel++;
				if (!$this->ObtenerNivel($filapagina['pagsuperior'],$nivel))
					return false;
			}
		}
		return true;
	}


	function _MostrarHijos($pagcod,$orden,&$ruta,$borrarborde=true)
	{
		if(is_null($pagcod) || $pagcod=="")
			return true;

		$spparam=array("ppagcod"=>$pagcod);
		$spparam+=array("pporderby"=>"pagordenmenu, pagnomarbol");
		if ($this->es_admin)
		{
			$spnombre="sel_paginas_pagsuperior_modif";
		}else
		{
			$spnombre="sel_paginas_pagsuperior_activas";
			/*PAGPUB = 70*/
			$spparam += array("ppagestado"=>70);
		}

		$primero = true;
		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas!=0)
		{
			if ($primero && $numfilas>0)
				$ruta[]="<ul>".chr(13);

			$contador = 1;
			while($filapagina=mysqli_fetch_assoc($query))
			{
				if ($borrarborde)
				{
					$borde = "";
					if ($contador==$numfilas)
						$borde = " style=\"border:none;\"";
				}
				$ruta[]="<li><a ".$borde." href='".$this->carpetadireccion."paginas.dhtml?pagina=".$filapagina['pagcod']."'>".$filapagina["pagnomarbol"]."</a></li>".chr(13);
				$contador++;
			}
			if ($primero && $numfilas>0)
			{
				$primero = false;
				$ruta[]="</ul>".chr(13);
			}
		} // Fin de encontró la pagina

		return true;

	}

	function _BuscarSuperior($pagcod,&$superior)
	{
		if(is_null($pagcod) || $pagcod=="")
			return true;

		$spnombre="sel_paginas_xpagcod";
		$spparam=array("ppagcod"=>$pagcod);

		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas==1)
		{
			$filapagina=mysqli_fetch_assoc($query);
			$superior = $pagcod;
			if(!$this->_BuscarSuperior($filapagina["pagsuperior"],$superior))
				return false;


		} // Fin de encontró la pagina
		else
		{
			$this->msg_error.="El código de página es inexistente o contiene un error. Pagina: ".$this->pagcod."<br>";
			return false;
		}

		return true;

	}



	function ArmarArbol($pagcod,&$arreglo)
	{
		if(is_null($pagcod) || $pagcod=="")
			return true;

		$spparam=array("ppagcod"=>$pagcod);
		$spparam+=array("pporderby"=>"pagordenmenu, pagnomarbol");
		if ($this->es_admin)
		{
			$spnombre="sel_paginas_pagsuperior_modif";
		}else
		{
			$spnombre="sel_paginas_pagsuperior_activas";
			$spparam += array("ppagestado"=>70);
		}


		if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas!=0)
		{
			while($filapagina=mysqli_fetch_assoc($query))
			{
				$pagcodhijo = $filapagina['pagcod'];
				$arreglo[$pagcodhijo] = $filapagina;
				$arreglo[$pagcodhijo]['subarbol'] = array();
				if (!$this->ArmarArbol($pagcodhijo,$arreglo[$pagcodhijo]['subarbol']))
					return false;
			}
		} // Fin de encontró la pagina

		return true;
	}





}



/*------------------------------------------------------------------------------------*/
/*------------------------------------------------------------------------------------*/
/*------------------------------------------------------------------------------------*/


class cNoticiasDinamicas
{

	var $conexionobjeto;
	var $msg_error;
	var $es_admin;

	var $pagcod;
	var $con_link = true;
	var $idioma="ESP";
	var $accion = "";
	var $accion_interna = "";
	var $cantidad_noticias = 10;
	var $notcod;
	var $mes;
	var $anio;
	var $temapagina = 0;
	var $noticiaaprobada = 70;
	var $noticiabaja = 90;
	var $comentarios = "";


	var $cantidadpaginar = 10;
	var $paginaactual = 1;


	var $arreglotitulos;
	var $tituloruta;
	var $mostrarcantidad = true;

	var $visualizcod = "";

	function cNoticiasDinamicas($es_admin=false)
	{
		$this->conexionobjeto = new accesoBDPortal(SERVIDORBD,USUARIOBD,CLAVEBD);
		$this->conexionobjeto->SeleccionBD(BASEDATOS);
		$this->msg_error = "";
		$this->es_admin = $es_admin;
	}

	function Setear($parametros)
	{

		if (isset($parametros['pagina']))
			$this->pagcod = $parametros['pagina'];
		elseif(isset($_GET['pagina']))
			$this->pagcod = $_GET['pagina'];

		if (isset($parametros['paginaMasInfo']))
			$this->pagcodMasInfo = $parametros['paginaMasInfo'];

		if (isset($_GET['paginado']))
			$this->paginaactual = $_GET['paginado'];

		if (isset($parametros['SubTipo']))
			$this->accion = $parametros['SubTipo'];

		if (isset($parametros['Cantidad']))
			$this->cantidad_noticias = $parametros['Cantidad'];

		if (isset($parametros['Titulo']))
			$this->arreglotitulos['Titulo'] = $parametros['Titulo'];
		else
			$this->arreglotitulos['Titulo'] = "Noticias";

		if (isset($parametros['TituloCorto']))
			$this->arreglotitulos['TituloCorto'] = $parametros['TituloCorto'];
		else
			$this->arreglotitulos['TituloCorto'] = "Noticia";

		if (isset($parametros['TituloAmpliado']))
			$this->arreglotitulos['TituloAmpliado'] = $parametros['TituloAmpliado'];
		else
			$this->arreglotitulos['TituloAmpliado'] = "Noticia Ampliada";

		if (isset($parametros['TituloRuta']))
			$this->arreglotitulos['TituloRuta'] = $parametros['TituloRuta'];
		else
			$this->arreglotitulos['TituloRuta'] = "Prensa";

		if (isset($parametros['MostrarCantidad']) && $parametros['MostrarCantidad']==0)
			$this->mostrarcantidad = false;

		if(isset($parametros['VisualizacionAmpliada']))
           	$this->visualizcod = $parametros['VisualizacionAmpliada'];

        if(isset($parametros['Visualizacion']))
           	$this->visualizcod = $parametros['Visualizacion'];

		// if (isset($parametros['Tema']) && $parametros['Tema']==1)
		//	$this->temapagina = 1;

		// Cambio x filtro de noticias Breves
		// Lo dejo igual por los otros sitios (aunque no deberia fijarse el tema 1) solo lo cambio
		// para caundo viene otro tema y debe fitrarse por él
		if (isset($parametros['Tema'])) {
	       if($parametros['Tema']==1)
	          $this->temapagina = 1;
	        else
	          $this->temapagina = $parametros['Tema'];
	    } else {
	          $this->temapagina ="-1";
	    }

		if (isset($_GET['anio']))
		{
			$this->anio = $_GET['anio'];
			if(!FuncionesPHPPortal::ValidarContenido($this->conexionobjeto,$this->anio,"NumericoEntero"))
				$this->anio = date("Y");

			if ($this->anio>date("Y"))
				$this->anio = date("Y");
			if ($this->anio<2007)
				$this->anio=date("Y");
		}
		if (isset($_GET['mes']))
		{
			$this->mes = $_GET['mes'];
			if(!FuncionesPHPPortal::ValidarContenido($this->conexionobjeto,$this->mes,"NumericoEntero"))
				$this->mes = "";
			if ($this->mes<1 || $this->mes>12)
				$this->mes = "";
		}
		if (isset($_GET['notcod']))
			$this->notcod = $_GET['notcod'];

		$this->accion_interna = "UltimasActivas";

		if (isset($_GET['notcod']) && $this->accion=="UltimasNoticias") {
			$this->accion = "NoticiaAmpliada";

			// Aca próxima actualizacion automata XXX
			// para que considere la visualizacion en la noticia ampliada
			// if (isset($parametros['VisualizacionAmpliada']))
			//	$this->visualizcod = $parametros['VisualizacionAmpliada'];

		}
		elseif ((isset($_GET['mes']) || isset($_GET['anio'])) && $this->accion=="UltimasNoticias")
			$this->accion_interna = "NoticiasxMesAnio";

		return true;
	}

	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		$ruta=array();

		$paginarresultados = false;

		switch($this->accion)
		{
			case 'UltimasNoticias':
				switch($this->accion_interna){

					case "UltimasActivas":
						$spnombre="sel_noticias_xestado_xcantidadfija";
						$spparam=array("pnotestado"=>$this->noticiaaprobada);
						$spparam+=array("pxnotestado"=>1);
						$spparam+=array("pxnotestadodistinto"=>1);
						$spparam+=array("pxnotadmin"=>0);
						$spparam+=array("pxestadotemacod"=>0);
						$spparam+=array("ptemacod"=>"-1");
						if ($this->temapagina==1)
						{
							if(!$this->conexionobjeto->TraerCampo("temas_paginas","temacod",array("pagcod='",$this->pagcod,"'"),$temacod,$numfilastema,$errno))
								return false;
							$spparam['pxestadotemacod'] = 1;
							$spparam['ptemacod'] = $temacod;
						}
						if ($this->es_admin)
						{
							$spparam['pxnotestado']=0;
							$spparam['pxnotadmin']=1;

						}
						$spparam+=array("pnotestadodistinto"=>$this->noticiabaja);
						$spparam+=array("porderby"=>"notdestacada DESC, notfechapub DESC, notorden ASC");
						$spparam+=array("pcantidadnoticias"=>$this->cantidad_noticias);
						$salida .= "<h1>".$this->arreglotitulos['Titulo']."</h1>";
					break;
					case "NoticiasxMesAnio":

						$spnombre="sel_noticias_xestado_xmes_anio_ordenadas";
						$spparam=array("pnotestado"=>$this->noticiaaprobada);
						$spparam+=array("pxnotestado"=>1);
						$spparam+=array("pxnotestadodistinto"=>1);
						$spparam+=array("pxnotadmin"=>0);
						$spparam+=array("pxestadotemacod"=>0);
						$spparam+=array("ptemacod"=>"-1");
						if ($this->temapagina==1)
						{
							if(!$this->conexionobjeto->TraerCampo("temas_paginas","temacod",array("pagcod='",$this->pagcod,"'"),$temacod,$numfilastema,$errno))
								return false;
							$spparam['pxestadotemacod'] = 1;
							$spparam['ptemacod'] = $temacod;
						}

						if ($this->es_admin)
						{
							$spparam['pxnotestado']=0;
							$spparam['pxnotadmin']=1;
						}
						$spparam+=array("pnotestadodistinto"=>$this->noticiabaja);
						$spparam+=array("porderby"=>"notfechapub DESC, notorden ASC");
						$spparam+=array("pnotfechapubmes"=>$this->mes);
						$spparam+=array("pestadomes"=>0);
						if ($this->mes!="")
							$spparam["pestadomes"]=1;

						$spparam+=array("pestadoanio"=>0);
						if ($this->anio!="")
							$spparam["pestadoanio"]=1;

						$spparam+=array("pnotfechapubanio"=>$this->anio);

						$aniosel = date("Y");
						if ($this->anio!="")
							$aniosel = $this->anio;
						if ($this->mes!="")
						{
							$texto = ObetenerTextoMes($this->mes);
							$salida .= "<h1>".$this->arreglotitulos['Titulo']." de ".$texto." de ".htmlspecialchars($aniosel,ENT_QUOTES)."</h1>";
						}elseif ($this->anio!="")
							$salida .= "<h1>&Uacute;ltimas ".$this->arreglotitulos['Titulo']." del ".htmlspecialchars($aniosel,ENT_QUOTES)."</h1>";


						if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$canttotal,$errno))
							return false;

						$spnombre="sel_noticias_xestado_xmes_anio_ordenadas_limitadas";
						$spparam+=array("paginicio"=>0);
						$spparam+=array("pagfin"=>$canttotal);


						if ($canttotal > $this->cantidadpaginar)
						{
							$i=1;
							$paginicio = 0;
							while ($i<=$this->paginaactual)
							{
								$pagfin = $this->cantidadpaginar * $i;
								$paginicio = $pagfin - $this->cantidadpaginar;
								$i++;
							}
							$spparam["paginicio"] = 0;
							if ($paginicio<$canttotal)
								$spparam["paginicio"] = $paginicio;
							$spparam["pagfin"] = $this->cantidadpaginar;

							$ultimapagina = ceil($canttotal / $this->cantidadpaginar);

							if ($spparam["paginicio"]==0)
							{
								$paginasiguiente = 2;
								$paginaanterior = 1;
								$this->paginaactual = 1;
							}else
							{
								$paginasiguiente = $i;
								if ($paginasiguiente>$ultimapagina)
									$paginasiguiente = $ultimapagina;

								$paginaanterior = $i - 2;
								if ($paginaanterior<1)
									$paginaanterior = 1;
							}
							$paginarresultados = true;
						}
					break;
				}

				if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
				{
					if ($numfilas==0)
					{
						$salida .= "<div class=\"noticia_msg msg_accion clearfix\">";
						$salida .= "Sin ".$this->arreglotitulos['Titulo']." Cargadas";
						$salida .= "</div>";
					}
					while($filanoticia=mysqli_fetch_assoc($query))
					{

						$textofecha = $this->ObtenerTextoFecha($filanoticia['notfechapub']);

						if(!is_null($filanoticia["imgcod"]))
						{
							$spnombre="sel_noticias_imagenes_ximgcod";
							$spparam=array("pimgcod"=>$filanoticia["imgcod"]);

							if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$queryimg,$numfilasimg,$errno) || $numfilasimg!=1)
							{
								$this->msg_error.="Imagen error. Notcod: ".$this->notcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
								return false;
							}
							$filaimagen=mysqli_fetch_assoc($queryimg);
							$imgubic = $filaimagen['imgubic'];
						}else
							$imgubic = "img/prensa_generico.jpg";

						$imgubic = FuncionesPHPPortal::ConvertirStringParaURL($imgubic);

						$destacada = false;
						if ($filanoticia['notdestacada']==1)
							$destacada = true;

/* Deberia usar una visualización, y deberia modificarse el objeto
 * Si de ultimasnoticias vengo con mes o año, NoticiasxMesAnio deberia
 * tener una visualizacion tambien - no se si asumir los titulos.
 * if ($this->visualizcod!="")
						{
							$parametros["pagcod"] = $this->pagcod;
							$parametros["notcod"] = $filanoticia['notcod'];
							$parametros["visualizcod"] = $this->visualizcod;
							$parametros["parametros"] = array();
							$parametros["datoid"] = "";
							$parametros["ordennoticia"] = 1;
							$parametros["modifnotic"] = 1;
							$oVisualizaNoticia->Setear($parametros);
							$oVisualizaNoticia->Mostrar($salida,$noticiasmostradas);
						}else {
 *
 */
						/* No esta usando visualización para el listado de noticias x mes o año */
						$salida .= "<div class=\"listultimasnoticias\">";
						$salida .= "	<div class=\"noticia clearfix\">";
						$salida .= "		<div class=\"imagen_noticia\">";
						$salida .= "			<img src=\"".$imgubic."\" alt=\"Im&aacute;gen de ".$this->arreglotitulos['TituloCorto']."\" />\n";
						$salida .= "		</div>";
						$salida .= "		<div class=\"texto_noticia\">";

						if ($destacada)
							$salida .= "<div class=\"titulo_destacado\">";

						$salida .= "			<h2><span class=\"fechapublicacion\">".$textofecha." - </span>".htmlspecialchars($filanoticia['notdesccorta'],ENT_QUOTES);

						if ($destacada)
							$salida .= "			- <span class=\"destacada\">".$this->arreglotitulos['TituloCorto']." DESTACADA</span>";

						$salida .= "			</h2>";

						if ($destacada)
							$salida .= "</div>";


						$copete = htmlspecialchars($filanoticia['notcopete'],ENT_QUOTES);
						if (strlen($filanoticia['notcopete'])>280)
							$copete = substr(htmlspecialchars($filanoticia['notcopete'],ENT_QUOTES),0,280)."...";
						$salida .= "			<p>".$copete."</p>";
						$salida .= "			<div class=\"masinfo clearfix\">";
						$querystring = str_replace("&","&amp;",$_SERVER['QUERY_STRING']);
						$salida .= "				<a href=\"paginas.dhtml?".$querystring."&amp;notcod=".$filanoticia['notcod']."\" title=\"m&aacute;s informaci&oacute;n\">m&aacute;s informaci&oacute;n></a>";
						$salida .= "			</div>";
						$salida .= "		</div>";
						$salida .= "	</div>";
						$salida .= "</div>";
					}
				}
				$querystring = FuncionesPHPPortal::ArmarQueryString("paginado");
				$querystring = str_replace("&","&amp;",$querystring);
				if ($paginarresultados)
				{
					$salida .= "<div class=\"paginar\">";
					$salida .= "		<hr />";
					$salida .= "		<div class=\"botones_izq\">";
					$salida .= "			<a href=\"paginas.dhtml?".$querystring."&amp;paginado=1\" title=\"Primer P&aacute;gina\">&lt;&lt;</a>";
					$salida .= "			&nbsp;&nbsp;&nbsp;";
					$salida .= "			<a href=\"paginas.dhtml?".$querystring."&amp;paginado=".$paginaanterior."\" title=\"P&aacute;gina Anterior\">&lt;</a>";
					$salida .= "		</div>";
					$salida .= "		<div class=\"txt_cen bold\">";
					$salida .= "			p&aacute;gina ".$this->paginaactual." de ".$ultimapagina;
					$salida .= "		</div>";
					$salida .= "		<div class=\"botones_der\">";
					$salida .= "			<a href=\"paginas.dhtml?".$querystring."&amp;paginado=".$paginasiguiente."\" title=\"P&aacute;gina Siguente\">&gt;</a>";
					$salida .= "			&nbsp;&nbsp;&nbsp;";
					$salida .= "			<a href=\"paginas.dhtml?".$querystring."&amp;paginado=".$ultimapagina."\" title=\"&Uacute;ltima P&aacute;gina\">&gt;&gt;</a>";
					$salida .= "		</div>";
					$salida .= "		<div class=\"clear\"></div>";
					$salida .= "</div>";
				}
				break;

				case 'NoticiaAmpliada':

					if ($this->visualizcod!="")
					{
						$parametros["pagcod"] = $this->pagcod;
						$parametros["notcod"] = $this->notcod;
						$parametros["visualizcod"] = $this->visualizcod;
						$parametros["parametros"] = array();
						$parametros["datoid"] = "";
						$parametros["ordennoticia"] = 1;
						$parametros["modifnotic"] = 1;

						$oVisualizaNoticia = new cVisualizaNoticia($this->conexionobjeto,false,false);
						$oVisualizaNoticia->Setear($parametros);
						$oVisualizaNoticia->Mostrar($salida,$noticiasmostradas);

					}else
					{
						$salida .= "<h1 id='titnoticiaampliada'>".$this->arreglotitulos['TituloCorto']." Ampliada</h1>";
						$spnombre="sel_noticias_xnotcod";
						$spparam=array("pnotcod"=>$this->notcod);
						if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
						{
							$this->msg_error.="Noticias error. Notcod: ".$this->notcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
							return false;
						}
						if ($numfilas==1)
						{
							$filanoticia=mysqli_fetch_assoc($query);
							$se_visualiza = false;
							if ($this->es_admin)
							{
								if ($filanoticia['notestado']!=$this->noticiabaja)
									$se_visualiza = true;
							}else
							{
								if ($filanoticia['notestado']==$this->noticiaaprobada)
									$se_visualiza = true;
							}

							$destacada = false;
							if ($filanoticia['notdestacada']==1)
								$destacada = true;

							if ($se_visualiza)
							{
								$textofecha = $this->ObtenerTextoFecha($filanoticia['notfechapub']);
								$contieneimg = false;
								if(!is_null($filanoticia["imgcod"]))
								{
									$spnombre="sel_noticias_imagenes_ximgcod";
									$spparam=array("pimgcod"=>$filanoticia["imgcod"]);

									if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$queryimg,$numfilasimg,$errno) || $numfilasimg!=1)
									{
										$this->msg_error.="Imagen error. Notcod: ".$this->notcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
										return false;
									}
									$filaimagen=mysqli_fetch_assoc($queryimg);
									$imgubic = $filaimagen['imgubic'];
									$contieneimg = true;
								}else
									$imgubic = "/contenido/portal/img/logotipo_JGM.png";

								$contieneaudio = false;
								if ($filanoticia['notaudio']!="")
									$contieneaudio = true;

								$contienevideo = false;
								if ($filanoticia['notvideo']!="")
									$contienevideo = true;


								$contieneepigrafe = false;
								if ($filanoticia['notepigrafe']!="")
									$contieneepigrafe = true;
								$alt = "   ";
								if ($filanoticia['imgalt']!="")
									$alt = $filanoticia['imgalt'];

								$salida .= "<div class=\"noticia_ampliada clearfix\">";
								$salida .= "	<div class=\"noticia clearfix\">";
								$salida .= "		<div class=\"fechapublicacion bold\">".$textofecha."</div>";

								$salida .= "		<h2>".htmlspecialchars($filanoticia['notdesccorta'],ENT_QUOTES);
								if ($destacada)
									$salida .= "			- <span class=\"destacada\">".$this->arreglotitulos['TituloCorto']." DESTACADA</span>";
								$salida .= "</h2>";

								$salida .= "		<div class=\"copete\">";
								$salida .= "			<p>";
												cNoticiasDinamicas::ProcesarNoticia($filanoticia['notcopete'],$salida);
								$salida .= "			</p>";
								$salida .= "		</div>";

								if ($contieneimg)
								{
									$salida .= "		<div class=\"imagen_noticia\">";
									$salida .= "			<img src=\"".$imgubic."\" alt=\"".htmlspecialchars($alt,ENT_QUOTES)."\" />\n";
									if($contieneepigrafe)
									{
										$salida .= "		<div class=\"epigrafe\">";
										$salida .= "			".$filanoticia['notepigrafe']."\n";
										$salida .= "		</div>";
									}
									$salida .= "		</div>";
								}

								if (isset($filanoticia['notvideoyoutube']) && $filanoticia['notvideoyoutube']!="")
								{
									$salida .= $filanoticia['notvideoyoutube'];
								}

								if($contienevideo)
								{

									$salida .= '<div id="contenidovideonot_'.$filanoticia['notcod'].'"></div>'.chr(13);
									$salida .= '<script type="text/javascript">'.chr(13);
									$salida .= ' var so = new SWFObject("player/video.swf?ruta=../'.$filanoticia['notvideo'].'", "mymovie", "500", "450", "7", "#EBF8FF")'.chr(13);
									$salida .= ' so.addParam("movie", "player/video.swf?ruta=../'.$filanoticia['notvideo'].'")'.chr(13);
									$salida .= ' so.addParam("autoSize", "false");'.chr(13);
									$salida .= ' so.addParam("mantainAspectRadio", "false");'.chr(13);
									$salida .= ' so.addParam("wmode", "transparent");'.chr(13);
									$salida .= ' so.write("contenidovideonot_'.$filanoticia['notcod'].'");'.chr(13);
									$salida .= ' </script>'.chr(13);

									$salida .= '<noscript>'.chr(13);
									$salida .= ' <object type="application/x-shockwave-flash" data="player/video.swf?ruta=../'.$filanoticia['notvideo'].'"  width="500" height="450">'.chr(13);
									$salida .= ' <param name="movie" value="player/video.swf?ruta=../'.$filanoticia['notvideo'].'" />'.chr(13);
									$salida .= ' <param name="quality" value="high" />'.chr(13);
									$salida .= ' <param name="autoSize" value="false" />'.chr(13);
									$salida .= ' <param name="mantainAspectRadio" value="false" />'.chr(13);
									$salida .= ' <param name="wmode" value="transparent" />'.chr(13);
									$salida .= ' </object>'.chr(13);
									$salida .= ' </noscript>'.chr(13);

								}

								if($contieneaudio)
								{

									$salida .= '<div class="solapa_audio"><h3>Audio</h3>'.chr(13);
									$salida .= '<div id="contenidosonidonot_'.$filanoticia['notcod'].'"></div>'.chr(13);
									$salida .= '<script type="text/javascript">'.chr(13);
									$salida .= ' var so = new SWFObject("player/player-sonido.swf?soundFile='.$filanoticia['notaudio'].'", "mymovie", "460", "24", "7", "#EBF8FF")'.chr(13);
									$salida .= ' so.addParam("movie", "player/player-sonido.swf?soundFile='.$filanoticia['notaudio'].'")'.chr(13);
									$salida .= ' so.addParam("quality", "high");'.chr(13);
									$salida .= ' so.addParam("menu", "true");'.chr(13);
									$salida .= ' so.addParam("wmode", "transparent");'.chr(13);
									$salida .= ' so.addParam("true", "titles");'.chr(13);
									$salida .= ' so.write("contenidosonidonot_'.$filanoticia['notcod'].'");'.chr(13);
									$salida .= ' </script>'.chr(13);

									$salida .= '<noscript>'.chr(13);
									$salida .= '<object data="player/player-sonido.swf?soundFile='.$filanoticia['notaudio'].'" ';
									$salida .= ' type="application/x-shockwave-flash" height="24" width="460">'.chr(13).'<param value="player/player-sonido.swf?soundFile='.$filanoticia['notaudio'].'" name="movie" />'.chr(13);
									$salida .= ' <param value="high" name="quality" />'.chr(13);
									$salida .= ' <param value="true" name="menu" />'.chr(13);
									$salida .= ' <param value="transparent" name="wmode" />'.chr(13);
									$salida .= ' <param value="true" name="titles" />'.chr(13);
									$salida .= ' <param value="false" name="animation" />'.chr(13);
									$salida .= ' </object>	';
									$salida .= ' </noscript>'.chr(13);
									$salida .= ' </div>'.chr(13);
								}

								$salida .= "		<div class=\"descripcion_noticia\">";
								cNoticiasDinamicas::ProcesarNoticia($filanoticia['notdesclarga'],$salida);
								$salida .= "		</div>";
								$salida .= "	</div>";
								$salida .= "		<div class=\"volver\">";
								$salida .= "			<a href=\"javascript:history.back();\" title=\"Volver Atr&aacute;s\">< volver atr&aacute;s</a>";
								$salida .= "		</div>";
								$salida .= "</div>";
							}else
							{
								$salida .= "<div class=\"noticia_msg msg_error  clearfix\">";
								$salida .= "Error, ".strtolower($this->arreglotitulos['TituloCorto'])." inexistente";
								$salida .= "</div>";
							}
						}else
						{
							$salida .= "<div class=\"noticia_msg msg_error  clearfix\">";
							$salida .= "Error, ".strtolower($this->arreglotitulos['TituloCorto'])." inexistente";
							$salida .= "</div>";
						}
					}
					break;


				case 'ListadoNoticiasBreves':

				$spnombre="sel_noticias_xestado_xcantidadfija";
				$spparam=array("pnotestado"=>$this->noticiaaprobada);
				$spparam+=array("pxnotestado"=>1);
				$spparam+=array("pxnotestadodistinto"=>1);
				$spparam+=array("pxnotadmin"=>0);
				//$spparam+=array("pxestadotemacod"=>0);
				//$spparam+=array("ptemacod"=>"-1");

				// Cambio lo dejo igual para el tema = 1 por efectos en otros sitios u otros usos
				if ($this->temapagina==-1) {
					$spparam+=array("pxestadotemacod"=>0);
					$spparam+=array("ptemacod"=>"-1");
				} else {
					$spparam+=array("pxestadotemacod"=>1);
					$spparam+=array("ptemacod"=>$this->temapagina);
				}

				// No de deberia ser así lo dejo por los otros sitios que puedan estar usandolo mal
				if ($this->temapagina==1)
				{
					if(!$this->conexionobjeto->TraerCampo("temas_paginas","temacod",array("pagcod='",$this->pagcod,"'"),$temacod,$numfilastema,$errno))
