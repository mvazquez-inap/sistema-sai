//-----------------------------------------------------------------------------------------------------	
	function BuscarPoc($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxpoc_ano'=>0);
		$sparam+=array('pxpoc_codigo'=>0);
		$sparam+=array('pxjurisdid_inap'=>0);
		$sparam+=array('pxpoc_estado'=>0);
		
		$sparam+=array('ppoc_ano' =>"");
		$sparam+=array('ppoc_codigo' =>"");
		$sparam+=array('pjurisdid_inap' =>"");
		$sparam+=array('ppoc_estado' =>"-1");
		$sparam+=array('porderby' =>"poc_ano");

		if (isset ($ArregloDatos['poc_ano']))
		{
			if ($ArregloDatos['poc_ano']!="")
			{	
				$sparam['ppoc_ano']= $ArregloDatos['poc_ano'];
				$sparam['pxpoc_ano']= 1;
			}
		}
		if (isset ($ArregloDatos['poc_codigo']))
		{
			if ($ArregloDatos['poc_codigo']!="")
			{	
				$sparam['ppoc_codigo']= $ArregloDatos['poc_codigo'];
				$sparam['pxpoc_codigo']= 1;
			}
		}	

		if (isset ($ArregloDatos['jurisdid_inap']))
		{
			if ($ArregloDatos['jurisdid_inap']!="")
			{	
				$sparam['pjurisdid_inap']= $ArregloDatos['jurisdid_inap'];
				$sparam['pxjurisdid_inap']= 1;
			}
		}
		
		if (isset ($ArregloDatos['poc_estado']))
		{
			if ($ArregloDatos['poc_estado']!="")
			{	
				$sparam['ppoc_estado']= $ArregloDatos['poc_estado'];
				$sparam['pxpoc_estado']= 1;
			}
		}
		
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}
	

		$spnombre="sel_poc_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			
			$error="Error al buscar el Poc.";
			$errormail="Error al buscar el Poc.".$errno;
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function TraerPoc($pocjuris,&$resultado)
	{
		$poc_estado1=POCNUEVO;
		$poc_estado2=POCRECHAZADO;
		$spnombre="sel_poc_xjurisdid_inap_xestado_nuevo_recha";
		$spparam =array('porderby'=>"poc_ano",'pjurisdid_inap'=>$pocjuris,'ppoc_estado1'=>$poc_estado1,'ppoc_estado2'=>$poc_estado2);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errorcod)) 
			return false;
		if($numfilas==0)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No existen POC aptos para pedir aprobación. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function ValidarRol($rol)
	{
		if ( ($rol!= COORDINADORTECNICO) && ($rol!= USUORGANISMO) )
			return false;
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function ValidarRolEvaluacionPoc($rol)
	{
		if ($rol!= USUACTJUR)
			return false;
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function AprobarPoc($poc_codigo,$juris,$rol)
	{
		if(!$this->PuedoAprobRecha($poc_codigo,$juris,$rol))
			return false;
			
		//Hacer el update del estado del poc
		$spnombre="upd_poc_estado";
		$spparam=array('ppoc_codigo'=>$poc_codigo, 
			   		  'pjurisdid_inap'=>$juris, 
					  'ppoc_estado'=>POCAPROBADO,
		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);
		//Aprobar todas las actividades relacionadas al poc
		if(!$this->AprobarActividadesPoc($poc_codigo,$juris))
			return false;

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\npoc_codigo='.$poc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar el POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function RechazarPoc($poc_codigo,$juris,$rol)
	{
		if(!$this->PuedoAprobRecha($poc_codigo,$juris,$rol))
			return false;
			
		//Hacer el update del estado del poc
		$spnombre="upd_poc_estado";
		$spparam=array('ppoc_codigo'=>$poc_codigo, 
			   		  'pjurisdid_inap'=>$juris, 
					  'ppoc_estado'=>POCRECHAZADO,
		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);
		
		//Las actividades relacionadas al poc quedarán en estado Nueva!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
		//No se modificara el estado de las actividades por mas que tenga que modificar el estado del poc a Rechazado.

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\npoc_codigo='.$poc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar el POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function AprobarActividadesPoc($poc_codigo,$juris)
	{
		$oPocActividad= new cPocActividad($this->conexion);
		$ArregloDatosAct['poc_codigo']=$poc_codigo;
		if(!$oPocActividad->BuscarPocActividad($ArregloDatosAct,$numfilas,$resultado,$error,$errormail))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar las Actividades del POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if($numfilas==0)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El POC no posee Actividades asociadas. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		while($filaact=mysqli_fetch_assoc($resultado))
		{
			//busco q la act tenga asociado al menos un obj.
			$oPocActividadPocObjetivo= new cPocActividadPocObjetivo($this->conexion);
			if(!$oPocActividadPocObjetivo->BuscarRelacionXPocActividad($filaact['pocact_codigo'],$query))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar las Actividades/Objetivos del POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			$cant=mysqli_num_rows($query);
			if($cant==0)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El POC no posee Actividades/Objetivos asociados. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			//si cumple con lo anterior, apruebo la actividad (modifico el estado)
			if(!$oPocActividad->AprobacionPocActividad($poc_codigo,$filaact['pocact_codigo'],$_SESSION['rolcod'],$juris))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al aprobar las Actividades del POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
		}
	return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function PedirAprobacionPoc($poc_codigo,$juris,$rol)
	{
		if(!$this->PuedoPedirAprob($poc_codigo,$juris,$rol))
			return false;
			
		//Hacer el update del estado del poc
		$spnombre="upd_poc_estado";
		$spparam=array('ppoc_codigo'=>$poc_codigo, 
			   		  'pjurisdid_inap'=>$juris, 
					  'ppoc_estado'=>POCPENDIENTEAPROBACION,
		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\npoc_codigo='.$poc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar el POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}

//-----------------------------------------------------------------------------------------------------	
	function CambiarEstadoPoc($datos)
	{
		if(!$this->PuedoCambiarEstado($datos["param_poc_codigo"],$datos["param_jurisdid_coordinacion"],$datos["poc_estado"]))
			return false;
			
		//Hacer el update del estado del poc
		$spnombre="upd_poc_estado";
		$spparam=array('ppoc_codigo'=>$datos["param_poc_codigo"],
			   		  'pjurisdid_inap'=>$datos["param_jurisdid_coordinacion"], 
					  'ppoc_estado'=>$datos["poc_estado"],
		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\npoc_codigo='.$datos["param_poc_codigo"];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar el estado del POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}
	
	
//-----------------------------------------------------------------------------------------------------	
	function PuedoCambiarEstado($poc_codigo,$juris,$estado)
	{
		//PuedoPedirAprob:
			//validar que el poc exista
			$ArregloDatos['poc_codigo']=$poc_codigo;
			if(!$this->BuscarPoc($ArregloDatos,$numfilas,$resultado,$error,$errormail))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar el POC",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			
			if ($juris == "")
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el organismo",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}	
			if ($estado == "")
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el estado",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}						
		return true;
	}
			
//-----------------------------------------------------------------------------------------------------	
	function PuedoPedirAprob($poc_codigo,$juris,$rol)
	{
		//PuedoPedirAprob:
			//validar q el poc exista
			$ArregloDatos['poc_codigo']=$poc_codigo;
			if(!$this->BuscarPoc($ArregloDatos,$numfilas,$resultado,$error,$errormail))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			//validar q el estado del poc sea nuevo o rechazado y sea de la juris de sesion
			if(!$this->Pocxcodigo($poc_codigo,$juris,$numfilas))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar el POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			if($numfilas!=1)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar el POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			//validar q el usuario tenga rol coord. tecnico o usu. organismo
			if(!$this->ValidarRol($rol))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al validar el rol del usuario. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			//validar q por lo menos tenga un obj y una actividad.
			$oPocActividad= new cPocActividad($this->conexion);
			$ArregloDatosAct['poc_codigo']=$poc_codigo;
			if(!$oPocActividad->BuscarPocActividad($ArregloDatosAct,$numfilas,$resultado,$error,$errormail))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar las Actividades del POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			if($numfilas==0)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El POC no posee Actividades asociadas. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			while($filaact=mysqli_fetch_assoc($resultado))
			{
				//busco q la act tenga asociado al menos un obj.
				$oPocActividadPocObjetivo= new cPocActividadPocObjetivo($this->conexion);
				if(!$oPocActividadPocObjetivo->BuscarRelacionXPocActividad($filaact['pocact_codigo'],$query))
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar las Actividades/Objetivos del POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
				$cant=mysqli_num_rows($query);
				if($cant==0)
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,
					"El POC posee Actividades sin Objetivos asociados. <br /><br /> La Actividad POC: ".$filaact['pocact_nombre_tentativo']. " no tiene Objetivos asosciados ".
					"<br /><br /><a href=\""."poc_actividad_poc_objetivo.dhtml?poc_codigo=".$filaact['poc_codigo']."&amp;pocact_codigo=".$filaact['pocact_codigo']."\" class=\"linkFondoBlanco\">Click Aqui para actualizar los Objetivos de la Actividad POC. </a>"
					,					
					array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
			}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function PuedoAprobRecha($poc_codigo,$juris,$rol)
	{
		//PuedoAprobRecha:
			//validar q el poc exista
			$ArregloDatos['poc_codigo']=$poc_codigo;
			if(!$this->BuscarPoc($ArregloDatos,$numfilas,$resultado,$error,$errormail))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			//validar q el estado del poc sea "con pedido de aprobacion" y sea de la juris de sesion
			if(!$this->PocxcodigoConPedAprob($poc_codigo,$juris,$numfilas))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar el POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			if($numfilas!=1)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar el POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			//validar q el usuario tenga rol USUACTJUR 
			if(!$this->ValidarRolEvaluacionPoc($rol))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al validar el rol del usuario. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			//validar q por lo menos tenga un obj y una actividad.
			$oPocActividad= new cPocActividad($this->conexion);
			$ArregloDatosAct['poc_codigo']=$poc_codigo;
			if(!$oPocActividad->BuscarPocActividad($ArregloDatosAct,$numfilas,$resultado,$error,$errormail))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar las Actividades del POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			if($numfilas==0)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El POC no posee Actividades asociadas. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			while($filaact=mysqli_fetch_assoc($resultado))
			{
				//busco q la act tenga asociado al menos un obj.
				$oPocActividadPocObjetivo= new cPocActividadPocObjetivo($this->conexion);
				if(!$oPocActividadPocObjetivo->BuscarRelacionXPocActividad($filaact['pocact_codigo'],$query))
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar las Actividades/Objetivos del POC. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
				$cant=mysqli_num_rows($query);
				if($cant==0)
				{	
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El POC no posee Actividades/Objetivos asociados. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
			}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function  ArmarMensajePedidoAprobacion($datos,&$mensaje) {
	// Debo armar el mensaje
		$result = true;
		// Debo traer la activ.
		$ArregloDatos['poc_codigo']=$datos['poc_codigo'];
		if(!$this->BuscarPoc($ArregloDatos,$numfilas,$resultado,$error,$errormail))  {
			$error="Error al buscar el POC.";
			$errormail="Error al buscar el POC en tabla poc\npoc_codigo=".$poc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$result =  false;
		}
		$filapoc=mysqli_fetch_assoc($resultado);
		$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filapoc['jurisdid_inap'],"'"),$jurisdnom,$numfilas,$errno);
		
		// con la actividad obtenida armo el mensaje
		if ($result) {
			$mensaje = " El Coordinador técnico o Usuario de Organismo ha solicitado la confirmación del siguiente POC: \n";
			$mensaje .= " Descripción:   ".$filapoc['poc_obs']."\n";	;	
			$mensaje .= " Año:   ".$filapoc['poc_ano']."\n";	
			$mensaje .= " Organismo:   ".$jurisdnom."\n";	;		
			
		}
		return $result;
	}	
//-----------------------------------------------------------------------------------------------------	
