	}

//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAsignarDisposicion($datos)	{

		if (!$datos["dis_codigo"]=="") {
			// Verifico que el número de disposicion exista.
			$oDisposicion = new cDisposicion($this->conexion);	
			$ArregloDatos=array();
			$ArregloDatos['dis_codigo']=$datos["dis_codigo"];
			if(!$oDisposicion->BuscarDisposicion($ArregloDatos,$numfilas,$result,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando la disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}				
			if ($numfilas != 1) {
				$txt_sys_mail="Error al buscar la disposición en Asignar Disposición.\ndis_codigo=".$datos['dis_codigo'];
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar la disposición",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}

		switch ($datos['tipoact_codigo']) 		{
			case TIPOACTCURSOINAP:
				$oActividad= new cActividadCursoInap($this->conexion);
				break;
			case TIPOACTCURSOINST:
				$oActividad= new cActividadCursoInstitucional($this->conexion);
				break;
			case TIPOACTCURSOJURISD:
				$oActividad= new cActividadCursoJurisdiccional($this->conexion);
				break;
			case TIPOACTEXTASIS:
				$oActividad= new cActividadExterna($this->conexion);
				break;	
			case TIPOACTAUTOEVASIS:
				$oActividad= new cActividadAutodesarrollo($this->conexion);
				break;	
		}
		
		if ($datos["dis_codigo"]=="") {
			// Si es curso institucional se puede desasignar y no se valida

			// Si es externa no tiene que tener agentes asignados
			if ($datos["tipoact_codigo"] == TIPOACTEXTASIS) {			
				$oActividadExternaPersona = new cActividadExternaPersona($this->conexion);
				$ArregloDatos=array();
				$ArregloDatos['act_codigo']=$datos["act_codigo"];
				$ArregloDatos['actprog_sec']=$datos["actprog_sec"];		
				if (!$oActividadExternaPersona->BuscarActividadAsignadaPersona($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
				if ($numfilas>=1) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se puede desasignar la disposición <br>porque la actividad tiene agentes acreditados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}			
			}
			
			// Si es curso inap o curso jurisdiccional
			// No tiene que tener ninguna comisión (de la programación a la cual se le asigna la diposición)
			// certificada  
			if ($datos["tipoact_codigo"] == TIPOACTCURSOINAP || $datos["tipoact_codigo"] == TIPOACTCURSOJURISD) {			
				$oComision=new cComision($this->conexion);
				$ArregloDatos=array();
				$ArregloDatos['act_codigo']=$datos["act_codigo"];
				$ArregloDatos['actprog_sec']=$datos["actprog_sec"];		
				$ArregloDatos['comi_estado']=COMISIONCERTIFICADA;						
						
				if (!$oComision->BuscarComision($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}

				if ($numfilas>=1) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se puede desasignar la disposición <br>porque la programación tiene comisiones certificadas.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
			} // curso inap o curso jurisdiccional
			
			if ($datos["tipoact_codigo"] == TIPOACTAUTOEVASIS) {	// revisar		
				$oActividadAutodesarrolloPersona = new cActividadAutodesarrolloPersona($this->conexion);
				$ArregloDatos=array();
				$ArregloDatos['act_codigo']=$datos["act_codigo"];
				$ArregloDatos['tipoact_codigo']=$datos["tipoact_codigo"];
				$ArregloDatos['actprog_sec']=$datos["actprog_sec"];		
				if (!$oActividadAutodesarrolloPersona->BuscarActividadAsignadaPersona($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}
				if ($numfilas>=1) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se puede desasignar la disposición <br>porque la actividad tiene agentes acreditados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					return false;
				}			
			} // Mero Asistente 
			
		}// ($datos["dis_codigo"]=="")

		$ArregloDatos=array();

		// Obtengo los dictamenes
		$ArregloDatos['act_codigo']=$datos['act_codigo'];
		$ArregloDatos['tipoact_codigo']=$datos['tipoact_codigo'];	
		$ArregloDatos['dic_codigo']=$datos['dic_codigo'];							
		$ArregloDatos['dic_estado']=DICTAMENACTIVO;			
		
		if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
			$txt_sys_mail="Error al buscar dictamen de la actividad.\nact_codigo=".$filaactividad['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 

		// tiene permiso
		if (!$this->TienePermisoAsignarDisposicion($datos['act_codigo'],$datos['actprog_sec'],$_SESSION['rolcod'])) {
			return false;
		}
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAsignarDisposicionPersonal($datos)	{

		if (!$datos["dis_codigo"]=="") {
			// Verifico que el número de disposicion exista.
			$oDisposicion = new cDisposicion($this->conexion);	
			$ArregloDatos=array();
			$ArregloDatos['dis_codigo']=$datos["dis_codigo"];
			if(!$oDisposicion->BuscarDisposicion($ArregloDatos,$numfilas,$result,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando la disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}				
			if ($numfilas != 1) {
				$txt_sys_mail="Error al buscar la disposición en Asignar Disposición.\ndis_codigo=".$datos['dis_codigo'];
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al buscar la disposición",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}


		$oActividad= new cActividadAutodesarrollo($this->conexion);
		
		if ($datos["dis_codigo"]=="") {
		
			// Si es curso inap o curso jurisdiccional
			// No tiene que tener ninguna comisión (de la programación a la cual se le asigna la diposición)
			// certificada  
			
			
		}// ($datos["dis_codigo"]=="")

		$ArregloDatos=array();

		// Obtengo los dictamenes
		$ArregloDatos['act_codigo']=$datos['act_codigo'];
		$ArregloDatos['tipoact_codigo']=$datos['tipoact_codigo'];	
		$ArregloDatos['dic_codigo']=$datos['dic_codigo'];							
		$ArregloDatos['dic_estado']=DICTAMENACTIVO;			
		
		if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
			$txt_sys_mail="Error al buscar dictamen de la actividad.\nact_codigo=".$filaactividad['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 

		// tiene permiso
		if (!$this->TienePermisoAsignarDisposicionPersonal($datos['dic_codigo'],$_SESSION['rolcod'])) {
			return false;
		}
		return true;
	}	
	
} // class
?>