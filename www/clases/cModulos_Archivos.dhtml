<?php
//----------------------------------------------------------------------------------------- 
class cModulos_Archivos extends cModulos  {
//-----------------------------------------------------------------------------------------
//							 PUBLICAS	
//----------------------------------------------------------------------------------------- 

//----------------------------------------------------------------------------------------- 
// Retorna una consulta con todos los usuarios que cumplan con las condiciones

// Parámetros de Entrada:
//		ArregloDatos: array asociativo con los filtros. Claves: usuarionombre, usuarioapellido, usuariocuit, usuarioemail

// Retorna:
//		numfilas,resultado: cantidad de filas y query de resultado
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function BuscarDatos ($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)
	{
		$sparam=array('pestadomodcod' =>0);
		$sparam+=array('pestadoarchcod' =>0);
	
		$sparam+=array('pmodulocod' =>"");
		$sparam+=array('parchivocod' =>"");

		$sparam+=array('porderby' =>"modulocod");

		if (isset ($ArregloDatos['modulocod']))
		{
			if ($ArregloDatos['modulocod']!="")
			{	
				$sparam['pmodulocod']= $ArregloDatos['modulocod'];
				$sparam['pestadomodcod']= 1;
			}
		}
		
		if (isset ($ArregloDatos['archivocod']))
		{
			if ($ArregloDatos['archivocod']!="")
			{	
				$sparam['parchivocod']= $ArregloDatos['archivocod'];
				$sparam['pestadoarchcod']= 1;
			}
		}	
		
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
				$sparam['porderby']= $ArregloDatos['orderby'];
		}	
		
		$spnombre="sel_modulos_archivos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el Archivo-Módulo.";
			$errormail="Error al buscar el Archivo-Módulo ".$errno;
			return false;
		}

		return true;
	}



	function Insertar ($ArregloDatos, &$error, &$errormail, &$codigoinsertado = null)
	{
		
		if (!$this->BuscarDatos ($ArregloDatos,$numfilas,$resultado,$error,$errormail))
			return false;
		
		if ($numfilas==1)
		{
			$error="Error, el Módulo-Archivo ya se encuentra en la tabla de Módulos. ";
			$errormail="Error, el Módulo ya se encuentra en la tabla de Módulos. ";
			return false;
		}
		
		$sparam =array("pmodulocod"=>$ArregloDatos['modulocod']);
		$sparam+=array("parchivocod"=>$ArregloDatos['archivocod']);
		$sparam+=array("pultmodusuario"=>$_SESSION['usuariocod']);
		$sparam+=array("pultmodfecha"=>date("Y/m/d H:i:s"));
		
		$spnombre="ins_modulos_archivos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al insertar el Módulo-Archivo.";
			$errormail="Error al insertar el Módulo-Archivo".$errno;
			return false;
		}
		return true;
	}


	function Eliminar ($ArregloDatos, &$error, &$errormail)
	{
		if (!isset ($ArregloDatos['modulocod']) || ($ArregloDatos['modulocod']==""))
		{
			$error="Error Código de Módulo Inexistente.";
			$errormail="Error Código de Módulo Inexistente.";
			return false;
		}
		if (!isset ($ArregloDatos['archivocod']) || ($ArregloDatos['archivocod']==""))
		{
			$error="Error Código Archivo Inexistente.";
			$errormail="Error Código de Archivo Inexistente.";
			return false;
		}
		if (!$this->BuscarDatos ($ArregloDatos,$numfilas,$resultado,$error,$errormail))
			return false;
		
		if ($numfilas!=1)
		{
			$error="Error Código de Módulo-Archivo Inexistente.";
			$errormail="Error Código de Módulo-Archivo Inexistente. ";
			return false;
		}
		
		//VERIFICAR QUE NO TENGA NADA COLGANDO(MODULOS)
		
		$sparam =array("pmodulocod"=>$ArregloDatos['modulocod']);
		$sparam +=array("parchivocod"=>$ArregloDatos['archivocod']);
		$spnombre="del_modulos_archivos_xgrupocod_xarchivocod";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al eliminar el Módulo-Archivo.";
			$errormail="Error al eliminar el Módulo-Archivo ".$errno;
			return false;
		}
		return true;
	}


}

?>