			$querystring.="&".$nomnivelactualiz."=".$codnivelactualiz;
		if($querystring!="")
			$querystring="?".$querystring;
			
		echo "<a href='".htmlspecialchars($archivonom,ENT_QUOTES).htmlspecialchars($querystring,ENT_QUOTES)."' class='linkFondoBlanco'>";
		echo htmlspecialchars($texto,ENT_QUOTES);
		echo "</a></span>";
	} // fin ArmarLinkEstrucVertical

