				$commit=false;

			break;	

		case 'B': 
			if ($oDisposicion->EliminarDatosDisposicion($_POST['dis_codigo'])) {			
				FuncionesPHPLocal::RegistrarAcceso($conexion,"39602","dis_codigo=".$_POST['dis_codigo'],$_SESSION['usuariocod']);	
