//----------------------------------------------------------------------------------------//
// MULTICELL 
//----------------------------------------------------------------------------------------//


	//----------------------------------------------------------------------------------------//
	// MULTICELL MAX LINE CON ESTILO
	//----------------------------------------------------------------------------------------//
	
	function MultiCellEstilo($estilo,$w,$h=0,$txt='',$border=0,$align='',$fill=0,$maxline=0)
	{
		if ($estilo!="")
			$this->SetearFormato($estilo);
		$txt=$this->TextoWindows1252($txt);

		$this->MultiCellMaxLine($w,$h,$txt,$border,$align,$fill,$maxline);
	}



	//----------------------------------------------------------------------------------------//
	// MULTICELL MAX LINE CON SALTO DE PAGINA
	//----------------------------------------------------------------------------------------//

	function MultiCellMaxLine($w,$h,$txt,$border=0,$align='J',$fill=0,$maxline=0)
    {
        //Output text with automatic or explicit line breaks, maximum of $maxlines
        $cw=&$this->CurrentFont['cw'];
        if($w==0)
            $w=$this->w-$this->rMargin-$this->x-$this->rightMargen;
        $wmax=($w-2*$this->cMargin)*1000/$this->FontSize;
        $s=str_replace("\r",'',$txt);
        $nb=strlen($s);
        if($nb>0 and $s[$nb-1]=="\n")
            $nb--;
        $b=0;
        if($border)
        {
            if($border==1)
            {
                $border='LTRB';
                $b='LRT';
                $b2='LR';
            }
            else
            {
                $b2='';
                if(is_int(strpos($border,'L')))
                    $b2.='L';
                if(is_int(strpos($border,'R')))
                    $b2.='R';
                $b=is_int(strpos($border,'T')) ? $b2.'T' : $b2;
            }
        }
        $sep=-1;
        $i=0;
        $j=0;
        $l=0;
        $ns=0;
        $nl=1;
        while($i<$nb)
        {
		    //Get next character
            $c=$s[$i];
            if($c=="\n")
            {
                //Explicit line break
                if($this->ws>0)
                {
                    $this->ws=0;
                    $this->_out('0 Tw');
                }
				$this->VerificarAltoHoja($this->altoMaxPag);
                $this->Cell($w,$h,substr($s,$j,$i-$j),$b,2,$align,$fill);
                $i++;
                $sep=-1;
                $j=$i;
                $l=0;
                $ns=0;
                $nl++;
                if($border and $nl==2)
                    $b=$b2;
                if ( $maxline  && $nl > $maxline ) 
                    return substr($s,$i);
                continue;
            }
            if($c==' ')
            {
                $sep=$i;
                $ls=$l;
                $ns++;
            }
            $l+=$cw[$c];
            if($l>$wmax)
            {
                //Automatic line break
                if($sep==-1)
                {
                    if($i==$j)
                        $i++;
                    if($this->ws>0)
                    {
                        $this->ws=0;
                        $this->_out('0 Tw');
                    }
					$this->VerificarAltoHoja($this->altoMaxPag);
                    $this->Cell($w,$h,substr($s,$j,$i-$j),$b,2,$align,$fill);
                }
                else
                {
                    if($align=='J')
                    {
                        $this->ws=($ns>1) ? ($wmax-$ls)/1000*$this->FontSize/($ns-1) : 0;
                        $this->_out(sprintf('%.3f Tw',$this->ws*$this->k));
                    }
					$this->VerificarAltoHoja($this->altoMaxPag);
                    $this->Cell($w,$h,substr($s,$j,$sep-$j),$b,2,$align,$fill);
                    $i=$sep+1;
                }
                $sep=-1;
                $j=$i;
                $l=0;
                $ns=0;
                $nl++;
                if($border and $nl==2)
                    $b=$b2;
                if ( $maxline  && $nl > $maxline ) 
                    return substr($s,$i);
            }
            else
                $i++;
        }
        //Last chunk
		//$cantlineasescritas=$nl;
        if($this->ws>0)
        {
            $this->ws=0;
            $this->_out('0 Tw');
        }

        if($border and is_int(strpos($border,'B')))
            $b.='B';
		$this->VerificarAltoHoja($this->altoMaxPag);
	    $this->Cell($w,$h,substr($s,$j,$i-$j),$b,2,$align,$fill);
        $this->x=$this->lMargin;
        return '';
    }





