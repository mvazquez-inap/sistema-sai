<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oUsuario=new cUsuarios($conexion);

//--------------------------------------------------------------------------------------------------	
function Validar($conexion,$oUsuario,&$datosvalidados) {

	$datosvalidados=array();

	if (!FuncionesPHPLocal::ValidarContenido($conexion,$_POST['usuarioapellido'],"AlfabeticoPuro") || trim($_POST['usuarioapellido'])=="")
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en el apellido.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$datosvalidados["usuarioapellido"]=strtoupper ($_POST["usuarioapellido"]);
	
	if (!FuncionesPHPLocal::ValidarContenido($conexion,$_POST['usuarionombre'],"AlfabeticoPuro") || trim($_POST['usuarionombre'])=="")
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en el nombre. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$datosvalidados["usuarionombre"]=$_POST["usuarionombre"];
	
	if ($_POST['usuariocuit']=="" || !FuncionesPHPLocal::ValidarContenido($conexion,$_POST['usuariocuit'],"CUIT"))
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en CUIT/CUIL/CDI. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	
	if(!$oUsuario->ValidarCUIT($_POST['usuariocuit'],""))
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Ya existe el CUIT/CUIL/CDI ingresado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$datosvalidados["usuariocuit"]=$_POST["usuariocuit"];

	if ($_POST['usuarioemail']=="" || !FuncionesPHPLocal::ValidarContenido($conexion,$_POST['usuarioemail'],"Email"))
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en el mail. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$datosvalidados["usuarioemail"]=$_POST["usuarioemail"];

	return true;
}

//----------------------------------------------------------------------------------------- 	
// Inicio de pantalla
if(!Validar($conexion,$oUsuario,$datosvalidados)) {
?>
	<br><br><div align="center"><a href="usuario_alta.dhtml?usuarionombre=<?php echo $_POST["usuarionombre"] ?>&amp;usuarioapellido=<?php echo $_POST["usuarioapellido"] ?>&amp;usuariocuit=<?php echo $_POST["usuariocuit"] ?>&amp;usuarioemail=<?php echo $_POST["usuarioemail"] ?>" class="linkFondoBlanco">Volver</a></div>
<?php
} else {
	$conexion->ManejoTransacciones("B");
	$result=true;
	
	if($oUsuario->AltaUsuario($datosvalidados,$nuevapwd))
		$nuevocodigo=$conexion->UltimoCodigoInsertado();
	else
		$result=false;

	if($result) 	{

		$cabeceras = "Content-type: text/plain; charset=utf-8\r\n";
		$cabeceras .= "From: ".MAIL_SISTEMA_FROM;

		$subject=SISTEMA." - Alta de Usuario";
		$texto="Usted fue dado de alta en el ".SYS_VENTANA_NOMBRE."\n\n";
		$texto.="Su contraseña para ingresar es: ".$nuevapwd;
		if(!mail($datosvalidados['usuarioemail'],$subject,$texto,$cabeceras))
		{
			$result=false;
			echo"<p>&nbsp;</p>";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al enviar el mail. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}	
	}
	
	if($result)	{
	
		FuncionesPHPLocal::RegistrarAcceso($conexion,"033801","usuariocuit=".$_POST['usuariocuit']." - usuariocod=".$nuevocodigo,$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se agregó el usuario. CUIT/CUIL/CDI:".$datosvalidados['usuariocuit']." ".$datosvalidados['usuarionombre']." ".$datosvalidados['usuarioapellido'],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se envió la contraseña de ingreso a ".$datosvalidados['usuarioemail'],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

		$conexion->ManejoTransacciones("C");?>		
		<br><br><div align="center"><a href="usuario_actualizar_roles.dhtml?usuariocod=<?php echo $nuevocodigo ?>" class="linkFondoBlanco">Asignarle Roles al Usuario</a></div>
<?php
	} else {
	
		$conexion->ManejoTransacciones("R"); ?>		
		<br><br><div align="center"><a href="usuario_alta.dhtml?usuarionombre=<?php echo htmlspecialchars($_POST["usuarionombre"],ENT_QUOTES) ?>&amp;usuarioapellido=<?php echo htmlspecialchars($_POST["usuarioapellido"],ENT_QUOTES) ?>&amp;usuariocuit=<?php echo htmlspecialchars($_POST["usuariocuit"],ENT_QUOTES) ?>&amp;usuarioemail=<?php echo htmlspecialchars($_POST["usuarioemail"],ENT_QUOTES) ?>" class="linkFondoBlanco">Volver a intentar</a></div> 
<?php	
	}
}
$oEncabezados->PieMenuEmergente();
?>