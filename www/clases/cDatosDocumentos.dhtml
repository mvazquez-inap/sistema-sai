//----------------------------------------------------------------------------------------- 
class cDatosDocumentos  {

	var $conexion;
	public function __construct($conexion,$formato=FMT_TEXTO) {
		$this->conexion = &$conexion;
		$this->formato = $formato;
	}


	//-----------------------------------------------------------------------------------------------------	
	function TraerDatosDatosDocumentos($dto_codigo,&$datosresult,&$es_modif) {
		
		$datosresult=array();
		$es_modif = false;		
		$sparam=array('pdto_codigo'=>$dto_codigo);
		$spnombre="sel_datos_documentos_xdto_codigo";	
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$errormail="\ndto_codigo=".$dto_codigo."\nerror=".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar los datos del sello.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}
		return true;
	
	}


//-----------------------------------------------------------------------------------------------------	
	function ObtenerSPClave(&$spnombre,&$spparam,$codigo) {
		$spnombre="sel_datos_documentos_xdto_codigo";
		$spparam=array('pdto_codigo'=>$codigo);
	}

//-----------------------------------------------------------------------------------------------------	
	function ValidarFormAltaDatosDocumentos() {
	?>
