//-----------------------------------------------------------------------------------------------------
	function MostrarActPoc($conexion, $act_codigo) {

		// busco los POC en los que se encuentra asociada la ACT
		// la relación tiene que estar APROBADA
		$spnombre="sel_poc_poc_actividad_actividad_xact_codigo";
		$sparam = array( 'pact_codigo'=>$act_codigo,
						 'ppocactact_estado'=>POCACTIVIDADACTIVIDADNUEVA.",".POCACTIVIDADACTIVIDADAPROBADA.",".POCACTIVIDADACTIVIDADPEDAPROB.",".POCACTIVIDADACTIVIDADRECHAZADA,
						 'porderby'=>'poc_ano'
						 );

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado_poc,$numfilas_poc,$errno))
		{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar los POCs asociados a la Actividad \nact_codigo=".$act_codigo,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		?>
		<br><div class="textoTitulo" align="left">Objetivos y Areas relacionados con la Actividad</div><br>

		<?php
		while ($fila_poc = mysqli_fetch_assoc($resultado_poc)) { ?>
			<br />
			<table width="100%" class="textoTablaDatoBorde" align="center" border="1" cellpadding="4" cellspacing="0">
			<tr>
				<td class='textoEtiquetaDatoResaltado'><?= htmlspecialchars($fila_poc['poc_ano'],ENT_QUOTES)."  -  ".htmlspecialchars($fila_poc['poc_obs'],ENT_QUOTES);; ?> </td>
			</tr>

			<?php
			// busco las ActPoc de un POC asociadas a la Actividad
			$oPocActividadActividad = new cPocActividadActividad($conexion);
			$filtro = array( 'act_codigo'=>$act_codigo,
							 'poc_codigo'=>$fila_poc['poc_codigo'],
							 'ppocactact_estado'=>POCACTIVIDADACTIVIDADNUEVA.",".POCACTIVIDADACTIVIDADAPROBADA.",".POCACTIVIDADACTIVIDADPEDAPROB.",".POCACTIVIDADACTIVIDADRECHAZADA,

		//					 'pocactact_estado'=>POCACTIVIDADACTIVIDADAPROBADA
							 );


			if (!$oPocActividadActividad->BuscarPocActividadActividad($filtro,$numfilas,$result_act_asignadas,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}

?>
			<tr>
				<td>
				<br><div class="textoTitulo" align="left">Actividades POC</div><br>
				<table width="90%" class="textoTablaDatoBorde" align="right" border="1" cellpadding="4" cellspacing="0">
<?php
				while ($fila_act = mysqli_fetch_assoc($result_act_asignadas)) {


					if(($conexion->TraerCampo("poc_actividad","pocact_nombre_tentativo",array("pocact_codigo='",$fila_act['pocact_codigo'],"'"),$descri,$numfilas,$errno))
			        && ($conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","POCACTIVIDADACTIVIDADESTADO","' and constantecod='",$fila_act['pocactact_estado'],"'"),$descri_estado,$numfilas_estado,$errno)))
					{
						?>
						<tr>
							<td class='textoEtiquetaDato'><?= htmlspecialchars($descri,ENT_QUOTES); ?> </td>
							<td class='textoEtiquetaDatoResaltado' width="100"><?= htmlspecialchars($descri_estado,ENT_QUOTES); ?> </td>
						</tr>

					<?php
					} else
						return false;

					// busco todos los objetivos asociados a la actividad poc
					$oPocActividadPocObjetivo = new cPocActividadPocObjetivo($this->conexion);

					$ArregloDatos['pocact_codigo']=$fila_act['pocact_codigo'];
					$ArregloDatos['poc_codigo']=$fila_poc['poc_codigo'];
					if (!$oPocActividadPocObjetivo ->BuscarPocActividadDatos($ArregloDatos,$numfilas_act,$result_obj,$error,$errormail))
					{
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Error en la búsqueda de los Objetivos de la Actividad Poc. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}

					$array_objetivos = array();
					while ($fila_obj = mysqli_fetch_assoc($result_obj)) {
						$array_objetivos[] = $fila_obj;
					}

		?>
					<tr> <td colspan="2">
						<br><div class="textoTitulo" align="left">Objetivos Asociados</div><br>
						<table width="90%" class="textoTablaDato" align="right" border="0" cellpadding="4" cellspacing="0">
							<?php
							foreach ($array_objetivos as $i=>$valor) {

								// obtengo las áreas del objetivo
								$ArregloDatos=array();
								$ArregloDatos['poc_codigo']= $fila_poc['poc_codigo'];
								$ArregloDatos['pocobj_codigo']= $valor['pocobj_codigo'];
								$oPocPocObjetivoPocArea=new cPocPocObjetivoPocArea($conexion);

								if (!$oPocPocObjetivoPocArea->BuscarPocPocObjetivoPocArea($ArregloDatos,$numfilas_area,$result_area,$error,$errormail)) {
									FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Error en la búsqueda de relaciones entre el Poc y el Objetivo. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
									return false;
								}

								?>
								<tr>
									<td class='textoEtiquetaDato'><?= htmlspecialchars($valor['pocobj_descripcion'],ENT_QUOTES); ?> </td>
								</tr>

								<tr>
									<td class='textoEtiquetaDato'>
											<table width="90%" class="textoTablaDato" align="right" border="0" cellpadding="4" cellspacing="0">
											<?php
											while ($fila_area = mysqli_fetch_assoc($result_area)){
												?>
												<tr>
													<td class='textoEtiquetaDato'><?= htmlspecialchars($fila_area['pocarea_descripcion'],ENT_QUOTES); ?> </td>
												</tr>
												<?php
											}
											?>
										</table>
									</td>
								</tr>


						<?php } ?>
						</table>
						</td>
					</tr>
	<?php
				} // while fila_act
				?>
				</table>
				</td>
			</tr>
		</table>
		<?php }	// while poc

}
//-----------------------------------------------------------------------------------------------------
	function DescargarExcelDisenoActividad($act_codigo, &$oExcel, $nuevo_excel=true) {

		 if (!$this->TraerDatosActividadCursoJurisdiccional($act_codigo,$filacurso,$es_modif)) {
		 	FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pueden obtener los datos de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		 }

		if ($nuevo_excel) {
			$nombrearchivo="actividad.xls";
			$oExcel= new cEscribirExcel($nombrearchivo);
		}

		$oExcel->AddHoja('Actividad');
		$ancho_columna['leyenda']=30;
		$ancho_columna['valor']=70;

		$oExcel->FormatoColumna (0,$ancho_columna['leyenda']);
		$oExcel->FormatoColumna (1,$ancho_columna['valor']);

		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor",22);
		$oExcel->CargarDatosVariasCeldas (0,0,0,1,'Detalle de la Actividad Curso Jurisdiccional',true);

		// Titulos de las columnas
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");

		$arrayclaves=array('leyenda','valor');

		$array_datos[]  = array('leyenda' => "Actividad",
								'valor' => $filacurso['actividad']['act_nombre']);

		$array_datos[] = array('leyenda' => "Código de Actividad",
								'valor' => $filacurso['actividad']['act_codinap']);

		$oExcel->BorrarFormato("");
		$oExcel->AddFormato ("Tamaño",8);
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("VAlign","vcenter");
		$formato_leyenda=$oExcel->GetFormato();

		$oExcel->BorrarFormato("");
		$oExcel->AddFormato ("Tamaño",8);
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("FgColor","blanco");
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("VAlign","vcenter");
		$formato_dato=$oExcel->GetFormato();

		foreach ($arrayclaves as $clave => $valor) {
			if ($valor == 'leyenda')
	 			$arrayformato[$valor]=$formato_leyenda;
			else
	 			$arrayformato[$valor]=$formato_dato;
		}

		if (!$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filacurso['actividad_curso']['jurisdid_inap'],"'"),$descri_organismo,$numfilascaracter,$errorcod))  {
				 	FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pueden obtener los datos del Organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		 }

		$array_datos[] = array('leyenda' => "Organismo",
								'valor' => $descri_organismo);
		$array_datos[] = array('leyenda' => "Fundamentación",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_fundamentacion']);
		$array_datos[] = array('leyenda' => "Contribución esperada",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_contribucion']);
		$array_datos[] = array('leyenda' => "Perfil del participante",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_perfil']);
		$array_datos[] = array('leyenda' => "Objetivos",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_objetivos']);
		$array_datos[] = array('leyenda' => "Contenido",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_contenido']);
		$array_datos[] = array('leyenda' => "Metodología",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_metodologia']);
		$array_datos[] = array('leyenda' => "Descripción de la modalidad",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_modaldesc']);
		$array_datos[] = array('leyenda' => "Bibliografía",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_bibliografia']);
		$array_datos[] = array('leyenda' => "Evaluación de los aprendizajes",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_eval']);
		$array_datos[] = array('leyenda' => "Instrumentos para la evaluación",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_evalinstru']);
		$array_datos[] = array('leyenda' => "Requisitos de Asistencia y aprobación",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_requiaprobacion']);
		$array_datos[] = array('leyenda' => "Duración (Hs.)",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_duracionhs']);
		$array_datos[] = array('leyenda' => "Detalle sobre la duración",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_duraciondetalle']);
		$array_datos[] = array('leyenda' => "Cronograma tentativo",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_cronogramatentativo']);
		$array_datos[] = array('leyenda' => "Lugar",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_lugar']);
		$array_datos[] = array('leyenda' => "Perfil Instructor",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_perfil_instructor']);
/*		$array_datos[]  = array('leyenda' => "Recursos",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_planrecursos']);
		$array_datos[]  = array('leyenda' => "Contenidos",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_plancontenidos']);
		$array_datos[]  = array('leyenda' => "Estrtegias",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_planestrategias']);
*/
		$array_datos[]  = array('leyenda' => "Origen de la demanda",
								'valor' => $filacurso['actividad_curso_jurisdiccional']['actdisjurisd_origen']);
		$fila_datos = array();

		foreach ($array_datos as $i => $valor) {
			$fila_datos['leyenda'] = $array_datos[$i]['leyenda'];
			$fila_datos['valor'] = $array_datos[$i]['valor'];
			// Saco los /r que no se lo banca el excel.
			$fila_datos['valor']=str_replace("\r\n","\n", $array_datos[$i]['valor']);
			$oExcel->CargarGrilla ($fila_datos,2+$i,0,$arrayclaves,$arrayformato);
		}
		if ($nuevo_excel)
			$oExcel->Enviar();
	}

//-----------------------------------------------------------------------------------------------------
	function _AguparDatosPost($datos,&$datos_agrup,$es_modif)	{

		//-----------------------------------------------------------
		$datos_agrup['actividad']=array('act_codinap'=>$datos['act_codinap'],
										'act_nombre'=>$datos['act_nombre'],
										'act_obs'=>$datos['act_obs']);
		if ($es_modif)
			$datos_agrup['actividad']+=array('act_codigo'=>$datos['act_codigo']);
		else
			$datos_agrup['actividad']+=array('formact_codigo'=>FORMATOCURSO);

		//-------------------------------------------------------------
		$datos_agrup['actividad_curso']=array('actcur_obs'=>$datos['actcur_obs']);
		if ($es_modif)
			$datos_agrup['actividad_curso']+=array('act_codigo'=>$datos['act_codigo']);
		else {
		 	$datos_agrup['actividad_curso']+=array('tipoact_codigo'=>TIPOACTCURSOJURISD);
		 	$datos_agrup['actividad_curso']+=array('actcur_creditos'=>0);
			$datos_agrup['actividad_curso']+=array('jurisdid_inap'=>$_SESSION['jurisdid_inap']);
			$datos_agrup['actividad_curso']+=array('actcur_estado'=>ACTCURSONUEVO);
		}
		//--------------------------------------------------------------
		$datos_agrup['actividad_curso_jurisdiccional']=array(
						  'actdisjurisd_fundamentacion'=>$datos['actdisjurisd_fundamentacion'],
						  'actdisjurisd_contribucion'=>$datos['actdisjurisd_contribucion'],
						  'actdisjurisd_perfil'=>$datos['actdisjurisd_perfil'],
						  'actdisjurisd_objetivos'=>$datos["actdisjurisd_objetivos"],
						  'actdisjurisd_contenido'=>$datos['actdisjurisd_contenido'],
						  'actdisjurisd_modaldesc'=>$datos['actdisjurisd_modaldesc'],
						  'actdisjurisd_eval'=>$datos['actdisjurisd_eval'],
						  'actdisjurisd_evalinstru'=>$datos['actdisjurisd_evalinstru'],
						  'actdisjurisd_requiaprobacion'=>$datos['actdisjurisd_requiaprobacion'],
  						  'actdisjurisd_duracionhs'=>$datos['actdisjurisd_duracionhs'],
						  'actdisjurisd_duraciondetalle'=>$datos['actdisjurisd_duraciondetalle'],
						  'actdisjurisd_cronogramatentativo'=>$datos['actdisjurisd_cronogramatentativo'],
						  'actdisjurisd_lugar'=>$datos['actdisjurisd_lugar'],
						  'actdisjurisd_metodologia'=>$datos['actdisjurisd_metodologia'],
						  'actdisjurisd_bibliografia'=>$datos['actdisjurisd_bibliografia'],
						  'actdisjurisd_perfil_instructor'=>$datos['actdisjurisd_perfil_instructor'],
						  'actdisjurisd_planrecursos'=>$datos['actdisjurisd_planrecursos'],
						  'actdisjurisd_plancontenidos'=>$datos['actdisjurisd_plancontenidos'],
						  'actdisjurisd_planestrategias'=>$datos['actdisjurisd_planestrategias'],
						  'actdisjurisd_origen'=>$datos['actdisjurisd_origen']
		);
		if ($es_modif)
			$datos_agrup['actividad_curso_jurisdiccional']+=array('act_codigo'=>$datos['act_codigo']);
		else {
		 	$datos_agrup['actividad_curso_jurisdiccional']+=array('actdisjurisd_duracionhs'=>0);
		}
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosAltaActividadCursoJurisdiccional($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->_DatosValidosComunesActividadCursoJurisdiccional($datos,$datosvalidados))
		   return false;

		return true;
	}
	
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosEliminarActividadCursoJurisdiccional($act_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoBaja($act_codigo,$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false;
		}

		$tipook=$this->EsActividadCursoTipo($act_codigo,TIPOACTCURSOJURISD,$error,$errormsg);
		if ($error) {
			$errormail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif(!$tipook) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		$datosvalidados['act_codigo'] = $act_codigo;

		// Verificar que la actividad no tenga dictamen.
		// En el caso de las actividades jurisdiccionales que no se eliminan
		// cuando estan activas, no va haber dictamen porque se dictamina sobre activas
		$oDictamen = new cDictamen($this->conexion);
		$ArregloDatos=array();
		$ArregloDatos=array('act_codigo'=>$act_codigo);
		$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
		if ($error)  {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif ($numfilas>0 && $_SESSION['rolcod']!=SUPERUSUARIO ) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La actividad no puede ser modificada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosModifActividadCursoJurisdiccional($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoModificar($datos['act_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false;
		}

		if (!$this->_DatosValidosComunesActividadCursoJurisdiccional($datos,$datosvalidados))
		   return false;

		$tipook=$this->EsActividadCursoTipo($datos['act_codigo'],TIPOACTCURSOJURISD,$error,$errormsg);
		if ($error) {
			$errormail="\nact_codigo=".$datos['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif(!$tipook) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		$datosvalidados+=array('act_codigo'=>$datos['act_codigo']);

		// Verificar que la actividad no tenga dictamen.
		$oDictamen = new cDictamen($this->conexion);
		$ArregloDatos=array();
		$ArregloDatos=array('act_codigo'=>$datos['act_codigo']);
		$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
		if ($error)  {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif ($numfilas>0 && $_SESSION['rolcod']!=SUPERUSUARIO) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La actividad no puede ser modificada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosComunesActividadCursoJurisdiccional($datos,&$datosvalidados)	{

		$datosvalidados=array();

		// Fundamentación 					- [actdisjurisd_fundamentacion] 	- [OBLIG]
		if (trim($datos['actdisjurisd_fundamentacion']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la fundamentación de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_fundamentacion"]=$datos["actdisjurisd_fundamentacion"];

		// Contribución esperada 			- [actdisjurisd_contribucion] 	- [OBLIG]
		if (trim($datos['actdisjurisd_contribucion']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la contribución esperada de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_contribucion"]=$datos["actdisjurisd_contribucion"];

		// Perfil del participante 			- [actdisjurisd_perfil] 			- [OBLIG]
		if (trim($datos['actdisjurisd_perfil']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el perfil de los participantes de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_perfil"]=$datos["actdisjurisd_perfil"];

		// Objetivos 						- [actdisjurisd_objetivos] 		- [OBLIG]
		if (trim($datos['actdisjurisd_objetivos']) == "") {
			$mensajepantalla="Debe ingresar los Objetivos de la actividad.";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$mensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_objetivos"]=$datos["actdisjurisd_objetivos"];

		// Contenido 						- [actdisjurisd_contenido] 		- [OBLIG]
		if (trim($datos['actdisjurisd_contenido']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar los contenido de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_contenido"]=$datos["actdisjurisd_contenido"];

		// Metodologia							- [actdisjurisd_metodologia] 			- [OBLIG]
		if (trim($datos['actdisjurisd_metodologia']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar las estrategias metodológicas y recursos didácticos",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_metodologia"]=$datos["actdisjurisd_metodologia"];

		// Descripción de la modalidad 		- [actdisjurisd_modaldesc] 		- [OBLIG]
		if (trim($datos['actdisjurisd_modaldesc']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la modalidad de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_modaldesc"]=$datos["actdisjurisd_modaldesc"];

		// Bibliografia 							- [actdisjurisd_bibliografia] 			- [OBLIG]
		if (trim($datos['actdisjurisd_bibliografia']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la Bibliografía.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_bibliografia"]=$datos["actdisjurisd_bibliografia"];

		// Evaluación de los aprendizajes 	- [actdisjurisd_eval] 			- [OBLIG]
		if (trim($datos['actdisjurisd_eval']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la evaluación de los aprendizajes de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_eval"]=$datos["actdisjurisd_eval"];

		// Instrumentos para la evaluación 	- [actdisjurisd_evalinstru] 		- [OPCIONAL]
		$datosvalidados["actdisjurisd_evalinstru"]=$datos["actdisjurisd_evalinstru"];

		// Requisitos de Asistencia y aprobación			- [actdisjurisd_requiaprobacion] 	- [OBLIG]
		if (trim($datos['actdisjurisd_requiaprobacion']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar los requisitos de Asistencia y aprobación de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_requiaprobacion"]=$datos["actdisjurisd_requiaprobacion"];

		// Duración	en horas 		- [actdisjurisd_duracionhs] 	- [OBLIG]
		if (!FuncionesPHPLocal::ValidarContenido($this->conexion, $datos['actdisjurisd_duracionhs'],'NumericoEntero') || $datos['actdisjurisd_duracionhs'] <=0 ) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La duración en hs. de la Actividad debe ser un número entero mayor que cero.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_duracionhs"]=$datos["actdisjurisd_duracionhs"];

		// Detalle sobre la duración	 	- [actdisjurisd_duraciondetalle] 	- [OBLIG]
		if (trim($datos['actdisjurisd_duraciondetalle']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la duración de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_duraciondetalle"]=$datos["actdisjurisd_duraciondetalle"];

		// Cronograma tentativo - [actdisjurisd_cronogramatentativo] 	- [OBLIG]
		if (trim($datos['actdisjurisd_cronogramatentativo']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el Cronograma tentativo de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_cronogramatentativo"]=$datos["actdisjurisd_cronogramatentativo"];

		// Lugar 							- [actdisjurisd_lugar] 			- [OBLIG]
		if (trim($datos['actdisjurisd_lugar']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el lugar de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_lugar"]=$datos["actdisjurisd_lugar"];

		// Perfil del Instructor 							- [actdisjurisd_perfil_instructor] 			- [OBLIG]
		if (trim($datos['actdisjurisd_perfil_instructor']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el perfil del instructor de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_perfil_instructor"]=$datos["actdisjurisd_perfil_instructor"];

		/*
		// Plan de Clases - Recursos 							- [actdisjurisd_planrecursos] 			- [OBLIG]
		if (trim($datos['actdisjurisd_planrecursos']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el Plan de Clases - Recursos 	 de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_planrecursos"]=$datos["actdisjurisd_planrecursos"];

		// Plan de Clases - contenidos 							- [actdisjurisd_plancontenidos] 			- [OBLIG]
		if (trim($datos['actdisjurisd_plancontenidos']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el Plan de Clases - contenidos de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_plancontenidos"]=$datos["actdisjurisd_plancontenidos"];

		// Plan de Clases - Estretegias						- [actdisjurisd_planestrategias] 			- [OBLIG]
		if (trim($datos['actdisjurisd_planestrategias']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el Plan de Clases - Estretegias de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_planestrategias"]=$datos["actdisjurisd_planestrategias"];
		*/

		$datosvalidados["actdisjurisd_plancontenidos"]="";
		$datosvalidados["actdisjurisd_planrecursos"]="";
		$datosvalidados["actdisjurisd_planestrategias"]="";

		// Origen 						- [actdisjurisd_origen] 			- [OBLIG]
		if (trim($datos['actdisjurisd_origen']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar Origen de la demanda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisjurisd_origen"]=$datos["actdisjurisd_origen"];



		return true;
	}
} // class
