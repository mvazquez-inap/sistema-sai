<?php
require_once("SysONTIaccesoBD2.dhtml");

//-- Cambio self x FuncionesPHP
class FuncionesPHP
{
//----------------------------------------------------------------------------------------- 
// Genera todas las constantes necesarias para el sistema

	static function CargarConstantes($conexion,$tipocarga)
	{
		$conexiongral=new SysONTIAccesoBD(getenv("SAI_DB_HOST") ?: "", getenv("SAI_DB_USER") ?: "", getenv("SAI_DB_PASSWORD") ?: "");
		$conexiongral->SeleccionBD(getenv("SAI_DB_TABGRALES2") ?: "");

		// Constantes Generales 
		$spparam=array('psistemanom'=>"SYSONTI");
		if(!$conexiongral->ejecutarStoredProcedure("sel_constantes_grales_xsistemanom",$spparam,$resultado,$numfilas,$errno))
			die("Error al cargar las constantes");
		
		while ($fila = mysqli_fetch_assoc($resultado))
			if(!defined($fila['constantenom']))
				define ($fila['constantenom'],$fila['constantecod']);

		$conexiongral->CerrarConexion();


		if(isset($tipocarga['roles']))
		{
			// constantes ROL de USUARIOS
			$spparam=array('porderby'=>"rolcod" );
			if(!$conexion->ejecutarStoredProcedure("sel_roles_orden",$spparam,$resultado,$numfilas,$errno))
				die("Error al cargar los roles");
			
			while ($fila = mysqli_fetch_assoc($resultado))
				if($fila['rolcod']!=0)
					if(!defined($fila['rolnom']))
						define ($fila['rolnom'],$fila['rolcod']);
		}

		if(isset($tipocarga['sistema']))
		{
			// Constantes Generales 
			$spparam=array('psistemanom'=>$tipocarga['sistema']);
			if(!$conexion->ejecutarStoredProcedure("sel_constantes_grales_xsistemanom",$spparam,$resultado,$numfilas,$errno))
				die("Error al cargar las constantes");
			
			while ($fila = mysqli_fetch_assoc($resultado)) 
				if(!defined($fila['constantenom']))
					define ($fila['constantenom'],$fila['constantecod']);
		}

	}

//----------------------------------------------------------------------------------------- 
// Usada para el envio automatico de mails, según rol/jurisdiccion

// Retorna true si no hubo problema, 
//		sino retorna false en caso de error al ejecutar el SP para seleccionar los usuarios,
//		por rol inválido o por error al enviar el mail.

	function MandarMail($conexion,$rolcod,$jurisdcod,$subjectmail,$textomail)
	{

		switch($rolcod)
		{
			case TABGRALES_ADMIONTI:
				$spparam=array('prolcod'=>$rolcod,'pusuarioestado'=>GENERAL_USUARIOACT);		
				$spnombre="sel_mail_usuarios_con_mail_xrol_xmenorestado";
				break;
	
			default:
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Error al generar mail. ");
				$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$arraymensajemail+=array("texto" => $arraymensajepantalla['texto']." Intento de enviar mail a rol inexistente '".$rolcod."'. ");
				self::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				return false;
		}
		
		if(!isset($spnombre))
		{
			$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
			$arraymensajepantalla+=array("texto" => "Error al generar mail. ");
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => $arraymensajepantalla['texto']." No se pudo determinar el nombre del stored procedure. ");
			self::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return false;
		}

		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
			return false;

		$mails_enviar=array();
		while($fila=mysqli_fetch_assoc($resultado))
			$mails_enviar[]=$fila['usuarioemail'];
		$mails_enviar=array_unique($mails_enviar);

		$destinatarios="Bcc: ".implode(", ",$mails_enviar)."\r\n";
		if(!mail("",$subjectmail,$textomail,$destinatarios))
		{
			$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
			$arraymensajepantalla+=array("texto" => "Imposible enviar mail. ");
			$arraymensajemail =array();			
			self::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return false;
		}



	
/*		while($fila=mysql_fetch_assoc($resultado))
			if(!mail($fila['usuarioemail'],$subjectmail,$textomail))
			{
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Imposible enviar mail. ");
				$arraymensajemail =array();			
				self::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				return false;
			}*/
		
		return true;	
	}

//----------------------------------------------------------------------------------------- 
// Muestra un mensaje en pantalla y/o envía mail a ADMIONTI

//	Parametros: 
//	$arraymensajepantalla (array asociativo)
//		$arraymensajepantalla['formato']=FMT_TEXTO|FMT_TABLA
//		$arraymensajepantalla['cantcols'] usado para colspan cuando es FMT_TABLA
//		$arraymensajepantalla['texto'] = texto a mostrar por pantalla
//	$arraymensajemail (array asociativo) para enviar mail al administrador definido en la conexion
//		$arraymensajemail['archivo'] = nombre php de llamada
//		$arraymensajemail['funcion'] = nombre función de llamada
//		$arraymensajemail['linea'] = línea de llamada
//		$arraymensajemail['texto'] = texto a mostrar por mail

	function MostrarMensaje($conexion,$nivelmensaje,$arraymensajepantalla,$arraymensajemail=array())
	{
		
		if(count($arraymensajepantalla)>0)
		{ // mostrar el mensaje en pantalla
			if(!isset($arraymensajepantalla['formato']))
				$arraymensajepantalla['formato']=GENERAL_FMT_TEXTO;	
			if(!isset($arraymensajepantalla['texto']))
				$arraymensajepantalla['texto']=" ";
			if ($nivelmensaje==GENERAL_MSG_ERRGRAVE)
				$arraymensajepantalla['texto']=$arraymensajepantalla['texto']."\n\n Avise a su Administrador o a la ONIG.";

			switch($arraymensajepantalla['formato'])
			{
				case GENERAL_FMT_TEXTO:
					echo "<br><div align='center' class='textonombreclave'>".$arraymensajepantalla['texto']."</div> <br>";	
					break;
				case GENERAL_FMT_TABLA:
					if(!isset($arraymensajepantalla['cantcols']))
						$arraymensajepantalla['cantcols']=1;	
	?>
		<tr>
			<td colspan="<?php echo $arraymensajepantalla['cantcols'] ?>" height="100" align="center" valign="middle">
				<span class='textonombreclave'><?php echo $arraymensajepantalla['texto'] ?></span>
			</td>
		</tr>	
	<?php
					break;
				default:
					echo $arraymensajepantalla['texto'];	
					break;
			}
		}
		if(count($arraymensajemail)>0)
		{ // envio de mail
			if(!isset($arraymensajemail['texto']))
			{
				$arraymensajemail['texto']=" ";
				if(isset($arraymensajepantalla['texto']))
					$arraymensajemail['texto']=$arraymensajepantalla['texto'];
			}

			if(defined('SISTEMAMOSTRAR'))
				$subjectmail=SISTEMAMOSTRAR;
			elseif(defined('SISTEMA'))
				$subjectmail=SISTEMA;
			else
				$subjectmail="";

			switch($nivelmensaje)
			{
				case GENERAL_MSG_OK:
					$subjectmail.=" - Mensaje OK";
					break;
				case GENERAL_MSG_INF:
					$subjectmail.=" - Mensaje Informativo";
					break;
				case GENERAL_MSG_ERRGRAVE:
					$subjectmail.=" - Error de Inconsistencia de Datos";
					break;
				case GENERAL_MSG_ERRSOSP:
					$subjectmail.=" - Error Datos Sospechosos";
					break;
				case GENERAL_MSG_ERRPGM:
					$subjectmail.=" - Error en Programa";
					break;
				default:
					$subjectmail.=" - Nivel de mensaje no definido";
					break;
			}

			$textomail ="\nMensaje:\n".$arraymensajemail['texto']."\n\n";
			$textomail.="Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";
			if(isset($arraymensajemail['archivo']))
				$textomail.="Ubic Archivo:       ".$arraymensajemail['archivo']."\n";
			if(isset($arraymensajemail['funcion']))
				$textomail.="Ubic Función:       ".$arraymensajemail['funcion']."\n";
			if(isset($arraymensajemail['linea']))
				$textomail.="Ubic Línea:         ".$arraymensajemail['linea']."\n";

			if(isset($_SESSION['usuariocod']) && $_SESSION['usuariocod']!=0)
				$textomail.="\nUsuario sesion:    '".$_SESSION['usuariocod']."'";

			if(isset($_SESSION['rolcod']) && $_SESSION['rolcod']!=0)
				$textomail.="\nRol sesion:        '".$_SESSION['rolcod']."'";

			if(isset($_SESSION['jurisdid']) && $_SESSION['jurisdid']!=0)
			{
				$textomail.="\nOrganismo sesion:  '".$_SESSION['jurisdid']."' - ";
				$cjurisdmail = new SysONTIjurisdicciones2();
				if($cjurisdmail->SelectJurisdxID($_SESSION['jurisdid'],array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$filaret,array(),$NumFilas,$CodError))
				{
					$filajurisd = current($filaret);
					$nombrejurisd=htmlspecialchars($filajurisd['jurisdnom'],ENT_QUOTES);
					$textomail.=$nombrejurisd;
				}
			}

			self::MandarMail($conexion,$conexion->VerAdmiGeneral(),"",$subjectmail,$textomail);
		}
	}

