//----------------------------------------------------------------------------------------- 	
function MostrarGrillaSeleccion($conexion) {

	$result = true;
	$spparam = array();

	$spparam['pxmodulocod']  = "0";
	$spparam['pxrolcod']  = "0";
	
	$spparam['pmodulocod']  = "";
	$spparam['prolcod']  = "";

	if ($_SESSION['array_listado']['modulocod']!="") {
		$spparam['pxmodulocod']  = "1";
		$spparam['pmodulocod'] = $_SESSION['array_listado']['modulocod'];			
	}		

	if ($_SESSION['array_listado']['rolcod']!="") {
		$spparam['pxrolcod']  = "1";
		$spparam['prolcod'] = $_SESSION['array_listado']['rolcod'];			
	}

	$spnombre="sel_modulos_asignados_xmodulocod_rolcod";

	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado_mod,$numfilas,$errno))
		return false;


	$querystring = $_SERVER['QUERY_STRING'];

	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FormularioBotonera"=>"formulario_boton_1",		
		"FilasPagina"=>50
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}

		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearAnchoGrilla('90%');

		$miColumna0 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna0,'Rol');
		$oGrilla->Setear('campo_grilla',$miColumna0,'rolnom');
		$oGrilla->Setear('align_columna',$miColumna0,'left');
	
		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'Módulo');
		$oGrilla->Setear('campo_grilla',$miColumna1,'modulodesc');
		$oGrilla->Setear('align_columna',$miColumna1,'left');

		$miColumna2 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Texto en Menú');
		$oGrilla->Setear('campo_grilla',$miColumna2,'modulotextomenu');
		$oGrilla->Setear('align_columna',$miColumna2,'left');

		$miColumna3 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Menú');
		$oGrilla->Setear('campo_grilla',$miColumna3,'grupomodtextomenu');
		$oGrilla->Setear('align_columna',$miColumna3,'left');

		$miColumna4 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna4,'Asignación');
		$oGrilla->Setear('campo_grilla',$miColumna4,'tipo_asignacion');
		$oGrilla->Setear('align_columna',$miColumna4,'left');


	if ($oGrilla->CargarGrilla($resultado_mod)) {
		$oGrilla->MostrarGrilla();					
	} else {
		$error=true;					
		$txt_sys_mail = "Error Grilla='".$oGrilla->GetError();
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar Roles Módulos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
	}		
	
	return $result;
}

