				$oExcel->FormatoColumna (6,$ancho_columna['asunto']); 
				$oExcel->FormatoColumna (7,$ancho_columna['perfil']); 
				$oExcel->FormatoColumna (8,$ancho_columna['poc']); 								
				$oExcel->FormatoColumna (9,$ancho_columna['fecha_desde']); 
				$oExcel->FormatoColumna (10,$ancho_columna['fecha_fin']); 
