<script type="text/javascript" language="javascript">
function Validar(formulario) {
	if (!ValidarContenido(formulario.usuarioapellido.value,"AlfabeticoPuro"))
	{
		alert("El apellido a buscar es inválido");
		formulario.usuarioapellido.focus();
		return false;	
	}
	if (!ValidarContenido(formulario.usuarionombre.value,"AlfabeticoPuro"))
	{
		alert("El nombre a buscar es inválido");
		formulario.usuarionombre.focus();
		return false;	
	}
	
	return true;	
}
</script>

<br><div class="textoTitulo" align="left"> Búsqueda de Usuarios </div><br>

<?php
if (isset($_POST['boton_buscar']))
	$_SESSION['array_busqueda_basica_usuario']=$_POST;
			
if (!isset($_SESSION['array_busqueda_basica_usuario'])) 
	$_SESSION['array_busqueda_basica_usuario']=array(); 

if(isset($_POST['boton_buscar']) || isset($_GET['pagina']) ) {
	
	MostrarGrillaSeleccion($conexion,$_SESSION['array_busqueda_basica_usuario']);
