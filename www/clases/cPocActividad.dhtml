//-----------------------------------------------------------------------------------------------------	
	function BuscarPocActividad($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{
		$sparam=array('pxpocact_codigo'=>0);
		$sparam+=array('pxpoc_codigo'=>0);
		$sparam+=array('pxpocact_nombre_tentativo'=>0);
		$sparam+=array('pxpocact_estado'=>0);
		
		$sparam+=array('ppocact_codigo'=>"");
		$sparam+=array('ppoc_codigo'=>"");
		$sparam+=array('ppocact_nombre_tentativo'=>"");
		$sparam+=array('ppocact_estado'=>"-1");
		$sparam+=array('porderby'=>"pocact_nombre_tentativo");

		if (isset ($ArregloDatos['pocact_codigo']))
		{
			if ($ArregloDatos['pocact_codigo']!="")
			{	
				$sparam['ppocact_codigo']= $ArregloDatos['pocact_codigo'];
				$sparam['pxpocact_codigo']= 1;
			}
		}
		if (isset ($ArregloDatos['poc_codigo']))
		{
			if ($ArregloDatos['poc_codigo']!="")
			{	
				$sparam['ppoc_codigo']= $ArregloDatos['poc_codigo'];
				$sparam['pxpoc_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['pocact_nombre_tentativo']))
		{
			if ($ArregloDatos['pocact_nombre_tentativo']!="")
			{	
				$sparam['ppocact_nombre_tentativo']= $ArregloDatos['pocact_nombre_tentativo'];
				$sparam['pxpocact_nombre_tentativo']= 1;
			}
		}	

		if (isset ($ArregloDatos['pocact_estado']))
		{
			if ($ArregloDatos['pocact_estado']!="")
			{	
				$sparam['ppocact_estado']= $ArregloDatos['pocact_estado'];
				$sparam['pxpocact_estado']= 1;
			}
		}
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}
		
		$spnombre="sel_poc_actividad_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar la Actividad del Poc.";
			$errormail="Error al buscar la Actividad del Poc \nerror=.".$errno;
			return false;
		}

		return true;
	}
	
//-----------------------------------------------------------------------------------------------------	
