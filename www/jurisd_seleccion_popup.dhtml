<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoConsulta();

$jurisdicciones=new jurisdicciones($conexion);

if(!$jurisdicciones->RamaAscendente($_GET["inicio"],JURISD_TODOSLOSNIVELES,array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$array_ascend,array(),$NumFilas,$CodError))
{
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"No se pudo obtener la rama ascendente de '".$_GET["inicio"]."'. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TABLA,"cantcols"=>2));
	die();
}
echo "<br>";

$margen=0;
foreach($array_ascend as $jurisdid=>$datos_jurisd)
{
	$querystring=FuncionesPHPLocal::ArmarQueryString("inicio");
	$querystring.="&amp;inicio=".$datos_jurisd["jurisdid"];
?>
	<div style="margin-left:<?php echo $margen*15+10 ?>px">
		<a href="javascript:void(0)" onClick="addValorPopup(window.opener.document,'<?php echo $_GET['destino']?>','<?php echo $datos_jurisd["jurisdid"] ?>','<?php echo htmlspecialchars(FuncionesPHPLocal::ReemplazarComillas($datos_jurisd["jurisdnom"]),ENT_QUOTES);?>','<?php echo $_GET['texto']?>');window.close();" title="Seleccionar"> <img src="images/activar.jpg" alt="Seleccionar" border="0" style="vertical-align:-5px"></a>
		<a href="<?php echo $_SERVER['PHP_SELF']."?".$querystring ?>" class="linkFondoBlanco">
			<?php echo htmlspecialchars($datos_jurisd["jurisdnom"],ENT_QUOTES) ?>
		</a>
	</div>
<?php
	$margen++;
}

?>
<br>
<table width="95%" class="textotabla" border="1" cellpadding="2" cellspacing="2" align="center">
<?php
	if(!$jurisdicciones->SubArbolDependiente($_GET["inicio"],1,array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$array_jurisd,array(),$NumFilas,$CodError))
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"No se pudieron obtener los organismos dependientes de '".$_GET["inicio"]."'. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TABLA,"cantcols"=>2));
		die();
	}
	//elimino el primer elemento, manteniendo las claves
	unset($array_jurisd[key($array_jurisd)]);

	foreach($array_jurisd as $jurisdid=>$datos_jurisd)
	{
?>
	<tr>
		<td width="90%">
			<?php echo htmlspecialchars($datos_jurisd["jurisdnom"],ENT_QUOTES) ?>
		</td>
		<td width="5%">
<?php
		if(count($datos_jurisd["IDHijos"])>0)
		{
			$querystring=FuncionesPHPLocal::ArmarQueryString("inicio");
			$querystring.="&amp;inicio=".$jurisdid;
?>
			<a href="<?php echo $_SERVER['PHP_SELF']."?".$querystring ?>" title="Ver Dependencias"><img src="images/bajar.png" border="0" alt="Ver Dependencias" align="middle"></a>
 
<?php		
		}
?>		
		</td>
		<td width="5%">
			<a href="javascript:void(0)" onClick="addValorPopup(window.opener.document,'<?php echo $_GET['destino']?>','<?php echo $jurisdid ?>','<?php echo htmlspecialchars($datos_jurisd["jurisdnom"],ENT_QUOTES);?>','<?php echo $_GET['texto']?>');window.close();" title="Seleccionar"> <img src="images/activar.jpg" alt="Seleccionar" border="0"></a>
		</td>
	</tr>

<?php
	}	
?>	
</table>

<?php
$oEncabezados->PieConsulta();
?>