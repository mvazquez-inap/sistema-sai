	function MostrarDatoPrestadorDocente($conexion,$operacion,$filaprestador=array()) {

	$jurisdicciones	= new jurisdicciones;

	// si queda esta opcion no mandar la conexion
	if ($operacion=="A") {
	   $es_modif = false;
	} elseif ($operacion=="M" || $operacion=="V") {   
	   	$es_modif = true;
	   } else {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en la llamada, operación inválida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
	   }


	if ($operacion=="V") 
		$sDisabled = ' disabled="true"';
	else	
		$sDisabled = '';   
	  
	   
?>		<table width="100%" class="textoTablaDato" align="center" cellpadding="2" cellspacing="2">
			<tr>
				<td colspan="2" >
					<fieldset class="bordeDetalleRegistro">
					<legend class="textoLeyendaDetalleRegistro"> Datos Básicos </legend>
					<table width="100%" class="textoTablaDato" align="center">
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Apellido</td>
						<td class="textoEtiquetaDatoResaltado"><input type="text" name="presdoc_apellido" id="presdoc_apellido" size="33" maxlength="30" <?= $sDisabled ?> class='textoInput' onblur="PasarAMayusculas('presdoc_apellido')" value="<?php echo ($es_modif) ? htmlspecialchars($filaprestador['presdoc_apellido'],ENT_QUOTES):""; ?>"></td>
					</tr>
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Nombre</td>
						<td class="textoEtiquetaDatoResaltado"><input type="text" name="presdoc_nombre" id="presdoc_nombre" size="33" maxlength="30" <?= $sDisabled ?> class='textoInput'  onblur="PasarAMayusculas('presdoc_nombre')" value="<?php echo ($es_modif) ? htmlspecialchars($filaprestador['presdoc_nombre'],ENT_QUOTES):""; ?>"></td>
					</tr>
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Sexo</td>
						<td class="textoEtiquetaDatoResaltado">
						  <label><input name="presdoc_sexo" type="radio" <?= $sDisabled ?>  value="<?php echo SEXO_FEMENINO?>" <?php echo ($es_modif && $filaprestador["presdoc_sexo"]==SEXO_FEMENINO)?"checked='checked'":"" ?>>Femenino</label>
						  <label><input name="presdoc_sexo" type="radio"<?= $sDisabled ?> value="<?php echo SEXO_MASCULINO?>" <?php echo ($es_modif && $filaprestador["presdoc_sexo"]==SEXO_MASCULINO)?"checked='checked'":"" ?>>Masculino</label>
						</td>
					</tr>
					<tr>
						<td valign="top" width="25%" class='textoEtiqueta'>Pais de Origen </td>
						<td class="textoEtiquetaDatoResaltado">	<?php
							$spnombre = "sel_paises_xestado";
							$spparam = array("ppaisestado"=>ESTADOACTIVO, "porderby"=>"paisnom");
							FuncionesPHPLocal::ArmarCombo_SinSalto_BD($conexion,$spnombre,$spparam,"formulario","presdoc_origen_pais_codigo","paiscod","paisnom",($es_modif)?$filaprestador['presdoc_origen_pais_codigo']:ARGENTINA,"-- Seleccione un País",$filaprespais,$seleprespais,1,"","width:400px",false,false,"",$operacion=="V");
							?>						
						</td>
					</tr>
					
					<?php if ($_SESSION['rolcod'] == ADMICURSO || $_SESSION['rolcod'] == USUCURSO  ) {?>
						<tr>
							<td valign="top" width="25%" class='textoEtiqueta'>Caracter de alta</td>
							<td class="textoEtiquetaDatoResaltado">
								<input name="presdoc_caracter_alta"  <?= $sDisabled ?> type="radio" onclick="SeleccionCaracterAlta(formulario,'presdoc_falta_prov','presdoc_falta_def')" value="<?php echo PRESDOCPROVISORIO ?>" <?php echo ($es_modif && $filaprestador["presdoc_caracter_alta"]==PRESDOCPROVISORIO)?"checked='checked'":"" ?>/>Provisoria
								<input name="presdoc_caracter_alta"  <?= $sDisabled ?> type="radio" onclick="SeleccionCaracterAlta(formulario,'presdoc_falta_prov','presdoc_falta_def')" value="<?php echo PRESDOCDEFINITIVO ?>"  <?php echo ($es_modif && $filaprestador["presdoc_caracter_alta"]==PRESDOCDEFINITIVO)?"checked='checked'":"" ?>/> Definitiva						  
							</td>
						</tr>

						<tr>
							<td valign="middle" class="textoEtiqueta" width="25%">Fecha de Alta Provisorio</td>
							<td class="textoEtiquetaDatoResaltado">	
						<?php 	if ($operacion == "B" || $operacion == "V") { ; 
