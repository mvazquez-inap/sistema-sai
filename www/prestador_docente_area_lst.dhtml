<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

//-----------------------------funcion grilla----------------------------------------------
function MostrarGrillaSeleccion($conexion,$areacon,$areagen,$areaesp) 
{	
	$sparam=array( 'ppresdoc_estado' =>PRESDOCACTIVO,'pxareacon_codigo' =>1,'pxareagen_codigo' =>1,'pxareaesp_codigo' =>1,
				  'pareacon_codigo' =>$areacon,'pareagen_codigo' =>$areagen,'pareaesp_codigo' =>$areaesp,
				  'porderby' =>"areacon_descripcion,areagen_descripcion,areaesp_descripcion,presdoc_apellido,presdoc_nombre");
	$spnombre="sel_prestador_docente_prestador_docente_area_xestado_area";	
	if(!$conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
	{
		$error="Error al buscar prestadores docentes.";
		$errormail="Error al buscar prestadores docentes. ".$errno;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
		return false;
	}
	if($numfilas>0)
	{
		$i=1;
		while ($fila=mysqli_fetch_assoc($resultado))	{
			$arrayresult[$i]['presdoc_cuilt']= $fila['presdoc_cuilt'];
			$arrayresult[$i]['presdoc_apellido']= $fila['presdoc_apellido'];
			$arrayresult[$i]['presdoc_nombre']= $fila['presdoc_nombre'];
			$conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","PRESDOCCARACTER","' and constantecod='",$fila['presdoc_caracter_alta'],"'"),$caracterdesc,$numfilascaracter,$errorcod);
			$arrayresult[$i]['presdoc_caracter_alta']= $caracterdesc;
			$arrayresult[$i]['presdoc_falta_prov'] = FuncionesPHPLocal::ConvertirFecha($fila['presdoc_falta_prov'],'aaaa-mm-dd','dd/mm/aaaa');
			$arrayresult[$i]['presdoc_falta_def'] = FuncionesPHPLocal::ConvertirFecha($fila['presdoc_falta_def'],'aaaa-mm-dd','dd/mm/aaaa');
			$arrayresult[$i]['presdoc_email'] = $fila['presdoc_email'];
			$conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$fila['presdoc_prov_codigo'],"'"),$descri_prov,$numfilascaracter,$errorcod); 
			$arrayresult[$i]['presdoc_prov_decripcion'] = $descri_prov;
			$arrayresult[$i]['presdoc_part_loca_descripcion'] = $fila['presdoc_part_loca_descripcion'];
			$i++;
		}
	}
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>$numfilas
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
			
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'CUIT/CUIL');
	$oGrilla->Setear('campo_grilla',$miColumna1,'presdoc_cuilt');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	
	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Apellido');
	$oGrilla->Setear('campo_grilla',$miColumna2,'presdoc_apellido');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna3,'presdoc_nombre');
	$oGrilla->Setear('align_columna',$miColumna3,'left');
	$oGrilla->Setear('ancho_columna',$miColumna3,'20');

	$miColumna7 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna7,'Mail');
	$oGrilla->Setear('campo_grilla',$miColumna7,'presdoc_email');
	$oGrilla->Setear('align_columna',$miColumna7,'left');

	$miColumna8 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna8,'Provincia');
	$oGrilla->Setear('campo_grilla',$miColumna8,'presdoc_prov_decripcion');
	$oGrilla->Setear('align_columna',$miColumna8,'left');

	$miColumna9 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna9,'Localidad');
	$oGrilla->Setear('campo_grilla',$miColumna9,'presdoc_part_loca_descripcion');
	$oGrilla->Setear('align_columna',$miColumna9,'left');

	$miColumna4 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Caracter');
	$oGrilla->Setear('campo_grilla',$miColumna4,'presdoc_caracter_alta');
	$oGrilla->Setear('align_columna',$miColumna4,'left');

	$miColumna5 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna5,'Fecha Alta Provisorio');
	$oGrilla->Setear('campo_grilla',$miColumna5,'presdoc_falta_prov');
	$oGrilla->Setear('align_columna',$miColumna5,'center');

	$miColumna6 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna6,'Fecha Alta Definitivo');
	$oGrilla->Setear('campo_grilla',$miColumna6,'presdoc_falta_def');
	$oGrilla->Setear('align_columna',$miColumna6,'center');

	if (!$oGrilla->CargarGrilla($arrayresult))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
//----------------------------------------------------------------------------------------- 
?>
