					<td> <a href="javascript:Popup('candidato_historial_popup.dhtml?pers_cuilt=<?php echo $fila_candidato['pers_cuilt'] ?>','ventana_persona',540,350,screen.availWidth-560,screen.availHeight-350,'yes');" ><img src="images/searchsai.jpg"  alt="Historial" width="24" height="24" border="0" /></a>					</td>
				
