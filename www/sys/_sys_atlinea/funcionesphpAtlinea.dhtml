<?php

class FuncionesPHPAtlinea
{

//----------------------------------------------------------------------------------------- 
// Genera todas las constantes necesarias para el sistema

	function CargarConstantes($conexion,$tipocarga)
	{
		$conexiongral=new accesoBDAtlinea(getenv("SAI_TABGRALES2C_HOST") ?: "", getenv("SAI_TABGRALES2C_USER") ?: "", getenv("SAI_TABGRALES2C_PASSWORD") ?: "");
		$conexiongral->SeleccionBD("tabgrales2");

		// Constantes Generales
		$spnombre="sel_constantes_grales_xsistemanom";
		$spparam=array('psistemanom'=>"SYSONTI");
		if(!$conexiongral->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
		{
			$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
			$arraymensajepantalla+=array("texto" => "Error al cargar las constantes");
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => $arraymensajepantalla["texto"]." - numfilas='".$numfilas."' - errno='".$errno."' ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			die();
		}
		
		while ($fila = mysqli_fetch_assoc($query))
			if(!defined($fila['constantenom']))
				define ($fila['constantenom'],$fila['constantecod']);

		$conexiongral->CerrarConexion();

		if(isset($tipocarga['roles']))
		{
			// constantes ROL de USUARIOS
			$spnombre="sel_roles_orden";
			$spparam=array('porderby'=>"rolcod" );
			if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
			{
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Error al cargar los roles");
				$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$arraymensajemail+=array("texto" => $arraymensajepantalla["texto"]." - numfilas='".$numfilas."' - errno='".$errno."' ");
				FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				die();
			}

			while ($fila = mysqli_fetch_assoc($query))
				if($fila['rolcod']!=0)
					if(!defined($fila['rolnom']))
						define ($fila['rolnom'],$fila['rolcod']);
		}

		if(isset($tipocarga['tipoorganismo']))
		{
			// Constantes Generales
			$spnombre="sel_tipoorganismos_orden";
			$spparam=array('porderby'=>"tipoorgid" );
			if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
			{
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Error al cargar los tipos de organismos");
				$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$arraymensajemail+=array("texto" => $arraymensajepantalla["texto"]." - numfilas='".$numfilas."' - errno='".$errno."' ");
				FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				die();
			}

		   while ($fila = mysqli_fetch_assoc($query))
				if(!defined($fila['tipoorgnom']))
			   		define ($fila['tipoorgnom'],$fila['tipoorgid']);
		}
		
		if(isset($tipocarga['sistema']))
		{
			// Constantes Generales
			$spnombre="sel_constantes_grales_xsistemanom";
			$spparam=array('psistemanom'=>$tipocarga['sistema']);
			if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
			{
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Error al cargar las constantes");
				$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$arraymensajemail+=array("texto" => $arraymensajepantalla["texto"]." - numfilas='".$numfilas."' - errno='".$errno."' ");
				FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				die();
			}
			
			while ($fila = mysqli_fetch_assoc($query)) 
				if(!defined($fila['constantenom']))
					define ($fila['constantenom'],$fila['constantecod']);
		}

		if(isset($tipocarga['peticinstclase']))
		{
			// Constantes Generales
			$spnombre="sel_peticinstclases_orden";
			$spparam=array('porderby'=>"peticinstclasecod");
			if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
			{
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Error al cargar las constantes");
				$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$arraymensajemail+=array("texto" => $arraymensajepantalla["texto"]." - numfilas='".$numfilas."' - errno='".$errno."' ");
				FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				die();
			}
			
			while ($fila = mysqli_fetch_assoc($query)) 
				if(!defined($fila['peticinstclasenom']))
					define ($fila['peticinstclasenom'],$fila['peticinstclasecod']);
		}

	}
	
//----------------------------------------------------------------------------------------- 
// Usada para el envio automatico de mails, según rol/jurisdiccion

// Retorna true si no hubo problema, 
//		sino retorna false en caso de error al ejecutar el SP para seleccionar los usuarios,
//		por rol inválido o por error al enviar el mail.

	function MandarMail($conexion,$rolcod,$sinusoenatlinea,$subject,$texto)
	{
		switch($rolcod)
		{
			case ADMIONTI:
				$spnombre="sel_mail_usuarios_con_mail_xrol_xmenorestado";
				$spparam =array('prolcod'=>$rolcod,'pusuarioestado'=>GENERAL_USUARIOACT);		
				break;
	
			default:
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Error al generar mail. ");
				$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$arraymensajemail+=array("texto" => $arraymensajepantalla['texto']." Intento de enviar mail a rol inexistente '".$rolcod."'. ");
				FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				return false;
		}
		
		if(!isset($spnombre))
		{
			$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
			$arraymensajepantalla+=array("texto" => "Error al generar mail. ");
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => $arraymensajepantalla['texto']." No se pudo determinar el nombre del stored procedure. ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return false;
		}
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
		{
			$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
			$arraymensajepantalla+=array("texto" => "Error al generar mail. ");
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => $arraymensajepantalla['texto']." Error selección destinatarios - numfilas='".$numfilas."' - errno='".$errno."'. ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return false;
		}
		while($fila=mysqli_fetch_assoc($query))
			if(!mail($fila['usuarioemail'],$subject,$texto))
			{
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Imposible enviar mail. ");
				$arraymensajemail =array();			
				FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_INF,$arraymensajepantalla,$arraymensajemail);
				return false;
			}
		
		return true;	
	}

//----------------------------------------------------------------------------------------- 
// Muestra un mensaje en pantalla y/o envía mail a ADMIONTI

//	Parametros: 
//	$arraymensajepantalla (array asociativo)
//		$arraymensajepantalla['formato']=FMT_TEXTO|FMT_TABLA
//		$arraymensajepantalla['cantcols'] usado para colspan cuando es FMT_TABLA
//		$arraymensajepantalla['texto'] = texto a mostrar por pantalla
//	$arraymensajemail (array asociativo) para enviar mail al administrador definido en la conexion
//		$arraymensajemail['archivo'] = nombre php de llamada
//		$arraymensajemail['funcion'] = nombre función de llamada
//		$arraymensajemail['linea'] = línea de llamada
//		$arraymensajemail['texto'] = texto a mostrar por mail

	function MostrarMensaje($conexion,$nivelmensaje,$arraymensajepantalla,$arraymensajemail=array())
	{
		
		if(count($arraymensajepantalla)>0)
		{ // mostrar el mensaje en pantalla
			if(!isset($arraymensajepantalla['formato']))
				$arraymensajepantalla['formato']=GENERAL_FMT_TEXTO;	
			if(!isset($arraymensajepantalla['texto']))
				$arraymensajepantalla['texto']=" ";
			if ($nivelmensaje==GENERAL_MSG_ERRGRAVE)
				$arraymensajepantalla['texto']=$arraymensajepantalla['texto']."\n\n Avise a su Administrador o a la ONIG.";

			switch($arraymensajepantalla['formato'])
			{
				case GENERAL_FMT_TEXTO:
					echo "<br /><div align='center' class='textonombreclave'>".$arraymensajepantalla['texto']."</div> <br />";	
					break;
				case GENERAL_FMT_TABLA:
					if(!isset($arraymensajepantalla['cantcols']))
						$arraymensajepantalla['cantcols']=1;	
	?>
		<tr>
			<td colspan="<?php echo $arraymensajepantalla['cantcols'] ?>" height="100" align="center" valign="middle">
				<span class='textonombreclave'><?php echo $arraymensajepantalla['texto'] ?></span>
			</td>
		</tr>	
	<?php
					break;
				default:
					echo $arraymensajepantalla['texto'];	
					break;
			}
		}
		if(count($arraymensajemail)>0)
		{ // envio de mail
			if(!isset($arraymensajemail['texto']))
			{
				$arraymensajemail['texto']=" ";
				if(isset($arraymensajepantalla['texto']))
					$arraymensajemail['texto']=$arraymensajepantalla['texto'];
			}
		
			$subjectmail=SISTEMAMOSTRAR;

			switch($nivelmensaje)
			{
				case GENERAL_MSG_OK:
					$subjectmail.=" - Mensaje OK";
					break;
				case GENERAL_MSG_INF:
					$subjectmail.=" - Mensaje Informativo";
					break;
				case GENERAL_MSG_ERRGRAVE:
					$subjectmail.=" - Error de Inconsistencia de Datos";
					break;
				case GENERAL_MSG_ERRSOSP:
					$subjectmail.=" - Error Datos Sospechosos";
					break;
				case GENERAL_MSG_ERRPGM:
					$subjectmail.=" - Error en Programa";
					break;
				default:
					$subjectmail.=" - Nivel de mensaje no definido";
					break;
			}

			$textomail ="\nMensaje:\n".$arraymensajemail['texto']."\n\n";
			$textomail.="Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";
			if(isset($arraymensajemail['archivo']))
				$textomail.="Ubic Archivo:       ".$arraymensajemail['archivo']."\n";
			if(isset($arraymensajemail['funcion']))
				$textomail.="Ubic Función:       ".$arraymensajemail['funcion']."\n";
			if(isset($arraymensajemail['linea']))
				$textomail.="Ubic Línea:         ".$arraymensajemail['linea']."\n";

			if(isset($_SESSION['usuariocod']) && $_SESSION['usuariocod']!=0)
			{
				$textomail.="\nUsuario sesion:     ".$_SESSION['usuariocod']." - ";
				if($conexion->TraerCampo("usuarios","concat(usuarionombre,' ',usuarioapellido)",array("usuariocod='",$_SESSION['usuariocod'],"'" ),$nombreusuario,$numfilas,$errno))
					$textomail.=$nombreusuario;
			}
			if(isset($_SESSION['rolcod']) && $_SESSION['rolcod']!=0)
			{
				$textomail.="\nRol sesion:         ".$_SESSION['rolcod']." - ";
				if($conexion->TraerCampo("roles","roldesc",array("rolcod='",$_SESSION['rolcod'],"'" ),$nombrerol,$numfilas,$errno))
					$textomail.=$nombrerol;
			}
			if(isset($_SESSION['mesaayudacod']) && $_SESSION['mesaayudacod']!=0)
			{
				$textomail.="\nMesa Ayuda sesion:  ".$_SESSION['mesaayudacod']." - ";
				if($conexion->TraerCampo("mesasayuda","mesaayudanom",array("mesaayudacod='",$_SESSION['mesaayudacod'],"'" ),$nombremesaayuda,$numfilas,$errno))
					$textomail.=$nombremesaayuda;
			}

			FuncionesPHPAtlinea::MandarMail($conexion,$conexion->VerAdmiGeneral(),"",$subjectmail,$textomail);
		}
	}

//----------------------------------------------------------------------------------------- 
// Registra el acceso de un usuario en el sistema

	function RegistrarAcceso($conexion,$codigo_mensaje,$acciondesc,$usuariocod) 
	{
		$archivonom=substr(strrchr($_SERVER['PHP_SELF'],'/'),1);
	
		if($usuariocod=='')
			$usuariocod=0;
		
		$spnombrelog='ins_logusuarios';
		$spparamlog =array('pcodigo_mensaje'=>$codigo_mensaje);
		$spparamlog+=array('pacciondesc'=>$acciondesc);
		$spparamlog+=array('pnumeroip'=>$_SERVER['REMOTE_ADDR']);
		$spparamlog+=array('parchivonom'=>$archivonom);
		$spparamlog+=array('pfecha'=>date('Y/m/d H:i:s'));
		$spparamlog+=array('pusuariocod'=>$usuariocod);
	
		if(!$conexion->ejecutarStoredProcedure($spnombrelog,$spparamlog,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$textoerror="Error registrar_acceso ".$errno." - ".$conexion->TextoError();
			// MANDAR MAIL con los parámetros de la llamada errónea
				
			$subjectmail=SISTEMAMOSTRAR." - Error en registrar acceso";
			$textomail ="Se ha producido un error en '".$_SERVER['PHP_SELF']."' \n\n";
			if($usuariocod!=0)
			{
				if(!$conexion->TraerCampo("usuarios","concat(usuarionombre,' ',usuarioapellido)",array("usuariocod='",$usuariocod,"'" ),$nombreusuario,$numfilas,$errno))
					$textomail.="Usuario '".$nombreusuario."'\n\n";
			}
			$textomail.="Parámetros de acceso \n";
			$textomail.="  pcodigo_mensaje '".$codigo_mensaje."'\n";
			$textomail.="  pacciondesc '".$acciondesc."'\n";
			$textomail.="  pnumeroip '".$_SERVER['REMOTE_ADDR']."'\n";
			$textomail.="  parchivonom '".$archivonom."'\n";
			$textomail.="  pfecha '".date('Y/m/d H:i:s')."'\n";
			$textomail.="  pusuariocod '".$usuariocod."'";
			FuncionesPHPAtlinea::MandarMail($conexion,$conexion->VerAdmiGeneral(),"",$subjectmail,$textomail);
			return false;
		}
		return true;
	}
//----------------------------------------------------------------------------------------- 
// Arma un combo que recarga la página según la opción seleccionada

// Parametros:
// 		->spnombre y spparam se usan para armar el query
// 		->nomformulario es el nombre del formulario sobre el que está el combo
// 		->nombrecombo es el nombre del combo
// 		->clavecombo y desccombo son campos del query con los que arma el combo
// 		->querystring lo coloca despues del nombre del php
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que exista una variables GET con el nombre del combo y coincide con algun registro del query, retorna la fila
// 		->seleccionado, en caso que se haya seleccionado un option del combo

	function ArmarCombo_BD($conexion,$spnombre,$spparam,$nomformulario,$nombrecombo,$clavecombo,$desccombo,$querystring,$textolineauno,&$regactual,&$seleccionado)
	{
		// Cargo los registros del query seleccionado
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$num_filas,$errno))
		{
			$arraymensajepantalla =array();	
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => "Error en carga de los registros seleccionados para el combo - numfilas='".$num_filas."' - errno='".$errno."'. ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return false;
		}	

		// Genera codigo JavaScript para autollamarse cuando selecciona un elemento del combo
		echo "<SCRIPT LANGUAGE='JavaScript' type='text/javascript'>\n";
		echo "<!--\n";
		
		echo "function ".$nombrecombo."_newpage() {\n";
	
		$temp="";
		if($querystring!='')
			$temp="?";
	
		echo "if(document.".$nomformulario.".".$nombrecombo.".selectedIndex==0)\n";
		echo "    location='".$_SERVER['PHP_SELF'].$temp.$querystring."';\n";
		echo "else\n";
	
		if($querystring!='')
			$querystring.="&";
	
		echo "    location='".$_SERVER['PHP_SELF']."?".$querystring.$nombrecombo."='+document.".$nomformulario.".".$nombrecombo."[document.".$nomformulario.".".$nombrecombo.".selectedIndex].value;\n";
		echo "}\n";
		
		echo "//-->\n";
		echo "</SCRIPT>\n";
	
		// Generación del combo, poniendo como primera linea $textolineauno
		echo "<select name='".$nombrecombo."' size=1 onChange='".$nombrecombo."_newpage();' class='combos' style='width: 370px;'>\n";
		echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>\n";
		$seleccionado=false;
		if($num_filas>0) 
		{
			// Recorre el cursor desde el principio, poniendo cada fila en una linea del combo
			$textopopup='';
			while ($fila = mysqli_fetch_assoc($query))
			{ 
				if(isset($_GET[$nombrecombo]) && $fila[$clavecombo]==$_GET[$nombrecombo]) 
				{
					echo "<option selected value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
					$seleccionado=true;
					$regactual=$fila;
					$textopopup=$fila[$desccombo];
				}
				else
					echo "<option value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
			}
		}
	
		echo("</select>\n");
		if(isset($textopopup))
			echo "<br /><a href='javascript:void(0)' onClick=\"javascript:popup('ventanatexto.dhtml?textopopup='+".$nomformulario.".".$clavecombo."[".$nomformulario.".".$clavecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkfondoblanco'><span class='textoaclaraciones'>Ver texto completo</span></a>\n";
		else
			echo "<div style='font-size: 7px;'>&nbsp;</div>\n";
	}
//----------------------------------------------------------------------------------------- 
// Arma un combo con la informacion del SP enviado

// Parametros:
// 		->spnombre y spparam se usan para armar el query
// 		->nomformulario es el nombre del formulario sobre el que está el combo
// 		->nombrecombo es el nombre del combo
// 		->clavecombo y desccombo son campos del query con los que arma el combo
// 		->claveselec es el registro que hay que seleccionar
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que se haya seleccionado un option se retorna la fila completa
// 		->seleccionado, en caso que se haya seleccionado un option del combo
//		->$filas, si es 1, es un combo, sino es una lista
//		->$onchange: la accion javascript al momento de seleccionar un elemento de la lista
//		->$style: estilo a aplicar sobre el combo
//		->$vertextocompleto: indica si se muestra el link abajo para ver texto completo

	function ArmarCombo_SinSalto_BD($conexion,$spnombre,$spparam,$nomformulario,$nombrecombo,$clavecombo,$desccombo,$claveselec,$textolineauno,&$regactual,&$seleccionado,$filas=1,$onchange="",$style="width: 370px;",$vertextocompleto=true)
	{
		// Cargo los registros del query seleccionado
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$num_filas,$errno))
		{
			$arraymensajepantalla =array();	
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => "Error en carga de los registros seleccionados para el combo - numfilas='".$num_filas."' - errno='".$errno."'. ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return false;
		}	

		// Generación del combo, poniendo como primera linea $textolineauno
		echo "<select name='".$nombrecombo."' size='".$filas."' class='combos' style='".$style."' onchange='".$onchange."'>\n";
		if($filas==1)
			echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>\n";

		$seleccionado=false;
		if($num_filas>0) 
		{
			// Recorre el cursor desde el principio, poniendo cada fila en una linea del combo
			while ($fila = mysqli_fetch_assoc($query))
			{ 
				if($fila[$clavecombo]==$claveselec) 
				{
					echo "<option selected='selected' value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
					$seleccionado=true;
					$regactual=$fila;
				}
				else
					echo "<option value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
			}
		}
	
		echo("</select>\n");
		if($filas==1 && $vertextocompleto)
			echo "<br /><a href='javascript:void(0)' onclick=\"javascript:popup('ventanatexto.dhtml?textopopup='+".$nomformulario.".".$nombrecombo."[".$nomformulario.".".$nombrecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkfondoblanco'><span class='textoaclaraciones'>Ver texto completo</span></a>\n";
	}

//----------------------------------------------------------------------------------------- 
// Arma un combo en base a la informacion proveniente en un array. Con salto.

// Parametros:
// 		->valores_combo: array asociativo, del que salen los valores para el combo
//			valores_combo=array(1=>array($clavecombo=>"valor",$desccombo=>"valor"),2=>array($clavecombo=>"valor",$desccombo=>"valor"))
// 		->nomformulario es el nombre del formulario sobre el que está el combo
// 		->nombrecombo es el nombre del combo
// 		->clavecombo y desccombo son campos del array con los que arma el combo
//		->querystring es el string que se agrega a la linea
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que se haya seleccionado un option se retorna la fila completa
// 		->seleccionado, en caso que se haya seleccionado un option del combo

	function ArmarCombo_deArray($valores_combo,$nomformulario,$nombrecombo,$clavecombo,$desccombo,$querystring,$textolineauno,&$regactual,&$seleccionado) 
	{
		$seleccionado=false;
		$regactual=array();
		
		// Genera codigo JavaScript para autollamarse cuando selecciona un elemento del combo
		echo "<SCRIPT LANGUAGE='JavaScript' type='text/javascript'>\n";
		echo "<!--\n";
		
		echo "function ".$nombrecombo."_newpage() {\n";
	
		$temp="";
		if($querystring!='')
			$temp="?";
	
		echo "if(document.".$nomformulario.".".$nombrecombo.".selectedIndex==0)\n";
		echo "    location='".$_SERVER['PHP_SELF'].$temp.$querystring."';\n";
		echo "else\n";
	
		if($querystring!='')
			$querystring.="&";
	
		echo "    location='".$_SERVER['PHP_SELF']."?".$querystring.$nombrecombo."='+document.".$nomformulario.".".$nombrecombo."[document.".$nomformulario.".".$nombrecombo.".selectedIndex].value;\n";
		echo "}\n";
		
		echo "//-->\n";
		echo "</SCRIPT>\n";
	
		// Generación del combo, poniendo como primera linea $textolineauno
		echo "<select name='".$nombrecombo."' size=1 onChange='".$nombrecombo."_newpage();' class='combos' style='width:370px'>\n";
		echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>\n";
	
		foreach($valores_combo as $optioncombo)
		{
			// Recorre el array, poniendo cada fila en una linea del combo
			echo "<option ";
	
			if(isset($_GET[$nombrecombo]) && $optioncombo[$clavecombo]==$_GET[$nombrecombo]) 
			{
				echo " selected ";
				$seleccionado=true;
				$regactual=$optioncombo;
			}
			
			echo " value='".htmlspecialchars($optioncombo[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($optioncombo[$desccombo],ENT_QUOTES);
			echo "</option>\n";
		}
	
		echo("</select>\n");
			
		echo "<br /><a href='javascript:void(0)' onClick=\"javascript:popup('ventanatexto.dhtml?textopopup='+formulario.".$nombrecombo."[formulario.".$nombrecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkfondoblanco'><span class='textoaclaraciones'>Ver texto completo</span></a>";
	}	

//----------------------------------------------------------------------------------------- 
// Arma un combo en base a la informacion proveniente en un array. Con salto.

// Parametros:
// 		->valores_combo: array asociativo, del que salen los valores para el combo
//			valores_combo=array(1=>array($clavecombo=>"valor",$desccombo=>"valor"),2=>array($clavecombo=>"valor",$desccombo=>"valor"))
// 		->nomformulario es el nombre del formulario sobre el que está el combo
// 		->nombrecombo es el nombre del combo
// 		->clavecombo y desccombo son campos del array con los que arma el combo
//		->querystring es el string que se agrega a la linea
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que se haya seleccionado un option se retorna la fila completa
// 		->seleccionado, en caso que se haya seleccionado un option del combo
//		->$filas, si es 1, es un combo, sino es una lista
//		->$onchange: la accion javascript al momento de seleccionar un elemento de la lista
//		->$style: estilo a aplicar sobre el combo

	function ArmarCombo_SinSalto_deArray($valores_combo,$nomformulario,$nombrecombo,$clavecombo,$desccombo,$claveselec,$textolineauno,&$regactual,&$seleccionado,$filas=1,$onchange="",$style="width: 370px;",$vertextocompleto=true) 
	{
		$seleccionado=false;
		$regactual=array();
			
		// Generación del combo, poniendo como primera linea $textolineauno
		echo "<select name='".$nombrecombo."' size='".$filas."' onchange='".$onchange."' class='combos' style='".$style."'>\n";
		
		if($filas==1)
			echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>\n";
	
		foreach($valores_combo as $optioncombo)
		{
			// Recorre el array, poniendo cada fila en una linea del combo
			echo "<option ";
	
			if($optioncombo[$clavecombo]==$claveselec) 
			{
				echo " selected='selected' ";
				$seleccionado=true;
				$regactual=$optioncombo;
			}
			
			echo " value='".htmlspecialchars($optioncombo[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($optioncombo[$desccombo],ENT_QUOTES);
			echo "</option>\n";
		}
	
		echo("</select>\n");
			
		if($filas==1 && $vertextocompleto)
			echo "<br /><a href='javascript:void(0)' onClick=\"javascript:popup('ventanatexto.dhtml?textopopup='+".$nomformulario.".".$nombrecombo."[".$nomformulario.".".$nombrecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkfondoblanco'><span class='textoaclaraciones'>Ver texto completo</span></a>\n";
	}	

//----------------------------------------------------------------------------------------- 
// Si existe la variable en el QUERY_STRING,
// elimina todo desde ahi en adelante

	function ArmarQueryString($variable)
	{
		// si no se informa $querystring, 
		// se toma el el querystring del server 
/*		if($querystring=="")
			$querystring=$_SERVER['QUERY_STRING'];
		
		// si existe en el querystring la variable $variable, se elimina
		// para asegurarse que el nombre de la variable es exacto:
		
		// Primero se buscan variables intermedias
		// 1- se agrega a variable un '&' al principio
		// 2- se agrega a variable un '=' al final
		$variablebusq="&amp;".$variable."=";  
		$posicion=strpos($querystring,$variablebusq);
		if($posicion>0)
			return substr($querystring,0,$posicion);
		
		// Si no se encontró, se busca si es la primera variable
		$variablebusq=$variable."=";  
		$posicion=strpos($querystring,$variablebusq);
		if($posicion===false)
			return $querystring;
		elseif($posicion==0)
			return "";
		else
			return $querystring;*/

		// si existe en el get la variable $variable, la elimino
		if(isset($_GET[$variable]))
		{
			$posicion=strpos($_SERVER['QUERY_STRING'],$variable);
			if($posicion===false)
				return str_replace("&","&amp;",$_SERVER['QUERY_STRING']);
			elseif($posicion==0)
				return "";
			else	
				return str_replace("&","&amp;",substr($_SERVER['QUERY_STRING'],0,$posicion-1));
		}
		else
			return str_replace("&","&amp;",$_SERVER['QUERY_STRING']);

	}

//----------------------------------------------------------------------------------------- 
//	Arma el array para agregar datos de las jurisdicciones generales
//  en los combos 
//  Busca si las jurisdicciones pasadas en el array están en 
//  JurisdiccionesAtlinea y completa sus datos
//  El array info tiene que ser de la forma clave=>datos 
//  donde datos es un array que por lo menos tiene "jurisdid"=>nn

	function ArmarArrayComboconJurisd($conexion,$arraybusqdonde,&$arrayinfo)
	{
		$jurisdicciones = new SysONTIjurisdicciones2(VERSIONID_JURISD);

		foreach ($arraybusqdonde as $donde) 
		{
			if($donde=='atlinea')
			{	
				$spnombrejurisd="sel_jurisdiccionesatlinea_xjurisdhabil_orden";
				$spparamjurisd=array("pjurisdhabil"=>array('("',"S",'","',"N",'")'),"porderby"=>"jurisdid");
			
				if(!$conexion->ejecutarStoredProcedure($spnombrejurisd,$spparamjurisd,$queryjurisd,$numfilasjurisd,$errno))
				{
					$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
					$arraymensajepantalla+=array("texto" => "Error BD en selección de JurisdiccionesAtlinea. ");
					$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
					FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
					return false;
				}
			} // $donde=='atlinea'
		} // foreach

		reset($arrayinfo);
		foreach($arrayinfo as $claveinfo => $datosinfo)
		{
			if($donde=='grales')
			{				
				if(!$jurisdicciones->SelectJurisdxID($datosinfo['jurisdid'],array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$filaret,array(),$NumFilas,$CodError))
				{
					$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
					$arraymensajepantalla+=array("texto" => "Error obteniendo el organismo de jurisdicciones generales - jurisdid='".$datosinfo['jurisdid']."'. ");
					$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
					FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
					return false;
				}
				$filajurisd = current($filaret);
				$arrayinfo[$claveinfo]=array_merge($datosinfo, $filajurisd);
			}		

			if(!$jurisdicciones->SelectTipoOrgxID($arrayinfo[$claveinfo]["torgid"],array(),TABGRALES_TS_ARRAY,$filaret,array(),$NumFilas,$CodError))
			{
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Error obteniendo el organismo de jurisdicciones generales - jurisdid='".$datosinfo['jurisdid']."'. ");
				$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				return false;
			}
			
			$arrayinfo[$claveinfo]["torgnivel"]=$filaret[$arrayinfo[$claveinfo]["torgid"]]["torgnivel"];
		}

		reset($arrayinfo);
		foreach($arrayinfo as $claveinfo => $datosinfo)
		{
			if($donde=='atlinea')
			{
				$arrayinfo[$claveinfo]['jurisdestaenatlinea']="N";
				$arrayinfo[$claveinfo]['jurisdhabil']="N";
				$arrayinfo[$claveinfo]['jurisdrelevante']="N";
				$arrayinfo[$claveinfo]['mesaayudacod']="";
			
				mysqli_data_seek($queryjurisd,0);
				$encontrado=false;
		
				if($numfilasjurisd>0)
				{
					while(!$encontrado && $filajurisd=mysqli_fetch_assoc($queryjurisd))
					{
						if($datosinfo['jurisdid']==$filajurisd["jurisdid"])
						{
							$encontrado=true;
							$arrayinfo[$claveinfo]['jurisdestaenatlinea']="S";
							$arrayinfo[$claveinfo]['jurisdhabil']=$filajurisd['jurisdhabil'];
							$arrayinfo[$claveinfo]['jurisdrelevante']=$filajurisd['jurisdrelevante'];
							if($conexion->TraerCampo("mesasayuda_jurisdiccion","mesaayudacod",array("jurisdid='",$datosinfo['jurisdid'],"'"),$mesaayudacod,$numfilasmayuda,$errno) && $numfilasmayuda==1)
								$arrayinfo[$claveinfo]['mesaayudacod']=$mesaayudacod;
						}
					}
				}
			} // $donde=='atlinea'	
/*			if($donde=='grales')
			{				
				if(!$jurisdicciones->SelectJurisdxID($datosinfo['jurisdid'],array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$filaret,array(),$NumFilas,$CodError))
				{
					$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
					$arraymensajepantalla+=array("texto" => "Error obteniendo el organismo de jurisdicciones generales - jurisdid='".$datosinfo['jurisdid']."'. ");
					$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
					FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
					return false;
				}
				$filajurisd = current($filaret);
				$arrayinfo[$claveinfo]=array_merge($datosinfo, $filajurisd);
			}	*/	

			// se arman descripciones para combos
			$arrayinfo[$claveinfo]['jurisd_con_guiones']=str_repeat("--",$arrayinfo[$claveinfo]['torgnivel']-1)." ".$arrayinfo[$claveinfo]['jurisdnom'];
			$arrayinfo[$claveinfo]['jurisd_con_puntos']=str_repeat("..",$arrayinfo[$claveinfo]['torgnivel']-1)." ".$arrayinfo[$claveinfo]['jurisdnom'];
			$arrayinfo[$claveinfo]['jurisd_con_jurisdid']=str_repeat("  ",$arrayinfo[$claveinfo]['torgnivel']-1).$arrayinfo[$claveinfo]['jurisdid']."-".$arrayinfo[$claveinfo]['jurisdnom'];
//echo "ojobea1 - ArmararrayinfoCombo <br>";
//echo "jurisdid /".$arrayinfo[$claveinfo]['jurisdid']."/ <br>";
//echo "datosinfo /";
//print_r($datosinfo);
//echo "/<br>";
//echo "ojobea2 - arrayinfo /";
//print_r($arrayinfo[$claveinfo]);
//echo "/<br><br>";
//echo "ojobea3 - arrayinfo /";
//print_r($arrayinfo[$claveinfo]);
//echo "/<br>";
//return true; // después sacar y dejar el otro return
		}	
		return true;
	}

//----------------------------------------------------------------------------------------- 
// Valida el contenido del campo según tipovalidacion

	function ValidarContenido($conexion,$campo,$tipovalidacion)
	{
		switch($tipovalidacion)
		{
			case "AlfanumericoPuro": // campo alfanumerico sin caracteres especiales
				if ( strspn(strtoupper($campo), '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ' ) != strlen($campo) ) 
					return false;
				break;
			case "CUIT": // 11 posiciones numericas con digito mod.11
				if ( strspn($campo, '0' ) == strlen($campo) ) 
					return false;

				if(!preg_match("#^[0-9]{11}$#i",$campo))
					return false;
					
				$array_factor_peso = array(5,4,3,2,7,6,5,4,3,2);
				$suma=0;
				$digito_verificador=0;
 
 				for ($i=0; $i<=9; $i++)  
					$suma=$suma+(substr($campo,$i,1)*$array_factor_peso[$i]); 	
			
				$digito_verificador=11-($suma%11);
				
				if ($digito_verificador == 11)
					$digito_verificador = 0;
			
				if ($digito_verificador!=substr($campo,10,1)) 
					return false; 
				break;
			case "Email": // campo alfanumerico con algunos caracteres especiales (emails)
				if(!preg_match("#^[\._a-z0-9]+@([a-z0-9]+[\.]{1}){1,2}[a-z]{2,4}([\.]{1}[a-z]{2}){0,1}$#i",$campo))
					return false;
				break;
			case "FechaDDMMAAAA": // valida fecha en formato DD/MM/AAAA
				if(!preg_match("#^[0-9]{2}/[0-9]{2}/[0-9]{4}$#i",$campo))
					return false;	
				list($dia, $mes, $anio) = preg_split ('#/#', $campo); 
				if(!checkdate($mes, $dia, $anio))
					return false;
				break;
			case "Hexa6Digitos": // color semáforo
				if(!preg_match("#^[0-9A-F]{6}$#i",$campo))
					return false;
				break;
			case "Jurisdiccion": // campo numerico con puntos (sólo para Jurisdicciones)
				if(!preg_match("#^[0-9]{2}\.([0-9]{3}\.([0-9a-zA-Z ]{2}\.){0,7}){0,1}$#i",$campo))
					return false;
				break;
			case "NumericoEntero": // campo numerico entero
				if ( strspn($campo, '0123456789' ) != strlen($campo) ) 
					return false;
				break;
			case "Numerico2Decimales": // campo numerico con 2 decimales maximo
				if(!preg_match("#^[0-9]+(,[0-9]{1,2}){0,1}$#i",$campo))
					return false;
				break;
			case "Periodo": // campo MM/AAAA
				if(!preg_match("#^[0-9]{2}/[0-9]{4}$#i",$campo))
					return false;
			
				$anio = substr($campo,3,4);
				$mes = substr($campo,0,2);
				if(($anio < 2000) || ($anio > 2050) || ($mes < 1) || ($mes > 12))
				   return false;
					
				break;	
			default:
				$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
				$arraymensajepantalla+=array("texto" => "Validación no definida. ");
				$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$arraymensajemail+=array("texto" => $arraymensajepantalla['texto']." '".$tipovalidacion."'. ");
				FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
				return false;
				break;
		}
		return true;
	}

//----------------------------------------------------------------------------------------- 
// Valida la clave

	function ValidarPassword($clave,$claveactual,$identificacion,$longmin)
	{
		$i = 0;
		$p = 0; // codigo de error que se produjo
		$c3 = 1; // cantidad de letras iguales secuenciales
		$a = 0; // mantiene el codigo ascii al recorrer la clave para las validaciones
		$sa = 1; // cantidad de letras consecutivas segun abecedario
		$sd = 1; // cantidad de letras consecutivas segun abecedario inverso
		$pa = 0; // mantiene la cantidad de caracteres iguales entre la nueva clave y la clave actual
		$ca = 0; // cuenta la cantidad de letras
		$cn = 0; // cuenta la cantidad de numeros
		$ant = 0; // mantiene un registro de la letra anterior
		$layout = array(); // array que contiene secuencia de caracteres comunes
	
		$layout[] = "QWERT";
		$layout[] = "TREWQ";
		$layout[] = "ASDFG";
		$layout[] = "GFDSA";
		$layout[] = "ZXCVB";
		$layout[] = "BVCXZ";
	
		if (strlen($clave)<$longmin)
			$p=12;
	
		$UsrId = strrev($identificacion); // contiene la identificacion al reves
	
		// Verifica si la clave contiene a la identificacion (al derecho y al reves)
		if(strpos($identificacion,$clave)!==false || strpos($clave,$identificacion)!==false)
			$p = 9;
		else
			if(strpos($UsrId,$clave)!==false || strpos($clave,$UsrId)!==false)
				$p = 10;
	
		// Verifica si la clave contiene una secuencia de caracteres comunes
		if ($p == 0)
		{
			for ($i = 0; $i < count($layout); $i++)
			{
				if (strpos(strtoupper($clave),$layout[$i])!== false)
				{
					$p = 6;
					break;
				}
			}
		}
	
		if ($p == 0)
		{
			for ($i = 0; $i < strlen($clave); $i++)
			{
				$a = ord(substr($clave,$i,1));

				if ($a >= 48 && $a <= 57)
					$cn++;
				else
					if (($a >= 65 && $a <= 90) || ($a >= 97 && $a <= 122))
						$ca++;
	
				if ($a == $ant)
				{
					if (++$c3 > 3) // si tengo mas de 3 letras iguales consecutivas
					{
						$p = 2;
						break;
					}
				}
				else
				{
					$c3 = 1;
					if ($ant == $a - 1)
					{
						if (++$sa > 3) // mas de 3 letras consecutivas segun abecedario
						{
							$p = 4;
							break;
						}
						$sd = 1;
					}
					else
					{
						if ($ant == $a + 1)
						{
							if (++$sd > 3) // mas de 3 letras consecutivas segun abecedario inverso
							{
								$p = 5;
								break;
							}
							$sa = 1;
						}
						else
						{
							$sa = 1;
							$sd = 1;
						}
					}
				}
	
				if ($a == ord(substr($claveactual,$i,1)))
				{
					if (++$pa > 5) // si tiene mas de 5 caracteres iguales que la clave actual
					{
						$p = 14;
						break;
					}
				}
	
				$ant = $a;
	
			}
		}
	
		if ($p == 0 && (($ca + $cn) != strlen($clave))) // si la cantidad de letras y numeros es distinta al largo total, entonces hay caracteres especiales
			$p = 11;

		if ($p != 0)
			return false;
		else
			return true;
	}
//----------------------------------------------------------------------------------------- 
// Si la Mesa de Ayuda es General, se cambia el rol de sesión por el que corresponda
	function AsignarRolesVirtuales($conexion)
	{
		if(!isset($_SESSION['mesaayudacod']))
			return true;
		if($_SESSION['mesaayudacod']=="")
			return true;
		if($_SESSION['mesaayudacod']==0)
			return true;

		if(!$conexion->TraerCampo("mesasayuda","mesaayudatipo",array("mesaayudacod='",$_SESSION['mesaayudacod'],"'"),$mesaayudatipo,$numfilasmayuda,$errno) || $numfilasmayuda!=1)
		{
			$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
			$arraymensajepantalla+=array("texto" => "Error BD selección de Mesa de Ayuda '".$_SESSION['mesaayudacod']."'. ");
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => $arraymensajepantalla['texto']." \nError='".$errno."'. ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return false;
		}

		if($mesaayudatipo!=MESAAYUDAGENERAL)
			return true;
			
		if(!$conexion->TraerCampo("roles","rolgeneralcod",array("rolcod='",$_SESSION['rolcod'],"'"),$rolgeneralcod,$numfilasrol,$errno) || $numfilasrol!=1)
		{
			$arraymensajepantalla =array("formato" => GENERAL_FMT_TEXTO);	
			$arraymensajepantalla+=array("texto" => "Error BD selección de Rol '".$_SESSION['rolcod']."'. ");
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => $arraymensajepantalla['texto']." \nError='".$errno."'. ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return false;
		}

		$_SESSION['rolcod']=$rolgeneralcod;
		return true;
	}
