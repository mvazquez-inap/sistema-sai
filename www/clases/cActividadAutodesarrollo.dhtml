				if ($jurisdicciones->SelectJurisdxID($filaautodesarrollo['actividad_autodesarrollo_evento']['jurisdid_apn'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError))  {
					echo  nl2br(htmlspecialchars($fila_jurisd[$filaautodesarrollo['actividad_autodesarrollo_evento']['jurisdid_apn']]['jurisdnom'],ENT_QUOTES)); 
				}					
					?>
				</td>
			</tr>
<?php			} ?>

