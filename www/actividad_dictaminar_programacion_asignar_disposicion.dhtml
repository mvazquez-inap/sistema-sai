						<?php				if( ($es_modif_agente || $tiene_asignacion) && $oEscalafon->TraerDatosCompletosEscalafon($fila_asignacion["escalafcod"],$fila_asignacion["agrupcod"],$fila_asignacion["escalafnivcod"],$fila_asignacion["escalaftramocod"],$fila_asignacion["escalafgradocod"],$texto_salida))
