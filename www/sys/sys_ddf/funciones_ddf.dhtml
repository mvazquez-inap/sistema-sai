<?php 
require_once("SysONTIjurisdicciones2.dhtml");
//----------------------------------------------------------------------------------------- 
// Retorna: En caso de un password válido => True y 
//											 msg_tipo ="OK" 
//			En caso de un password válido => False y 
//											 msg_tipo ="Descripcion de los errores detectados "
//
//----------------------------------------------------------------------------------------- 
function ValidarNuevoPassword($clave,&$msg_err) {

$valido = true;
$msg_err = "";

// Longitud de la clave
if (strlen($clave)<7) {
	$msg_err="debe ser de longitud mayor o igual a 7";
	$valido = false;
}

// Ultimo error con "y" y "." final. 
// No comience o termine con blancos
if (substr($clave,0,1)==" " || substr($clave,strlen($clave)-1,1)==" ") {
	$msg_err=($valido)?" ":$msg_err." y ";
	$msg_err=$msg_err."no puede comenzar o terminar con blancos";
	$valido = false;
}

// Ver si ponemos números y letras o no u otras validaciones!!!
if ($valido)
	$msg_err = "OK";
else 	
	$msg_err=$msg_err.".";

return $valido;
}
//----------------------------------------------------------------------------------------- 
// FUNCIONES PARA LA BUSQUEDA DE FUNCIONARIOS, ORGANISMOS Y CARGOS
// ---------------------------------------------------------------------------------------------------------------- 
// Busca los organismos, por nombre del organismo ordenando el resultado cualquiera de los criterios posibles
// 		1) Se obtiene la cantidad de organismos que cumplen con el filtro seleccionado.
//		2) Se obtiene todos los organismos que cumplan con el filtro seleccionado.
//			Si el orden es por organismo se limitan y ordenan los registros de salida.
// 		    en otro caso no se limita ni ordena.
//		 4) A todas las jurisdicciones halladas en (2), les pega si existe
//			a) los datos del cargo ( si esta activo o vacante).
//			b) los datos del funcionario del cargo.  	
//		 5) En caso de no ser el orden por jurisdicción, en otro caso ya esta ordenado.
//			Se ordena (4) según el criterio deseado y limita la cantidad de registros de la salida.
// ---------------------------------------------------------------------------------------------------------------- 
function ObtenerOrganismosxJurisd($idconexion,$objJurisdicciones,$oper_campo,$valor_buscado,
								  $orden,$inicio,$resu_x_pag,$numero_pagina,&$cant_total,&$array_func) {

	$array_func=array();

	// No debiera pero no tengo la funcionalidad para sacar la Raiz
    //$arrayin=array_merge(array(' and '),InTipoOrgDepEjeNacional($objJurisdicciones));
    //$arrayin=array_merge($arrayin,array(" and jurisdarboltiponodo != 'R'" ));

	// todos los tipos de Organismo hasta Dirección Simple
    //$arrayin=array_merge(array(' and '),InTipoOrgDepEjeNacional($objJurisdicciones));
	$arrayin=array("and jurisdid!=".$objJurisdicciones->IdNodoNAC_EJ());
	
	// Saco la cantidad total de jurisdicciones que cumplen la condición sobre el nombre
	if (!$objJurisdicciones->SelectCantJurisdxCampo("jurisdnom",$oper_campo,$valor_buscado,array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'pjurisdwhere'=>$arrayin),$cant_total,$CodError))
		return false;
	
	if ($cant_total==0) 
		return true;
	
	// Saco los organismos segun el criterio 
	//	si el orden es por organismo se ordena y limita los registros a los posibles en una pagina
	//  en caso contrario no se ordena ni limita la salida.
	if (trim(strtolower($orden)) == 'jurisdnom asc' || trim(strtolower($orden)) == 'jurisdnom desc')
		$param_juris=array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'pjurisdwhere'=>$arrayin,'pjurisdorden'=>$orden,'pjurisdlimit'=>$inicio.",".$resu_x_pag);
	else
		$param_juris=array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'pjurisdwhere'=>$arrayin);
	
	if (!$objJurisdicciones->SelectJurisdxCampo("jurisdnom",$oper_campo,$valor_buscado,$param_juris,TABGRALES_TS_ARRAY,$array_jurisd,array(),$NumFilas,$CodError))
		return false;

	// Armo el arreglo de salida con todos los datos 
	// organismo /cargo (de existir) / funcionario (de existir).
	$array_func_local=array();
	$i=0;
	foreach($array_jurisd as $clave=>$valor) {

		// Obtengo el cargo en caso de existir
		$arrayin=ArrayToArray_Delimitado(array($valor['jurisdid'])," ", ","," " );	

		$param=array('pcarg_estado'=>CARGO_ACT.",".CARGO_VACANTE, 'pjurisdid'=>$arrayin);
		if( ($query_cargos=ejecutarStoredProcedure($idconexion,'sel_cargo_xjurisdid_estado',$param)) < 0 ) 
			return false;

		$array_dato_func=array();

		if (mysqli_num_rows($query_cargos)==1) {
			$fila_cargo=mysqli_fetch_assoc($query_cargos);
			$array_dato_func[$fila_cargo['jurisdid']]=$fila_cargo;
		}
		
		if (!ObtenerDatosFuncionarioBusq($idconexion,$array_dato_func[$clave]['carg_codigo'],$fila_func))
			return false;

		$fila_func+=array('jurisdnom'=>$valor['jurisdnom']);

		if (array_key_exists($clave,$array_dato_func)) { 
			$fila_func+=array('carg_codigo'=>$array_dato_func[$clave]['carg_codigo']);
			$fila_func+=array('carg_nombre'=>$array_dato_func[$clave]['carg_nombre']);
			$fila_func+=array('jurisdid'=>$array_dato_func[$clave]['jurisdid']);
			$fila_func+=array('hay_cargo'=>true);
		} else {
		    // Para que sea el menor
			$fila_func+=array('carg_nombre'=>'');
			$fila_func+=array('hay_cargo'=>false);
		}
				
		$array_func_local[$i]=$fila_func;		
		$i++;
	} 

	// Ya esta limitado y ordenado si es orden es por jurisdiccion
	if ( strtolower($orden) == 'jurisdnom asc' || strtolower($orden) == 'jurisdnom desc') {
		$array_func=$array_func_local;		
	} else {	    
		// Ordeno el arreglo de salida.
		$pos = strrpos(trim($orden), " "); 
		if ($pos == false) { 
			$orden_sentido="ASC";
		} else {
			$orden_sentido=substr(trim($orden),$pos+1,3);
			$orden_campo=substr(trim($orden),0,$pos);
		} 

	
		$sqlCreate = SqlCreateBusquedas('tmpBusquedas');	
	    OrdenSql($idconexion,$sqlCreate,'tmpBusquedas',$array_func_local,$array_func,$orden,
    		     $numero_pagina,$resu_x_pag,$CodError);	
	    
		if($CodError)
			return false;
			
	    // Para el orden del multisort
		/* $col_orden=array();
		$i=0;
		foreach($array_func_local as $clave=>$row) {
			$col_orden[$i][$orden_campo]=$row[$orden_campo];
			$i++;
		} 
	
		if(strtoupper($orden_sentido)=="ASC") 
			array_multisort($col_orden,SORT_ASC,$array_func_local);
		else 
			array_multisort($col_orden,SORT_DESC,$array_func_local);
	
		// Paginación sobre el arreglo	
		// Limito el arreglo de salida según el limit y la pagina que se busca. FALTA	
		$i=($numero_pagina-1)*$resu_x_pag;
		$hasta=(($numero_pagina*$resu_x_pag)-1);
	
		while ($i<=$hasta && $i<count($array_func_local) ) {
			$array_func[]=$array_func_local[$i]; 
			$i++;
		} 
		*/
	}
	
	return true;
}

// ---------------------------------------------------------------------------------------------------------------- 
function SqlCreateBusquedas($nombretabla) {
	
	$sql="CREATE TEMPORARY TABLE IF NOT EXISTS ".$nombretabla." (";
	$sql.="pers_nombre varchar(40),";
	$sql.="pers_apellido varchar(60),";
	$sql.="pers_cuilt varchar(11),";
	$sql.="jurisdid mediumint(8) unsigned NOT NULL,";	
	$sql.="carg_codigo mediumint(8) unsigned NOT NULL,";
	$sql.="carg_nombre varchar(255) default '',";
	$sql.="trat_codigo tinyint(1) unsigned NOT NULL default '0',";
	$sql.="hay_funcionario tinyint(1) unsigned NOT NULL default '0',";
	$sql.="hay_cargo smallint(1) unsigned NOT NULL,";
	$sql.="jurisdnom varchar(150) NOT NULL default ''";
  	$sql.=") TYPE=INNODB COMMENT='Salida Temporal';";

	return $sql;
}

// ---------------------------------------------------------------------------------------------------------------- 
function SqlCreateContactosCargo($nombretabla) {
	
	$sql="CREATE TEMPORARY TABLE IF NOT EXISTS ".$nombretabla." (";
	$sql.="apeynom varchar(100),";
	$sql.="apeynomorden varchar(100),";
	$sql.="apeynom_cargo text,";
	$sql.="jurisdid mediumint(8) unsigned NOT NULL,";	
	$sql.="carg_codigo mediumint(8) unsigned NOT NULL,";
	$sql.="carg_nombre varchar(255) default '',";
	$sql.="hay_funcionario tinyint(1) unsigned NOT NULL default '0',";
	$sql.="hay_cargo smallint(1) unsigned NOT NULL,";
	$sql.="jurisdnom varchar(150) NOT NULL default ''";
  	$sql.=") TYPE=INNODB COMMENT='Salida Temporal';";

	return $sql;
}

// ---------------------------------------------------------------------------------------------------------------- 
// Búsqueda de funcionarios por nombre,apellido o apellido y nombre, 
// ordenando por cualquiera de los criterios que NO sea jurisdiccion.
//		1) Se obtiene la cantidad de registros que cumplen con el criterio.
// 		2) Se obtienen los funcionarios que cumplan con el filtro seleccionado, limitando la
//          cantidad de elementos a los posibles en una pagina, y seleccionando lo de la pagina requerida.
//			Aplica el orden final.
// 		3) A todos los funcionarios hallados en (2) se les pega la informacion del organismo, e indicando
//			que existe el funcionario.
function ObtenerFuncionariosxCriterio($idconexion,$objJurisdicciones,$sp_nom_count,$param_count,
                                       $sp_nom,$param,$nom_campo_jurisd,&$cant_total,&$array_func) {

	$array_func=array();


	// Saco cantidad total de funcionarios que cumplen con el criterio
	if( ($query_count=ejecutarStoredProcedure($idconexion,$sp_nom_count,$param_count)) < 0 ) 
		return  false;
	else {
		$cant_total = mysqli_num_rows($query_count);
		mysqli_free_result($query_count);
	}

	if ($cant_total>0) {
		// Obtengo los funcionarios que cumplen el criterio e imponiendo el limit.
		if(($query_func=ejecutarStoredProcedure($idconexion,$sp_nom,$param)) < 0) 
			return false;
		else  {
			// Genero el arreglo con los datos del funcionario, agregando el nombre de la jurisdiccion
			$i=0;
			while ($fila_func=mysqli_fetch_assoc($query_func)) {
				$fila_func+=array('hay_funcionario'=>true);
				$fila_func+=array('hay_cargo'=>true);
				$array_func[$i]=$fila_func;
				$i++;
			}		
	
			// Armo un arreglo con los registros de las jurisdicciones de los funcionarios que cumplian,
			// queda ordenado segun los registros de $query_funcionarios.
			if (!Armo_array_jurisd_query($objJurisdicciones,$query_func,$nom_campo_jurisd,$array_jurisd,$array_asoc_jurisd))
				return false;  
	
			//	Agrego el nombre de la jurisdiccion al arreglo de salida.		
			$i=0;
			foreach($array_func as $clave=>$valor) {
				$array_func[$i]['jurisdnom']=$array_asoc_jurisd[$i]['jurisdnom'];
				$array_func[$i]['jurisdid']=$array_asoc_jurisd[$i]['jurisdid'];

				$i++;
			} 
		} 
	}	

	return true;
} // fin - funcion
// ---------------------------------------------------------------------------------------------------------------- 
// Búsqueda de funcionarios por nombre,apellido o apellido y nombre, 
// ordenando por jurisdicción.
// 		1) Se obtienen los funcionarios que cumplan con el filtro seleccionado, 
//          NO se limita la cantidad de elementos a los posibles en una pagina.
//			Si no los hay entonces se retorna 0 en la cantidad de registros y true.	
//			Se obtienen todos los que cumplen.	
//		2) Se obtiene la cantidad de registros que cumplen con el criterio si el total .
//		3) Se arma una lista con todas las jurisdicciones implicadas en (1).
// 		4) Se obtienen todas las jurisdicciones de los funcionarios hallados en (3)
//         limitando la cantidad a los posibles en una página, y según la página deseada.
//		   Se obtienen ordenadas por jurisdiccion.         
//		5) Se arma la salida con los datos hallados en (4) a los que se les pega 
// 		   la información del funcionario se indica que hay funcionario.
function ObtenerFuncionariosxCriterio_OrdenJurisd($idconexion,$objJurisdicciones,$sp_nom,$param,$nom_campo_jurisd,
												  $orden,$inicio,$resu_x_pag,&$cant_total,&$array_func) {

	$array_func=array();

	// Saco todos funcionarios que cumplen con el criterio.
	if(($query_func=ejecutarStoredProcedure($idconexion,$sp_nom,$param)) < 0) 
		return false;
	
	if (mysqli_num_rows($query_func)==0)	 {
		$cant_total=0;
		return true;
	}
	$cant_total=mysqli_num_rows($query_func);
	
	// Obtengo los datos del funcionario.	
	$i=0;
	while ($fila_func=mysqli_fetch_assoc($query_func)) {
			$array_jurisd_ids[$i]=$fila_func[$nom_campo_jurisd];
			$fila_func+=array('hay_cargo'=>true);
			$array_dato_func[$fila_func[$nom_campo_jurisd]]=$fila_func;
			$i++;
	}
	
	// Selecciono las jurisdicciones por nombre que tienen funcionarios, ordenando e imponiendo el limit.
	if (!$objJurisdicciones->SelectJurisdxID($array_jurisd_ids,array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'pjurisdorden'=>$orden,'pjurisdlimit'=>$inicio.",".$resu_x_pag),TABGRALES_TS_ARRAY,$array_jurisd,array(),$NumFilas,$CodError)) 
			 return false;
	
	// Armo el array de salida con los datos del funcionario y el nombre de la jurisdiccion.	
	$i=0;
	foreach($array_jurisd as $clave=>$valor) {
		$array_dato_func[$clave]+=array('hay_funcionario'=>true);
		$array_func[$i]=$array_dato_func[$clave];
		$array_func[$i]['jurisdnom']=$array_jurisd[$clave]['jurisdnom'];
		$i++;
	}

	return true;
}
//---------------------------------------------------------------------------------------------------------------- 
// Búsqueda filtrando por cargos ordenando por cargo.
// 1) Obtengo la cantidad de elementos que cumplen con el criterio. 
// 2) Se obtienen todos los cargos que cumplen con el criterio imponiendo el limit y el order.
// 3) Para cada fila de (2) obtengo el funcionario de existir.
// 4) Para cada fila de (2) obtengo la jurisdiccion.
// 5) Se arma la salida con los datos de (2) (3) y (4)
function ObtenerCargosxCriterio($idconexion,$objJurisdicciones,$sp_nom_count,$param_count,
                                $sp_nom,$param,$nom_campo_jurisd,&$cant_total,&$array_func) {

	$array_func=array();

	// Saco cantidad total,tal vez convenga tener un stored especial para este count
	if( ($query_count=ejecutarStoredProcedure($idconexion,$sp_nom_count,$param_count)) < 0 ) 
		return  false;
	else {
		$cant_total = mysqli_num_rows($query_count);
		mysqli_free_result($query_count);
	}

    if ($cant_total >0) {
		// Obtengo los cargos que cumplen el criterio e imponiendo el limit.
		if(($query_cargos=ejecutarStoredProcedure($idconexion,$sp_nom,$param)) < 0) 
			return false;
		else  {
	
			// Armo un arreglo con los registros de las jurisdicciones 
			if (!Armo_array_jurisd_query($objJurisdicciones,$query_cargos,$nom_campo_jurisd,$array_jurisd,$array_asoc_jurisd))  
				return false;  
				
			// Genero el arreglo con los datos del cargo y del funcionario si existiera, agregando el nombre de la jurisdiccion
			$i=0;
			while ($fila_cargo=mysqli_fetch_assoc($query_cargos)) {
	
				if (!ObtenerDatosFuncionarioBusq($idconexion,$fila_cargo['carg_codigo'],$fila_func))
				   return false;
	
				$fila_func+=array('carg_codigo'=>$fila_cargo['carg_codigo']);
				$fila_func+=array('carg_nombre'=>$fila_cargo['carg_nombre']);
				$fila_func+=array('jurisdid'=>$fila_cargo['jurisdid']);
				$fila_func+=array('jurisdnom'=>$array_asoc_jurisd[$i]['jurisdnom']);
				$fila_func+=array('hay_cargo'=>true);
				$array_func[$i]=$fila_func;
				$i++;
			}		
		} 
	} // fin - cant_total
	return true;
} // fin - funcion

// ---------------------------------------------------------------------------------------------------------------- 
// Búsqueda filtrando por cargo, ordenando nombre
// 1) Obtengo los cargos que cumplen con el criterio, sin limitar la cantidad.
// 2) Si NO hay cargos retorno la cantidad 0 y OK.
// 3) Obtengo la cantidad todal de los funcionarios que cumplen el criterio.
// 4) Para los cargos obtenidos en (1) obtengo las jurisdicciones.
// 5) Armo un array con los cargos obtenidos en (1) con la jurisdicción y el funcionario en caso de existir.
// 6) Ordeno el array (5) según el nombre del funcionario.
// 7) Limito la cantidad de la salida a los requeridos por la paginación.
function ObtenerCargosxCriterio_OrdenNombre($idconexion,$objJurisdicciones,$sp_nom_count,$param_count,
                                            $sp_nom,$param,$nom_campo_jurisd,
											$orden,$inicio,$resu_x_pag,$numero_pagina,&$cant_total,&$array_func) {

	$array_func=array();

	// Saco todos los cargos que cumplen con el criterio que no implica jurisdiccion, no se le aplica el limit ($param en la llamada es $param_count). 	    
	if(($query_cargos=ejecutarStoredProcedure($idconexion,$sp_nom,$param)) < 0) 
		return false;

	// Si no hay cargos que cumplen con el criterio
	if(mysqli_num_rows($query_cargos)==0) {
		$cant_total=0;
		return true;
	}

 	// Obtengo el total de los funcionarios que cumplian con el criterio.
	$cant_total	= mysqli_num_rows($query_cargos);

	// Armo un arreglo con los registros de las jurisdicciones de los funcionarios que cumplian,
	// queda ordenado segun los registros de $query_funcionarios.
	if (!Armo_array_jurisd_query($objJurisdicciones,$query_cargos,$nom_campo_jurisd,$array_jurisd,$array_asoc_jurisd))
		return false;  
	
	// Genero el arreglo con los datos del cargo y del funcionario si existiera, agregando el nombre de la jurisdiccion
	$i=0;		
	while ($fila_cargo=mysqli_fetch_assoc($query_cargos)) {
		// Busco el funcionario si existe
		if (!ObtenerDatosFuncionarioBusq($idconexion,$fila_cargo['carg_codigo'],$fila_func))
		   return false;
	
		$fila_func+=array('carg_codigo'=>$fila_cargo['carg_codigo']);
		$fila_func+=array('carg_nombre'=>$fila_cargo['carg_nombre']);
		$fila_func+=array('jurisdid'=>$fila_cargo['jurisdid']);
		$fila_func+=array('hay_cargo'=>true);
		$fila_func+=array('jurisdnom'=>$array_asoc_jurisd[$i]['jurisdnom']);

		$array_func_local[$i]=$fila_func;
		
		$i++;
	}		

    // Orden y Paginación
	$pos = strrpos(trim($orden), " "); 
	if ($pos == false) { 
		$orden_sentido="asc";
	} else {
		$orden_sentido=substr(trim($orden),$pos+1,3);
		$orden_campo=substr(trim($orden),0,$pos);
	} 

	$sqlCreate = SqlCreateBusquedas('tmpBusquedas');	
    OrdenSql($idconexion,$sqlCreate,'tmpBusquedas',$array_func_local,$array_func,$orden,
    		 $numero_pagina,$resu_x_pag,$CodError);	

	if($CodError)
		return false;

/*  Para el orden del multisort
	$col_orden=array();
	$i=0;
	foreach($array_func_local as $clave=>$row) {
		$col_orden[$i][$orden_campo]=$row[$orden_campo];
		$i++;
	} 

	if(strtoupper($orden_sentido)=="ASC") 
		array_multisort($col_orden,SORT_ASC,$array_func_local);
	else 
		array_multisort($col_orden,SORT_DESC,$array_func_local);

	// Paginación sobre el arreglo	
	// Limito el arreglo de salida según el limit y la pagina que se busca. FALTA	
	$i=($numero_pagina-1)*$resu_x_pag;
	$hasta=(($numero_pagina*$resu_x_pag)-1);

	while ($i<=$hasta && $i<count($array_func_local) ) {
		$array_func[]=$array_func_local[$i]; 
		$i++;
	} 
*/
	return true;
} // fin - funcion

// ---------------------------------------------------------------------------------------------------------------- 
// Búsqueda filtrando por cargo, ordenando por jurisdicción
// 1) Obtengo los cargos que cumplen con el criterio, sin limitar la cantidad.
// 2) Si NO hay cargos retorno la cantidad 0 y OK.
// 3) Obtengo los funcionarios para los cargos de (1).
// 4) Selecciono las jurisdicciones de los cargos obtenidos en (1),ordenando por jurisdicción e 
//    imponiendo el limit. Ver!!!
function ObtenerCargosxCriterio_OrdenJurisd($idconexion,$objJurisdicciones,$sp_nom,$param,
											$nom_campo_jurisd,
											$orden,$inicio,$resu_x_pag,&$cant_total,&$array_func) {

	$array_func=array();
	
	// Saco todos los cargos que cumplen con el criterio que no implica jurisdiccion, no se le aplica el limit ($param en la llamada es $param_count). 	    
	if(($query_cargos=ejecutarStoredProcedure($idconexion,$sp_nom,$param)) < 0) 
		return false;

	// Si no hay cargos que cumplen con el criterio
	if(mysqli_num_rows($query_cargos)==0) {
		$cant_total=0;
		return true;
	}

	// Obtengo los datos del funcionario.	
	$i=0;
	while ($fila_cargo=mysqli_fetch_assoc($query_cargos)) {

		$array_jurisd_ids[$i]=$fila_cargo[$nom_campo_jurisd];

		// Busco el funcionario si existe
   		if (!ObtenerDatosFuncionarioBusq($idconexion,$fila_cargo['carg_codigo'],$fila_func))
		   return false;

		$fila_func+=array('carg_codigo'=>$fila_cargo['carg_codigo']);
		$fila_func+=array('carg_nombre'=>$fila_cargo['carg_nombre']);
		$fila_func+=array('jurisdid'=>$fila_cargo['jurisdid']);
		$fila_func+=array('hay_cargo'=>true);

		$array_dato_func[$fila_cargo[$nom_campo_jurisd]]=$fila_func;
		$i++;
	}

	// Nota: No se agrega el in
	// Asumo que todos los funcionarios pertenecen a los tipos de organismo 
	// del universo de interés.
	// $arrayin=InTipoOrgDepEjeNacional($objJurisdicciones);
	// echo "ObtenerFuncionariosxCriterio_OrdenJurisd no uso el in.<BR>";
	
	// Selecciono las jurisdicciones por nombre que tienen funcionarios, ordenando e imponiendo el limit.
	if (!$objJurisdicciones->SelectJurisdxID($array_jurisd_ids,array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'pjurisdorden'=>$orden,'pjurisdlimit'=>$inicio.",".$resu_x_pag),TABGRALES_TS_ARRAY,$array_jurisd,array(),$NumFilas,$CodError)) 
		 return false;

	// Armo el array de salida con los datos del funcionario y el nombre de la jurisdiccion.	
	$i=0;
	foreach($array_jurisd as $clave=>$valor) {
		$array_func[$i]=$array_dato_func[$clave];
		$array_func[$i]['jurisdnom']=$array_jurisd[$clave]['jurisdnom'];
		$i++;
	}
	
	// Saco cantidad total,tal vez convenga agregar funcionalidad en jurisdicciones para tener solo la cantidad.
	if (!$objJurisdicciones->SelectJurisdxID($array_jurisd_ids,array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$array_jurisd,array(),$cant_total,$CodError)) 
		 return false;

	return true;
}
//---------------------------------------------------------------------------------------------------------------- 
// Dado un cargo obtiene el registro del funcionario o un registro en blanco 
// uno de los campos indica si el funcionario encontrado o no.
function ObtenerDatosFuncionarioBusq($idconexion,$carg_codigo,&$fila_func) {

	$fila_func=array();
	
	// Busco el funcionario si existe, le pego los datos del funcionario asociado al cargo
	$param_func=array('pcarg_codigo'=>$carg_codigo,'prol_codigo'=>FUNCIONARIO);
	$param_func+=array('pusurolcar_estado'=>USUARIO_ROL_CARGO_ACT.",".USUARIO_ROL_CARGO_BLOQUEADO);  			

	if (($query_func=ejecutarStoredProcedure($idconexion,"sel_func_xcarg_codigo",$param_func)) < 0) {
		return false;
	} elseif (mysqli_num_rows($query_func)>1) {
		return false;
	} elseif (mysqli_num_rows($query_func)==1) {
			$fila_func=mysqli_fetch_assoc($query_func);
			$fila_func+=array('hay_funcionario'=>true);
	} else {
			$fila_func=array();
			$fila_func+=array('pers_nombre'=>"");
			$fila_func+=array('pers_apellido'=>"");
			$fila_func+=array('hay_funcionario'=>false);
	}	
	return true;
}
//---------------------------------------------------------------------------------------------------------------- 
// Obtiene los datos básicos del funcionario asociados al cargo y en el estado requerido.
// Retorna: false en caso de error o si no lo encuentra al funcionario. 
// 		    En caso de error, muestra el mensaje por pantalla y envía el mail. 
function ObtenerDatosFuncionario($idconexion,$carg_codigo,$func_estado,&$fila_func) {

	$param=array('pcarg_codigo'=>$carg_codigo,'prol_codigo'=>FUNCIONARIO,'pusurolcar_estado'=>$func_estado);
	$query_func=ejecutarStoredProcedure($idconexion,"sel_func_xcarg_codigo",$param);
		
	if($query_func<0 || mysqli_num_rows($query_func)>1)	{
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "1Se ha producido un error al seleccionar el funcionario correspondiente al cargo.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n"."carg_codigo=".$_SESSION['carg_codigo']." - pusurolcar_estado=".$func_estado);
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;
	} elseif (mysqli_num_rows($query_func)==0) {
				$array_msg_pantalla=array("formato" => FMT_TEXTO);	
				$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar el funcionario correspondiente al cargo.");
				$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);
				$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n"."carg_codigo=".$_SESSION['carg_codigo']." - pusurolcar_estado=".$func_estado);
				MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail); 
				return false;
		} else
			$fila_func = mysqli_fetch_assoc($query_func);

	return true;
}
