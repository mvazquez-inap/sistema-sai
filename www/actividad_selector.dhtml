<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
//-----------------------------------------------------------------------------------------
// accion  = Actualizar ---> busco actividades ACTIVA (USUCURSOINAP o USUACTEXT o USUACTINS)
// 							 busco actividades NUEVA O RECHAZADA del Organismo correspondiente (COORDINADORTECNICO o USUORGANISMO)
//							 busco actividades ACTIVA (USUAUTODESARROLLO)
//         = ActualizarPrestadores ---> busco actividades ACTIVA (USUACTEXT o USUACTINS)
// 							            busco actividades NUEVA O RECHAZADA o ACTIVA del Organismo correspondiente  (USUCURSOINAP o COORDINADORTECNICO o USUORGANISMO)
//         = Imprimir ---> busco actividades ACTIVA (USUCURSOINAP o USUACTEXT o USUACTINS)
// 					       busco actividades ACTIVA del Organismo correspondiente (COORDINADORTECNICO o USUORGANISMO)
//         = AgregarFormato ---> busco actividades ACTIVA (USUCURSOINAP o USUACTEXT o USUACTINS)
// 					       		busco actividades ACTIVA del Organismo correspondiente (COORDINADORTECNICO o USUORGANISMO)
//         = Dictaminar ---> busco actividades ACTIVA (USUCURSOINAP o USUACTEXT o USUACTINS)
// 					       		busco actividades ACTIVA del Organismo correspondiente (COORDINADORTECNICO o USUORGANISMO)



function MostrarGrillaSeleccion($conexion,$ArregloDatos, &$estado_leyenda) {

	// array para pasar a la grilla
	$result_array = array();

	// Defino el filtro de búsqueda.
	switch ($_SESSION['array_busqueda_basica_actividad']['accion'] ) {
	case "Actualizar" :
		switch ($_SESSION['rolcod']) {
			case USUCURSOINAP:
				$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case USUACTINS:
				$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case COORDINADORTECNICO:
			case USUORGANISMO:
				$ArregloDatos['actcur_estado'] = ACTCURSONUEVO.",".ACTCURSORECHAZADO;
				$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];
				$estado_leyenda = "NUEVAS o RECHAZADAS";
				break;
			case USUACTEXT:
				$ArregloDatos['actext_estado'] = ACTEXTERNAACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case USUAUTODESARROLLO:
				$ArregloDatos['actauto_estado'] = ACTAUTOACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case SUPERUSUARIO:
			//	$ArregloDatos['actauto_estado'] =  ACTCURSONUEVO.",".ACTCURSOPENDIENTEAPROBACION.",".ACTCURSOACTIVO.",".ACTCURSOAPROBADO.",".ACTCURSORECHAZADO.",".ACTCURSONBAJA;
					$estado_leyenda = "TODOS";
				break;
		}
		break;
		
	case "ActualizarEducacionFormal" :
			$ArregloDatos['actform_estado'] = ACTFORMALACTIVO;
			$ArregloDatos['formact_codigo'] = FORMATOEFORMAL; 
			$ArregloDatos['tipoact_codigo'] = TIPOACTSECUNDARIO.",".TIPOACTSUPNOUNIV.",".TIPOACTSUPUNIV.",".TIPOACTPOSGRADO.",".TIPOACTOBLIG;
			$estado_leyenda = "ACTIVAS";
			break;
	case "AsociarActPocINAP" :
			$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
			$estado_leyenda = "ACTIVAS";
			break;

	case "AsociarActPocJURIS":
			$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO.",".ACTCURSOAPROBADO.",".ACTCURSORECHAZADO.",".ACTCURSONUEVO;
			$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];
			$estado_leyenda = "NUEVAS, ACTIVAS, APROBADAS, RECHAZADAS";
			break;

	case "ActualizarPrestadores" :
		switch ($_SESSION['rolcod']) {
			case USUCURSOINAP:
				$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO.",".ACTCURSOAPROBADO.",".ACTCURSONUEVO.",".ACTCURSORECHAZADO;
				$estado_leyenda = "ACTIVAS, APROBADAS, NUEVAS o RECHAZADAS";
				break;
			case USUACTINS:
				$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case COORDINADORTECNICO:
			case USUORGANISMO:
				$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO.",".ACTCURSOAPROBADO.",".ACTCURSONUEVO.",".ACTCURSORECHAZADO;
				// Modificación: Los usuarios en el organismo no actualizan el equipo docente de las actividades
				// que fueron aprobadas.
				//.",".ACTCURSOACTIVO;
				$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];
				// $estado_leyenda = "NUEVAS, RECHAZADAS o ACTIVAS";
				$estado_leyenda = "ACTIVAS, APROBADAS, NUEVAS o RECHAZADAS";
				break;

			case USUACTJUR: 	// Antes el enlace no actualizaba equipo docente, ahora solo actulizara (alta) de
							    // prestadores docentes de su jurisdiccion
				// $ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];
				$estado_leyenda = "ACTIVAS";
				break;

			// El super usuario lo hace siempre a través de la modificación de la actividad
			// INAP u JURID
			//case SUPERUSUARIO:
			//	$estado_leyenda = "TODOS";
			//	break;
		}
		break;


	case "Imprimir" :

		switch ($_SESSION['rolcod']) {
			case USUCURSOINAP:
				// $ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$estado_leyenda = "EN TODOS LOS ESTADOS";
				break;
			case USUACTINS:
				// $ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$estado_leyenda = "EN TODOS LOS ESTADOS";
				break;
			case COORDINADORTECNICO:
			case USUORGANISMO:
			case USUACTJUR:
				// $ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];
				$estado_leyenda = "EN TODOS LOS ESTADOS";
				break;
			case USUACTEXT:
				// $ArregloDatos['actext_estado'] = ACTEXTERNAACTIVO;
				$estado_leyenda = "EN TODOS LOS ESTADOS";
				break;
		}
		break;

	case "AgregarFormato" :

		$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
		$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP.",".TIPOACTCURSOJURISD.",".TIPOACTCURSOINST.",".TIPOACTAUTOEVASIS.",".TIPOACTAUTOEVACT;
		$estado_leyenda = "ACTIVAS";
		break;

	case "Dictaminar" :
		switch ($_SESSION['rolcod']) {
			case USUCURSOINAP:
				$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case USUACTINS:
				$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case COORDINADORTECNICO:
			case USUORGANISMO:
			case USUACTJUR:
				$ArregloDatos['actcur_estado'] = ACTEXTERNAACTIVO;
				$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];
				$estado_leyenda = "ACTIVAS";
				break;
			case USUACTEXT:
				$ArregloDatos['actext_estado'] = ACTEXTERNAACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case USUAUTODESARROLLO:
				$ArregloDatos['actauto_estado'] = ACTAUTOACTIVO;
				$estado_leyenda = "ACTIVAS";
				break;
			case SUPERUSUARIO:
				$estado_leyenda = "EN TODOS LOS ESTADOS";
				break;

		}
		break;
	}

    // Defino el proceso a realizar para la búsqueda
	switch ($_SESSION['rolcod']) {
			case USUCURSOINAP: 
				if ($_SESSION['array_busqueda_basica_actividad']['accion']=="ActualizarEducacionFormal") 
				{
					$oActividad = new cActividadEducacionFormal($conexion);
					if(!$oActividad->BuscarActividadEducacionFormal($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}
				} 
				else
				{
					$ArregloDatos['tipoact_codigo'] = $_SESSION['array_busqueda_basica_actividad']['tipoact_codigo'];
					$oActividad = new cActividadCurso($conexion);
					if(!$oActividad->BuscarActividadCurso($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}
				}
				break;
			
			case USUACTJUR:
			case USUACTINS:
				$ArregloDatos['tipoact_codigo'] = $_SESSION['array_busqueda_basica_actividad']['tipoact_codigo'];
				$oActividad = new cActividadCurso($conexion);
				if(!$oActividad->BuscarActividadCurso($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				break;
			case COORDINADORTECNICO:
			case USUORGANISMO:
				$ArregloDatos['tipoact_codigo'] = $_SESSION['array_busqueda_basica_actividad']['tipoact_codigo'];
				$oActividad = new cActividadCurso($conexion);
				if(!$oActividad->BuscarActividadCurso($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				break;
			case USUACTEXT:
				$ArregloDatos['tipoact_codigo'] = $_SESSION['array_busqueda_basica_actividad']['tipoact_codigo'];
				$oActividad = new cActividadExterna($conexion);
				if(!$oActividad->BuscarActividadExterna($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				break;

			case USUAUTODESARROLLO:

			if ($_SESSION['array_busqueda_basica_actividad']['accion'] == "AgregarFormato") {
				$oActividad = new cActividadCurso($conexion);
				if(!$oActividad->BuscarActividadCurso($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}

				while ($fila_result = mysqli_fetch_assoc($result))
					$result_array[] = array("act_codinap"=>$fila_result['act_codinap'],"act_nombre"=>$fila_result['act_nombre'],"act_codigo" => $fila_result['act_codigo'],"tipoact_codigo"=>$fila_result['tipoact_codigo']);

			}

			$ArregloDatos['formact_codigo'] = FORMATOAUTO;
			$oActividad = new cActividadAutodesarrollo($conexion);
			if(!$oActividad->BuscarActividadAutodesarrollo($ArregloDatos,$numfilas,$result,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			break;
			
			case SUPERUSUARIO:
				$ArregloDatos['tipoact_codigo'] = $_SESSION['array_busqueda_basica_actividad']['tipoact_codigo'];
				$oActividad = new cActividad($conexion);
				if(!$oActividad->BuscarActividad($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				break;

			
			
	}
	// paso el resultado a un array
	while ($fila_result = mysqli_fetch_assoc($result))
		$result_array[] = array("act_codinap"=>$fila_result['act_codinap'],"act_nombre"=>$fila_result['act_nombre'],"act_codigo" => $fila_result['act_codigo'],"tipoact_codigo"=>isset($fila_result['tipoact_codigo'])?$fila_result['tipoact_codigo']:"");

	$act_codinap = array();
	$act_nombre = array();
	$tipoact_codigo = array();

	// separo los arrays par poder ordenarlos
	// sólo es necesario cuando se quiere agregar un formato a una actividad
	foreach ($result_array as $llave => $fila) {
	   $act_codinap[$llave]  = $fila['act_codinap'];
	   $act_nombre[$llave] = $fila['act_nombre'];
	   $tipoact_codigo[$llave]  = $fila['tipoact_codigo'];
	}
	// ordeno los arrays
	array_multisort($act_nombre, SORT_ASC, $act_codinap, SORT_ASC, $result_array);


	$numfilas = count($result_array);
	if ($numfilas >=LIMITE_BUSQUEDA_CHICO) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda retornó demasiadas filas, ajuste el criterio de búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}

	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda no retornó resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}

	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>10
	);

	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);
		$opciones['QueryString']=$querystring;
	}

	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Código INAP');
	$oGrilla->Setear('campo_grilla',$miColumna1,'act_codinap');
	$oGrilla->Setear('align_columna',$miColumna1,'left');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna2,'act_nombre');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	// Agregado
	$miColumna21 = $oGrilla->AddColumna('popup');
	$oGrilla->Setear('ancho_columna',$miColumna21,'60');
	$oGrilla->Setear('imagen',$miColumna21,'images/verdetalle.gif');
	$oGrilla->Setear('altImagen',$miColumna21,'Ver detalle actividad');
	$oGrilla->Setear('titulo_columna',$miColumna21,'Detalle');
	$oGrilla->Setear('url',$miColumna21,'actividad_ver_dis.dhtml');
	$oGrilla->Setear('ventanaNombre',$miColumna21,'ventana_detalle_actividad');
	$oGrilla->Setear('ventanaAnchoPopup',$miColumna21,'680');
	$oGrilla->Setear('ventanaAltoPopup',$miColumna21,'500');
	$oGrilla->Setear('ventanaVarxPopup',$miColumna21,'120');
	$oGrilla->Setear('ventanaVaryPopup',$miColumna21,'50');
	$oGrilla->AddParametrosURL($miColumna21,"act_codigo",'act_codigo');
 	$oGrilla->AddParametrosURL($miColumna21,"tipoact_codigo",'tipoact_codigo');

	$miColumna3 = $oGrilla->AddColumna('addValor');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Seleccionar');
	$oGrilla->Setear('imagen',$miColumna3,'images/seleccionar.jpg');
	$oGrilla->Setear('altImagen',$miColumna3,'Seleccionar');
	$oGrilla->Setear('idtextboxAddValor',$miColumna3,$_SESSION['array_busqueda_basica_actividad']['destino']);

	if (!$_SESSION['array_busqueda_basica_actividad']['submit']) {
		$oGrilla->Setear('submitAddValor',$miColumna3,'no');
		$oGrilla->Setear('documentAddValor',$miColumna3,'window.opener.document');
		$oGrilla->Setear('nombreContenidoAddValor',$miColumna3,'act_codinap');
		$oGrilla->Setear('idtextoContenidoAddValor',$miColumna3,'act_codinap');
	} else {
		$oGrilla->Setear('submitAddValor',$miColumna3,'si');
		$oGrilla->Setear('nombreFormularioSubmitAddValor',$miColumna3,$_SESSION['array_busqueda_basica_actividad']['formulario']);
	}

	$oGrilla->AddParametrosAddValor($miColumna3,'act_codinap');
	$oGrilla->Setear('ancho_columna',$miColumna3,'20%');

	if (!$oGrilla->CargarGrilla($result_array))
		return false;

	$oGrilla->MostrarGrilla();
}
//-----------------------------------------------------------------------------------------
?>
