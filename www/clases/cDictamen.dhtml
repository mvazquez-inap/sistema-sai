					<td class='textoTablaDatoChico' align="left"> <?=isset($fila_dictamenAct['datos_dictamen']["actprog_fecha_fin"])?$fila_dictamenAct['datos_dictamen']["actprog_fecha_fin"]:"&nbsp;" ;?> </td>										
