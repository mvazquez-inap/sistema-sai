//-----------------------------------------------------------------------------------------------------	
function MostrarAreasPrestadorDocente($presdoc_codigo) {

	// Selecciono todos los relacionados
	$oPrestadorDocenteArea = new cPrestadorDocenteArea($this->conexion);
	$ArregloDatos= array();
	$ArregloDatos['presdoc_codigo']=$presdoc_codigo;
	$ArregloDatos['orderby']="areagen_descripcion, areaesp_descripcion";
		
	if(!$oPrestadorDocenteArea->BuscarPrestadorDocentexArea($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
		$txt_sys_mail="Error al seleccionar las áreas asociadas al prestador docente. error=".$error."\n presdoc=".$presdoc_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar las áreas asociadas al prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}

	$arrayresult=array();
	while ($fila=mysqli_fetch_assoc($resultado))	{
		$this->conexion->TraerCampo("area_general","areagen_descripcion",array("areagen_codigo='",$fila['areagen_codigo'],"'"),$areagendesc,$numfilasdesc,$errorcod);
		$this->conexion->TraerCampo("area_especifica","areaesp_descripcion",array("areagen_codigo='",$fila['areagen_codigo'],"' and areaesp_codigo='",$fila['areaesp_codigo'],"'"),$areaespdesc,$numfilasdesc,$errorcod);
		$fila+=array('areagen_descripcion'=>$areagendesc);
		$fila+=array('areaesp_descripcion'=>$areaespdesc);
		$arrayresult[]=$fila;
	}
		
	$opciones=array("FilasPagina"=>$numfilas);
	
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla("Áreas Específicas del Prestador Docente");
	$oGrilla->SetearAnchoGrilla('100%');
	
	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,"Area General");
	$oGrilla->Setear('campo_grilla',$miColumna2,"areagen_descripcion");
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,"Area Específica");
	$oGrilla->Setear('campo_grilla',$miColumna3,"areaesp_descripcion");
	$oGrilla->Setear('align_columna',$miColumna3,'left');

	if (!$oGrilla->CargarGrilla($arrayresult))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
}

//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAltaPrestadorDocente($datos,&$datosvalidados)	{
		
		$datosvalidados=array();

		if (!$this->_DatosValidosComunesPrestadorDocente($datos,$datosvalidados))
		   return false; 


		
		


		// valido que no exista el CUIT si es un prestador NO eventual	
		if ($datos['presdoc_eventual'] == 'N') {

			$ArregloDatos['presdoc_cuilt']=$datos["presdoc_cuilt"];
			if(!$this->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando buscando prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}

			if($numfilas>=1) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe un prestador docente con CUIT/CUIL:".$datos["presdoc_cuilt"].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

			// contraseña
			if ( (trim($datos['presdoc_password'])==''))
			{
				$arraymensajepantalla="Debe ingresar la contraseña";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
	
			if ( (trim($datos['presdoc_password2'])==''))
			{
				$arraymensajepantalla="Debe ingresar la confirmación de la contraseña";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
	
			if ( (trim($datos['presdoc_password'])!=trim($datos['presdoc_password2'])))
			{
				$arraymensajepantalla="Las contraseñas no coinciden";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
			$datosvalidados["presdoc_password"]=md5($datos["presdoc_password"]);
				
		} else {
	
			
			// No puede existir mas que el con ese nombre
			$ArregloDatos['presdoc_nombre']=$datos["presdoc_nombre"];
			$ArregloDatos['presdoc_apellido']=$datos["presdoc_apellido"];
									
			if(!$this->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando buscando prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}				

			if($numfilas>=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe un prestador docente eventual <br> con nombre:".$datos["presdoc_apellido"].",".$datos["presdoc_nombre"].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
			
			$datosvalidados["presdoc_password"]="";
			
			

				
			}
		
		if($_SESSION['rolcod']==COORDINADORTECNICO || $_SESSION['rolcod']==USUORGANISMO)   
			$datosvalidados['presdoc_estado'] = PRESDOCNUEVO;
		elseif ($_SESSION['rolcod']==ADMICURSO || $_SESSION['rolcod']==USUCURSO) 
			$datosvalidados['presdoc_estado'] = PRESDOCINACTIVO;

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosEliminarPrestadorDocente($presdoc_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		// El usuario tiene permiso de eliminar el prestador
		if (!$this->TienePermisoBaja($presdoc_codigo,$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		$datosvalidados+=array('presdoc_codigo'=>$presdoc_codigo);
		
		return true;
	}

//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifHistorialPrestadorDocente($datos,&$datosvalidados)	{
	
		$datosvalidados = array();
		if(!$this->TraerDatosPrestadorDocente($datos['presdoc_codigo'],$filaprestador,$es_modif))  {
			$error="Error al buscar el prestador docente.";
			$errormail="Error al buscar el prestador docente en tabla presador_docente \n presdoc_codigo=".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if (!$es_modif) {
			$error="Error no se encontró el prestador docente.";
			$errormail="Error no se encontró el prestador docente \n presdoc_codigo=".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} 

		$datosvalidados+=array('presdoc_codigo'=>$datos['presdoc_codigo']);
		$datosvalidados+=array('presdoc_historial'=>$filaprestador['presdoc_historial']."\n----------- ".
													date("Y/m/d H:i:s")." ----------\n\n".		
													$datos['presdoc_historial']	);
		
		return true;

	}	


	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifPrestadorDocente($datos,&$datosvalidados)	{

		if (!$this->_DatosValidosComunesPrestadorDocente($datos,$datosvalidados))
		   return false; 
		
		// El usuario tiene permiso de modificar el prestador
		if (!$this->TienePermisoModificar($datos['presdoc_codigo'],$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		$datosvalidados+=array('presdoc_codigo'=>$datos['presdoc_codigo']);

		//-- Es un prestador eventual 
		if ($datos['presdoc_eventual'] == 'S') {
			// No puede existir mas que el con ese nombre
			$ArregloDatos['presdoc_nombre']=$datos["presdoc_nombre"];
			$ArregloDatos['presdoc_apellido']=$datos["presdoc_apellido"];
									
			if(!$this->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}				
			if ($numfilas>1) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe un prestador docente eventual <br> con nombre:".$datos["presdoc_apellido"].",".$datos["presdoc_nombre"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			} elseif ($numfilas==1) {	// hay un prestador que no es el que se esta modificando			   
			   $filaprestador=mysqli_fetch_assoc($result);
			   if ($filaprestador['presdoc_codigo']!= $datos['presdoc_codigo']) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe un prestador docente eventual <br> con nombre:".$datos["presdoc_apellido"].",".$datos["presdoc_nombre"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;							   
			   }
			}
		} else {
				// No puede existir mas que el con ese cuit
				$ArregloDatos['presdoc_cuilt']=$datos["presdoc_cuilt"];
				if(!$this->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando buscando prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;			
				}
				if ($numfilas>1) {		// hay un prestador que no es el que se esta modificando
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe un prestador docente con CUIT/CUIL: ".$datos["presdoc_cuilt"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				} elseif ($numfilas==1) {				   
				   $filaprestador=mysqli_fetch_assoc($result);
				   if ($filaprestador['presdoc_codigo']!= $datos['presdoc_codigo']) {
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha completado la operación, pues ya existe un prestador docente con CUIT/CUIL: ".$datos["presdoc_cuilt"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;							   
				   }
				}
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosComunesPrestadorDocente($datos,&$datosvalidados)	{
	
		//-- datos comunes ---------------------------------------------------------------
		if ( (trim($datos['presdoc_apellido'])=='') || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['presdoc_apellido'],"AlfabeticoPuro"))
		{
			$arraymensajepantalla="El apellido ingresado no es válido";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["presdoc_apellido"]=strtoupper ($datos["presdoc_apellido"]);

		if ( (trim($datos['presdoc_nombre'])=='') || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['presdoc_nombre'],"AlfabeticoPuro"))
		{
			$arraymensajepantalla="El nombre ingresado no es válido";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["presdoc_nombre"]=$datos["presdoc_nombre"];

		if ( (!isset($datos['presdoc_sexo'])) || (($datos['presdoc_sexo'] != SEXO_FEMENINO) && ($datos['presdoc_sexo'] != SEXO_MASCULINO))) {
			$arraymensajepantalla="El sexo ingresado no es válido";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["presdoc_sexo"]=$datos["presdoc_sexo"];

		// presdoc_origen_pais_codigo ----------------------
		$this->PaisSP($spnombre,$spparam);
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("paiscod"=>$datos["presdoc_origen_pais_codigo"]),$resultado,$filapais,$numfilasmatcheo,$errno))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el pais de origen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		if($numfilasmatcheo!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el pais de origen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["presdoc_origen_pais_codigo"]=$datos['presdoc_origen_pais_codigo'];

		if ($_SESSION['rolcod'] == ADMICURSO || $_SESSION['rolcod'] == USUCURSO  ) {
			if ( (!isset($datos['presdoc_caracter_alta'])) ||  (($datos['presdoc_caracter_alta'] != PRESDOCPROVISORIO) && ($datos['presdoc_caracter_alta'] != PRESDOCDEFINITIVO))) {
				$arraymensajepantalla="El caracter de alta ingresado no es válido";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["presdoc_caracter_alta"]=$datos["presdoc_caracter_alta"];			
		} else {
			$datosvalidados["presdoc_caracter_alta"]=PRESDOCPENDIENTE;	
		}

		if ( (!isset($datos['presdoc_eventual'])) || (($datos['presdoc_eventual'] != 'S') && ($datos['presdoc_eventual'] != 'N'))) {
			$arraymensajepantalla="El tipo de prestador ingresado no es válido";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["presdoc_eventual"]=$datos["presdoc_eventual"];


		$datosvalidados["presdoc_falta_prov"]="NULL";
		$datosvalidados["presdoc_falta_def"]="NULL";


		if ($_SESSION['rolcod'] == ADMICURSO || $_SESSION['rolcod'] == USUCURSO  ) {

			//-- Fecha de Alta Provisorio  -------------------------------------------------------------------------
			if ($datos['presdoc_caracter_alta'] == PRESDOCPROVISORIO || $datos['presdoc_caracter_alta'] == PRESDOCDEFINITIVO) {
				if (trim($datos['presdoc_falta_prov'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['presdoc_falta_prov'],"FechaDDMMAAAA"))
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de Alta Provisorio no es válida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_falta_prov"]=$datos["presdoc_falta_prov"];
			}

			//-- Fecha de Alta Definitivo-------------------------------------------------------------------------
			if ($datos['presdoc_caracter_alta'] == PRESDOCDEFINITIVO) {
				if (trim($datos['presdoc_falta_def'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['presdoc_falta_def'],"FechaDDMMAAAA"))
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de Alta Definitivo no es válida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				
				// La de inicio es menor que la de fin
				$fechainicio_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['presdoc_falta_prov'],'dd/mm/aaaa','aaaa-mm-dd');
				$fechafin_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['presdoc_falta_def'],'dd/mm/aaaa','aaaa-mm-dd');
				if ($fechainicio_AAAAMMDD > $fechafin_AAAAMMDD) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de alta definitiva debe ser mayor o igual que la fecha de alta provisoria",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}

				$datosvalidados["presdoc_falta_def"]=$datos["presdoc_falta_def"];
			}

		}

		//-- Fecha de Carga  -------------------------------------------------------------------------
		if (trim($datos['presdoc_falta'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['presdoc_falta'],"FechaDDMMAAAA"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de Carga no es vádida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["presdoc_falta"]=$datos["presdoc_falta"];


		
		

		//-- Es un prestador eventual ---------------------------------------------------------------
		if ($datos['presdoc_eventual'] == 'S') {

			$datosvalidados['presdoc_cuilt'] = "NULL";
			$datosvalidados['presdoc_presentacion'] = "NULL";
			$datosvalidados['presdoc_telefono'] = "NULL";
			$datosvalidados['presdoc_celular'] = "NULL";			
			$datosvalidados['presdoc_calle'] = "NULL";
			$datosvalidados['presdoc_numero'] = "NULL";
			$datosvalidados['presdoc_piso'] = "NULL";
			$datosvalidados['presdoc_cp'] = "NULL";
			$datosvalidados['presdoc_prov_codigo'] = "NULL";
			$datosvalidados['presdoc_part_loca_descripcion'] = "NULL";
			$datosvalidados['presins_codigo'] = "NULL";
			$datosvalidados['jurisdid_apn'] = "NULL";
			$datosvalidados['orgapub_codigo'] = "NULL";		
			$datosvalidados["presdoc_cargo"]="NULL";

			$datosvalidados["tipopos"]=array();
			$datosvalidados["presdoc_max_nivel_estudio"]="NULL";
			$datosvalidados["presdoc_ult_titulo"]="NULL";
			$datosvalidados["presdoc_ult_titulo_institucion"]="NULL";
			$datosvalidados["presdoc_ult_titulo_ano"]="NULL";
			$datosvalidados["presdoc_ido_competencias"]="NULL";
			$datosvalidados["presdoc_ido_instituciones"]="NULL";
			$datosvalidados["presdoc_cv"]="NULL";
			
			
			 
			
			// Organismo donde trabaja
			if (trim($datos['presdoc_eve_organismo']) == "") {
				$arraymensajepantalla="Debe ingresar un Organismo donde trabaja";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["presdoc_eve_organismo"]=$datos["presdoc_eve_organismo"];

			// Cargo
			if (trim($datos['presdoc_eve_cargo']) == "") {
				$arraymensajepantalla="Debe ingresar un cargo / función";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["presdoc_cargo"]=$datos["presdoc_eve_cargo"];


			// Email
			if (!FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['presdoc_eve_email'],"Email"))
			{
				$arraymensajepantalla="El Email ingresado no es válido";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["presdoc_email"]=$datos["presdoc_eve_email"];

		
		} else { // if ($datos['presdoc_eventual'] == 'S')
		
				$datosvalidados["presdoc_eve_organismo"]="NULL";		
				$datosvalidados["presdoc_cargo"]="NULL";
				//-- NO Es un prestador eventual --------
				if (!FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['presdoc_cuilt'],"CUIT"))
				{
					$arraymensajepantalla="El CUIT/CUIL/CDI ingresado no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}

				$datosvalidados["presdoc_cuilt"]=$datos["presdoc_cuilt"];

				
				if ( (!isset($datos['presdoc_presentacion'])) || ($datos['presdoc_presentacion'] != PRESDOCINDIVIDUAL) && ($datos['presdoc_presentacion'] != PRESDOCINSTITUCIONAL)) {
					$arraymensajepantalla="El tipo de presentación ingresado no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_presentacion"]=$datos["presdoc_presentacion"];

				//-- Es una presentación INDIVIDUAL-----------------------------
				if (($datos['presdoc_presentacion'] == PRESDOCINDIVIDUAL) && $datos['tipo_individual_con_org']==SI) {

					
					if (trim($datos['presdoc_cargo']) == "") {
						$arraymensajepantalla="Debe ingresar un cargo / función";
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}
					$datosvalidados["presdoc_cargo"]=$datos["presdoc_cargo"];
					
					
					if ($datos['tipoorg_codigo'] == ORGANISMO_APN) { //-- seleccionó Organismo APN
							
						if (trim($datos['jurisdid']) == "") {
							$arraymensajepantalla="El organismo ingresado no es válido";
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							return false;
						}
						$datosvalidados["jurisdid_apn"]=$datos["jurisdid"];
						$datosvalidados["orgapub_codigo"]="NULL";
						$datosvalidados["presins_codigo"]="NULL";						
						
					} else { 
					
						if ($datos['tipoorg_codigo'] == ORGANISMO_NO_APN) { //-- seleccionó otro organismo público
					
							$spnombre = "sel_organismo_publico_xestado_orden";
							$spparam = array("porgapub_estado"=>ESTADOACTIVO, "porderby"=>"orgapub_nombre");
				
							if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("orgapub_codigo"=>$datos["jurisdid"]),$resultado,$filapais,$numfilasmatcheo,$errno))
							{
								FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el organismo. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;
							}
							
							if($numfilasmatcheo!=1)
							{
								FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el organismo. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;
							}
							$datosvalidados["orgapub_codigo"]=$datos["jurisdid"];
							$datosvalidados["jurisdid_apn"]="NULL";
							$datosvalidados["presins_codigo"]="NULL";						
							
						} else { //-- seleccionó No corresponde Organismo
						
							$datosvalidados["orgapub_codigo"]="NULL";
							$datosvalidados["jurisdid_apn"]="NULL";
							$datosvalidados["presins_codigo"]="NULL";						
						
						}
			
					}
					
				
				} else  { 
				
				if (($datos['presdoc_presentacion'] == PRESDOCINSTITUCIONAL)) {	 //-- Es una presentación INSTITUCIONAL-----------------------------
				
						$spnombre = "sel_prestador_institucional_xestado";
						$spparam = array("ppresins_estado"=>PRESINSACTIVO, "porderby"=>"presins_nombre");
			
						if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("presins_codigo"=>$datos["presins_codigo"]),$resultado,$filapais,$numfilasmatcheo,$errno))
						{
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la Institución prestadora. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							return false;
						}
						
						if($numfilasmatcheo!=1)
						{
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la Institución prestadora. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							return false;
						}
			
						$datosvalidados["presins_codigo"]=$datos["presins_codigo"];
						$datosvalidados["orgapub_codigo"]="NULL";
						$datosvalidados["jurisdid_apn"]="NULL";				
	
				} else {
						$datosvalidados["presins_codigo"]="NULL";
						$datosvalidados["orgapub_codigo"]="NULL";
						$datosvalidados["jurisdid_apn"]="NULL";	
									
				}
				
				}			
			
				if (trim($datos['presdoc_telefono']) == "") {
					$arraymensajepantalla="El teléfono ingresado no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_telefono"]=$datos["presdoc_telefono"];

				if (!FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['presdoc_email'],"Email"))
				{
					$arraymensajepantalla="El Email ingresado no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_email"]=$datos["presdoc_email"];

				if (trim($datos['presdoc_calle']) == "") {
					$arraymensajepantalla="La calle ingresada no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_calle"]=$datos["presdoc_calle"];

				if (trim($datos['presdoc_numero']) == "") {
					$arraymensajepantalla="El número ingresado no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_numero"]=$datos["presdoc_numero"];

				if (trim($datos['presdoc_piso']) == "") {
					$arraymensajepantalla="El piso ingresado no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_piso"]=$datos["presdoc_piso"];

				if (trim($datos['presdoc_cp']) == "") {
					$arraymensajepantalla="El Código Postal ingresado no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_cp"]=$datos["presdoc_cp"];

				$oprovincia = new cProvincias($this->conexion);
				$oprovincia->ProvinciasSP($spnombre,$spparam);
				if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("provinciacod"=>$datos["presdoc_prov_codigo"]),$resultado,$filapais,$numfilasmatcheo,$errno))
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la provincia del domicilio. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				
				if($numfilasmatcheo!=1)
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la provincia del domicilio. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_prov_codigo"]=$datos['presdoc_prov_codigo'];

				if (trim($datos['presdoc_part_loca_descripcion']) == "") {
					$arraymensajepantalla="El Partido/Localidad ingresado no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_part_loca_descripcion"]=$datos["presdoc_part_loca_descripcion"];

				$datosvalidados["presdoc_celular"]=$datos["presdoc_celular"];


				$datosvalidados["tipopos"]=array();
				// cargar el array con todos los tipos de postulación seleccionados 
				foreach ($_POST as $clave => $valor) {
					if (substr($clave,0,8) == "tipopos_") 
						$datosvalidados["tipopos"][] += $valor;
				}			
				
				$spnombre = "sel_nivel_estudios_xorden";
				$spparam = array("porderby"=>"nivest_descricpcion");
	
				if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("nivest_codigo"=>$datos["nivest_codigo"]),$resultado,$filapais,$numfilasmatcheo,$errno))
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el nivel de estudios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				
				if($numfilasmatcheo!=1)
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el nivel de estudios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}

				$datosvalidados["presdoc_max_nivel_estudio"]=$datos["nivest_codigo"];
	
	
	
				if (trim($datos['presdoc_ult_titulo']) == "") {
					$arraymensajepantalla="El último título alcanzado educativa no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_ult_titulo"]=$datos["presdoc_ult_titulo"];
	
	
				if (trim($datos['presdoc_ult_titulo_institucion']) == "") {
					$arraymensajepantalla="La institución educativa no es válida";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_ult_titulo_institucion"]=$datos["presdoc_ult_titulo_institucion"];


				if (trim($datos['presdoc_ult_titulo_ano']) == "") {
					$arraymensajepantalla="El año de egreso no es válida";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_ult_titulo_ano"]=$datos["presdoc_ult_titulo_ano"];
	
	
				if (trim($datos['presdoc_ido_competencias']) == "") {
					$arraymensajepantalla="La competencia no es válida";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_ido_competencias"]=$datos["presdoc_ido_competencias"];
			
	
				if (trim($datos['presdoc_ido_instituciones']) == "") {
					$arraymensajepantalla="La Institución / Organismo no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_ido_instituciones"]=$datos["presdoc_ido_instituciones"];


				if (trim($datos['presdoc_cv']) == "") {
					$arraymensajepantalla="El Resumen de CV no es válido";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["presdoc_cv"]=$datos["presdoc_cv"];

		} //  if ($datos['presdoc_eventual'] == 'S')

		$datosvalidados['jurisdid_origen'] = $_SESSION['jurisdid_inap'];					

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosRehabilitarPrestadorDocente($presdoc_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		// El usuario tiene permiso de rehabilitar el prestador
		if (!$this->TienePermisoRehabilitar($presdoc_codigo,$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		$datosvalidados+=array('presdoc_codigo'=>$presdoc_codigo);
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosActivarPrestadorDocente($presdoc_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		// El usuario tiene permiso de activar el prestador
		if (!$this->TienePermisoActivar($presdoc_codigo,$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		$datosvalidados+=array('presdoc_codigo'=>$presdoc_codigo);
		return true;
	}		
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosEvaluarPrestadorDocente($presdoc_codigo,$operacion,&$datos,&$datosvalidados)	{
	
		// El usuario tiene permiso de eliminar el prestador
		if (!$this->TienePermisoEvaluar($presdoc_codigo,$_SESSION['rolcod'])) {
			return false; 
		}
		
		if ($operacion != "A" && $operacion != "R") {
			return false; 
		}
		
		if(!$this->TraerDatosPrestadorDocente($presdoc_codigo,$filaprestador,$es_modif))  {
			$error="Error al buscar el prestador docente.";
			$errormail="Error al buscar el prestador docente en tabla presador_docente \npresdoc_codigo=".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		$datosvalidados= array();
		$datosvalidados['jurisdid_origen'] = $filaprestador['jurisdid_origen'];
		
		if ($operacion == "A") {
			if (($datos['presdoc_caracter_alta'] != PRESDOCPROVISORIO) && ($datos['presdoc_caracter_alta'] != PRESDOCDEFINITIVO)) {
				$arraymensajepantalla="El caracter de alta ingresado no es válido";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["presdoc_caracter_alta"]=$datos["presdoc_caracter_alta"];			
		} else {
			$datosvalidados["presdoc_caracter_alta"]=$datos['presdoc_caracter_alta'];	
		}
		$datosvalidados["presdoc_falta_prov"]=(isset($datos["presdoc_falta_prov"]))?$datos["presdoc_falta_prov"]:"NULL";					
		$datosvalidados["presdoc_falta_def"]=(isset($datos["presdoc_falta_def"]))?$datos["presdoc_falta_def"]:"NULL";							

		// No debiera suceder, porque si se solicito la aprobación tiene que tener áreas especificas
		// cargadas, se verifica de todas formas.
		$ArregloDatos= array();
		$ArregloDatos['presdoc_codigo']=$presdoc_codigo;
	
		$oPrestadorDocenteArea=new cPrestadorDocenteArea($this->conexion);
		if(!$oPrestadorDocenteArea->BuscarPrestadorDocentexArea($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
			$txt_sys_mail="Error al seleccionar las áreas asociadas al prestador docente. error=".$error." ";
			$txt_sys_mail.='\npresdoc_codigo='.$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al evaluar el prestador.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		} 
		if($numfilas<1) {		
			$txt_sys_mail="Error al seleccionar las áreas asociadas al prestador docente. error=".$error." ";
			$txt_sys_mail.='\npresdoc_codigo='.$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al evaluar el prestador.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosPedidoAprobacionPrestadorDocente($presdoc_codigo)	{
	
		// El usuario tiene permiso de pedir aprobación
		if (!$this->TienePermisoPedirAprobacion($presdoc_codigo,$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false; 
		}

		// Tiene que tener por lo menos un área específica definida
		$ArregloDatos= array();
		$ArregloDatos['presdoc_codigo']=$presdoc_codigo;
	
		$oPrestadorDocenteArea=new cPrestadorDocenteArea($this->conexion);
		if(!$oPrestadorDocenteArea->BuscarPrestadorDocentexArea($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
			$txt_sys_mail="Error al seleccionar las áreas asociadas al prestador docente. error=".$error." ";
			$txt_sys_mail.='\npresdoc_codigo='.$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar las áreas asociadas al prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		} 
		if($numfilas<1) {		
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El Prestador Docente no tiene áreas específicas asignadas, <br> Deber&aacute; cargarlas antes de solicitar la aprobación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function BuscarPrestadorDocenteAvanzada($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxpresdoc_cuilt'=>0);
