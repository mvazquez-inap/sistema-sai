<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oRoles_Modulos=new cRoles_Modulos ($conexion);

//----------------------------------------------------------------------------------------- 
$result=true;
	
if($_POST["operacion"]=="I")
{
	$conexion->ManejoTransacciones("B");
	
	if($oRoles_Modulos->AltaRolModulo($_POST))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"033601","rolcod=".$_POST['rolcod']." modulocod=".$_POST['modulocod']." rolmodtipoasig=".$_POST['rolmodtipoasig'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha agregado el módulo al rol seleccionado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

		$conexion->ManejoTransacciones("C");
?>		
		<br><br><br><div align="center"><a href="roles_modulos.dhtml?modulocod=<?php echo $_POST["modulocod"] ?>" class="linkFondoBlanco">Continuar</a></div>
<?php 

	}
	else
		$conexion->ManejoTransacciones("R");
		
}
elseif($_POST["operacion"]=="M")
{
	$conexion->ManejoTransacciones("B");
	if($oRoles_Modulos->ModifRolModulo($_POST))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"033603","rolcod=".$_POST['rolcod']." modulocod=".$_POST['modulocod']." rolmodtipoasig=".$_POST['rolmodtipoasig'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha modificado el módulo - rol seleccionado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
?>		
		<br><br><br><div align="center"><a href="roles_modulos.dhtml?modulocod=<?php echo $_POST["modulocod"] ?>" class="linkFondoBlanco">Continuar</a></div>
<?php 

	}
	else
		$conexion->ManejoTransacciones("R");
		

}
elseif($_POST["operacion"]=="B")

{

	$conexion->ManejoTransacciones("B");
	if($oRoles_Modulos->BajaRolModulo($_POST))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"033602","rolcod=".$_POST['rolcod']." modulocod=".$_POST['modulocod'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha eliminado el módulo - rol seleccionado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

		$conexion->ManejoTransacciones("C");
?>		
		<br><br><br><div align="center"><a href="roles_modulos.dhtml?modulocod=<?php echo $_POST["modulocod"] ?>" class="linkFondoBlanco">Continuar</a></div>
<?php 

	}
	else
		$conexion->ManejoTransacciones("R");
		
}
else
{

?>		
		<br><br><br><div align="center"><a href="roles_modulos.dhtml" class="linkFondoBlanco">Ir al listado</a></div>
<?php 
}

$oEncabezados->PieMenuEmergente();
?>
