<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

// Cambiar tiene que ser segun el usuario a modificar
if ($_SESSION['rolcod'] == USUCURSOINAP)
	$oActividadCurso= new cActividadCursoInap($conexion);

if ($_SESSION['rolcod'] == COORDINADORTECNICO || $_SESSION['rolcod'] == USUORGANISMO || $_SESSION['rolcod'] == USUACTJUR)
	$oActividadCurso= new cActividadCursoJurisdiccional($conexion);


$oActividadCursoPrestadorDocente = new cActividadCursoPrestadorDocente($conexion);

//-----------------------------------------------------------------------------------------
function MostrarGrillaSeleccion($conexion,$modulo,$act_codigo) {

	// Selecciono todos los prestadores asociados a la actividad.
	$oPrestadorDocente = new cPrestadorDocente($conexion);
	$ArregloDatos= array();
	$ArregloDatos['act_codigo']=$act_codigo;

	if(!$oPrestadorDocente->BuscarPrestadorDocentexActividad($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
		$txt_sys_mail="\nact_codigo=".$act_codigo."\nerror=".$error;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}

	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>$numfilas
	);

	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla("Prestadores Docentes de la Actividad");
	$oGrilla->SetearAnchoGrilla('90%');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,"CUIT/CUIL");
	$oGrilla->Setear('campo_grilla',$miColumna1,"presdoc_cuilt");
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	$oGrilla->Setear('ancho_columna',$miColumna1,'20%');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,"Apellido");
	$oGrilla->Setear('campo_grilla',$miColumna2,"presdoc_apellido");
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,"Nombre");
	$oGrilla->Setear('campo_grilla',$miColumna3,"presdoc_nombre");
	$oGrilla->Setear('align_columna',$miColumna3,'left');

	if ($_SESSION['rolcod'] != USUACTJUR) {
		$miColumna4 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna4,'Eliminar');
		$oGrilla->Setear('ancho_columna',$miColumna4,'60');
		$oGrilla->Setear('url',$miColumna4,$modulo);
		$oGrilla->Setear('imagen',$miColumna4,'images/borrar.jpg');
		$oGrilla->Setear('altImagen',$miColumna4,'Eliminar');
		$oGrilla->AddParametrosURL($miColumna4,"act_codigo","act_codigo");
		$oGrilla->AddParametrosURL($miColumna4,"presdoc_codigo","presdoc_codigo");
		$oGrilla->AddParametrosURL($miColumna4,"operacion","B","cte");
	}

	if (!$oGrilla->CargarGrilla($resultado))
		return false;

	$oGrilla->MostrarGrilla();

	return true;
}
//-----------------------------------------------------------------------------------------
?>
<script type="text/javascript">
	<?php $oActividadCursoPrestadorDocente->ValidarFormAltaActividadPrestadorDocenteCurso(); ?>
