//-----------------------------------------------------------------------------------------
function hayDisposicion ($datos) {
	if (isset($datos['dis_codigo']))
		return true;
	else
		return false;
}
//-----------------------------------------------------------------------------------------
function MostrarGrillaSeleccion($conexion,$filtro,$modulo) {

	switch ($_SESSION['rolcod']) {
		case USUCURSOINAP:
			$oActividad= new cActividadCursoInap($conexion);
			$tipoact_codigo=TIPOACTCURSOINAP;
			$formact_codigo=FORMATOCURSO;
			break;
		case USUACTINS:
			$oActividad= new cActividadCursoInstitucional($conexion);
			$tipoact_codigo=TIPOACTCURSOINST;
			$formact_codigo=FORMATOCURSO;
			break;
		case USUACTJUR:
		case USUDISJUR:
			$oActividad= new cActividadCursoJurisdiccional($conexion);
			$tipoact_codigo=TIPOACTCURSOJURISD;
			$formact_codigo=FORMATOCURSO;
			$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];
			break;
		case USUACTEXT:
			$oActividad= new cActividadExterna($conexion);
			$formact_codigo=FORMATOEXT;
			$tipoact_codigo=TIPOACTEXTASIS;
			break;
		case USUAUTODESARROLLO: // Solo Para Mero asistente
			$oActividad= new cActividadAutodesarrollo($conexion);
			$formact_codigo=FORMATOAUTO;
			$tipoact_codigo=TIPOACTAUTOEVASIS;
			break;
	}

	$ArregloDatos['dic_estado']=DICTAMENACTIVO;
	$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;
	$ArregloDatos['orderby']='tipoact_codigo, act_nombre';
	$ArregloDatos+=$filtro;

	if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenesAct,$error,$errormail)) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok=false;
	}

/*	$arrayresult=array();
	while ($fila=mysql_fetch_assoc($resultDictamenesAct))	{
		$arrayresult[]=$fila;
	}
*/

	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FormularioBotonera"=>"formulario_boton",
		"FilasPagina"=>5
	);

	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);
		$opciones['QueryString']=$querystring;
	}

	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla("Dictámenes Activos");
	$oGrilla->SetearAnchoGrilla('100%');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Código INAP');
	$oGrilla->Setear('campo_grilla',$miColumna1,'act_codinap');
	$oGrilla->Setear('align_columna',$miColumna1,'left');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Actividad');
	$oGrilla->Setear('campo_grilla',$miColumna2,'act_nombre');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

/*
	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Fecha Inicio');
	$oGrilla->Setear('campo_grilla',$miColumna3,'actprog_fecha_inicio');
	$oGrilla->Setear('align_columna',$miColumna3,'left');
	$oGrilla->Setear('ancho_columna',$miColumna3,'80');

	$miColumna4 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Fecha Fin' );
	$oGrilla->Setear('campo_grilla',$miColumna4,'actprog_fecha_fin');
	$oGrilla->Setear('align_columna',$miColumna4,'left');
	$oGrilla->Setear('ancho_columna',$miColumna4,'80');
*/
    // Cambio formato fechas
	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Vigencia Desde');
	$oGrilla->Setear('campo_grilla',$miColumna3,'actprog_fecha_inicio_ddmmaaaa');
	$oGrilla->Setear('align_columna',$miColumna3,'left');
	$oGrilla->Setear('ancho_columna',$miColumna3,'80');

	$miColumna4 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Vigencia Hasta' );
	$oGrilla->Setear('campo_grilla',$miColumna4,'actprog_fecha_fin_ddmmaaaa');
	$oGrilla->Setear('align_columna',$miColumna4,'left');
	$oGrilla->Setear('ancho_columna',$miColumna4,'80');

	$miColumna5 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna5,'Disposición' );
	$oGrilla->Setear('campo_grilla',$miColumna5,'dis_numero');
	$oGrilla->Setear('align_columna',$miColumna5,'center');
	$oGrilla->Setear('condicion_visualizar_columna',$miColumna5,'hayDisposicion');

	$miColumna6 = $oGrilla->AddColumna('linkimg');
	$oGrilla->Setear('titulo_columna',$miColumna6,'Seleccionar');
	$oGrilla->Setear('ancho_columna',$miColumna6,'50');
	$oGrilla->Setear('url',$miColumna6,$modulo);
	$oGrilla->Setear('url_ancla',$miColumna6,'Edicion');
	$oGrilla->Setear('imagen',$miColumna6,'images/seleccionar.jpg');
	$oGrilla->Setear('altImagen',$miColumna6,'Seleccionar');
	$oGrilla->AddParametrosURL($miColumna6,"dic_codigo","dic_codigo");
	$oGrilla->AddParametrosURL($miColumna6,"act_codigo","act_codigo");
	$oGrilla->AddParametrosURL($miColumna6,"tipoact_codigo","tipoact_codigo");
	$oGrilla->AddParametrosURL($miColumna6,"operacion","AD","cte");

	if (!$oGrilla->CargarGrilla($resultDictamenesAct))
		return false;

	$oGrilla->MostrarGrilla();

	return true;
}
//-----------------------------------------------------------------------------------------
function MostrarGrillaSeleccionPersona($conexion,$filtro,$modulo) {

	if($_SESSION['rolcod']!=USUAUTODESARROLLO) // Solo autodesarrollo tiene dictamentes personales
		return true;

	// Selecciono todos los relacionados
	$oActividadAutodesarrollo = new cActividadAutodesarrollo($conexion);
	$ArregloDatos['dic_estado']=DICTAMENACTIVO;
	$ArregloDatos['tipoact_codigo']=TIPOACTAUTODOCENTE.",".TIPOACTAUTOEVACT.",".TIPOACTAUTOPUBLI.",".TIPOACTAUTOASISTEC.",".TIPOACTAUTOAAUTOFORM;

	$ArregloDatos['orderby']='tipoact_codigo, act_nombre';
	$ArregloDatos+=$filtro;

	if (!$oActividadAutodesarrollo->BuscarActividadDictaminadaPersonaAvanzada($ArregloDatos,$numfilas,$resultDictamenesAuto,$error,$errormail)) {
