<script language="javascript"  type="text/javascript">
function AddValorFormatoTipoProgPersonal(docu,frm,act_codigo,formact_codigo,tipoact_codigo,actprog_sec,cuilt,idAct,idFormato,idTipo,idProg,idCuilt)  {

	idElement = eval(docu+'.'+'getElementById("'+idAct+'")');
	idElement.value=act_codigo;

	idElement = eval(docu+'.'+'getElementById("'+idFormato+'")');
	idElement.value=formact_codigo;

	idElement = eval(docu+'.'+'getElementById("'+idTipo+'")');
	idElement.value=tipoact_codigo;

	if (idProg!='') {
		idElement = eval(docu+'.'+'getElementById("'+idProg+'")');
		idElement.value=actprog_sec;
	} else {
		idElement = eval(docu+'.'+'getElementById("'+idCuilt+'")');
		idElement.value=cuilt;
	}

	eval(docu+'.'+frm+'.'+'submit()');
	window.close();
}

function AddValorFormatoTipoProg(docu,frm,act_codigo,formact_codigo,tipoact_codigo,actprog_sec,idAct,idFormato,idTipo,idProg)  {

	idElement = eval(docu+'.'+'getElementById("'+idAct+'")');
	idElement.value=act_codigo;

	idElement = eval(docu+'.'+'getElementById("'+idFormato+'")');
	idElement.value=formact_codigo;

	idElement = eval(docu+'.'+'getElementById("'+idTipo+'")');
	idElement.value=tipoact_codigo;

	if (idProg!='') {
		idElement = eval(docu+'.'+'getElementById("'+idProg+'")');
		idElement.value=actprog_sec;
	}

	eval(docu+'.'+frm+'.'+'submit()');
	window.close();
}

//----------------------------------------------------------------------------------------------------
function AddValorFormatoTipo(docu,frm,act_codigo,formact_codigo,tipoact_codigo,idAct,idFormato,idTipo)  {

	idElement = eval(docu+'.'+'getElementById("'+idAct+'")');
	idElement.value=act_codigo;

	idElement = eval(docu+'.'+'getElementById("'+idFormato+'")');
	idElement.value=formact_codigo;

	idElement = eval(docu+'.'+'getElementById("'+idTipo+'")');
	idElement.value=tipoact_codigo;

	eval(docu+'.'+frm+'.'+'submit()');
	window.close();
}

//----------------------------------------------------------------------------------------------------
</script>
