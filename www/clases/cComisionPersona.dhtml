//		print_r($ArregloDatos);
	
		if (isset ($ArregloDatos['act_codigo']))  {
			if ($ArregloDatos['act_codigo']!="") {	
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['act_nombre']))  {
			if ($ArregloDatos['act_nombre']!="") {	
				$sparam['pact_nombre']= $ArregloDatos['act_nombre'];
				$sparam['pxact_nombre']= 1;
			}
		}	
		if (isset ($ArregloDatos['act_codinap']))  {
			if ($ArregloDatos['act_codinap']!="") {	
				$sparam['pact_codinap']= $ArregloDatos['act_codinap'];
				$sparam['pxact_codinap']= 1;
			}
		}	
		if (isset ($ArregloDatos['tipoact_codigo']))  {
			if ($ArregloDatos['tipoact_codigo']!="") {	
				$sparam['ptipoact_codigo']= $ArregloDatos['tipoact_codigo'];
				$sparam['pxtipoact_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['pers_codigo']))  {
			if ($ArregloDatos['pers_codigo']!="") {	
				$sparam['ppers_codigo']= $ArregloDatos['pers_codigo'];
				$sparam['pxpers_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['actprog_sec']))  {
			if ($ArregloDatos['actprog_sec']!="") {	
				$sparam['pactprog_sec']= $ArregloDatos['actprog_sec'];
				$sparam['pxactprog_sec']= 1;
			}
		}		
		if (isset ($ArregloDatos['eval_codigo']))  {
			if ($ArregloDatos['eval_codigo']!="") {	
				$sparam['peval_codigo']= $ArregloDatos['eval_codigo'];
				$sparam['pxeval_codigo']= 1;
			}
		}	
		if (isset ($ArregloDatos['eval_certifica']))  {
			if ($ArregloDatos['eval_certifica']!="") {	
				$sparam['peval_certifica']= $ArregloDatos['eval_certifica'];
				$sparam['pxeval_certifica']= 1;
			}
		}	
		if (isset ($ArregloDatos['comi_codigo']))  {
			if ($ArregloDatos['comi_codigo']!="") {	
				$sparam['pcomi_codigo']= $ArregloDatos['comi_codigo'];
				$sparam['pxcomi_codigo']= 1;
			}
		}	
		if (isset($ArregloDatos['actprog_fecha_inicio']))	{
			if ($ArregloDatos['actprog_fecha_inicio']!="") 	{	
				$sparam['pactprog_fecha_inicio']= $ArregloDatos['actprog_fecha_inicio'];
				$sparam['pxactprog_fecha_inicio']= 1;
			}
		}	
		if (isset($ArregloDatos['actprog_fecha_fin']))	{
			if ($ArregloDatos['actprog_fecha_fin']!="")	{	
				$sparam['pactprog_fecha_fin']= $ArregloDatos['actprog_fecha_fin'];
				$sparam['pxactprog_fecha_fin']= 1;
			}
		}	
		if (isset($ArregloDatos['exp_numero']))	{
			if ($ArregloDatos['exp_numero']!="") {	
				$sparam['pexp_numero'] = $ArregloDatos['exp_numero'];
				$sparam['pxexp_numero'] = 1;
			}
		}	
		if (isset($ArregloDatos['jurisdid_inap']))	{
			if ($ArregloDatos['jurisdid_inap']!="") {	
				if ($ArregloDatos['jurisdid_inap'] == "NULL") {
					$sparam['pxsin_jurisdid_inap'] = 1;				
				} else {
					$sparam['pjurisdid_inap'] = $ArregloDatos['jurisdid_inap'];
					$sparam['pxjurisdid_inap'] = 1;
				}
			}
		}	

	
// if(#pxactividad_jurisdid_inap#,ac.jurisdid_inap="#pactividad_jurisdid_inap#",1) and
		if (isset($ArregloDatos['actividad_jurisdid_inap']))	{				
			if ($ArregloDatos['actividad_jurisdid_inap']!="")	{	
				$sparam['pactividad_jurisdid_inap']= $ArregloDatos['actividad_jurisdid_inap'];
				$sparam['pxactividad_jurisdid_inap']= 1;
			}
		}	

// if(#pxcomi_codinap#,c.comi_codinap="#pcomi_codinap#",1) and
		if (isset($ArregloDatos['comi_codinap']))	{
			if ($ArregloDatos['comi_codinap']!="")	{	
				$sparam['pcomi_codinap']= $ArregloDatos['comi_codinap'];
				$sparam['pxcomi_codinap']= 1;
			}
		}	

// if(#pxcomi_fecha_inicio#,c.comi_fecha_inicio >= "#pcomi_fecha_inicio#",1) and 
		if (isset($ArregloDatos['comi_fecha_inicio']))	{
			if ($ArregloDatos['comi_fecha_inicio']!="")	{	
				$sparam['pcomi_fecha_inicio']= $ArregloDatos['comi_fecha_inicio'];
				$sparam['pxcomi_fecha_inicio']= 1;
			}
		}	

// if(#pxcomi_fecha_fin#,c.comi_fecha_fin <= "#pcomi_fecha_fin#",1) and
		if (isset($ArregloDatos['comi_fecha_fin']))	{
			if ($ArregloDatos['comi_fecha_fin']!="")	{	
				$sparam['pcomi_fecha_fin']= $ArregloDatos['comi_fecha_fin'];
				$sparam['pxcomi_fecha_fin']= 1;
			}
		}	

// if(#pxcomi_estado#,c.comi_estado in (#pcomi_estado#),1) and
		if (isset($ArregloDatos['comi_estado']))	{
			if ($ArregloDatos['comi_estado']!="")	{	
				$sparam['pcomi_estado']= $ArregloDatos['comi_estado'];
				$sparam['pxcomi_estado']= 1;
			}
		}	

		if (isset ($ArregloDatos['pers_apeynom']))  {
			if ($ArregloDatos['pers_apeynom']!="") {	
				$sparam['ppers_apeynom']= $ArregloDatos['pers_apeynom'];
				$sparam['pxpers_apeynom']= 1;
			}
		}	


		if (isset ($ArregloDatos['dic_estado']))  {
			if ($ArregloDatos['dic_estado']!="") {	
				$sparam['pdic_estado']= $ArregloDatos['dic_estado'];
				$sparam['pxdic_estado']= 1;
			}
		}	

		if (isset ($ArregloDatos['dic_fecha_inicio']))  {
			if ($ArregloDatos['dic_fecha_inicio']!="") {	
				$sparam['pdic_fecha_inicio']= $ArregloDatos['dic_fecha_inicio'];
				$sparam['pxdic_fecha_inicio']= 1;
			}
		}	

		if (isset ($ArregloDatos['dic_fecha_fin']))  {
			if ($ArregloDatos['dic_fecha_fin']!="") {	
				$sparam['pdic_fecha_fin']= $ArregloDatos['dic_fecha_fin'];
				$sparam['pxdic_fecha_fin']= 1;
			}
		}	


		if (isset ($ArregloDatos['orderby'])) {
			if ($ArregloDatos['orderby']!="") {	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}
		
//		echo "<br><br> Aca los parámetros (sel_actividad_curso_persona_avanzada_xdatos) = <br><br>";
//		print_r($sparam);
//		echo "<br><br><br>";

		$spnombre="sel_actividad_curso_persona_avanzada_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno)) {
			$error="Error al buscar la Persona en Actividad Curso.";
			$errormail="Error al buscar la Persona en Actividad Curso.".$errno;
			return false;
		}
		return true;
	}

//-----------------------------------------------------------------------------------------
	function  AltaDatosComisionInscribirAlumnos ($datos) {
	
		$datosvalidados=array();		

		// Valida para insertar comision_persona
		if(!$this->_DatosValidosAltaDatosComisionInscribirAlumnos($datos,$datosvalidados)) {
			return false;
		}


		// Asignacion de la persona a la actividad
		$spnombre="ins_comision_persona";
		$spparam=array(
			'pcomi_codigo'=>$datosvalidados['comi_codigo'],
			'ppers_codigo'=>$datosvalidados['pers_codigo'],
			'pescalafcod'=>$datosvalidados['escalafcod'],
			'pagrupcod'=>$datosvalidados['agrupcod'],
			'pescalafnivcod'=>$datosvalidados['escalafnivcod'],
			'pescalaftramocod'=>$datosvalidados['escalaftramocod'],
			'pescalafgradocod'=>$datosvalidados['escalafgradocod'],
			'pagfunc_codigo'=>$datosvalidados['agfunc_codigo'],
			'peval_codigo'=>$datosvalidados['eval_codigo'],
			'pjurisdid_inap'=>$datosvalidados['jurisdid_inap'],
			'pjurisdid_apn'=>$datosvalidados['jurisdid_apn'], 
			'porgapub_codigo'=>$datosvalidados['orgapub_codigo'],
			'pnivest_codigo'=>$datosvalidados['nivest_codigo'],
			'pagentes_a_cargo'=>$datosvalidados['agentes_a_cargo'],
			'ppaiscod_revista'=>$datosvalidados['paiscod_revista'],
			'pprovinciacod_revista'=>$datosvalidados['provinciacod_revista'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al asignar la persona a la comisión .",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		$oAgente = new cAgentes($this->conexion);
		
		// Actualizo el mail (de la persona) al inscribir 
		if(!$oAgente -> ModifMailPers($datosvalidados)) {
			$errormail="(al actualizar el mail personal) \nppers_codigo".$datosvalidados['pers_codigo'];						
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al asignar la persona a la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		// Insertar / Actualizar datos laborales del Agente
		if ($datosvalidados['tipo_individual_con_org'] == SI) {
			if ($datosvalidados['es_modif_agente']) {
				if($oAgente->ModifDatosAgente($datosvalidados['datos_agente'])) {
					FuncionesPHPLocal::RegistrarAcceso($this->conexion,"35703","pers_codigo=".$datosvalidados['pers_codigo'],$_SESSION['usuariocod']);
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se han modificado los datos laborales de la persona con CUIT ".$datosvalidados['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar los datos del agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
			} else {
				
				if (!$datosvalidados['hay_agente'])
					if($oAgente->AltaDatosAgente($datosvalidados['datos_agente'])) {
						FuncionesPHPLocal::RegistrarAcceso($this->conexion,"35701","pers_cuilt=".$datosvalidados['pers_cuilt'],$_SESSION['usuariocod']);
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se han dado de Alta los datos laborales de la persona con CUIT ".$datosvalidados['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					} else {
						// EL error ya se muestra en el alta.	
						// FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al agregar los datos del agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}
			}
		
		} else {
			if ($datosvalidados['hay_agente']) {
					if($oAgente->BorrarDatosAgente($datosvalidados['pers_cuilt'])) {
						FuncionesPHPLocal::RegistrarAcceso($this->conexion,"35702","pers_cuilt=".$datosvalidados['pers_cuilt'],$_SESSION['usuariocod']);
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se han Eliminado los datos laborales de la persona con CUIT ".$datosvalidados['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					} else {
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar los datos del agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}
			}
		}
		return true;
	}


