//----------------------------------------------------------------------------------------- 
	function UniversidadesPosiblesAsignar ($usuariocod,&$numfilas,&$univ_sin_asignar ){
		
		$spnombre="sel_universidad_asignar_xusuario";
		$spparam=array(
			'pusuariocod'=> $usuariocod,
			'puniv_estado'=> ESTADOACTIVO
			);
			
  		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar las universidades.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} 

		$univ_sin_asignar=array();
		if($numfilas>0) {
			while($fila=mysqli_fetch_assoc($resultado))
				$univ_sin_asignar[]=$fila["univ_codigo"];
		}	

		
		return true;
			
	}
	
	
		
//----------------------------------------------------------------------------------------- 
	function TienePermisoAsignarUniversidad ($rolcod){
	
		if($rolcod != ADMIINAP)	{
			return false;
		} 
		
		return true;
			
	}

	//----------------------------------------------------------------------------------------- 
	function TienePermisoDesasignarUniversidad ($rolcod){
	
		if($rolcod != ADMIINAP)	{
			return false;
		} 
		
		return true;
			
	}
	
	
		
//----------------------------------------------------------------------------------------- 
	function AsignarUniversidad ($usuariocod, $univ_codigo, &$error, &$errormail){

			$spnombre="ins_usuario_universidad";
			$spparam=array("pusuariocod"=>$usuariocod);				
			$spparam+=array("puniv_codigo"=>$univ_codigo);			
			$spparam+=array("pultmodusuario"=>$_SESSION['usuariocod']);
			$spparam+=array("pultmodfecha"=>date("Y/m/d H:i:s"));
							
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)			{
				$errormail="Error al insertar en ins_usuario_universidad"."\n".$errorparam;
				$error="Error al asignar la universidad"."\n".$errorparam;
				return false;
			}
		return true;
	}

//----------------------------------------------------------------------------------------- 
	function DesasignarUniversidad ($usuariocod, $univ_codigo, &$error, &$errormail){

			$spnombre="del_usuario_universidad";
			$spparam=array("pusuariocod"=>$usuariocod);				
			$spparam+=array("puniv_codigo"=>$univ_codigo);			
							
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)			{
				$errormail="Error al eliminar en usuario_universidad"."\n";
				$error="Error al eliminar la universidad"."\n";
				return false;
			}
		return true;
	}
				

//----------------------------------------------------------------------------------------- 
} // fin Clase
?>