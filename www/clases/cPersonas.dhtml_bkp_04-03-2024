		return true;
	}	
//----------------------------------VANI------------------------------------------------------- 
// Retorna una consulta con todos las personas que cumplan con las condiciones

// Parámetros de Entrada:
//		datosbuscar: array asociativo con los filtros. 
//	Claves: pers_nombre, pers_apellido, pers_cuilt,
//			pers_codigo, pers_estado

// Retorna:
//		numfilas,resultado: cantidad de filas y query de resultado
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function BuscarPersonas ($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)
	{
		$sparam=array('pxcuit'=>0);
		$sparam+=array('pxcod'=>0);
		$sparam+=array('pxnombre'=>0);
		$sparam+=array('pxapellido'=>0);
		$sparam+=array('pxestado'=>0);
		
		$sparam+=array('ppers_cuilt' =>"");
		$sparam+=array('ppers_codigo' =>"");
		$sparam+=array('ppers_nombre' =>"");
		$sparam+=array('ppers_apellido' =>"");
		$sparam+=array('ppers_estado' =>"-1");
		$sparam+=array('porderby' =>"pers_apellido,pers_nombre");

		if (isset ($ArregloDatos['pers_cuilt']))
		{
			if ($ArregloDatos['pers_cuilt']!="")
			{	
				$sparam['ppers_cuilt']= $ArregloDatos['pers_cuilt'];
				$sparam['pxcuit']= 1;
			}
		}
		if (isset ($ArregloDatos['pers_codigo']))
		{
			if ($ArregloDatos['pers_codigo']!="")
			{	
				$sparam['ppers_codigo']= $ArregloDatos['pers_codigo'];
				$sparam['pxcod']= 1;
			}
		}	
		if (isset ($ArregloDatos['pers_nombre']))
		{
			if ($ArregloDatos['pers_nombre']!="")
			{	
				$sparam['ppers_nombre']= $ArregloDatos['pers_nombre'];
				$sparam['pxnombre']= 1;
			}
		}
		if (isset ($ArregloDatos['pers_apellido']))
		{
			if ($ArregloDatos['pers_apellido']!="")
			{	
				$sparam['ppers_apellido']= $ArregloDatos['pers_apellido'];
				$sparam['pxapellido']= 1;
			}
		}
		if (isset ($ArregloDatos['pers_estado']))
		{
			if ($ArregloDatos['pers_estado']!="")
			{	
				$sparam['ppers_estado']= $ArregloDatos['pers_estado'];
				$sparam['pxestado']= 1;
			}
		}

		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_personas_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar la Persona.";
			$errormail="Error al buscar la Persona ".$errno;
			return false;
		}

		return true;
	}


