$filaauto=array();
$filaauto['act_codinap']=(isset($_POST['act_codinap_seleccion']))?$_POST['act_codinap_seleccion']:"";

$destino_formulario_selector="actividad_autodesarrollo_alta.dhtml";
$destino_formulario_interface="actividad_autodesarrollo_alta_upd.dhtml";
$ok = true;
$_SESSION['carga_inicial']=true;
?>
<form action="<?php echo $destino_formulario_selector ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
