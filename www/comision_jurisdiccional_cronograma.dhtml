<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

//----------------------------------------------------------------------------------------- 
	function MostrarGrillaSeleccion($conexion,$oComision,$modulo,$comi_codigo) {

		$ArregloDatos= array();
		$ArregloDatos['porderby'] = "comifec_fecha, comifec_hora_inicio, comifec_hora_fin";
		$ArregloDatos['comi_codigo'] = $comi_codigo;

		if (!$oComision->BuscarComiCronograma($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\ncomi_codigo=".$comi_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos del cronograma de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		}			
		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"NombrePaginaQuery"=>"pagina",
			"FilasPagina"=>10
		);
		
		if (isset($_GET['pagina']))	{
			$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
			$opciones['QueryString']=$querystring;
		}
		
		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla('Cronograma');	
		$oGrilla->SetearAnchoGrilla('90%');
		
		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'Horario');
		$oGrilla->Setear('campo_grilla',$miColumna1,'horario');
		$oGrilla->Setear('align_columna',$miColumna1,'left');

		$miColumna2 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Editar');
		$oGrilla->Setear('ancho_columna',$miColumna2,'60');
		$oGrilla->Setear('url',$miColumna2,$modulo);
		$oGrilla->Setear('url_ancla',$miColumna2,'Edicion');
		$oGrilla->Setear('imagen',$miColumna2,'images/editar.jpg');
		$oGrilla->Setear('altImagen',$miColumna2,'Editar');						
		$oGrilla->AddParametrosURL($miColumna2,"comi_codigo",$comi_codigo,"cte");
		$oGrilla->AddParametrosURL($miColumna2,"pagina",$opciones["numPagina"],"cte");
		$oGrilla->AddParametrosURL($miColumna2,"comifec_codigo","comifec_codigo");
		$oGrilla->AddParametrosURL($miColumna2,"operacion","M","cte");
	
		$miColumna3 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Eliminar');
		$oGrilla->Setear('ancho_columna',$miColumna3,'60');
		$oGrilla->Setear('url',$miColumna3,$modulo);
		$oGrilla->Setear('url_ancla',$miColumna3,'Edicion');
		$oGrilla->Setear('imagen',$miColumna3,'images/borrar.jpg');
		$oGrilla->Setear('altImagen',$miColumna3,'Eliminar');
		$oGrilla->AddParametrosURL($miColumna3,"comi_codigo",$comi_codigo,"cte");
		$oGrilla->AddParametrosURL($miColumna3,"pagina",$opciones["numPagina"],"cte");
		$oGrilla->AddParametrosURL($miColumna3,"comifec_codigo","comifec_codigo");
		$oGrilla->AddParametrosURL($miColumna3,"operacion","B","cte");

		if (!$oGrilla->CargarGrilla($result))
			return false;
			
		$oGrilla->MostrarGrilla();

		return true;
	} 		
//----------------------------------------------------------------------------------------- 
$oComision= new cComisionCronograma($conexion);
$oActividad = new cActividadCurso($conexion);

?>
<script type="text/javascript" src="calendar/calendar.js"></script>
<script type="text/javascript" src="calendar/calendar-setup.js"></script>
<script type="text/javascript" src="calendar/calendar-es.js"></script>

<script type="text/javascript">
	<?php $oComision->ValidarFormAltaCronograma(); ?>
</script>
<?php
$filacomision=array();

$filacomision['comi_codinap']=(isset($_POST['comi_codinap_seleccion']))?$_POST['comi_codinap_seleccion']:"";

$filacomision['comi_codigo']=(isset($_GET['comi_codigo']))?$_GET['comi_codigo']:"";
$filacomision['comi_codigo']=(isset($_POST['comi_codigo']))?$_POST['comi_codigo']:$filacomision['comi_codigo'];

if (isset($_POST['comi_codinap_seleccion'])) {
	if($conexion->TraerCampo("comision","comi_codigo",array("comi_codinap='",$_POST['comi_codinap_seleccion'],"'"),$comi_codigo,$numfilas,$errno))
		$filacomision['comi_codigo']=htmlspecialchars($comi_codigo,ENT_QUOTES);
}
if ( isset($_POST['comi_codigo']) || isset($_GET['comi_codigo']) ) {
	if($conexion->TraerCampo("comision","comi_codinap",array("comi_codigo='",$filacomision['comi_codigo'],"'"),$comi_codigo_inap,$numfilas,$errno))
		$filacomision['comi_codinap']=htmlspecialchars($comi_codigo_inap,ENT_QUOTES);
}

$destino_formulario_interface="comision_jurisdiccional_cronograma.dhtml";
?>
<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oComision->PedirComision($filacomision['comi_codinap'],'formulario_seleccion','comi_codinap_seleccion','Actualizar Jurisdiccional'); ?></td>
	</tr>
	</table>
</form>	
<?php
$ok=false;

if ($filacomision['comi_codigo']=="") {

	if ( isset($_POST['comi_codigo']) || isset($_POST['comi_codinap_seleccion']) )
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

} else {

	if ($oComision->TraerDatosComision($filacomision['comi_codigo'],$filacomision,$es_modif)) {
		
		if (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else { 
			switch ($_SESSION['rolcod']) {
				
				case USUCURSOINAP:
					$oActividadCurso = new cActividadCursoInap($conexion); 
					$formact_codigo=FORMATOCURSO;
					$tipoact_codigo=TIPOACTCURSOINAP;
					break;
				case SUPERUSUARIO:	
				case USUORGANISMO:
				case COORDINADORTECNICO:
					$oActividadCurso = new cActividadCursoJurisdiccional($conexion); 
					$formact_codigo=FORMATOCURSO;
					$tipoact_codigo=TIPOACTCURSOJURISD;
					break;
			}		

			// Busco la comision para obtener 
			if ($oComision->TraerDatosComision($filacomision['comi_codigo'],$filacomision,$es_modif)) {
				$act_codigo=$filacomision['act_codigo'];
				$actprog_sec=$filacomision['actprog_sec'];
				$formact_codigo=$formact_codigo;
				$tipoact_codigo=$tipoact_codigo;
		
				if ($oActividadCurso->MostrarDatosActividadAsignable($conexion,$act_codigo,$formact_codigo,$tipoact_codigo,$actprog_sec)) {
					if ($oComision->TienePermisoModificar($filacomision['comi_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
						$ArregloDatos = array();
						$ArregloDatos['act_codigo'] = $filacomision['act_codigo'];
						$ArregloDatos['actprog_sec'] = $filacomision['actprog_sec'];		
						
						if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result_actividad,$error,$errormail)){
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando la programación de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						} elseif ($numfilas != 1) {
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando la programación de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						} else {
							$fila_actividad = mysqli_fetch_assoc($result_actividad);
							$ok=true;
						}
					} // Tiene permiso el usuario sobre la comision
				} // mostrar actividad asignable
			}	//  TraerDatosComision
		}	// Se encontró la actividad con el formato esperado		
	} // No se produjo error al buscar la actividad con el formato esperado		

} // seleccion de actividad

//------------------------------------------------------------
// Inicio de pantalla
//------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Se confirmo la operacion 
//--------------------------------------------------------------
if (isset($_POST['boton_confirma']) && !isset($_POST['boton_cancela'])) {

	$commit=true;
	$conexion->ManejoTransacciones("B");

	// Alta - Baja - Modificación
	if ($commit) {

		switch($_POST['operacion']) {
		case 'I': 	
	
			if ($oComision->AltaDatosComisionCronograma($_POST,$nuevocodigo)) {
				$nuevocodigo=$conexion->UltimoCodigoInsertado();
				FuncionesPHPLocal::RegistrarAcceso($conexion,"50201","comifec_codigo=".$nuevocodigo,$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha actualizado el cronograma de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else 
				$commit=false;

			break;	
			
		case 'M': 
			if ($oComision->ModifDatosComisionCronograma($_POST)) {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"50203","comifec_codigo=".$_POST['comifec_codigo'],$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha actualizado el cronograma de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else 
				$commit=false;

			break;	

		case 'B': 
			if ($oComision->EliminarDatosComisionCronograma($_POST['comifec_codigo'])) {			
				FuncionesPHPLocal::RegistrarAcceso($conexion,"50202","comifec_codigo=".$_POST['comifec_codigo'],$_SESSION['usuariocod']);	
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha eliminado a fecha en el cronograma de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else 
				$commit=false;
			break;	

		default: 
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en la operación",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$commit=false;
		} // $switch
		
		if($commit) 
			$conexion->ManejoTransacciones("C");
		else 
			$conexion->ManejoTransacciones("R");
	}	// commit

} // seteado el confirma 

if ($ok) { 

	$modulo_recarga= "comision_jurisdiccional_cronograma.dhtml?comi_codigo=".$filacomision['comi_codigo'];

	// Se define la acción
	if (!isset($_GET['operacion'])) {
		$leyenda_operacion = "Agregar";
		$boton_operacion = "Agregar";		
		$operacion = "I";
	} else {
		switch ($_GET['operacion']) {		
		case "M" :
				$leyenda_operacion = "Actualizar";		
				$boton_operacion = "Actualizar";		
				$operacion = "M";				
				break;
		case "B" :
				$leyenda_operacion = "Eliminar";		
				$boton_operacion = "Eliminar";		
				$operacion = "B";				
				break;
		default:
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error de operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok=false;
		}
	}

	//------- GRILLA VALORES A MODIFICAR 
	if ($ok)  { 
	?>	<div style="width:95%" align="right"><a href="comision_jurisdiccional_modificar.dhtml?comi_codigo=<?= $filacomision['comi_codigo'] ?>">Ir a la Comisi&oacute;n</a></div>
		<div style="width:95%" align="right">
			<img src="images/verdetalle.gif" alt="" title="" width="25" height="25" />
			<a href="javascript:Popup('comision_ver_detalle_popup.dhtml?comi_codigo=<?php echo $filacomision['comi_codigo'] ?>','ventana_comision',650,420,screen.availWidth-670,screen.availHeight-460,'yes');" >	Ver Datos Comisi&oacute;n </a>
		</div>
		<div align='center'>
	<?php	if (!MostrarGrillaSeleccion($conexion,$oComision,$modulo_recarga,$filacomision['comi_codigo']))
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar datos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	?>	</div> <?php
	} 
	//------- DATOS DE UN REGISTRO
	if ($ok) { 	
		
		$fila_cronograma=array("comi_codigo"=>$filacomision["comi_codigo"]);						//  NUEVO
		$es_modif=false;
		
		if ($operacion == "I")
			$fila_cronograma['comifec_codigo']="";
			
		if ($operacion == "M" || $operacion == "B") {	// BAJA o MODIFICACION (tiene los mismos permisos de acceso)
			// Datos para la seleccion de un registro por su clave.
			if (!$oComision->TraerDatosCronograma($_GET['comifec_codigo'],$fila_cronograma,$es_modif)) {
				$txt_sys_mail="\ncomifec_codigo=".$_GET['comifec_codigo'];
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos de la tabla comision_fecha.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				$ok=false;
			} else 
				$numfilas=count($fila_cronograma);		
	
			if ($numfilas==0)  {
				$txt_sys_mail="\ncomifec_codigo=".$_GET['comifec_codigo']."\nnumfilas=".$numfilas;
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos, no existe el valor buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				$ok=false;
			} 	
		} // Obtencion de datos 
	
		if ( $ok ) {  	?>	
			<br />
			<a name="Edicion"></a>
			<table width="90%"  align="center" cellspacing="0" cellpadding="0">			
			<!-- DATOS A MODIFICAR -->
			<tr> 
				<td>
					<fieldset class="bordeDetalleRegistro">
					<legend class="textoLeyendaDetalleRegistro">  Detalle del Registro  ( <?php echo $leyenda_operacion ?>  )</legend>
					<form action="<?php echo $modulo_recarga; ?>" method="post" name="formulario">
					<table width="100%" class="textoTablaDato" cellpadding="2" cellspacing="0">
							<tr>
								<td valign="middle" class="textoEtiqueta" width="30%">Fecha</td>
								<td class="textoEtiquetaDatoResaltado" width="70%">	
							<?php 	if ($operacion == "B") { ; 
									echo  FuncionesPHPLocal::ConvertirFecha($fila_cronograma["comifec_fecha"],'aaaa-mm-dd','dd/mm/aaaa');
								} else { ?>
									<input type="text" name="comifec_fecha" id="comifec_fecha"   maxlength="10" size="11" class="textoInput" value="<?php echo ($operacion!="I")? FuncionesPHPLocal::ConvertirFecha($fila_cronograma["comifec_fecha"],'aaaa-mm-dd','dd/mm/aaaa'):"" ?>"> 
									<img src="images/calendario.gif" id="cal-button-2" name="cal-button-2" style="vertical-align:-4px; cursor:pointer" border="0" alt="Calendario">
									<script type="text/javascript">
										Calendar.setup({
		<?php								if ($operacion!="I")	{
		?>									  date    : "<?php echo  FuncionesPHPLocal::ConvertirFecha($fila_cronograma["comifec_fecha"],'aaaa-mm-dd','dd/mm/aaaa') ?>",
		<?php								}		?>				
										range		  : [<?php echo ANOINICALINAP ?>,<?php echo date("Y") ?>],
										inputField    : "comifec_fecha",
										button        : "cal-button-2",
										ifFormat	: "%d/%m/%Y"
										});
									</script>
								  <span class="textoAclaraciones">(dd/mm/aaaa)</span>
								  <div style='font-size: 7px;'>&nbsp;</div>
							<?php } ?>
							
								</td>							
							</tr> 
	
							<tr>
								<td valign="top" class="textoEtiqueta">Hora Inicio</td>
								<td class="textoEtiquetaDatoResaltado">	
							<?php 	if ($operacion == "B") { ; 
									echo  $fila_cronograma['hora_inicio'];
								} else { ?>
									<input name="comifec_hora_inicio" type="text" size="6" maxlength="5" <?php echo ($operacion == "B")?' class="inputReadonly" readonly ':' class="textoInput" ' ?> value ="<?php if($operacion == "M" || $operacion == "B") echo $fila_cronograma['hora_inicio'] ?>"> 
									  <span class="textoAclaraciones">(hh:mm)</span>
									  <div style='font-size: 7px;'>&nbsp;</div>
							<?php } ?>
								</td>							
							</tr> 
	
							<tr>
								<td valign="top" class="textoEtiqueta">Hora Finalización</td>
								<td class="textoEtiquetaDatoResaltado">	
							<?php 	if ($operacion == "B") { ; 
									echo  $fila_cronograma['hora_fin'];
								} else { ?>
									<input name="comifec_hora_fin" type="text" size="6" maxlength="5" <?php echo ($operacion == "B")?' class="inputReadonly" readonly ':' class="textoInput" ' ?> value ="<?php if($operacion == "M" || $operacion == "B") echo $fila_cronograma['hora_fin'] ?>"> 
									  <span class="textoAclaraciones">(hh:mm)</span>
									  <div style='font-size: 7px;'>&nbsp;</div>
							<?php } ?>
								</td>							
							</tr> 
							
							<tr>
								<td colspan="2" align="center">
									<input type="submit" name="boton_valido_operacion" value="<?php echo $boton_operacion; ?>" onClick="return ValidarFormAltaCronograma(formulario,'<?php echo $operacion ?>','<?php echo FuncionesPHPLocal::ConvertirFecha($fila_actividad["actprog_fecha_inicio"],'aaaa-mm-dd','dd/mm/aaaa') ?>','<?php echo FuncionesPHPLocal::ConvertirFecha($fila_actividad["actprog_fecha_fin"],'aaaa-mm-dd','dd/mm/aaaa') ?>');" class="botones" />
									<input type="hidden" name="boton_confirma" value="<?php echo $boton_operacion; ?>">
									<input type="submit" name="boton_cancela" value="Cancelar" class="botones" />
									<input type="hidden" name="operacion" id="operacion" value="<?php echo $operacion;?>" />
									<input type="hidden" name="comi_codigo" value="<?php echo $filacomision["comi_codigo"];?>" />
									<input type="hidden" name="comifec_codigo" id="comifec_codigo" value="<?php echo (isset($fila_cronograma['comifec_codigo']))?$fila_cronograma['comifec_codigo']:"" ?>" />				  
									<input type="hidden" name="actprog_fecha_inicio_act" id="actprog_fecha_inicio_act" value="<?php echo FuncionesPHPLocal::ConvertirFecha($fila_actividad["actprog_fecha_inicio"],'aaaa-mm-dd','dd/mm/aaaa');?>" />
									<input type="hidden" name="actprog_fecha_fin_act" id="actprog_fecha_fin_act" value="<?php echo FuncionesPHPLocal::ConvertirFecha($fila_actividad["actprog_fecha_fin"],'aaaa-mm-dd','dd/mm/aaaa');?>" />
								</td>
							</tr>					
					</table>
					</form>
					</fieldset> 	
				</td>
				</tr>
			</table>
	<?php		} // fin ok
		} //  fin ok
} // fin ok
$oEncabezados->PieMenuEmergente(); 
