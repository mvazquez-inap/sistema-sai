<?php 
require('./include.dhtml');
header('Content-Type: text/html; charset=utf-8');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oPersonas = new cPersonas($conexion);
$oAgentes = new cAgentes($conexion);
$oComisionPersona = new cComisionPersona($conexion);	
$escalafon = new cEscalafones($conexion);
$jurisdicciones	 = new jurisdicciones;
$oComisionPersona= new cComisionPersona($conexion);
//-----------------------------------------------------------------------------------------------------------------------------------
	$ok = true;

	// Busco la persona y saco sus datos o informo que debe dar el alta
	if(!$oPersonas->TraerDatosPersona($_POST["pers_cuilt"],$datospersona,$es_modif)) {
		$ok=false;
	} elseif (!$es_modif) {
			$mensaje = "La Persona no se encuentra en el sistema. <br> Deber&aacute; crearla haciendo click en el botón Nueva Persona";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$mensaje,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok=false;
		/*  Cambio - Revisar
		} elseif($datospersona['pers_estado'] == PERSONABAJA) {
			$error="La persona ingresada se encuentra dada de baja.<br>Deber&aacute; rehabilitar a la persona.";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok = false;  */
	}

	// Busco la inscripción en la comisión
	if ($ok) {
		$ArregloDatos = array();
		$ArregloDatos['pers_codigo'] = $datospersona['pers_codigo'];
		$ArregloDatos['comi_codigo'] = $_POST['comi_codigo'];
		
		$leyendaBoton = "Agregar";
		$tiene_asignacion = false;
		$operacion = "I";
	
		if(!$oComisionPersona->BuscarActividadAsignadaPersona ($ArregloDatos, $numfilas, $result, $error, $errormail)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$ok = false;
		} elseif ($numfilas >= 1)	{
			$leyendaBoton = "Actualizar";
			$tiene_asignacion = true;		
			$operacion = "M";
		}
	
		$fila_asignacion = mysqli_fetch_assoc($result);
	}	

	// Cambio - Revisar
	// Si esta de baja y no tiene asignación
	if($datospersona['pers_estado'] == PERSONABAJA && !$tiene_asignacion) {
		$error="La persona ingresada se encuentra dada de baja.<br>Deber&aacute; rehabilitar a la persona.";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok = false; 
	}


	// no está inscripto en la comisión
	// verifico si corresponde la inscripción en la actividad
	if ($ok && $operacion == "I") {
	
		if (!$oComisionPersona->VerificarInscripcionPersona($_POST['comi_codigo'],$datospersona['pers_codigo'],$puede_inscribir, $mensaje_no_inscripcion)) {
//			$errormail = "\ncomi_codigo=".$_POST['comi_codigo']."\npers_codigo=".$datospersona['pers_codigo'];
//			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al verificar la inscripción de la persona en la actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$ok = false;
		}
		
		if (!$puede_inscribir) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$mensaje_no_inscripcion,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok = false;
		}
	}

	if ($ok) {
		// Buscamos datos del agente y los pegamos o no 
		if(!$oAgentes->TraerDatosAgente($_POST["pers_cuilt"],$datosagente,$es_modif_agente)) {
			$ok=false;
			?><br><br><br><div align="center"><a href="agente_modificar.dhtml" class="linkFondoBlanco">Volver</a></div><?php
		}  	elseif (($es_modif_agente ) && ($datosagente['pers_estado'] == PERSONABAJA)) {
				$error="La persona ingresada se encuentra dada de baja.<br>Deber&aacute; rehabilitar a la persona.";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
			} 
		if ($operacion == "I")			
			$fila_asignacion = $datosagente;
	}

	// Determino la jurisdiccion a mostar
	if ($ok) {
		
		$jurisdnom = "";
		$jurisdid = "";		
		$tipoorg_codigo = "";		
		
		if (isset($fila_asignacion['jurisdid_apn'])) {
			$tipoorg_codigo = ORGANISMO_APN;
			$jurisdid = 'jurisdid_apn';
			if ($jurisdicciones->SelectJurisdxID($fila_asignacion['jurisdid_apn'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError)) 
				$jurisdnom=htmlspecialchars($fila_jurisd[$fila_asignacion['jurisdid_apn']]['jurisdnom'],ENT_QUOTES);
		} elseif (isset($fila_asignacion['orgapub_codigo'])) {
				$tipoorg_codigo = ORGANISMO_NO_APN;		
				$jurisdid = 'orgapub_codigo';
				$spnombre = "sel_organismo_publico_xdatos";
				$spparam = array("pxclave"=>"1","porgapub_codigo"=>$fila_asignacion["orgapub_codigo"],"pxdescripcion"=>"0","porgapub_nombre"=>"0","porgapub_nombre"=>"0","pxestado"=>"0","porgapub_estado"=>"0","porderby"=>"orgapub_nombre");
				if(!$conexion->BuscarRegistroxClave($spnombre,$spparam,array("orgapub_codigo"=>$fila_asignacion["orgapub_codigo"]),$resultado,$filaret,$numfilasmatcheo,$errno)) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al seleccionar el organismo público. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok =  false;
				} elseif($numfilasmatcheo!=1) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al seleccionar el organismo público. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok =  false;
				}
				$jurisdnom = $filaret['orgapub_nombre'];
		} // isset($fila_asignacion['jurisdid_apn'])
	} // ok - determino jurisdiccion


	if ($ok) {		?>
