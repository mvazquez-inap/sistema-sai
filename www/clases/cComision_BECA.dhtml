//-----------------------------------------------------------------------------------------------------	
	function ResumenComision($comi_codigo, &$datos_evaluacion) {
		
		$ok = true;
		$datos_evaluacion = array();
	
		$spparam=array('porderby'=>"eval_descripcion");
		if(!$this->conexion->ejecutarStoredProcedure("sel_evaluacion_orden",$spparam,$resultado,$numfilas,$errno)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al cargar las evaluaciones.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok = false;
		} else { 	
		    $total_inscriptos = 0;
			while ($fila_evaluacion = mysqli_fetch_assoc($resultado)) {
				$array_evaluacion=array();							
				if ($this->ResumenEvaluacion($comi_codigo, $fila_evaluacion['eval_codigo'],$array_evaluacion)) {

					$datos_evaluacion[$fila_evaluacion['eval_codigo']] = array ('eval_codigo' => $fila_evaluacion['eval_codigo'],
											     'eval_descripcion'=> $fila_evaluacion['eval_descripcion'],				
											     'cantidad' => $array_evaluacion['cantidad']);								

					 $total_inscriptos = $total_inscriptos + $array_evaluacion['cantidad'];
				} else 
					$ok = false;			
			}
		}	
		
		if ($ok)  // Agrego el Total
			$datos_evaluacion[] = array ('eval_codigo' => 0,'eval_descripcion'=> "TOTAL",'cantidad' => $total_inscriptos);								
		
		return $ok;
	}
	
//-----------------------------------------------------------------------------------------------------	
	function ObtenerCodigoInap ($act_codigo, &$comi_codinap) {

		if ( ($_SESSION['rolcod']==COORDINADORTECNICO) || ($_SESSION['rolcod']==USUORGANISMO)) {
			// es Comision Jurisdiccional

			if (!$this->conexion->TraerCampo("jurisdiccion_inap","jurisd_prefijo_comision",array("jurisdid='",$_SESSION['jurisdid_inap'],"'"),$prefijo,$numfilas,$errorcod)) {
				$errormail="\nact_codigo".$act_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el Organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			$tipo = "JU";

		} else { 
			// es Comisión INAP
			$prefijo = "BECA";
			$sparam=array('pact_codigo'=>$act_codigo);
			$spnombre="sel_actividad_curso_diseno_inap_xact_codigo";
		
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
			{
				$errormail="\nact_codigo".$act_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			
			if ($numfilas == 1)	{
				$fila_diseno= mysqli_fetch_assoc($resultado);
			} 
	
			if (!$this->conexion->TraerCampo("area_curso_inap","areacur_prefijo",array("areacur_codigo='",$fila_diseno['areacur_codigo'],"'"),$prefijo,$numfilas,$errorcod)) {
				$errormail="\nact_codigo".$act_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el Area de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			
			$tipo = "IN";
		}

		$comi_codinap = $tipo."-".$prefijo;

		return true;
	}
	

//-----------------------------------------------------------------------------------------------------	
	function DescargarExcelComision($comi_codigo, &$oExcel, $nuevo_excel=true) {	


		if ($this->TraerDatosComision($comi_codigo, $filacomision, $es_modif)) {
			if (!$es_modif) {
			 	FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pueden obtener los datos de la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		}

		if ($nuevo_excel) {
			$nombrearchivo="comision.xls";  
			$oExcel= new cEscribirExcel($nombrearchivo);
		}		

		$oExcel->AddHoja('Comision');
		$ancho_columna['leyenda']=30;
		$ancho_columna['valor']=70;

		$oExcel->FormatoColumna (0,$ancho_columna['leyenda']); 
		$oExcel->FormatoColumna (1,$ancho_columna['valor']); 				

		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor",22);
		$oExcel->CargarDatosVariasCeldas (0,0,0,1,'Detalle de la Comisión',true);
				
		$oExcel->BorrarFormato("");	
		$oExcel->AddFormato ("Tamaño",8);
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("VAlign","vcenter");
		$formato_leyenda=$oExcel->GetFormato(); 	

		$oExcel->BorrarFormato("");
		$oExcel->AddFormato ("Tamaño",8);
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("FgColor","blanco");
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("VAlign","vcenter");
		$formato_dato=$oExcel->GetFormato(); 	


		// Titulos de las columnas

		$arrayclaves=array(	'leyenda','valor');


		foreach ($arrayclaves as $clave => $valor) {	
			if ($valor == 'leyenda')
	 			$arrayformato[$valor]=$formato_leyenda;
			else 
	 			$arrayformato[$valor]=$formato_dato;
		}


		$array_datos[0]['leyenda'] = "Código de Comisión";
		$array_datos[0]['valor'] = $filacomision['comi_codinap'];


		// estado comisión
		if (!$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","COMISIONESTADO","' and constantecod='",$filacomision['comi_estado'],"'"),$descri_estado,$numfilas,$errorcod)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado el estado de la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}						
		$array_datos[1]['leyenda'] = "Estado de Comisión";
		$array_datos[1]['valor'] = $descri_estado;
						
		// tipo de inscripción
		if (!$this->conexion->TraerCampo("tipo_inscripcion","tipoins_descripcion",array("tipoins_codigo='",$filacomision['tipoins_codigo'],"'"),$descri_tipo,$numfilas,$errorcod)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado el tipo de inscripción.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$array_datos[2]['leyenda'] = "Tipo de Inscripción";
		$array_datos[2]['valor'] = $descri_tipo;

		$array_datos[3]['leyenda'] = "Fecha de Inicio";
		$array_datos[3]['valor'] = $filacomision['comi_fecha_inicio_ddmmaaaa'];
		
		$array_datos[4]['leyenda'] = "Fecha de Fin";
		$array_datos[4]['valor'] = $filacomision['comi_fecha_fin_ddmmaaaa'];
		
		$array_datos[5]['leyenda'] = "Acta";
		$array_datos[5]['valor'] = $filacomision['comi_acta_numero'];

		$array_datos[6]['leyenda'] = "Vacantes";
		$array_datos[6]['valor'] = $filacomision['comi_vacantes'];

		$array_datos[7]['leyenda'] = "Sobreventa";
		$array_datos[7]['valor'] = $filacomision['comi_sobreventa'];


		// País
		if (!$this->conexion->TraerCampo("paises","paisnom",array("paiscod='",$filacomision['pais_codigo'],"'"),$descri_pais,$numfilas,$errorcod)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado el país.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$array_datos[8]['leyenda'] = "País";
		$array_datos[8]['valor'] = $descri_pais;

		// Provincia
		if (!$this->conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$filacomision['prov_codigo'],"'"),$descri_prov,$numfilas,$errorcod)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la provincia.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$array_datos[9]['leyenda'] = "Provincia";
		$array_datos[9]['valor'] = $descri_prov;

		// Sede
		if (!$this->conexion->TraerCampo("sede","sede_descripcion",array("sede_codigo='",$filacomision['sede_codigo'],"'"),$descri_sede,$numfilas,$errorcod)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la sede.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$array_datos[10]['leyenda'] = "Sede";
		$array_datos[10]['valor'] = $descri_sede;

		$array_datos[11]['leyenda'] = "Domicilio";
		$array_datos[11]['valor'] = $filacomision['comi_domicilio'];

		$array_datos[12]['leyenda'] = "Detalle";
		$array_datos[12]['valor'] = $filacomision['comi_detalle'];


		$fila_datos = array();
		
		foreach ($array_datos as $i => $valor) {
			$fila_datos['leyenda'] = $array_datos[$i]['leyenda'];
			$fila_datos['valor'] = $array_datos[$i]['valor'];
			// Saco los /r que no se lo banca el excel. 
			$fila_datos['valor']=str_replace("\r\n","\n", $array_datos[$i]['valor']);
			$oExcel->CargarGrilla ($fila_datos,2+$i,0,$arrayclaves,$arrayformato);	
		}	

		if ($nuevo_excel) 
			$oExcel->Enviar();			
	
	}	


//-----------------------------------------------------------------------------------------------------	
	function DescargarExcelComisionBuscar($ArregloDatos, &$oExcel, $nuevo_excel=true) {	
		
		 // echo  "Sacar 1 ";
		 // print_r($ArregloDatos);
		
		if (isset($ArregloDatos['tipoact_codigo']) && $ArregloDatos['tipoact_codigo']!="")   
			$array_tipos = array($ArregloDatos['tipoact_codigo']); 	
		else 
			$array_tipos = array(TIPOACTCURSOINAP,TIPOACTCURSOJURISD); 	


		if ($nuevo_excel) {
			$nombrearchivo="comision_listado.xls";  
			$oExcel= new cEscribirExcel($nombrearchivo);
		}		


		$numfilas=0;
	
		// paso los parámetros a un arreglo auxiliar para eliminar las fechas si es que se selecciona algún filtro por fechas
		$ArregloDatosFechas = $ArregloDatos;
		
		if ($ArregloDatos['tipo_fecha'] != "no_filtra") {
			$ArregloDatosFechas['comi_fecha_inicio'] ="";
			$ArregloDatosFechas['comi_fecha_fin'] ="";
		}
		// se busca por prestador docente	
		if (isset($ArregloDatos['apeynom']) && $ArregloDatos['apeynom']!="") {   
				if(!$this->BuscarComisionPresDocAvanzada($ArregloDatosFechas, $numfilas, $resultComision, $error, $errormail)) {
					return false;
				} 
		} else {
				if(!$this->BuscarComisionAvanzada($ArregloDatosFechas, $numfilas, $resultComision, $error, $errormail)) {
					return false;
				} 
		
		}
		$jurisdicciones	 = new jurisdicciones;
		$comsiones_seleccionadas = array();				
		while ($fila_comision = mysqli_fetch_assoc($resultComision)) {  
	

				$jurisdnom = "---";			
				if (($fila_comision['tipoact_codigo'] == TIPOACTCURSOJURISD))
					if ($jurisdicciones->SelectJurisdxID($fila_comision['jurisdid_inap'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError)) 
						$jurisdnom=htmlspecialchars($fila_jurisd[$fila_comision['jurisdid_inap']]['jurisdnom'],ENT_QUOTES);

				$fila_comision['jurisdnom'] = $jurisdnom;

			$se_muestra = false;
			switch ($ArregloDatos['tipo_fecha']) {
				
				case "dia":
						$spnombre="sel_comision_fecha_xcomi_codigo_comifec_fecha_comifec";
						$spparam_fecha=array('pcomi_codigo'=>$fila_comision['comi_codigo'],'pcomifec_fecha'=>$ArregloDatos['comi_fecha_inicio']);
						if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam_fecha,$resultado,$numfilas,$errno))
							return false;
						if ($numfilas == 1) 
							$se_muestra = true;
						break;

				case "inicio":
						$spnombre="sel_comision_xcomi_codigo_fechainicio";
						$spparam_fecha=array('pcomi_codigo'=>$fila_comision['comi_codigo'],'pcomi_fecha_inicio'=>$ArregloDatos['comi_fecha_inicio'],'pcomi_fecha_fin'=>$ArregloDatos['comi_fecha_fin']);
						if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam_fecha,$resultado,$numfilas,$errno))	
							return false;
						if ($numfilas == 1) 
							$se_muestra = true;
						break;


				case "fin":
						$spnombre="sel_comision_xcomi_codigo_fechafin";
						$spparam_fecha=array('pcomi_codigo'=>$fila_comision['comi_codigo'],'pcomi_fecha_inicio'=>$ArregloDatos['comi_fecha_inicio'],'pcomi_fecha_fin'=>$ArregloDatos['comi_fecha_fin']);
						if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam_fecha,$resultado,$numfilas,$errno))	
							return false;
						if ($numfilas == 1) 
							$se_muestra = true;
				
				break;

				case "no_filtra":
					$se_muestra = true;
				break;					
			
			}

			// $se_muestra = true;
			if ($se_muestra) {

				// echo  "Sacar  = entro en se muestra ";
			
				$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_comision['tipoact_codigo'],"'"),$tipoact_descripcion,$numfilas,$errorcod); 

				if ($fila_comision['tipoact_codigo'] == TIPOACTCURSOINAP) {
					
					// echo  "Sacar = tipo de actividad ";
					
					$sparam=array('pact_codigo'=>$fila_comision['act_codigo']);
					$spnombre="sel_actividad_curso_diseno_inap_xact_codigo";
				
					if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
						return false;
					
					if ($numfilas == 1)	{
						$fila_diseno= mysqli_fetch_assoc($resultado);
					}

					if ($this->conexion->TraerCampo("programa_curso_inap","progcur_descripcion",array("progcur_codigo='",$fila_diseno['progcur_codigo'],"'"),$descri,$numfilas,$errorcod)) 
						$fila_comision['progcur_descripcion']=$descri;

					if ($this->conexion->TraerCampo("area_curso_inap","areacur_descripcion",array("areacur_codigo='",$fila_diseno['areacur_codigo'],"'"),$descri,$numfilas,$errorcod)) 
						$fila_comision['areacur_descripcion']=$descri;
				} else {
						$fila_comision['progcur_descripcion']="----";
						$fila_comision['areacur_descripcion']="----";
				}
				
					if ($this->conexion->TraerCampo("tipo_inscripcion","tipoins_descripcion",array("tipoins_codigo='",$fila_comision['tipoins_codigo'],"'"),$descri,$numfilas,$errorcod)) 
						$fila_comision['tipoins_descripcion']=$descri;

				
				
				
				$oActividadCurso = new cActividadCurso($this->conexion);
				if (!$oActividadCurso->TraerDatosActividadCurso($fila_comision['act_codigo'],$fila_actividad_curso,$es_modif_act_curso)) 
					return false;
				$fila_comision['actcur_creditos']=$fila_actividad_curso['actcur_creditos'];

				// echo  "Sacar = Antes de dictamen";

				$oDictamen = new cDictamen($this->conexion);
				if (!$oDictamen->TraerDatosActividadProgramacion($fila_comision["act_codigo"], $fila_comision["actprog_sec"], $fila_progact, $es_modif) ) 
					return false;
				if (!$oDictamen->TraerDatosDictamen($fila_progact["dic_codigo"], $fila_dictamen, $es_modif) ) 
					return false;

				$oDisposicion = new cDisposicion($this->conexion);
				$ArregloDatosDis=array();
				$ArregloDatosDis['dis_codigo']=$fila_dictamen['dis_codigo'];
				if(!$oDisposicion->BuscarDisposicion($ArregloDatosDis,$numfilas,$result_dis,$error,$errormail))
					return false;
				if ($numfilas==1) {
					$fila=mysqli_fetch_assoc($result_dis);
					$fila_comision['dis_numero']=$fila['dis_numero'];
				}	else 
					$fila_comision['dis_numero'] = "----";
				
				$oComisionPrestadorDocente = new cComisionPrestadorDocente($this->conexion);
				$ArregloDatosPres=array("comi_codigo"=>$fila_comision['comi_codigo']);	
				if (!$oComisionPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatosPres,$numfilas,$resultado,$error,$errormail)) 
					return false;

				$fila_comision['pres_doc'] = "";
				while ($fila = mysqli_fetch_assoc($resultado))
					$fila_comision['pres_doc'] .= $fila['campo_mostrar'];


				if(!$this->conexion->TraerCampo("sede","sede_descripcion",array("sede_codigo='",$fila_comision['sede_codigo'],"'"),$sededesc,$numfilas,$errorcod))
					return false;
				$fila_comision['sede_descripcion']=htmlspecialchars($sededesc,ENT_QUOTES);

				
				if (!$this->conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$fila_comision['prov_codigo'],"'"),$descri_prov,$numfilas,$errorcod))
					return false;
				$fila_comision['provincia_descripcion']=htmlspecialchars($descri_prov,ENT_QUOTES);

				$resultados_evaluacion=array();
				if (!($this->ResumenComision($fila_comision['comi_codigo'],$resultados_evaluacion)))
					return false;		
				$fila_comision['cant_vacantes']=$fila_comision['comi_vacantes'];
				$fila_comision['cant_sobreventa']=$fila_comision['comi_sobreventa'];	
				$fila_comision['cant_aprobados']=$resultados_evaluacion[EVALAPROBADO]['cantidad'];
				$fila_comision['cant_cursando']=$resultados_evaluacion[EVALCURSANDO]['cantidad'];
				$fila_comision['cant_presentes']=$resultados_evaluacion[EVALPRESENTE]['cantidad'];
				$fila_comision['cant_ausentes']=$resultados_evaluacion[EVALAUSENTE]['cantidad'];
				$fila_comision['cant_ausentesjustificados']=$resultados_evaluacion[EVALAUSENTEJUSTIFICADO]['cantidad'];
				$fila_comision['cant_libres']=$resultados_evaluacion[EVALLIBRE]['cantidad'];																									
				$fila_comision['cant_desaprobados']=$resultados_evaluacion[EVALDESAPROBADO]['cantidad'];																									
				$fila_comision['cant_totales']=$fila_comision['cant_aprobados'] + $fila_comision['cant_cursando'] + $fila_comision['cant_presentes'] + $fila_comision['cant_ausentes'] + $fila_comision['cant_ausentesjustificados'] + $fila_comision['cant_libres'] + $fila_comision['cant_desaprobados'] ;																									

				$fila_comision['tipoact_descripcion']=$tipoact_descripcion;
				$fila_comision['fecha_desde_hasta'] = isset($fila_comision['comi_fecha_inicio_ddmmaaaa'])?$fila_comision['comi_fecha_inicio_ddmmaaaa']."\na\n".$fila_comision['comi_fecha_fin_ddmmaaaa']:"Indefinida";
				$comsiones_seleccionadas[]=$fila_comision;				
				
			}
			
		} // while $fila_asignacion = mysql_fetch_assoc($resultComision)
		
		// echo  "Sacar 3 (quedaron seleccionadas)= ";
		// print_r($comsiones_seleccionadas)	;

		if (count($comsiones_seleccionadas >0)) {
		
			$nombrearchivo="comision_listado.xls";  
	
			$oExcel= new cEscribirExcel($nombrearchivo);
			$oExcel->AddHoja('comisiones');
			$oExcel->EsconderGrillas();
			$oExcel->PaginaHorizontal();

			$arrayclaves = array ('progcur_descripcion','areacur_descripcion','act_nombre','jurisdnom','dis_numero','comi_codinap','tipoins_descripcion','actcur_creditos',
									'pres_doc','sede_descripcion','provincia_descripcion','comi_domicilio',
									'comi_fecha_inicio_ddmmaaaa','comi_fecha_fin_ddmmaaaa',
									'cant_aprobados','cant_cursando','cant_presentes','cant_ausentes','cant_ausentesjustificados','cant_libres','cant_desaprobados','cant_totales','cant_vacantes','cant_sobreventa');
								

			// Ancho de cada columna, las claves tienen que coincidir con arrayclaves
			$ancho_columna = array ('progcur_descripcion'=>30,'areacur_descripcion'=>30,
									'act_nombre'=>50,'jurisdnom'=>30,'dis_numero'=>15,				
									'comi_codinap'=>15,'tipoins_descripcion'=>7, 'actcur_creditos'=>10,
									'pres_doc'=>50,'sede_descripcion'=>20,
									'provincia_descripcion'=>20,'comi_domicilio'=>40,'comi_fecha_inicio_ddmmaaaa'=>15,
									'comi_fecha_fin_ddmmaaaa'=>15, 'cant_aprobados'=>10,'cant_cursando'=>10,	
									'cant_presentes'=>10,'cant_ausentes'=>10,								
									'cant_ausentesjustificados'=>10,'cant_libres'=>10,  'cant_desaprobados'=>15,'cant_totales'=>10, 'cant_vacantes'=>10,'cant_sobreventa'=>10,);					
								
			$titulos_columna = array ('Programa','Area','Nombre Actividad','Organismo del Coordinador Técnico de Capacitación',
									'Disp. Aprobatoria','Cód. Comisión','Tipo','Créditos',
									'Docentes','Sede','Provincia','Domicilio','Fecha de Inicio.', 'Fecha de Fin.',
									'Cant. Aprobados','Cant. Cursando', 'Cant Presentas','Cant Ausentes','Cant Aus Justificados','Cant Libres','Cant Desaprobados','Cant Inscriptos','Vacantes','Sobreventa');
			
			
			
			
			for ($i=0; $i<count($arrayclaves); $i++) 
				$oExcel->FormatoColumna ($i,$ancho_columna[$arrayclaves[$i]]); 
												


			// Titulos 
			// $oExcel->AddFormato ("Align","left");
			// $oExcel->AddFormato ("Border",1);
			// $oExcel->AddFormato ("Font","Times New Roman");
			// $oExcel->AddFormato ("Tamaño",12);
			// $oExcel->AddFormato ("Color","azul");
			// $oExcel->AddFormato ("FgColor",22);
			// $oExcel->CargarDatosVariasCeldas (0,0,0,count($titulos_columna)-1,'Listado de Comisiones',true);

			// Titulos de las columnas
			$oExcel->AddFormato ("Align","center");
			$oExcel->AddFormato ("TextWrap","");
			$oExcel->AddFormato ("Border",1);
			$oExcel->AddFormato ("Font","Times New Roman");
			$oExcel->AddFormato ("Tamaño",10);
			$oExcel->AddFormato ("VAlign","vcenter");
			
			$oExcel->AddFormato ("Color","negro");
			$oExcel->AddFormato ("FgColor","gris");
						
			//$formato_celda = array("NumFormat"=>"dd/mm/yyyy");
			//$formato_celda = array("NumFormat"=>"D/M/YYYY h:mm:ss");
			$formato_celda = array("NumFormat"=>14, "Align"=>"right");
			$arregloformatos['comi_fecha_inicio_ddmmaaaa']=$formato_celda;
			$arregloformatos['comi_fecha_fin_ddmmaaaa']=$formato_celda;

			for ($i=0; $i<count($titulos_columna); $i++) 
				$oExcel->CargarDatos (0,$i,$titulos_columna[$i],true);
			
			$i=1;
			foreach ($comsiones_seleccionadas as $datos) {
				$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,array());	
				$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,$arregloformatos);	
				
				
				$i++;
			}
			$oExcel->Enviar();			
		}	
	
	}	
//-----------------------------------------------------------------------------------------------------	
	function ResumenEvaluacion ($comi_codigo, $eval_codigo, &$datos_evaluacion) {

		$ok = true;
		$datos_evaluacion = array();
		$cComisionPersona = new cComisionPersona($this->conexion);
		
		// Busco las personas inscriptas
		$spnombre="sel_comision_persona_xcomi_codigo_eval_codigo";	
		$spparam=array(	'pcomi_codigo'=>$comi_codigo,
						'peval_codigo'=>$eval_codigo);

		if(!($this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))) {
			$errormail="\ncomi_codigo=".$comi_codigo."\neval_codigo=".$eval_codigo."\nerror=".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el resumen de la evaluación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$ok = false;
		}
	
		if ($ok) {
			if ($numfilas == 1) 
				$datos_evaluacion = mysqli_fetch_assoc($resultado);
			else 
				$ok =  false;
		}

		return $ok;
	}		
//-----------------------------------------------------------------------------------------
	function _DatosValidosModifComision($datos,&$datosvalidados)	{


		if (!$this->_DatosValidosComunesComision($datos,$datosvalidados))
		   return false; 
		// 	El usuario tiene permiso de modificar la comisión
		if (!$this->TienePermisoModificar($datos['comi_codigo'],$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		$datosvalidados["comi_codigo"]=$datos["comi_codigo"];
		$datosvalidados["comi_codinap"]=$datos["comi_codinap"];

		return true;	
	}
//-----------------------------------------------------------------------------------------
	function _DatosValidosEliminarComision($comi_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		
		// 	El usuario tiene permiso de eliminar la comisión
		if (!$this->TienePermisoModificar($comi_codigo,$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}
		$datosvalidados["comi_codigo"]=$comi_codigo;

		return true;
	}
//-----------------------------------------------------------------------------------------
	function _DatosValidosAltaComision($datos,&$datosvalidados)	{

		$datosvalidados = array();
	
		if (!$this->_DatosValidosComunesComision($datos,$datosvalidados))
		   return false; 

		// La comisión tiene que tener dictamen aprobado
		$ArregloDatos= array();
		$ArregloDatos['act_codigo'] = $datos["act_codigo"];		
		$ArregloDatos['actprog_sec'] = $datos["actprog_sec"];		
		$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
		$ArregloDatos['formact_codigo'] = FORMATOCURSO;

		$oActividad = new cActividadCurso($this->conexion);
		if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;								
		}	
		if($numfilas!=1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La programación de la actividad debe tener el dictamen aprobado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;								
		}
		$fila_act = mysqli_fetch_assoc ($result);

		if ($fila_act['tipoact_codigo'] == TIPOACTCURSOJURISD ) { 
			// debe existir al menos una relación ActPOC / Act aprobada
			$oDictamen = new cDictamen($this->conexion);
			if (!$oDictamen->TraerDatosActividadProgramacion($datos["act_codigo"], $datos["actprog_sec"], $fila_progact, $es_modif) ) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se encontró dictámen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}			
			if ($es_modif)	{
				// obtengo todos los Años de vigencia
				$a_inicio = substr($fila_progact['actprog_fecha_inicio'],0,4);
				$a_fin = substr($fila_progact['actprog_fecha_fin'],0,4);
				$total_relaciones_aprobadas = 0;
				for ($a = $a_inicio; $a<=$a_fin;$a++){
					// por cada año, busco las Act Poc relacionadas APROBADAS
					
					$oPoc = new cPoc($this->conexion);
					$ArregloDatos = array(
										'poc_ano'=>$a,
										'jurisdid_inap'=>$_SESSION['jurisdid_inap'],
										'poc_estado'=>POCAPROBADO
									);
					
					if(!$oPoc->BuscarPoc($ArregloDatos,$numfilas_poc,$resultado_poc,$error,$errormail)) 
					{
						$txt_sys_mail="\npoc_codigo_".$a."\nerror=".$errormail;
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
						return false;			
	
					} else { 
	
						// Si hay POC, busco todas las Act Poc / Act aprobadas				
						if ($numfilas_poc == 1) {
	
							$fila_poc=mysqli_fetch_assoc($resultado_poc);
						
							$oPocActividadActividad = new cPocActividadActividad($this->conexion);				
						
							$filtro = array( 
											'poc_codigo'=>$fila_poc['poc_codigo'],
											'act_codigo'=>$datos['act_codigo'],							
											'pocactact_estado'=>POCACTIVIDADACTIVIDADAPROBADA						
											);
							if (!$oPocActividadActividad->BuscarPocActividadActividad($filtro,$numfilas_act_asignadas,$result_act_asignadas,$error,$errormail)) {
								FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
								return false;
							}
							$total_relaciones_aprobadas += $numfilas_act_asignadas;
						}
											
					}
			
				} // for $a = $a_inicio; $a<=$a_fin;$a++
		
				if ($total_relaciones_aprobadas == 0) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La actividad no tiene relaciones Aprobadas con Actividades del POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;		
				}
			} // $es_modif
		} 

		return true;
	}
//-----------------------------------------------------------------------------------------
	function _DatosValidosComunesComision($datos,&$datosvalidados)	{
		
		// La actividad programacion tiene que tener el dictamen aprobado.
		switch ($_SESSION['rolcod']) {
		case SUPERUSUARIO:
			$oActividadCurso = new cActividadCursoInap($this->conexion); 
			$formact_codigo=FORMATOCURSO;
			$tipoact_codigo=TIPOACTCURSOINAP;
			break;
		case USUCURSOINAP:
			$oActividadCurso = new cActividadCursoInap($this->conexion); 
			$formact_codigo=FORMATOCURSO;
			$tipoact_codigo=TIPOACTCURSOINAP;
			break;
		case USUORGANISMO:
		case COORDINADORTECNICO:
			$oActividadCurso = new cActividadCursoJurisdiccional($this->conexion); 
			$formact_codigo=FORMATOCURSO;
			$tipoact_codigo=TIPOACTCURSOJURISD;
			break;
		}		
	
		$ArregloDatos=array();
		$datosvalidados=array();
		if (!isset($datos['comi_web']))
			$datos['comi_web'] = "";
		$datosvalidados['comi_web']=$datos['comi_web'];
		$ArregloDatos['act_codigo']=$datos['act_codigo'];
		$ArregloDatos['actprog_sec']=$datos['actprog_sec'];
		$ArregloDatos['formact_codigo']=$formact_codigo;
		$ArregloDatos['tipoact_codigo']=$tipoact_codigo;
		$ArregloDatos['dic_estado']=DICTAMENACTIVO;
		if(!$oActividadCurso->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;			
		}	
		if ($numfilas!=1) 	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en el estado del dictamen de la actividad asociada a la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados['act_codigo']=$datos['act_codigo'];		
		$datosvalidados['actprog_sec']=$datos['actprog_sec'];		

		$spnombre="sel_tipo_inscripcion_xtipoins_codigo";	
		$spparam=array("ptipoins_codigo"=>$datos["tipoins_codigo"]);	
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("tipoins_codigo"=>$datos["tipoins_codigo"]),$query,$filaret,$numfilasmatcheo,$errorcod) || $numfilasmatcheo!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del tipo de inscripción.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}		
		$datosvalidados["tipoins_codigo"]=$datos["tipoins_codigo"];

		if($datos['comi_vacantes']=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$_POST['comi_vacantes'],"NumericoEntero") || $datos['comi_vacantes']<=0) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la cantidad de vacantes, debe ser un número entero mayor a cero.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		$datosvalidados["comi_vacantes"]=$datos["comi_vacantes"];
		
		if ($datos['comi_sobreventa']!="" ) {
	
			if(!FuncionesPHPLocal::ValidarContenido($this->conexion,$_POST['comi_sobreventa'],"NumericoEntero") || $datos['comi_sobreventa']<0) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la sobreventa, debe ser un número entero mayor o igual a cero.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}	
			$datosvalidados["comi_sobreventa"]=$datos["comi_sobreventa"];
		} else {
			$datosvalidados["comi_sobreventa"]=0;		
		}
				
		$spnombre = "sel_paises_xestado";
		$spparam = array("ppaisestado"=>ESTADOACTIVO, "porderby"=>"paisnom");
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("paiscod"=>$datos['pais_codigo']),$resultado,$filapais,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el pais.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["pais_codigo"]=$datos['pais_codigo'];

		if ($datos['pais_codigo'] == ARGENTINA) {
			$oprovincia = new cProvincias($this->conexion);
			$oprovincia->ProvinciasSP($spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("provinciacod"=>$datos['prov_codigo']),$resultado,$filaprov,$numfilas,$errno) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la provincia. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["prov_codigo"]=$datos['prov_codigo'];
		} else 
			$datosvalidados["prov_codigo"]="NULL";

		$oSede = new cTablaSede($this->conexion);		
		$oSede->TablaDescriptoresSP($spnombre,$spparam);
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("sede_codigo"=>$datos["sede_codigo"]),$query,$filaret,$numfilas,$errorcod) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la sede.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["sede_codigo"]=$datos['sede_codigo'];

		if (strlen(trim($datos['comi_domicilio'])) >150 ) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error el domicilio no puede superar los 150 caracteres",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["comi_domicilio"]=$datos['comi_domicilio'];
		$datosvalidados["comi_detalle"]=$datos['comi_detalle'];
		$datosvalidados["comi_codinap"]= $datos["comi_codinap"];

		return true;
	}	
//-----------------------------------------------------------------------------------------
	function _DatosValidosAbrirComision($datos,&$datosvalidados) {

		// 	El usuario tiene permiso de modificar la comisión y tiene que estar nueva
		if (!$this->TienePermisoModificar($datos['comi_codigo'],$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}			

		// Busco los datos de la comision.
		$ArregloDatos=array("comi_codigo"=>$datos['comi_codigo'],"comi_estado"=>COMISIONNUEVA);	
		if(!$this->BuscarComision($ArregloDatos,$numfilas,$resulcomi,$error,$errormail)) {
			$txt_sys_mail="Error al buscar para la comisión NUEVA - \ncomi_codigo=".$datos['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} elseif ($numfilas!=1) {
			$txt_sys_mail="Hay cero o más de un registros para la comisión (si fue seleccionada debería poder abrirse)\ncomi_codigo=".$datos['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la comisión no permite su apertura.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		} 

		$fila_comision=mysqli_fetch_assoc($resulcomi);
		if (!isset($fila_comision['comi_fecha_inicio']) || !isset($fila_comision['comi_fecha_fin'])) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión debe tener definida la fecha de realización.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false; 
		}
		
		// La comisión tiene definido el cronograma.
		$ArregloDatos=array("comi_codigo"=>$datos['comi_codigo']);	
		$oComisionCronograma = new cComisionCronograma($this->conexion);

		if (!$oComisionCronograma->BuscarComiCronograma($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\ncomi_codigo=".$comi_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando datos del cronograma.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		} elseif ($numfilas==0) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión debe tener definida la fecha de realización.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false; 
		}
		
		// La comisión tiene asignado por lo menos un docente. 
		$ArregloDatos=array("comi_codigo"=>$datos['comi_codigo']);	
		$oComisionPrestadorDocente = new cComisionPrestadorDocente($this->conexion);

		if (!$oComisionPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
 			$txt_sys_mail="Error al buscar docentes - \ncomi_codigo=".$datos['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al verificar la cantidad de docentes de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false; 
		} elseif ($numfilas==0) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión debe tener por lo menos un docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false; 
		}
				
		$datosvalidados = array();
		$datosvalidados['comi_codigo']=$datos['comi_codigo'];
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosCerrarComision($datos,&$datosvalidados,&$hay_otros_errores) {

		// 	El usuario tiene permiso de cerrar la comisión y la comision tiene que estar abierta
		if (!$this->TienePermisoCerrar($datos['comi_codigo'],$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) {
			return false; 
		}			

		$hay_otros_errores = false;
		// La comisión tiene todos sus alumnos con evaluación
		/*
		$ArregloDatos= array();
		$ArregloDatos['comi_codigo'] = $datos['comi_codigo'];
		$ArregloDatos['eval_codigo'] = EVALCURSANDO;		// Unico estado no final es cursando 

		$oComisionPersona = new cComisionPersona($this->conexion);
