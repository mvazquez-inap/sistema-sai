		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('pact_codinap'=>"");
		$sparam+=array('ptipoact_codigo'=>"-1");
		$sparam+=array('pjurisdid_inap'=>"-1");
		$sparam+=array('pactcur_estado'=>"-1");
		$sparam+=array('pexp_numero'=>"");
		$sparam+=array('pdis_numero'=>"");
		$sparam+=array('pdic_estado'=>"-1");
		$sparam+=array('pdic_codigo'=>"-1");
		$sparam+=array('pdis_codigo'=>"-1");
		$sparam+=array('pactprog_sec'=>"");
		$sparam+=array('pactprog_fecha_inicio'=>"");
		$sparam+=array('pactprog_fecha_fin'=>"");
		$sparam+=array('pprogcur_codigo'=>"");
		$sparam+=array('pareacur_codigo'=>"");
		$sparam+=array('pactdisinap_beca'=>"");
		//$sparam+=array('pdic_esta_visado'=>"");
		
		$sparam+=array('porderby'=>"act_nombre");

