		</td>
		<td align="center">
			<select name="<?php echo $nombrelista.'der' ?>[]" size="<?php echo $filas ?>" style="<?php echo $style ?>" multiple></select><br>
	<?php		if($subebaja)	{ ?>			
				<input type="button" name="<?php echo $nombrelista."botonsubir" ?>" value="Subir" class="boton" onClick="MoverItemLista(formulario['<?php echo $nombrelista."der" ?>[]'],'subir')">&nbsp;&nbsp;
				<input type="button" name="<?php echo $nombrelista."botonbajar" ?>" value="Bajar" class="boton" onClick="MoverItemLista(formulario['<?php echo $nombrelista."der" ?>[]'],'bajar')">
	<?php		} ?>			
		</td>
	</tr>
</table>
<?php
	return true;
}
//----------------------------------------------------------------------------------------- 
// Combo de jurisdcciones, se arma el combo a partir de las jurisdicciones que genera 
// un store procedure (local) que genera códigos de jurisdicción (procedente de tablas 
// locales con jurisdid, o jurisdsafid).
// Se le envia tambien el nombre del campo que contiene el código de jurisdicción. El combo es con salto. 
function ArmarComboJurisdicciones($objJurisdicciones,$query_jurisd,$nomcampo,
								  $nomlista,$clavecombo,$querystring,$textolineauno,
								  &$regactual,&$varlogica,$formulario='formulario',$style="width: 370px") {

	$array_combo_jurisd=array();
	$array_asoc_combo_jurisd=array();
	
	armo_array_jurisd_query($objJurisdicciones,$query_jurisd,$nomcampo,$array_combo_jurisd,$array_asoc_combo_jurisd);  

	// Ordenar el combo por jurisdicción, por descripcion (nombre de la jurisdicción).
	$array_combo_jurisd=Array_column_sort($array_combo_jurisd,"descri_combo");
	$array_asoc_combo_jurisd=Array_column_sort($array_asoc_combo_jurisd,"descri_combo");
	
	ArmarCombo_deArray($array_combo_jurisd,$array_asoc_combo_jurisd,$nomlista,$clavecombo,$querystring,$textolineauno,$regactual,$varlogica,1,$formulario,$style);

	if (isset($_GET[$clavecombo]))
		echo "<br><a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?tipo=1&jurisdid='+".$formulario.".".$clavecombo."[".$formulario.".".$clavecombo.".selectedIndex].value,'ventanatexto',530,180,screen.availWidth-550,screen.availHeight-230,'yes')\" class='linkAclaraciones'>Ver dependencia jerárquica</a>";
	else	
		echo "<div style='font-size: 7px;'>&nbsp;</div>";
}
//----------------------------------------------------------------------------------------- 
// Combo de jurisdcciones, se arma el combo a partir de las jurisdicciones que genera 
// un store procedure (local) que genera códigos de jurisdicción (procedente de tablas 
// locales con jurisdid, o jurisdsafid).
// Se le envia tambien el nombre del campo que contiene el código de jurisdicción. El combo es con salto. 
function ArmarComboJurisdicciones_SinSalto(	$objJurisdicciones,$query_jurisd,$nomcampo,
										    $nomlista,$textolineauno,&$regactual,&$varlogica,
											$formulario='formulario',$style="width: 370px") {

	Armo_array_jurisd_query($objJurisdicciones,$query_jurisd,$nomcampo,$array_combo_jurisd,$array_asoc_combo_jurisd);  

	// Ordenar el combo por jurisdicción, por descripcion (nombre de la jurisdicción).
	$array_combo_jurisd=Array_column_sort($array_combo_jurisd,"descri_combo");
	$array_asoc_combo_jurisd=Array_column_sort($array_asoc_combo_jurisd,"descri_combo");

	ArmarCombo_sinSalto_deArray($array_combo_jurisd,$array_asoc_combo_jurisd,$nomlista,$textolineauno,"",$regactual,$varlogica,1,$formulario,$style);
	echo "<br><a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?tipo=1&jurisdid='+".$formulario.".".$clavecombo."[".$formulario.".".$clavecombo.".selectedIndex].value,'ventanatexto',530,180,screen.availWidth-550,screen.availHeight-230,'yes')\" class='linkAclaraciones'>Ver dependencia jerárquica</a>";
}
//----------------------------------------------------------------------------------------- 
// Entrada: $objJurisdicciones: Objeto jurisdicciones.
//			$queryjurisd:		Query que contiene un campo que será el que se 
//								busque en jurisdicciones.
//			$nomcampo:			Nombre del campo del query que contiene el codigo de
//								jurisdiccion.
//			
// Salida:  Retorno: 					true: 	No hubo ningun error.
//										false:	Hubo error.
//			$array_combo_jurisd:		clave, descripcion. 
//			&$array_asoc_combo_jurisd:	datos asociados.
	
// Proceso: Arma arreglos, con el formato necesario para el ArmarCombo_deArray o ArmarCombo_SinSalto_deArray
//				$array_combo_jurisd['clave_combo'=>jurisdid,
//								    'descri_combo'=>jurisdnom (indentado en la cantidad de niveles)
//								   ]	
//				$array_asoc_combo_jurisd: Un arreglo de con toda la información del registro de jurisdicciones
//			Ambos arreglos incluyen las TODAS jurisdicciones ACTIVAS que se fueron enviadas en el query. 	
function Armo_array_jurisd_query($objJurisdicciones,$queryjurisd,$nomcampo,&$array_combo_jurisd,&$array_asoc_combo_jurisd) {

	if (mysqli_num_rows($queryjurisd)==0) 
		return false;

	// Como me voy a mover en el cursor, me posiciono en la primera fial y lo dejo en la primera fila
	mysqli_data_seek($queryjurisd,0);
	
	$array_combo_jurisd=array();
	$array_asoc_combo_jurisd=array();

	$array_jurisd=array();
	$i=0;	
	while ($fila_query_jurisd=mysqli_fetch_assoc($queryjurisd)) {
		$array_jurisd[$i]=$fila_query_jurisd[$nomcampo];
		$i++;	
	}

	if (!$objJurisdicciones->SelectJurisdxID($array_jurisd,array('pjurisdestado'=>TABGRALES_JURISDACTIVA),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError)) 
		return false;
	elseif ($NumFilas!=count($array_jurisd)) {
			MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Error alguno de los organismos solicitado no fue encontrado en la tabla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);					
			return false;
		} else { 
			$i=0;
			for ($i=0;$i<count($array_jurisd);$i++) {
				$array_combo_jurisd[$i]['clave_combo']=$fila_jurisd[$array_jurisd[$i]]['jurisdid'];
				// version con codigo de jurisdiccion: $array_combo_jurisd[$i]['descri_combo']=$array_combo_jurisd[$i]['clave_combo']." - ".$fila_jurisd[$array_jurisd[$i]]['jurisdnom'];
				$array_combo_jurisd[$i]['descri_combo']=$fila_jurisd[$array_jurisd[$i]]['jurisdnom'];
				$array_asoc_combo_jurisd[$i]=$fila_jurisd[$array_jurisd[$i]];
			}
	}

	mysqli_data_seek($queryjurisd,0);
	return true;
}
//--------------------------------------------------------------------------
// Entrada: $objJurisdicciones: Objeto jurisdicciones.
//			$jurisdid:	Jurisdiccion de la cual quiero las activas dependientes.		
 
// Salida:  Retorno: 					true: 	No hubo ningun error.
//										false:	Hubo error.
//			$array_combo_jurisd:		clave, descripcion. 
//			&$array_asoc_combo_jurisd:	datos asociados.
	
// Proceso: Arma arreglos, con el formato necesario para el ArmarCombo_deArray o ArmarCombo_SinSalto_deArray
//				$array_combo_jurisd['clave_combo'=>jurisdid,
//								    'descri_combo'=>jurisdnom (indentado en la cantidad de niveles)
//								   ]	
//				$array_asoc_combo_jurisd: Un arreglo de con toda la información del registro de jurisdicciones

//			Ambos arreglos incluyen las TODAS jurisdicciones ACTIVAS dependientes de $jurisdid (sin incluirla). 	
//			a cualquier nivel.
function Armo_array_jurisd_dependientes($objJurisdicciones,$jurisdid,&$array_combo_jurisd,&$array_asoc_combo_jurisd) {

	if (!($objJurisdicciones->SubArbolDependiente($jurisdid,JURISD_TODOSLOSNIVELES,array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'porderby'=>'jurisdarbolorden'),TABGRALES_TS_ARRAY,$subArbolDep,array(),$NumFilas,$CodError) )) 
		return false;
		
	if ($NumFilas=0)
		return false;

	// Saco la raiz que viene en el subarbol. 
	unset($subArbolDep[$jurisdid]);
	$i=0;
	$array_combo_jurisd=array();
	$array_asoc_combo_jurisd=array();
	
	foreach ($subArbolDep as $clave => $valor) {
		$array_combo_jurisd[$i]['clave_combo']=$subArbolDep[$clave]['jurisdid'];
		// version con codigo de jurisdiccion: 
		// $array_combo_jurisd[$i]['descri_combo']=str_repeat("--",$subArbolDep[$clave]['jurisdarbolnivel']-1).$array_combo_jurisd[$i]['clave_combo']." - ".$subArbolDep[$clave]['jurisdnom'];
		$array_combo_jurisd[$i]['descri_combo']=str_repeat("--",$subArbolDep[$clave]['jurisdarbolnivel']-1)." ".$subArbolDep[$clave]['jurisdnom'];
		$array_asoc_combo_jurisd[$i]=$subArbolDep[$clave];
		$i++;
	}
	return true;
}

//----------------------------------------------------------------------------------------- 
function ValidarContenido($campo,$tipovalidacion) {
 switch($tipovalidacion)  {
	case "AlfanumericoPuro": // campo alfanumerico sin caracteres especiales
		if ( strspn(strtoupper($campo), '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ' ) != strlen($campo) ) 
			return false;
 		break;
	case "AlfabeticoPuro": // campo alfabetico sin caracteres especiales
		// El upper de ñáéíóúü es ñáéíóúü		
		if ( strspn(strtoupper($campo), ' \'ABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÜÑñáéíóúü' ) != strlen($campo) ) 
			return false;
 		break;
	case "Email": // campo alfanumerico con algunos caracteres especiales (emails)
		if(!preg_match("#^[\._a-z0-9]+@([a-z0-9]+[\.]{1}){1,2}[a-z]{2,4}([\.]{1}[a-z]{2}){0,1}$#i",$campo))
			return false;
 		break;
	case "Web": // campo alfanumerico con algunos caracteres especiales (Web)
		if(!preg_match("#^(http|https)://(www\.)?.+\.(.*)#i",$campo))
			return false;
 		break;
	case "FechaDDMMAAAA": // valida fecha en formato DD/MM/AAAA
		if(!preg_match("#^[0-9]{2}/[0-9]{2}/[0-9]{4}$#i",$campo))
			return false;	
		list($dia, $mes, $anio) = preg_split ('#/#', $campo); 
		if(!checkdate($mes, $dia, $anio))
			return false;
		break;
	case "Periodo": // campo MM/AAAA
	
		if(!preg_match("#^[0-9]{2}/[0-9]{4}$#i",$campo))
			return false;
			
		$anio = substr($campo,3,4);
		$mes = substr($campo,0,2);
		if(($anio < 2000) || ($anio > 2050) || ($mes < 1) || ($mes > 12))
		   return false;
			
		break;	
	case "Hexa6Digitos": // color semáforo
		if(!preg_match("#^[0-9A-F]{6}$#i",$campo))
			return false;
		break;
	case "Jurisdiccion": // campo numerico con puntos (sólo para Jurisdicciones)
		if(!preg_match("#^[0-9]{2}\.([0-9]{3}\.([0-9a-zA-Z ]{2}\.){0,7}){0,1}$#i",$campo))
			return false;
 		break;
	case "NumericoEntero": // campo numerico entero
		if ( strspn($campo, '0123456789' ) != strlen($campo) ) 
			return false;
		break;
	case "Numerico2Decimales": // campo numerico con 2 decimales maximo
		if(!preg_match("#^[0-9]+(,[0-9]{1,2}){0,1}$#i",$campo))
			return false;
 		break;	
	case "Cuit":	
		if(!ValidaCuit($campo))
			return false;
 		break;	
 	default:
		MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Validación no definida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);
 		return false;
 		break;
 }
 return true;
}
//----------------------------------------------------------------------------------------- 
// OJO MARA: 	Cambiar ValidaCuit por la implementacion que tiene 
// 						 ValidaCuit2
function ValidaCuit($cuit) {
	return true;
}
//----------------------------------------------------------------------------------------- 
function ValidaCuit2($cuit){

// Verifico que todos sean números y que la longitud sea 11
if(!preg_match("#^[0-9]{11}$#i",$cuit))
	return false;
					
$array_factor_peso = array (5, 4, 3, 2, 7, 6, 5, 4, 3, 2);
$suma=0;

for ($i=0; $i<=9; $i++)  
	$suma = $suma +substr($cuit,$i,1)*$array_factor_peso[$i]; 	

$resto=$suma%11;
$digito_verificador = 11-$resto;

if ($digito_verificador == 11)
	$digito_verificador = 0;

// Comparo el digito verificador obtenido con el ingresado (ultimo del cuit)	
if ($digito_verificador==substr($cuit,10,1))
   return true;
else
   return false;
}
//----------------------------------------------------------------------------------------- 
function MandarMail($idconexion,$rolcod,$jurisdid,$subject,$texto) {


	switch($rolcod) {
		case ADMI_SISTEMA:
			$spparam=array('pusuario_rol'=>ADMI_SISTEMA,'pactivo'=>USUARIO_ACT);		
			$spnombre="sel_mail_usuario_con_mail_xrol_menorestado";
			break;

		default:
			MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Intento de enviar mail a rol inexistente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);
			return false;
	}
	
	if(!isset($spnombre)) {
		MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Error al generar el mail.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);
		return false;
	}
	$query=ejecutarStoredProcedure($idconexion,$spnombre,$spparam);
	
	while($fila=mysqli_fetch_assoc($query))	{ 
		if(!mail($fila['email'],$subject,$texto)) {
			MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Imposible enviar mail.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);
			return false;
		}
	}	
	return true;	
}
//----------------------------------------------------------------------------------------- 
function ConvertirPeriodo($periodo,$formatoinput,$formatooutput) {
	if($periodo=='') return "";
	
	if($formatoinput=='mm/aaaa' && $formatooutput=='aaaamm')
		return substr($periodo,3,4).substr($periodo,0,2);
	elseif($formatoinput=='aaaamm' && $formatooutput=='mm/aaaa')
		return substr($periodo,4,2)."/".substr($periodo,0,4);
}
//----------------------------------------------------------------------------------------- 
function ConvertirFecha($fecha,$formatoinput,$formatooutput)
{
	if($fecha=='') return "";
	
	if($formatoinput=='dd/mm/aaaa' && $formatooutput=='aaaa/mm/dd')
		return substr($fecha,6,4)."/".substr($fecha,3,2)."/".substr($fecha,0,2);
	elseif($formatoinput=='aaaa-mm-dd' && $formatooutput=='dd/mm/aaaa')
		return substr($fecha,8,2)."/".substr($fecha,5,2)."/".substr($fecha,0,4);
	elseif($formatoinput=='timestamp' && $formatooutput=='dd/mm/aaaa')
		return substr($fecha,6,2)."/".substr($fecha,4,2)."/".substr($fecha,0,4);
}
//----------------------------------------------------------------------------------------- 
function ObtenerHsMin($fecha) {
	return substr($fecha,10,6);
}	
//----------------------------------------------------------------------------------------- 
function ObtenerBrowser(&$info) {

	$browser = array (
	   "MSIE",            // parent
	   "OPERA",
	   "MOZILLA",        // parent
	   "NETSCAPE",
	   "FIREFOX",
	   "SAFARI"
	);
	
	$info[browser] = "OTHER";
	foreach ($browser as $parent) {
	   $s = strpos(strtoupper($_SERVER['HTTP_USER_AGENT']), $parent);
	   $f = $s + strlen($parent);
	   $version = substr($_SERVER['HTTP_USER_AGENT'], $f, 5);
	   $version = preg_replace('/[^0-9,.]/','',$version);
	   
	   if (strpos(strtoupper($_SERVER['HTTP_USER_AGENT']), $parent)) {
	   $info[browser] = $parent;
	   $info[version] = $version;
	   }
	}
}

//----------------------------------------------------------------------------------------- 
function MostrarMensaje_viejo($idconexion,$nivelmensaje,$texto,$ubicerror,$formatomensaje,$cantcols=1) {

	if ($nivelmensaje==MSG_ERRGRAVE) {
	    $texto="<div class='textoMensajeError'>".$texto;
		$texto.=" <BR> Avise al Administrador del Sistema.";
		$texto=$texto."</div>";
	}

	switch($nivelmensaje) {
		case MSG_OK:
		case MSG_INF:
		case MSG_ERRGRAVE:
		case MSG_ERRSOSP:
			if($formatomensaje==FMT_TEXTO)
				echo "<p align='center' class='textoMensaje'>".$texto."</p> ";	
			elseif($formatomensaje==FMT_TABLA)	{ ?>
				<tr class="textoMensaje">
					<td colspan="<?php echo $cantcols ?>" height="100" align="center" valign="middle">
						<?php echo $texto ?>
					</td>
				</tr>	
		<?php }
			else
				echo $texto;	
			break;
	}

	// Envio de mail según el nivel de gravedad del mismo
	switch($nivelmensaje) 	{
		case MSG_ERRGRAVE:
			$subject="( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." ) - Error de Inconsistencia de Datos.";
			$textomail="Se produjo un error:\n";
			$textomail.="  Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";
			$textomail.="  Ubic Archivo: ".$ubicerror['archivo']."\n";
			$textomail.="  Ubic Función: ".($ubicerror['funcion']==""?"-":$ubicerror['funcion'])."\n";
			$textomail.="  Ubic Línea: ".$ubicerror['linea']."\n";
			$textomail.="Texto error:".$texto."\n";
			$textomail.="Usuario sesion: ".$_SESSION['pers_cuilt']."\n";
			MandarMail($idconexion,ADMI_SISTEMA,"",$subject,$textomail); 
			break;
		case MSG_ERRSOSP:
			$subject="( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." ) - Error Datos Sospechosos.";
			$textomail="Se produjo un error:\n";
			$textomail.="  Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";
			$textomail.="  Ubic Archivo: ".$ubicerror['archivo']."\n";
			$textomail.="  Ubic Función: ".($ubicerror['funcion']==""?"-":$ubicerror['funcion'])."\n";
			$textomail.="  Ubic Línea: ".$ubicerror['linea']."\n";
			$textomail.="Texto error:".$texto."\n";
			$textomail.="Usuario sesion: ".$_SESSION['pers_cuilt']."\n";
			MandarMail($idconexion,ADMI_SISTEMA,"",$subject,$textomail);
			break;
	}
}

