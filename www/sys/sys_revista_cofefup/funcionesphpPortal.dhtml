//----------------------------------------------------------------------------------------- 
/**
* array_column_sort 
* 
* function to sort an "arrow of rows" by its columns
* exracts the columns to be sorted and then
* uses eval to flexibly apply the standard
* array_multisort function
*
* uses a temporary copy of the array whith "_" prefixed to  the keys
* this makes sure that array_multisort is working with an associative
* array with string type keys, which in turn ensures that the keys 
* will be preserved.
*
* TODO: find a way of modifying the keys of $array directly, without using
* a copy of the array. 
* 
* flexible syntax:
* $new_array = array_column_sort($array [, 'col1' [, SORT_FLAG [, SORT_FLAG]]]...);
* 
* original code credited to Ichier (www.ichier.de) here:
* http://uk.dhtml.net/manual/en/function.array-multisort.dhtml
*
* prefixing array indeces with "_" idea credit to steve at mg-rover dot org, also here:
* http://uk.dhtml.net/manual/en/function.array-multisort.dhtml
* 
*/

	function array_column_sort() 
	{ 
		$args = func_get_args();
		$array = array_shift($args);
		$sort_array=array();
		
		if(count($array)==0)
			return $array;
		
		// make a temporary copy of array for which will fix the 
		// keys to be strings, so that array_multisort() doesn't
		// destroy them
		$array_mod = array();
		foreach ($array as $key => $value)
			$array_mod['_' . $key] = $value;
		
		$i = 0;
		$multi_sort_line = "return array_multisort( ";
		foreach ($args as $arg) 
		{
			$i++;
			if ( is_string($arg) ) 
			{
				foreach ($array_mod as $row_key => $row) 
				{
					$sort_array[$i][$row_key] = $row[$arg];
				}
			} 
			else 
			{
				$sort_array[$i] = $arg;
			}
			$multi_sort_line .= "\$sort_array[" . $i . "], ";
		}
		$multi_sort_line .= "SORT_ASC,\$array_mod );";
	
		eval($multi_sort_line);
	
		// now copy $array_mod back into $array, stripping off the "_"
		// that we added earlier.
		$array = array();
		foreach ($array_mod as $key => $value)
			$array[ substr($key, 1) ] = $value;
	
		return $array;
	}

//----------------------------------------------------------------------------------------- 
// Separa el codigo post de una imagen para obtener el codigo
	
	function DesglosarBt ($cadenapost,$cadenainicio,&$codigo)
	{
		$codigo=strstr ($cadenapost, $cadenainicio );  // string empezando por Borrar
 		$pos1=0;
		$pos2=0;
		$pos3=0;		
		$pos1 = strpos($codigo, '_'); 
		if (!$pos1===false)
			$possig1 = strpos(substr($codigo,$pos1+1), '_');
		if (!$possig1===false) 
		{
			$pos2= $pos1+$possig1+1;
		}
		
		if ($pos1>0 && $pos2>0) 
		{
			$codigolength=$pos2-$pos1-1;
			$codigo=substr($codigo,$pos1+1,$codigolength);
		}
	}

//----------------------------------------------------------------------------------------- 
// Hace la inversa a htmlspecialchars

	function htmldecode($encoded) 
	{
		return strtr($encoded,array_flip(get_html_translation_table(HTML_ENTITIES)));
	}
	
	function ConvertirStringParaURL($texto)
	{
		return str_replace(array(" ","ó","ñ"),array("%20","%F3","%F1"),htmlspecialchars($texto,ENT_QUOTES));
	}

	function strepos($haystack, $needle, $offset=0) 
	{ 
		$pos_rule = ($offset<0)?strlen($haystack)+($offset-1):$offset;
		$last_pos = false; $first_run = true;
		do {
		$pos=strpos($haystack, $needle, (intval($last_pos)+(($first_run)?0:strlen($needle))));
		if ($pos!==false && (($offset<0 && $pos <= $pos_rule)||$offset >= 0)) {
		$last_pos = $pos;
		} else { break; }
		$first_run = false;
		} while ($pos !== false);
		if ($offset>0 && $last_pos<$pos_rule) { $last_pos = false; }
		return $last_pos;
	}


	function ConvertiraUtf8($arreglo)
	{
		$arregloenviar=array();
		foreach($arreglo as $clave=>$valor)
			$arregloenviar[$clave]=utf8_decode($valor);
		return $arregloenviar;
	}


	function EncriptarMail($fake) {
		$lalph='abcdefghijklmnopqrstuvwxyz';
		$calph='ABCDEFGHIJKLMNOPQRSTUVWXYZ';
		$e='';
		$code=0; 
		$i=0;
		$flag=0;
		for ($i=0; $i<strlen($fake); $i++)
		{
			$flag=0;
			$code=-1;
			
			$posicionl = strpos($lalph,$fake[$i]);
			$posicionc = strpos($calph,$fake[$i]);
			if ($posicionl !== false)	
			{
				$flag=1;
				$code = $posicionl + 97;
			}elseif ($posicionc !== false)
			{
				$flag=1;
				$code = $posicionc + 68;
			}elseif($fake[$i]=='@')
			{
				$flag=1;
				$code=64;
			}elseif($fake[$i]=='-')
			{
				$flag=1;
				$code=45;
			}elseif($fake[$i]=='.')
			{
				$flag=1;
				$code=46;
			}elseif($fake[$i]=='_')
			{
				$flag=1;
				$code=95;
			}
			if($flag==1)
			{
				$e.='&#'.$code.';';
			}
			else{
				$e.=$fake[$i];
			}
		}
	
		return $e;
	}



	function ValoresPosiblesTablaPropia($arreglodatosentrada,$conexion,&$arreglovalores)
	{
		$arreglovalores = array();
		$spnombre="sel_tablas_propias_campos_descriptores_xtabcamponom";
		$spparam=array(
			'ptabcamponom'=> $arreglodatosentrada['tabcamponom'],
			'ptabcod'=> $arreglodatosentrada['tabla']
		);		
			
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		{	
			FuncionesPHPPortal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar campos descriptores por nombre del campo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} 	
		
		$i = 0;
		while ($fila = mysqli_fetch_assoc($resultado)) 
		{	
			$arreglovalores[$fila['tabcampocat']]['codigo'] = $fila['tabcampocat'];
			$arreglovalores[$fila['tabcampocat']]['descripcion'] = $fila['tabcampocatdesc'];
			$i++;
		}		
		
		return true;
	}	
	
	// Modificado xxx respecto produccion
	function ObtenerTextoFecha($fecha)
	{
		$arrayfecha = explode('-', $fecha);
		$fechaint = mktime(0,0,0, $arrayfecha[1], $arrayfecha[2], $arrayfecha[0]);
		$fechasalida = strftime("%e de %B de %Y." ,$fechaint);
		return ReemplazarTextoFechas($fechasalida);
	}

} // Fin clase FuncionesPHPPortal

//----------------------------------------------------------------------------------------- 
//----------------------------------------------------------------------------------------- 
// Clase que parsea el código HTML y separa los comandos

class cSepararHTML
{
//----------------------------------------------------------------------------------------- 
// Separa $parte en los componentes, retornando un en $componentes un array asociativo
	
	function ProcesarParametros($parte,&$componentes,$posicion=0)
	{

		if($posicion==0)
		{
			$componentes=array();
			if(!preg_match("#^([A-Z0-9]+='[^']+')( [A-Z0-9]+='[^']+')*$#i",$parte))
				return false;
		}

		$componentelocal=array();
		if(!preg_match("#^([A-Z0-9]+='[^']+')#i",$parte,$componentelocal))
			return false;
		else
		{
			$posigual=strpos($componentelocal[0],"=");
			$componentes[substr($componentelocal[0],0,$posigual)]=substr($componentelocal[0],$posigual+2,strlen(substr($componentelocal[0],$posigual+2))-1);
			$parte=substr($parte,strlen($componentelocal[0])+1);
			if(strlen($parte)>0)
				return cSepararHTML::ProcesarParametros($parte,$componentes,++$posicion);
		}
		
		return true;
	}
	
//----------------------------------------------------------------------------------------- 
// Verifica si lo que llega en $parte es un comando.
// Si es asi, lo procesa, sino retorna false
	
	function ProcesarComando($parte,&$componentes)
	{
		if(substr($parte,0,5)=="Tipo=")
		{
			if(!preg_match("#^([A-Z0-9]+='[^']+')( [A-Z0-9]+='[^']+')*$#i",$parte))
				return false;
		}
		else
			return false;
	
		return cSepararHTML::ProcesarParametros($parte,$componentes);
	}
	
//----------------------------------------------------------------------------------------- 
// Separa el codigo html en un array.
// Cada posición en partes puede ser:
//      codigo HTML puro, para enviar directamente
//      un array, indicando que es un comando que hay que interpretar
	
	function ProcesarHTML($html,&$partes)
	{
		$partes=explode("$$",$html);
		
		for($i=0;$i<count($partes);$i++)
		{
			$componentes=array();
			if(cSepararHTML::ProcesarComando($partes[$i],$componentes))
				$partes[$i]=$componentes;
		}
		
		return true;
	}
	
	
	//----------------------------------------------------------------------------------------- 
// Separa el codigo html en un array.
// Cada posición en partes puede ser:
//      codigo HTML puro, para enviar directamente
//      un array, indicando que es un comando que hay que interpretar
	
	function PreProcesarHTML($datos,$html,&$htmlsalida)
	{
		$partes=explode("$#$",$html);
		
		
		for($i=0;$i<count($partes);$i++)
		{
			
			if(substr(trim($partes[$i]),0,2)=="IF")
			{
				if(cSepararHTML::ObtenerCondicional($partes[$i],$condicional))
				{
					$condicion = 1;
					$condicional = str_replace("##","'",$condicional);
					
					$a_evaluar = "if( (".
						 				$condicional.
									") ) ".
									"$"."condicion=1; 
									else " ."$"."condicion=0;";
					 eval($a_evaluar);						 						//evaluo
					
					 if ($condicion)
						$htmlsalida .= cSepararHTML::ObtenerBloque($partes[$i]);
				}
				
			}else	
				$htmlsalida.=$partes[$i];
		}
				return true;
	}
	
	
    function ObtenerCondicional($html,&$condicional_final)
    {
        
    	$posbegin = strpos($html,"BEGIN");
    	$subhtmlposfinal = substr($html,0,$posbegin); 
    	
    	$posinicial = strpos($html,"(") + 1;
        $posfinal = strrpos($subhtmlposfinal,")");
        
        $longitud = $posfinal - $posinicial;

        // Obtengo lo que esta entre parentesis
        $condicional = substr($html,$posinicial,$longitud);

        // Reemplazo cada aparición de registro (asociativo)  x datos
        $condicional_final="";
        $str_aux_condicional=$condicional; 
      
          while (strlen($str_aux_condicional) >  0) {

            $posinicial = strpos($str_aux_condicional,"[##") ;

              //echo "<br><br><br> inicial :".$posinicial;
      
              if($posinicial !== false) {
              
                $posinicial = $posinicial + 3;
              
                  $posfinal = strpos($str_aux_condicional,"##]", $posinicial );                    
                  $longitud = $posfinal - $posinicial;                    
          
                  $campo = substr($str_aux_condicional,$posinicial,$longitud);

                  $condicional_final.=substr($str_aux_condicional,0,$posinicial - 3);
                  $condicional_final.="$"."datos['".$campo."']" ;

                  $str_aux_condicional=substr($str_aux_condicional, $posfinal + 3);

                  /*
                  echo "<br><br><br> campo : "."$"."datos['".$campo."']";
                  echo "<br><br><br> valor del campo ".eval("$"."datos['".$campo."']");
      			  echo "<br><br><br> campo : ".$campo;
      			  
                  echo "<br><br><br>condicional_final : ".$condicional_final;
                  echo "<br><br><br>queda por analizar str_aux_condicional : ".$str_aux_condicional;
				*/
                  
              } else { 
                  $condicional_final.=$str_aux_condicional;
                  $str_aux_condicional="";
              }
          }

      //  echo "<br>Condicion Final =".$condicional_final;

        return true;
    }
	
	
	function ObtenerBloque($html)
	{
		$posinicial = strpos($html,"BEGIN") + 5;
		$posfinal = strpos($html,"END");
		$longitud = $posfinal - $posinicial;
		$bloque = substr($html,$posinicial,$longitud);
		return $bloque;	
	}
}
