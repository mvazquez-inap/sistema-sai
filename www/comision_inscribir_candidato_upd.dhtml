<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oComisionPersonaCandidato= new cComisionPersonaCandidato($conexion);

$conexion->ManejoTransacciones("B");

if (isset($_POST['boton_eliminar'])) {

	if($oComisionPersona->BajaDatosComisionInscribirAlumnos($_POST)) {
		FuncionesPHPLocal::RegistrarAcceso($conexion,"50402","pers_codigo=".$_POST['pers_codigo']." - comi_codigo=".$_POST['comi_codigo'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha eliminado la persona de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
	} else 
		$conexion->ManejoTransacciones("R");

} elseif ($_POST['operacion'] == "I") {		
		

		if($oComisionPersonaCandidato->AltaDatosComisionInscribirCandidato($_POST)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han agregado los datos de la asignación de la persona a la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$conexion->ManejoTransacciones("C");
			
		} else 
			$conexion->ManejoTransacciones("R");

	} elseif ($_POST['operacion'] == "M" ) {
	
		if($oComisionPersona->ModifDatosComisionInscribirAlumnos($_POST)) {
			FuncionesPHPLocal::RegistrarAcceso($conexion,"50403","pers_codigo=".$_POST['pers_codigo']." - comi_codigo=".$_POST['comi_codigo'],$_SESSION['usuariocod']);
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han modificado los datos de la asignación de la persona a la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$conexion->ManejoTransacciones("C");
		} else 
			$conexion->ManejoTransacciones("R");			
	 
	 } else 		
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en la operación a realizar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));


		if 	( ($_SESSION['rolcod'] == USUCURSOINAP &&  $_POST['tipoact_codigo'] == TIPOACTCURSOINAP) ||
			  (($_SESSION['rolcod'] == COORDINADORTECNICO  ||  $_SESSION['rolcod'] ==  USUORGANISMO) &&  $_POST['tipoact_codigo'] == TIPOACTCURSOJURISD) ){ ?>
				<div align="center"><a href="comision_inscribir_alumno.dhtml?comi_codigo=<?php echo $_POST['comi_codigo']?>"class="linkFondoBlanco">Inscribir Alumnos en la Comisión</a></div><br>
		<?php } ?>
<div align="center"><a href="comision_inscribir_candidato.dhtml?comi_codigo=<?php echo $_POST['comi_codigo']?>"class="linkFondoBlanco">Volver</a></div><br>



<?php	
$oEncabezados->PieMenuEmergente(); 
?>