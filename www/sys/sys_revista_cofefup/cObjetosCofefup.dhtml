//----------------------------------------------------------------------------------------- 
	public function MostrarSumario($idart="") {
	 	
		$salida="";
 		$oArticulo = new cArticulos($this->conexion);
		
		$datosbusqueda = array ('campo'=>'titulo',
						    'estadopub' => ESTPUBPUBLICADA,
						    'estadoart' => ESTARTPUBLICADO,	
						    'orderby' => "orden_menu DESC");
		
	 	$tipo = 0; // Distinto de 1 porque no quiero el count

	 	if (!$oArticulo->BusquedaAvanzada($datosbusqueda,$tipo,$resultado,$numfilas))
			die();		
			
		$salida='	<div class="menulateral">
				     <div class="titulo_menu"> Sumario </div>
					<ul class="clearfix">';

		$count=1;
	
		
		while($registro=mysqli_fetch_assoc($resultado)){			
			$salida.='<li> 
				<a ';
					
			if (isset($idart)) {
				if ($idart == $registro['idart'])
					$salida.=" class=\"seleccionado\" ";
			}
			if ($count==$numfilas)
				$salida.='style="border:none;"';				
				
			$salida.='href="'.PAG_ART_AMPLIADO.'?idart='.$registro['idart'].'">'.$registro['titulo'].
			         "</a></li> " ;
			
			$count++;
		}			
		$salida.='	</ul>
				</div>';

		
		
		echo $salida;
	}
	//----------------------------------------------------------------------------------------- 
	public function MostrarLstArticuloHome() {
	 	
		$salida="";
	 	
		$oArticulo = new cArticulos($this->conexion);
		
		$datosbusqueda = array ('estadopub' => ESTPUBPUBLICADA,
						    'estadoart' => ESTARTPUBLICADO,
		   				    'destacado' => DESTACADO_SI,		
						    'orderby' => "orden_destacado DESC",
						);
		
	 	$tipo = 0; 		// Distinto de 1 porque no quiero el count

	 	if (!$oArticulo->BusquedaAvanzada($datosbusqueda,$tipo,$resultado,$numfilas))
			die();		
		
		$nivel = 1;
		$count = 1;	
		while($registro=mysqli_fetch_assoc($resultado)){
				
			$this->MostrarArticuloHome($registro, $nivel, $salida_registro);			
			
			if ($nivel==1)
			    $nivel = $nivel + 1;			    
			elseif($nivel>1 and $nivel<3 ) {
				if ($count==3) {
					$nivel = $nivel + 1;	
					$count = 1;		 
				} else {
					$count++;	
				}				 
			}    
			if ($nivel>3) 
			    $nivel=3; 
			   
			$salida.=$salida_registro;
		}					
		
	 	echo $salida;
	}	
	//----------------------------------------------------------------------------------------- 
	public function MostrarArticuloHome($articulo,$nivel,&$salida) {
		
		$salida="";
		
		switch($nivel)
		{
			case 1:
				$salida.='<div class="articulolst">';	
				$salida.='	<div class="clearfix">
								<div class="imgPrincipal">';
									if (isset($articulo['img']) ){
										if(trim($articulo['img_alt'])=="")
											$articulo['img_alt']='Imagen';
											$salida.='<img src="'.$articulo['img'].'" alt="'.$articulo['img_alt'].'" />';					
									}
				$salida.='		</div> 
								<div class="clearboth"></div>';
				$salida.='		<div class="titulo_articulo clearfix">
									<h1>	<a href="'.PAG_ART_AMPLIADO.'?idart='.$articulo['idart'].'" title="'.$articulo['titulo'].'" > '.
										$articulo['titulo'].
										'</a> 	
									</h1>';	
				$salida.='		</div>';				
				$salida.='	<div class="">'.
									$articulo['desc_corta'].
								'</div>
							<div class="clearboth"></div>
						</div>
					</div>';
		         break;
			case 2:
				$salida.='<div class="articulolst">	
							<div class="titulo_articulo clearfix">
								<h2>	<a href="'.PAG_ART_AMPLIADO.'?idart='.$articulo['idart'].'" title="'.$articulo['titulo'].'" > '.
									$articulo['titulo'].
									'</a> 	
								</h2>';	
				$salida.='	</div>';				
				$salida.='	<div class="clearfix">
								<div class="img_izq">';
									if (isset($articulo['img']) ){
										if(trim($articulo['img_alt'])=="")
											$articulo['img_alt']='Imagen';
										$salida.='<img class="imgCaja"  src="'.$articulo['img'].'" alt="'.$articulo['img_alt'].'" />';					
									}
				$salida.='		</div>
								<div class="txt_caja txt_derecha">'.
									$articulo['desc_corta'].
								'</div>
							<div class="clearboth"></div>
						</div>
					</div>';
				break;
			case 3:			
				// $salida=" 3 - ".$articulo['idart']. " <br />";
				$salida=' <div class="articulolst">	
							<div class="titulo_articulo clearfix">';										
				$salida.='		<h2> <a href="'.PAG_ART_AMPLIADO.'?idart='.$articulo['idart'].'" title="'.$articulo['titulo'].'" > '.
									$articulo['titulo'].
									'</a> 	
								</h2>';												
				$salida.='	</div>';
				$salida.='	<div class="clear"></div>';
				$salida.='	<p>'.$articulo['desc_corta'].'</p>';					
				$salida.='</div>';
				break;
		}		
	}			
