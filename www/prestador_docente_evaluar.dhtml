										);
										$spnombre="sel_prestador_docente_tipo_postulacion_xpresdoc_tipopos";	
										if(!$conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado_tipopos,$numfilas_tipopos,$errno))
