/* Requiere que esten definidos:

	Stored Básicos: sel_usuarios_xusuariocuit_xpassword
					sel_roles_xusuariocod
					sel_usuarios_xusuariocod

	Registros de Acceso: 
*/

ob_start();
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session 

$_SESSION['sistema']=SISTEMA;
$_SESSION['mostrarmsgbloqueo'] ="NO";

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$usuarios=new cUsuarios($conexion);

// echo "<br> run actual = ".RUN_ACTUAL;

//----------------------------------------------------------------------------------------- 
function ValidarDatosLogin($conexion,&$datosvalidados) {

	$datosbien=true;
	
	if (!FuncionesPHPLocal::ValidarContenido($conexion,$_POST['usuariocuit'],"NumericoEntero"))
		$datosbien=false;
		
	if ($datosbien)
	{
		$clavemd5 = md5($_POST['usuarioclave']);
		
		$spnombreusuario='sel_usuarios_xusuariocuit_xpassword';
		$spparamusuario=array('pusuariocuit'=>$_POST['usuariocuit'],'pusuariopassword'=>$clavemd5);
		if(!$conexion->ejecutarStoredProcedure($spnombreusuario,$spparamusuario,$queryusuario,$numfilas,$errno) || $numfilas!=1)
			$datosbien=false;
		
	}

	if(!$datosbien)
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,'013801',"usuariocuit=".$_POST['usuariocuit'],$_SESSION['usuariocod']);
		echo "<br><br><br><br>";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Usuario y/o Clave no válidos - '".htmlspecialchars($_POST['usuariocuit'],ENT_QUOTES)."'",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"",true,false);
		echo "<br><br>";
		return false;
	}
	else
	{
		$filausuario=mysqli_fetch_assoc($queryusuario);
		//asignacion de variables de session
		$datosvalidados['usuariocod'] = $filausuario['usuariocod'];

		$datosvalidados['resetpass']=false;
		switch ($filausuario['usuarioestado'])
		{
			case USUARIONUEVO :
				$datosvalidados['resetpass']=true;
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Bienvenido al Sistema '".htmlspecialchars($filausuario['usuarioapellido'].",".$filausuario['usuarionombre'],ENT_QUOTES)."'<br>Ud. Deber&aacute; modificar su Clave",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				break;
	
			case USUARIOACT :
				
				FuncionesPHPLocal::RegistrarAcceso($conexion,'013802',"usuariocuit=".$_POST['usuariocuit'],$datosvalidados['usuariocod']);

				$roles=new cRoles($conexion);
				$roles->RolesDeUnUsuarioSP($datosvalidados['usuariocod'],$spnombre,$spparam);

				if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
				{
					// Password already matched. This is not a bad login:
					// returning false prints the link to index.dhtml.
					$datosvalidados["roles_errno"]=$errno;
					$datosvalidados["cantroles"]=0;
					break;
				}
				
				$datosvalidados["cantroles"]=$numfilas;
				
				if($datosvalidados["cantroles"]==1)
				{
					$filarol=mysqli_fetch_assoc($query);
					$datosvalidados["rolcod"]=$filarol["rolcod"];
					$datosvalidados["jurisdid_inap"]=$filarol["jurisdid_inap"];
				}
				break;			
				
			case USUARIOBAJA :
				echo "<br><br><br>";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"No tiene acceso al Sistema.<br>El usuario '".htmlspecialchars($filausuario['usuarioapellido'].",".$filausuario['usuarionombre'],ENT_QUOTES)."' ha sido dado de baja",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				echo "<p>&nbsp;</p>";
				return false;
				
				break;
			default:
				echo "<br><br><br>";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Imposible acceder.  Estado del usuario indefinido:'".htmlspecialchars($filausuario['usuarioapellido'].",".$filausuario['usuarionombre'],ENT_QUOTES)."' indefinido.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				
				return false;
		}
	}
	
	return true;
}
//----------------------------------------------------------------------------------------- 
function ValidarDatosCambiaPass($conexion,&$datosvalidados)
{
	$commit=true;
	$conexion->ManejoTransacciones("B");
	
	$clave_actual = md5($_POST['clave1']);
	$clave_nueva = md5($_POST['clave2']);
	$clave_confirma = md5($_POST['clave3']);

	$spnombre='sel_usuarios_xusuariocod';
	$spparam=array('pusuariocod'=>$_SESSION['usuariocod']);
	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$queryusuario,$numfilas,$errno) || $numfilas!=1)
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en acceso a usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$filausuario=mysqli_fetch_assoc($queryusuario);

	if($filausuario["usuariopassword"] !=$clave_actual || $clave_nueva!=$clave_confirma)
	{
		echo"<p>&nbsp;</p>";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Los datos ingresados son erróneos. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}

	if($commit && !FuncionesPHPLocal::ValidarPassword($_POST['clave2'],$_POST['clave1'],$filausuario["usuarioCUIT"],6))
	{
		echo"<p>&nbsp;</p>";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"La nueva contraseña no es válida. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$datosvalidados["clavenueva"]=$_POST['clave2'];
	$datosvalidados["usuariocuit"]=$filausuario["usuarioCUIT"];

	return true;
}
//----------------------------------------------------------------------------------------- 
$datosvalidados=array();
$accion="NADA";

// A password manager can submit the form without the submit button.
// That used to fall through to Location: index.dhtml.
if(isset($_POST["botoningresar"]) || (isset($_POST["usuariocuit"]) && isset($_POST["usuarioclave"]) && !isset($_POST["botoncambiapass"]) && !isset($_POST["botonelegirrol"])))
{

	if(ValidarDatosLogin($conexion,$datosvalidados))
	{ 

		$_SESSION['usuariocod'] = $datosvalidados['usuariocod'];
		if($datosvalidados["resetpass"])
		{
			$accion="CAMBIARPASS";
			$usuariocuit=$_POST["usuariocuit"];
		}
		elseif(isset($datosvalidados["roles_errno"]))
		{
			echo "<div align='center' class='textoDatoBold'><br>Error al leer los roles. MySQL ".$datosvalidados["roles_errno"].": ".htmlspecialchars(mysqli_error($conexion->idconexion),ENT_QUOTES)."</div>";
			$accion="NADA";
		}
		elseif($datosvalidados["cantroles"]>1)
			$accion="ELEGIRROL";
		elseif($datosvalidados["cantroles"]==0)
		{
			$_SESSION['usuariocod']=0;
			echo "<div align='center' class='textoDatoBold'><br> No le han asignado ningún rol en el sistema. <br> <br> Comuníquese con su administrador</div>";
			$accion="NADA";
		}
		else
		{
			$_SESSION['mostrarmsgbloqueo'] ="SI";
			$_SESSION['rolcod']=$datosvalidados['rolcod'];
			$_SESSION['jurisdid_inap']=$datosvalidados['jurisdid_inap'];

			while (ob_get_level() > 0)
				ob_end_clean();
			header("Location:ingreso.dhtml");
			die();
		} 
	}
	else
	{ // error al validar los datos
		$_SESSION['usuariocod']=0;
		echo "<div align='center'><a href='index.dhtml' class='textoTablaDato linkFondoBlanco'>Volver al Inicio</a></div>";
		$accion="NADA";
	} 
} // fin botoningresar
elseif(isset($_POST["botoncambiapass"]))
{
	if(ValidarDatosCambiaPass($conexion,$datosvalidados))
	{
		$commit=true;
		$conexion->ManejoTransacciones("B");
		
		if($usuarios->CambiarPwd($_SESSION["usuariocod"],$_POST['clave1'],$_POST['clave2'],$_POST['clave3'])) 
		{		
			FuncionesPHPLocal::RegistrarAcceso($conexion,'023804',"usuariocod=".$_SESSION['usuariocod']." - usuariocuit=".$datosvalidados["usuariocuit"],$_SESSION['usuariocod']);	
			$conexion->ManejoTransacciones("C");
			echo"<p>&nbsp;</p>";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se actualizó la nueva contraseña",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			echo"<p>&nbsp;</p>";
			echo"<div align='center'><a href='index.dhtml' class='linkFondoBlanco textoAclaraciones'>Deber&aacute; volver ingresar al sistema con la nueva contraseña</a></div>";
			$_SESSION['usuariocod']=0;
			$accion="NADA";
	
		} // si realizó el cambio
		else 
		{  // si se produjo un error en los datos
			$conexion->ManejoTransacciones("R");
			echo"<p>&nbsp;</p>";
			echo"<div align='center'><span class='linkFondoBlanco textoAclaraciones'>Ingrese nuevamente</span></div>";

			$accion="CAMBIARPASS";
		} // commit
	}
	else
	{ // error al validar los datos
		echo "<div align='center'><a href='index.dhtml' class='textoTablaDato linkFondoBlanco'>Volver al Inicio</a></div>";
		$_SESSION['usuariocod']=0;
		$accion="NADA";
	}
} // fin botoncambiapass
elseif(isset($_POST["botonelegirrol"]))
{
	// Selecciono rol y jurisdicción, no solo rol
	$parametros = explode("#",strtolower(trim($_POST['rol_jurisd'])));

	$rol = $parametros[0];
	$jurisdid = $parametros[1];
	
	if($usuarios->ValidarDatosElegirRol($_SESSION["usuariocod"],$rol,$jurisdid,$datosvalidados))
	{
		$_SESSION['mostrarmsgbloqueo'] ="SI";
		$_SESSION['rolcod']=$datosvalidados['rolcod'];
		$_SESSION['jurisdid_inap']=$datosvalidados['jurisdid_inap'];

		while (ob_get_level() > 0)
			ob_end_clean();
		header("Location:ingreso.dhtml");
		die();
	}
	else
	{ // error al validar los datos
		echo "<div align='center'><a href='index.dhtml' class='textoTablaDato linkFondoBlanco'>Volver al Inicio</a></div>";
		$_SESSION['usuariocod']=0;
		$accion="NADA";
	}
} // fin boton eligerol
else
{
	$_SESSION['usuariocod'] = 0;	
	$_SESSION['rolcod']=0;
	$_SESSION['jurisdid_inap']=0;

	while (ob_get_level() > 0)
		ob_end_clean();
	header("Location:index.dhtml");
	die();
}

switch ($accion)
{
	case "CAMBIARPASS":
