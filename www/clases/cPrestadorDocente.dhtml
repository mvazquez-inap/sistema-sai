<?php
//----------------------------------------------------------------------------------------- 
class cPrestadorDocente 
{
	var $conexion;

	public function __construct($conexion) {
		$this->conexion = &$conexion;
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosPrestadorDocente($presdoc_codigo,&$datosresult,&$es_modif){
	
		$datosresult=array();
		$es_modif = false;		
		$sparam=array('ppresdoc_codigo' =>$presdoc_codigo);
		$spnombre="sel_prestador_docente_xpresdoc_codigo";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el prestador docente.";
			$errormail="Error al buscar el prestador docente en tabla presador_docente. ".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}
		return true;
	}
	
//-----------------------------------------------------------------------------------------------------	
	function Alta_Pres_Doc_Tipo_Postulacion($presdoc_codigo,$tipopos_codigo ) {
	
	$spnombre="ins_prestador_docente_tipo_postulacion";
	$spparam=array(
		'ppresdoc_codigo'=> $presdoc_codigo,
		'ptipopos_codigo'=> $tipopos_codigo,
		'pultmodusuario'=>$_SESSION['usuariocod'],
		'pultmodfecha'=> date("Y/m/d H:i:s")
	);
	if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		return false;

	return true;
	}

//-----------------------------------------------------------------------------------------------------	
	function Baja_Pres_Doc_Tipo_Postulacion($presdoc_codigo) {
	
	$spnombre="del_prestador_docente_tipo_postulacion_x_presdoc";
	$spparam=array(
		'ppresdoc_codigo'=> $presdoc_codigo
	);
	if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		return false;

	return true;
	}

	
//-----------------------------------------------------------------------------------------------------	
	function AltaDatosPrestadorDocente($datos, &$presdoc_codigo) {

	if(!$this->_DatosValidosAltaPrestadorDocente($datos,$datosvalidados))
		return false;

	// El que valida determina el jurisdicccion y estado según el usuario que da el alta
	$spnombre="ins_prestador_docente";
	$spparam=array(
		'ppresdoc_nombre'=> $datosvalidados['presdoc_nombre'],
		'ppresdoc_apellido'=> $datosvalidados['presdoc_apellido'],
		'ppresdoc_sexo'=> $datosvalidados['presdoc_sexo'],
		'ppresdoc_origen_pais_codigo'=> $datosvalidados['presdoc_origen_pais_codigo'],
		'ppresdoc_eventual'=> $datosvalidados['presdoc_eventual'],
		'ppresdoc_cuilt'=> $datosvalidados['presdoc_cuilt'],
		'ppresdoc_password'=> $datosvalidados['presdoc_password'],
		'ppresdoc_caracter_alta'=> $datosvalidados['presdoc_caracter_alta'],
		'ppresdoc_falta'=> FuncionesPHPLocal::ConvertirFecha($datosvalidados['presdoc_falta'],'dd/mm/aaaa','aaaa-mm-dd'), 
		'ppresdoc_falta_prov'=> ($datosvalidados['presdoc_falta_prov'] != "NULL")?FuncionesPHPLocal::ConvertirFecha($datosvalidados['presdoc_falta_prov'],'dd/mm/aaaa','aaaa-mm-dd'):"NULL", 						
		'ppresdoc_falta_def'=> ($datosvalidados['presdoc_falta_def'] != "NULL")?FuncionesPHPLocal::ConvertirFecha($datosvalidados['presdoc_falta_def'],'dd/mm/aaaa','aaaa-mm-dd'):"NULL", 				
		'ppresdoc_presentacion'=> $datosvalidados['presdoc_presentacion'],
		'ppresdoc_telefono'=> $datosvalidados['presdoc_telefono'],
		'ppresdoc_celular'=> $datosvalidados['presdoc_celular'],
		'ppresdoc_email'=>$datosvalidados['presdoc_email'],
		'ppresdoc_calle'=> $datosvalidados['presdoc_calle'],
		'ppresdoc_numero'=>$datosvalidados['presdoc_numero'],
		'ppresdoc_piso'=> $datosvalidados['presdoc_piso'],
		'ppresdoc_cp'=> $datos['presdoc_cp'],
		'ppresdoc_prov_codigo'=> $datosvalidados['presdoc_prov_codigo'],
		'ppresdoc_part_loca_descripcion'=> $datosvalidados['presdoc_part_loca_descripcion'],			
		'ppresins_codigo'=> $datosvalidados['presins_codigo'],
		'pjurisdid_apn'=> $datosvalidados['jurisdid_apn'],
		'pjurisdid_origen'=> $datosvalidados['jurisdid_origen'],
		'porgapub_codigo'=> $datosvalidados['orgapub_codigo'],
		'ppresdoc_cargo'=> $datosvalidados['presdoc_cargo'],
		'ppresdoc_estado'=> $datosvalidados['presdoc_estado'],
		'ppresdoc_eve_organismo'=> $datosvalidados['presdoc_eve_organismo'],		
		'ppresdoc_max_nivel_estudio'=> $datosvalidados['presdoc_max_nivel_estudio'],		
		'ppresdoc_ult_titulo'=> $datosvalidados['presdoc_ult_titulo'],		
		'ppresdoc_ult_titulo_institucion'=> $datosvalidados['presdoc_ult_titulo_institucion'],		
		'ppresdoc_ult_titulo_ano'=> $datosvalidados['presdoc_ult_titulo_ano'],		
		'ppresdoc_ido_competencias'=> $datosvalidados['presdoc_ido_competencias'],		
		'presdoc_ido_instituciones'=> $datosvalidados['presdoc_ido_instituciones'],		
		'ppresdoc_cv'=> $datosvalidados['presdoc_cv'],				
		'pultmodusuario'=>$_SESSION['usuariocod'],
		'pultmodfecha'=> date("Y/m/d H:i:s")
	);

	if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
	{
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo dar de alta el prestador. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	} else {
		$presdoc_codigo = $this->conexion->ultimocodigoinsertado();

		// agrego los tipos de postulación
		$nuevocodigo=$this->conexion->UltimoCodigoInsertado();
		foreach ($datosvalidados["tipopos"] as $clave => $valor) {
			if(!$this->Alta_Pres_Doc_Tipo_Postulacion($nuevocodigo,$valor,$errno)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo agregar el tipo de postulación al docente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			} else {
				FuncionesPHPLocal::RegistrarAcceso($this->conexion,"36301","presdoc_codigo=".$nuevocodigo."tipopos_codido=".$valor,$_SESSION['usuariocod']);
			}
		}				
	}

	return true;
}	

//-----------------------------------------------------------------------------------------------------	
	function PosibleBajaFisica($presdoc_codigo) {
	
		if(!$this->conexion->TraerCampo('actividad_curso_prestador_docente','presdoc_codigo',array("presdoc_codigo='",$presdoc_codigo,"'"),$dato,$numfilas,$errno)) {
			$error="Error al intentar la baja.";
			$errormail="Error al determinar si puede ser realizada la baja física del prestador docente (actividad_curso_prestador_docente). error=".$errno."presdoc_codigo='".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;	
	    } elseif ($numfilas!=0) {
			return false;	
		}

		if(!$this->conexion->TraerCampo('comision_prestador_docente','presdoc_codigo',array("presdoc_codigo='",$presdoc_codigo,"'"),$dato,$numfilas,$errno)) {
			$error="Error al intentar la baja.";
			$errormail="Error al determinar si puede ser realizada la baja física del prestador docente (comision_prestador_docente). error=".$errno."presdoc_codigo='".$presdoc_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;	
	    } elseif ($numfilas!=0) {
			return false;	
		}
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _BajaCascada($presdoc_codigo) {
	
		// Se eliminan las áreas del prestador docente.	
		// Baja física 
		$oPrestadorDocenteArea = new cPrestadorDocenteArea($this->conexion);
		if (!$oPrestadorDocenteArea->EliminarDatosPrestadorDocenteAreaTodas($presdoc_codigo))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"36202","Global / presdoc_codigo=".$presdoc_codigo,$_SESSION['usuariocod']);

		// Hay que sacar al prestador de todos los equipos docentes.
		// Baja física o lógica, según tenga comisiones o no el prestador docente.
		$oActividadCursoPrestadorDocente = new cActividadCursoPrestadorDocente($this->conexion);
		if( !$oActividadCursoPrestadorDocente->EliminarDatosActividadesCursoPrestadorDocenteTodas($presdoc_codigo))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38502","Global / presdoc_codigo=".$presdoc_codigo,$_SESSION['usuariocod']);


		// borro todos los tipos de postulación que tiene el docente
		if(!$this->Baja_Pres_Doc_Tipo_Postulacion($presdoc_codigo)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo eliminar los tipos de postulación del docente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} else {
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"36302","Global / presdoc_codigo=".$presdoc_codigo,$_SESSION['usuariocod']);
		}


		return true;	
	}
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosPrestadorDocente($presdoc_codigo, &$bajafisica) {

		if(!$this->_DatosValidosEliminarPrestadorDocente($presdoc_codigo,$datosvalidados))
			return false;

		if(!$this->_BajaCascada($datosvalidados['presdoc_codigo']))	
				return false;
	
		if ($this->PosibleBajaFisica($datosvalidados['presdoc_codigo']))	{		
			
			$esbajafisica=true;
			$spnombre="del_prestador_docente";
			$spparam=array(
				'ppresdoc_codigo'=> $datosvalidados['presdoc_codigo']
			);

			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod)) 
				return false;					  	 	
						
		} else {
		
				$esbajafisica=false;
				$spnombre="upd_prestador_docente_baja_xpresdoc_codigo";
				$spparam=array(
					'ppresdoc_fbaja'=> date("Y/m/d H:i:s"),
					'ppresdoc_estado'=> PRESDOCBAJA,
					'pultmodusuario'=>$_SESSION['usuariocod'],
					'ppresdoc_codigo'=> $datosvalidados['presdoc_codigo']
					);

				  if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod) || $numfilas!=1) {
						return false;					  	 	
				}
		}

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function RehabilitarDatosPrestadorDocente($presdoc_codigo)	{

		if(!$this->_DatosValidosRehabilitarPrestadorDocente($presdoc_codigo,$datosvalidados))
			return false;
		
		$spnombre="upd_prestador_docente_cambio_estado_xpresdoc_codigo";
		$spparam=array(
			'ppresdoc_estado'=> PRESDOCINACTIVO,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'ppresdoc_codigo'=> $presdoc_codigo
			);

		  if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod) || $numfilas!=1) {
				return false;					  	 	
		}

		return true;
	}	
