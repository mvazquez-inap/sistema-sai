//-----------------------------------------------------------------------------------------------------
	function ListarDisenoActividadPDF($act_codigo) {

		function GenerarActividadDiseno(&$pdf,$filacurso,$prestadores) {

			$pdf->AddAcividadDiseno();
			$pdf->Set('datos_actividad',$filacurso);
			$pdf->Set('datos_actividad_prestador',$prestadores);
			$pdf->Set('formact_codigo',FORMATOCURSO);
			$pdf->Set('tipoact_codigo',$filacurso['actividad_curso']['tipoact_codigo']);

		} // GenerarActa


		if (!$this->TraerDatosActividadCursoJurisdiccional($act_codigo,$filacurso,$es_modif))  {
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} elseif (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		$descri="";
		if ($this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filacurso['actividad_curso']['jurisdid_inap'],"'"),$descri,$numfilascaracter,$errorcod))
			$filacurso['actividad_curso'] += array('jurisdnom'=>$descri);

		$descri="";
		if ($this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$filacurso['actividad_curso']['actcur_estado'],"'"),$descri,$numfilas,$errorcod))
			$filacurso['actividad_curso'] += array('actcur_estado_desc'=>$descri);


		// Selecciono todos los prestadores asociados a la actividad.
		$oPrestadorDocente = new cPrestadorDocente($this->conexion);
		$ArregloDatos = array();
		$ArregloDatos['act_codigo']=$act_codigo;

		if(!$oPrestadorDocente->BuscarPrestadorDocentexActividad($ArregloDatos,$numfilas,$prestadores,$error,$errormail)) {
			$txt_sys_mail="\nact_codigo=".$act_codigo."\nerror=".$error;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}


		$pdf = new cActividadDisenoPDF();
		GenerarActividadDiseno($pdf,$filacurso,$prestadores);
		$pdf->MostrarActividadDiseno($this->conexion);
		$pdf->Output("disenoActividad.pdf","I");

		return true;
	}

//-----------------------------------------------------------------------------------------------------
	function ListarDisenoActividad($act_codigo) {

	$ok=true;
 	if (!$this->TraerDatosActividadCursoJurisdiccional($act_codigo,$filacurso,$es_modif))  {
		$txt_sys_mail="\nact_codigo=".$act_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		$ok=false;
	} elseif (!$es_modif) {
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok=false;
	}

	if (!$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$filacurso['actividad_curso']['actcur_estado'],"'"),$descri_estado,$numfilas,$errorcod)){
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el estado de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok=false;
	}


?>
	<br><div class="textoTitulo" align="left">Detalle de la Actividad Curso Jurisdiccional <?php echo ($filacurso['actividad_curso']['actcur_estado'] != ACTCURSOACTIVO)?"(Estado ".$descri_estado.")":""?></div><br>
<?php
	if ($ok) {	?>
		<table width="100%" class="textoTablaDatoBorde" align="center" border="1" cellpadding="4" cellspacing="0">
			<tr>
				<td width="30%" class='textoTablaDato'>Nombre</td>
				<td class='textoEtiquetaDatoResaltado'><?= htmlspecialchars($filacurso['actividad']['act_nombre'],ENT_QUOTES); ?></td>
			</tr>
			<tr>
				<td class='textoTablaDato'>Organismo</td>
				<td class='textoEtiquetaDatoResaltado'>
					<?php $this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filacurso['actividad_curso']['jurisdid_inap'],"'"),$descri,$numfilascaracter,$errorcod);
					   echo $descri;
					?>
				</td>
			</tr>
			<tr>
				<td class='textoTablaDato'>Código INAP</td>
				<td class='textoEtiquetaDatoResaltado'><?= htmlspecialchars($filacurso['actividad']['act_codinap'],ENT_QUOTES); ?></td>
			</tr>
			<tr>
				<td class='textoTablaDato'>Fundamentación</td>
				<td class='textoEtiquetaDatoResaltado'><?= nl2br(htmlspecialchars($filacurso['actividad_curso_jurisdiccional']['actdisjurisd_fundamentacion'],ENT_QUOTES)); ?></td>
			</tr>
<?php			if (isset($filacurso['actividad_curso_jurisdiccional']['actdisjurisd_contribucion'])) { ?>
				<tr>
					<td class='textoTablaDato'>Contribución esperada</td>
					<td class='textoEtiquetaDatoResaltado'><?= htmlspecialchars($filacurso['actividad_curso_jurisdiccional']['actdisjurisd_contribucion'],ENT_QUOTES); ?></td>
				</tr>
<?php			} ?>
<?php			if (isset($filacurso['actividad_curso_jurisdiccional']['actdisjurisd_perfil'])) { ?>
				<tr>
					<td class='textoTablaDato'>Perfil del participante</td>
					<td class='textoEtiquetaDatoResaltado'><?= nl2br(htmlspecialchars($filacurso['actividad_curso_jurisdiccional']['actdisjurisd_perfil'],ENT_QUOTES)); ?></td>
				</tr>
<?php			} ?>
<?php			if (isset($filacurso['actividad_curso_jurisdiccional']['actdisjurisd_objetivos'])) { ?>
