		?>
		<br>
<?php		if($ok) { 

			// Muestro Historial (como ya estan en el array mando el array)
			$oActividadCursoJurisdiccional->MostrarHistorialEvaluacion($conexion,$filacurso); 
?>
			<form action="<?php echo $destino_formulario_upd ?>" method="post" name="formulario">
				<table width="95%" class="textoTablaDato" align="center">
					<tr>
						<td valign="top"  width="25%" class='textoEtiqueta'>Motivo/Aclaración</td>
						<td valign="top" class="textoEtiquetaDatoResaltado">  
							<textarea cols="100" rows="3" class='textoInput' name="aclaracion_mail" style="width:400px"></textarea>
						</td>
					</tr>
					<tr align="center">
						<td colspan="2" valign="middle">
							<input type="submit" name="boton_aprueba" class="botones" value="Aprobar" onClick="return confirm('¿Está seguro que desea Aprobar la Actividad?') &amp;&amp; ValidarFormActividadCursoEvaluar(formulario);">
							<input type="submit" name="boton_rechaza" class="botones" value="Rechazar" onClick="return confirm('¿Está seguro que desea Rechazar la Actividad?') &amp;&amp; ValidarFormActividadCursoEvaluar(formulario);">
							<input type="hidden" name="act_codigo" value="<?php echo ($es_modif)?htmlspecialchars($filacurso['actividad']['act_codigo'],ENT_QUOTES):""; ?>"/>
						</td>
					</tr>	
				</table>
			</form>
			<br><br>
	<?php } // ok
	} // ok
