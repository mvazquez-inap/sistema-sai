<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oAgente = new cAgentes($conexion);

if(isset($_POST['BotonAlta']) && $_POST["pers_codigo"]=="")
{
	$conexion->ManejoTransacciones("B");

	if($oAgente->AltaDatosAgente($_POST))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"35701","pers_cuilt=".$_POST['pers_cuilt'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han dado de Alta los datos laborales de la persona con CUIT ".$_POST['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

		$conexion->ManejoTransacciones("C");

	}
	else
		$conexion->ManejoTransacciones("R");
?>		
		<br><br><br><div align="center"><a href="agente_modificar.dhtml" class="linkFondoBlanco">Continuar</a></div>
<?php 
		
}
elseif(isset($_POST['BotonAlta']) && $_POST["pers_codigo"]!="")
{
	$conexion->ManejoTransacciones("B");

	if($oAgente->ModifDatosAgente($_POST))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"35703","pers_codigo=".$_POST['pers_codigo'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han modificado los datos laborales de la persona con CUIT ".$_POST['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
	}
	else
		$conexion->ManejoTransacciones("R");
?>		
		<br><br><br><div align="center"><a href="agente_modificar.dhtml" class="linkFondoBlanco">Continuar</a></div>
<?php 
		
}
elseif(isset($_POST['BotonBaja']))
{
	$conexion->ManejoTransacciones("B");
	if($oAgente->BorrarDatosAgente($_POST["pers_cuilt"]))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"35702","pers_codigo=".$_POST['pers_codigo'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han eliminado los datos laborales de la persona con CUIT ".$_POST['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
	}
	else
		$conexion->ManejoTransacciones("R");
?>		
		<br><br><br><div align="center"><a href="agente_modificar.dhtml" class="linkFondoBlanco">Continuar</a></div>
<?php 
		
}
else
{

?>		
		<br><br><br><div align="center"><a href="agente_modificar.dhtml" class="linkFondoBlanco">Ir al listado</a></div>
<?php 
}

$oEncabezados->PieMenuEmergente();
?>
