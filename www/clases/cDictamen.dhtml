		return true;
	}

//-----------------------------------------------------------------------------------------------------	
	function ModifDatosDictamenPersonal($datos) {

		if(!$this->_DatosValidosModifDictamenPersonal($datos,$datosvalidados))
			return false;

		if($this->ModifDatosDictamen($datosvalidados)) {
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"49003","dic_codigo=".$datosvalidados['dic_codigo'],$_SESSION['usuariocod']);
		} else 
			return false;
		
		//creo dictamen
		$spnombre="upd_actividad_autodesarrollo_dictamen_xact_codigo_pers_codigo";
		$spparam=array(
			'pact_codigo'=> $datosvalidados['act_codigo'],
			'ppers_codigo'=> $datosvalidados['pers_codigo'],
			'pdic_codigo'=> $datosvalidados['dic_codigo'],
			'pactauto_creditos'=> $datosvalidados['act_creditos'],
			'pactautodic_obs'=> $datosvalidados['actautodic_obs'],			
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar el Dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		return true;
	}


	//-----------------------------------------------------------------------------------------------------	
	// Esta funcion dada una actividad, codigo, y tipo
	// Retorna 
	// a) Operación que se puede realizar sobre el dictamen.  
	// b) Dictamen editable (ultimo editable o uno nuevo).
	// c) Fila con datos basicos de la actividad en formato normalizado, para ser mostrado. 
	// Se usa antes de mostrar los datos al dictaminar
	function ObtenerDatosParaDictaminar ($conexion,$oActividad,$act_codigo,$tipoact_codigo,
								   					&$operacion_dictamen,&$operacion_programacion,
								   					&$fila_ultimo_dictamen,&$fila_detalle,&$fila_dictamen_editable) {
	
		if (!$oActividad->TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,$fila_detalle,$es_modif_act) ) {
	
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar la Actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"\nact_codigo=".$filaactividad['act_codigo']);
			return false;	

		} else {
		
			$fila_dictamen_editable=array();
			$fila_ultimo_dictamen=array();		
		
			// Obtengo los dictamenes ordenados por la secuencia
			$ArregloDatos['act_codigo']=$act_codigo;
			$ArregloDatos['tipoact_codigo']=$tipoact_codigo;		
			$ArregloDatos['orderby']='actprog_sec desc';

			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
				$txt_sys_mail="Error al buscar dictamen de la actividad.\nact_codigo=".$filaactividad['act_codigo'];
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;	
			} elseif ($numfilas!=0) { // Hay dictamenes para la actividad

				$fila_dictamen=mysqli_fetch_assoc($resultDictamenes);

				if ($fila_dictamen['dic_estado']==DICTAMENNUEVO || $fila_dictamen['dic_estado']==DICTAMENRECHAZADO)
					$fila_dictamen_editable=$fila_dictamen;

				$fila_ultimo_dictamen=$fila_dictamen;
			} 

			$fila_ultimo_dictamen['act_duracionhs']=$fila_detalle['act_duracionhs'];
			$fila_ultimo_dictamen['act_creditos']=$fila_detalle['act_creditos'];

			$fila_ultimo_dictamen['act_creditos']=$fila_detalle['act_creditos'];
			// Hay un único dictamen y es nuevo o rechazado
			$hay_dictamen = ($numfilas!=0);
			$hay_dictamen_editable = ($numfilas==1 && ($fila_ultimo_dictamen['dic_estado']==DICTAMENNUEVO || $fila_ultimo_dictamen['dic_estado']==DICTAMENRECHAZADO || $_SESSION['rolcod'] == SUPERUSUARIO));
		
			if (!$hay_dictamen) 
			   $operacion_dictamen= "A";
			elseif ($hay_dictamen_editable)    
				$operacion_dictamen= "M";
			 else 
				$operacion_dictamen= "V";

				
			if ($numfilas==0 || !($fila_ultimo_dictamen['dic_estado']==DICTAMENNUEVO || $fila_ultimo_dictamen['dic_estado']==DICTAMENRECHAZADO || $_SESSION['rolcod'] == SUPERUSUARIO))
				$operacion_programacion = "A";
			else 
				$operacion_programacion = "M";	

		}
		return  true;	
	}
	//-----------------------------------------------------------------------------------------------------	
	// Esta funcion dada una actividad, codigo, y tipo
	// Retorna 
	// a) Operación que se puede realizar sobre el dictamen.  
	// b) Dictamen editable (ultimo editable o uno nuevo).
	// c) Fila con datos basicos de la actividad en formato normalizado, para ser mostrado. 
	// Se usa antes de mostrar los datos al dictaminar
	function ObtenerDatosParaModificarDictamen ($conexion,$oActividad,$act_codigo,$tipoact_codigo,
								   					&$operacion_dictamen,&$operacion_programacion,
								   					&$fila_ultimo_dictamen,&$fila_detalle,&$fila_dictamen_editable) {
	
	
		if (!$oActividad->TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,$fila_detalle,$es_modif_act) ) {
	
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar la Actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"\nact_codigo=".$filaactividad['act_codigo']);
			return false;	

		} else {
		
			$fila_dictamen_editable=array();
			$fila_ultimo_dictamen=array();		
		
			// Obtengo los dictamenes ordenados por la secuencia
			$ArregloDatos['act_codigo']=$act_codigo;
			$ArregloDatos['tipoact_codigo']=$tipoact_codigo;		
			$ArregloDatos['orderby']='actprog_sec desc';

			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
				$txt_sys_mail="Error al buscar dictamen de la actividad.\nact_codigo=".$filaactividad['act_codigo'];
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;	
			} elseif ($numfilas!=0) { // Hay dictamenes para la actividad
				$fila_dictamen=mysqli_fetch_assoc($resultDictamenes);
				if ($fila_dictamen['dic_estado']==DICTAMENNUEVO || $fila_dictamen['dic_estado']==DICTAMENRECHAZADO)
					$fila_dictamen_editable=$fila_dictamen;
				$fila_ultimo_dictamen=$fila_dictamen;
			} 

			$fila_ultimo_dictamen['act_duracionhs']=$fila_detalle['act_duracionhs'];
			$fila_ultimo_dictamen['act_creditos']=$fila_detalle['act_creditos'];


			// Hay un único dictamen y es nuevo o rechazado
			$hay_dictamen = ($numfilas!=0);
			$hay_dictamen_editable = ($numfilas==1 && ($fila_ultimo_dictamen['dic_estado']==DICTAMENNUEVO || $fila_ultimo_dictamen['dic_estado']==DICTAMENRECHAZADO)) ;


			if (!$hay_dictamen){ 
			   $operacion_dictamen= "A";
			   $operacion_programacion = "A";
			 }else{ 
				$operacion_dictamen= "M";
				$operacion_programacion = "M";	
			}
		}
		return  true;	
	}	
	//--------------------------------------------------------------------------------------------
	function ObtenerDatosParaPedirAprobDictamen($conexion,$oActividad,$act_codigo,$tipoact_codigo,
								   				$actprog_sec,&$fila_dictamen_editable,&$fila_detalle) {
		
		if (!$oActividad->TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,$fila_detalle,$es_modif_act) ) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar la Actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"\nact_codigo=".$filaactividad['act_codigo']);
			return false;	
		} else {
			
			$fila_dictamen_editable=array();
			$ArregloDatos['act_codigo']=$act_codigo;
			$ArregloDatos['tipoact_codigo']=$tipoact_codigo;		
			$ArregloDatos['actprog_sec']=$actprog_sec;		

			// Obtengo el dictamen de la secuencia enviada
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
				$txt_sys_mail="Error al buscar dictamen de la actividad.\nact_codigo=".$filaactividad['act_codigo'];
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;	
			} elseif ($numfilas==1) { // No existe la secuencia 
				$fila_dictamen=mysqli_fetch_assoc($resultDictamenes);
				if ($fila_dictamen['dic_estado']==DICTAMENNUEVO || $fila_dictamen['dic_estado']==DICTAMENRECHAZADO) {
					$fila_dictamen_editable=$fila_dictamen;
					$fila_dictamen_editable['act_duracionhs']=$fila_detalle['act_duracionhs'];
					$fila_dictamen_editable['act_creditos']=$fila_detalle['act_creditos'];
				} 	
			  } else {
			  	 return false;	
		    } // Obtencion del dictamen
			
		} // ok datos de la actividad
		
		return true;	
	}
