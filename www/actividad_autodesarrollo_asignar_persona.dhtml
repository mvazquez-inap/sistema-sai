<script type="text/javascript">
function buscarActividadPersona(formulario,divPersona,pers_cuilt,act_codigo,formact_codigo, tipoact_codigo, actprog_sec) {

	var item_obj = EncontrarObjeto(divPersona);
	var objAguarde = EncontrarObjeto('idAguarde');	
	if (objAguarde != null)
		objAguarde.innerHTML='Aguarde ...';	
	
	item_obj.innerHTML="";
	
	var ajax=nuevoAjax();
	var datos="pers_cuilt="+trim(pers_cuilt)+"&act_codigo="+act_codigo;
	    datos=datos+"&formact_codigo="+formact_codigo+"&tipoact_codigo="+tipoact_codigo+"&actprog_sec="+actprog_sec;

	var archivo = "actividad_autodesarrollo_asignar_persona_ajax.dhtml";
	ajax.open("POST",archivo,true);
	ajax.onreadystatechange=function() {
		if (ajax.readyState==4) {	
			if (objAguarde != null)
				objAguarde.innerHTML='';	
			item_obj.innerHTML=ajax.responseText;	
			return true;
		}
	}	
	ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded'); 
	ajax.send(datos);		
	return false;
}
//-----------------------------------------------------------------
</script>
