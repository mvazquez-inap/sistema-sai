<?php
/* CLASE ABSTRACTA

	Los métodos que comienzan con _	no deber ser usados desde afuera.
	Los métodos que comienzan con __ deben ser redefinidos en la subclase si fuera necesario.

//--------------------------------------------------------------------------------------------------
// ABM de tablas básicas del sistema:
// Tablas: 	código 			: autoincremental.
			descripción  	: se parametriza el nombre del campo.
			fecha de alta	: fecha en que ingresa la descripcion al sistema.
 			estado 			: opcional en caso de manejar baja lógica.
			fecha de baja 	: opcional en caso de manejar baja lógica. 

// Para ALTA o MODIFICACIOn
	Si la tabla maneja estado:
		Se valida que la descripción no exista en un registro activo cuando se inserta o modifica.
	Si la tabla no maneja estado:
		Se valida que la descripción no exista en un registro cuando se inserta o modifica.

// Para la BAJA
	__PosibleBaja: 	Debe ser redefinida en caso de querer evitar la baja (logica o fisica) x la 
					existencia de datos asociados.	
    __BajaCascada:	Debe ser redefinida en caso de requerirse eliminar datos asocidos antes de intentar la 
					baja del descriptor.

	Si es una tabla que maneja estados:
				
		 Se intenta una baja física cuando el código no existe en ninguna de
		 las tablas definidas como referenciadas, sino se realiza una baja lógica.

//--------------------------------------------------------------------------------------------------
// Se deben definir los siguientes stored para la tabla
//  NOTA: si la tabla no maneja estado omitir en los nombres y parametros el mismo
//		  y no hace falta definir el cambio de estado.
  
// "ins_".$tabla
// "del_".$tabla
// "upd_".$tabla
// "upd_".$tabla."_cambio_estado_x".$campo_clave
// "sel_".$tabla."_x".$campo_clave;  				
// "sel_".$tabla."_x".$campo_estado."_".$campo_desc;
// "sel_".$tabla."_xestado_orden"
// "sel_".$tabla."_xdatos"
*/

class cTablaSysDesc  {

	var $conexion;
	var $nom_tabla="";			// Nombre de la tabla Ej:area_curso_inap
	var $titulo_tabla;			// Titulo de la tabla Ej: Areas para clasificar las actividades INAP
								// Si esta seteado se usa en la grilla de seleccion como titulo de la misma.
	var $campos_tabla=array();	// Campos de la tabla 
								// Define el nombre de campo cada uno de los componentes de la tabla
								// Ej:	$array_campos=array(	'clave'=> 'areacur_codigo',
								//  	'estado'=>'areacur_estado',
								//		'descripcion'=>array('nombre_campo'=>'areacur_descripcion', 'long_campo'=>40 ,'titulo_campo'=>'Area'),
								//		'fecha_alta'=>'areacur_falta',
								//		'fecha_baja'=>'areacur_fbaja');
								
	var $error=false;			// Alguna operación produjo o no error 
	var $errorMsg="";			// Descripcion del error que se produjo

	var $logs=array();			// Ej: $array_log=array('ins'=>'35001', 'upd'=>'35003', 'del'=>'35002','chg_estado'=>'35004');

	var $tabla_ref=array();	    // Array con las tablas que hacen referencia a la tabla que se actualiza.
								// cada elemento contiene nombre de la tabla relacionada y campo por el cual se relaciona
								// Ej: array(array('nom_tabla'=>'actividad_curso_diseno_inap','campo_tabla'=>'areacur_codigo') 
								// Por defecto si existen datos en las tablas relacionadas se va a
								// ejecutar una baja lógica, sino física.

	var $estado=true;			// Define si la tabla maneja estados.
	
//---------------------------------------------------------------
	public function __construct($conexion,$tabla,$array_campos) {
		$this->conexion = &$conexion;
		$this->_SetearCampos($array_campos);
		$this->nom_tabla=$tabla;
	}
//---------------------------------------------------------------	
	function SetearTablasTipoBaja($tabla_relacionada) {
		$this->tabla_ref=$tabla_relacionada;
	}
//---------------------------------------------------------------
	function SetearLogs($array_log) {
	
		if ($this->_ValidarLog($array_log)) {

			$this->_SetearLog('ins',$array_log['ins']);
			$this->_SetearLog('upd',$array_log['upd']);
			$this->_SetearLog('del',$array_log['del']);

			if($this->_EsTablaConEstado()) 			
				$this->_SetearLog('chg_estado',$array_log['chg_estado']);
		}			
	}	
//---------------------------------------------------------------
	function SetearTituloTabla($titulo) {
		$this->titulo_tabla=$titulo;
	}	
//---------------------------------------------------------------
	function ObtenerNombreTabla() {
	 	return $this->nom_tabla;
	}
//---------------------------------------------------------------
	function ObtenerTituloTabla() {
	 	return $this->titulo_tabla;
	}
//---------------------------------------------------------------
	function ObtenerCampo($campo) {
		if($campo=='descripcion')
			return $this->campos_tabla['descripcion']['nombre_campo'];	
		
		return $this->campos_tabla[$campo];	 
	}
//---------------------------------------------------------------
	function ObtenerLongCampo($campo) {
		if($campo=='descripcion')
			return $this->campos_tabla['descripcion']['long_campo'];	
		else {
			$this->error=true;
			$this->errorMsg="No se definió long para el campo enviado";			
		}	  
	}
//---------------------------------------------------------------
	function ObtenerTituloCampo($campo) {
		if($campo=='descripcion')
			return $this->campos_tabla['descripcion']['titulo_campo'];	
		else {
			$this->error=true;
			$this->errorMsg="No se definió titulo para el campo enviado";			
		}	  
	}
//---------------------------------------------------------------
	function ObtenerCodigoLog($operacion) {
		if (!isset($array_log[$operacion]))	{
			$this->error=true;
			$this->errorMsg="Error no existe la operación requerida";			
		}			
		return $this->logs[$operacion];
	}	
//---------------------------------------------------------------
	function ObtenerSPxClave(&$spnombre,&$spparam,$valor) {
		$spnombre= "sel_".$this->ObtenerNombreTabla()."_x".$this->ObtenerCampo('clave');
		$spparam = array('p'.$this->ObtenerCampo('clave')=>$valor);
	}
//---------------------------------------------------------------
	function TablaDescriptoresSP(&$spnombre,&$spparam)
	{
		$spnombre="sel_".$this->ObtenerNombreTabla();
		$spnombre.=($this->_EsTablaConEstado())?"_xestado":"";
		$spnombre.="_orden";
		
		$spparam = array('porderby'=>$this->ObtenerCampo('descripcion'));
		if($this->_EsTablaConEstado()) 		
			$spparam+=array('p'.$this->ObtenerCampo('estado')=>ESTADOACTIVO);
	}
//---------------------------------------------------------------
	// Hay que mandarle la conexion porque es una funcion de clase
	function CrearSubTipo($conexion,$subtipo,&$objTabla)	{
		switch ($subtipo) {
			case 'area_curso_inap':
				$objTabla = new cTablaAreaCursoInap($conexion);
				break;
			case 'programa_curso_inap':
				$objTabla = new cTablaProgramaCursoInap($conexion);
				break;
			case 'organismo_publico':
				$objTabla = new cTablaOrganismoPublico($conexion);
				break;
			case 'organismo_privado':
				$objTabla = new cTablaOrganismoPrivado($conexion);
				break;
			case 'sede':		
				$objTabla = new cTablaSede($conexion);
				break;
			case 'agente_funcion':
				$objTabla = new cTablaAgenteTipoFuncion($conexion);
				break;
			case 'tipo_inscripcion':
				$objTabla=new cTablaTipoInscripcion($conexion);
				break;
			case 'area_contextual':
				$objTabla=new cTablaAreaContextual($conexion);
				break;
			case 'area_general':
				$objTabla=new cTablaAreaGeneral($conexion);
				break;				
			case 'tipo_certificacion':
				$objTabla=new cTablaTipoCertificacion($conexion);
				break;				
			default: false;			
		}		
		return true;
	}	
//---------------------------------------------------------------
	function __PosibleBaja($valor_campo,&$error, &$error_mail) {
		// Redefinido en las tablas del sistema que evitan la baja 
		// bajo algún criterio.
		
		// Ejempo, no se puede dar baja lógica de areas contextuales,  
		// areas generales o específicas si existen datos de docentes,
		// primero se debieran redefinir los docentes a otras áreas.
		
		$error="";
		$error_mail="";
		return true;
	}
//---------------------------------------------------------------
	function __BajaCascada($valor_campo) {
		// Redefinido en las tablas del sistema requiern baja en otras tablas
		// bajo algún criterio.
	
		return true;
	}
//---------------------------------------------------------------
	function PosibleBajaFisica($valor_campo, &$error) {
		$error=false;
		foreach ($this->tabla_ref as $tabla) {	
			if(!$this->conexion->TraerCampo($tabla['nom_tabla'],$tabla['campo_tabla'],array($tabla['campo_tabla']."='",$valor_campo,"'"),$dato,$numfilas,$errno)) {
				$error=true;	
				return false;	
		    } elseif ($numfilas!=0) 
				return false;	
		}
		return true;
	}
//---------------------------------------------------------------
	function ValidarFormSysTabla() {
	?>
