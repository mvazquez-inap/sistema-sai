<?php class cTablaTipoCertificacion extends cTablaSysDesc {

	public function __construct($conexion) {
		
		$array_campos=array('clave'=> 'tipocert_codigo',
							'estado'=>'tipocert_estado',
							'descripcion'=>array('nombre_campo'=>'tipocert_descripcion', 'long_campo'=>100 ,'titulo_campo'=>'Tipo Certificación'),
							'fecha_alta'=>'tipocert_falta',
							'fecha_baja'=>'tipocert_fbaja');

		parent::__construct($conexion,"tipo_certificacion",$array_campos);
		$this->SetearTituloTabla('Tipo de Certificación');
	
		// Array con los cógigos de operaciones a ser registradas
		$array_log=array('ins'=>'35211', 'upd'=>'35213', 'del'=>'35212','chg_estado'=>'35214');
		$this->SetearLogs($array_log);

		// Array con las tablas en las que se busca para determinar si la baja es física o lógica.
		$this->SetearTablasTipoBaja(array(array('nom_tabla'=>'actividad_externa','campo_tabla'=>'tipocert_codigo')));
	}		
} ?>