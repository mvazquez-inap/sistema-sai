<?php
require('./include.dhtml');
// maxi 2
$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
//----------------------------------------------------------------------------------------- 
// accion  = Asignar 			---> //	 busco actividades ACTIVA (USUAUTODESARROLLO o USUACTEXT o USUACTINS)
// accion  = Dictaminar 		---> //	 busco actividades ACTIVA (USUAUTODESARROLLO o USUACTEXT)
// accion  = PedirAprobacion 	---> //	 busco actividades ACTIVA con Dictamen NUEVO o rechazado (USUAUTODESARROLLO)
//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccionPersonal($conexion,$ArregloDatos) {


	// Defino el filtro de búsqueda.
	switch ($_SESSION['array_busqueda_basica_actividad']['accion'] ) {
	case "Asignar" :
		switch ($_SESSION['rolcod']) {
			case USUACTEXT: 
				$ArregloDatos['actext_estado'] = ACTEXTERNAACTIVO;					
				break;
			case USUAUTODESARROLLO: 
				$ArregloDatos['actauto_estado'] = ACTAUTOACTIVO;					
				break;
		}
		break;

	case "Dictaminar":
		switch ($_SESSION['rolcod']) {
			case USUAUTODESARROLLO: 
			case SUPERUSUARIO: 
				$ArregloDatos['actauto_estado'] = ACTAUTOACTIVO;					
				break;
		}
		break;
	case "PedirAprobacion":
		switch ($_SESSION['rolcod']) {
			case USUAUTODESARROLLO: 
			$ArregloDatos['actauto_estado'] = ACTAUTOACTIVO;					
			break;
		}
		break;
	}		
		
    // Defino el proceso a realizar para la búsqueda
	switch ($_SESSION['rolcod']) {

		case USUACTEXT: 
			if ($_SESSION['array_busqueda_basica_actividad']['accion'] == "Asignar") {

				$ArregloDatos['formact_codigo'] = FORMATOEXT;
				$ArregloDatos['tipoact_codigo'] = TIPOACTEXTASIS; 
				$ArregloDatos['orderby'] = "act_nombre";

				$oActividad = new cActividadExterna($conexion);
				if(!$oActividad->BuscarActividadExterna($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;			
				}			
			}
			break;

		case USUAUTODESARROLLO: 
		case SUPERUSUARIO: 

			if  ($_SESSION['array_busqueda_basica_actividad']['accion'] == "Asignar") {

				$ArregloDatos['formact_codigo'] = FORMATOAUTO;
				$ArregloDatos['orderby'] = "act_nombre";

				if ($ArregloDatos['tipoact_codigo'] == "")
					$ArregloDatos['tipoact_codigo'] = TIPOACTAUTODOCENTE.",".TIPOACTAUTOEVACT.",".TIPOACTAUTOPUBLI.",".TIPOACTAUTOASISTEC.",".TIPOACTAUTOAAUTOFORM;

				$oActividad = new cActividadAutodesarrollo($conexion);
				if(!$oActividad->BuscarActividadAutodesarrollo($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;			
				}			
			}
			

			if ($_SESSION['array_busqueda_basica_actividad']['accion'] == "Dictaminar") {

				$ArregloDatos['formact_codigo'] = FORMATOAUTO;
				$ArregloDatos['orderby'] = "act_nombre";

				if ($ArregloDatos['tipoact_codigo'] == "")
					$ArregloDatos['tipoact_codigo'] = TIPOACTAUTODOCENTE.",".TIPOACTAUTOEVACT.",".TIPOACTAUTOPUBLI.",".TIPOACTAUTOASISTEC.",".TIPOACTAUTOAAUTOFORM;

				$oActividad = new cActividadAutodesarrolloPersona($conexion);

				// Actividad, persona , expediente  				
				// Personas asignadas con dictamen NUEVO o RECHAZADO
				// Personas asignadas sin dictamen 
				
				$numfilas=0;		
				if(!$oActividad->BuscarActividadAsignadaPersonaAvanzada ($ArregloDatos, $numfilas, $result, $error, $errormail)) {
					$txt_sys_mail = "\nformato=$formact_codigo";
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar las personas asignadas a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					return false;
				} 

			}

			if ($_SESSION['array_busqueda_basica_actividad']['accion'] == "PedirAprobacion") {
				$ArregloDatos['formact_codigo'] = FORMATOAUTO;
				$ArregloDatos['dic_estado'] = DICTAMENNUEVO.",".DICTAMENRECHAZADO;		
				$ArregloDatos['tipoact_codigo'] = TIPOACTAUTODOCENTE.",".TIPOACTAUTOEVACT.",".TIPOACTAUTOPUBLI.",".TIPOACTAUTOASISTEC.",".TIPOACTAUTOAAUTOFORM;
				$ArregloDatos['orderby'] = "act_nombre";		

				$oActividad = new cActividadAutodesarrollo($conexion);
				if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;			
				}	
			}
			break;
			
			
			
	}	
	
	if ($numfilas>=LIMITE_BUSQUEDA_CHICO) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda retornó demasiadas filas, ajuste el criterio de búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}

	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda no retornó resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}

	$array_result = array();
	$array_tipos = array();
	$spnombre="sel_tipo_actividad_xformact_codigo_orden";
	$spparam=array('pformact_codigo'=>FORMATOAUTO,'porderby'=>"tipoact_descripcion");
	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado_tipo,$numfilas,$errno))
		return false;

	while ($fila_tipo = mysqli_fetch_array($resultado_tipo)) {
		$array_tipos[$fila_tipo['tipoact_codigo']]=$fila_tipo['tipoact_descripcion'];
	}	
	
	while ($fila_result = mysqli_fetch_assoc($result)) {
		
		$fila_result['tipoact_descripcion'] = $array_tipos[$fila_result['tipoact_codigo']];
		$fila_result['pers_cuilt'] = "";
				
		if (!isset($fila_result['exp_numero']))
			 $fila_result['exp_numero'] = "";		
		if (isset($fila_result['pers_codigo'])) {
			if (!$conexion->TraerCampo("persona","pers_cuilt",array("pers_codigo='",$fila_result['pers_codigo'],"'"),$pers_cuilt,$numfilaspers,$errorcod)){ 
				$txt_sys_mail = "\npers_codigo=".$fila_result['pers_codigo'];
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al buscar el CUIL de la persona.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;		
			}
			$fila_result['pers_cuilt'] = $pers_cuilt;
		}
		$array_result[]=$fila_result;
	}
	
	
	$querystring = $_SERVER['QUERY_STRING'];

	$opciones=array(
		"numPagina"=>isset($_GET['pagina_1'])?$_GET['pagina_1']:1,
		"NombrePaginaQuery"=>"pagina_1",
		"FormularioBotonera"=>"formulario_boton_1",		
		"FilasPagina"=>10
	);
	
	if (isset($_GET['pagina_1']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina_1","",false);	
		$opciones['QueryString']=$querystring;
	}
	
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Código INAP');
	$oGrilla->Setear('campo_grilla',$miColumna1,'act_codinap');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	
	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna2,'act_nombre');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Tipo Actividad');
	$oGrilla->Setear('campo_grilla',$miColumna3,'tipoact_descripcion');
	$oGrilla->Setear('align_columna',$miColumna3,'left');

	if (($_SESSION['array_busqueda_basica_actividad']['accion'] == "PedirAprobacion") ||
		($_SESSION['array_busqueda_basica_actividad']['accion'] == "Dictaminar"))
	 {
		$miColumna5 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna5,'CUIT/CUIL/CDI');
		$oGrilla->Setear('campo_grilla',$miColumna5,'pers_cuilt');
		$oGrilla->Setear('align_columna',$miColumna5,'left');
	
		$miColumna6 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna6,'Expediente');
		$oGrilla->Setear('campo_grilla',$miColumna6,'exp_numero');
		$oGrilla->Setear('align_columna',$miColumna6,'left');
	}	

	$miColumna4 = $oGrilla->AddColumna('linkimg');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Seleccionar');
	$oGrilla->Setear('imagen',$miColumna4,'images/seleccionar.jpg');
	$oGrilla->Setear('altImagen',$miColumna4,'Seleccionar');
	$oGrilla->Setear('ancho_columna',$miColumna4,'60');
	$oGrilla->Setear('align_columna',$miColumna4,'center');
	$oGrilla->Setear('onClick_function',$miColumna4,"AddValorFormatoTipoProgPersonal");
	$oGrilla->Setear('url',$miColumna4,"#");
	$oGrilla->AddParametrosOnClick($miColumna4,"window.opener.document");
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['formulario']);
	$oGrilla->AddParametrosOnClick($miColumna4,'act_codigo',"var");
	$oGrilla->AddParametrosOnClick($miColumna4,$ArregloDatos['formact_codigo']);
	$oGrilla->AddParametrosOnClick($miColumna4,'tipoact_codigo',"var");
	$oGrilla->AddParametrosOnClick($miColumna4,'');	
	$oGrilla->AddParametrosOnClick($miColumna4,'pers_cuilt',"var");
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['act_codigo_seleccion']);
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['formact_codigo_seleccion']);
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['tipoact_codigo_seleccion']);
	$oGrilla->AddParametrosOnClick($miColumna4,'');
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['pers_cuilt']);
	

	if (!$oGrilla->CargarGrilla($array_result))
		return false;
		
	$oGrilla->MostrarGrilla();
} 		
//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccionNoPersonal($conexion,$ArregloDatos) {
	// Defino el filtro de búsqueda.
	switch ($_SESSION['array_busqueda_basica_actividad']['accion'] ) {
	
		case "Asignar" :
		case "AsignarExterna" :
			switch ($_SESSION['rolcod']) {
				case USUACTEXT:
					$ArregloDatos['actext_estado'] = ACTEXTERNAACTIVO;	
					break;
				case USUAUTODESARROLLO: 
					$ArregloDatos['actauto_estado'] = ACTAUTOACTIVO;	
					break;
				case USUACTINS: 
					$ArregloDatos['actauto_estado'] = ACTCURSOACTIVO;					
					break;
				case COORDINADORTECNICO:
				case USUORGANISMO: 
					$ArregloDatos['actext_estado'] = ACTEXTERNAACTIVO;	
					// ver
					//$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];	
					break;					
					
			}
			break;
			
		case "AsignarEducacionFormal" :			
			switch ($_SESSION['rolcod']) {
				case COORDINADORTECNICO:
				case USUORGANISMO: 
					$ArregloDatos['actform_estado'] = ACTFORMALACTIVO;	
					break;					
			}
			break;
		case "Dictaminar" :
			switch ($_SESSION['rolcod']) {
				case USUACTEXT: 
					$ArregloDatos['actext_estado'] = ACTEXTERNAACTIVO;	
					break;
				case USUAUTODESARROLLO: 
				case SUPERUSUARIO: 
					$ArregloDatos['actauto_estado'] = ACTAUTOACTIVO;	
					break;
			}
			break;			
			
		case "PedirAprobacion" :
			switch ($_SESSION['rolcod']) {
				case USUAUTODESARROLLO: 
					$ArregloDatos['actauto_estado'] = ACTAUTOACTIVO;	
					break;
			}
			break;

		case "AltaComision" :
			$ArregloDatos['actcur_estado'] = ACTCURSOACTIVO;	
			break;			
	}		

    // Defino el proceso a realizar para la búsqueda
	switch ($_SESSION['rolcod']) {

		case USUCURSOINAP: 
			switch ($_SESSION['array_busqueda_basica_actividad']['accion']) {			
				case "AltaComision":
					$ArregloDatos['formact_codigo'] = FORMATOCURSO;
					$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP;
					$ArregloDatos['orderby'] = "act_nombre asc, actprog_fecha_inicio desc";		

					$oActividad = new cActividadCurso($conexion);
					if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;								
					}	
					break;					
			} 	
			break; 
			
		case USUORGANISMO: 
		

			switch ($_SESSION['array_busqueda_basica_actividad']['accion']) {			
				case "AltaComision":
				
					$ArregloDatos['formact_codigo'] = FORMATOCURSO;
					$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;
					$ArregloDatos['orderby'] = "act_nombre asc, actprog_fecha_inicio desc";		

					$oActividad = new cActividadCurso($conexion);
					if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;	
					}	
					break;
					
					case "Asignar":
					
							$ArregloDatos['formact_codigo'] = FORMATOCURSO;
							$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINST; 
							$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
							
							$ArregloDatos['orderby'] = "act_nombre";
			
							$oActividad = new cActividadCursoInstitucional($conexion);
							if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;			
							}			
						break;		
				
					case "AsignarExterna":
					
							$ArregloDatos['formact_codigo'] = FORMATOEXT;
							$ArregloDatos['tipoact_codigo'] = TIPOACTEXTASIS; 
							$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
							$ArregloDatos['con_disposicion'] = 1;	
							
							$ArregloDatos['orderby'] = "act_nombre";
							$oActividad = new cActividadExterna($conexion);
							if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;			
							}			
						break;						
					case "AsignarEducacionFormal":
					
							$ArregloDatos['formact_codigo'] = FORMATOEFORMAL;
							$ArregloDatos['orderby'] = "act_nombre";
							$oActividad = new cActividadEducacionFormal($conexion);
							if(!$oActividad->BuscarActividadEducacionFormal($ArregloDatos,$numfilas,$result,$error,$errormail)){
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;			
							}			
						break;						
									
			} 
			break; 		
		
		case COORDINADORTECNICO: 



			switch ($_SESSION['array_busqueda_basica_actividad']['accion']) {			
				case "AltaComision":
				
					$ArregloDatos['formact_codigo'] = FORMATOCURSO;
					$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
					$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];		
					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOJURISD;
					$ArregloDatos['orderby'] = "act_nombre asc, actprog_fecha_inicio desc";		

					$oActividad = new cActividadCurso($conexion);
					if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;	
					}	
					break;
					
					case "Asignar":
					
							$ArregloDatos['formact_codigo'] = FORMATOCURSO;
							$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINST; 
							$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
							
							$ArregloDatos['orderby'] = "act_nombre";
							$oActividad = new cActividadCursoInstitucional($conexion);
							if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;			
							}			
						break;
						
					case "AsignarExterna":
							$ArregloDatos['formact_codigo'] = FORMATOEXT;
							$ArregloDatos['tipoact_codigo'] = TIPOACTEXTASIS; 
							$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
							$ArregloDatos['con_disposicion'] = 1;	
							
							$ArregloDatos['orderby'] = "act_nombre";
							$oActividad = new cActividadExterna($conexion);
							if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;			
							}		
						break;	
					case "AsignarEducacionFormal":
					
							$ArregloDatos['formact_codigo'] = FORMATOEFORMAL;
							$ArregloDatos['orderby'] = "act_nombre";
							$oActividad = new cActividadEducacionFormal($conexion);
							
							if(!$oActividad->BuscarActividadEducacionFormal($ArregloDatos,$numfilas,$result,$error,$errormail)){
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;			
							}			
						break;						
											
					
			} 
			

			break; 

		case USUACTEXT: 
			
			switch ($_SESSION['array_busqueda_basica_actividad']['accion']) {			

				case "Asignar":
					$ArregloDatos['formact_codigo'] = FORMATOEXT;
					$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
					$ArregloDatos['tipoact_codigo'] = TIPOACTEXTASIS;
					$ArregloDatos['con_disposicion'] = 1;								
					$ArregloDatos['orderby'] = "act_nombre";		

					$oActividad = new cActividadExterna($conexion);
					if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;			
				}			
				break;	
				case "AsignarExterna":
						$ArregloDatos['formact_codigo'] = FORMATOEXT;
						$ArregloDatos['tipoact_codigo'] = TIPOACTEXTASIS; 
						$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
						$ArregloDatos['con_disposicion'] = 1;	
						
						$ArregloDatos['orderby'] = "act_nombre";
						$oActividad = new cActividadExterna($conexion);
						if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							return false;			
						}		
					break;	

							
			}
			break;
			
		case USUAUTODESARROLLO: 
		case SUPERUSUARIO: 
		
			switch ($_SESSION['array_busqueda_basica_actividad']['accion']) {
			
				case "Asignar":
					$ArregloDatos['formact_codigo'] = FORMATOAUTO;
					$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
					$ArregloDatos['tipoact_codigo'] = TIPOACTAUTOEVASIS;
					$ArregloDatos['con_disposicion'] = 1;								
					$ArregloDatos['orderby'] = "act_nombre";		
										
					$oActividad = new cActividadAutodesarrollo($conexion);
					if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;			
					}			
					break;
					
				case "Dictaminar" :

					// Muestra todas las actividades de auto desarrollo			
					$ArregloDatos['formact_codigo'] = FORMATOAUTO;
					$ArregloDatos['tipoact_codigo'] = TIPOACTAUTOEVASIS;
					$ArregloDatos['orderby'] = "act_nombre";

					$oActividad = new cActividadAutodesarrollo($conexion);
					if(!$oActividad->BuscarActividadAutodesarrollo($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;			
					}			
					break; 	
					
				case "PedirAprobacion":
				
					$ArregloDatos['formact_codigo'] = FORMATOAUTO;
					$ArregloDatos['dic_estado'] = DICTAMENNUEVO.",".DICTAMENRECHAZADO;		
					$ArregloDatos['tipoact_codigo'] = TIPOACTAUTOEVASIS;
					$ArregloDatos['orderby'] = "act_nombre";		
					
					$oActividad = new cActividadAutodesarrollo($conexion);
					if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;			
					}	
					break;
			}	

		break;

		case USUACTINS: 
		
			if ($_SESSION['array_busqueda_basica_actividad']['accion'] == "Asignar") {

				$ArregloDatos['formact_codigo'] = FORMATOCURSO;
				$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINST; 
				$ArregloDatos['dic_estado'] = DICTAMENACTIVO;		
				
				$ArregloDatos['orderby'] = "act_nombre";

				$oActividad = new cActividadCursoInstitucional($conexion);
				if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;			
				}			
			}
			break;
		
	}	

	if ($numfilas >=LIMITE_BUSQUEDA_CHICO) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda retornó demasiadas filas, ajuste el criterio de búsqueda.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}
	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda no retornó resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}

	$array_result = array();
	$array_tipos = array();

	$spnombre="sel_tipo_actividad_orden";
	$spparam=array('porderby'=>"tipoact_descripcion");
	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado_tipo,$numfilas,$errno))
		return false;

	while ($fila_tipo = mysqli_fetch_array($resultado_tipo)) {
		$array_tipos[$fila_tipo['tipoact_codigo']]=$fila_tipo['tipoact_descripcion'];
	}	
	
	while ($fila_result = mysqli_fetch_array($result)) {
		$fila_result['tipoact_descripcion'] = $array_tipos[$fila_result['tipoact_codigo']];
		$array_result[]=$fila_result;
	}

	$opciones=array(
		"numPagina"=>isset($_GET['pagina_2'])?$_GET['pagina_2']:1,
		"NombrePaginaQuery"=>"pagina_2",
		"FormularioBotonera"=>"formulario_boton_2",				
		"FilasPagina"=>10
	);
	
	if (isset($_GET['pagina_2']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina_2","",false);	
		$opciones['QueryString']=$querystring;
	}

	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Código INAP');
	$oGrilla->Setear('campo_grilla',$miColumna1,'act_codinap');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	
	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna2,'act_nombre');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	if ($_SESSION['rolcod']==USUAUTODESARROLLO) {
		$miColumna3 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Tipo Actividad');
		$oGrilla->Setear('campo_grilla',$miColumna3,'tipoact_descripcion');
		$oGrilla->Setear('align_columna',$miColumna3,'left');
	}
	
	if ($_SESSION['array_busqueda_basica_actividad']['accion']=="Asignar" || 
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AltaComision" ||
		// agregado externa
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AsignarExterna") {

		// Cambio  formato fechas		
		$miColumna31 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna31,'Fecha Inicio');
		$oGrilla->Setear('ancho_columna',$miColumna31,'80');
		$oGrilla->Setear('campo_grilla',$miColumna31,'actprog_fecha_inicio_ddmmaaaa');
		$oGrilla->Setear('align_columna',$miColumna31,'left');

		// Cambio x formato fechas
		$miColumna32 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna32,'Fecha Fin');
		$oGrilla->Setear('ancho_columna',$miColumna32,'80');
		$oGrilla->Setear('campo_grilla',$miColumna32,'actprog_fecha_fin_ddmmaaaa');
		$oGrilla->Setear('align_columna',$miColumna32,'left');
	}

	$miColumna4 = $oGrilla->AddColumna('linkimg');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Seleccionar');
	$oGrilla->Setear('imagen',$miColumna4,'images/seleccionar.jpg');
	$oGrilla->Setear('altImagen',$miColumna4,'Seleccionar');
	$oGrilla->Setear('ancho_columna',$miColumna4,'60');
	$oGrilla->Setear('align_columna',$miColumna4,'center');

	if ($_SESSION['array_busqueda_basica_actividad']['accion']=="Asignar"	||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AsignarExterna"	||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="PedirAprobacion" ||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AltaComision") 		
		$oGrilla->Setear('onClick_function',$miColumna4,"AddValorFormatoTipoProg");

	if ($_SESSION['array_busqueda_basica_actividad']['accion']=="Dictaminar" ||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AsignarEducacionFormal")  
		$oGrilla->Setear('onClick_function',$miColumna4,"AddValorFormatoTipo");

	$oGrilla->Setear('url',$miColumna4,"#");

	$oGrilla->AddParametrosOnClick($miColumna4,"window.opener.document");
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['formulario']);
	$oGrilla->AddParametrosOnClick($miColumna4,'act_codigo',"var");
	$oGrilla->AddParametrosOnClick($miColumna4,$ArregloDatos['formact_codigo']);
	$oGrilla->AddParametrosOnClick($miColumna4,'tipoact_codigo',"var");

	if ($_SESSION['array_busqueda_basica_actividad']['accion']=="Asignar" ||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AsignarExterna"	||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="PedirAprobacion" ||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AltaComision") 
		$oGrilla->AddParametrosOnClick($miColumna4,'actprog_sec',"var");	
		
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['act_codigo_seleccion']);
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['formact_codigo_seleccion']);
	$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['tipoact_codigo_seleccion']);
		
	if ($_SESSION['array_busqueda_basica_actividad']['accion']=="Asignar" ||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AsignarExterna"	||	
		$_SESSION['array_busqueda_basica_actividad']['accion']=="PedirAprobacion" ||
		$_SESSION['array_busqueda_basica_actividad']['accion']=="AltaComision"	) 
		$oGrilla->AddParametrosOnClick($miColumna4,$_SESSION['array_busqueda_basica_actividad']['actprog_sec_seleccion']);

	if (!$oGrilla->CargarGrilla($array_result))
		return false;
		
	$oGrilla->MostrarGrilla();
} 		
