			</a>
	</div>
	<table width="100%" class="textoTablaDato">
		<tr> 
			<td> <?php
					if(!$conexion->ejecutarStoredProcedure("sel_prestador_institucional_xestado",array('ppresins_estado'=>ESTADOACTIVO,"porderby"=>"presins_nombre"),$result,$numfilas,$errno))	{
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar los prestadores institucionales. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						$error=true;					
					} else {
						$opciones=array(
							"numPagina"=>isset($_GET['paginaG1'])?$_GET['paginaG1']:1,
							"FilasPagina"=>$numfilas,
							"NombrePaginaQuery"=>"paginaG1"
						);
						
						if (isset($_GET['paginaG1']))	{
							$querystring=FuncionesPHPLocal::ArmarQueryString("paginaG1","",false);
							$opciones['QueryString']=$querystring;
						}
						
						$oGrilla = new cGrilla($opciones);
						$oGrilla->SetearTituloGrilla('Prestadores Institucionales: ');
						$oGrilla->SetearAnchoGrilla('90%');
						
						$miColumna1 = $oGrilla->AddColumna('txt');
						$oGrilla->Setear('titulo_columna',$miColumna1,'Nombre');
						$oGrilla->Setear('campo_grilla',$miColumna1,'presins_nombre');
						$oGrilla->Setear('align_columna',$miColumna1,'left');
		
						$miColumna2 = $oGrilla->AddColumna('linkimg');
						$oGrilla->Setear('titulo_columna',$miColumna2,'Editar');
						$oGrilla->Setear('ancho_columna',$miColumna2,'60');
						$oGrilla->Setear('url',$miColumna2,'prestador_institucional.dhtml');
						$oGrilla->Setear('imagen',$miColumna2,'images/editar.jpg');
						$oGrilla->Setear('altImagen',$miColumna2,'Editar');						
						$oGrilla->AddParametrosURL($miColumna2,"presins_codigo","presins_codigo");
						$oGrilla->AddParametrosURL($miColumna2,"operacion","M","cte");
		
						$miColumna3 = $oGrilla->AddColumna('linkimg');
						$oGrilla->Setear('titulo_columna',$miColumna3,'Eliminar');
						$oGrilla->Setear('ancho_columna',$miColumna3,'60');
						$oGrilla->Setear('url',$miColumna3,'prestador_institucional.dhtml');
						$oGrilla->Setear('imagen',$miColumna3,'images/borrar.jpg');
						$oGrilla->Setear('altImagen',$miColumna3,'Eliminar');
						$oGrilla->AddParametrosURL($miColumna3,"presins_codigo","presins_codigo");
						$oGrilla->AddParametrosURL($miColumna3,"operacion","B","cte");
		
						if ($oGrilla->CargarGrilla($result)) {
							$oGrilla->MostrarGrilla();					
						} else {
							$error=true;					
							$txt_sys_mail = "Error Grilla='".$oGrilla->GetError();
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar prestador institucional.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
						}		
				}		
	?>
			</td>
		</tr>	
	</table>	<br>
<?php	}


//------- DATOS DE UN REGISTRO
if ($result) { 	

	$fila_tabla=array();						//  NUEVO

	$es_modif = false;	
	if ($operacion == "M" || $operacion == "B") {	// BAJA o MODIFICACION

