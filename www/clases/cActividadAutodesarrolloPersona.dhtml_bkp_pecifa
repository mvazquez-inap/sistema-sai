	function _DatosValidosComunesActividadAutodesarrolloPersona ($datos,&$datosvalidados)	{

		$oPersonas = new cPersonas($this->conexion);
		$oAgentes = new cAgentes($this->conexion);

		$datosvalidados["datos_agente"]=array();

		if ($_SESSION['rolcod'] != USUAUTODESARROLLO) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error Ud. no tiene los permisos suficientes para realizar la operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		$datosvalidados['act_codigo']=$datos['act_codigo'];
		$datosvalidados['tipoact_codigo']=$datos['tipoact_codigo'];
		$datosvalidados['actprog_sec']=$datos['actprog_sec'];

		// La de inicio es menor que la de fin
		$fechainicio_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['actauto_act_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd');
		$fechafin_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['actauto_act_fecha_fin'],'dd/mm/aaaa','aaaa-mm-dd');
		$fechaincioinap="01/01/".ANOINICALINAP;
		$fechaincioinap_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($fechaincioinap,'dd/mm/aaaa','aaaa-mm-dd');


		// Fecha de Inicio - [actauto_act_fecha_inicio] - [OBLIG]
		if (trim($datos['actauto_act_fecha_inicio'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['actauto_act_fecha_inicio'],"FechaDDMMAAAA"))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de inicio no es vádida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// La fecha de inicio debe ser posterior a la de inicio INAP
		if ($fechainicio_AAAAMMDD < $fechaincioinap_AAAAMMDD)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de inicio debe ser mayor o igual a ".$fechaincioinap,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// Fecha de Inicio tiene que estar dentro de la programación para mero asistente
		if ($datos['tipoact_codigo'] == TIPOACTAUTOEVASIS) {
			if (!($fechainicio_AAAAMMDD >= $datos['actprog_fecha_inicio'] && $fechainicio_AAAAMMDD <= $datos['actprog_fecha_fin'])) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de inicio debe estar comprendida en la programación",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		 }

		// Fecha de fin - [actauto_act_fecha_fin] - [OBLIG]
		if (trim($datos['actauto_act_fecha_fin'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['actauto_act_fecha_fin'],"FechaDDMMAAAA"))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de fin no es vádida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// La fecha de fin debe ser posterior a la de inicio INAP
		if ($fechafin_AAAAMMDD < $fechaincioinap_AAAAMMDD) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de fin debe ser mayor o igual a ".$fechaincioinap,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// Fecha de fin tiene que estar dentro de la programación para mero asistente
		if ($datos['tipoact_codigo'] == TIPOACTAUTOEVASIS) {
			if (!($fechafin_AAAAMMDD >= $datos['actprog_fecha_inicio'] && $fechafin_AAAAMMDD <= $datos['actprog_fecha_fin'])) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de fin debe estar comprendida en la programación",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		 }

		// Fecha de Inicio >= Fecha de Fin
