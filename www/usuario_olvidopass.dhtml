<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,true); // Inicia session y borra todo

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$usuarios=new cUsuarios($conexion);

if(isset($_POST["submit"]))
{
	if($usuarios->OlvidoPassword($_POST['usuariocuit'],$_POST['usuarioemail'],$nuevapwd))
	{
		$subject=" ( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." ) - Nueva contraseña ";
		$texto="Su nueva contraseña para ingresar al sistema es: ".$nuevapwd;
	
		// Agrego cabeceras al mail
		$cabeceras = "Content-type: text/plain; charset=utf-8\r\n";
		$cabeceras .= "From: ".MAIL_SISTEMA_FROM;

		if(!mail($_POST['usuarioemail'],$subject,$texto,$cabeceras))
		{
			echo"<p>&nbsp;</p>";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al enviar el mail. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}	
	} // fin de se encontró el usuario
}
else
{ // se muestra el formulario
?>
<SCRIPT LANGUAGE="JavaScript" type="text/javascript">
function ValidarJS(formulario) 
{
	if (formulario.usuariocuit.value=="")
	{
		alert("Debe ingresar su CUIT / CUIL / CDI");
		formulario.usuariocuit.focus();
		return false;
	}
	else if(formulario.usuarioemail.value=="" || !ValidarContenido(formulario.usuarioemail.value,"Email"))
	{
		alert("Debe ingresar el eMail y debe tener un formato válido");
		formulario.usuarioemail.focus();
		return false;	
	}
	else
		return true;
}
</script>
<div align="right" style="width:100%">
	<a href="index.dhtml" class="linkFondoBlanco textoAclaraciones">Volver</a>
</div>

<form name="formulario" action="<?php echo htmlspecialchars ($_SERVER['PHP_SELF'],ENT_QUOTES) ?>" method="post">
<br><br><br>
<div align='center'>
<table width="500"  border="0" cellpadding="2" cellspacing="3" class="textoTablaDato">
  <tr>
	<td width="30%" align="left" class="textoEtiqueta">CUIT / CUIL / CDI</td>
	<td width="70%" align="left" class="colorFondoSeleccion"><input name="usuariocuit" type="text" class="textoInput" style="text-align:left" size="12" maxlength="11" ><div style='font-size: 3px;'>&nbsp;</div></td>
  </tr>    
  <tr>
	<td align="left" class="textoEtiqueta">Mail</td>
	<td align="left" class="colorFondoSeleccion"><input name="usuarioemail" type="text" class="textoInput" style="text-align:left" size="42" maxlength="100"><div style='font-size: 3px;'>&nbsp;</div></td>
  </tr>  
    <tr>
	<td colspan="2" class="textoTablaDato">
		<br />El sistema enviará una nueva password al mail indicado
	</td>
  </tr>    
</table>
<br />
<input type="submit" name="submit" class="botones" value="Enviar" onClick="return ValidarJS(formulario)">
</div>
</form>
<?php 
} // fin de mostrar el formulario
$oEncabezados->PieMenuEmergente(); 
?>
