	//---------------------------------------------------------------------------------------------------------------------
	function FuncionesCalculoCreditos() {	
	// Funciones Java que definen la maquinita (1) y (2) 
	// (1) Todos los tipos y formatos excepto autodesarrollo publicaciones
	// (2) Solo publicaciones
?>		
		var creditos_total=0;
		var total_base_creditos=0;			// Para publicaciones
		var porcentaje_base_creditos=0;		// Para publicaciones

		function ReCalculo_creditos(act_duracionhs,	pondtipopond_codigo_cal_pres,
									pondtipopond_codigo_int,pondtipopond_codigo_proc_eva,idAguarde) {
		
			var archivo="calculo_creditos_ajax.dhtml";		
			var datos="act_duracionhs="+act_duracionhs;
			datos+="&pondtipopond_codigo_cal_pres="+pondtipopond_codigo_cal_pres;
			datos+="&pondtipopond_codigo_int="+pondtipopond_codigo_int;
			datos+="&pondtipopond_codigo_proc_eva="+pondtipopond_codigo_proc_eva;
		
			var contenedor=document.getElementById(idAguarde);
			contenedor.innerHTML='Aguarde, recalculado los créditos...';
		
			var ajax=nuevoAjax();
			ajax.open("POST",archivo,true);
		
			ajax.onreadystatechange=function() {
				if (ajax.readyState==4) {	
					eval (ajax.responseText);
					contenedor.innerHTML="";
					SetearTexto('act_creditos',creditos_total);
				}
			}
			ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
			ajax.send(datos);		
		}
		//---------------------------------------------------------------------------------------------------------------------
		function ReCalculo_creditosPublicaciones(tipopart_codigo,escalaftramocod,escalafnivcod,pondtipopond_codigo_cal_pres,pondtipopond_codigo_int,pondtipopond_codigo_proc_eva,idAguarde) {
		
            
			var archivo="calculo_creditos_ajax.dhtml";		
			var datos="tipopart_codigo="+tipopart_codigo;
      		datos+="&escalaftramocod="+escalaftramocod;
			datos+="&escalafnivcod="+escalafnivcod;
			datos+="&pondtipopond_codigo_cal_pres="+pondtipopond_codigo_cal_pres;
			datos+="&pondtipopond_codigo_int="+pondtipopond_codigo_int;
			datos+="&pondtipopond_codigo_proc_eva="+pondtipopond_codigo_proc_eva;


			var contenedor=document.getElementById(idAguarde);
			contenedor.innerHTML='Aguarde, recalculado los créditos...';
		
			var ajax=nuevoAjax();
			ajax.open("POST",archivo,true);
		
			ajax.onreadystatechange=function() {
				if (ajax.readyState==4) {	
					eval (ajax.responseText);
					contenedor.innerHTML="";
					SetearTexto('act_creditos',creditos_total);
					SetearTexto('pondtipopart_total',total_base_creditos);
					SetearTexto('pondtipopart_porcentaje',porcentaje_base_creditos);
				}
			}
			ajax.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
			ajax.send(datos);		
				
		}
<?php 	}		
