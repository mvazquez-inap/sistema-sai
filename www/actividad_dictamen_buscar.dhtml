//------------------------------------------------------------------------------------------------
function DeterminoFormatoTipo(&$tipoact_codigo,&$formact_codigo,&$unico_formato,&$unico_tipo) {

	// Segun el rol de usuario se determina:
		// Si maneja un único formato y tipo, seteando ambas variables y dejando unico_formato=true 
		// y unico_tipo=true. 
		// Si maneja un único formato pero mas de un tipo solo se setea formact_codigo y 
		// unico_formato=true. 
		// En caso de manejar mas de un formato y mas de un tipo setea unico_formato=false y unico_tipo=false. 
	
	$tipoact_codigo="";
	$formact_codigo="";					
	$unico_formato=true;
	$unico_tipo=true;
	
	switch ($_SESSION['rolcod']) {
		case SUPERUSUARIO:
			$formact_codigo=FORMATOCURSO;
			$tipoact_codigo=TIPOACTCURSOINAP.",".TIPOACTCURSOJURISD.",".TIPOACTCURSOINST;
			$unico_tipo=false;
			break;
		case USUCURSOINAP:
			$formact_codigo=FORMATOCURSO;
			$tipoact_codigo=TIPOACTCURSOINAP;
			break;
		case USUACTINS:
			$formact_codigo=FORMATOCURSO;
			$tipoact_codigo=TIPOACTCURSOINST;
			break;
		case USUACTJUR:
			$formact_codigo=FORMATOCURSO;
			$tipoact_codigo=TIPOACTCURSOJURISD;
			break;
		case USUACTEXT:
			$formact_codigo=FORMATOEXT;
			$tipoact_codigo=TIPOACTEXTASIS;
			break;	
		case USUAUTODESARROLLO:
			$formact_codigo=FORMATOAUTO;
			$unico_tipo=false;									
			break;	
		case COORDINADORINAP:
			$unico_formato=false;		
			$unico_tipo=false;									
			break;	
	}				
}
//------------------------------------------------------------------------------------------------
if (isset($_POST['boton_filtrar'])) {

	$ok=true;	

	$_SESSION['filtro_busqueda']=array();
	$_SESSION['filtro_busqueda']['exp_numero']=trim($_POST['exp_numero']);
	$_SESSION['filtro_busqueda']['act_nombre']=trim($_POST['act_nombre']);
	$_SESSION['filtro_busqueda']['act_codinap']=trim($_POST['act_codinap']);

	if (isset($_POST['con_dispo'])) {
		if ($_POST['con_dispo']=='SI') {
			$_SESSION['filtro_busqueda']['con_disposicion']=1;
			if (isset($_POST['dis_numero'])) 
				$_SESSION['filtro_busqueda']['dis_numero']=trim($_POST['dis_numero']);
		} elseif ($_POST['con_dispo']=='NO') 
			$_SESSION['filtro_busqueda']['sin_disposicion']=1;
	}

   	if (isset($_POST['pers_cuilt']) && ($_POST['pers_cuilt']!="") ) {
		// Buscar el código de persona
		$oPersonas = new cPersonas($conexion);
		if(!$oPersonas->TraerDatosPersona($_POST["pers_cuilt"],$datospersona,$es_modif)) {
			$txt_sys_mail="\n pers_cuilt=".$_POST["pers_cuilt"];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar el dictamen personal.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
			$_SESSION['filtro_busqueda']['pers_codigo']=-1;
			$ok=false;	
		} elseif ($es_modif) {
				$_SESSION['filtro_busqueda']['pers_codigo']=$datospersona['pers_codigo'];
			} else {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"<br>La persona con CUIT/CUIL/CDI ".$_POST["pers_cuilt"]."<br> no se encuentra registrada en el sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$_SESSION['filtro_busqueda']['pers_codigo']=-1;
				$ok=false;	
			}
	}

   	if (isset($_POST['actprog_fecha_inicio'])) 
		$_SESSION['filtro_busqueda']['actprog_fecha_inicio']=FuncionesPHPLocal::ConvertirFecha($_POST['actprog_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd');
		
   	if (isset($_POST['actprog_fecha_fin'])) 
		$_SESSION['filtro_busqueda']['actprog_fecha_fin']=FuncionesPHPLocal::ConvertirFecha($_POST['actprog_fecha_fin'],'dd/mm/aaaa','aaaa-mm-dd');
	
	// Si los combos estan deshabilitados no vienen en el post.
	DeterminoFormatoTipo($tipoact_codigo,$formact_codigo,$unico_formato,$unico_tipo);	
	if ($unico_formato) 
		$_SESSION['filtro_busqueda']['formact_codigo']=$formact_codigo;
	else 
		$_SESSION['filtro_busqueda']['formact_codigo']=$_POST['formact_codigo'];

	if ($unico_tipo) 
		$_SESSION['filtro_busqueda']['tipoact_codigo']=$tipoact_codigo;
	else 
		$_SESSION['filtro_busqueda']['tipoact_codigo']=$_POST['tipoact_codigo'];


	// El Buscador de dictámenes solo lo tiene en cuenta para las actividades que son jurisdiccionales
	// que son accedidas por el enlace
	if ($_SESSION['rolcod']==USUACTJUR)
		$_SESSION['filtro_busqueda']['jurisdid_inap']=$_SESSION['jurisdid_inap'];
	
	$_SESSION['filtro_busqueda']['orderby']="act_nombre";
}			

if (isset($_POST['boton_filtrar']) || isset($_GET['pagina'])) { 

	switch ($_SESSION['filtro_busqueda']['formact_codigo']) {
		case FORMATOCURSO:
			$oActividad=new cActividadCurso($conexion);
			break;
		case FORMATOEXT:
			$oActividad=new cActividadExterna($conexion);
			break;
		case FORMATOAUTO:
			$oActividad=new cActividadAutodesarrollo($conexion);
			break;
	}		
	
?>	<table width="100%" class="textoTablaDato" align="center">
