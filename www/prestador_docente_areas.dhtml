//-----------------------------------------------------------------------------------------
function MostrarGrillaSeleccion($conexion,$modulo,$presdoc_codigo) {

	// Selecciono todos los relacionados
	$oPrestadorDocenteArea = new cPrestadorDocenteArea($conexion);
	$ArregloDatos= array();
	$ArregloDatos['presdoc_codigo']=$presdoc_codigo;
	$ArregloDatos['orderby']="areagen_descripcion, areaesp_descripcion";
		
	if(!$oPrestadorDocenteArea->BuscarPrestadorDocentexArea($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
		$txt_sys_mail="Error al seleccionar las áreas asociadas al prestador docente. error=".$error."\n presdoc=".$presdoc_codigo;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar las áreas asociadas al prestador docente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}

	$arrayresult=array();
	while ($fila=mysqli_fetch_assoc($resultado))	{
		$conexion->TraerCampo("area_general","areagen_descripcion",array("areagen_codigo='",$fila['areagen_codigo'],"'"),$areagendesc,$numfilasdesc,$errorcod);
		$conexion->TraerCampo("area_especifica","areaesp_descripcion",array("areagen_codigo='",$fila['areagen_codigo'],"' and areaesp_codigo='",$fila['areaesp_codigo'],"'"),$areaespdesc,$numfilasdesc,$errorcod);
		$fila+=array('areagen_descripcion'=>$areagendesc);
		$fila+=array('areaesp_descripcion'=>$areaespdesc);
		$arrayresult[]=$fila;
	}
		
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>$numfilas
	);
	
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla("Áreas Específicas del prestador Docente");
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,"Área General");
	$oGrilla->Setear('campo_grilla',$miColumna2,"areagen_descripcion");
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,"Área Específica");
	$oGrilla->Setear('campo_grilla',$miColumna3,"areaesp_descripcion");
	$oGrilla->Setear('align_columna',$miColumna3,'left');

	$miColumna4 = $oGrilla->AddColumna('linkimg');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Eliminar');
	$oGrilla->Setear('ancho_columna',$miColumna4,'60');
	$oGrilla->Setear('url',$miColumna4,$modulo);
	$oGrilla->Setear('imagen',$miColumna4,'images/borrar.jpg');
	$oGrilla->Setear('altImagen',$miColumna4,'Eliminar');
	$oGrilla->AddParametrosURL($miColumna4,"presdoc_codigo","presdoc_codigo");
	$oGrilla->AddParametrosURL($miColumna4,"areagen_codigo","areagen_codigo");
	$oGrilla->AddParametrosURL($miColumna4,"areaesp_codigo","areaesp_codigo");
	$oGrilla->AddParametrosURL($miColumna4,"operacion","B","cte");

	if (!$oGrilla->CargarGrilla($arrayresult))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
}
	
//----------------------------------------------------------------------------------------- 	
$filaprestador=array();
$filaprestador['presdoc_codigo']=(isset($_POST['presdoc_codigo']))?$_POST['presdoc_codigo']:"";

$ok=false;
//if ( isset($_GET['presdoc_codigo']) && isset($_GET['operacion'])=="B")
