//-----------------------------------------------------------------------------------------------------
	function BuscarActividadResumen($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxact_codinap'=>0);
		$sparam+=array('pxpoc_ano_desde'=>0);
		$sparam+=array('pxpoc_ano_hasta'=>0);
		$sparam+=array('pxdic_estado'=>0);

		$sparam+=array('pact_codinap'=>"");
		$sparam+=array('ppoc_ano_desde'=>"");
		$sparam+=array('ppoc_ano_hasta'=>"");
		$sparam+=array('pdic_estado'=>"");


		if (isset ($ArregloDatos['act_codinap']))
		{
			if ($ArregloDatos['act_codinap']!="")
			{
				$sparam['pact_codinap']= $ArregloDatos['act_codinap'];
				$sparam['pxact_codinap']= 1;
			}
		}

		if (isset ($ArregloDatos['poc_ano_desde']))
		{
			if ($ArregloDatos['poc_ano_desde']!="")
			{
				$sparam['ppoc_ano_desde']= $ArregloDatos['poc_ano_desde'];
				$sparam['pxpoc_ano_desde']= 1;
			}
		}

		if (isset ($ArregloDatos['poc_ano_hasta']))
		{
			if ($ArregloDatos['poc_ano_hasta']!="")
			{
				$sparam['ppoc_ano_hasta']= $ArregloDatos['poc_ano_hasta'];
				$sparam['pxpoc_ano_hasta']= 1;
			}
		}

		if (isset ($ArregloDatos['jurisdid_inap']))
		{
			if ($ArregloDatos['jurisdid_inap']!="")
			{
				$sparam['pjurisdid_inap']= $ArregloDatos['jurisdid_inap'];
				$sparam['pxjurisdid_inap']= 1;
			}
		}

		if (isset ($ArregloDatos['dic_estado']))
		{
			if ($ArregloDatos['dic_estado']!="")
			{
				$sparam['pdic_estado']= $ArregloDatos['dic_estado'];
				$sparam['pxdic_estado']= 1;
			}
		}
		$spnombre="sel_resumen_actividad_poc_xdatos";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el Actividad Resumen.";
			$errormail="Error al buscar el Actividad Resumen.".$errno;
			return false;
		}
		return true;
	}


//-----------------------------------------------------------------------------------------------------
	function BuscarActividadResumenPoc($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxact_codigo'=>0);
		$sparam+=array('pxpoc_ano_desde'=>0);
		$sparam+=array('pxpoc_ano_hasta'=>0);
		$sparam+=array('pxdic_estado'=>0);
		$sparam+=array('pxjurisdid_inap'=>0);



		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('ppoc_ano_desde'=>"");
		$sparam+=array('ppoc_ano_hasta'=>"");
		$sparam+=array('pdic_estado'=>"");
		$sparam+=array('pjurisdid_inap'=>"");



		if (isset ($ArregloDatos['act_codigo']))
		{
			if ($ArregloDatos['act_codigo']!="")
			{
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}

		if (isset ($ArregloDatos['poc_ano_desde']))
		{
			if ($ArregloDatos['poc_ano_desde']!="")
			{
				$sparam['ppoc_ano_desde']= $ArregloDatos['poc_ano_desde'];
				$sparam['pxpoc_ano_desde']= 1;
			}
		}

		if (isset ($ArregloDatos['poc_ano_hasta']))
		{
			if ($ArregloDatos['poc_ano_hasta']!="")
			{
				$sparam['ppoc_ano_hasta']= $ArregloDatos['poc_ano_hasta'];
				$sparam['pxpoc_ano_hasta']= 1;
			}
		}

		if (isset ($ArregloDatos['jurisdid_inap']))
		{
			if ($ArregloDatos['jurisdid_inap']!="")
			{
				$sparam['pjurisdid_inap']= $ArregloDatos['jurisdid_inap'];
				$sparam['pxjurisdid_inap']= 1;
			}
		}


		if (isset ($ArregloDatos['dic_estado']))
		{
			if ($ArregloDatos['dic_estado']!="")
			{
				$sparam['pdic_estado']= $ArregloDatos['dic_estado'];
				$sparam['pxdic_estado']= 1;
			}
		}

		$spnombre="sel_poc_resumen_actividad_poc_xdatos";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el POC de la Actividad Resumen.";
			$errormail="Error al buscar el POC de la Actividad Resumen.".$errno;
			return false;
		}
		return true;
	}

//-----------------------------------------------------------------------------------------------------
	function TienePermisoPedirAprobacion($act_codigo,$rolcod,$jurisdid) {

		// Valida el estado con rol y la jurisdicción
		if (!$this->TraerDatosActividadCurso($act_codigo,$fila_actividad_curso,$es_modif_act_curso))
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;
		if (!$es_modif_act_curso)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		if ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO) {
			 if ($fila_actividad_curso['jurisdid_inap'] == $jurisdid) {
					if ($fila_actividad_curso['actcur_estado'] == ACTCURSONUEVO || $fila_actividad_curso['actcur_estado'] == ACTCURSORECHAZADO)
						return true;
					else {
						$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), <br> no le permite realizar la operacion.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
						return false;
					}
			 } else {
 				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene acceso a la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para pedir la aprobación de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
//-----------------------------------------------------------------------------------------------------
	function PedirAprobacionActividadCursoJurisdiccional($act_codigo) {

		// Es la unica validación que se hace por eso no va a un Validar
		if (!$this->TienePermisoPedirAprobacion($act_codigo,$_SESSION['rolcod'],$_SESSION['jurisdid_inap']))
			return false;

		$spnombre="upd_actividad_curso_cambio_estado_xact_codigo";
		$spparam=array(
			'pactcur_estado'=>ACTCURSOPENDIENTEAPROBACION,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'pact_codigo'=> $act_codigo
			);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al ejecutar el pedido de aprobación de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function  ArmarMensajePedidoAprobacion($datos,&$mensaje) {

		$result = true;
		if(!$this->TraerDatosActividadCursoJurisdiccional($datos['act_codigo'],$filacurso,$es_modif))  {
			$errormail="\nact_codigo=".$datos['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$result =  false;
		}
		if ($result) {
			$mensaje = " Se ha solicitado la aprobación del Diseño de la siguiente actividad:\n";
			$mensaje .= " Nombre:   ".$filacurso['actividad']['act_nombre']."\n";
			$mensaje .= " Código INAP:   ".$filacurso['actividad']['act_codinap']."\n";	;
			$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filacurso['actividad_curso']['jurisdid_inap'],"'"),$jurisdnom,$numfilas,$errno);
			$mensaje .= " Organismo:   ".$jurisdnom."\n";
			$mensaje .= " Aclaraciones:   ".$datos['aclaracion_mail']."\n";	;
		}

		return $result;
	}
//-----------------------------------------------------------------------------------------------------
	function TienePermisoEvaluar($act_codigo,$rolcod,$jurisdid) {

		// Valida el estado con rol y la jurisdicción
		if (!$this->TraerDatosActividadCurso($act_codigo,$fila_actividad_curso,$es_modif_act_curso))
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;
		if (!$es_modif_act_curso)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error no existe la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		if ($rolcod == USUACTJUR) {
			 if ($fila_actividad_curso['jurisdid_inap'] == $jurisdid) {
				if ($fila_actividad_curso['actcur_estado'] == ACTCURSOPENDIENTEAPROBACION)
					return true;
				else {
					$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), <br>  no le permite realizar la operacion.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					return false;
				}
			} else {
 				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene acceso a la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para evaluar la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
//-----------------------------------------------------------------------------------------------------
	function EvaluarActividadCursoJurisdiccional($act_codigo,$operacion,$datos,&$datosvalidados) {

		// Es la unica validación que se hace por eso no va a un Validar
		if (!$this->TienePermisoEvaluar($act_codigo,$_SESSION['rolcod'],$_SESSION['jurisdid_inap']))
			return false;

		if ($operacion == "A") {
			$estado = ACTCURSOAPROBADO;
		} else {
			$estado = ACTCURSORECHAZADO;
		}

		$spnombre="upd_actividad_curso_cambio_estado_xact_codigo";
		$spparam=array(
			'pactcur_estado'=>$estado,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'pact_codigo'=> $act_codigo
			);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al ejecutar la evaluación de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if( trim($datos['aclaracion_mail']) != "") {

			// ver si cambio por traer solo historial
			if (!$this->TraerDatosActividadCursoJurisdiccional($act_codigo, $fila_actividad, $es_modif) )
				return false;

			$txt_sys_mail="\nact_codigo=".$act_codigo;
			if (!$es_modif)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, no existe la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}

			$spnombre="upd_actividad_curso_diseno_jurisdiccional_hist_evaluacion";
			$spparam=array(
				'pactdisjurisd_hist_evaluacion'=>($fila_actividad['actividad_curso_jurisdiccional']['actdisjurisd_hist_evaluacion']."\n----------- ".
										date("Y/m/d H:i:s")." ----------\n\n".
										$datos['aclaracion_mail']."\n"),
				'pultmodusuario'=>$_SESSION['usuariocod'],
				'pultmodfecha'=> date("Y/m/d H:i:s"),
				'pact_codigo'=>$act_codigo
			);

			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
			{
				$txt_sys_mail="Actualizando el historial de evaluaciones de \nact_codigo=".$act_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar el historial de la actividad jurisdiccional. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}	// if hay datos aclaratorios

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function  ArmarMensajeEvaluar($datos,$operacion,&$mensaje) {

		$result = true;
		if(!$this->TraerDatosActividadCursoJurisdiccional($datos['act_codigo'],$filacurso,$es_modif))  {
			$errormail="\nact_codigo=".$datos['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$result =  false;
		}
		if ($result) {

			if ($operacion=="A")
				$mensaje = " El diseño cumple con los requisitos establecidos por el INAP \n";
			else
				$mensaje = " El diseño no cumple con los requisitos establecidos por el INAP \n";

			$mensaje .= " Nombre:   ".$filacurso['actividad']['act_nombre']."\n";
			$mensaje .= " Código INAP:   ".$filacurso['actividad']['act_codinap']."\n";	;
			$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filacurso['actividad_curso']['jurisdid_inap'],"'"),$jurisdnom,$numfilas,$errno);
			$mensaje .= " Organismo:   ".$jurisdnom."\n";
			$mensaje .= " Aclaraciones:   ".$datos['aclaracion_mail']."\n";
		}

		return $result;
	}
