function MostrarDictamenes($conexion,$oActividad,$formact_codigo,$ArregloDatos,&$numfilas) {

	if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) 
		return false;		

	if($numfilas>LIMITE_BUSQUEDA_CHICO) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La b&uacute;squeda retorn&oacute; más de ".LIMITE_BUSQUEDA_CHICO." dict&aacute;menes, deber&aacute; acotarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;		
	}
	
	if($numfilas>0) {  

		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"FilasPagina"=>10,
			"NombrePaginaQuery"=>"pagina"
		);				

		while ($fila_dictamen = mysqli_fetch_assoc($resultDictamenes)) {  
				$tipoact_descripcion="";
				$conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_dictamen['tipoact_codigo'],"'"),$tipoact_descripcion,$numfilas,$errorcod); 
		
				$fila_dictamen['formact_codigo']=$formact_codigo;
				$fila_dictamen['tipoact_descripcion']=$tipoact_descripcion;
				
				if( $formact_codigo==FORMATOAUTO && $ArregloDatos['tipoact_codigo']!=TIPOACTAUTOEVASIS) { 
					$oPersonas = new cPersonas($conexion);
					$oPersonas->TraerDatosPersona_xCod($fila_dictamen["pers_codigo"],$datos_personales,$es_modif);
					$destinatario=htmlspecialchars($datos_personales['pers_apellido'],ENT_QUOTES).", ".htmlspecialchars($datos_personales['pers_nombre'],ENT_QUOTES)." (".htmlspecialchars($datos_personales['pers_cuilt'],ENT_QUOTES).")";
					$fila_dictamen['destinatario']=$destinatario;
				}
			 	$array_dictamenes[]=$fila_dictamen;
		} 
		
		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla('Dictámenes Buscados ');
		$oGrilla->SetearAnchoGrilla('95%');

		$miColumna0 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna0,'Expediente');
		$oGrilla->Setear('campo_grilla',$miColumna0,'exp_numero');
		$oGrilla->Setear('align_columna',$miColumna0,'left');

		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'Código INAP');
		$oGrilla->Setear('campo_grilla',$miColumna1,'act_codinap');
		$oGrilla->Setear('align_columna',$miColumna1,'left');

		$miColumna2 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Actividad');
		$oGrilla->Setear('campo_grilla',$miColumna2,'act_nombre');					
		$oGrilla->Setear('align_columna',$miColumna2,'left');
		
		
		if ($formact_codigo!=FORMATOAUTO || ($formact_codigo==FORMATOAUTO && $ArregloDatos['tipoact_codigo']==TIPOACTAUTOEVASIS) ) {

/*			$miColumna3 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna3,'Vigencia Desde');
			$oGrilla->Setear('campo_grilla',$miColumna3,'actprog_fecha_inicio');
			$oGrilla->Setear('align_columna',$miColumna3,'left');
			$oGrilla->Setear('ancho_columna',$miColumna3,'80');
*/
			$miColumna3 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna3,'Vigencia Desde');
			$oGrilla->Setear('campo_grilla',$miColumna3,'actprog_fecha_inicio_ddmmaaaa');
			$oGrilla->Setear('align_columna',$miColumna3,'left');
			$oGrilla->Setear('ancho_columna',$miColumna3,'80');

	
/*			$miColumna4 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna4,'Vigencia Hasta' );
			$oGrilla->Setear('campo_grilla',$miColumna4,'actprog_fecha_fin');
			$oGrilla->Setear('align_columna',$miColumna4,'left');
			$oGrilla->Setear('ancho_columna',$miColumna4,'80');
*/

			$miColumna4 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna4,'Vigencia Hasta' );
			$oGrilla->Setear('campo_grilla',$miColumna4,'actprog_fecha_fin_ddmmaaaa');
			$oGrilla->Setear('align_columna',$miColumna4,'left');
			$oGrilla->Setear('ancho_columna',$miColumna4,'80');
	
		
		} else {
	
			$miColumna3 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna3,'Destinatario');
			$oGrilla->Setear('campo_grilla',$miColumna3,'destinatario');					
			$oGrilla->Setear('align_columna',$miColumna3,'left');
		}

		$miColumna5 = $oGrilla->AddColumna('popup');
		$oGrilla->Setear('ancho_columna',$miColumna5,'60');
		$oGrilla->Setear('imagen',$miColumna5,'images/verdetalle.gif');
		$oGrilla->Setear('altImagen',$miColumna5,'Ver detalle Dictamen');		
		$oGrilla->Setear('titulo_columna',$miColumna5,'Detalle');
		$oGrilla->Setear('url',$miColumna5,'dictamen_ver_detalle.dhtml');
		$oGrilla->Setear('ventanaAnchoPopup',$miColumna5,'850');
		$oGrilla->Setear('ventanaAltoPopup',$miColumna5,'580');
		$oGrilla->Setear('ventanaVarxPopup',$miColumna5,'130');
		$oGrilla->Setear('ventanaVaryPopup',$miColumna5,'50');
		$oGrilla->AddParametrosURL($miColumna5,"dic_codigo",'dic_codigo');
		$oGrilla->AddParametrosURL($miColumna5,"formact_codigo",'formact_codigo');
		$oGrilla->AddParametrosURL($miColumna5,"tipoact_codigo",'tipoact_codigo');

		if ($oGrilla->CargarGrilla($array_dictamenes)) {
			$oGrilla->MostrarGrilla();					
		} else {
			$txt_sys_mail = "Error Grilla='".$oGrilla->GetError();
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar los dictámenes solicitados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
			return false;
		}		
		
	}  else 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se encontraron dict&aacute;menes, que cumplan con la condición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	
	return true;
} 
