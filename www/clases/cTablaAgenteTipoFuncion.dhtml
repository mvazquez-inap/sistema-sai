<?php class cTablaAgenteTipoFuncion extends cTablaSysDesc {

	public function __construct($conexion) {
		
		$array_campos=array('clave'=> 'agfunc_codigo',
							'estado'=>'agfunc_estado',
							'descripcion'=>array('nombre_campo'=>'agfunc_descripcion', 'long_campo'=>255 ,'titulo_campo'=>'Tipo de Función del Agente'),
							'fecha_alta'=>'agfunc_falta',
							'fecha_baja'=>'agfunc_fbaja');

		parent::__construct($conexion,"agente_funcion",$array_campos);
		$this->SetearTituloTabla('Tipo de función del agente');
	
		// Array con los cógigos de operaciones a ser registradas
		$array_log=array('ins'=>'35401', 'upd'=>'35403', 'del'=>'35402','chg_estado'=>'35404');
		$this->SetearLogs($array_log);
	
		// Array con las tablas en las que se busca para determinar si la baja es física o lógica.
		$array_tablas[]=array('nom_tabla'=>'agente','campo_tabla'=>'agfunc_codigo');
		$array_tablas[]=array('nom_tabla'=>'comision_persona','campo_tabla'=>'agfunc_codigo');
		$array_tablas[]=array('nom_tabla'=>'actividad_externa_persona','campo_tabla'=>'agfunc_codigo');
		$array_tablas[]=array('nom_tabla'=>'actividad_autodesarrollo_persona','campo_tabla'=>'agfunc_codigo');
		$this->SetearTablasTipoBaja($array_tablas);		
	}		
} ?>