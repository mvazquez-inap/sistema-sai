	</tr>
	<tr>
		<td valign="top" class="textoEtiqueta">Apellido</td>
		<td class="textoEtiquetaDatoResaltado"><input type="text" name="usuarioapellido" id="usuarioapellido" onblur="PasarAMayusculas('usuarioapellido')" size="32" maxlength="30" class='textoInput' value="<?php echo htmlspecialchars($filausuario['usuarioapellido'],ENT_QUOTES); ?>"></td>
	</tr>
	<tr>
		<td valign="top"  width="25%" class="textoEtiqueta">Nombre</td>		
		<td class="textoEtiquetaDatoResaltado"><input type="text" name="usuarionombre" id="usuarionombre" size="32" maxlength="30"  onblur="PasarAMayusculas('usuarionombre')" class='textoInput' value="<?php echo htmlspecialchars($filausuario['usuarionombre'],ENT_QUOTES); ?>"></td>
	</tr>
	<tr>
		<td valign="top" class="textoEtiqueta">Email</td>
		<td class="textoEtiquetaDatoResaltado"><input type="text" name="usuarioemail" size="32"  maxlength="100" value="<?php echo htmlspecialchars($filausuario['usuarioemail'],ENT_QUOTES); ?>"></td>
	</tr> 	
	<tr align="center">
	  	<td colspan="2" valign="top">
			<input type="submit" name="boton_modificar" class="botones" value="Confirma Actualización" onClick="return Validar(formulario);">&nbsp;&nbsp;&nbsp;&nbsp;
	  	</td>
    </tr>	
</table>
