									<a href='javascript:void(0)' onClick="Popup('prestador_docente_area_selector.dhtml?destino=area_con_gen_esp&amp;texto=area_con_gen_esp_texto','ventana_area_espcifica',540,250,screen.availWidth-560,screen.availHeight-310,'yes');" title="Seleccionar Área Específica"><img src="images/versai.jpg" border="0" style="vertical-align:-5px" alt="Seleccionar Área Específica"></a>
									<input name="area_con_gen_esp" id="area_con_gen_esp" type="hidden" class="textoinput" value="">
<?php 									} ?>								
								<span id="area_con_gen_esp_texto">
			<?php						$texto_salida="";											
									if($operacion=="B") {
										$areaEspecifica= new cTablaAreaEspecifica($conexion);
										$areaEspecifica->TraerDatosCompletosAreaEspecifica($_GET['areagen_codigo'],$_GET['areaesp_codigo'],$texto_salida);
									}	
