<?php

} else {

?>
	<form action="actividad_selector.dhtml" name="formulario"  id="formulario" method="post">
	<table width="100%" class="textoTablaDato" align="center">
		<tr>
			<td width="25%"></td>
			<td width="65%"></td>
		</tr>
		<tr>
			<td class="textoEtiqueta">Código INAP</td>
			<td class="textoEtiquetaDatoResaltado"><input type="text" name="act_codinap"  id="act_codinap"class="textoInput" onBlur="PasarAMayusculas('act_codinap')"maxlength="20" size="20"></td>
		</tr>
		<tr>
			<td class="textoEtiqueta">Nombre</td>
			<td class="textoEtiquetaDatoResaltado">	<input type="text" name="act_nombre"  id="act_nombre" class="textoInput" onBlur="PasarAMayusculas('act_nombre')" maxlength="255" size="30"></td>
		</tr>
		<tr>
			<td colspan="2" height="20"></td>
		</tr>
		<tr align="center">
			<td colspan="2">
				<input type="hidden" name="formulario" value="<?php echo (isset($_GET['formulario']))?$_GET['formulario']:$_SESSION['array_busqueda_basica_actividad']['formulario']?>" >
				<input type="hidden" name="destino" value="<?php echo (isset($_GET['destino']))?$_GET['destino']:$_SESSION['array_busqueda_basica_actividad']['destino']?>" >
				<input type="hidden" name="submit" value="<?php echo (isset($_GET['submit']))?$_GET['submit']:$_SESSION['array_busqueda_basica_actividad']['submit']?>" >
				<input type="hidden" name="tipoact_codigo" value="<?php echo (isset($_GET['tipoact_codigo']))?$_GET['tipoact_codigo']:$_SESSION['array_busqueda_basica_actividad']['tipoact_codigo'] ?>" >
				<input type="hidden" name="accion" value="<?php echo (isset($_GET['accion']))?$_GET['accion']:$_SESSION['array_busqueda_basica_actividad']['accion']?>" >
				<input type="submit" name="boton_buscar" class="botones" value="Buscar Actividad" onClick="return Validar(formulario)">
				&nbsp;&nbsp;&nbsp;&nbsp;
				<input type="reset" name="boton_limpiar" class="botones" value="Limpiar">
			</td>
		</tr>

	</table>
	</form>
	<?php
} // se seleccionó buscar
