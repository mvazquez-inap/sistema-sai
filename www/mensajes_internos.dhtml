                        <td class='textoEtiqueta' width="20%" align="left">Fecha</td>
                      <td colspan="2" class="textoEtiquetaDatoResaltado" align="left"><?php echo date("d/m/Y H:i",strtotime($fila_mensaje['msg_fecha']))?></td>  
