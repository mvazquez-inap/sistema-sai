	function CambiaTipoActividad(tipoact_codigo) {
		var elSelect = document.getElementById('datos_evento');
		if ((tipoact_codigo == <?php echo TIPOACTAUTOEVASIS?> )|| (tipoact_codigo == <?php echo TIPOACTAUTOEVACT?>)) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";		
		}		
	}
</script>
