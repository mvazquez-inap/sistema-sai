//----------------------------------------------------------------------------------------- 	
	function MostrarGrillaNoEditable($conexion,$modulo,$poc_codigo,$poc_estado="") {
		$oPocActividad= new cPocActividad($conexion);
		$ArregloDatos= array();
		$ArregloDatos['pocact_estado'] = POCACTIVIDADAPROBADA.",".POCACTIVIDADPEDAPROB;
		$ArregloDatos['orderby'] = "pocact_nombre_tentativo";
		$ArregloDatos['poc_codigo']=$poc_codigo;	
		if (!$oPocActividad->BuscarPocActividad($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\npoc_codigo_".$poc_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		}
		$i=0;
		while ($filaresult=mysqli_fetch_assoc($result))
		{
			$arrayresult[$i]['pocact_codigo']= $filaresult['pocact_codigo'];
			$arrayresult[$i]['pocact_nombre_tentativo']= $filaresult['pocact_nombre_tentativo'];
			$arrayresult[$i]['poctipopres_codigo']= $filaresult['poctipopres_codigo'];
			$arrayresult[$i]['pocact_estado']= $filaresult['pocact_estado'];
			$conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","POCACTIVIDADESTADO","' and constantecod='",$filaresult['pocact_estado'],"'"),$caracterdesc,$numfilascaracter,$errorcod);
			$arrayresult[$i]['pocact_estado']= $caracterdesc;
			$arrayresult[$i]['poc_codigo']= $filaresult['poc_codigo'];
			$i++;
		}
		if ($numfilas ==0) {
			return true;			
		}
		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"NombrePaginaQuery"=>"pagina",
			"FilasPagina"=>10
		);
		if (isset($_GET['pagina']))	{
			$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
			$opciones['QueryString']=$querystring;
		}
		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla('Actividades No Editables');	
		$oGrilla->SetearAnchoGrilla('90%');
		
		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'Actividad');
		$oGrilla->Setear('ancho_columna',$miColumna1,'70%');
		$oGrilla->Setear('campo_grilla',$miColumna1,'pocact_nombre_tentativo');
		$oGrilla->Setear('align_columna',$miColumna1,'left');
		
		$miColumna2 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Estado');
		$oGrilla->Setear('ancho_columna',$miColumna2,'30%');
		$oGrilla->Setear('campo_grilla',$miColumna2,'pocact_estado');
		$oGrilla->Setear('align_columna',$miColumna2,'center');
		
		if (!$oGrilla->CargarGrilla($arrayresult))
			return false;
		$oGrilla->MostrarGrilla();
		return true;
	} 		
//----------------------------------------------------------------------------------------- 	
	function MostrarGrillaSeleccion($conexion,$modulo,$poc_codigo,$poc_estado="") {
		$oPocActividad= new cPocActividad($conexion);
		$ArregloDatos= array();
		$ArregloDatos['pocact_estado'] = POCACTIVIDADNUEVA.",".POCACTIVIDADRECHAZADA;
		$ArregloDatos['orderby'] = "pocact_nombre_tentativo";
		$ArregloDatos['poc_codigo']=$poc_codigo;	
		if (!$oPocActividad->BuscarPocActividad($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\npoc_codigo_".$poc_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		}
		$i=0;
		while ($filaresult=mysqli_fetch_assoc($result))
		{
			$arrayresult[$i]['pocact_codigo']= $filaresult['pocact_codigo'];
			$arrayresult[$i]['pocact_nombre_tentativo']= $filaresult['pocact_nombre_tentativo'];
			$arrayresult[$i]['poctipopres_codigo']= $filaresult['poctipopres_codigo'];
			$arrayresult[$i]['pocact_estado']= $filaresult['pocact_estado'];
			$arrayresult[$i]['poc_codigo']= $filaresult['poc_codigo'];
			$i++;
		}
		if ($numfilas ==0) {
			return true;			
		}
		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"NombrePaginaQuery"=>"pagina",
			"FilasPagina"=>10
		);
		if (isset($_GET['pagina']))	{
			$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
			$opciones['QueryString']=$querystring;
		}
		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla('Actividades Editables');	
		$oGrilla->SetearAnchoGrilla('90%');
		
		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'Actividad');
		$oGrilla->Setear('campo_grilla',$miColumna1,'pocact_nombre_tentativo');
		$oGrilla->Setear('align_columna',$miColumna1,'left');
		
		$miColumna3 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Editar');
		$oGrilla->Setear('ancho_columna',$miColumna3,'60');
		$oGrilla->Setear('url',$miColumna3,$modulo);
		$oGrilla->Setear('url_ancla',$miColumna3,'Edicion');
		$oGrilla->Setear('imagen',$miColumna3,'images/editar.jpg');
		$oGrilla->Setear('altImagen',$miColumna3,'Editar');						
		$oGrilla->AddParametrosURL($miColumna3,"poc_codigo","poc_codigo");
		$oGrilla->AddParametrosURL($miColumna3,"pocact_codigo","pocact_codigo");
		$oGrilla->AddParametrosURL($miColumna3,"operacion","M","cte");

		$miColumna4 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('titulo_columna',$miColumna4,'Eliminar');
		$oGrilla->Setear('ancho_columna',$miColumna4,'60');
		$oGrilla->Setear('url',$miColumna4,$modulo);
		$oGrilla->Setear('url_ancla',$miColumna4,'Edicion');
		$oGrilla->Setear('imagen',$miColumna4,'images/borrar.jpg');
		$oGrilla->Setear('altImagen',$miColumna4,'Eliminar');
		$oGrilla->AddParametrosURL($miColumna4,"poc_codigo","poc_codigo");
		$oGrilla->AddParametrosURL($miColumna4,"pocact_codigo","pocact_codigo");
		$oGrilla->AddParametrosURL($miColumna4,"operacion","B","cte");

		if (!$oGrilla->CargarGrilla($arrayresult))
			return false;
		$oGrilla->MostrarGrilla();
		return true;
	} 		
//--------------------------------------------------------------------------------------------------
?>
