//----------------------------------------------------------------------------------------- 
//                                FUNCIONES PRIVADAS
//----------------------------------------------------------------------------------------- 
// Agrega en el nodo del padre, un array con todos los IDs de sus hijos. 
// Si por la cantidad de niveles solicitados corresponde, agrega la información general de cada uno de sus hijos
// y se llama a si misma

// Parámetros de Entrada:
//		IDBusq: ID del padre
//		CantNiveles: No incluye a la jurisdicción mencionada en IDBusq. (CantNiveles=1 retornaría el primer nivel de hijos)
//		TipoOrgID: Si el nodo hijo no es raiz de un tipo de organismo, entonces utiliza el tipo de organismo de su padre
//		ParamBusq: se usan pjurisdestado, pjurisdorden. No se usa pjurisdlimit.

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no
//		DestinoInterno: un array con el resultado

//ojo TipoOrg function _HijosDe($IDBusq,$CantNiveles,$TipoOrgid,$ParamBusq,&$DestinoInterno,&$NumFilas,&$CodError)
//MODIFICADA
	function _HijosDe($IDBusq,$CantNiveles,$ParamBusq,&$DestinoInterno,&$NumFilas,&$CodError)
	{
		$spnombre="selc_jurisdicciones_xjurisdsuperior";
		$spparam=array("codtabla1"=>$this->versiontabla,"codtabla2"=>$this->versiontabla,"pversionid"=>$this->versionid,"pjurisdsuperior"=>$IDBusq);


		if(isset($ParamBusq["pincluirbajas"]) && $ParamBusq["pincluirbajas"])
			$spparam+=array("pjurisdfbaja_filtro"=>0);
		else
			$spparam+=array("pjurisdfbaja_filtro"=>1);

		if(isset($ParamBusq["pjurisdorden"]))
			$spparam+=array("porderby"=>$ParamBusq["pjurisdorden"]);
		else
			$spparam+=array("porderby"=>GENERAL_JURISDORDEN);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultadosalida,$NumFilasHijos,$CodError))
			return false;

		$CantNiveles--;
		
		while($filahijos=mysqli_fetch_assoc($resultadosalida))
		{
			$DestinoInterno[$IDBusq]["IDHijos"][]=$filahijos["jurisdid"];
			if($CantNiveles>=0)
			{
				
				//----------------------------------------------------------------------//
				//AGREGADO PARA VER EL TIPO DE ORGANISMO Y PONER EL NIVEL.
				if(!$this->SelectTipoOrgxID($filahijos["torgid"],$ParamBusq,TABGRALES_TS_ARRAY,$PrimerNodoTipo,array(),$NumFilasTipoOrg,$CodError))
					return false;
				
				if($NumFilasTipoOrg==0)
				{
					$subjectmail="";
					if(defined('SISTEMAMOSTRAR'))
						$subjectmail=SISTEMAMOSTRAR;
					elseif(defined('SISTEMA'))
						$subjectmail=SISTEMA;				
					$subjectmail.=" - Error en el sistema";
					$textomail ="Se produjo un error: \n";
					$textomail.="Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n\n";
					$textomail.="Se recibió un Tipo Id no válido (".$PrimerNodo[$IDBusq]['torgid'].") en SubArbolDependiente.";
		
					FuncionesPHP::MandarMail($this->conexion,$this->conexion->admigeneral,"",$subjectmail,$textomail);
					return false;
				}	
				
				$filahijos["torgnivel"]=$PrimerNodoTipo[$filahijos["torgid"]]['torgnivel'];
				//----------------------------------------------------------------------//
				
				$DestinoInterno[$filahijos["jurisdid"]]=$filahijos;
				$DestinoInterno[$filahijos["jurisdid"]]["IDHijos"]=array();
				$NumFilas++;
				
/*				if(!$this->EsRaiz($filahijos["jurisdid"],$ParamBusq,TABGRALES_TS_ARRAY,$SalidaTO,$RaizSiNo,array(),$CodError))
					return false;*/
				
/*				if($filahijos["jurisdarboltiponodo"]!="H")
				{*/
					if(!$this->_HijosDe($filahijos["jurisdid"],$CantNiveles,$ParamBusq,$DestinoInterno,$NumFilas,$CodError))
						return false;
//				}
			}
		}

		return true;
	}

//----------------------------------------------------------------------------------------- 
// Retorna todos los datos de la jurisdicción buscada y todas las superiores, 
// 	hasta llegar al arbolnivel igual a 1 o llegar a CantNiveles=0


// Parámetros de Entrada:
//		IDBusq: Contiene el ID de la jurisdicción a buscar.
//		CantNiveles: Utilizada como una de las condiciones de corte. (CantNiveles=0 corta el ciclo)
//		ParamBusq: no se utilizan específicamente, pero si en funciones llamadas.
//		ParamSalida: se usan conexion, nombretabla en caso que la salida sea en cursor

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no
//		DestinoInterno: un array con el resultado
//		ELIMINADO TipoOrg: en caso que el nodo no sea raiz de arbol, utiliza este dato para asignar el tipo de organismo al nodo
//MODIFICADA	
	function _RamaAscendente($IDBusq,$CantNiveles,$ParamBusq,&$DestinoInterno,&$NumFilas,&$CodError)
	{

		if(!$this->SelectJurisdxID($IDBusq,$ParamBusq,TABGRALES_TS_ARRAY,$JurisdBuscada,array(),$NumFilasJB,$CodError))
			return false;

		if($NumFilasJB!=1)
			return false;
		
		$FilaJurisd=$JurisdBuscada[$IDBusq];
		
		if($FilaJurisd["jurisdsuperior"]==$IDBusq) // Es el padre de si mismo. No debería suceder.
			return false;
		
		$DestinoInterno[]=$JurisdBuscada[$IDBusq];

		if(!$this->BuscarTipoOrg($IDBusq,array(),TABGRALES_TS_ARRAY,$TOrgBuscada,array(),$CodError))
			return false;

		$NumFilas++;
		
		$CondicionCorte=($TOrgBuscada["torgnivel"]<=1 || $CantNiveles<=0);
		
		if(!$CondicionCorte)
		{
			if(!$this->_RamaAscendente($FilaJurisd["jurisdsuperior"],$CantNiveles-1,$ParamBusq,$DestinoInterno,$NumFilas,$CodError))
				return false;
		}

		return true;
	}

//----------------------------------------------------------------------------------------- 
// Genera una tabla temporal con todos los campos de la tabla de jurisdicciones mas el tipo de organismo 

// Parámetros de Entrada:
//		conexion: la conexión con la base de datos sobre la cual va a quedar la tabla temporal
//		nombretabla: el nombre con el que se va a generar la tabla temporal

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no

//MODIFICADA		
//PEND: Actualizar a la ultima version de la tabla, eliminar constraint
	function _CrearJurisdTemp($conexion,$nombretabla,&$CodError)
	{

		$sql="
			CREATE TEMPORARY TABLE IF NOT EXISTS `".$nombretabla."` (
				  `versionid` int(10) unsigned NOT NULL default '0',
				  `jurisdid` mediumint(8) unsigned NOT NULL default '0',
				  `torgid` int(10) unsigned NOT NULL default '0',
				  `jurisdnom` varchar(150) default NULL,
				  `jurisdcod01` varchar(28) default NULL,
				  `jurisdsuperior` mediumint(8) unsigned default '0',
				  `jurisdfalta` datetime default NULL,
				  `jurisdfbaja` datetime default NULL,
				  `jurisdorden` mediumint(8) NOT NULL default '0',
				  `jurisdobj` text,
				  `jurisdrespprim` text,
				  `jurisdacciones` text,
				  `versionidinicial` int(10) unsigned NOT NULL default '0',
				  `ultmodusuario` int(10) unsigned NOT NULL default '0',
				  `ultmodfecha` datetime default NULL,
			  PRIMARY KEY  (`versionid`,`jurisdid`),
			  KEY `jurisdsuperior` (`versionid`,`jurisdsuperior`),
			  KEY `versionid` (`versionid`,`torgid`),
			  KEY `versionidinicial` (`versionidinicial`)
			) TYPE=InnoDB COMMENT='Jurisdicciones Temporal';
			";

		if(!mysqli_query($conexion, $sql))
		{
			$CodError=mysqli_errno($conexion);

			$subjectmail="";
			if(defined('SISTEMAMOSTRAR'))
				$subjectmail=SISTEMAMOSTRAR;
			elseif(defined('SISTEMA'))
				$subjectmail=SISTEMA;				
			$subjectmail.=" - Error en el sistema";
			$textomail ="Se produjo un error: \n";
			$textomail.="Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n\n";
			$textomail.="No se pudo crear Tabla Jurisdicciones Temporal \n";
			$textomail.="Conexión      ".$conexion." \n";
			$textomail.="Nombre tabla  ".$nombretabla." \n";
			$textomail.="Error MySql   ".$CodError." - ".mysqli_error($conexion)." \n";

			FuncionesPHP::MandarMail($this->conexion,$this->conexion->admigeneral,"",$subjectmail,$textomail);
		
			return false;
		}
		
		return true;
	}
