					<span class='textoEtiqueta'><?php echo $fila['areaesp_descripcion']; ?></span>
					<br><br><?php MostrarGrillaSeleccion($conexion,$fila['areacon_codigo'],$fila['areagen_codigo'],$fila['areaesp_codigo']); ?>
