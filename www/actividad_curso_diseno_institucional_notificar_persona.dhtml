		$act_seleccionada_ok = false;
	} 
	if (!$es_modif) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error la Persona no se encuentra en el sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$act_seleccionada_ok = false;
	} 
	$pers_cuilt=$datospersona['pers_cuilt'];
	
    $act_seleccionada_ok = true; 
	// ver de agregar md5 con clave
} 
