			$txt_sys_mail="\ndic_codigo=".$datos['dic_codigo'];		
			if (!$es_modif)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, no existe el dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			} 

			$spnombre="upd_dictamen_hist_evaluacion_xdic_codigo";
			$spparam=array(
				'pdic_hist_evaluacion'=>($fila_dictamen['dic_hist_evaluacion']."\n----------- ".
										date("Y/m/d H:i:s")." ----------\n\n".
										$datos['aclaracion_mail']."\n"),
				'pultmodusuario'=>$_SESSION['usuariocod'],
				'pultmodfecha'=> date("Y/m/d H:i:s"),
				'pdic_codigo'=>$datos['dic_codigo']
			);
			
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
			{
				$txt_sys_mail="Actualizando el historial de evaluaciones de \ndic_codigo=".$datos['dic_codigo'];		
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar la evaluación del dictamen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}	
		}	// if hay datos aclaratorios
	*/
		return true;
	}

//-----------------------------------------------------------------------------------------------------	
	function EvaluarDictamen($datos,$operacion) {
		
		if ($datos['tipoact_codigo'] == TIPOACTAUTODOCENTE || 
			$datos['tipoact_codigo'] == TIPOACTAUTOEVACT ||
			$datos['tipoact_codigo'] == TIPOACTAUTOPUBLI ||
			$datos['tipoact_codigo'] == TIPOACTAUTOASISTEC ||
			$datos['tipoact_codigo'] == TIPOACTAUTOAAUTOFORM 		
			) {
			
			if(!$this->_DatosValidosEvaluarDictamenPersonal ($datos))
				return false;
			
		} else {
			if(!$this->_DatosValidosEvaluarDictamen($datos))
				return false;
		}
	
		if ($operacion == "A") 
			$estado = DICTAMENACTIVO;
		else 
			$estado = DICTAMENRECHAZADO;	
		
		$spnombre="upd_dictamen_cambio_estado_xdic_codigo";
		$spparam=array(
			'pdic_estado'=>$estado,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'pdic_codigo'=>$datos['dic_codigo']
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar la evaluación del dictamen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	


		if 	($estado == DICTAMENRECHAZADO) 
		{
			$spnombre="upd_dictamen_visado_limpieza_xdic_codigo";
			$spparam=array(
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'pdic_codigo'=>$datos['dic_codigo']
			);
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar la evaluación del dictamen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}	
	
		}




		if( trim($datos['aclaracion_mail']) != "") {
			
			if (!$this->TraerDatosDictamen($datos['dic_codigo'], $fila_dictamen, $es_modif) ) 
				return false;

			$txt_sys_mail="\ndic_codigo=".$datos['dic_codigo'];		
			if (!$es_modif)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, no existe el dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			} 

			$spnombre="upd_dictamen_hist_evaluacion_xdic_codigo";
			$spparam=array(
				'pdic_hist_evaluacion'=>($fila_dictamen['dic_hist_evaluacion']."\n----------- ".
										date("Y/m/d H:i:s")." ----------\n\n".
										$datos['aclaracion_mail']."\n"),
				'pultmodusuario'=>$_SESSION['usuariocod'],
				'pultmodfecha'=> date("Y/m/d H:i:s"),
				'pdic_codigo'=>$datos['dic_codigo']
			);
			
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
			{
				$txt_sys_mail="Actualizando el historial de evaluaciones de \ndic_codigo=".$datos['dic_codigo'];		
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar la evaluación del dictamen. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}	
		}	// if hay datos aclaratorios
	
		return true;
	}

