<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
//----------------------------------------------------------------------------------------- 	
$oUsuario=new cUsuarios($conexion);
// Inicio de pantalla

$ArregloDatos['usuariocod']=$_GET['usuariocod'];
if(!$oUsuario->BuscarUsuarios($ArregloDatos,$numfilasusuarios,$resultadousuarios,$error,$errormail) || $numfilasusuarios!=1)
{
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	die();
}
$filausuario=mysqli_fetch_assoc($resultadousuarios);

$result=true;

$conexion->ManejoTransacciones("B");

if (($result) && (isset ($_POST['usuarioemail'])) && ($_POST['usuarioemail']!=""))
{
	$datos['usuarionombre']=$filausuario['usuarionombre'];
	$datos['usuarioapellido']=$filausuario['usuarioapellido'];
	$datos['usuariocuit']=$filausuario['usuarioCUIT'];
	$datos['usuarioemail']=$_POST['usuarioemail'];
	$email=$_POST['usuarioemail'];
	
	if(!$oUsuario->ModificarUsuario($filausuario['usuariocod'],$datos,$error))
	{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Imposible modificar Email.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result=false;
	}

} elseif ($_POST['usuarioemail']=="")
	$email=$filausuario['usuarioemail'];

if($result)
{
	if(!$oUsuario->RehabilitarUsuario($filausuario['usuarioCUIT'],$email,$nuevapwd,$error,$msgcorrecto))
	{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result=false;
	}
	if ($result)
	{
		$cabeceras = "Content-type: text/plain; charset=utf-8\r\n";
		$cabeceras .= "From: ".MAIL_SISTEMA_FROM;

		$subject=SISTEMA." - Rehabilitación de Usuario";
		$texto="Usted fue Rehabilitado en el Sistema de Seguimiento de Actividades\n\n";
		$texto.="Su contraseña para ingresar es: ".$nuevapwd;
		
		if(!mail($email,$subject,$texto,$cabeceras)) {
			echo"<p>&nbsp;</p>";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al enviar el mail. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}	
	}	

if($result) 	{
	$conexion->ManejoTransacciones("C");
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,$msgcorrecto,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se Rehabilitó el usuario seleccionado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	FuncionesPHPLocal::RegistrarAcceso($conexion,"33804","usuariocod=".$_GET["usuariocod"],$_SESSION['usuariocod']);

} 	else 	
	$conexion->ManejoTransacciones("R");
} 

?>		<br><br><div align="center"><a href="usuario_rehabilitar.dhtml" class="linkFondoBlanco">Volver</a></div>
<?php

$oEncabezados->PieMenuEmergente();
?>
