//----------------------------------------------------------------------------------------- 
class cObjetosDinamicos
{
	var $msg_error;
	var $pagina;
	var $es_admin;
	
	function cObjetosDinamicos($es_admin=false)
	{
		$this->msg_error = "";
		$this->es_admin = $es_admin;
	}

	function Setear($parametros)
	{
		$this->pagina=$parametros["pagina"];
		return true;
	}
	
	function Mostrar($codigohtml,&$salida)
	{
		$salida="";
		$seprodujoerror=false;

		$partes=array();
		cSepararHTML::ProcesarHTML($codigohtml,$partes);

		foreach($partes as $comando)		
		{
			// si es un comando
			if(is_array($comando))
			{
				// si no existe la clase para dar soporte al comando
				if(!class_exists($comando["Tipo"]))
				{
					$this->msg_error.="Clase ".$comando["Tipo"]." no encontrada";
					return false;
				}
				else
				{
					$componente=new $comando["Tipo"]($this->es_admin);
					if($componente->Setear($comando+array("pagina"=>$this->pagina)))
					{
						if(!$componente->Mostrar($salida))
							$seprodujoerror=true;
					}
					else
						$seprodujoerror=true;
						
					$this->msg_error.=$componente->RetornarMsgError();
				}
			}
			else
				$salida.=$comando;
		}

		return !$seprodujoerror;
	}
}

//----------------------------------------------------------------------------------------- 
class cFecha
{
	var $msg_error;
	var $es_admin;

	function cFecha($es_admin=false)
	{
		$this->msg_error = "";
		$this->es_admin = $es_admin;
	}
	
	function Setear($parametros)
	{
		return true;
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		
		putenv("TZ=America/Argentina/Buenos_Aires");
		
		$texto = date("H:i - l d \d\e F \d\e Y"); 

		$texto=ReemplazarTextoFechas($texto);
		
		$salida.=$texto;
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}
	
}

//----------------------------------------------------------------------------------------- 
class cFechaIngles
{
	var $msg_error;
	var $es_admin;

	function cFechaIngles($es_admin=false)
	{
		$this->msg_error = "";
		$this->es_admin = $es_admin;
	}
	
	function Setear($parametros)
	{
		return true;
	}
	
	function Mostrar(&$salida)
	{
		$seprodujoerror=false;

		$texto = date("l, F d, Y h:i A"); 
		
		$salida.=$texto;
		
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}
	
}


