						<td valign="top" width="25%" class='textoEtiqueta'>Nombre</td>
						<td class="textoEtiquetaDatoResaltado">
						<textarea cols="100" rows="2" class="inputReadonly" readonly="readonly" name="act_nombre"  id="act_nombre"  style="width:400px" ><?php echo htmlspecialchars($filaauto['act_nombre'],ENT_QUOTES); ?></textarea>
						</td>
