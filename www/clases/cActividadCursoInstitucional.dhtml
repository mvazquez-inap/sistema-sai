	function DescargarExcelDisenoActividad($act_codigo, &$oExcel, $nuevo_excel=true) {	

		 if (!$this->TraerDatosActividadCursoInstitucional($act_codigo,$filacurso,$es_modif)) {
		 	FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pueden obtener los datos de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		 }									

		if ($nuevo_excel) {
			$nombrearchivo="actividad.xls";  
			$oExcel= new cEscribirExcel($nombrearchivo);
		}	
		
		$oExcel->AddHoja('Actividad');
		$ancho_columna['leyenda']=30;
		$ancho_columna['valor']=70;

		$oExcel->FormatoColumna (0,$ancho_columna['leyenda']); 
		$oExcel->FormatoColumna (1,$ancho_columna['valor']); 				

		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor",22);
		$oExcel->CargarDatosVariasCeldas (0,0,0,1,'Detalle de la Actividad Curso Institucional',true);
				
		// Titulos de las columnas
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");

		$arrayclaves=array('leyenda','valor');

		$array_datos[0]['leyenda'] = "Actividad";
		$array_datos[0]['valor'] = $filacurso['actividad']['act_nombre'];
		$array_datos[1]['leyenda'] = "Código de Actividad";
		$array_datos[1]['valor'] = $filacurso['actividad']['act_codinap'];

		$oExcel->BorrarFormato("");	
		$oExcel->AddFormato ("Tamaño",8);
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","gris");
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("VAlign","vcenter");
		$formato_leyenda=$oExcel->GetFormato(); 	
		
		$oExcel->BorrarFormato("");
		$oExcel->AddFormato ("Tamaño",8);
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("TextWrap","");
		$oExcel->AddFormato ("FgColor","blanco");
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("VAlign","vcenter");
		$formato_dato=$oExcel->GetFormato(); 	

		foreach ($arrayclaves as $clave => $valor) {	
			if ($valor == 'leyenda')
	 			$arrayformato[$valor]=$formato_leyenda;
			else 
	 			$arrayformato[$valor]=$formato_dato;
		}

		$array_datos[2]['leyenda'] = "Fundamentación";
		$array_datos[2]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_fundamentacion'];
		$array_datos[3]['leyenda'] = "Perfil del participante";
		$array_datos[3]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_perfil'];
		$array_datos[4]['leyenda'] = "Objetivos";
		$array_datos[4]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_objetivos'];
		$array_datos[5]['leyenda'] = "Contenido";
		$array_datos[5]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_contenido'];
		$array_datos[6]['leyenda'] = "Evaluación de los aprendizajes";
		$array_datos[6]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_eval'];
		$array_datos[7]['leyenda'] = "Requisitos de Asistencia y aprobación";
		$array_datos[7]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_requiaprobacion'];
		$array_datos[8]['leyenda'] = "Fecha";
		$array_datos[8]['valor'] = FuncionesPHPLocal::ConvertirFecha($filacurso['actividad_curso_institucional']['actdisinst_fecha'],'aaaa-mm-dd','dd/mm/aaaa');
		$array_datos[9]['leyenda'] = "Duración (Hs.)";
		$array_datos[9]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_duracionhs'];
		$array_datos[10]['leyenda'] = "Detalle sobre la duración";
		$array_datos[10]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_duraciondetalle'];

		// País
		if (!$this->conexion->TraerCampo("paises","paisnom",array("paiscod='",$filacurso['actividad_curso_institucional']['pais_codigo'],"'"),$descri_pais,$numfilas,$errorcod)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado el país.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$array_datos[11]['leyenda'] = "País";
		$array_datos[11]['valor'] = $descri_pais;

		// Provincia
		if (!$this->conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$filacurso['actividad_curso_institucional']['prov_codigo'],"'"),$descri_prov,$numfilas,$errorcod)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la provincia.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$array_datos[12]['leyenda'] = "Provincia";
		$array_datos[12]['valor'] = $descri_prov;

		$array_datos[13]['leyenda'] = "Ciudad / Dirección";
		$array_datos[13]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_direccion'];

		if (!$this->ObtenerOrganismoInstitucion($filacurso['actividad_curso_institucional']['orgapri_codigo'],
												$filacurso['actividad_curso_institucional']['jurisdid_apn'],
												$filacurso['actividad_curso_institucional']['orgapub_codigo'],				
												$jurisdnom,$sector_org,$tipoorg_codigo,$jurisdid)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al obtener el tipo de organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		if ($sector_org==ORGANISMO_PUBLICO) 
			$array_datos[14]['leyenda'] = "Organismo Público";
		else 
			if ($sector_org==ORGANISMO_PRIVADO) 
				$array_datos[14]['leyenda'] = "Organismo Privado";
		
		$array_datos[14]['valor'] = $jurisdnom;


		$array_datos[15]['leyenda'] = "Metodología";
		$array_datos[15]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_metodologia'];
		$array_datos[16]['leyenda'] = "Bibliografía";
		$array_datos[16]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_bibliografia'];
		$array_datos[17]['leyenda'] = "Perfil Instructor";
		$array_datos[17]['valor'] = $filacurso['actividad_curso_institucional']['actdisinst_perfil_instructor'];


		$fila_datos = array();
		
		foreach ($array_datos as $i => $valor) {
			$fila_datos['leyenda'] = $array_datos[$i]['leyenda'];
			$fila_datos['valor'] = $array_datos[$i]['valor'];
			// Saco los /r que no se lo banca el excel. 
			$fila_datos['valor']=str_replace("\r\n","\n", $array_datos[$i]['valor']);
			$oExcel->CargarGrilla ($fila_datos,2+$i,0,$arrayclaves,$arrayformato);	
		}	
		
		if ($nuevo_excel) 
			$oExcel->Enviar();			
	
	}		
//-----------------------------------------------------------------------------------------------------	
	function _AguparDatosPost($datos,&$datos_agrup,$es_modif)	{

		//-----------------------------------------------------------
		$datos_agrup['actividad']=array('act_codinap'=>$datos['act_codinap'],
										'act_nombre'=>$datos['act_nombre'],
										'act_obs'=>$datos['act_obs']);
		if ($es_modif)
			$datos_agrup['actividad']+=array('act_codigo'=>$datos['act_codigo']);
		else 
			$datos_agrup['actividad']+=array('formact_codigo'=>FORMATOCURSO);	

		//-------------------------------------------------------------
		$datos_agrup['actividad_curso']=array('actcur_obs'=>$datos['actcur_obs']);		
		if ($es_modif)
			$datos_agrup['actividad_curso']+=array('act_codigo'=>$datos['act_codigo']);
		else {
		 	$datos_agrup['actividad_curso']+=array('tipoact_codigo'=>TIPOACTCURSOINST);
		 	$datos_agrup['actividad_curso']+=array('actcur_creditos'=>0);
			$datos_agrup['actividad_curso']+=array('jurisdid_inap'=>0);
			$datos_agrup['actividad_curso']+=array('actcur_estado'=>ACTCURSOACTIVO);
		}						
		//--------------------------------------------------------------
		$datos_agrup['actividad_curso_institucional']=array(
						  'actdisinst_fundamentacion'=>$datos['actdisinst_fundamentacion'],
						  'actdisinst_perfil'=>$datos['actdisinst_perfil'],
						  'actdisinst_objetivos'=>$datos["actdisinst_objetivos"],
						  'actdisinst_contenido'=>$datos['actdisinst_contenido'],
						  'actdisinst_eval'=>$datos['actdisinst_eval'],
						  'actdisinst_requiaprobacion'=>$datos['actdisinst_requiaprobacion'],
  						  'actdisinst_fecha'=>$datos['actdisinst_fecha'],
						  'actdisinst_duracionhs'=>$datos['actdisinst_duracionhs'],
						  'actdisinst_duraciondetalle'=>$datos['actdisinst_duraciondetalle'],
						  'pais_codigo'=>$datos['pais_codigo'],
						  'prov_codigo'=>$datos['prov_codigo'],
						  'actdisinst_direccion'=>$datos['actdisinst_direccion'],
						  'tipoorg_codigo'=>$datos['tipoorg_codigo'],
						  'tipo_institucion'=>$datos['tipo_institucion'], 
						  'orgapri_codigo'=>($datos['tipo_institucion'] == ORGANISMO_PRIVADO)?$datos['orgapri_codigo']:"NULL",
						  'jurisdid_apn'=>( ($datos['tipo_institucion'] == ORGANISMO_PUBLICO) && ($datos['tipoorg_codigo']==ORGANISMO_APN))?$datos['jurisdid']:"NULL",
						  'orgapub_codigo'=>( ($datos['tipo_institucion'] == ORGANISMO_PUBLICO) && ($datos['tipoorg_codigo']==ORGANISMO_NO_APN))?$datos['jurisdid']:"NULL",
						  
						  'actdisinst_metodologia'=>$datos['actdisinst_metodologia'],
						  'actdisinst_bibliografia'=>$datos['actdisinst_bibliografia'],
						  'actdisinst_perfil_instructor'=>$datos['actdisinst_perfil_instructor']
		);		
	
		if ($es_modif)
			$datos_agrup['actividad_curso_institucional']+=array('act_codigo'=>$datos['act_codigo']);
		else {
		 	$datos_agrup['actividad_curso_institucional']+=array('actdisinst_duracionhs'=>0);
		}
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAltaActividadCursoInstitucional($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->_DatosValidosComunesActividadCursoInstitucional($datos,$datosvalidados))
		   return false; 

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosEliminarActividadCursoInstitucional($act_codigo,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoBaja($act_codigo,$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false; 
		}
	
		$tipook=$this->EsActividadCursoTipo($act_codigo,TIPOACTCURSOINST,$error,$errormsg);
		if ($error) {
			$errormail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif(!$tipook) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		$datosvalidados['act_codigo'] = $act_codigo;

		// Verificar que la actividad no tenga dictamen.
		$oDictamen = new cDictamen($this->conexion);
		$ArregloDatos=array();
		$ArregloDatos=array('act_codigo'=>$act_codigo);
		$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
		if ($error)  {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif ($numfilas>0) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La actividad no puede ser modificada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;			
		}

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifActividadCursoInstitucional($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->TienePermisoModificar($datos['act_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
			return false; 
		}

		if (!$this->_DatosValidosComunesActividadCursoInstitucional($datos,$datosvalidados))
		   return false; 
		
		$tipook=$this->EsActividadCursoTipo($datos['act_codigo'],TIPOACTCURSOINST,$error,$errormsg);
		if ($error) {
			$errormail="\nact_codigo=".$datos['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif(!$tipook) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		
		$datosvalidados+=array('act_codigo'=>$datos['act_codigo']);
		
		// Verificar que la actividad no tenga dictamen.
		$oDictamen = new cDictamen($this->conexion);
		$ArregloDatos=array();
		$ArregloDatos=array('act_codigo'=>$datos['act_codigo']);
		$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
		if ($error)  {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif ($numfilas>0) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La actividad no puede ser modificada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;			
		}

		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosComunesActividadCursoInstitucional($datos,&$datosvalidados)	{

		$datosvalidados=array();

		// Fundamentación 					- [actdisinst_fundamentacion] 	- [OPCIONAL]
		$datosvalidados["actdisinst_fundamentacion"]=$datos["actdisinst_fundamentacion"];

		// Perfil del participante 			- [actdisinst_perfil] 			- [OBLIG]
		if (trim($datos['actdisinst_perfil']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el perfil de los participantes de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisinst_perfil"]=$datos["actdisinst_perfil"];

		// Objetivos 						- [actdisinst_objetivos] 		- [OPCIONAL]
		$datosvalidados["actdisinst_objetivos"]=$datos["actdisinst_objetivos"];

		// Contenido 						- [actdisinst_contenido] 		- [OBLIG]
		if (trim($datos['actdisinst_contenido']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar los contenido de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisinst_contenido"]=$datos["actdisinst_contenido"];

		// Metodologia							- [actdisinst_metodologia] 			- [OBLIG]
		if (trim($datos['actdisinst_metodologia']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar las estrategias metodológicas y recursos didácticos",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisinst_metodologia"]=$datos["actdisinst_metodologia"];

		// Evaluación de los aprendizajes 	- [actdisinst_eval] 			- [OBLIG]
		if (trim($datos['actdisinst_eval']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la evaluación de los aprendizajes de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisinst_eval"]=$datos["actdisinst_eval"];

		// Requisitos de Asistencia y aprobación			- [actdisinst_requiaprobacion] 	- [OBLIG]
		if (trim($datos['actdisinst_requiaprobacion']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar los requisitos de Asistencia y aprobación de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisinst_requiaprobacion"]=$datos["actdisinst_requiaprobacion"];

		// Fecha valida
		if (trim($datos['actdisinst_fecha'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['actdisinst_fecha'],"FechaDDMMAAAA"))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha no es vádida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$fechanac_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['actdisinst_fecha'],'dd/mm/aaaa','aaaa-mm-dd');
		$datosvalidados["actdisinst_fecha"]=$fechanac_AAAAMMDD;
				
		// Duración	en horas 				- [actdisinst_duracionhs] 	- [OBLIG]
		if (!FuncionesPHPLocal::ValidarContenido($this->conexion, $datos['actdisinst_duracionhs'],'NumericoEntero') || $datos['actdisinst_duracionhs'] <=0 ) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La duración en hs. de la Actividad debe ser un número entero mayor que cero.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisinst_duracionhs"]=$datos["actdisinst_duracionhs"];

		// Detalle sobre la duración	 	- [actdisinst_duraciondetalle] 	- [OPCIONAL]
		$datosvalidados["actdisinst_duraciondetalle"]=$datos["actdisinst_duraciondetalle"];


		// Bibliografia 							- [actdisinst_bibliografia] 			- [OBLIG]
		if (trim($datos['actdisinst_bibliografia']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar la Bibliografía.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisinst_bibliografia"]=$datos["actdisinst_bibliografia"];
		
		// Perfil del Instructor 							- [actdisinst_perfil_instructor] 			- [OBLIG]
		if (trim($datos['actdisinst_perfil_instructor']) == "") {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Debe ingresar el perfil del instructor de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["actdisinst_perfil_instructor"]=$datos["actdisinst_perfil_instructor"];


		// Dirección 							- [actdisinst_direccion] 	- [OPCIONAL]
		$datosvalidados["actdisinst_direccion"]=$datos["actdisinst_direccion"];

		// Pais									- [pais_codigo] - [OBLIG]
		$spnombre = "sel_paises_xestado";
		$spparam = array("ppaisestado"=>ESTADOACTIVO, "porderby"=>"paisnom");
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("paiscod"=>$datos['pais_codigo']),$resultado,$filapais,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el pais.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["pais_codigo"]=$datos['pais_codigo'];

		// Provincia							- [prov_codigo] - [OBLIG] / Si es Argentina
		if ($datosvalidados["pais_codigo"]==ARGENTINA) {
			$oprovincia = new cProvincias($this->conexion);
			$oprovincia->ProvinciasSP($spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("provinciacod"=>$datos['prov_codigo']),$resultado,$filaprov,$numfilas,$errno) || $numfilas!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la provincia. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["prov_codigo"]=$datos['prov_codigo'];
		} else	
			$datosvalidados["prov_codigo"]="NULL";

		$datosvalidados["tipo_institucion"]=$datos['tipo_institucion'];

		// Organismo							- [jurisdid_apn/orgapub_codigo/orgapri_codigo] [OBLIG]
		if($datos["tipo_institucion"]==ORGANISMO_PUBLICO) {

			if ($datos["tipoorg_codigo"]==ORGANISMO_APN) {	
				$jurisdicciones	= new jurisdicciones;		
				if (!$jurisdicciones->SelectJurisdxID($datos['jurisdid_apn'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError)) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del Organismo Público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["jurisdid_apn"]=$datos['jurisdid_apn'];
				$datosvalidados["orgapub_codigo"]="NULL";
				$datosvalidados["orgapri_codigo"]="NULL";
					
			}
			if ($datos["tipoorg_codigo"]==ORGANISMO_NO_APN) {
				$oTablaOrganismoPublico = new cTablaOrganismoPublico($this->conexion);		
				$oTablaOrganismoPublico -> TablaDescriptoresSP($spnombre,$spparam);
				$arraybusq=array("orgapub_codigo"=>$datos["orgapub_codigo"]);
				if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,$arraybusq,$query,$filaret,$numfilas,$errorcod) || $numfilas!=1)	{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del Organismo Público.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["orgapub_codigo"]=$datos['orgapub_codigo'];
				$datosvalidados["jurisdid_apn"]="NULL";
				$datosvalidados["orgapri_codigo"]="NULL";				
			}
		}
			
		if ($datos["tipo_institucion"]==ORGANISMO_PRIVADO) {
			$oTablaOrganismoPrivado = new cTablaOrganismoPrivado($this->conexion);		
			$oTablaOrganismoPrivado -> TablaDescriptoresSP($spnombre,$spparam);
			$arraybusq=array("orgapri_codigo"=>$datos["orgapri_codigo"]);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,$arraybusq,$query,$filaret,$numfilasmatcheo,$errorcod) || $numfilasmatcheo!=1)	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en la selección del Organismo Privado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			$datosvalidados["orgapri_codigo"]=$datos['orgapri_codigo'];
			$datosvalidados["jurisdid_apn"]="NULL";
			$datosvalidados["orgapub_codigo"]="NULL";
		}
		
		return true;
	}	
} // class
?>