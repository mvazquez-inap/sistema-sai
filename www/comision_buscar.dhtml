<script type="text/javascript">
//------------------------------------------------------------------------------------------------
function Validar(formulario) {

	// Fecha de Inicio
	if (formulario.comi_fecha_inicio.value!="" && !ValidarFecha(formulario.comi_fecha_inicio.value))	{
		alert("La fecha de inicio de la realización no es válida");
		formulario.comi_fecha_inicio.focus();
		return false;
	}
	// Fecha de fin
	if (formulario.comi_fecha_fin.value!="" && !ValidarFecha(formulario.comi_fecha_fin.value)) {
		alert("La fecha de finalización de la realización no es válida");
		formulario.comi_fecha_fin.focus();
		return false;
	}

	// Si se seleccionan ambas, Fecha de Inicio >= Fecha de Fin 
	if (formulario.comi_fecha_inicio.value!="" && formulario.comi_fecha_fin.value!="") {
		var fechainicio=ConvertirFecha(formulario.comi_fecha_inicio.value,'dd/mm/aaaa','aaaammdd');
		var fechafin=ConvertirFecha(formulario.comi_fecha_fin.value,'dd/mm/aaaa','aaaammdd');
		if (fechainicio>fechafin) 	{
			alert("La fecha de finalización debe ser mayor o igual que la fecha de inicio");
			formulario.comi_fecha_inicio.focus();
			return false;
		}
	}
	
	return true;
}
//----------------------------------------------------------------------------------------------------
// Se age
function ExportarComision(formulario)
{
	var url = "download_tablas_excel_filtro_ajax.dhtml";
	var params = "tabla="+encodeURIComponent('comision_buscar');
		params += "&act_nombre=" + encodeURIComponent($('act_nombre').value);
		params += "&act_codinap=" + encodeURIComponent($('act_codinap').value);
		params += "&comi_codinap=" + encodeURIComponent($('comi_codinap').value);
		params += "&tipo_fecha=" + encodeURIComponent($('tipo_fecha').value);
		params += "&comi_estado=" + encodeURIComponent($('comi_estado').value);
		params += "&comi_fecha_inicio=" + encodeURIComponent($('comi_fecha_inicio').value);
		params += "&comi_fecha_fin=" + encodeURIComponent($('comi_fecha_fin').value);
		params += "&presdoc_apeynom=" + encodeURIComponent($('presdoc_apeynom').value);
		params += "&tipoact_codigo=" + encodeURIComponent($('tipoact_codigo').value);

	var ajax = new Ajax.Request(url, {
		parameters: params,
		method:"post",
		onComplete: function(transport) {
				if (200 == transport.status) 
				{
					response=transport.responseText;
					// alert(response);
					// $('muestro').innerHTML=response;
					document.location = "download_tablas_excel.dhtml?tabla=comision_buscar";
					// mensajeWait('waitDiv',0);
				} else {
					//mensajeWait('waitDiv',0);
				}	
			}
		}
	);
	
	return true;
}
//------------------------------------------------------------------------------------------------
