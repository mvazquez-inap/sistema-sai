$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
$oPoc = new cPoc($conexion);
$oPocActividad= new cPocActividad($conexion);
//----------------------------------------------------------------------------------------- 	
function MostrarGrillaPocPendAprob($conexion,$modulo,$poc_codigo,$poc_estado="") {
	//tengo que seleccionar lo siguiente:
	//si el poc es Nuevo o Rechaz.-> me traigo las actividades. Nuevas
	//si el poc es Aprobada-> me traigo las actividades Aprobadas y Con Pedido de Aprobación 
	
	$oPocActividad= new cPocActividad($conexion);
	$ArregloDatos= array();
	if ($poc_estado==POCPENDIENTEAPROBACION)
	{
		$ArregloDatos['orderby'] = "pocact_nombre_tentativo";
		$ArregloDatos['poc_codigo']=$poc_codigo;	
		if (!$oPocActividad->BuscarPocActividad($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\npoc_codigo_".$poc_codigo."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;	
			}		
	}
	else
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Estado del Poc incorrecto.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}
	$i=0;
	while ($filaresult=mysqli_fetch_assoc($result))
	{
		$arrayresult[$i]['pocact_codigo']= $filaresult['pocact_codigo'];
		$arrayresult[$i]['pocact_nombre_tentativo']= $filaresult['pocact_nombre_tentativo'];
		$arrayresult[$i]['poctipopres_codigo']= $filaresult['poctipopres_codigo'];
		$arrayresult[$i]['pocact_estado']= $filaresult['pocact_estado'];
		$conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","POCACTIVIDADESTADO","' and constantecod='",$filaresult['pocact_estado'],"'"),$caracterdesc,$numfilascaracter,$errorcod);
		$arrayresult[$i]['pocact_estado']= $caracterdesc;
		$arrayresult[$i]['poc_codigo']= $filaresult['poc_codigo'];
		$i++;
	}
	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El Poc seleccionado no posee Actividades No Editables.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return true;			
	}
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>10
	);
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla('Actividades');	
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Actividad');
	$oGrilla->Setear('ancho_columna',$miColumna1,'80%');
	$oGrilla->Setear('campo_grilla',$miColumna1,'pocact_nombre_tentativo');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	
	if (!$oGrilla->CargarGrilla($arrayresult))
		return false;
	$oGrilla->MostrarGrilla();
	return true;
} 		
//----------------------------------------------------------------------------------------- 	
function MostrarGrillaPocAprobEditables($conexion,$poc_codigo,$poc_estado="") {

	$oPocActividad= new cPocActividad($conexion);
	$ArregloDatos= array();

	$ArregloDatos['pocact_estado'] = POCACTIVIDADPEDAPROB;
	$ArregloDatos['orderby'] = "pocact_nombre_tentativo";
	$ArregloDatos['poc_codigo']=$poc_codigo;	
	if (!$oPocActividad->BuscarPocActividad($ArregloDatos,$numfilas,$result,$error,$errormail)) {
		$txt_sys_mail="\npoc_codigo_".$poc_codigo."\nerror=".$errormail;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}
	$i=0;
	while ($filaresult=mysqli_fetch_assoc($result))
	{
		$arrayresult[$i]['pocact_codigo']= $filaresult['pocact_codigo'];
		$arrayresult[$i]['pocact_nombre_tentativo']= $filaresult['pocact_nombre_tentativo'];
		$arrayresult[$i]['poctipopres_codigo']= $filaresult['poctipopres_codigo'];
		$arrayresult[$i]['pocact_estado']= $filaresult['pocact_estado'];
		$conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","POCACTIVIDADESTADO","' and constantecod='",$filaresult['pocact_estado'],"'"),$caracterdesc,$numfilascaracter,$errorcod);
		$arrayresult[$i]['pocact_estado']= $caracterdesc;
		$arrayresult[$i]['poc_codigo']= $filaresult['poc_codigo'];
		$i++;
	}
	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El Poc seleccionado no posee Actividades a Aprobar o Rechazar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return true;			
	}

	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>10
	);
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla('Actividades con Pedido de Confirmación de Carga');	
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Actividad');
	$oGrilla->Setear('ancho_columna',$miColumna1,'70%');
	$oGrilla->Setear('campo_grilla',$miColumna1,'pocact_nombre_tentativo');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	
	$miColumna9 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna9,'Estado');
	$oGrilla->Setear('ancho_columna',$miColumna9,'15%');
	$oGrilla->Setear('campo_grilla',$miColumna9,'pocact_estado');
	$oGrilla->Setear('align_columna',$miColumna9,'center');

	$miColumna4 = $oGrilla->AddColumna('popup');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Detalle');
	$oGrilla->Setear('ancho_columna',$miColumna4,'55');
	$oGrilla->Setear('imagen',$miColumna4,'images/verdetalle.gif');
	$oGrilla->Setear('altImagen',$miColumna4,'Ver Actividad POC');
	$oGrilla->Setear('url',$miColumna4,"poc_actividad_ver_dis.dhtml");
	$oGrilla->Setear('ventanaAnchoPopup',$miColumna4,'680');
	$oGrilla->Setear('ventanaAltoPopup',$miColumna4,'500');
	$oGrilla->Setear('ventanaVarxPopup',$miColumna4,'120');
	$oGrilla->Setear('ventanaVaryPopup',$miColumna4,'50');
	$oGrilla->AddParametrosURL($miColumna4,"poc_codigo",'poc_codigo');
	$oGrilla->AddParametrosURL($miColumna4,"pocact_codigo",'pocact_codigo');

	
	$miColumna2 = $oGrilla->AddColumna('linkimg');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Confirmar Carga');
	$oGrilla->Setear('ancho_columna',$miColumna2,'15%');
	$oGrilla->Setear('url',$miColumna2,'poc_evaluar_upd.dhtml');
	//$oGrilla->Setear('url_ancla',$miColumna3,'Edicion');
	$oGrilla->Setear('imagen',$miColumna2,'images/aprobar.gif');
	$oGrilla->Setear('altImagen',$miColumna2,'Confirmar Carga');						
	$oGrilla->AddParametrosURL($miColumna2,"poc_codigo","poc_codigo");
	$oGrilla->AddParametrosURL($miColumna2,"pocact_codigo","pocact_codigo");
	$oGrilla->AddParametrosURL($miColumna2,"operacion","A","cte");

	$miColumna3 = $oGrilla->AddColumna('linkimg');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Rectificar Carga');
	$oGrilla->Setear('ancho_columna',$miColumna3,'15%');
	$oGrilla->Setear('url',$miColumna3,'poc_evaluar_upd.dhtml');
	//$oGrilla->Setear('url_ancla',$miColumna3,'Edicion');
	$oGrilla->Setear('imagen',$miColumna3,'images/rechazar.gif');
	$oGrilla->Setear('altImagen',$miColumna3,'Rectificar Carga');						
	$oGrilla->AddParametrosURL($miColumna3,"poc_codigo","poc_codigo");
	$oGrilla->AddParametrosURL($miColumna3,"pocact_codigo","pocact_codigo");
	$oGrilla->AddParametrosURL($miColumna3,"operacion","R","cte");

	if (!$oGrilla->CargarGrilla($arrayresult))
		return false;
	$oGrilla->MostrarGrilla();
	return true;
} 		
