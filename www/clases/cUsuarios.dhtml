<?php
//----------------------------------------------------------------------------------------- 
// Clase con la lógica para el manejo de usuarios

/* La clase requiere que esten definidos:

	Stored Básicos: 	sel_usuarios_xusuariocod
						upd_usuarios_xusuariocod
						sel_usuarios_xusuariocuit
						upd_usuariopassword_xusuariocod						
						sel_usuarios_xusuariocuit_usuarioemail
						
	Registros de Acceso: 

	Clase: cRoles 
*/

class cUsuarios
{
	var $conexion;

	public function __construct($conexion)
	{
		$this->conexion = &$conexion;
	}

//-----------------------------------------------------------------------------------------
//							 PUBLICAS	
//----------------------------------------------------------------------------------------- 
/*
//----------------------------------------------------------------------------------------- 
// Retorna una consulta con todos los usuarios que cumplan con las condiciones

// Parámetros de Entrada:
//		datosbuscar: array asociativo con los filtros. Claves: usuarionombre, usuarioapellido, usuariocuit, usuarioemail

// Retorna:
//		numfilas,resultado: cantidad de filas y query de resultado
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function BuscarUsuariosXDatos($datosbuscar,&$numfilas,&$resultado)
	{
		$spnombre="sel_usuarios_xdatos_menorestado";
		$spparam=array("pusuarioestado"=>USUARIOBAJA,"pusuarionombre"=>"","pusuarioapellido"=>"","pusuariocuit"=>"","pusuarioemail"=>"","porderby"=>"usuarioapellido,usuarionombre");
		
		if(isset($datosbuscar["usuarionombre"]))
			$spparam["pusuarionombre"]=$datosbuscar["usuarionombre"];
