//-----------------------------------------------------------------------------------------
class cActividadCursoInstitucionalPersona
{
	var $conexion;
	public function __construct($conexion) {
		$this->conexion = &$conexion;
	}
//-----------------------------------------------------------------------------------------
	function BuscarActividadAsignadaPersona($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{


		$sparam=array('pxact_codigo'=>0);
		$sparam+=array('pxpers_codigo'=>0);

		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('ppers_codigo'=>"");
		$sparam+=array('porderby'=>"act_codigo");

		if (isset ($ArregloDatos['act_codigo']))
		{
			if ($ArregloDatos['act_codigo']!="")
			{
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}
		if (isset ($ArregloDatos['pers_codigo']))
		{
			if ($ArregloDatos['pers_codigo']!="")
			{
				$sparam['ppers_codigo']= $ArregloDatos['pers_codigo'];
				$sparam['pxpers_codigo']= 1;
			}
		}


		$spnombre="sel_actividad_curso_diseno_institucional_persona_xdatos";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar la Persona en Actividad Curso Diseño Institucional.";
			$errormail="Error al buscar la Persona en Actividad Curso Diseño Institucional.".$errno;
			return false;
		}
		return true;

	}


//------------------------------------------------------------------------------------------------------------------
function BuscarActividadPersonaCertificada($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail) {

	// Falta probar
	// Si esta asignada debe estar dictaminada y con disposición
	// En arreglo deberia venir una persona y/o actividad
	if(!$this->BuscarActividadAsignadaPersonaAvanzada($ArregloDatosAuto, $numfilas, $resultado, $error, $errormail)) {
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
		return false;
	}
	return true;
}
//------------------------------------------------------------------------------------------------------------------
function BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxact_codigo'=>0);
		$sparam+=array('pxpers_codigo'=>0);
		$sparam+=array('pxact_nombre'=>0);
		$sparam+=array('pxact_codinap'=>0);

		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('ppers_codigo'=>"");
		$sparam+=array('pact_nombre'=>"");
		$sparam+=array('pact_codinap'=>"");


		$sparam+=array('porderby'=>"act_codigo");

		if (isset ($ArregloDatos['act_codigo'])) {
			if ($ArregloDatos['act_codigo']!="") {
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}

		if (isset ($ArregloDatos['pers_codigo'])) {
			if ($ArregloDatos['pers_codigo']!="") {
				$sparam['ppers_codigo']= $ArregloDatos['pers_codigo'];
				$sparam['pxpers_codigo']= 1;
			}
		}
			if (isset ($ArregloDatos['act_nombre']))  {
			if ($ArregloDatos['act_nombre']!="") {
				$sparam['pact_nombre']= $ArregloDatos['act_nombre'];
				$sparam['pxact_nombre']= 1;
			}
		}
		if (isset ($ArregloDatos['act_codinap']))  {
			if ($ArregloDatos['act_codinap']!="") {
				$sparam['pact_codinap']= $ArregloDatos['act_codinap'];
				$sparam['pxact_codinap']= 1;
			}
		}

		if (isset ($ArregloDatos['orderby'])) {
			if ($ArregloDatos['orderby']!="") {
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_actividad_curso_diseno_institucional_persona_avanzadaxdatos";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))	{
			$error="Error al buscar la Persona en Actividad Externa.";
			$errormail="Error al buscar la Persona en Actividad Externa.".$errno;
			return false;
		}
		return true;

	}
//------------------------------------------------------------------------------------------------------------------
	function ValidarFormAltaActividadInstitucionalPersona() {
?>
	function ValidarFormAltaActividadInstitucionalPersona(formulario,operacion) {


			// Situación escalafonaria    - [esc_agrup_niv_grado] 	- [OBLIG]
			if ((trim(formulario.esc_agrup_niv_grado.value)=="")){
				alert("Debe ingresar una situación escalafonaria válida");
				return false;
			}
			// El Agente debe ser SINEP
			// if (formulario.esc_agrup_niv_grado.value.substr(0,4)!="<?php echo SINEP?>"){
			// MV 2024 - PECIFA
                        if (formulario.esc_agrup_niv_grado.value.substr(0, 4) != "<?php echo SINEP ?>" &&
                            formulario.esc_agrup_niv_grado.value.substr(0, 4) != "<?php echo PECIFA ?>"
                        ) {
				alert("Debe seleccionar un Agente SINEP");
				return false;
			}


			if (trim(formulario.jurisdid.value)==""){
				alert("Debe ingresar un Organismo donde trabaja el agente válido");
				formulario.jurisdid.focus();
				return false;
			}

			if (formulario.escalafon.value == "A") {
				if ((trim(formulario.agfunc_codigo.value)=="")){
					alert("Debe ingresar una función válida");
					formulario.agfunc_codigo.focus();
					return false;
				}
			}

			if (trim(formulario.jurisdid_coordinacion.value)==""){
				alert("Debe ingresar un Organismo del Coordinador T&eacute;cnico de Capacitaci&oacute;n válido");
				formulario.jurisdid_coordinacion.focus();
				return false;
			}

			if (trim(formulario.nivest_codigo.value)==""){
				alert("Debe ingresar Último nivel de estudios alcanzado");
				formulario.nivest_codigo.focus();
				return false;
			}

			if (trim(formulario.agentes_a_cargo.value)==""){
				alert("Debe ingresar Cantidad de agentes a cargo");
				formulario.agentes_a_cargo.focus();
				return false;
			}

			if (trim(formulario.paiscod_revista.value)==""){
				alert("Debe ingresar el País de revista");
				formulario.paiscod_revista.focus();
				return false;
			}

			if (formulario.paiscod_revista.value == <?php echo ARGENTINA?> ) {
				if (trim(formulario.provinciacod_revista.value)==""){
					alert("Debe ingresar la provincia de revista");
					formulario.provinciacod_revista.focus();
					return false;
				}
			}

		return true;
		}


//-----------------------------------------------------------------------------------------------------
	function SeleccionPais(formulario){
		var elSelect = document.getElementById('datos_provincia');
		if (formulario.paiscod_revista.value == <?php echo ARGENTINA ?>) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";
		}
	}
	<?php
 }
//-----------------------------------------------------------------------------------------
	function  AltaDatosActividadCursoDisenoInstitucionalPersona ($datos) {

		$datosvalidados=array();

		// Valida para insertar actividad_externa_persona
		if(!$this->_DatosValidosAltaActividadCursoDisenoInstitucionalPersona($datos,$datosvalidados)) {
			return false;
		}

		// Asignacion de la persona a la actividad
		$spnombre="ins_actividad_curso_diseno_institucional_persona";
		$spparam=array(
			'pact_codigo'=>$datosvalidados['act_codigo'],
			'ppers_codigo'=>$datosvalidados['pers_codigo'],
			'pagfunc_codigo'=>$datosvalidados['agfunc_codigo'],
			'pescalafcod'=>$datosvalidados['escalafcod'],
			'pagrupcod'=>$datosvalidados['agrupcod'],
			'pescalafnivcod'=>$datosvalidados['escalafnivcod'],
			'pescalaftramocod'=>$datosvalidados['escalaftramocod'],
			'pescalafgradocod'=>$datosvalidados['escalafgradocod'],
			'pactextpers_obs'=>$datosvalidados['actextpers_obs'],
			'pjurisdid_inap'=>$datosvalidados['jurisdid_inap'],
			'pjurisdid_apn'=>$datosvalidados['jurisdid_apn'],
			'porgapub_codigo'=>$datosvalidados['orgapub_codigo'],
			'pnivest_codigo'=>$datosvalidados['datos_agente']['nivest_codigo'],
			'pagentes_a_cargo'=>$datosvalidados['datos_agente']['agentes_a_cargo'],
			'ppaiscod_revista'=>$datosvalidados['datos_agente']['paiscod_revista'],
			'pprovinciacod_revista'=>$datosvalidados['datos_agente']['provinciacod_revista'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al asignar el agente a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// Insertar / Actualizar datos laborales del Agente
		$oAgente = new cAgentes($this->conexion);
		if ($datosvalidados['es_modif_agente']) {
			if($oAgente->ModifDatosAgente($datosvalidados['datos_agente'])) {
				FuncionesPHPLocal::RegistrarAcceso($this->conexion,"35703","pers_codigo=".$datosvalidados['pers_codigo'],$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se han modificado los datos laborales de la persona con CUIT ".$datosvalidados['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar los datos del agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		} else {
			if (!$datosvalidados['hay_agente'])
				if($oAgente->AltaDatosAgente($datosvalidados['datos_agente'])) {
					FuncionesPHPLocal::RegistrarAcceso($this->conexion,"35701","pers_cuilt=".$datosvalidados['pers_cuilt'],$_SESSION['usuariocod']);
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se han dado de Alta los datos laborales de la persona con CUIT ".$datosvalidados['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al agregar los datos del agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
		}

		return true;
	}
