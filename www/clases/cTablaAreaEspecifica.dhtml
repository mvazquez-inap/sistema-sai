	//---------------------------------------------------------------	
	// 	Funcion:	DescargarCatalogoExcel
	//  Proceso:	Genera el excel correspondiente al catálogo de Áreas Especificas.
	//	Entrada:	
	//				
	// 	Salida:     false: 	Si exite algún error.
	// 				true: 	Si todo esta ok.		
	//---------------------------------------------------------------	
	function DescargarCatalogoExcel()  {	
	
		$nombrearchivo="prestador_docente_catalodo_areas.xls";  
					
		$oExcel= new cEscribirExcel($nombrearchivo);
		$oExcel->AddHoja('Catálogo de Áreas para Prestadores Docentes');
		$oExcel->EsconderGrillas();
		$oExcel->PaginaHorizontal();
			
		$columnas = array();
   	    $columnas[] = array("titulo"=>"Clasificación Disciplinar",'ancho'=>100,'campo'=>'campo_detalle');
		
		for ($i=0; $i<count($columnas); $i++) 
			$oExcel->FormatoColumna ($i, $columnas[$i]['ancho']); 

		// Formato titulo del listado	
		$oExcel->BorrarFormato ();
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","azul");
		$oExcel->AddFormato ("FgColor","22");
		$formato_titulo=$oExcel->GetFormato();
	
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",14);
		$oExcel->AddFormato ("Color","blanco");
		$oExcel->AddFormato ("FgColor","gris");
		$formato_sub_titulo=$oExcel->GetFormato();

		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",12);
		$oExcel->AddFormato ("Color","blanco");
		$oExcel->AddFormato ("FgColor","violeta");
		$formato_sub_titulo_2=$oExcel->GetFormato();
	
		$oExcel->AddFormato ("Align","left");
		$oExcel->AddFormato ("Border",1);
		$oExcel->AddFormato ("Font","Times New Roman");
		$oExcel->AddFormato ("Tamaño",10);
		$oExcel->AddFormato ("Color","negro");
		$oExcel->AddFormato ("FgColor","blanco");
		$formato_texto=$oExcel->GetFormato();
		
		$cant_columnas=count($columnas);
		
		$fila_excel=-1;
		//$titulo_listado="Catálogo de Áreas para Prestadores Docentes";
		//$oExcel->CargarDatosVariasCeldas (0,0,0,$cant_columnas-1,'Catálogo de Áreas para Prestadores Docentes',$formato_titulo);
		$fila_excel++;
		
		$areacon_codigo_anterior=-1;
		$areagen_codigo_anterior=-1;

		$col_desde=0;
		$spnombre="sel_area_especifica_general_contextual";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,array(),$resultado,$numfilas,$errno)){
			$error="Error al buscar áreas temáticas.";
			$errormail="Error al buscar áreas temáticas.".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		
		while ($fila_area = mysqli_fetch_assoc($resultado)) {
	
			if($fila_area['areacon_codigo'] != $areacon_codigo_anterior) {
				$fila_result= array('campo_detalle'=>trim($fila_area['areacon_descripcion'])); 
				for ($k=$col_desde; $k<count($columnas); $k++) 		
					 $oExcel->CargarDatos ($fila_excel,$k,$fila_result[$columnas[$k]['campo']],$formato_sub_titulo);
				$fila_excel++;							 	 
			}		
			$areacon_codigo_anterior=$fila_area['areacon_codigo'];
		
			if($fila_area['areagen_codigo'] != $areagen_codigo_anterior) {
				$fila_result = array('campo_detalle'=>trim($fila_area['areagen_descripcion'])); 
				for ($k=$col_desde; $k<$cant_columnas; $k++) 		
					 $oExcel->CargarDatos ($fila_excel,$k,$fila_result[$columnas[$k]['campo']],$formato_sub_titulo_2);
				$fila_excel++;							 		 
			}
			$areagen_codigo_anterior=$fila_area['areagen_codigo'];

			$fila_result = array('campo_detalle'=>trim($fila_area['areaesp_descripcion'])); 
			for ($k=$col_desde; $k<$cant_columnas; $k++) 		
				 $oExcel->CargarDatos ($fila_excel,$k,$fila_result[$columnas[$k]['campo']],$formato_texto);
			$fila_excel++;						
							 
		}	// while

		$oExcel->Enviar();
		
		return true;

	} 	// 	 fin - DescargarCatalogoExcel

} // fin de la clase
?>