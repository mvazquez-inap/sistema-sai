//----------------------------------------------------------------------------------------- 
function ArmarCombo($idconexion,$spnombre,$spparam,$nomlista,$clavecombo,$desccombo,
					$querystring,$textolineauno,&$regactual,&$varlogica,$filas,
					$formulario='formulario',$style="width: 370px",$nomcombo="") {

	if ($nomcombo=="")
		$nomcombo=$clavecombo;
	
	// Cargo los registros del query seleccionado
	$query=ejecutarStoredProcedure($idconexion,$spnombre,$spparam);
	$num_filas=mysqli_num_rows($query);

	// Genera codigo JavaScript para autollamarse cuando selecciona un elemento del combo
	echo "<SCRIPT type='text/javascript'> \n";
	echo "<!--\n";
	
	echo "function ".$nomlista."_newpage() {\n";

	$temp="";
	if($querystring!='')
		$temp="?";

	echo "if(document.".$formulario.".".$nomcombo.".selectedIndex==0)\n";
	echo "    location='".$_SERVER['PHP_SELF'].$temp.$querystring."';\n";
	echo "else\n";

	if($querystring!='')
		$querystring.="&"; 

//	if($querystring!='')
// 		$querystring.="&amp;"; 	
//	echo "    location='".$_SERVER['PHP_SELF']."?".$querystring.$clavecombo."='+document.".$formulario.".".$clavecombo."[document.".$formulario.".".$clavecombo.".selectedIndex]".".value;\n";
	
	echo "    location='".$_SERVER['PHP_SELF']."?".$querystring.$nomcombo."='+document.".$formulario.".".$nomcombo."[document.".$formulario.".".$nomcombo.".selectedIndex]".".value;\n";
	echo "}\n";
	
	echo "//-->\n";
	echo "</SCRIPT>\n";

	// Generación del combo, poniendo como primera linea $textolineauno
	echo "<select name='".$nomcombo."' id='".$nomcombo."' onChange='".$nomlista."_newpage();' class='textoCombo' style='".$style."'size='".$filas."'>";
	echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>";
	$varlogica=false;

	if($num_filas>0) 	{
		mysqli_data_seek($query,0);
		// Recorre el cursor desde el principio, poniendo cada fila en una linea del combo
		$textopopup='';
		while ($fila = mysqli_fetch_assoc($query)) { 
			if($fila[$clavecombo]==$_GET[$nomcombo]) 	{
				echo "<option selected value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>";
				$varlogica=true;
				$regactual=$fila;
				$textopopup=$fila[$desccombo];				
			}
			else
				echo "<option value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>";
		}
	}
	echo("</select>");	

	if($textopopup!='')
		echo "<br><a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?textopopup='+".$formulario.".".$clavecombo."[".$formulario.".".$clavecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkAclaraciones'>Ver texto completo</a>";
	else
		 echo "<div style='font-size: 7px;'>&nbsp;</div>";
}
//----------------------------------------------------------------------------------------- 
function ArmarCombo_sinSalto($idconexion,$spnombre,$spparam,$nombrecombo,
							$clavecombo,$desccombo,$textolineauno,$claveselec,&$regactual,
							&$varlogica,$filas,$formulario='formulario',$style="width: 370px",$ver_texto=true,$class="textoCombo") {

	// Cargo los registros del query seleccionado
	$query=ejecutarStoredProcedure($idconexion,$spnombre,$spparam);
	$num_filas=mysqli_num_rows($query);

	// Generación del combo, poniendo como primera linea $textolineauno
	echo "<select name='".$nombrecombo."' id='".$nombrecombo."' class='".$class."' style='".$style."' size='".$filas."'>";
	
	// Aparece $textolineauno como primera opcion del combo ej:"Seleccione ...", 
	// si se manda el texto de la primera línea.
	if ($textolineauno!="")
	  echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>";
	
	$varlogica=false;
	if($num_filas>0) {
		mysqli_data_seek($query,0);
		// Recorre el cursor desde el principio, poniendo cada fila en una linea del combo
		while ($fila = mysqli_fetch_assoc($query))	{ 
			if($fila[$clavecombo]==$claveselec) {
				echo "<option selected value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>";
				$varlogica=true;
				$regactual=$fila;
			} else
				echo "<option value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>";
		}
	}
	echo("</select>");
	if ($ver_texto)
		echo "<br><a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?textopopup='+".$formulario.".".$nombrecombo."[".$formulario.".".$nombrecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkAclaraciones'>Ver texto completo</a>";
}
//----------------------------------------------------------------------------------------- 
function ArmarCombo_deArray($valores_combo,$valores_asoc,$nomlista,$clavecombo,$querystring,
							$textolineauno,&$regactual,&$varlogica,$filas,
							$formulario='formulario',$style="width: 370px",
							$clave_combo="clave_combo",$descri_combo="descri_combo",$ver_texto=true) {

	// Dejo los nombres: $clavecombo,$nomlista por compatibildad ArmarCombo
	// $nomlista:		es la funcion javascript que se ejecuta con el Onchange del combo.
	// $clavecombo:	 	nombre del combo. 

	// La $clave_combo, nombre del componente donde se encuentra el valor a asignar en el combo
	// por defecto $descri_combo se asume se encuentra en "clave_combo".

	// La $descri_combo, nombre del componente que corresponde a la descripcion 
	// a mostrar en el combo, por defecto se asume se encuentra en "descri_combo" 

	$varlogica=false;
	
	// Validar que si el array de valores asociado tiene elementos, entonces tiene
	// tantas filas como el array con las claves
	if (count($valores_asoc)!=0 && count($valores_asoc)!=count($valores_combo)  ) {
		MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Array asociado con distinta cantidad de valores que el de claves.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);
		return;
	}

	// Genera codigo JavaScript para autollamarse cuando selecciona un elemento del combo
	echo "<SCRIPT type='text/javascript'> \n";
	echo "<!--\n";
	
	echo "function ".$nomlista."_newpage() {\n";

	$temp="";
	if($querystring!='')
		$temp="?";

	echo "if(document.".$formulario.".".$clavecombo.".selectedIndex==0)\n";
	echo "    location='".$_SERVER['PHP_SELF'].$temp.$querystring."';\n";
	echo "else\n";

	if($querystring!='')
		$querystring.="&";

	echo "    location='".$_SERVER['PHP_SELF']."?".$querystring.$clavecombo."='+document.".$formulario.".".$clavecombo."[document.".$formulario.".".$clavecombo.".selectedIndex]".".value;\n";
	echo "}\n";
	
	echo "//-->\n";
	echo "</SCRIPT>\n";

	// Generación del combo, poniendo como primera linea $textolineauno
	echo "<select name='".$clavecombo."' id='".$clavecombo."' onChange='".$nomlista."_newpage();' class='textoCombo' style='".$style."' size='".$filas."'>";
	if ($textolineauno!="")
		echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>";

	$varlogica=false;
	$textopopup='';

	foreach ($valores_combo as $key => $val) {

		if ($val[$clave_combo]==$_GET[$clavecombo]) {
				echo "<option selected value='".htmlspecialchars($val[$clave_combo],ENT_QUOTES)."'> ".htmlspecialchars($val[$descri_combo],ENT_QUOTES)." </option>";
					
				$regactual[$clave_combo]=$val[$clave_combo];
				$regactual[$descri_combo]=$val[$descri_combo];

				$claves_valores_asoc = array_keys(array_change_key_case($valores_asoc[$key],CASE_LOWER));
				
				for ($j=0; $j<count($claves_valores_asoc); $j++ ) {
					$regactual[$claves_valores_asoc[$j]] = $valores_asoc[$key][$claves_valores_asoc[$j]];
				}

				$varlogica=true;
				$textopopup=$val[$descri_combo];
		} else
				echo "<option value='".htmlspecialchars($val[$clave_combo],ENT_QUOTES)."'> ".htmlspecialchars($val[$descri_combo],ENT_QUOTES)." </option>";
	} // foreach

	echo("</select>");
		
	if($textopopup!='') {
		if ($ver_texto)
			echo "<br><a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?textopopup='+".$formulario.".".$clavecombo."[".$formulario.".".$clavecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkAclaraciones'>Ver texto completo</a>";
	} else
		 echo "<div style='font-size: 7px;'>&nbsp;</div>";
}
//----------------------------------------------------------------------------------------- 
function ArmarCombo_sinSalto_deArray($valores_combo,$valores_asoc,$nombrecombo,$textolineauno,
									 $claveselec,&$regactual,&$varlogica,$filas,
									 $formulario='formulario',$style="width: 370px",$clave_combo="clave_combo",
									 $descri_combo="descri_combo",$ver_texto=true) {  
 
	// La $clave_combo, nombre del componente donde se encuentra el valor a asignar en el combo
	// por defecto $descri_combo se asume se encuentra en "clave_combo".

	// La $descri_combo, nombre del componente que corresponde a la descripcion 
	// a mostrar en el combo, por defecto se asume se encuentra en "descri_combo" 
	
	$varlogica=false;
	
	// Validar que si el array de valores asociado tiene elementos, entonces tiene
	// tantas filas como el array con las claves
	if (count($valores_asoc)!=0 && count($valores_asoc)!=count($valores_combo)  ) {
		MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Array asociado con distinta cantidad de valores que el de claves.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);
		return;
	}

	// Generación del combo, poniendo como primera linea $textolineauno
	echo "<select name='".$nombrecombo."' id='".$nombrecombo."' class='textoCombo' style='".$style."' size='".$filas."'>";
	
	// Para que no aparezca siempre el Seleccione.
	if ($textolineauno!="")
	  echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>";
	
	$varlogica=false;

	// Recorre el array, poniendo cada fila en una linea del combo
	 foreach ($valores_combo as $key => $val) {
		if($val[$clave_combo]==$claveselec) {
			echo "<option selected value='".htmlspecialchars($val[$clave_combo],ENT_QUOTES)."'> ".htmlspecialchars($val[$descri_combo],ENT_QUOTES)." </option>";
			$varlogica=true;
				
			$regactual[$clave_combo]=$val[$clave_combo];
			$regactual[$descri_combo]=$val[$descri_combo];

			$claves_valores_asoc = array_keys(array_change_key_case($valores_asoc[$key],CASE_LOWER));
			for ($j=0; $j<count($claves_valores_asoc); $j++ ) {
				$regactual[$claves_valores_asoc[$j]] = $valores_asoc[$key][$claves_valores_asoc[$j] ];
			}
		} else
			echo "<option value='".htmlspecialchars($val[$clave_combo],ENT_QUOTES)."'> ".htmlspecialchars($val[$descri_combo],ENT_QUOTES)." </option>";	
	} // foreach
	
	echo("</select>");
	
	if ($ver_texto)
		echo "<br><a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?textopopup='+".$formulario.".".$nombrecombo."[".$formulario.".".$nombrecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkAclaraciones'>Ver texto completo</a>";
}
//----------------------------------------------------------------------------------------- 
// Arma los 2 listbox para pasar de uno al otro (de arriba a abajo )

// Parametros:
// 		->sp_nombre y sp_param es el SP con el que se genera la lista de la izquierda
// 		->clavecombo y desccombo son campos del array con los que arma el combo
// 		->nomformulario es el nombre del formulario sobre el que está el combo
//		->nombrelista es el nombre que van a recibir las listas, botones, etc
//		->textoarriba y textoabajo es el texto que aparecerá arriba de cada lista
//		->style es el estilo que se aplicará a las listas
//		->filas es la cantidad de filas en la lista
//		->subebaja si se quiere que en la lista de la derecha aparezcan los botones para subir y bajar elementos
	
function ArmarListasAB($conexion,$sp_nombre,$sp_param,$clavecombo,$desccombo,$nomformulario,$nombrelista,$textoarriba,$textoabajo,$style,$filas,$subebaja)	{
?>
<table width="100%" class="textoTablaDato">
	<tr align="center">
		<td><strong><?php echo htmlspecialchars($textoarriba,ENT_QUOTES) ?></strong></td>
		<!-- <br> -->
	</tr>
	<!-- <tr>
		<td>&nbsp;</td>
	</tr> -->
	<tr>
		<td align="center">
<?php 		ArmarCombo_SinSalto($conexion,$sp_nombre,$sp_param,$nombrelista."arriba",$clavecombo,$desccombo,"","",$regnousar,$validonousar,$filas,$nomformulario,$style);?>		
		</td>
	</tr>
	
	<tr>
		<td align="center">
			<a href="JavaScript:PasarItemLista(<?php echo "document.".$nomformulario.".".$nombrelista."arriba" ?>,<?php echo "document.".$nomformulario."['".$nombrelista."abajo" ?>[]'],true)"><img src="images/bajar.jpg" border="0" alt="bajar"></a>
			<a href="JavaScript:PasarItemLista(<?php echo "document.".$nomformulario."['".$nombrelista."abajo" ?>[]'],<?php echo "document.".$nomformulario.".".$nombrelista."arriba" ?>,true)"><img src="images/subir.jpg" border="0" alt="subir"></a>
		</td>	
	</tr>
	
	<tr align="center">
		<td><strong><?php echo htmlspecialchars($textoabajo,ENT_QUOTES) ?></strong></td>
	</tr>
	<tr>
		<td align="center">
			<select name="<?php echo $nombrelista.'abajo' ?>[]" size="<?php echo $filas ?>" style="<?php echo $style ?>" multiple></select><br>
	<?php		if($subebaja) {  ?>			
				<input type="button" name="<?php echo $nombrelista."botonsubir" ?>" value="Subir" onClick="MoverItemLista(formulario['<?php echo $nombrelista."abajo" ?>[]'],'subir')">&nbsp;&nbsp;
				<input type="button" name="<?php echo $nombrelista."botonbajar" ?>" value="Bajar" onClick="MoverItemLista(formulario['<?php echo $nombrelista."abajo" ?>[]'],'bajar')">
	<?php		} ?>			
		</td>
	</tr>
</table>
<?php
 return true;
}
