						$spparam+=array("porderby"=>"notfechapub DESC");
						$spparam+=array("pnotfechapubmes"=>"");
						$spparam+=array("pestadomes"=>0);
						$spparam+=array("pestadoanio"=>0);
						$spparam["pestadoanio"]=1;
						$spparam+=array("pnotfechapubanio"=>$filaanios['anio']);
						$spparam+=array("porderby"=>"notfechapub DESC");
						if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$querynotanio,$numfilasnotanio,$errno))
						{
							$this->msg_error.="Error al buscar ".$this->arreglotitulos['Titulo']." por año.";
							return false;
						}

						$borde = " ";

						if ($i==$numfilas)
							$borde = " style=\"border:none;\"";

						$querystring = FuncionesPHPPortal::ArmarQueryString("");
						$texto = $filaanios['anio'];
						$seleccionado = " ";

						if ($this->anio!="" && $this->anio==$filaanios['anio'])
							$seleccionado = " class=\"seleccionado\"";

						$anio = "&amp;anio=".$filaanios['anio'];
						$href = "paginas.dhtml?pagina=".$this->pagcod.$anio;

						$salida .= "	<li>";
						$salida .= "		<a ".$borde.$seleccionado." href=\"".$href."\" title=\"".$this->arreglotitulos['Titulo']." de ".$texto."\">";
						$salida .= "			".$texto;
						if ($this->mostrarcantidad)
							$salida .= " (".$numfilasnotanio.")";
						$salida .= "		</a>";
						$salida .= "	</li>";
						$i++;

					}
					$salida .= "	</ul>";
					$salida .= "</div>";
				}
			break;

			case "Ruta":
				$href = "paginas.dhtml?pagina=1";
				$salida .= "<a href=\"".$href."\" title=\"Inicio\">Inicio</a>";
				if ($this->anio=="" && $this->mes=="" && $this->notcod=="")
				{
					$salida .= "&nbsp;> <strong>".$this->arreglotitulos['TituloRuta']."</strong>";
				}else
				{
					$href = "paginas.dhtml?pagina=".$this->pagcod;
					$salida .= "&nbsp;> <a href=\"".$href."\" title=\"".$this->arreglotitulos['TituloRuta']."\">".$this->arreglotitulos['TituloRuta']."</a>";
				}
				$anio = "";
				if ($this->anio!="")
					$anio = "&amp;anio=".$this->anio;
				if ($this->anio!="")
				{
					$href = "paginas.dhtml?pagina=".$this->pagcod.$anio;
					$salida .= "&nbsp;> <a href=\"".$href."\" title=\"".$this->arreglotitulos['TituloRuta']." de ".$this->anio."\">".$this->anio."</a>";
				}
				if ($this->mes!="")
				{
					if ($this->anio!="")
						$mes = "&amp;mes=".$this->mes;
					if ($this->notcod!="")
					{
						$href = "paginas.dhtml?pagina=".$this->pagcod.$anio.$mes;
						$salida .= "&nbsp;> <a href=\"".$href."\" title=\"".$this->arreglotitulos['TituloRuta']." de ".$this->anio."\">".ObetenerTextoMes($this->mes)."</a>";
					}else
					{
						$salida .= "&nbsp;> <strong>".ObetenerTextoMes($this->mes)."</strong>";
					}
				}
				if ($this->notcod!="")
				{
					$salida .= "&nbsp;> <strong>".$this->arreglotitulos['TituloCorto']."</strong>";
				}
			break;
		}

		return true;
	}




	function ObtenerTextoFecha($fecha)
	{
		$arrayfecha = explode('-', $fecha);
		$fechaint = mktime(0,0,0, $arrayfecha[1], $arrayfecha[2], $arrayfecha[0]);
		$fechasalida = strftime("%e de %B de %Y." ,$fechaint);
		return ReemplazarTextoFechas($fechasalida);
	}

	function ProcesarNoticia($descripcion,&$salida)
	{

		$campo=new cVisualizaCampo($this->conexionobjeto,$this->comentarios,$this->es_admin);
		if($campo->Setear(array("ContCampo"=>$descripcion,"conv_SGML"=>true)))
		{
			if(!$campo->Mostrar($salida))
				$seprodujoerror=true;
		}
		else
			$seprodujoerror=true;

		return true;
	}


	function RetornarMsgError()
	{
		return $this->msg_error;
	}



}//fin clase cNoticiasDinamicas



// ----------------------------------------------------------------------
class cTablaPropiaDinamica
{

	// Esta clase maneja las visualizaciones de tablas propias del portal
	// Ejemplo: tablas_propias_cursos

	// Requiere los siguiente estilos
	//--------------------------------
	// noticia_msg - msg_accion - clearfix
	// menulateral - seleccionado - separador
	// clear - noticia_msg - paginar - botones_izq
	// botones_der - txt_cen -  bold

	var $conexionobjeto;
	var $msg_error;
	var $es_admin;

	var $pagcod;
	var $con_link = true;
	var $idioma="ESP";
	var $accion = "";
	var $accion_interna = "";

	var $regdatocod;

	var $dia;
	var $mes;
	var $anio;

	var $cantidadpaginar = 10;
	var $paginaactual = 1;

	var $arreglotitulos;
	var $tituloruta;
	var $mostrarcantidad = true;

	var $classcss = "";

	var $visualizcod = 1;

	var $filtrosql = array();
	var $campofecha ="";

	var $vistas = array();

	var $anoInicial = "";
	var $anoFinal = "";

	function cTablaPropiaDinamica($es_admin=false)
	{
		$this->conexionobjeto = new accesoBDPortal(SERVIDORBD,USUARIOBD,CLAVEBD);
		$this->conexionobjeto->SeleccionBD(BASEDATOS);
		$this->msg_error = "";
		$this->es_admin = $es_admin;
	}

	function Setear($parametros)
	{

		if (isset($parametros['SubTipo']))
			$this->accion = $parametros['SubTipo'];

		// Filtro y orden a tener sobre la tabls
		$this->filtrosql['where'] = "1=1";
		if (isset($parametros['Filtro']))
			$this->filtrosql['where'] = str_replace("##",'"',$parametros['Filtro']);
		if (isset($parametros['Tabla']))
			$this->filtrosql['tabla'] = $parametros['Tabla'];
		if (isset($parametros['Orden']))
			$this->filtrosql['orden'] = $parametros['Orden'];

		// Cantidad de registros a mostrar
		if (isset($parametros['Cantidad']))
			$this->filtrosql['cantidad'] = $parametros['Cantidad'];

		// Año inicio del calendario
		if (isset($parametros['AnioInicio']))
			$this->anoInicial = $parametros['AnioInicio'];
		// Año fin del calendario
		if (isset($parametros['AnioFin']))
			$this->anoFinal = $parametros['AnioFin'];

		// Visualización a utilizar
		if (isset($parametros['Visualizacion']))
			$this->visualizcod = $parametros['Visualizacion'];
		// ClassCSS a utilizar
		if (isset($parametros['ClassCss']))
			$this->classcss = $parametros['ClassCss'];

		// Fecha sobre la cual se construye el calendario
		if (isset($parametros['CampoFecha']))
			$this->campofecha = $parametros['CampoFecha'];

		// Pagina
		if (isset($parametros['pagina']))
			$this->pagcod = $parametros['pagina'];
		elseif(isset($_GET['pagina']))
			$this->pagcod = $_GET['pagina'];

		// Si se desea paginado, indicar Cantidad de registros por página
		if (isset($_GET['paginado']))
			$this->paginaactual = $_GET['paginado'];
		if (isset($parametros['CantidadPorPagina']))
			$this->cantidadpaginar = $parametros['CantidadPorPagina'];

		// Titulos
		if (isset($parametros['Titulo']))
			$this->arreglotitulos['Titulo'] = $parametros['Titulo'];
		if (isset($parametros['TituloRuta']))
			$this->arreglotitulos['TituloRuta'] = $parametros['TituloRuta'];
		if (isset($parametros['TituloCorto']))
			$this->arreglotitulos['TituloCorto'] = $parametros['TituloCorto'];
		if (isset($parametros['TituloAmpliado']))
			$this->arreglotitulos['TituloAmpliado'] = $parametros['TituloAmpliado'];

		if (isset($parametros['Vistas']))
			$this->vistas = explode("|",$parametros['Vistas']);

		// Mostrar entre parentesis la cantidad de registros en el mes/año en el menu calendario
		if (isset($parametros['MostrarCantidad']) && $parametros['MostrarCantidad']==0)
			$this->mostrarcantidad = false;

		// Esta parado sobre un año
		if (isset($_GET['anio']))
		{
			$this->anio = $_GET['anio'];
			if(!FuncionesPHPPortal::ValidarContenido($this->conexionobjeto,$this->anio,"NumericoEntero"))
				$this->anio = date("Y");
		}

		// Esta parado sobre un mes
		if (isset($_GET['mes']))
		{
			$this->mes = $_GET['mes'];
			if(!FuncionesPHPPortal::ValidarContenido($this->conexionobjeto,$this->mes,"NumericoEntero"))
				$this->mes = "";
			if ($this->mes<1 || $this->mes>12)
				$this->mes = "";
		}

		if (isset($_GET['dia']))
		{
			$this->dia = $_GET['dia'];
			if(!FuncionesPHPPortal::ValidarContenido($this->conexionobjeto,$this->dia,"NumericoEntero"))
				$this->dia = "";
			/*Validar fecha*/
		}

		if (isset($_GET['regdatocod']))
			$this->regdatocod = $_GET['regdatocod'];

		// Si el detalle del registro cambiar la visualizacion a lo que vienen  en	VisualizacionAmpliada
		if (isset($_GET['regdatocod']) && $this->accion=="TablaPropiaFiltrada")
		{
			$this->accion = "TablaPropiaAmpliada";
			$this->visualizcod = $parametros['VisualizacionAmpliada'];
		}
		elseif ( isset($_GET['dia'])  && isset($_GET['mes']) && isset($_GET['anio']) && $this->accion=="TablaPropiaFiltrada") {
			// Deberia venir dia, mes y año
			$this->accion = "TablaPropiaFiltradaxDiaxMesxAnio";
		}
		elseif ((isset($_GET['mes']) || isset($_GET['anio'])) && $this->accion=="TablaPropiaFiltrada")
		{
			// Si vienen mes o año filtrar utilizar TablaPropiaFiltradaxMesxAnio
			$this->accion = "TablaPropiaFiltradaxMesxAnio";
		}


		return true;
	}

	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		$ruta=array();

		$paginarresultados = false;

		switch($this->accion)
		{
			case 'TablaPropiaFiltrada':

				$spnombre="sel_tablas_propias_tablas_xfiltros";
				$spparam=array("pwhere"=>$this->filtrosql['where']);
				$spparam+=array("ptabla1"=>$this->filtrosql['tabla']);
				$spparam+=array("ptabla2"=>$this->filtrosql['tabla']);
				$spparam+=array("porderby"=>$this->filtrosql['orden']);
				$spparam+=array("plimit"=>"");
				if (isset($this->filtrosql['cantidad']))
				{
					$inicio = 0;
					$spparam["plimit"] = " limit ".$inicio.",".$this->filtrosql['cantidad'];
					$canttotal = $this->filtrosql['cantidad'];
				}else
				{
					if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$canttotal,$errno))
					{
						$this->msg_error.="Imagen error. Regdatocod: ".$this->regdatocod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
						return false;
					}
				}

				$mostrarpaginado = false;
				if ($this->CalcularPaginado($canttotal,$paginaanterior,$paginasiguiente,$ultimapagina,$limit))
				{
					$spparam["plimit"] = $limit;
					$mostrarpaginado = true;
				}

				if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$canttotal,$errno))
				{
					$this->msg_error.="Imagen error. regdatocod: ".$this->regdatocod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
					return false;
				}

				if ($canttotal==0)
				{
					$salida .= "<div class=\"msg_no_datos msg_accion clearfix\">";
					$salida .= "No se encontraron ".$this->arreglotitulos['Titulo']." en las fechas seleccionadas.";
					$salida .= "</div>";
				}

				$oVisualizaTablasPropias = new cVisualizaTablasPropias($this->conexionobjeto,false,false);
				while($filaregistro=mysqli_fetch_assoc($query))
				{
					$parametros["pagcod"] = $this->pagcod;
					$parametros["regdatocod"] = $filaregistro['regdatocod'];
					$parametros["visualizcod"] = $this->visualizcod;
					$parametros["tabla"] = $this->filtrosql['tabla'];
					$parametros["parametros"] = array();

					if($oVisualizaTablasPropias->Setear($parametros))
					{

						if(!$oVisualizaTablasPropias->Mostrar($salida,$cantregistros))
							$seprodujoerror=true;
					}
				}
				if ($mostrarpaginado)
					$salida .= $this->MostrarPaginado($paginaanterior, $paginasiguiente, $ultimapagina);

			break;

			case "TablaPropiaFiltradaxMesxAnio":

				$spnombre="sel_tablas_propias_tablas_xfiltros";

				$spparam=array("pwhere"=>$this->filtrosql['where']);
				$spparam+=array("ptabla1"=>$this->filtrosql['tabla']);
				$spparam+=array("ptabla2"=>$this->filtrosql['tabla']);
				$spparam+=array("porderby"=>$this->filtrosql['orden']);
				$spparam+=array("plimit"=>"");
				$limit = "";

				if ($this->mes!="")
				{
					if (isset($this->filtrosql['where']) && $this->filtrosql['where']!="")
						$spparam['pwhere'].=" and ";

					$spparam['pwhere'].=" MONTH(".$this->campofecha.") = ".$this->mes;
				}

				if ($this->anio!="")
				{
					if (isset($this->filtrosql['where']) && $this->filtrosql['where']!="")
						$spparam['pwhere'].=" and ";

						$spparam['pwhere'].=" YEAR(".$this->campofecha.") = ".$this->anio;
				}

				if ($this->mes!="")
				{
					$texto = ObetenerTextoMes($this->mes);
					$salida .= "<h1>".$this->arreglotitulos['Titulo']." de ".$texto." de ".htmlspecialchars($this->anio,ENT_QUOTES)."</h1>";
				}elseif ($this->anio!="")
					$salida .= "<h1>".$this->arreglotitulos['Titulo']." del ".htmlspecialchars($this->anio,ENT_QUOTES)."</h1>";

				if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$canttotal,$errno))
					return false;

				$inicio = 0;
				$spparam["plimit"] = " limit ".$inicio.",".$canttotal;

				$mostrarpaginado = false;
				if ($this->CalcularPaginado($canttotal,$paginaanterior,$paginasiguiente,$ultimapagina,$limit))
				{
					$spparam["plimit"] = $limit;
					$mostrarpaginado = true;
				}
				if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
				{
					if ($numfilas==0)
					{
						$salida .= "<div class=\"msg_no_datos msg_accion clearfix\">";
						$salida .= "No se encontraron ".$this->arreglotitulos['Titulo']." en las fechas seleccionadas.";
						$salida .= "</div>";
					}

					$oVisualizaTablasPropias = new cVisualizaTablasPropias($this->conexionobjeto,false,false);
					while($filaregistro=mysqli_fetch_assoc($query))
					{
						$parametros["pagcod"] = $this->pagcod;
						$parametros["regdatocod"] = $filaregistro['regdatocod'];
						$parametros["visualizcod"] = $this->visualizcod;
						$parametros["tabla"] = $this->filtrosql['tabla'];
						$parametros["parametros"] = array();
						if($oVisualizaTablasPropias->Setear($parametros))
						{
							if(!$oVisualizaTablasPropias->Mostrar($salida,$cantregistros))
								$seprodujoerror=true;
						}

					}
				}
				if ($mostrarpaginado)
					$salida .= $this->MostrarPaginado($paginaanterior, $paginasiguiente, $ultimapagina);
			break;

			// 	Todo esto es nuevo
		 	case "TablaPropiaFiltradaxDiaxMesxAnio":

				$spnombre="sel_tablas_propias_tablas_xfiltros";

				$spparam=array("pwhere"=>$this->filtrosql['where']);
				$spparam+=array("ptabla1"=>$this->filtrosql['tabla']);
				$spparam+=array("ptabla2"=>$this->filtrosql['tabla']);
				$spparam+=array("porderby"=>$this->filtrosql['orden']);
				$spparam+=array("plimit"=>"");
				$limit = "";

				if ($this->dia!="")
				{
					if (isset($this->filtrosql['where']) && $this->filtrosql['where']!="")
						$spparam['pwhere'].=" and ";

					$spparam['pwhere'].=" DAY(".$this->campofecha.") = ".$this->dia;
				}

				if ($this->mes!="")
				{
					if (isset($this->filtrosql['where']) && $this->filtrosql['where']!="")
						$spparam['pwhere'].=" and ";

					$spparam['pwhere'].=" MONTH(".$this->campofecha.") = ".$this->mes;
				}

				if ($this->anio!="")
				{
					if (isset($this->filtrosql['where']) && $this->filtrosql['where']!="")
						$spparam['pwhere'].=" and ";

						$spparam['pwhere'].=" YEAR(".$this->campofecha.") = ".$this->anio;
				}

				$texto = ObetenerTextoMes($this->mes);
				$salida .= "<h1>".$this->arreglotitulos['Titulo']." del ".$this->dia." de ".$texto." de ".htmlspecialchars($this->anio,ENT_QUOTES)."</h1>";





				if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$canttotal,$errno))
					return false;

				$inicio = 0;
				$spparam["plimit"] = " limit ".$inicio.",".$canttotal;

				$mostrarpaginado = false;
				if ($this->CalcularPaginado($canttotal,$paginaanterior,$paginasiguiente,$ultimapagina,$limit))
				{
					$spparam["plimit"] = $limit;
					$mostrarpaginado = true;
				}
				if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno))
				{
					if ($numfilas==0)
					{
						$salida .= "<div class=\"msg_no_datos msg_accion clearfix\">";
						$salida .= "No se encontraron ".$this->arreglotitulos['Titulo']." en las fechas seleccionadas.";
						$salida .= "</div>";
					}

					$oVisualizaTablasPropias = new cVisualizaTablasPropias($this->conexionobjeto,false,false);
					while($filaregistro=mysqli_fetch_assoc($query))
					{
						$parametros["pagcod"] = $this->pagcod;
						$parametros["regdatocod"] = $filaregistro['regdatocod'];
						$parametros["visualizcod"] = $this->visualizcod;
						$parametros["tabla"] = $this->filtrosql['tabla'];
						$parametros["parametros"] = array();
						if($oVisualizaTablasPropias->Setear($parametros))
						{
							if(!$oVisualizaTablasPropias->Mostrar($salida,$cantregistros))
								$seprodujoerror=true;
						}

					}
				}
				if ($mostrarpaginado)
					$salida .= $this->MostrarPaginado($paginaanterior, $paginasiguiente, $ultimapagina);
			break;

			case "TablaPropiaAmpliada":


				$parametros["pagcod"] = $this->pagcod;
				$parametros["regdatocod"] = $this->regdatocod;
				$parametros["visualizcod"] = $this->visualizcod;
				$parametros["tabla"] = $this->filtrosql['tabla'];
				$parametros["parametros"] = array();

				$oVisualizaTablasPropias = new cVisualizaTablasPropias($this->conexionobjeto,false,false);

				if($oVisualizaTablasPropias->Setear($parametros))
				{
					if(!$oVisualizaTablasPropias->Mostrar($salida,$cantregistros))
						$seprodujoerror=true;
				}
				break;

			// Menu de Meses
			case "CalendarioMenuMeses":

				$m = 12;

				if ($this->anio!="")
					if ($this->anio<date("Y"))
						$m=12;
				$i = $m;

				if ($this->anio=="")
					$this->anio=date("Y");
				if ($this->anio<1)
					$this->anio=date("Y");


				$aux=1;
				$encontradoanio=false;
				$ultmes = 0;


				while(!$encontradoanio || $aux<5)
				{
					$spnombre = "sel_tablas_propias_tablas_xfiltro_ultimomes";
					$spparam=array("pwhere"=>$this->filtrosql['where']);
					$spparam+=array("ptabla1"=>$this->filtrosql['tabla']);
					$spparam+=array("ptabla2"=>$this->filtrosql['tabla']);
					$spparam+=array("porderby"=>$this->filtrosql['orden']);
					$limit = "";
					if (isset($this->filtrosql['cantidad']))
					{
						$inicio = 0;
						$limit = " limit ".$inicio.",".$this->filtrosql['cantidad'];
					}
					$spparam+=array("plimit"=>$limit);


					$spparam+=array("pcampofecha1"=>$this->campofecha);
					$spparam+=array("pcampofecha2"=>$this->campofecha);
					$spparam+=array("pfechaanio"=>$this->anio);


					if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$queryultmes,$numfilasultmes,$errno))
					{
						$this->msg_error.="Error al buscar la última ".strtolower($this->arreglotitulos['TituloCorto'])." del año por mes.";
						return false;
					}
					if ($this->anio<2000)
						break;

					if ($numfilasultmes>0)
					{
						$datosultmes = mysqli_fetch_assoc($queryultmes);
						if ($datosultmes['ultmes']!="")
						{
							$ultmes = $datosultmes['ultmes'];
							$encontradoanio=true;
						}else
							$this->anio = $this->anio - 1;
					}else
						$this->anio = $this->anio - 1;
					$aux++;

				}
				$cerrarmenu = false;
				if ($numfilasultmes>0)
				{
					$salida .= "<div class=\"menulateral\">";
					$salida .= "	<ul class=\"clearfix\">";
					$cerrarmenu = true;
				}

				while ($i>0)
				{

					$spnombre = "sel_tablas_propias_tablas_xfiltro_xmes_anio_ordenadas";
					$spparam=array("pwhere"=>$this->filtrosql['where']);
					$spparam+=array("ptabla1"=>$this->filtrosql['tabla']);
					$spparam+=array("ptabla2"=>$this->filtrosql['tabla']);
					$spparam+=array("porderby"=>$this->filtrosql['orden']);
					$limit = "";
					if (isset($this->filtrosql['cantidad']))
					{
						$inicio = 0;
						$limit = " limit ".$inicio.",".$this->filtrosql['cantidad'];
					}
					$spparam+=array("plimit"=>$limit);

					$spparam+=array("pcampofecha1"=>$this->campofecha);
					$spparam+=array("pcampofecha2"=>$this->campofecha);
					$spparam+=array("pfechaanio"=>$this->anio);

					$spparam+=array("pestadomes"=>1);
					$spparam+=array("pestadoanio"=>0);
					if ($this->anio!="")
						$spparam["pestadoanio"]=1;

					$spparam+=array("pfechames"=>$i);
					if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$querymes,$numfilasmes,$errno))
					{
						$this->msg_error.="Error al buscar ".$this->arreglotitulos['Titulo']." por mes.";
						return false;
					}

					$borde = " ";
					if ($i==$ultmes)
						$borde = " style=\"border:none;\"";


					$querystring = FuncionesPHPPortal::ArmarQueryString("");
					$texto = ObetenerTextoMes($i);
					$seleccionado = " ";
					if (isset($this->mes) && $this->mes!="" && $this->mes==$i)
						$seleccionado = " class=\"seleccionado\"";

					$anio="";
					if ($this->anio!="")
						$anio = "&amp;anio=".$this->anio;

					$mes = "&amp;mes=".$i;
					$href = "paginas.dhtml?pagina=".$this->pagcod.$anio.$mes;
					if ($numfilasmes>0)
					{
						$salida .= "	<li>";
						$salida .= "		<a ".$borde.$seleccionado." href=\"".$href."\" title=\"".$this->arreglotitulos['Titulo']." de ".$texto."\">";
						$salida .= "			".$texto;
						if ($this->mostrarcantidad)
							$salida .= " (".$numfilasmes.")";
						$salida .= "		</a>";
						$salida .= "	</li>";
					}
					$i--;
				}
				if ($cerrarmenu)
				{
				$salida .= "	</ul>";
				$salida .= "</div>";
				}
			break;

			// Menu de Años
			case "CalendarioMenuAnios":

				$spnombre = "sel_tablas_propias_tablas_xfiltro_aniocondatos";
				$spparam=array("pwhere"=>$this->filtrosql['where']);
				$spparam+=array("ptabla1"=>$this->filtrosql['tabla']);
				$spparam+=array("ptabla2"=>$this->filtrosql['tabla']);
				$spparam+=array("porderby"=>$this->filtrosql['orden']);
				$limit = "";
				if (isset($this->filtrosql['cantidad']))
				{
					$inicio = 0;
					$limit = " limit ".$inicio.",".$this->filtrosql['cantidad'];
				}
				$spparam+=array("plimit"=>$limit);
				$spparam+=array("pcampofecha"=>$this->campofecha);

				$y = "";
				if ($this->anio!="")
					$y=$this->anio;

				$i=1;
				if($this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) && $numfilas>0)
				{
					$salida .= "<div class=\"separador\">&nbsp;</div>";
					$salida .= "<div class=\"menulateral\">";
					$salida .= "	<ul class=\"clearfix\">";
					while($filaanios=mysqli_fetch_assoc($query))
					{

						$spnombre="sel_tablas_propias_tablas_xfiltros";

						$spparam=array("pwhere"=>$this->filtrosql['where']);
						$spparam+=array("ptabla1"=>$this->filtrosql['tabla']);
						$spparam+=array("ptabla2"=>$this->filtrosql['tabla']);
						$spparam+=array("porderby"=>$this->filtrosql['orden']);
						$spparam+=array("plimit"=>"");
						$limit = "";

						if (isset($this->filtrosql['where']) && $this->filtrosql['where']!="")
							$spparam['pwhere'].=" and ";

						$spparam['pwhere'].=" YEAR(".$this->campofecha.") = ".$filaanios['anio'];

						if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$querycantdatosanio,$numfilasdatosanio,$errno))
						{
							$this->msg_error.="Error al buscar ".$this->arreglotitulos['Titulo']." por mes.";
							return false;
						}

						$borde = " ";

						if ($i==$numfilas)
							$borde = " style=\"border:none;\"";

						$querystring = FuncionesPHPPortal::ArmarQueryString("");
						$texto = $filaanios['anio'];
						$seleccionado = " ";

						if ($this->anio!="" && $this->anio==$filaanios['anio'])
							$seleccionado = " class=\"seleccionado\"";

						$anio = "&amp;anio=".$filaanios['anio'];
						$href = "paginas.dhtml?pagina=".$this->pagcod.$anio;

						$salida .= "	<li>";
						$salida .= "		<a ".$borde.$seleccionado." href=\"".$href."\" title=\"".$this->arreglotitulos['Titulo']." de ".$texto."\">";
						$salida .= "			".$texto;
						if ($this->mostrarcantidad)
							$salida .= " (".$numfilasdatosanio.")";
						$salida .= "		</a>";
						$salida .= "	</li>";
						$i++;

					}
					$salida .= "	</ul>";
					$salida .= "</div>";
				}else
					echo "error";


			break;

			case "CalendarioMenu":

				if ($this->anio=="")
					$this->anio=date("Y");

				if ($this->mes=="")
					$this->mes=date("m");

				if ($this->dia=="")
					$this->dia=1;

				$oCalendario = new cCalendario($this->conexionobjeto,$this->es_admin);

				// Hay que inicializar el parametro fecha
				$parametros['fecha'] = $this->anio."-".	str_pad($this->mes, 2, "0", STR_PAD_LEFT )."-".	str_pad($this->dia, 2, "0", STR_PAD_LEFT );
				$parametros['vistas'] = $this->vistas;
				$parametros['classcss'] = $this->classcss;
				$parametros['pagcod'] = $this->pagcod;
				$parametros['arreglotitulos'] = $this->arreglotitulos;
				$parametros['anoInicial'] = $this->anoInicial;
				$parametros['anoFinal'] = $this->anoFinal;

				if($oCalendario->Setear($parametros))
				{
					if(!$oCalendario->Mostrar($salida))
						$seprodujoerror=true;
				}


			break;




			// La ruta del mes
			case "Ruta":

				$href = "paginas.dhtml?pagina=1";
				$salida .= "<a href=\"".$href."\" title=\"Inicio\">Inicio</a>";
				if ($this->anio=="" && $this->mes=="" && $this->regdatocod=="")
				{
					$salida .= "&nbsp;> <strong>".$this->arreglotitulos['TituloRuta']."</strong>";
				}else
				{
					$href = "paginas.dhtml?pagina=".$this->pagcod;
					$salida .= "&nbsp;> <a href=\"".$href."\" title=\"".$this->arreglotitulos['TituloRuta']."\">".$this->arreglotitulos['TituloRuta']."</a>";
				}
				$anio = "";
				if ($this->anio!="")
					$anio = "&amp;anio=".$this->anio;
				if ($this->anio!="")
				{
					$href = "paginas.dhtml?pagina=".$this->pagcod.$anio;
					$salida .= "&nbsp;> <a href=\"".$href."\" title=\"".$this->arreglotitulos['TituloRuta']." de ".$this->anio."\">".$this->anio."</a>";
				}
				if ($this->mes!="")
				{
					if ($this->anio!="")
						$mes = "&amp;mes=".$this->mes;
					if ($this->regdatocod!="")
					{
						$href = "paginas.dhtml?pagina=".$this->pagcod.$anio.$mes;
						$salida .= "&nbsp;> <a href=\"".$href."\" title=\"".$this->arreglotitulos['TituloRuta']." de ".$this->anio."\">".ObetenerTextoMes($this->mes)."</a>";
					}else
					{
						$salida .= "&nbsp;> <strong>".ObetenerTextoMes($this->mes)."</strong>";
					}
				}
				if ($this->regdatocod!="")
				{
					$salida .= "&nbsp;> <strong>".$this->arreglotitulos['TituloCorto']."</strong>";
				}

			break;
		}

		return true;
	}

	function ObtenerTextoFecha($fecha)
	{
		$arrayfecha = explode('-', $fecha);
		$fechaint = mktime(0,0,0, $arrayfecha[1], $arrayfecha[2], $arrayfecha[0]);
		$fechasalida = strftime("%e de %B de %Y." ,$fechaint);
		return ReemplazarTextoFechas($fechasalida);
	}


	function RetornarMsgError()
	{
		return $this->msg_error;
	}


	function CalcularPaginado($canttotal,&$paginaanterior,&$paginasiguiente,&$ultimapagina,&$limit)
	{
		$paginarresultados = false;
		if ($canttotal > $this->cantidadpaginar)
		{
			$i=1;
			$paginicio = 0;
			while ($i<=$this->paginaactual)
			{
				$pagfin = $this->cantidadpaginar * $i;
				$paginicio = $pagfin - $this->cantidadpaginar;
				$i++;
			}

			if ($paginicio<$canttotal)
				$limit = " limit ".$paginicio.",".$this->cantidadpaginar;

			$ultimapagina = ceil($canttotal / $this->cantidadpaginar);

			if ($paginicio==0)
			{
				$paginasiguiente = 2;
				$paginaanterior = 1;
				$this->paginaactual = 1;
			}else
			{
				$paginasiguiente = $i;
				if ($paginasiguiente>$ultimapagina)
					$paginasiguiente = $ultimapagina;

				$paginaanterior = $i - 2;
				if ($paginaanterior<1)
					$paginaanterior = 1;
			}
			$paginarresultados = true;
		}
		return $paginarresultados;
	}

	function MostrarPaginado($paginaanterior,$paginasiguiente,$ultimapagina)
	{
		$querystring = FuncionesPHPPortal::ArmarQueryString("paginado");
		$querystring = str_replace("&","&amp;",$querystring);
		$salida = "<div class=\"paginar\">";
		$salida .= "		<hr />";
		$salida .= "		<div class=\"botones_izq\">";
		$salida .= "			<a href=\"paginas.dhtml?".$querystring."&amp;paginado=1\" title=\"Primer P&aacute;gina\">&lt;&lt;</a>";
		$salida .= "			&nbsp;&nbsp;&nbsp;";
		$salida .= "			<a href=\"paginas.dhtml?".$querystring."&amp;paginado=".$paginaanterior."\" title=\"P&aacute;gina Anterior\">&lt;</a>";
		$salida .= "		</div>";
		$salida .= "		<div class=\"txt_cen bold\">";
		$salida .= "			p&aacute;gina ".$this->paginaactual." de ".$ultimapagina;
		$salida .= "		</div>";
		$salida .= "		<div class=\"botones_der\">";
		$salida .= "			<a href=\"paginas.dhtml?".$querystring."&amp;paginado=".$paginasiguiente."\" title=\"P&aacute;gina Siguente\">&gt;</a>";
		$salida .= "			&nbsp;&nbsp;&nbsp;";
		$salida .= "			<a href=\"paginas.dhtml?".$querystring."&amp;paginado=".$ultimapagina."\" title=\"&Uacute;ltima P&aacute;gina\">&gt;&gt;</a>";
		$salida .= "		</div>";
		$salida .= "		<div class=\"clear\"></div>";
		$salida .= "</div>";

		return $salida;
	}

}//fin clase cTablaPropiaDinamica



class cCalendario
{
	var $conexionobjeto;
	var $msg_error;
	var $es_admin;

	var $pagcod;
	var $fecha;
	var $fechacompleta;

	var $anoInicial;
	var $anoFinal;

	var $classcss = "calendario";

	var $diaDefaultAnio = 1; // Cuando cambia el año, dia al que va por defecto

	private $meses = Array ('enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre');
	private $diasSem = Array ('Lun','Mar','Mié','Jue','Vie','Sab','Dom');

	var $vistas = array();

	var $arreglotitulos = array();

	function cCalendario($es_admin=false)
	{
		$this->conexionobjeto = new accesoBDPortal(SERVIDORBD,USUARIOBD,CLAVEBD);
		$this->conexionobjeto->SeleccionBD(BASEDATOS);
		$this->msg_error = "";
		$this->es_admin = $es_admin;

		$this->anoInicial = date('Y') - 1;
		$this->anoFinal = date('Y') + 1;
	}

	function Setear($parametros)
	{
		if (isset($parametros['fecha']) && $parametros['fecha']!="")
			$this->fecha = strtotime($parametros['fecha']);
		else
			$this->fecha = strtotime(date('Y-m-d'));

		$this->fechacompleta = getdate( mktime(0,0,0,date("m",  $this->fecha) ,date("d",  $this->fecha) ,date("Y",  $this->fecha) ));

		if (!isset($_GET['dia']))
			$this->fechacompleta['mday'] = "-1";


		if (isset($parametros['anoInicial']))
		{
			if (substr($parametros['anoInicial'],0,1)=="+")
				$this->anoInicial = date('Y') +  substr($parametros['anoInicial'],1);
			elseif(substr($parametros['anoInicial'],0,1)=="-")
				$this->anoInicial = date('Y') -  substr($parametros['anoInicial'],1);
			else
				$this->anoInicial = $parametros['anoInicial'];
		}

		if (isset($parametros['anoFinal']))
		{
			if (substr($parametros['anoFinal'],0,1)=="+")
				$this->anoFinal = date('Y') +  substr($parametros['anoFinal'],1);
			elseif(substr($parametros['anoFinal'],0,1)=="-")
				$this->anoFinal = date('Y') -  substr($parametros['anoFinal'],1);
			else
				$this->anoFinal = $parametros['anoFinal'];
		}


		if (isset($parametros['vistas']))
			$this->vistas = $parametros['vistas'];
		if (isset($parametros['classcss']))
			$this->classcss = $parametros['classcss'];
			// Pagina
		if (isset($parametros['pagcod']))
			$this->pagcod = $parametros['pagcod'];
		elseif(isset($_GET['pagina']))
			$this->pagcod = $_GET['pagina'];

		$this->arreglotitulos = $parametros['arreglotitulos'];
		return true;
	}

	function Mostrar(&$salida)
	{
		$seprodujoerror=false;
		$ruta=array();

		$this->EncabezadoCalendario($salida);

		foreach ($this->vistas as $vistas)
		{
			switch ($vistas)
			{
				case "ComboMeses":
					$this->ArmarComboMeses($salida);
					break;
				case "ComboAnios":
					$this->ArmarComboAnio($salida);
					break;
				case "TituloMesAnio":
					$this->ArmarTituloMesAnio($salida);
					break;
				case "Calendario":
					$this->ArmarHtmlCalendario($salida);
					break;
				case "Titulo":
					$this->ArmarTitulo($salida);
					break;
			}
		}

		if (count ($this->vistas) == 0 || !in_array("Calendario",$this->vistas))
			$this->ArmarHtmlCalendario($salida);

		$this->PieCalendario($salida);


		return true;
	}


	function EncabezadoCalendario(&$salida)
	{
		$salida .=" <div class='".$this->classcss." clearfix'>";
		$salida .=" <form name='formulario_calendario_".$this->pagcod."' method='post' action='paginas.dhtml?pagina=".$this->pagcod."'>
					<div class='caja_calendario clearfix'>
					<div class='calendario_dias'>";

		return true;
	}

	function PieCalendario(&$salida)
	{

		$salida .="</div>
			</div>
		</form>
		</div>";

	}

	function ArmarHtmlCalendario(&$salida)
	{
		$querystring = FuncionesPHPPortal::ArmarQueryString("pagina");
		$fechaInicioMes = mktime(0,0,0,$this->fechacompleta['mon'],1,$this->fechacompleta['year']);
		$fechaInicioMes = date("w",$fechaInicioMes);



		$salida .='<div class="calendario_dias">';

		$ultimoDia = date('t',$this->fecha);
		$numDia = 0;
		for ($fila = 0; $fila < 7; $fila++){
			$class="";
    		if($fila == 0)
    			$class .='class="lst_dias_semanales clearfix"';

 			$salida .= "<div class='clear'></div><ul ".$class.">";
  			for ($coln = 0; $coln < 7; $coln++){
    				$posicion = Array (1,2,3,4,5,6,0);
    				$salida .='        <li';

   				$salida .= " >\n";
    			$salida .= '      ';

    			if($fila == 0)
    				$salida .= $this->diasSem[$coln];
    			elseif(($numDia && $numDia < $ultimoDia) || (!$numDia && $posicion[$coln] == $fechaInicioMes))
    			{
       				$class="";
     				$numDia = $numDia + 1;
    				if($this->fechacompleta['mday'] == $numDia)
   	   					$class = 'class="seleccionado"';
      				$salida .= '<a '.$class.' href="paginas.dhtml?pagina='.$this->pagcod.'&amp;dia='.$numDia.'&amp;mes='.$this->fechacompleta['mon'].'&amp;anio='.$this->fechacompleta['year'].'" title="Ir al día '.$numDia.'/'.$this->fechacompleta['mon'].'/'.$this->fechacompleta['year'].'">';
     				$salida .= $numDia;
     				$salida .= '</a>';
    			}else
    				$salida .= "&nbsp;";
  	 		$salida .= "</li>\n";
  		}
 		$salida .= "      </ul>\n";

	}
	$salida .="</div>";

		return true;
	}

	function ArmarTituloMesAnio(&$salida)
	{

		$salida .="		<div class='titulo_mes_actual'>";
		$salida .= $this->meses[$this->fechacompleta['mon']-1]. " de " . $this->fechacompleta['year'];
		$salida .="		</div>";


		return true;
	}

	function ArmarTitulo(&$salida)
	{

		$salida .="		<div class='titulo'>";
		$salida .= $this->arreglotitulos['Titulo'];
		$salida .="		</div>";


		return true;
	}

	function ArmarComboAnio(&$salida)
	{

		$querystring = FuncionesPHPPortal::ArmarQueryString("pagina");
		$salida .="		<div class='combo_anio'>";

		$salida .="		<select size='1' name='ano' class='m1' onchange='document.location = \"?pagina=".$this->pagcod."&amp;mes=".$this->fechacompleta['mon']."&amp;anio=\" + document.formulario_calendario_".$this->pagcod.".ano.value;'>";
				for ($i = $this->anoInicial; $i <= $this->anoFinal; $i++){
					 $salida.= '      <option ';
					  if($this->fechacompleta['year'] == $i)
					  	$salida.='selected = "selected" ';
					  $salida.= 'value="'.$i.'">'.$i."\n";
					  $salida.= '</option>';
					}
		$salida .="		</select>";
		$salida .="		</div>";


		return true;
	}

	function ArmarComboMeses(&$salida)
	{
		$querystring = FuncionesPHPPortal::ArmarQueryString("pagina");

		$salida .=" <div class='combo_mes'>";

		$salida .="		<select size='1' name='mes' class='m1' onchange='document.location = \"?pagina=".$this->pagcod."&amp;mes=\" + document.formulario_calendario_".$this->pagcod.".mes.value + \"&amp;anio=".$this->fechacompleta['year']."\";'>";
					for($i = 1; $i <= 12; $i++){
  						$salida.= '      <option ';
  						if($this->fechacompleta['mon'] == $i)
  							$salida.='selected= "selected" ';

  						$salida.= 'value="'.$i.'">'.$this->meses[$i-1]."\n";
  						$salida.= '</option>';
					}
		$salida .="		</select>";
		$salida .="		</div>";


		return true;
	}


}//FIN CLASE CALENDARIO


?>