								FuncionesPHPLocal::ArmarCombo_SinSalto_BD($conexion,$spnombre,$spparam,"formulario","sede_codigo","sede_codigo","sede_descripcion",($es_modif)?$filacomision['sede_codigo']:"","-- Seleccione una Sede",$filasede_codigo,$selesede_codigo);
						} ?>				
					</td>
				</tr>
				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Domicilio</td>
					<td class="textoEtiquetaDatoResaltado">
						<textarea cols="100"  name="comi_domicilio"  style="width:400px" class=<?php echo ($operacion=="V")?"'inputReadonly' readonly='true'":"'textoInput'" ?>><?php echo ($es_modif) ? htmlspecialchars($filacomision['comi_domicilio'],ENT_QUOTES):"" ?></textarea>
						<?php if ($operacion!="V") {  ?>
							<br><span class="textoAclaraciones">Nota: La longitud del domicilio debe ser menor a 150 caracteres. </span>
						<?php } ?>
					</td>
				</tr>							
				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Detalle</td>
					<td class="textoEtiquetaDatoResaltado">
						<textarea cols="100"  name="comi_detalle"  style="width:400px" class=<?php echo ($operacion=="V")?"'inputReadonly' readonly='true'":"'textoInput'" ?>><?php echo ($es_modif) ? htmlspecialchars($filacomision['comi_detalle'],ENT_QUOTES):"" ?></textarea>
						<?php if ($operacion!="V") { ?>
							<br><span class="textoAclaraciones">Nota: La longitud del detalle debe ser menor a 150 caracteres. </span>
						<?php } ?>
					</td>
				</tr>							
				</table>
				</fieldset> 
			</td>
		</tr>
		
<?php		if ($operacion=="V") { ?>
		<tr>
			<td colspan="2" align="right">
				<?php 	$oComisionPrestadorDocente = new cComisionPrestadorDocente($this->conexion);
					$oComisionPrestadorDocente->MostrarPrestadoresComision($this->conexion,$filacomision['comi_codigo']);	
				?>	
			</td>
		</tr>
<?php 		} ?>		

	</table>		
<?php 
	return true;
  } 
//-----------------------------------------------------------------------------------------
	function AltaDatosComision($datos,&$comi_codigo_nuevo, &$comi_codinap) {

		

		// busco el número de secuencia
		$spnombre="sel_valor_unico";
		$spparam=array();
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			$txt_sys_mail = "Error al generar el código único de actividad. (codigo temporal)";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al dar el alta de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato), $txt_sys_mail );
			return false;
		}
		$fila = mysqli_fetch_assoc($resultado);

		$datos["comi_codinap"]= $_SESSION['usuariocod'].$fila['time_seg'];

		if(!$this->_DatosValidosAltaComision($datos,$datosvalidados))
			return false;
		
		$spnombre="ins_comision";
		$spparam=array(
				'pact_codigo'=>$datosvalidados['act_codigo'] ,
				'pactprog_sec'=>$datosvalidados['actprog_sec'] ,
				'pcomi_codinap'=> $datosvalidados['comi_codinap'],
				'ptipoins_codigo'=> $datosvalidados['tipoins_codigo'],
				'pcomi_fecha_inicio'=> "NULL",
				'pcomi_fecha_fin'=> "NULL",
				'ppais_codigo'=> $datosvalidados['pais_codigo'],
				'pprov_codigo'=> $datosvalidados['prov_codigo'],
				'psede_codigo'=> $datosvalidados['sede_codigo'],
				'pcomi_acta_numero'=> "NULL",
				'pcomi_domicilio'=> $datosvalidados['comi_domicilio'],
				'pcomi_detalle'=> $datosvalidados['comi_detalle'],
				'pcomi_vacantes'=> $datosvalidados['comi_vacantes'],
				'pcomi_sobreventa'=> $datosvalidados['comi_sobreventa'],
				'pcomi_web'=> $datosvalidados['comi_web'],
				'pcomi_estado'=>COMISIONNUEVA,
			  	'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s") 
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} 
		$comi_codigo_nuevo = $this->conexion->ultimocodigoinsertado();


		if(!$this->ObtenerCodigoInap($datos['act_codigo'],$comi_codinap)){
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al generar el Código de Comisión INAP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;			
		}				
		$datosvalidados['comi_codinap'] = $comi_codinap."-".$comi_codigo_nuevo;
		
		$spnombre="upd_comision_codinap_xcomi_codigo";
		$spparam=array(
				'pcomi_codinap'=> $datosvalidados['comi_codinap'],
				'pcomi_codigo'=> $comi_codigo_nuevo,
			  	'pultmodusuario'=>$_SESSION['usuariocod'],
  			    'pultmodfecha'=> date("Y/m/d H:i:s") 
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			$txt_sys_mail="Error al modificar la comision\ncomi_codigo=".$datosvalidados['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}		
		
		$comi_codinap = $datosvalidados['comi_codinap'];
		
		return true;
	}	
//-----------------------------------------------------------------------------------------
	function ModifDatosComision($datos)	{

		
		if(!$this->_DatosValidosModifComision($datos,$datosvalidados))
			return false;
			
		//print_r($datosvalidados);

		$spnombre="upd_comision";
		$spparam=array(
				'pcomi_codigo'=> $datosvalidados['comi_codigo'],
				'ptipoins_codigo'=> $datosvalidados['tipoins_codigo'],
				'ppais_codigo'=> $datosvalidados['pais_codigo'],
				'pprov_codigo'=> $datosvalidados['prov_codigo'],
				'psede_codigo'=> $datosvalidados['sede_codigo'],
				'pcomi_domicilio'=> $datosvalidados['comi_domicilio'],
				'pcomi_detalle'=> $datosvalidados['comi_detalle'],
				'pcomi_vacantes'=> $datosvalidados['comi_vacantes'],
				'pcomi_sobreventa'=> $datosvalidados['comi_sobreventa'],
				'pcomi_web'=> $datosvalidados['comi_web'],
			  	'pultmodusuario'=>$_SESSION['usuariocod'],
  			    'pultmodfecha'=> date("Y/m/d H:i:s") 
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			$txt_sys_mail="Error al modificar la comision\ncomi_codigo=".$datosvalidados['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}	
//-----------------------------------------------------------------------------------------
	function EliminarDatosComision($comi_codigo) {

		if(!$this->_DatosValidosEliminarComision($comi_codigo,$datosvalidados))
			return false;

		// Eliminar cronograma 
		$oComisionCronograma= new cComisionCronograma($this->conexion);
		if(!$oComisionCronograma->EliminarCronogramaComision($comi_codigo))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"50202","Global / comi_codigo=".$comi_codigo,$_SESSION['usuariocod']);

		// Eliminar docentes
		$oComisionPrestadorDocente = new cComisionPrestadorDocente($this->conexion);
		if(!$oComisionPrestadorDocente->EliminarComisionPrestadorDocenteTodos($comi_codigo))
			return false;		
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"50302","Global / comi_codigo=".$comi_codigo,$_SESSION['usuariocod']);

		// Eliminar los inscriptos de la comisión
		$oComisionPersona = new cComisionPersona($this->conexion);
		if(!$oComisionPersona->EliminarDatosComisionAlumnos($comi_codigo))
			return false;		
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"50402","Global /comi_codigo=".$comi_codigo,$_SESSION['usuariocod']);

		// Eliminar comisión 
		$spnombre="del_comision";
		$spparam=array('pcomi_codigo'=>$comi_codigo);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail="Error al eliminar la comisión\ncomi_codigo=".$comi_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
			
		return true;
	}	
//-----------------------------------------------------------------------------------------
	function AbrirComision($datos) {

		if (!$this->_DatosValidosAbrirComision($datos,$datosvalidados))
		   return false; 

		$spnombre="upd_comision_cambio_estado";
		$spparam=array(
				'pcomi_codigo'=> $datosvalidados['comi_codigo'],
				'pcomi_estado'=> COMISIONABIERTA,
			  	'pultmodusuario'=>$_SESSION['usuariocod'],
	            'pultmodfecha'=> date("Y/m/d H:i:s") 
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			$txt_sys_mail="Error al abrir la comision\ncomi_codigo=".$datosvalidados['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al abrir la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		$spnombre="sel_comision_proximo_nro_acta";
		$spparam=array();
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			$txt_sys_mail="Error al abrir la comisión obteniendo el proximo nro de acta\ncomi_codigo=".$datosvalidados['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al abrir la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}
		$fila_nro_acta = mysqli_fetch_assoc($resultado);

		$spnombre="upd_comision_xcomi_acta_numero";
		$spparam=array(
				'pcomi_acta_numero'=>$fila_nro_acta['proximo_nro_acta'], // Ya lo trae + 1 
				'pcomi_codigo'=> $datosvalidados['comi_codigo'],
			  	'pultmodusuario'=> $_SESSION['usuariocod'],
	            'pultmodfecha'=> date("Y/m/d H:i:s") 
		);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			$txt_sys_mail="Error al abrir la comisión actualizando el número de acta \ncomi_codigo=".$datosvalidados['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al abrir la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,'50105',"comi_codigo=".$datosvalidados['comi_codigo']."-"."acta_numero=".$fila_nro_acta['proximo_nro_acta'],$_SESSION['usuariocod']);

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function CerrarComision($datos) {
		$oComisionPersonaCandidato= new cComisionPersonaCandidato($this->conexion);

		if (!$this->_DatosValidosCerrarComision($datos,$datosvalidados,$otros_errores))
		   return false; 

		// elimino todos los candidatos para la comisión
		if (!$oComisionPersonaCandidato->EliminarDatosInscripcionWebdeComision($datosvalidados,$resultado,$numfilas))
		   return false; 

		$spnombre="upd_comision_cambio_estado";
		$spparam=array(
				'pcomi_codigo'=> $datosvalidados['comi_codigo'],
				'pcomi_estado'=> COMISIONCERRADA,
			  	'pultmodusuario'=>$_SESSION['usuariocod'],
	            'pultmodfecha'=> date("Y/m/d H:i:s") 
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			$txt_sys_mail="Error al cerrar la comisión\ncomi_codigo=".$datosvalidados['comi_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al cerrar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function CertificarComision($datos) {

		if (!$this->DatosValidosCertificarComision($datos,$datosvalidados,$array_errores))
		   return false; 

		$spnombre="upd_comision_cambio_estado";
