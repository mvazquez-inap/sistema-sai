				$organismo=$this->array_datos['datos_actividad']['actividad_externa']['orgapub_nombre'];
			elseif (isset($this->array_datos['datos_actividad']['actividad_externa']['orgapri_codigo']))
				$organismo=$this->array_datos['datos_actividad']['actividad_externa']['orgapri_nombre'];
			else 
				$organismo=$this->array_datos['datos_actividad']['actividad_externa']['jurisdid_apn_nombre'];

			$dato_mostrar[]	 = array ('rotulo' => "Organismo", 'valor' => $organismo);			
			$dato_mostrar[]	 = array ('rotulo' => "Observaciones", 'valor' => $this->array_datos['datos_actividad']['actividad_externa']['actext_obs']);			

		} // formato actividad externa
		
		
		
		if ($this->array_datos['formact_codigo']==FORMATOEFORMAL) {

