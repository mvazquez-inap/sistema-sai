		if($num_filas>0) 
		{
			// Recorre el cursor desde el principio, poniendo cada fila en una linea del combo
			while ($fila = mysql_fetch_assoc($resultado))
			{ 
				if($fila[$clavecombo]==$claveselec) 
				{
					echo "<option selected value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
					$seleccionado=true;
					$regactual=$fila;
				}
				else
					echo "<option value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
			}
		}
	
		echo("</select>\n");
		echo "<br><a href='javascript:void(0)' onClick=\"javascript:popup('ventanatexto.dhtml?textopopup='+".$nomformulario.".".$nombrecombo."[".$nomformulario.".".$nombrecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkfondoblanco'><span class='textoaclaraciones'>Ver texto completo</span></a>\n";
	}

