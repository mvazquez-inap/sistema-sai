	// ----------------------------------------------------------------------------------------------------------------
	if (isset($_POST['detalleCreditosPorFormato']))
		$result = $oWsCreditosPersonales->getDetalleCreditosPorFormato($_POST['formact_codigo'],$_POST['pers_cuit'],$_POST['fdesde'],$_POST['fhasta']);
}

// ----------------------------------------------------------------------------------------------------------------
// Tablas del sistema
