function DatosValidosCertificarComision($datos,&$datosvalidados,&$hay_otros_errores) {

	// 	El usuario tiene permiso de certicar la comisión y la comisión tiene que estar cerrada
	if (!$this->TienePermisoCertificar($datos['comi_codigo'],$_SESSION['rolcod'], $_SESSION['jurisdid_inap'])) 
		return false; 

	// Busco los datos de la comision.
	$ArregloDatos=array("comi_codigo"=>$datos['comi_codigo'],"comi_estado"=>COMISIONCERRADA);	
	if(!$this->BuscarComision($ArregloDatos,$numfilas,$resulcomi,$error,$errormail)) {
		$txt_sys_mail="Error al buscar para la comisión CERRADA - \ncomi_codigo=".$datos['comi_codigo'];
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	} elseif ($numfilas!=1) {
		$txt_sys_mail="Hay cero o más de un registros para la comisión (si fue seleccionada debería poder abrirse)\ncomi_codigo=".$datos['comi_codigo'];
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la comisión no permite su certificación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	} 
	$fila_comision=mysqli_fetch_assoc($resulcomi);
	
	// La actividad de la comisión tiene que tener dictamen aprobado con disposición
	$ArregloDatos= array();
	$ArregloDatos['act_codigo'] = $fila_comision["act_codigo"];
	$ArregloDatos['actprog_sec'] = $fila_comision["actprog_sec"];
	$ArregloDatos['dic_estado'] = DICTAMENACTIVO;
	$ArregloDatos['formact_codigo'] = FORMATOCURSO;
	$ArregloDatos['con_disposicion'] = 1;				

	$oActividad = new cActividadCurso($this->conexion);
	if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result,$error,$errormail)){
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;								
	}	
	if($numfilas!=1) {
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión no puede ser certificada hasta que <br> el dictamen de la actividad este aprobado y tenga disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;								
	}

	$datosvalidados = array();
	$datosvalidados['comi_codigo']=$datos['comi_codigo'];

	// tiene un POC asociado a la actividad		
	if ($oActividad->EsActividadCursoTipo($fila_comision["act_codigo"],TIPOACTCURSOJURISD,$error,$errormsg)) {
		if (!$this->ValidarActividadPoc($datos['comi_codigo'],$_SESSION['jurisdid_inap'])) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La comisión no puede ser certificada pues la actividad <br> no esta asociada al POC del año de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false; 			
		}
	}

		
///////////////////////////////////////////////////////////////////////////////-----				
