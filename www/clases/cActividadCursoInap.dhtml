					<?php  if (!$es_modif) { ?>
					 		<input type="hidden" name="act_codinap" id="act_codinap" size="21" maxlength="20" value="##">
					<?php  } ?>
					</td>
				</tr>

				<?php  if ($es_modif) { ?>
					<tr>
						<td valign="top" width="15%" class='textoEtiqueta'>Código INAP</td>
						<td class="textoEtiquetaDatoResaltado">
						<input type="text" name="act_codinap" id="act_codinap" class="inputReadonly" readonly="readonly" size="21" maxlength="20" value="<?=htmlspecialchars($filacurso['actividad']['act_codinap'],ENT_QUOTES)?>">
						</td>
					</tr>
				<?php  } ?>

				<tr>
					<td valign="top" width="25%" class='textoEtiqueta'>Observación</td>
