//-----------------------------------------------------------------------------------------------------	
	function BuscarPrestadorDocentexActividad($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		// Busca en actividad_curso_prestador_docente, prestador_docente
		// Retorna la información del prestador 
		$sparam= array('pxact_codigo'=>0);
		$sparam+=array('pxpresdoc_codigo'=>0);
		$sparam+=array('pxpresdoc_estado'=>0);
		$sparam+=array('pxactpres_estado'=>1);

		$sparam+=array('pact_codigo' =>"");
		$sparam+=array('ppresdoc_codigo' =>"");
		$sparam+=array('ppresdoc_estado' =>"-1");		
		$sparam+=array('pactpres_estado'=>ACTPRESDOCACTIVO);

		$sparam+=array('porderby' =>"presdoc_apellido,presdoc_nombre");

		if (isset ($ArregloDatos['act_codigo']))
		{
			if ($ArregloDatos['act_codigo']!="")
			{	
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}
		if (isset ($ArregloDatos['presdoc_codigo']))
		{
			if ($ArregloDatos['presdoc_codigo']!="")
			{	
				$sparam['ppresdoc_codigo']= $ArregloDatos['presdoc_codigo'];
				$sparam['pxpresdoc_codigo']= 1;
			}
		}
		if (isset ($ArregloDatos['presdoc_estado']))
		{
			if ($ArregloDatos['presdoc_estado']!="")
			{	
				$sparam['ppresdoc_estado']= $ArregloDatos['presdoc_estado'];
				$sparam['pxpresdoc_estado']= 1;
			}
		}
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_actividad_curso_prestador_docente_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el Prestador Docente .";
			$errormail="Error al buscar Prestador Docente".$errno;
			return false;
		}

		return true;
	}
