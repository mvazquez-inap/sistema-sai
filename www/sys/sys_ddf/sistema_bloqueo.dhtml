//--------------------------------------------------------------------------
// Para el manejo del BLOQUEO DEL SISTEMA.
//--------------------------------------------------------------------------
// Muestra el mensaje de Bloqueo
require_once('sys_ddf/funciones_php.dhtml'); 

function mostrar_aviso($aviso,$fecha) {	
	echo "<table width='100%' border='0' cellspacing='0' cellpadding='0' >
	      <tr> <td class='textoAvisoBloqueo'>";
		  echo 'El sistema se bloqueará el '.ConvertirFecha($fecha,'aaaa-mm-dd','dd/mm/aaaa').' '. ' a las '.ObtenerHsMin($fecha).' hs. <BR>';				
  	      echo $aviso."<br>";  		  
	echo "</td></tr></table>";
}
//--------------------------------------------------------------------------
function mostrar_aviso_off_line($mensaje) {	
?> 
	<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 TRANSITIONAL//EN"> 
	<html>
	<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
