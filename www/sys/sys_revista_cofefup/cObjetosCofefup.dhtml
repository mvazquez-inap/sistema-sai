	public function MostrarEdicionHeader() {
	 	
		$oPublicacion = new cPublicaciones($this->conexion);		
		$datosbusqueda = array ('estadopub' => ESTPUBPUBLICADA);		
	 	$tipo = 0; 	// Distinto de 1 porque no quiero el count
	
	 	if (!$oPublicacion->BusquedaAvanzada($datosbusqueda,$tipo,$resultado,$numfilas) || $numfilas!=1)
			die();		
		
		$registro=mysqli_fetch_assoc($resultado);	 	
		//$fecha_mes_anio_txt = $this->ReemplazarTextoFechas(strftime("%e de %B de %Y." ,strtotime($resu_fila['fecha_edicion'])));
		$fecha_mes_anio_txt = $this->ObtenerTextoFechaMesAnio(substr($registro['fecha_edicion'],0,9));
		$salida="<div> ".
	 				$fecha_mes_anio_txt.
	 				" <br /> A&ntilde;o ".$registro['anio_edicion']." N&#176; ".$registro['numero_edicion'].
	 				"<br /> Rep&uacute;blica Argentina".
	 		    "</div>";	 	
	 	echo $salida;
	 				
	}	
