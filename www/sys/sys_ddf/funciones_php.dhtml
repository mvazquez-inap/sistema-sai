function MandarMail($idconexion,$rolcod,$jurisdid,$subject,$texto) {
  
	switch($rolcod) {
		case ADMI_SISTEMA:
			$spparam=array('prol_codigo'=>$rolcod,'pusurol_estado'=>USUARIO_ACT);		
			$spnombre="sel_mail_usuario_con_mail_xrol_menorestado";
			break;
		case USUA_RRHH:			
		    $jurisdsafid=TraerCampo($idconexion,"jurisdiccion_ddf","jurisdsafid",array("jurisdid=",$jurisdid));
			$spparam=array('prol_codigo'=>$rolcod,'pjurisdid'=>$jurisdsafid,'pusurol_estado'=>USUARIO_ACT);
			$spnombre="sel_mail_usuarios_rrhh_con_mail_xjurisdiccion_xmenorestado";
			break;		
		default:
			MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Intento de enviar mail a rol inexistente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);
			return false;
	}
	
	if(!isset($spnombre)) {
		MostrarMensaje_viejo($idconexion,MSG_ERRGRAVE,"Error al generar el mail.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),FMT_TEXTO);
		return false;
	}

	// Cabeceras adicionales
	$cabeceras = "Content-type: text/plain; charset=utf-8\r\n";
	$cabeceras .= "From: ".MAIL_SISTEMA_FROM;
							
	$query=ejecutarStoredProcedure($idconexion,$spnombre,$spparam);
	while($fila=mysqli_fetch_assoc($query))	{ 
	echo $texto;
/*		if(!mail($fila['usurol_email'],$subject,$texto,$cabeceras)) {
			echo "<BR> Imposible enviar mail. <BR>";
			return false;
		}
*/		
	}	

	return true;	
}
//----------------------------------------------------------------------------------------- 
function ConvertirPeriodo($periodo,$formatoinput,$formatooutput) {
	if($periodo=='') return "";
	
	if($formatoinput=='mm/aaaa' && $formatooutput=='aaaamm')
		return substr($periodo,3,4).substr($periodo,0,2);
	elseif($formatoinput=='aaaamm' && $formatooutput=='mm/aaaa')
		return substr($periodo,4,2)."/".substr($periodo,0,4);
}
//----------------------------------------------------------------------------------------- 
function ConvertirFecha($fecha,$formatoinput,$formatooutput)
{
	if($fecha=='') return "";
	
	if($formatoinput=='dd/mm/aaaa' && $formatooutput=='aaaa/mm/dd')
		return substr($fecha,6,4)."/".substr($fecha,3,2)."/".substr($fecha,0,2);
	elseif($formatoinput=='aaaa-mm-dd' && $formatooutput=='dd/mm/aaaa')
		return substr($fecha,8,2)."/".substr($fecha,5,2)."/".substr($fecha,0,4);
	elseif($formatoinput=='timestamp' && $formatooutput=='dd/mm/aaaa')
		return substr($fecha,6,2)."/".substr($fecha,4,2)."/".substr($fecha,0,4);
}
//----------------------------------------------------------------------------------------- 
function MostrarMensaje_viejo($idconexion,$nivelmensaje,$texto,$ubicerror,$formatomensaje,$cantcols=1) {

	if ($nivelmensaje==MSG_ERRGRAVE) {
	    $texto="<div class='textoMensajeError'>".$texto;
		$texto.=" <BR> Avise al Administrador del Sistema.";
		$texto=$texto."</div>";
	}

	switch($nivelmensaje) {
		case MSG_OK:
		case MSG_INF:
		case MSG_ERRGRAVE:
		case MSG_ERRSOSP:
			if($formatomensaje==FMT_TEXTO)
				echo "<div align='center' class='textoMensaje'>".$texto."<br></div> ";	
			elseif($formatomensaje==FMT_TABLA)	{ ?>
				<tr class="textoMensaje">
					<td colspan="<?php echo $cantcols ?>" height="100" align="center" valign="middle">
						<?php echo $texto ?>
					</td>
				</tr>	
		<?php }
			else
				echo $texto;	
			break;
	}

	// Envio de mail según el nivel de gravedad del mismo
	switch($nivelmensaje) 	{
		case MSG_ERRGRAVE:
			$subject="( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." ) - Error de Inconsistencia de Datos.";
			$textomail="Se produjo un error:\n";
			$textomail.="  Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";
			$textomail.="  Ubic Archivo: ".$ubicerror['archivo']."\n";
			$textomail.="  Ubic Función: ".($ubicerror['funcion']==""?"-":$ubicerror['funcion'])."\n";
			$textomail.="  Ubic Línea: ".$ubicerror['linea']."\n";
			$textomail.="Texto error:".$texto."\n";
			$textomail.="Usuario sesion: ".$_SESSION['pers_cuilt']."\n";
			MandarMail($idconexion,ADMI_SISTEMA,"",$subject,$textomail); 
			break;
		case MSG_ERRSOSP:
			$subject="( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." ) - Error Datos Sospechosos.";
			$textomail="Se produjo un error:\n";
			$textomail.="  Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";
			$textomail.="  Ubic Archivo: ".$ubicerror['archivo']."\n";
			$textomail.="  Ubic Función: ".($ubicerror['funcion']==""?"-":$ubicerror['funcion'])."\n";
			$textomail.="  Ubic Línea: ".$ubicerror['linea']."\n";
			$textomail.="Texto error:".$texto."\n";
			$textomail.="Usuario sesion: ".$_SESSION['pers_cuilt']."\n";
			MandarMail($idconexion,ADMI_SISTEMA,"",$subject,$textomail);
			break;
	}
}

