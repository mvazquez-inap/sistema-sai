<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccion($conexion) {

	$oPrestadorDocente= new cPrestadorDocente($conexion);

	$ArregloDatos['presdoc_estado']=PRESDOCACTIVO;
	$ArregloDatos['orderby']='presdoc_apellido, presdoc_nombre';
	
	if(!$oPrestadorDocente->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)){
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}
	$i=0;
	while ($filaresult=mysqli_fetch_assoc($result))
	{
		$arrayresult[$i]['presdoc_cuilt']= $filaresult['presdoc_cuilt'];
		$arrayresult[$i]['presdoc_apellido']= $filaresult['presdoc_apellido'];
		$arrayresult[$i]['presdoc_nombre']= $filaresult['presdoc_nombre'];
		$conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","PRESDOCCARACTER","' and constantecod='",$filaresult['presdoc_caracter_alta'],"'"),$caracterdesc,$numfilascaracter,$errorcod);
		$arrayresult[$i]['presdoc_caracter_alta']= $caracterdesc;
		$arrayresult[$i]['presdoc_falta_prov'] = FuncionesPHPLocal::ConvertirFecha($filaresult['presdoc_falta_prov'],'aaaa-mm-dd','dd/mm/aaaa');
		$arrayresult[$i]['presdoc_falta_def'] = FuncionesPHPLocal::ConvertirFecha($filaresult['presdoc_falta_def'],'aaaa-mm-dd','dd/mm/aaaa');
		$i++;
		
	}

	if ($numfilas ==0) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No hay Prestadores Docentes a listar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
	}
	
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
//		"FilasPagina"=>$numfilas
		"FilasPagina"=>TAMANO_PAGINA_30
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
	
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'CUIT/CUIL');
	$oGrilla->Setear('campo_grilla',$miColumna1,'presdoc_cuilt');
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	
	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Apellido');
	$oGrilla->Setear('campo_grilla',$miColumna2,'presdoc_apellido');
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Nombre');
	$oGrilla->Setear('campo_grilla',$miColumna3,'presdoc_nombre');
	$oGrilla->Setear('align_columna',$miColumna3,'left');

	$miColumna4 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Caracter');
	$oGrilla->Setear('campo_grilla',$miColumna4,'presdoc_caracter_alta');
	$oGrilla->Setear('align_columna',$miColumna4,'left');
	
	$miColumna5 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna5,'Fecha Alta Provisorio');
	$oGrilla->Setear('campo_grilla',$miColumna5,'presdoc_falta_prov');
	$oGrilla->Setear('align_columna',$miColumna5,'center');

	$miColumna6 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna6,'Fecha Alta Definitivo');
	$oGrilla->Setear('campo_grilla',$miColumna6,'presdoc_falta_def');
	$oGrilla->Setear('align_columna',$miColumna6,'center');

	if (!$oGrilla->CargarGrilla($arrayresult))
//	if (!$oGrilla->CargarGrilla($result))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
//----------------------------------------------------------------------------------------- 
