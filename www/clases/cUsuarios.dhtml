			$spparam["pusuarioapellido"]=$datosbuscar["usuarioapellido"];
		if(isset($datosbuscar["usuariocuit"]))
			$spparam["pusuariocuit"]=$datosbuscar["usuariocuit"];
		if(isset($datosbuscar["usuarioemail"]))
			$spparam["pusuarioemail"]=$datosbuscar["usuarioemail"];

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		return true;
	}
*/
//----------------------------------------------------------------------------------------- 
// Agrega un nuevo usuario al sistema

// Parámetros de Entrada:
//		datos: array asociativo con los datos a agregar

// Retorna:
//		nuevapwd: la password generada para el usuario
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function AltaUsuario($datos,&$nuevapwd)	{

		// Se pueden hacer las validaciones acá

		$nuevapwd=FuncionesPHPLocal::GenerarPassword(6);

		$spnombre="ins_usuarios";
		$spparam=array("pusuariocuit"=>$datos["usuariocuit"]);
		$spparam+=array("pusuarionombre"=>$datos["usuarionombre"]);
		$spparam+=array("pusuarioapellido"=>$datos["usuarioapellido"]);
		$spparam+=array("pusuarioemail"=>$datos["usuarioemail"]);
		$spparam+=array("pusuariopassword"=>md5($nuevapwd));
		$spparam+=array("pusuarioestado"=>USUARIONUEVO);
		$spparam+=array("pusuariodioalta"=>$_SESSION['usuariocod']);
		$spparam+=array("pusuariofalta"=>date("Y/m/d H:i:s"));
		$spparam+=array("pultmodusuario"=>$_SESSION['usuariocod']);
		$spparam+=array("pultmodfecha"=>date("Y/m/d H:i:s"));
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudo dar de alta el usuario. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	
	}
	
//----------------------------------------------------------------------------------------- 
// Da de baja un usuario

// Parámetros de Entrada:
//		usuariocod: usuario a modificar los datos

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function EliminarUsuario($usuariocod)
	{

		$roles=new cRoles($this->conexion);
	
		if(!$roles->RolesDeUnUsuario($usuariocod,$numfilasroles,$resultadoroles))
			return false;
			
		if($numfilasroles!=0)
			return false;
			
		$spnombre="upd_usuarios_estado_xusuariocod";
		$spparam=array("pusuariocod"=>$usuariocod);				
		$spparam+=array("pusuarioestado"=>USUARIOBAJA);				
		$spparam+=array("pultmodusuario"=>$_SESSION['usuariocod']);
		$spparam+=array("pultmodfecha"=>date("Y/m/d H:i:s"));
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al dar de baja el usuario. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		return true;
	}
	
//----------------------------------------------------------------------------------------- 
// Modifica los datos del usuario

// Parámetros de Entrada:
//		usuariocod: usuario a modificar los datos
//		datos: array asociativo con los datos a agregar

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function ModificarUsuario($usuariocod,$datos,&$errno)	{
		

		$ArregloDatos['usuariocod']=$usuariocod;
		if (!$this->BuscarUsuarios ($ArregloDatos,$numfilas,$resultadousuarios,$error,$errormail) || $numfilas!=1)
			return false;
	
		$spnombre="upd_usuarios_xusuariocod";
		$spparam=array("pusuariocod"=>$usuariocod);
		$spparam+=array("pusuariocuit"=>$datos["usuariocuit"]);
		$spparam+=array("pusuarionombre"=>$datos["usuarionombre"]);
		$spparam+=array("pusuarioapellido"=>$datos["usuarioapellido"]);
		$spparam+=array("pusuarioemail"=>$datos["usuarioemail"]);
		$spparam+=array("pultmodusuario"=>$_SESSION['usuariocod']);
		$spparam+=array("pultmodfecha"=>date("Y/m/d H:i:s"));
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se pudieron modificar los datos. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		return true;
	}
	
//----------------------------------------------------------------------------------------- 
// Rehabilita un usuario dado de baja

// Parámetros de Entrada:
//		usuariocuit,usuarioemail: los datos de la cuenta a rehabilitar

// Retorna:
//		nuevapwd: la nueva password generada
//		error: si se produjo algún error
//		msgok: mensaje de salida
	
	function RehabilitarUsuario ($usuariocuit,$usuarioemail,&$nuevapwd,&$error,&$msgok)
	{		

		$spnombreusuario='sel_usuarios_xusuariocuit_usuarioemail';
		$spparamusuario=array('pusuariocuit'=>$usuariocuit,'pusuarioemail'=>$usuarioemail);
		if(!$this->conexion->ejecutarStoredProcedure($spnombreusuario,$spparamusuario,$queryusuario,$numfilas,$errno) || $numfilas!=1)
		{
			$error= "Los datos ingresados no corresponden a un usuario - '".htmlspecialchars($usuariocuit,ENT_QUOTES)."'/'".htmlspecialchars($usuarioemail,ENT_QUOTES)."'";
			return false;
		}
		else
		{ // se encontró un usuario con los datos
			$usuario=mysqli_fetch_assoc($queryusuario);
			
			if($usuario["usuarioestado"]!=USUARIOBAJA)
			{
				$error= "Su usuario no se encuentra para rehabilitar - '".htmlspecialchars($usuariocuit,ENT_QUOTES)."'/'".htmlspecialchars($usuarioemail,ENT_QUOTES)."'";
				return false;
			}
			else
			{ // se puede generar la nueva contraseña
				$nuevapwd=FuncionesPHPLocal::GenerarPassword(6);
				
				$spnombreusu='upd_usuariopassword_xusuariocod';
				$spparamusu=array('pusuariopassword'=>md5($nuevapwd),'pusuarioestado'=>USUARIONUEVO,'pultmodusuario'=>0,'pultmodfecha'=>date('Y/m/d H:i:s'),'pusuariocod'=>$usuario["usuariocod"]);
			
				if(!$this->conexion->ejecutarStoredProcedure($spnombreusu,$spparamusu,$nousar,$numfilas,$errno) || $numfilas!=1)
				{
					$error= "Error BD en selección de usuarios. ";
					return false;
				}	
				else
				{
					$msgok="Se envió la nueva contraseña al mail del usuario. El envío puede demorar unos minutos.";
				}
	
			} // fin de se puede enviar la nueva contraseña
		} // fin de se encontró el usuario

		return true;
	}

//----------------------------------------------------------------------------------------- 
// Retorna una consulta con los datos del usuario por usuariocod

// Parámetros de Entrada:
//		usuariocod: usuario a buscar

// Retorna:
//		numfilas,resultado: cantidad de filas y query de resultado
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function BuscarUsuariosXUsuariocod($usuariocod,&$numfilas,&$resultado,$solo_activos=true)
	{
		if($solo_activos)
		{
			$spnombre="sel_usuarios_xusuariocod_menorestado";
			$spparam=array("pusuarioestado"=>USUARIOBAJA,"pusuariocod"=>$usuariocod);
		}
		else
		{
			$spnombre='sel_usuarios_xusuariocod';
			$spparam=array('pusuariocod'=>$usuariocod);
		}
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas>1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		return true;
	}
	
	function BuscarUsuarioUniversidadsXUsuarioUniversidad($usuariocod,$univ_codigo, &$numfilas,&$resultado,$solo_activos=true)
	{
			$spnombre="sel_usuario_universidad_xusuario_univ";
			$spparam=array("pusuariocod"=>$usuariocod,"puniv_codigo"=>$univ_codigo);
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas>1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		return true;
	}

		function BuscarUsuarioUniversidadsXUsuario($usuariocod, &$numfilas,&$resultado,$solo_activos=true)
	{
			$spnombre="sel_usuario_universidad_xusuario";
			$spparam=array("pusuariocod"=>$usuariocod);
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		return true;
	}
	
	
//----------------------------------------------------------------------------------------- 
	function BuscarUsuariosXUsuarioRol($usuariocod,$rolcod,$jurisdid,&$numfilas,&$resultado)
	{
		$spnombre='sel_usuarios_roles_jurisdiccion_inap_xusuariocod_rolcod_jurisdid';
		$spparam=array('pusuariocod'=>$usuariocod);
		$spparam+=array('prolcod'=>$rolcod);
		$spparam+=array('pjurisdid_inap'=>$jurisdid);
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno)) {
			$txt_sys_mail="Rol buscado="."\n usuariocod=".$usuariocod."\n rolcod= ".$rolcod."\n jurisdid=".$jurisdid;;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando rol del usuario. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} elseif($numfilas>1)	{
			$txt_sys_mail="Rol buscado (más de un registro para el mismo rol)\n"."\n usuariocod=".$usuariocod."\n rolcod= ".$rolcod."\n jurisdid=".$jurisdid;;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando rol del usuario. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		}

		return true;
	}

//----------------------------------------------------------------------------------------- 
// Retorna los datos de un usuario

// Parámetros de Entrada:
//		usuariocod: usuario a buscar

// Retorna:
//		datos: son los datos del usuario
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function TraerDatosUsuario($usuariocod,&$datos,$solo_activos=true)
	{
		if(!$this->BuscarUsuariosXUsuariocod($usuariocod,$numfilas,$resultado,$solo_activos) || $numfilas!=1)
			return false;
		
		$datos=mysqli_fetch_assoc($resultado);
		
		return true;
	}

//----------------------------------------------------------------------------------------- 
// Valida que no este ya cargado el CUIT ingresado

// Parámetros de Entrada:
//		usuarioCUIT: es el CUIT a buscar
//		usuariocod: en caso que sea distinto a vacio, entonces el unico cuit existente tiene que ser el de ese usuario

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function ValidarCUIT($usuariocuit,$usuariocod="")
	{
		$spnombre='sel_usuarios_xusuariocuit';
		$spparam=array('pusuariocuit'=>$usuariocuit);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$queryusuario,$numfilas,$errno))
			return false;
			
		if($numfilas==0)
			return true;
		elseif($numfilas==1)
		{
			if($usuariocod!="")
			{
				$fila=mysqli_fetch_assoc($queryusuario);
				
				if($fila["usuariocod"]==$usuariocod)
					return true;
			}
		}
			
		return false;
	}

//----------------------------------------------------------------------------------------- 
// Cambiar PWD del usuario

// Parámetros de Entrada:
//		usuariocod: es el usuario a cambiar la contraseña
//		claveactual: es la clave actual del usuario
//		clavenueva: es la nueva clave del usuario
//		claveconf: es la confirmación de la clave nueva

// Retorna:
//		la función retorna true o false si se pudo ejecutar con éxito o no
	
	function CambiarPwd($usuariocod,$claveactual,$clavenueva,$claveconf)
	{
		if(!$this->BuscarUsuariosXUsuariocod($usuariocod,$numfilasusuarios,$resultadousuarios) || $numfilasusuarios!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$filausuario=mysqli_fetch_assoc($resultadousuarios);
	
	
		if(md5($claveactual)!=$filausuario["usuariopassword"] || $clavenueva!=$claveconf)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Los datos ingresados son erróneos. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		if(!FuncionesPHPLocal::ValidarPassword($clavenueva,$claveactual,$filausuario["usuarioCUIT"],6))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La nueva contraseña no es válida. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	
		$spnombreusu='upd_usuariopassword_xusuariocod';
		$spparamusu=array('pusuariopassword'=>md5($clavenueva),'pusuarioestado'=>USUARIOACT,'pultmodusuario'=>$_SESSION['usuariocod'],'pultmodfecha'=>date('Y/m/d H:i:s'),'pusuariocod'=>$usuariocod);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombreusu,$spparamusu,$nousar,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error BD en selección de usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		
		return true;
	}

//----------------------------------------------------------------------------------------- 

	function CambiarPwdDocente($usuariocod,$claveactual,$clavenueva,$claveconf)
	{
		$oPrestadorDocente = new cPrestadorDocente($this->conexion);

		
		if(!$oPrestadorDocente->TraerDatosPrestadorDocente($usuariocod,$filausuario,$numltadousuarios))
		{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando al Prestador. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			die();
		}
		if(md5($claveactual)!=$filausuario["presdoc_password"] || $clavenueva!=$claveconf)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Los datos ingresados son erróneos. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if(!FuncionesPHPLocal::ValidarPassword($clavenueva,$claveactual,$filausuario["presdoc_cuilt"],6))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La nueva contraseña no es válida. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	
		$spnombreusu='upd_prestador_docente_xpresdoc_codigo';
		$spparamusu=array('ppresdoc_password'=>md5($clavenueva),'ppresdoc_estado'=>USUARIOACT,'pultmodusuario'=>$_SESSION['usuariocod'],'pultmodfecha'=>date('Y/m/d H:i:s'),'ppresdoc_codigo'=>$usuariocod);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombreusu,$spparamusu,$nousar,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error BD en selección de usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		
		return true;
	}




//----------------------------------------------------------------------------------------- 
// Genera una password nueva para ser enviada al usuario

// Parámetros de Entrada:
//		usuariocuit/usuariomail: datos a buscar en la base

// Retorna:
//		nuevapwd: la clave nueva generada por el sistema
//		la función retorna true o false si se pudo ejecutar con éxito o no
	
	function OlvidoPassword($usuariocuit,$usuarioemail,&$nuevapwd)
	{		
		$spnombreusuario='sel_usuarios_xusuariocuit_usuarioemail';
		$spparamusuario=array('pusuariocuit'=>$usuariocuit,'pusuarioemail'=>$usuarioemail);
		if(!$this->conexion->ejecutarStoredProcedure($spnombreusuario,$spparamusuario,$queryusuario,$numfilas,$errno) || $numfilas!=1)
		{
			echo "<br><br><br><br>";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Los datos ingresados no corresponden a un usuario - '".htmlspecialchars($usuariocuit,ENT_QUOTES)."'/'".htmlspecialchars($usuarioemail,ENT_QUOTES)."'",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			echo "<br><br>";
			echo "<div align='center'><a href='".$_SERVER['PHP_SELF']."' class='textoTablaDato linkFondoBlanco'>Volver a ingresar los datos</a></div>";
			return false;
		}
		else
		{ // se encontró un usuario con los datos
			$usuario=mysqli_fetch_assoc($queryusuario);
			
			if($usuario["usuarioestado"]>USUARIOACT)
			{
				echo "<br><br><br><br>";
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No se pudo enviar una contraseña nueva. Su usuario no se encuentra activo - '".htmlspecialchars($usuariocuit,ENT_QUOTES)."'/'".htmlspecialchars($usuarioemail,ENT_QUOTES)."'",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				echo "<br><br>";
				echo "<div align='center'><a href='".$_SERVER['PHP_SELF']."' class='textoTablaDato linkFondoBlanco'>Volver a ingresar los datos</a></div>";
				return false;
			}
			else
			{ // se puede generar la nueva contraseña
				$nuevapwd=FuncionesPHPLocal::GenerarPassword(6);
				
				$spnombreusu='upd_usuariopassword_xusuariocod';
				$spparamusu=array('pusuariopassword'=>md5($nuevapwd),'pusuarioestado'=>USUARIONUEVO,'pultmodusuario'=>0,'pultmodfecha'=>date('Y/m/d H:i:s'),'pusuariocod'=>$usuario["usuariocod"]);
			
				if(!$this->conexion->ejecutarStoredProcedure($spnombreusu,$spparamusu,$nousar,$numfilas,$errno) || $numfilas!=1)
				{
					echo"<p>&nbsp;</p>";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error en selección de usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}	
				else
				{
					echo "<br><br><br><br>";
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se envió su nueva contraseña al mail. El envío puede demorar unos minutos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					echo "<br><br>";
					echo "<div align='center'><a href='index.dhtml' class='textoTablaDato linkFondoBlanco'>Volver a inicio</a></div>";
					FuncionesPHPLocal::RegistrarAcceso($this->conexion,'023807',"usuariocod=".$usuario["usuariocod"]." - usuariocuit=".$usuariocuit,0);	
				}
	
			} // fin de se puede enviar la nueva contraseña
		} // fin de se encontró el usuario
		
		return true;
	}

