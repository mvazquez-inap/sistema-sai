class cActividadCursoPrestadorDocente
{
	var $conexion;

	public function __construct($conexion) {
		$this->conexion = &$conexion;
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadCursoPrestadorDocente($act_codigo,$presdoc_codigo,&$datosresult,&$es_modif){
	
		$datosresult=array();
		$es_modif = false;		
		$sparam=array( 'pact_codigo'=>$act_codigo,
					   'ppresdoc_codigo'=>$presdoc_codigo);
					   
		$spnombre="sel_actividad_curso_prestador_docente_xact_codigo_presdoc_codigo";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el prestadores docentes de la actividad.";
			$errormail="\nact_codigo=".$act_codigo."\npresdoc_codigo=".$presdoc_codigo."Error. ".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}
		return true;
	}
	
