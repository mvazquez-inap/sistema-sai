<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oActividad = new cActividad($conexion);
$oPersonas = new cPersonas($conexion);
$oActividadAutodesarrolloPersona = new cActividadAutodesarrolloPersona($conexion);
//----------------------------------------------------------------------------------------- 
$conexion->ManejoTransacciones("B");

if (isset($_POST['boton_eliminar'])) {

	if($oActividadAutodesarrolloPersona->EliminarDatosActividadAutodesarrolloPersona($_POST)) {
		FuncionesPHPLocal::RegistrarAcceso($conexion,"48802","pers_codigo=".$_POST['pers_codigo']."- act_codigo=".$_POST['act_codigo']."- tipoact_codigo=".$_POST['tipoact_codigo']."- actprog_sec=".$_POST['actprog_sec'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha eliminado la asignación de la persona en la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
	} else 
		$conexion->ManejoTransacciones("R");

} elseif ($_POST['operacion'] == "I") {		
	
		if($oActividadAutodesarrolloPersona->AltaDatosActividadAutodesarrolloPersona($_POST)) {
			FuncionesPHPLocal::RegistrarAcceso($conexion,"48801","pers_codigo=".$_POST['pers_codigo']."act_codigo=".$_POST['act_codigo']."- tipoact_codigo=".$_POST['tipoact_codigo']."- actprog_sec=".$_POST['actprog_sec'],$_SESSION['usuariocod']);
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha asignado la persona a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$conexion->ManejoTransacciones("C");
		} else 
			$conexion->ManejoTransacciones("R");

	} elseif ($_POST['operacion'] == "M" ) {
	
		if($oActividadAutodesarrolloPersona->ModifDatosActividadAutodesarrolloPersona($_POST)) {
			FuncionesPHPLocal::RegistrarAcceso($conexion,"48803","pers_codigo=".$_POST['pers_codigo']."act_codigo=".$_POST['act_codigo']."- tipoact_codigo=".$_POST['tipoact_codigo']."- actprog_sec=".$_POST['actprog_sec'],$_SESSION['usuariocod']);
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha modificado los datos de la asignación de la persona en la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$conexion->ManejoTransacciones("C");
		} else 
			$conexion->ManejoTransacciones("R");			
	 
	 } else 		
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en la operación a realizar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
?>
<div align="center"><a href="actividad_autodesarrollo_asignar_persona.dhtml<?php echo "?act_codigo=".$_POST['act_codigo']."&amp;formact_codigo=".FORMATOAUTO."&amp;tipoact_codigo=".$_POST['tipoact_codigo']."&amp;actprog_sec=".$_POST['actprog_sec']."&amp;pers_codigo=".$_POST['pers_codigo'];?>"class="linkFondoBlanco">Volver</a></div><br>
<?php 
$oEncabezados->PieMenuEmergente(); 
?>