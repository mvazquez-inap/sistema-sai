	protected function PuedeEliminarRegistroTablaPropia($regdatocod,&$tipobaja)
	{
		if(!$this->RegistroXRegdatocod($regdatocod,$datos))
			return false;
		
		switch ($datos['cat_02'])
		{
			case ESTCURSOCARGADO:
				$tipobaja=1;
				break;
			case ESTCURSOABIERTO:	
			case ESTCURSOCERRADO:
				$tipobaja=2;
				break;
			default:
				$tipobaja=2;	
		}					
		return true;
	}
	
	
