	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosEliminarActividadAutodesarrollo($act_codigo,$tipoact_codigo)	{

			$ArregloDatos['act_codigo'] = $act_codigo;
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;			
		
			if(!$this->BuscarActividadAutodesarrollo($ArregloDatos,$numfilas,$resultActAuto,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}

			if ($numfilas == 1)	{
				$es_modif = true;
			}

			// Verificar que la actividad no tenga dictamen.
			$oDictamen = new cDictamen($this->conexion);
			$ArregloDatos=array();
			$ArregloDatos['act_codigo'] = $act_codigo;
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;			
				
			$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
			if ($error)  {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			} elseif ($numfilas>0) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La actividad no puede ser eliminada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}

			// Arreglo 02/10/08: No mostraba el mensaje que informaba que existían personas asigadas a la actividad
			// e intentaba la eliminiación fallando por la existencia de las mismas 
			$oActividadPersona = new cActividadAutodesarrolloPersona($this->conexion);				
			if(!$oActividadPersona->BuscarActividadAsignadaPersonaAvanzada ($ArregloDatos, $numfilas, $resultPersonas, $error, $errormail)) {
				$txt_sys_mail = "act_codigo= ".$act_codigo."- formato=".$tipoact_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar las personas asignadas a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			} 
			if ($numfilas>0) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha eliminado la actividad, pues se han encontrado <br> personas asignadas a la misma.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

		return true;
	}
