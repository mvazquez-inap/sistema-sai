$oAgentes = new cAgentes($conexion);
$escalafon = new cEscalafones($conexion);
$jurisdicciones	 = new jurisdicciones;
$oExpediente = new cExpediente($conexion);


$leyendaBoton = "";
$operacion = "";
$ok = true;

// Busco la persona y saco sus datos o informo que debe dar el alta
if(!$oPersonas->TraerDatosPersona($_POST["pers_cuilt"],$datospersona,$es_modif)) {
	$ok=false;
} elseif (!$es_modif) {
		$mensaje = "La Persona no se encuentra en el sistema. <br> Deber&aacute; crearla haciendo click en el botón Nueva Persona";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$mensaje,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok=false;
  } elseif($datospersona['pers_estado'] == PERSONABAJA) {
		$error="La persona ingresada se encuentra dada de baja.<br>Deber&aacute; rehabilitar a la persona.";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok = false;
}

if ($ok) {

	// Verifico que si se acredita tipo Docente y la actividad tiene formato curso,
	// el prestador tiene que estar asignado a alguna comisión de la actividad (para act.
	// jurisdiccional o inap) ya que en instucional no hay comisiones, ni prestadores docentes.

	if ($_POST['tipoact_codigo'] == TIPOACTAUTODOCENTE) {

		if (!$oActividad->TieneFormato($_POST['act_codigo'],FORMATOCURSO,$tiene_formato)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al verificar formatos de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"");
			$ok =  false;

		} elseif ($tiene_formato) {

			// Es un curso INAP o Jurisdiccional al que se le esta agregando el formato de autodesarrollo

			if (!$oActividadAutodesarrolloPersona->VerificarInscripcionPersona($_POST['act_codigo'],$datospersona['pers_codigo'],$puede_inscribir, $mensaje_no_inscripcion))
				$ok = false;

			if (!$puede_inscribir) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$mensaje_no_inscripcion,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
			}

/*
			// Verifico si la persona esta asignada en el formato CURSO
			// solo se busca la persona en algun curso, sin imporar el estado de aprobación
			$ArregloDatos = array();
			$ArregloDatos['pers_codigo'] = $datospersona['pers_codigo'];
			$ArregloDatos['act_codigo'] = $_POST['act_codigo'];
			if(!$oComisionPersona->BuscarActividadAsignadaPersona ($ArregloDatos, $numfilas, $result, $error, $errormail)) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				$ok = false;
			} elseif ($numfilas >= 1)	{

				$numfilasCurso=0;

				// OJO CAMBIO CERTI
				// Verifico que no la tenga certificada
				if (!$oComisionPersona->BuscarActividadPersonaCertificada($ArregloDatos,$numfilasCurso,$resultComiPers,$error,$errormail)) {
					$txt_sys_mail="\nact_codigo=".$ArregloDatos['act_codigo']."\npers_codigo=".$ArregloDatos['pers_codigo']."\nerror=".$errormail;
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando inscripto.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					$ok = false;
				} elseif ($numfilasCurso!=0) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La persona ya tiene acreditada la actividad en formato Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok = false;
				} else {
					$error = "ADVERTENCIA: La persona tiene asignada la actividad en el formato Curso <BR> Tenga en cuenta que la podrá acreditar en un un único formato.";
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				}

			} else {
				// Busco si es prestador
				$oPrestadorDocente = new cPrestadorDocente($conexion);
				$ArregloDatos['presdoc_cuilt']=$_POST['pers_cuilt'];
				if(!$oPrestadorDocente->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)){
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok = false;
				} elseif ($numfilas==0) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La persona no esta registrada como Prestador Docente INAP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok =  false;
				} else {
					$fila_pres_doc = mysql_fetch_assoc($result);
					// Busco el prestador en alguna comisión ABIERTA, CERRADA o CERTIFICADA
					$oComisionPrestadorDocente=new cComisionPrestadorDocente($conexion);
					$ArregloDatos=array();
					$ArregloDatos['act_codigo']=$_POST['act_codigo'];
					$ArregloDatos['presdoc_codigo']=$fila_pres_doc['presdoc_codigo'];
					$ArregloDatos['comi_estado']=COMISIONABIERTA.",".COMISIONCERRADA.",".COMISIONCERTIFICADA;
					if (!$oComisionPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar docentes en las comisiones de la actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
						$ok = false;
					} elseif ($numfilas==0) {
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La persona no se encuentra asignada como Prestador Docente <br>de ninguna comisión de la actividad o bien  <br> la Comisión no se encuentra ABIERTA, CERRADA o CERTIFICADA.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						$ok =  false;
					}
				} // !$oPrestadorDocente->BuscarPrestadorDocente(
			}	//ok

*/
		} // TieneFormato

	} // $_POST['tipoact_codigo'] == TIPOACTAUTODOCENTE

	$tiene_dictamen_editable = false;
	// Para Mero Asistente, busco el dictamen para obtener las fechas de la programacion,
	// y validar la de realización
	if ($_POST['tipoact_codigo'] == TIPOACTAUTOEVASIS) {
		$ArregloDatos = array();
		$ArregloDatos['act_codigo'] = $_POST['act_codigo'];
		$ArregloDatos['actprog_sec'] = $_POST['actprog_sec'];
		$ArregloDatos['tipoact_codigo'] = $_POST['tipoact_codigo'];		// Agrego el tipo que estaba mal

		if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result_dictamen,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok = false;
		} elseif ($numfilas != 1) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok = false;
		} else {
			$fila_dictamen = mysqli_fetch_assoc($result_dictamen);
			$tiene_dictamen_editable = true;
			$tiene_dictamen = true;
		}

	} else { // ($_POST['tipoact_codigo'] == TIPOACTAUTOEVASIS)

		$ArregloDatos = array();
		$ArregloDatos['act_codigo'] = $_POST['act_codigo'];
		$ArregloDatos['pers_codigo'] = $datospersona['pers_codigo'];
		$ArregloDatos['tipoact_codigo'] = $_POST['tipoact_codigo'];		// Agrego el tipo que estaba mal

		if(!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$result_dictamen,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok = false;
		} elseif ($numfilas > 1) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando el dictamen de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$ok = false;
		} elseif ($numfilas == 1) {
			$fila_dictamen = mysqli_fetch_assoc($result_dictamen);
			$tiene_dictamen= true;
			if ($fila_dictamen['dic_estado'] == DICTAMENNUEVO || $fila_dictamen['dic_estado'] == DICTAMENRECHAZADO)
				$tiene_dictamen_editable = true;
		}  else {
			$tiene_dictamen= false;
		}

	}

	if ($ok && $tiene_dictamen && !$tiene_dictamen_editable) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La asignación se encuentra dictaminada. <br>El estado del dictamen no le permite actualizarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$ok = false;
	}

	// Busco la asignacion en autodesarrollo
	if ($ok) {
		$ArregloDatos = array();
		$ArregloDatos['pers_codigo'] = $datospersona['pers_codigo'];
		$ArregloDatos['act_codigo'] = $_POST['act_codigo'];
		if(!$oActividadAutodesarrolloPersona->BuscarActividadAsignadaPersona ($ArregloDatos, $numfilasAsignacion, $result, $error, $errormail)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$ok = false;
		} elseif($numfilasAsignacion > 1)	{
			$error = "La persona ya tiene acreditada la actividad.";
			$errormail ="La persona tiene más de 1 tipo de actividad acreditada.\npers_codigo=".$ArregloDatos['pers_codigo']."\nact_codigo=".$ArregloDatos['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			$ok = false;
		}
	} // $ok

	if ($ok) {
		// Buscamos datos del agente y los pegamos o no a la asignacion
		if(!$oAgentes->TraerDatosAgente($_POST["pers_cuilt"],$datosagente,$es_modif_agente)) {
			$ok=false;
			?><br><br><br><div align="center"><a href="agente_modificar.dhtml" class="linkFondoBlanco">Volver</a></div><?php
		} elseif (($es_modif_agente ) && ($datosagente['pers_estado'] == PERSONABAJA)) {
				$error="La persona ingresada se encuentra dada de baja.<br>Deber&aacute; rehabilitar a la persona.";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
			//
			// MV 2024 PECIFA
			}  elseif ($numfilasAsignacion == 0 && isset($datosagente['escalafcod']) && $datosagente['escalafcod'] != SINEP && ($datosagente['escalafcod'] != SINEP && $datosagente['escalafcod'] != PECIFA )) {
					// cuando se realizo la asignación era SINEP
					$txt_sys_mail="\npers_codigo=".$datosagente['pers_codigo'];
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La persona seleccionada no es un Agente de SINEP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok = false;
				} elseif ($numfilasAsignacion == 0) { // No tiene asignada la actividad

						$tiene_asignacion = false;
						$leyendaBoton = "Agregar";
						$operacion = "I";
						$fila_asignacion = $datosagente;
					} else { // La persona tiene asignada la actividad
						$tiene_asignacion = true;
						$leyendaBoton = "Actualizar";
						$operacion = "M";
						$fila_asignacion = mysqli_fetch_assoc($result);
						if ($fila_asignacion['actprog_sec']!=$_POST['actprog_sec']) {
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La persona tiene asignada la actividad en otra programación. <br> Realizó la actividad del ".$fila_asignacion['actauto_act_fecha_inicio']." al ".$fila_asignacion['actauto_act_fecha_fin']."<br> Seleccione la programación correspondiente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							$ok = false;
						}

						// Verifico que la persona no esté asignada en AUTODESARROLLO otro formato
						if ($_POST['tipoact_codigo'] != $fila_asignacion['tipoact_codigo']) {
							$error = "La persona ya tiene acreditada la actividad en el formato Autodesarrollo.";
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							$ok = false;
						} elseif (!$oExpediente->TraerDatosExpediente($fila_asignacion['exp_codigo'],$fila_expediente,$es_modif_exp)) {
								$txt_sys_mail="Error buscando los datos del expediente. \nexp_codigo=".$fila_asignacion['exp_codigo'];
								FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar detalles del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
								$ok = false;
							} else {
								$fila_asignacion['jurisdid_inap'] = $fila_expediente['jurisdid_exp'];
								$fila_asignacion['exp_numero'] = $fila_expediente['exp_numero'];
							} //
		} // if	!$oAgentes->TraerDatosAgente
	} // if ok


	// Determino la jurisdiccion a mostar
	if ($ok) {
		$jurisdnom = "";
		if (isset($fila_asignacion['jurisdid_apn'])) {
			$tipoorg_codigo = ORGANISMO_APN;
			$jurisdid = 'jurisdid_apn';
			if ($jurisdicciones->SelectJurisdxID($fila_asignacion['jurisdid_apn'],array(),TABGRALES_TS_ARRAY,$fila_jurisd,array(),$NumFilas,$CodError))
				$jurisdnom=htmlspecialchars($fila_jurisd[$fila_asignacion['jurisdid_apn']]['jurisdnom'],ENT_QUOTES);
		} elseif (isset($fila_asignacion['orgapub_codigo'])) {
				$tipoorg_codigo = ORGANISMO_NO_APN;
				$jurisdid = 'orgapub_codigo';
				$spnombre = "sel_organismo_publico_xdatos";
				$spparam = array("pxclave"=>"1","porgapub_codigo"=>$fila_asignacion["orgapub_codigo"],"pxdescripcion"=>"0","porgapub_nombre"=>"0","porgapub_nombre"=>"0","pxestado"=>"0","porgapub_estado"=>"0","porderby"=>"orgapub_nombre");
				if(!$conexion->BuscarRegistroxClave($spnombre,$spparam,array("orgapub_codigo"=>$fila_asignacion["orgapub_codigo"]),$resultado,$filaret,$numfilasmatcheo,$errno)) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al seleccionar el organismo público. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok =  false;
				} elseif($numfilasmatcheo!=1) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error al seleccionar el organismo público. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					$ok =  false;
				}
				$jurisdnom = $filaret['orgapub_nombre'];
		} // isset($fila_asignacion['jurisdid_apn'])
	} // ok - determino jurisdiccion

} // if ok
