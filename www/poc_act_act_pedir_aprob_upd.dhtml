<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

//----------------------------------------------------------------------------------------- 	
$oPocActividadActividad = new cPocActividadActividad($conexion);				

$conexion->ManejoTransacciones("B");

if($oPocActividadActividad->PedirAprobacionPocActividadActividad($_POST)) {

	$operacion_mensaje = "Fin de Carga";			
	$asunto = SISTEMA." - Fin Carga de Actividad Curso - Actividad POC";
	$oPocActividadActividad->ArmarMensajePedirAprobacion($_POST,$mensaje); 

	if (FuncionesPHPLocal::MandarMail($conexion,USUACTJUR,$_SESSION['jurisdid_inap'],$asunto,$mensaje)) 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"En unos momentos Coordinador Institucional recibirá un correo electrónico <BR> con la notificación del fin de Carga.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	else 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El correo electrónico con la notificación del fin de carga no fue enviado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	
	FuncionesPHPLocal::RegistrarAcceso($conexion,"37406","operacion=pedido de aprobación"."\npocact_codigo=".$_POST['poc_codigo']."\nact_codigo=".$_POST['act_codigo'],$_SESSION['usuariocod']);
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha notificado el fin de la carga de las relaciones <br> de la Actividad Curso - Actividad POC.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

	$conexion->ManejoTransacciones("C");

}  else {

	$conexion->ManejoTransacciones("R");
}
?>

<br><div align="center"><a href="poc_act_act_pedir_aprob.dhtml" class="linkFondoBlanco">Volver</a></div>

<?php $oEncabezados->PieMenuEmergente(); ?>
