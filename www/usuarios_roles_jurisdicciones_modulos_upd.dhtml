			else
				formulario.checkbox_<?=$filamodulos['modulocod']?>.checked=false;
		<?php }
	?>
	}

	var indiceroljuris;
	indiceroljuris=-1;
	for(elem in grilla)
	{
		if (grilla[elem][0]==rol && grilla[elem][1]==jurisd)
			indiceroljuris=elem;
	}
	if (indiceroljuris>-1)	
	{
		var indicemodulo;
		<?php
		$spnombremodulos="sel_modulos_gruposmod_modulos_orden";
		$spparammodulos=array('porderby'=>"modulocod");
		$conexion->ejecutarStoredProcedure($spnombremodulos,$spparammodulos,$querymodulos,$numfilas,$errorcod);
		
		while($filamodulos=mysqli_fetch_assoc($querymodulos))
		{?>
			indicemodulo=-1;
			for(elemento in grilla[indiceroljuris][2])
			{
