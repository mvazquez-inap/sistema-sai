			if (is_object($xml2))
			{
				$cant_act_certificadas = count($xml2->actividades_certificadas->children());
				if ($cant_act_certificadas==0)	 	 { 
					echo '<span style="font-weight:bold">No se encontraron créditos de actividades del formato solicitado.</span><br>';
				} else	{
	?>		
		        <table border="1" style="width:100%; font-family:Arial, Helvetica, sans-serif;   font-size:11px;" >
		        <tr style="background-color:#999999; color:#FFFFFF;text-align:center;font-weight:bold;">
