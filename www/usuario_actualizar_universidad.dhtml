//--------------------------------------------------------------------------------------------------
function MostrarGrillaSeleccion($conexion, $usuariocod) {

	$spnombre='sel_usuario_universidad_actualizables_xusuario';
	$spparam = array('pusuariocod'=>$usuariocod, 
					 'puniv_estado'=> ESTADOACTIVO	
			);

	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$result_usu,$num_roles_usu,$errno)) {	
		$txt_sys_mail.="\nusuariocod=".$usuariocod;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar universidades asignadas.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}

	$opciones=array(
		"FilasPagina"=>$num_roles_usu,
	);
	
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla('Universidades actualizables');
	$oGrilla->SetearAnchoGrilla('100%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Universidad');
	$oGrilla->Setear('campo_grilla',$miColumna1,'univ_descripcion');
	$oGrilla->Setear('align_columna',$miColumna1,'left');

	// El unico rol que tiene datos para actualizar es el de COORDINADOR TECNICO que es actualizado por el 
	// ADMIINAP

	
	$miColumna4 = $oGrilla->AddColumna('linkimg');
	$oGrilla->Setear('titulo_columna',$miColumna4,'Eliminar');
	$oGrilla->Setear('ancho_columna',$miColumna4,'60');
	$oGrilla->Setear('url',$miColumna4,'usuario_actualizar_universidad.dhtml');
	$oGrilla->Setear('url_ancla',$miColumna4,'Edicion');
	$oGrilla->Setear('imagen',$miColumna4,'images/borrar.jpg');
	
	$oGrilla->Setear('altImagen',$miColumna4,'Eliminar');
	$oGrilla->AddParametrosURL($miColumna4,"usuariocod","usuariocod");
	$oGrilla->AddParametrosURL($miColumna4,"univ_codigo","univ_codigo");
	$oGrilla->AddParametrosURL($miColumna4,"operacion","B","cte");

	if (!$oGrilla->CargarGrilla($result_usu))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
