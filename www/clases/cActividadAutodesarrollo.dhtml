									FuncionesPHPLocal::ArmarCombo_SinSalto_BD($conexion,$spnombre,$spparam,"formulario","tipoact_codigo","tipoact_agrega","tipoact_descripcion",isset($filaauto['actividad_autodesarrollo']['tipoact_codigo'])?$filaauto['actividad_autodesarrollo']['tipoact_codigo']:"","-- Seleccione un Tipo de Actividad",$filaagfuncion,$seleagfuncion,"1","CambiaTipoActividad(tipoact_codigo.value)");
