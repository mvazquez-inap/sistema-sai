					if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$querynotultmes,$numfilasnotultmes,$errno))
					{
						$this->msg_error.="Error al buscar la última ".strtolower($this->arreglotitulos['TituloCorto'])." del año por mes.";
						return false;
					}
					if ($this->anio<2000)
						break;

					if ($numfilasnotultmes>0)
					{
						$datosultmes = mysqli_fetch_assoc($querynotultmes);
						if ($datosultmes['ultmes']!="")
						{
							$ultmes = $datosultmes['ultmes'];
							$encontradoanio=true;
						}else
							$this->anio = $this->anio - 1;
					}else
						$this->anio = $this->anio - 1;


					$aux++;
				}
				$cerrarmenu = false;
				if ($numfilasnotultmes>0)
				{
					$salida .= "<div class=\"menulateral\">";
					$salida .= "	<ul class=\"clearfix\">";
					$cerrarmenu = true;
				}
