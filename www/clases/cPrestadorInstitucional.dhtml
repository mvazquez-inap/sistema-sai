				return false;
			}	

			if ((trim(formulario.presins_ra_apellido.value)=="")){
				alert("Debe ingresar el apellido del respresentante académico");
				formulario.presins_ra_apellido.focus();
				return false;
			}	
		
			if (!ValidarContenido(formulario.presins_ra_apellido.value,"AlfabeticoPuro")){
				alert("Debe ingresar un apellido válido");
				formulario.presins_ra_apellido.focus();
				return false;
			}	

			if ((trim(formulario.presins_ra_nombre.value)=="")){
				alert("Debe ingresar el nombre del respresentante académico");
				formulario.presins_ra_nombre.focus();
				return false;
			}	

			if (!ValidarContenido(formulario.presins_ra_nombre.value,"AlfabeticoPuro")){
				alert("Debe ingresar un nombre válido");
				formulario.presins_ra_nombre.focus();
				return false;
			}	
			
			if ((trim(formulario.presins_ra_domicilio.value)=="")){
				alert("Debe ingresar el domicilio");
				formulario.presins_ra_domicilio.focus();
				return false;
			}	
			
			if ((trim(formulario.presins_ra_cp.value)=="")){
				alert("Debe ingresar el código postal");
				formulario.presins_ra_cp.focus();
				return false;
			}	
			
			if ((trim(formulario.presins_ra_prov_codigo.value)=="")){
				alert("Debe ingresar provincia");
				formulario.presins_ra_prov_codigo.focus();
				return false;
			}	
			
			if ((trim(formulario.presins_ra_telefono.value)=="")){
				alert("Debe ingresar el teléfono");
				formulario.presins_ra_telefono.focus();
				return false;
			}	
			
			if ((trim(formulario.presins_ra_prov_codigo.value)=="")){
				alert("Debe ingresar una provincia");
				formulario.presins_ra_prov_codigo.focus();
				return false;
			}	
					
			if ((trim(formulario.presins_ra_part_loca_descripcion.value)=="")){
				alert("Debe ingresar Partido / Localidad");
				formulario.presins_ra_part_loca_descripcion.focus();
				return false;
			}	

			if (!ValidarContenido(formulario.presins_ra_email.value,"Email")){
				alert("Debe ingresar un email válido");
				formulario.presins_ra_email.focus();
				return false;
			}	

			return true;
		}
