		if (isset($ArregloDatos['comi_fecha_inicio']))	{
			if ($ArregloDatos['comi_fecha_inicio']!="")
			{	
				$sparam['pcomi_fecha_inicio']= $ArregloDatos['comi_fecha_inicio'];
				$sparam['pxcomi_fecha_inicio']= 1;
			}
		}	
		if (isset($ArregloDatos['comi_fecha_fin']))	{
			if ($ArregloDatos['comi_fecha_fin']!="")
			{	
				$sparam['pcomi_fecha_fin']= $ArregloDatos['comi_fecha_fin'];
				$sparam['pxcomi_fecha_fin']= 1;
			}
		}	
		if (isset($ArregloDatos['comi_web']))	{
			if ($ArregloDatos['comi_web']!="")
			{	
				$sparam['pcomi_web']= $ArregloDatos['comi_web'];
				$sparam['pxcomi_web']= 1;
			}
		}	

		
		if (isset($ArregloDatos['progcur_codigo']))	{
			if ($ArregloDatos['progcur_codigo']!="")
			{	
				$sparam['pprogcur_codigo']= $ArregloDatos['progcur_codigo'];
				$sparam['pxprogcur_codigo']= 1;
			}
		}	
		
		if (isset($ArregloDatos['areacur_codigo']))	{
