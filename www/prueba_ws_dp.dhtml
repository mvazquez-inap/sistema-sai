$servidor="http://wssai.sgp.gov.ar"; 

// ----------------------------------------------------------------------------------------------------------------
if ($servidor=="10.1.10.173" || $servidor=="127.0.0.1") { 	
	$WSDL_creditosPersonales = "http://".$servidor."/sai/wsSai/wsCreditosPersonales.php?wsdl";	
	$WSDL_TablasBasicas = "http://".$servidor."/sai/wsSai/wsTablasBasicas.php?wsdl";		
} else 	{
	$WSDL_creditosPersonales = $servidor."/wsCreditosPersonales.php?wsdl";	
	$WSDL_TablasBasicas = $servidor."/wsTablasBasicas.php?wsdl";		
}

$oWsCreditosPersonales = new cCreditosPersonalesINAP($WSDL_creditosPersonales,true);
$oWsTablasBasicas= new cTablasBasicasINAP($WSDL_TablasBasicas,true);

echo "<br>Servicio";
echo "<br>-".$WSDL_creditosPersonales ;
echo "<br>-".$WSDL_TablasBasicas ;

if ( isset($_POST['pers_cuit']) && (isset($_POST['creditosTotal']) || isset($_POST['detalleCreditosTotal']) || 
									isset($_POST['creditosPorFormato']) || isset($_POST['detalleCreditosPorFormato']))) {

	$result = $oWsCreditosPersonales->getDatosPersonales($_POST['pers_cuit']);
	$error=$oWsCreditosPersonales->fault;
	$error_description=$oWsCreditosPersonales->getError();
	
	if ($error) {
		echo '<br><strong>Error: </strong>';
		echo "(".$error_description['faultcode'].",'".$error_description['faultstring']."','".$error_description['detail']. "')";
		echo '<br>';
		die();
	} else {
		echo '<h3>Datos Personales:</h3>';
		$xml = iconv("ISO-8859-1","UTF-8//IGNORE",$result['resultado']);
		$xml2 = @simplexml_load_string($xml);
	
		// echo "<BR>CLIENTE PERSONA:<BR>";	
		if ($verXML)	 { 
			echo "<br>xml=<br>";
			echo utf8_decode(htmlspecialchars($xml , ENT_QUOTES ));
			echo "<br><br>";
		}
		$cant_reg_persona = count($xml2->persona);
		if ($cant_reg_persona==0) {
			echo "<strong>No se encontró la persona</strong>";
			$esta_cuit=false;
		} else { 
			echo "<strong>CUIT=</strong>".utf8_decode($xml2->persona->cuit).", ";
			echo "<strong>APELLIDO y NOMBRE=</strong>".utf8_decode($xml2->persona->apellido)." ".utf8_decode($xml2->persona->nombres).", ";
			echo "<strong>SEXO=</strong>".utf8_decode($xml2->persona->sexo);
			$esta_cuit=true;
		}
		
	}
}

if ($esta_cuit) { 

	// ----------------------------------------------------------------------------------------------------------------
	// Créditos totales
	// ----------------------------------------------------------------------------------------------------------------
	if (isset($_POST['creditosTotal']))
		$result = $oWsCreditosPersonales->getCreditosTotal($_POST['pers_cuit'],$_POST['fdesde'],$_POST['fhasta']);
	// ----------------------------------------------------------------------------------------------------------------
	if (isset($_POST['detalleCreditosTotal']))
		$result = $oWsCreditosPersonales->getDetalleCreditosTotal($_POST['pers_cuit'],$_POST['fdesde'],$_POST['fhasta']);
	
	// ----------------------------------------------------------------------------------------------------------------
	// Créditos por Formato
	// ----------------------------------------------------------------------------------------------------------------
	if (isset($_POST['creditosPorFormato']))
