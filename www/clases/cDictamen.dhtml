	 					$arrayformato[$valor]=$formato_centrado;
					else 
	 					$arrayformato[$valor]=$formato;
				}

				$i=2;
				foreach ($arrayresult as $datos) {
					$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,$arrayformato);	
					$i++;
				} 
			}
		} // fin formato curso
	
		if($numfilas_DicActExt>0) {

				if (!$this->AgregarDetalleDictamenActExterna($resultDicActExt,$array_DictamenesActExt))  {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al obtener los dictámenes Formato Externas.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;											
				}
				$oExcel->AddHoja("Actividades Externas");
				$oExcel->EsconderGrillas();
				$oExcel->PaginaHorizontal();

				// Titulos 
				$oExcel->FormatoColumna (0,$ancho_columna['disposición']); 
				$oExcel->FormatoColumna (1,$ancho_columna['fecha_protocolizacion']); 
				$oExcel->FormatoColumna (2,$ancho_columna['expediente']); 
				$oExcel->FormatoColumna (3,$ancho_columna['origen_expediente']); 
				$oExcel->FormatoColumna (4,$ancho_columna['codinap']); 
				$oExcel->FormatoColumna (5,$ancho_columna['actividad']); 
				$oExcel->FormatoColumna (6,$ancho_columna['asunto']); 
				$oExcel->FormatoColumna (7,$ancho_columna['organismo_institucion']); 
				$oExcel->FormatoColumna (8,$ancho_columna['fecha_desde']); 
				$oExcel->FormatoColumna (9,$ancho_columna['fecha_fin']); 
				$oExcel->FormatoColumna (10,$ancho_columna['creditos']); 
				$oExcel->FormatoColumna (11,$ancho_columna['observaciones']); 

				// Formato Titulo 
				_setearFormato($oExcel,'titulo');
				$oExcel->CargarDatosVariasCeldas (0,0,0,11,"Dictámenes de Actividades Externas",true);		

				// Formato Titulos Columnas
				_setearFormato($oExcel,'titulo_columna');

				$oExcel->CargarDatos (1,0,"Disposición",true);
				$oExcel->CargarDatos (1,1,"Fecha Protocolización",true);
				$oExcel->CargarDatos (1,2,"Expediente",true);
				$oExcel->CargarDatos (1,3,"Origen Expediente",true);
				$oExcel->CargarDatos (1,4,"Cod. INAP",true);				
				$oExcel->CargarDatos (1,5,"Actividad",true);
				$oExcel->CargarDatos (1,6,"Asunto",true);
				$oExcel->CargarDatos (1,7,"Institución/Organismo",true);
				$oExcel->CargarDatos (1,8,"Fecha Desde",true);
				$oExcel->CargarDatos (1,9,"Fecha Hasta",true);
				$oExcel->CargarDatos (1,10,"Créditos",true);
				$oExcel->CargarDatos (1,11,"Observaciones",true);
				// Cargo Datos y los mando a la Grilla
				_cargarDatosExternaArray($array_DictamenesActExt,$arrayresult,$arrayclaves);		

				foreach ($arrayclaves as $clave => $valor) {	
					if (in_array($valor,$arreglo_centrados))
	 					$arrayformato[$valor]=$formato_centrado;
					else 
	 					$arrayformato[$valor]=$formato;
				}

				$i=2;
				foreach ($arrayresult as $datos) {
					$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,$arrayformato);	
					$i++;
				} 
				
		} // $numfilas_DicActExt>0
	
		if($numfilas_DicActAuto>0)  { 

			if (!$this->AgregarDetalleDictameActAutodesarrollo($resultDicActAuto,$array_DictamenesActAuto)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al obtener los dictámenes Formato Autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
			$oExcel->AddHoja("Actividades Autodesarrollo");
			$oExcel->EsconderGrillas();
			$oExcel->PaginaHorizontal();

			// Titulos 
			$oExcel->FormatoColumna (0,$ancho_columna['disposición']); 
			$oExcel->FormatoColumna (1,$ancho_columna['fecha_protocolizacion']); 
			$oExcel->FormatoColumna (2,$ancho_columna['expediente']); 
			$oExcel->FormatoColumna (3,$ancho_columna['origen_expediente']); 
			$oExcel->FormatoColumna (4,$ancho_columna['codinap']);
			$oExcel->FormatoColumna (5,$ancho_columna['actividad']);
			$oExcel->FormatoColumna (6,$ancho_columna['asunto']); 
			$oExcel->FormatoColumna (7,$ancho_columna['destinatario']); 
			$oExcel->FormatoColumna (8,$ancho_columna['fecha_desde']); 
			$oExcel->FormatoColumna (9,$ancho_columna['fecha_fin']); 
			$oExcel->FormatoColumna (10,$ancho_columna['creditos']); 
			$oExcel->FormatoColumna (11,$ancho_columna['dictamen']); 

			// Formato Titulo
			_setearFormato($oExcel,'titulo');
			$oExcel->CargarDatosVariasCeldas (0,0,0,10,"Dictámenes de Actividades de Autodesarrollo",true);		

			// Formato Titulos columnas
			_setearFormato($oExcel,'titulo_columna');

			$oExcel->CargarDatos (1,0,"Disposición",true);
			$oExcel->CargarDatos (1,1,"Fecha Protocolización",true);
			$oExcel->CargarDatos (1,2,"Expediente",true);
			$oExcel->CargarDatos (1,3,"Origen Expediente",true);
			$oExcel->CargarDatos (1,4,"Cod. INAP",true);			
			$oExcel->CargarDatos (1,5,"Actividad",true);
			$oExcel->CargarDatos (1,6,"Asunto",true);
			$oExcel->CargarDatos (1,7,"Destinatario",true);
			$oExcel->CargarDatos (1,8,"Fecha Desde",true);
			$oExcel->CargarDatos (1,9,"Fecha Hasta",true);
			$oExcel->CargarDatos (1,10,"Créditos",true);
			$oExcel->CargarDatos (1,11,"Dictamen",true);
			
			_cargarDatosAutodesarrolloArray($this->conexion,$array_DictamenesActAuto,$arrayresult,$arrayclaves);		
	
			foreach ($arrayclaves as $clave => $valor) {	
				if (in_array($valor,$arreglo_centrados))
					$arrayformato[$valor]=$formato_centrado;
				else 
					$arrayformato[$valor]=$formato;
			}

			$i=2;
			foreach ($arrayresult as $datos) {
				$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,$arrayformato);	
				$i++;
			} 

		} //	$numfilas_DicActAuto>0		
	}
	
	$oExcel->Enviar();	
	return true;											
	
	}	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAltaProgramacion($datos,&$datosvalidados) {
		
		$datosvalidados = array();
		
		if (!$this->_DatosValidosComunesProgramacion($datos,$datosvalidados))
		   return false; 
	
		//generar secuencia	
		$spnombre = "sel_actividad_programacion_act_codigo";
		$spparam = array('pact_codigo'=>$datos['act_codigo'],'porderby'=>"actprog_sec DESC");
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno)) {	
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error seleccionando las programaciones.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		if ($numfilas > 0) {
			$fila_prog = mysqli_fetch_assoc($query);
			$nueva_secuencia = $fila_prog['actprog_sec']+1;
		} else 
			$nueva_secuencia = 1;	
	
		$datosvalidados['actprog_sec'] = $nueva_secuencia;
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosBajaProgramacion($datos,&$datosvalidados) {
		if (!$this->TienePermisoBajaProgramacion($datos['act_codigo'],$datos['actprog_sec'])) {
			return false; 
		}
		$datosvalidados=$datos;	
		return true;	
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifProgramacion($datos,&$datosvalidados) {
	
		if (!$this->TienePermisoModificarProgramacion($datos['act_codigo'],$datos['actprog_sec'])) {
			return false; 
		}
		if (!$this->_DatosValidosComunesProgramacion($datos,$datosvalidados))
		   return false; 
	
		$datosvalidados['actprog_sec'] = $datos['actprog_sec'];
		return true;	
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAltaDictamen($datos,&$datosvalidados) {
	
		if (!$this->_DatosValidosComunesDictamen($datos,$datosvalidados))
		   return false; 
		
		return true;
	}
