		$error=$oWsCreditosPersonales->fault;
		$error_description=$oWsCreditosPersonales->getError();
		
		if ($error) {
			echo '<br><strong>Error: </strong>';
			echo "(".$error_description['faultcode'].",'".$error_description['faultstring']."','".$error_description['detail']. "')";
			echo '<br>';
			die();
		} else {
			echo '<br>';		
			echo '<h3>Información de Créditos:</h3>';
			$xml = iconv("ISO-8859-1","UTF-8//IGNORE",$result['resultado']);
