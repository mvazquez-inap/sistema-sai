<?php class cTablaUniversidad extends cTablaSysDesc {

	public function __construct($conexion) {
		
		$array_campos=array('clave'=> 'univ_codigo',
							'estado'=>'univ_estado',
							'descripcion'=>array('nombre_campo'=>'univ_descripcion', 'long_campo'=>40 ,'titulo_campo'=>'Universidad'),
							'fecha_alta'=>'univ_falta',
							'fecha_baja'=>'univ_fbaja');

		parent::__construct($conexion,"universidad",$array_campos);
		$this->SetearTituloTabla('Universidades para Actividades Becas');
	
		// Array con los cógigos de operaciones a ser registradas
		$array_log=array('ins'=>'39301', 'upd'=>'39303', 'del'=>'39302','chg_estado'=>'39304');
		$this->SetearLogs($array_log);

		// Array con las tablas en las que se busca para determinar si la baja es física o lógica.
		$this->SetearTablasTipoBaja(array(array('nom_tabla'=>'actividad_curso_diseno_inap','campo_tabla'=>'univ_codigo')));
	}		
} ?>