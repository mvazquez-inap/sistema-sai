		if (isset($ArregloDatos['act_codinap_exacto']))
		{
			if ($ArregloDatos['act_codinap_exacto']!="")
			{
				$sparam['pact_codinap_exacto']= $ArregloDatos['act_codinap_exacto'];
				$sparam['pxact_codinap_exacto']= 1;
			}
		}

		if (isset($ArregloDatos['actcur_estado']))
		{
			if ($ArregloDatos['actcur_estado']!="")
			{
				$sparam['pactcur_estado']= $ArregloDatos['actcur_estado'];
				$sparam['pxactcur_estado']= 1;
			}
		}

		if (isset($ArregloDatos['jurisdid_inap']))
		{
			if ($ArregloDatos['jurisdid_inap']!="")
			{
				$sparam['pjurisdid_inap']= $ArregloDatos['jurisdid_inap'];
				$sparam['pxjurisdid_inap']= 1;
			}
		}

		if (isset($ArregloDatos['tipoact_codigo']))
		{
			if ($ArregloDatos['tipoact_codigo']!="")
			{
				$sparam['ptipoact_codigo']= $ArregloDatos['tipoact_codigo'];
				$sparam['pxtipoact_codigo']= 1;
			}
		}


		if (isset($ArregloDatos['progcur_codigo']))	{
			if ($ArregloDatos['progcur_codigo']!="")
			{
				$sparam['pprogcur_codigo']= $ArregloDatos['progcur_codigo'];
				$sparam['pxprogcur_codigo']= 1;
			}
		}

		if (isset($ArregloDatos['areacur_codigo']))	{
			if ($ArregloDatos['areacur_codigo']!="")
			{
				$sparam['pareacur_codigo']= $ArregloDatos['areacur_codigo'];
				$sparam['pxareacur_codigo']= 1;
			}
		}

		if (isset($ArregloDatos['actdisinap_beca']))	{
			if ($ArregloDatos['actdisinap_beca']!="")
			{
				$sparam['pactdisinap_beca']= $ArregloDatos['actdisinap_beca'];
				$sparam['pxactdisinap_beca']= 1;
			}
		}



		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_actividad_curso_sin_dictamen_xdatos";
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el Actividad Curso.";
			$errormail="Error al buscar el Actividad Curso.".$errno;
			return false;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function BuscarActividadCursoAsignablesPoc($filtro,&$numfilas,&$resultado,&$error,&$errormail)	{

		$resultado = array();

		// Dado el poc busco el año
		$oPoc= new cPoc($this->conexion);
		if(!$oPoc->TraerDatosPoc($filtro['poc_codigo'],$datos_poc,$es_modif))
			return false;

		$sparam=array();

		$sparam+=array('pxact_nombre'=>0);
		$sparam+=array('pact_nombre'=>'');
		$sparam+=array('pxact_codigo'=>0);
		$sparam+=array('pact_codigo'=>'');

		if (isset($filtro['act_nombre'])) {
			if ($filtro['act_nombre']!="") {
				$sparam['pact_nombre'] = $filtro['act_nombre'];
				$sparam['pxact_nombre'] = 1;
			}
		}

		if (isset($filtro['act_codigo'])) {
			if ($filtro['act_codigo']!="") {
				$sparam['pact_codigo'] = $filtro['act_codigo'];
				$sparam['pxact_codigo'] = 1;
			}
		}

		$fecha_ini_poc = $datos_poc['poc_ano']."01"."01";
		$fecha_fin_poc = $datos_poc['poc_ano']."12"."31";

		$sparam+=array('pfecha_inicio1'=>$fecha_ini_poc);
		$sparam+=array('pfecha_inicio2'=>$fecha_ini_poc);
		$sparam+=array('pfecha_inicio3'=>$fecha_ini_poc);
		$sparam+=array('pfecha_inicio4'=>$fecha_ini_poc);
		$sparam+=array('pfecha_inicio5'=>$fecha_ini_poc);

		$sparam+=array('pfecha_fin1'=>$fecha_fin_poc);
		$sparam+=array('pfecha_fin2'=>$fecha_fin_poc);
		$sparam+=array('pfecha_fin3'=>$fecha_fin_poc);

		$sparam+=array('pxact_codinap'=>0);
		$sparam+=array('pact_codinap'=>"");


		$sparam+=array('pxactcur_estado'=>0);
		$sparam+=array('pactcur_estado'=>"-1");

		$sparam+=array('pxdic_codigo'=>0);
		$sparam+=array('pdic_codigo'=>"-1");

		$sparam+=array('pxdic_estado'=>1);
		$sparam+=array('pdic_estado'=>DICTAMENACTIVO);

		$sparam+=array('pxcon_dispo'=>0);
		$sparam+=array('pxsin_dispo'=>0);

		$sparam+=array('pxactprog_sec'=>0);
		$sparam+=array('pactprog_sec'=>"");

		$sparam+=array('porderby'=>"tipoact_codigo, act_nombre");

		// ACTIVIDADES INAP
		$sparam+=array('pxjurisdid_inap'=>0);
		$sparam+=array('pjurisdid_inap'=>'-1');

		$sparam+=array('pxtipoact_codigo'=>1);
		$sparam+=array('ptipoact_codigo'=>TIPOACTCURSOINAP);

		$spnombre="sel_actividad_curso_dictaminada_en_fechas_xdatos";

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultDictamenesActINAP,$numfilas,$errno))	{
			$error=" Error al obtener actividades/programaciones disponibles para el poc.";
			$errormail="Inap - \n poc_codigo= ".$filtro['poc_codigo']."\n pfecha_inicio1= ".$sparam['pfecha_inicio1']."\npfecha_fin1= ".$sparam['pfecha_fin1'].$errno;
			return false;
		}

		while ($fila = mysqli_fetch_assoc($resultDictamenesActINAP))  {
				$resultado[$fila['act_codigo']]= array ('poc_codigo'=>$filtro['poc_codigo'],
									 'act_codigo'=>$fila['act_codigo'],
									 'tipoact_codigo'=>$fila['tipoact_codigo'],
									 'act_codinap'=>$fila['act_codinap'],
									 'act_nombre'=>$fila['act_nombre']
									 );
		}

		// Actividades JURISDICCIONALES
		$sparam['pxtipoact_codigo']=1;
		$sparam['ptipoact_codigo']=TIPOACTCURSOJURISD;
		$sparam['pxjurisdid_inap']=1;
		$sparam['pjurisdid_inap']=$filtro['jurisdid_inap'];

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultDictamenesActJURISD,$numfilas,$errno))	{
			$error=" Error al obtener actividades/programaciones disponibles para el poc.";
			$errormail="Jurisdiccionales - \n poc_codigo= ".$filtro['poc_codigo']."\n pfecha_inicio1= ".$sparam['pfecha_inicio1']."\npfecha_fin1= ".$sparam['pfecha_fin1'].$errno;
			return false;
		}
		while ($fila = mysqli_fetch_assoc($resultDictamenesActJURISD))  {
				$resultado[$fila['act_codigo']]= array ('poc_codigo'=>$filtro['poc_codigo'],
									 'act_codigo'=>$fila['act_codigo'],
									 'tipoact_codigo'=>$fila['tipoact_codigo'],
									 'act_codinap'=>$fila['act_codinap'],
									 'act_nombre'=>$fila['act_nombre']
									 );
		}

		$numfilas=count($resultado);

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function MostrarPrestadoresActividad($conexion,$act_codigo, $operacion="V") {

	if ($operacion=="A") { ?>
		<a href="actividad_curso_prestador_docente.dhtml?act_codigo=<?= $act_codigo; ?>">Actualizar Equipo Docente de la actividad</a>
		<br /> &nbsp;
<?php	}

	// Selecciono todos los prestadores asociados a la actividad.
	$oPrestadorDocente = new cPrestadorDocente($conexion);
	$ArregloDatos= array();
	$ArregloDatos['act_codigo']=$act_codigo;

	if(!$oPrestadorDocente->BuscarPrestadorDocentexActividad($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
		$txt_sys_mail="\nact_codigo=".$act_codigo."\nerror=".$error;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}

	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>$numfilas
	);

	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearTituloGrilla("Prestadores Docentes de la Actividad");
	$oGrilla->SetearAnchoGrilla('100%');

	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,"CUIT/CUIL");
	$oGrilla->Setear('campo_grilla',$miColumna1,"presdoc_cuilt");
	$oGrilla->Setear('align_columna',$miColumna1,'left');
	$oGrilla->Setear('ancho_columna',$miColumna1,'20%');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,"Apellido");
	$oGrilla->Setear('campo_grilla',$miColumna2,"presdoc_apellido");
	$oGrilla->Setear('align_columna',$miColumna2,'left');

	$miColumna3 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna3,"Nombre");
	$oGrilla->Setear('campo_grilla',$miColumna3,"presdoc_nombre");
	$oGrilla->Setear('align_columna',$miColumna3,'left');

	if (!$oGrilla->CargarGrilla($resultado))
		return false;

	$oGrilla->MostrarGrilla();

	return true;
}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosAltaActividadCurso($datos,&$datosvalidados)	{

		$datosvalidados=array();

		if (!$this->_DatosValidosComunesActividadCurso($datos,$datosvalidados))
		   return false;

		$spnombre = "sel_tipo_actividad_xformact_codigo_orden";
		$spparam = array("pformact_codigo"=>FORMATOCURSO,"porderby"=>"tipoact_descripcion");
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("tipoact_codigo"=>$datos["tipoact_codigo"]),$resultado,$filatipo_act,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el tipo de Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados['tipoact_codigo'] = $datos['tipoact_codigo'];

		$datosvalidados['jurisdid_inap'] = $datos['jurisdid_inap'];
		$datosvalidados['actcur_estado'] = $datos['actcur_estado'];
		$datosvalidados['actcur_creditos'] = $datos['actcur_creditos'];

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosEliminarActividadCurso($act_codigo,&$datosvalidados)	{

		// Se elimina la actividad
		$datosvalidados=array();
		if (!$this->TraerDatosActividadCurso($act_codigo,$datosvalidados,$es_modif_act_curso))
			return false;

		// Debe existir
		if (!$es_modif_act_curso) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		// No debe estar asignada a ninguna comisión
		$oComision=new cComision($this->conexion);
		$ArregloDatos=array();
		$ArregloDatos['act_codigo']=$act_codigo;
		if (!$oComision->BuscarComision($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas>=1) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La actividad tiene comisiones, las mismas deben ser eliminadas <br>antes de eliminar la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}

		// A los cursos sólo se les puede agregar el formato de autodesarrollo.
		// Verificar que no tiene asignado el formato de autodesarrollo.
		if (!$this->TieneFormato($act_codigo,FORMATOAUTO,$tiene_formato)) {
			$errormail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error verificar formatos de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($tiene_formato) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La actividad tiene asignado el formato de Autodesarrollo.<br><br>Se Deber&aacute; eliminar dicho formato antes de eliminar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosModifActividadCurso($datos,&$datosvalidados)	{

		$datosvalidados=array();
		if (!$this->_DatosValidosComunesActividadCurso($datos,$datosvalidados))
		   return false;

		$datosvalidados['act_codigo'] = $datos['act_codigo'];
		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function _DatosValidosComunesActividadCurso($datos,&$datosvalidados)	{
		$datosvalidados=array();
		$datosvalidados['actcur_obs'] = $datos['actcur_obs'];
		return true;
	}
