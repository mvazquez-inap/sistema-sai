//----------------------------------------------------------------------------------------- 
// cambia algunos caracteres para que no de error el JS

	function ReemplazarCharJS($texto)
	{
		if($texto!="")
			return str_replace(array("'","\r","\n"),array("\'","\\r","\\n"),$texto);
		else
			return $texto;
	}

//----------------------------------------------------------------------------------------- 	
// Convierte la fecha de un formato a otro

	function ConvertirFecha($fecha,$formatoinput,$formatooutput)
	{
		if($fecha=='') return "";
		
		if($formatoinput=='dd/mm/aaaa' && $formatooutput=='aaaa/mm/dd')
			return substr($fecha,6,4)."/".substr($fecha,3,2)."/".substr($fecha,0,2);
		elseif($formatoinput=='aaaa-mm-dd' && $formatooutput=='dd/mm/aaaa')
			return substr($fecha,8,2)."/".substr($fecha,5,2)."/".substr($fecha,0,4);
		elseif($formatoinput=='timestamp' && $formatooutput=='dd/mm/aaaa')
			return substr($fecha,6,2)."/".substr($fecha,4,2)."/".substr($fecha,0,4);
	}

//----------------------------------------------------------------------------------------- 
// Devuelve la descripción del módulo ejecutado, si existe

	function BuscarTituloModulo($conexion,$string,$separador)
	{
		// si no se informa $string, 
		// se toma el del server 
		if($string=="")
			$string=$_SERVER['PHP_SELF'];
			
		// se busca el último separador en la cadena		
		$posicion=strrpos($string,$separador);
		
		if($posicion === false)
			return "";
			
		$archivonom=substr($string,$posicion+1);
		
		// se busca el codigo del archivo que se está ejecutando
		// sólo si existe un único código
		$spnombrearchivo="sel_archivos_xcampovariable";
		$spparamarchivo =array("pnombrecampo"=>"archivonom");			
		$spparamarchivo+=array("pvalorcampo"=>$archivonom);
		if(!$conexion->ejecutarStoredProcedure($spnombrearchivo,$spparamarchivo,$queryarchivo,$numfilas,$errno))
		{
			$arraymensajepantalla =array();	
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => "Error en selección archivos - numfilas='".$numfilas."' - errno='".$errno."'. ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return "";
		}	
			
		if($numfilas!=1)
			return "";

	   	$filaarchivo = mysqli_fetch_assoc($queryarchivo);
		
		// se busca la descripción del módulo que comienza
		// ejecutando ese archivo, sólo si existe un único módulo
		
		$spnombremodulo="sel_modulos_xcampovariable";
		$spparammodulo =array("pnombrecampo"=>"archivocod");			
		$spparammodulo+=array("pvalorcampo"=>$filaarchivo['archivocod']);
		if(!$conexion->ejecutarStoredProcedure($spnombremodulo,$spparammodulo,$querymodulo,$numfilas,$errno))
		{
			$arraymensajepantalla =array();	
			$arraymensajemail =array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$arraymensajemail+=array("texto" => "Error en selección módulos - numfilas='".$numfilas."' - errno='".$errno."'. ");
			FuncionesPHPAtlinea::MostrarMensaje($conexion,GENERAL_MSG_ERRGRAVE,$arraymensajepantalla,$arraymensajemail);
			return "";
		}	
			
		if($numfilas!=1)
			return "";
		
	   	$filamodulo = mysqli_fetch_assoc($querymodulo);
		
		return $filamodulo['modulodesc'];
					
	}

//----------------------------------------------------------------------------------------- 
/**
* array_column_sort 
* 
* function to sort an "arrow of rows" by its columns
* exracts the columns to be sorted and then
* uses eval to flexibly apply the standard
* array_multisort function
*
* uses a temporary copy of the array whith "_" prefixed to  the keys
* this makes sure that array_multisort is working with an associative
* array with string type keys, which in turn ensures that the keys 
* will be preserved.
*
* TODO: find a way of modifying the keys of $array directly, without using
* a copy of the array. 
* 
* flexible syntax:
* $new_array = array_column_sort($array [, 'col1' [, SORT_FLAG [, SORT_FLAG]]]...);
* 
* original code credited to Ichier (www.ichier.de) here:
* http://uk.php.net/manual/en/function.array-multisort.php
*
* prefixing array indeces with "_" idea credit to steve at mg-rover dot org, also here:
* http://uk.php.net/manual/en/function.array-multisort.php
* 
*/

	function array_column_sort() 
	{ 
		$args = func_get_args();
		$array = array_shift($args);
		$sort_array=array();
		
		// make a temporary copy of array for which will fix the 
		// keys to be strings, so that array_multisort() doesn't
		// destroy them
		$array_mod = array();
		foreach ($array as $key => $value)
			$array_mod['_' . $key] = $value;
		
		$i = 0;
		$multi_sort_line = "return array_multisort( ";
		foreach ($args as $arg) 
		{
			$i++;
			if ( is_string($arg) ) 
			{
				foreach ($array_mod as $row_key => $row) 
				{
					$sort_array[$i][$row_key] = $row[$arg];
				}
			} 
			else 
			{
				$sort_array[$i] = $arg;
			}
			$multi_sort_line .= "\$sort_array[" . $i . "], ";
		}
		$multi_sort_line .= "SORT_ASC,\$array_mod );";
	
		eval($multi_sort_line);
	
		// now copy $array_mod back into $array, stripping off the "_"
		// that we added earlier.
		$array = array();
		foreach ($array_mod as $key => $value)
			$array[ substr($key, 1) ] = $value;
	
		return $array;
	}

