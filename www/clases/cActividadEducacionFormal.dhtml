<?php
//-----------------------------------------------------------------------------------------
class cActividadEducacionFormal extends cActividad {

	public function __construct($conexion) {
		parent::__construct($conexion);
	}

//-----------------------------------------------------------------------------------------
	function TraerDatosActividadDetalles($act_codigo,$tipoact_codigo,&$datosresult,&$es_modif) {

		if (!$this->TraerDatosActividadEducacionFormal($act_codigo,$datosresult_detalle,$es_modif)) {
			return false;
		} else {
			$datosresult['act_codigo']=$datosresult_detalle['actividad']['act_codigo'];
			$datosresult['act_formato']=FORMATOEFORMAL;
			$datosresult['tipoact_codigo']=$tipoact_codigo;
			$datosresult['act_nombre']=$datosresult_detalle['actividad']['act_nombre'];
			$datosresult['act_codinap']=$datosresult_detalle['actividad']['act_codinap'];
			$datosresult['act_estado']=$datosresult_detalle['actividad_eformal']['actform_estado'];
			return true;
		}
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosActividadEducacionFormal($act_codigo,&$datosresult,&$es_modif) {

		$datosresult=array();
		$es_modif = false;

		if (!$this->TraerDatosActividad($act_codigo,$result_actividad,$es_modif_act))
			return false;

		if ($es_modif_act) {
		
			$datosresult['actividad']=$result_actividad; // Datos de la actividad
			$sparam=array('pact_codigo'=>$act_codigo);
			$spnombre="sel_actividad_eformal_xact_codigo";
		
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
			{
				$errormail="\nact_codigo".$act_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			if ($numfilas == 1)	{
				$datosresult['actividad_eformal'] = mysqli_fetch_assoc($resultado);
				$es_modif = true;
			}
		} // $es_modif_act

		return true;
	}
	
	//-----------------------------------------------------------------------------------------------------

	function BuscarActividadEducacionFormal($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{


		$sparam=array('pxact_codigo'=>0);
		$sparam+=array('pact_codigo'=>"");
				
		$sparam+=array('pxact_codinap'=>0);
		$sparam+=array('pact_codinap'=>"");
		
		$sparam+=array('pxtipoact_codigo'=>0);
		$sparam+=array('ptipoact_codigo'=>"-1");

		$sparam+=array('pxact_nombre'=>0);
		$sparam+=array('pact_nombre'=>"");

		$sparam+=array('pxactform_estado'=>0);
		$sparam+=array('pactform_estado'=>"");

			
		if (isset($ArregloDatos['act_codigo']) &&  $ArregloDatos['act_codigo']!="")
		{
			$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
			$sparam['pxact_codigo']= 1;
		}	

		if (isset ($ArregloDatos['act_nombre']) && $ArregloDatos['act_nombre']!="")
		{
			$sparam['pact_nombre']= $ArregloDatos['act_nombre'];
			$sparam['pxact_nombre']= 1;
		}	
	
		if (isset($ArregloDatos['act_codinap']) &&  $ArregloDatos['act_codinap']!="")
		{
			$sparam['pact_codinap'] = $ArregloDatos['act_codinap'];
			$sparam['pxact_codinap'] = 1;
		}	
	
		if (isset($ArregloDatos['actform_estado']) &&  $ArregloDatos['actform_estado']!="")
		{
			$sparam['pactform_estado'] = $ArregloDatos['actform_estado'];
			$sparam['pxactform_estado'] = 1;
		}	
		
		if (isset($ArregloDatos['tipoact_codigo']) &&  $ArregloDatos['tipoact_codigo']!="")
		{
			$sparam['ptipoact_codigo'] = $ArregloDatos['tipoact_codigo'];
			$sparam['pxtipoact_codigo']= 1;
		}				
		
		$sparam+=array('porderby'=>"act_nombre");
		if (isset ($ArregloDatos['orderby']) && $ArregloDatos['orderby']!="")
		{
			$sparam['porderby'] = $ArregloDatos['orderby'];
		}
		$spnombre="sel_actividad_eformal_xdatos";	

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar en Actividad Educación Formal.";
			$errormail="Error al buscar en Actividad Educación Formal.".$errno;
			return false;
		}
	
		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function AltaDatosActividadEducacionFormal($datos,&$act_codigo_nuevo,&$act_codinap) {

		$datosvalidados=array();
		$this->_AguparDatosPost($datos,$datos_agrup,false);

		$datos_act=$datos_agrup['actividad'];
	
		if(!$this->AltaDatosActividad($datos_act,$act_codigo_nuevo,true,"EF",$act_codinap))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38001","act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);
			
		if(!$this->_DatosValidosAltaEducacionFormal($datos_agrup['actividad_eformal'],$datosvalidados))
			return false;

		$spnombre="ins_actividad_eformal";
		$spparam=array('pact_codigo'=>$act_codigo_nuevo,
					  'ptipoact_codigo'=>$datosvalidados['tipoact_codigo'],
					  'pactform_estado'=>$datosvalidados['actform_estado'],
		  			  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad .",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}


		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function EliminarDatosActividadEducacionFormal($act_codigo) {

		if(!$this->_DatosValidosEliminarActividadEducacionFormal($act_codigo,$datosvalidados))
			return false;

		$oActividadEducacionFormalPersona  = new cActividadEducacionFormalPersona($this->conexion);

		$ArregloDatos= array();
		$ArregloDatos['act_codigo'] = $act_codigo;		
			
		if (!$oActividadEducacionFormalPersona->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas_personas_asig,$result_personas,$error,$errormail)) {
			$txt_sys_mail="\nvalor_buscado_".$fila_eformal['actividad_eformal']['act_codigo']."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar las personas asignadas a la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		}			
			
		if ($numfilas_personas_asig> 0)		
		{	
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La actividad no puede eliminarse pues tiene personas asignadas.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		$spnombre="del_actividad_eformal_xact_codigo";
		$spparam=array('pact_codigo'=>$act_codigo);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la Actividad de Educación Formal.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if(!$this->EliminarDatosActividad($act_codigo, FORMATOEFORMAL))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38002","act_codigo=".$act_codigo,$_SESSION['usuariocod']);

		return true;
	}
//-----------------------------------------------------------------------------------------------------
	function ModifDatosActividadEducacionFormal($datos)	{

		$this->_AguparDatosPost($datos,$datos_agrup,true);

		$datos_eformal['actividad']=$datos_agrup['actividad'];
		$datos_eformal['actividad_eformal']=$datos_agrup['actividad_eformal'];

		if(!$this->ModifDatosActividad($datos_eformal['actividad']))
			return false;
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38003","act_codigo=".$datos_agrup['actividad']['act_codigo'],$_SESSION['usuariocod']);

		if(!$this->_DatosValidosModifActividadEducacionFormal($datos_agrup['actividad_eformal'],$datosvalidados))
			return false;

		$spnombre="upd_actividad_eformal_xact_codigo";
		$spparam=array('pact_codigo'=>$datosvalidados['act_codigo'],
					  'pactform_estado'=>$datosvalidados['actform_estado'],
					  'pultmodusuario'=>$_SESSION['usuariocod'],
  			          'pultmodfecha'=> date("Y/m/d H:i:s")
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			$txt_sys_mail='\nact_codigo='.$datosvalidados['act_codigo'];
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la Actividad de Educación Formal.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}


		return true;
	}

//-----------------------------------------------------------------------------------------------------
	function TienePermisoBaja($act_codigo,$rolcod,$jurisdid) {
		return  $this->TienePermisoModificar($act_codigo,$rolcod,$jurisdid) ;
	} 

//-----------------------------------------------------------------------------------------------------
	function TienePermisoModificar($act_codigo,$rolcod,$jurisdid) {
	
		// Valida el estado con rol y la jurisdicción
		if (!$this->TraerDatosActividadEducacionFormal($act_codigo,$fila_actividad,$es_modif))
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error no existe la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}
		
		if ($fila_actividad['actividad_eformal']['actform_estado'] == ACTFORMALACTIVO)
			return true;
		else 
		{
			$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTFORMALESTADO","' and constantecod='",$fila_actividad['actform_estado'],"'"),$descri,$numfilas,$errorcod);
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad de Educación Formal (".$descri."), <br> no le permite realizar la operacion.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		if (!($rolcod == USUACTJUR || $rolcod==COORDINADORTECNICO)) 
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene acceso a la Actividad de Educación Formal.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		return true;
	}
	
//-----------------------------------------------------------------------------------------------------
	function ValidarFormAltaActividadEducacionFormal() {

	$this->ValidarFormAltaActividad();
?>
	function ValidarFormAltaActividadEducacionFormal(formulario,operacion) {
            	
			if ((trim(formulario.act_nombre.value)=="")) {
				alert("Debe ingresar el nombre de la actividad.");
				formulario.act_nombre.focus();
				return false;
			}

			// Tipo de actividad		- [tipoact_codigo] 			- [OBLIG]
			if ((trim(formulario.tipoact_codigo.value)=="")) {
				alert("Debe ingresar el tipo de la actividad.");
				formulario.tipoact_codigo.focus();
				return false;
			}
			var s = trim(formulario.act_nombre.value);			
			if (s.length >255) {
				alert("Debe ingresar un nombre de la actividad, con menos de 255 caracteres.");
				formulario.act_nombre.focus();
				return false;
			}	
 
			return true;
		}
<?php }

