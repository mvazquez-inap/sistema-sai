<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);
//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccion($conexion,$modulo,$ArregloDatos) {

	$ArregloDatos['orderby'] = "dis_fecha,dis_numero";
	$oDisposicion= new cDisposicion($conexion);

	if (!$oDisposicion->BuscarDisposicion($ArregloDatos,$numfilas,$result,$error,$errormail)) {
		$txt_sys_mail="\nvalor_buscado_".$valor_buscado."\nerror=".$errormail;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}			
	
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>10
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
	
	$oGrilla = new cGrilla($opciones);

	$oGrilla->SetearTituloGrilla('Disposiciones');	
	$oGrilla->SetearAnchoGrilla('90%');
	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Disposición');
	$oGrilla->Setear('campo_grilla',$miColumna1,'dis_numero');
	$oGrilla->Setear('align_columna',$miColumna1,'left');

	$miColumna2 = $oGrilla->AddColumna('popup');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Detalle');
	$oGrilla->Setear('ancho_columna',$miColumna2,'60');
	$oGrilla->Setear('align_columna',$miColumna2,'center');
	$oGrilla->Setear('imagen',$miColumna2,'images/verdetalle.gif');
	$oGrilla->Setear('altImagen',$miColumna2,'Ver detalle disposición');		
	$oGrilla->Setear('url',$miColumna2,'disposicion_ver_detalle.dhtml');
	$oGrilla->Setear('ventanaAnchoPopup',$miColumna2,'720');
	$oGrilla->Setear('ventanaAltoPopup',$miColumna2,'450');
	$oGrilla->Setear('ventanaVarxPopup',$miColumna2,'50');
	$oGrilla->Setear('ventanaVaryPopup',$miColumna2,'50');
	$oGrilla->AddParametrosURL($miColumna2,"dis_codigo",'dis_codigo');

	$miColumna3 = $oGrilla->AddColumna('addValor');
	$oGrilla->Setear('titulo_columna',$miColumna3,'Seleccionar');
	$oGrilla->Setear('imagen',$miColumna3,'images/seleccionar.jpg');
	$oGrilla->Setear('altImagen',$miColumna3,'Seleccionar');						
	$oGrilla->Setear('idtextboxAddValor',$miColumna3,$_SESSION['array_busqueda_basica_disposicion']['idtextboxAddValor']);

	if (!$_SESSION['array_busqueda_basica_disposicion']['submit']) {
		$oGrilla->Setear('submitAddValor',$miColumna3,'no');
		$oGrilla->Setear('documentAddValor',$miColumna3,'window.opener.document');
		$oGrilla->Setear('nombreContenidoAddValor',$miColumna3,'dis_numero');
		$oGrilla->Setear('idtextoContenidoAddValor',$miColumna3,'dis_numero');
	} else {
		$oGrilla->Setear('submitAddValor',$miColumna3,'si');
		$oGrilla->Setear('nombreFormularioSubmitAddValor',$miColumna3,$_SESSION['array_busqueda_basica_disposicion']['formulario']);
	}
	$oGrilla->Setear('ancho_columna',$miColumna3,'60');
	$oGrilla->AddParametrosAddValor($miColumna3,'dis_codigo');

	if (!$oGrilla->CargarGrilla($result))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
//----------------------------------------------------------------------------------------- 
?>
