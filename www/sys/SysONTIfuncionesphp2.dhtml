//----------------------------------------------------------------------------------------- 
// Si existe la variable en el QUERY_STRING,
// elimina todo desde ahi en adelante

	static function ArmarQueryString($variable,$querystring="")
	{
		// si no se informa $querystring, 
		// se toma el el querystring del server 
		if($querystring=="")
			$querystring=$_SERVER['QUERY_STRING'];
		
		// si existe en el querystring la variable $variable, se elimina
		// para asegurarse que el nombre de la variable es exacto:
		
		// Primero se buscan variables intermedias
		// 1- se agrega a variable un '&' al principio
		// 2- se agrega a variable un '=' al final
		$variablebusq="&".$variable."=";  
		$posicion=strpos($querystring,$variablebusq);
		if($posicion>0)
			return substr($querystring,0,$posicion);
		
		// Si no se encontró, se busca si es la primera variable
		$variablebusq=$variable."=";  
		$posicion=strpos($querystring,$variablebusq);
		
		
		if($posicion===false)
			return $querystring;
		elseif($posicion==0)
			return "";
		else
			return $querystring;
	}

