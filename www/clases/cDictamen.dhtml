									<a class="linkListadoMenu" href='javascript:void(0)' onClick="Popup('actividad_ver_dis.dhtml?act_codigo=<?= htmlspecialchars($fila_detalle['act_codigo'],ENT_QUOTES)."&amp; tipoact_codigo=".$fila_detalle['tipoact_codigo']; ?>','ventana_diseno',650,420,screen.availWidth-650,screen.availHeight-420,'yes');"> Ver diseño de la actividad </a> 
