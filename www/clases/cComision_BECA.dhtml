//-----------------------------------------------------------------------------------------------------	
	function BuscarComisionInscriptos($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{
		
		$spnombre="sel_comision_persona_xcomi_codigo_pers_apellido";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$ArregloDatos,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar los inscriptos.";
			$errormail="Error al buscar los inscriptos \nerror=.".$errno;
			return false;
		}
		
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function BuscarComisionInscriptosFiltro($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{
		$spnombre="sel_comision_persona_xcomi_codigo_pers_apellido_desde_hasta";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$ArregloDatos,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar los inscriptos.";
			$errormail="Error al buscar los inscriptos \nerror=.".$errno;
			return false;
		}
		
		return true;
	}
//-----------------------------------------------------------------------------------------
	function ValidarFormAltaComision()	{
?>		
		
		function VerificarExistenciaCodigoInapComision(formulario,valor_buscado,codigo_buscado) {
		
			var ajax=nuevoAjax();
			var variables="?tipo=C&valor_buscado="+valor_buscado+"&valor_codigo_unico="+codigo_buscado;
			var direccion= "verifico_existencia_codigo_ajax.dhtml"+variables;
			var ejecutook=false;
			
			if (valor_buscado=='') {
				alert('Código INAP no puede quedar en blanco.');
				return false;				
			}
			
			ajax.open("GET",direccion,true);
			ajax.onreadystatechange=function() {
				if (ajax.readyState==4) {	
					if (ajax.responseText.substr(0,15)=="//tienepermisos") 	{				
						eval (ajax.responseText);
						if (!ejecutook){	
							alert('El código INAP ingresado ya existe.');
							formulario.comi_codinap.value = "";
							formulario.comi_codinap.focus();
							return false;
						} else {
							alert('El código INAP ingresado no existe, puede continuar la carga.');
							return true;
						}
					} else {	
						alert (ajax.responseText);
						return false;
					}
				}
				return true;
			}	
			ajax.send(null);		
			return false;
		}
	
		function ValidarFormAltaComision(formulario,operacion) {


			if(formulario.tipoins_codigo.value==""){
				alert("Debe seleccionar el tipo de inscripción");
				formulario.tipoins_codigo.focus();
				return false;
			}	

			if ((!formulario.comi_web[0].checked) && (!formulario.comi_web[1].checked))
			{
				alert("Debe seleccionar la posibilidad de Inscribir vía web");
				return false;
			}
			

			if(formulario.comi_vacantes.value=="" || !ValidarContenido(formulario.comi_vacantes.value,"NumericoEntero") || formulario.comi_vacantes.value<=0){
				alert("Debe ingresar la cantidad de vacantes y debe ser un número entero mayor a cero");
				formulario.comi_vacantes.focus();
				return false;
			}	
			if(formulario.comi_sobreventa.value!="")
			{
				if(!ValidarContenido(formulario.comi_sobreventa.value,"NumericoEntero") || formulario.comi_sobreventa.value < 0){
					alert("La sobreventa debe ser un valor número mayor o igual a cero");
					formulario.comi_sobreventa.focus();
					return false;
				}	
			}
			
			if ((trim(formulario.pais_codigo.value)=="")) {
				alert("Debe ingresar un pais");
				formulario.pais_codigo.focus();
				return false;
			}	

			if ((trim(formulario.pais_codigo.value)== <?php echo ARGENTINA?>)){
				if ((trim(formulario.prov_codigo.value)=="")){
					alert("Debe ingresar una provincia");
					formulario.prov_codigo.focus();
					return false;
				}					
			}

			if ((trim(formulario.sede_codigo.value)=="")) {
				alert("Debe seleccionar la sede");
				formulario.sede_codigo.focus();
				return false;
			}	

			if (trim(formulario.comi_domicilio.value).length > 150) {
				alert("El domicilio no puede superar los 150 caracteres.");
				formulario.comi_domicilio.focus();
				return false;
			}	
			return true;
		}			

	function SeleccionPais(formulario){
		var elSelect = document.getElementById('datos_provincia');
		if (formulario.pais_codigo.value == <?php echo ARGENTINA ?>) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";
		}
	}
<?php }
