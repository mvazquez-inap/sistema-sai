	public function MostrarMasLeidas() {
	 	
		 	
		$oArticulo = new cArticulos($this->conexion);
		
		$datosbusqueda = array ('estadopub' => ESTPUBPUBLICADA,
						    	'estadoart' => ESTARTPUBLICADO,
		   				    	'mas_leido' => ESMASLEIDO_SI,
						    	'orderby' => "orden_mas_leido DESC",
						);
		
	 	$tipo = 0; 		// Distinto de 1 porque no quiero el count
	
	 	if (!$oArticulo->BusquedaAvanzada($datosbusqueda,$tipo,$resultado,$numfilas))
			die();		
			
		$salida='	<div class="menulateral">
