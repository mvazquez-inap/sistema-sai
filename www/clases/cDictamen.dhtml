	function AgregarDetalleDictamenActCurso($resultActCurso,
										&$array_DictamenesActCursoInap,
										&$array_DictamenesActCursoInstitucional,
										&$array_DictamenesActCursoJurisdiccional) {

	$oDisposicion = new cDisposicion($this->conexion);
	while ($filaDicActCurso=mysqli_fetch_assoc($resultActCurso)) {

			$filaDis=array('dis_codigo'=>NULL,'dis_numero'=>NULL,'dis_fecha'=>NULL);
			if(isset($filaDicActCurso['dis_codigo'])) {
				if (!$oDisposicion->TraerDatosDisposicion($filaDicActCurso['dis_codigo'],$fila_disposicion,$es_modif)) {
						$txt_sys_mail="Error buscando los datos de la disposición.\ndis_codigo=".$filaDicActCurso['dis_codigo'];
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al mostrar detalles de la disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
						return false;		
				} elseif ($es_modif) 
						$filaDis=array('dis_codigo'=>$fila_disposicion['dis_codigo'],'dis_numero'=>$fila_disposicion['dis_numero'],
									   'dis_fecha'=> FuncionesPHPLocal::ConvertirFecha($fila_disposicion["dis_fecha"],'aaaa-mm-dd','dd/mm/aaaa'));
			} 
			
			$norma="";
			$this->conexion->TraerCampo("tipo_actividad","tipoact_norma_legal",array("tipoact_codigo='",$filaDicActCurso['tipoact_codigo'],"'"),$norma,$numfilas,$errorcod); 
	
			$filaDic=array( 'dic_codigo'=>$filaDicActCurso['dic_codigo'], 'dic_observaciones'=>$filaDicActCurso['dic_observaciones'],
							'actprog_fecha_inicio'=> FuncionesPHPLocal::ConvertirFecha($filaDicActCurso["actprog_fecha_inicio"],'aaaa-mm-dd','dd/mm/aaaa'),
							'actprog_fecha_fin'=> FuncionesPHPLocal::ConvertirFecha($filaDicActCurso["actprog_fecha_fin"],'aaaa-mm-dd','dd/mm/aaaa'),
							'dic_estado'=>$filaDicActCurso['dic_estado']
							);						
			$filaCurso=array('act_creditos'=>$filaDicActCurso['actcur_creditos'],'tipoact_codigo'=>$filaDicActCurso['tipoact_codigo'],
							 'tipoact_norma_legal'=>$norma);
	
			$jurisdexp="";
			$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filaDicActCurso['jurisdid_exp'],"'"),$jurisdexp,$numfilas,$errorcod);
			$filaExp=array('exp_codigo'=> $filaDicActCurso['exp_codigo'],'exp_numero'=>$filaDicActCurso['exp_numero'],
						   'jurisdid_exp'=>$jurisdexp);				
		
			$filaAct=array('act_codigo'=>$filaDicActCurso['act_codigo'],'act_nombre'=>$filaDicActCurso['act_nombre'],'act_codinap'=>$filaDicActCurso['act_codinap']);
	
			switch($filaDicActCurso['tipoact_codigo']) 	{
				
				case TIPOACTCURSOINAP:
					$oActividadCursoInap = new cActividadCursoInap($this->conexion);
					if (!$oActividadCursoInap->TraerDatosActividadCursoInap($filaDicActCurso['act_codigo'],$fila_curso,$es_modif))
						return false;
	
					$programa="";
					if (!$this->conexion->TraerCampo("programa_curso_inap","progcur_descripcion",array("progcur_codigo='",$fila_curso['actividad_curso_inap']['progcur_codigo'],"'"),$programa,$numfilas,$errorcod)) 
						return false;
					else
						$filaCurso+=array('progcur_descripcion'=>$programa);
						
					$area="";
					if (!$this->conexion->TraerCampo("area_curso_inap","areacur_descripcion",array("areacur_codigo='",$fila_curso['actividad_curso_inap']['areacur_codigo'],"'"),$area,$numfilas,$errorcod)) 
						return false;
					else 
						$filaCurso+=array('areacur_descripcion'=>$area);
			
					$array_DictamenesActCursoInap[]=array( 'datos_actividad'=>$filaAct,
												'datos_actividad_tipo'=>$filaCurso,
												'datos_dictamen'=>$filaDic, 
												'datos_expediente'=>$filaExp,
												'datos_disposicion'=>$filaDis);
					break;
					
				case TIPOACTCURSOINST:
					$oActividadCursoInstitucional = new cActividadCursoInstitucional($this->conexion);
					if (!$oActividadCursoInstitucional->TraerDatosActividadCursoInstitucional($filaDicActCurso['act_codigo'],$fila_curso,$es_modif))
						return false;
					
					$nombre_institucion="";	
					$oActividadCursoInstitucional->ObtenerOrganismoInstitucion($fila_curso['actividad_curso_institucional']['orgapri_codigo'],
														$fila_curso['actividad_curso_institucional']['jurisdid_apn'],
														$fila_curso['actividad_curso_institucional']['orgapub_codigo'],				
														$nombre_institucion,$sector_org,$tipoorg_codigo,$campo_institucion);
	
					$filaCurso['insti_orga']=$nombre_institucion;								
	
					$array_DictamenesActCursoInstitucional[]=array( 'datos_actividad'=>$filaAct,
												'datos_actividad_tipo'=>$filaCurso,
												'datos_dictamen'=>$filaDic, 
												'datos_expediente'=>$filaExp,
												'datos_disposicion'=>$filaDis);
					break;
				case TIPOACTCURSOJURISD :
					$oActividadCursoJurisdiccional = new cActividadCursoJurisdiccional($this->conexion);
					if (!$oActividadCursoJurisdiccional->TraerDatosActividadCursoJurisdiccional($filaDicActCurso['act_codigo'],$fila_curso,$es_modif))
						return false;	
						
					// busco el POC 
						
						$ArregloDatosPOC=array('dic_estado'=>DICTAMENACTIVO,
												'act_codigo'=>$filaDicActCurso['act_codigo']);

						$oActividadCursoJurisdiccional->BuscarActividadResumenPoc($ArregloDatosPOC,$numfilas_poc,$resultado_poc,$error,$errormail);
						$poc_actividad = "";
						while ($fila_poc = mysqli_fetch_assoc($resultado_poc)) {
							$poc_actividad .=$fila_poc["poc_ano"]." - ";
						}
						


						
					$array_DictamenesActCursoJurisdiccional[]=array( 'datos_actividad'=>$filaAct,
												'datos_actividad_tipo'=>$filaCurso,
												'datos_dictamen'=>$filaDic, 
												'datos_expediente'=>$filaExp,
												'datos_disposicion'=>$filaDis,
												'datos_perfil'=>$fila_curso["actividad_curso_jurisdiccional"]["actdisjurisd_perfil"],
												'datos_poc'=>$poc_actividad);
												
												
					break;
			} 	
		}
		if (mysqli_num_rows($resultActCurso) > 0 )
			mysqli_data_seek($resultActCurso, 0);
		return true;
	} 	
//-----------------------------------------------------------------------------------------------------	
function AgregarDetalleDictamenActExterna($resultDicActExt,&$array_DictamenesActExt) {

	$oDisposicion = new cDisposicion($this->conexion);
	while ($filaDicActExt=mysqli_fetch_assoc($resultDicActExt)) {

		$filaDis=array('dis_codigo'=>NULL,'dis_numero'=>NULL,'dis_fecha'=>NULL);
		if( isset($filaDicActExt['dis_codigo'])) {
			if (!$oDisposicion->TraerDatosDisposicion($filaDicActExt['dis_codigo'],$fila_disposicion,$es_modif)) {
					$txt_sys_mail="Error buscando los datos de la disposición.\ndis_codigo=".$filaDicActExt['dis_codigo'];
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al mostrar detalles de la disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					return false;		
			} elseif ($es_modif) 
					$filaDis=array('dis_codigo'=>$fila_disposicion['dis_codigo'],'dis_numero'=>$fila_disposicion['dis_numero'],
								   'dis_fecha'=> FuncionesPHPLocal::ConvertirFecha($fila_disposicion["dis_fecha"],'aaaa-mm-dd','dd/mm/aaaa'));
		} 
	
		$filaDic=array( 'dic_codigo'=>$filaDicActExt['dic_codigo'], 'dic_observaciones'=>$filaDicActExt['dic_observaciones'],
						'actprog_fecha_inicio'=> FuncionesPHPLocal::ConvertirFecha($filaDicActExt["actprog_fecha_inicio"],'aaaa-mm-dd','dd/mm/aaaa'),
						'actprog_fecha_fin'=> FuncionesPHPLocal::ConvertirFecha($filaDicActExt["actprog_fecha_fin"],'aaaa-mm-dd','dd/mm/aaaa'),
						'dic_estado'=>$filaDicActExt['dic_estado']
						);						

		$nombre_institucion="";
		$oActividadExterna = new cActividadExterna($this->conexion);
		if (!$oActividadExterna->TraerDatosActividadExterna($filaDicActExt ['act_codigo'],$fila_act_externa,$es_modif))
			return false;
	
		$oActividadExterna->ObtenerOrganismoInstitucion($fila_act_externa['actividad_externa']['orgapri_codigo'],
														$fila_act_externa['actividad_externa']['jurisdid_apn'],
														$fila_act_externa['actividad_externa']['orgapub_codigo'],				
														$nombre_institucion,$sector_org,$tipoorg_codigo,$campo_institucion);

		$norma="";
		$this->conexion->TraerCampo("tipo_actividad","tipoact_norma_legal",array("tipoact_codigo='",$filaDicActExt['tipoact_codigo'],"'"),$norma,$numfilas,$errorcod); 
		$filaActExt=array('act_creditos'=>$filaDicActExt['actext_creditos'],'tipoact_codigo'=>$filaDicActExt['tipoact_codigo'],
						 'tipoact_norma_legal'=>$norma,'insti_orga'=>$nombre_institucion);

		$jurisdexp="";	
		$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filaDicActExt['jurisdid_exp'],"'"),$jurisdexp,$numfilas,$errorcod);
		$filaExp=array('exp_codigo'=> $filaDicActExt['exp_codigo'],'exp_numero'=>$filaDicActExt['exp_numero'],
					   'jurisdid_exp'=>$jurisdexp);				
	
		$filaAct=array('act_codigo'=>$filaDicActExt['act_codigo'],'act_nombre'=>$filaDicActExt['act_nombre'],'act_codinap'=>$filaDicActExt['act_codinap']);
	
		$array_DictamenesActExt[]=array( 'datos_actividad'=>$filaAct,
										'datos_actividad_tipo'=>$filaActExt,
										'datos_dictamen'=>$filaDic, 
										'datos_expediente'=>$filaExp,
										'datos_disposicion'=>$filaDis);
	} 

	mysqli_data_seek($resultDicActExt, 0);
	return true;
}
//-----------------------------------------------------------------------------------------------------	
function AgregarDetalleDictameActAutodesarrollo($resultDicActAuto,&$array_DictamenesActAuto) {

	$oDisposicion = new cDisposicion($this->conexion);
	while ($filaDicActAuto=mysqli_fetch_assoc($resultDicActAuto)) {

		$filaDis=array('dis_codigo'=>NULL,'dis_numero'=>NULL,'dis_fecha'=>NULL);
		if( isset($filaDicActAuto['dis_codigo'])) {
			if (!$oDisposicion->TraerDatosDisposicion($filaDicActAuto['dis_codigo'],$fila_disposicion,$es_modif)) {
					$txt_sys_mail="Error buscando los datos de la disposición.\ndis_codigo=".$filaDicActAuto['dis_codigo'];
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al mostrar detalles de la disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
					return false;		
			} elseif ($es_modif) 
					$filaDis=array('dis_codigo'=>$fila_disposicion['dis_codigo'],'dis_numero'=>$fila_disposicion['dis_numero'],
								   'dis_fecha'=> FuncionesPHPLocal::ConvertirFecha($fila_disposicion["dis_fecha"],'aaaa-mm-dd','dd/mm/aaaa'));
		} 


		$destinatario="";
		$ponderador_detalle="";
		$oPonderadorDictamen= new cPonderadorDictamen($this->conexion);		

		$oPonderadorDictamen->ObtenerPonderadorDescripcion(TIPOPONDCALPRESTADOR,$nombre_ponderador);
	    $oPonderadorDictamen->ObtenerValorPonderador($filaDicActAuto['pondtipopond_codigo_cal_pres'],$fila_tabla_pond);
		$ponderador_detalle .= $nombre_ponderador.": ".$fila_tabla_pond['pondtipopond_descripcion'];

		$oPonderadorDictamen->ObtenerPonderadorDescripcion(TIPOPONDINTENSIDAD,$nombre_ponderador);
	    $oPonderadorDictamen->ObtenerValorPonderador($filaDicActAuto['pondtipopond_codigo_int'],$fila_tabla_pond);
		$ponderador_detalle .= "<br>".$nombre_ponderador.": ".$fila_tabla_pond['pondtipopond_descripcion'];

		$oPonderadorDictamen->ObtenerPonderadorDescripcion(TIPOPONDCALPROCESO,$nombre_ponderador);
	    $oPonderadorDictamen->ObtenerValorPonderador($filaDicActAuto['pondtipopond_codigo_proc_eva'],$fila_tabla_pond);
		$ponderador_detalle .= "<br>".$nombre_ponderador.": ".$fila_tabla_pond['pondtipopond_descripcion'];
		
		
		$filaDic=array(	'dic_codigo'=>$filaDicActAuto['dic_codigo'],
						'dic_estado'=>$filaDicActAuto['dic_estado'],
						'dictamen'=>$ponderador_detalle);						
		if($filaDicActAuto['tipoact_codigo']==TIPOACTAUTOEVASIS) {
			$filaDic+=array('actprog_fecha_inicio'=> FuncionesPHPLocal::ConvertirFecha($filaDicActAuto["actprog_fecha_inicio"],'aaaa-mm-dd','dd/mm/aaaa'),
							'actprog_fecha_fin'=> FuncionesPHPLocal::ConvertirFecha($filaDicActAuto["actprog_fecha_fin"],'aaaa-mm-dd','dd/mm/aaaa'));
		} else {
			$oPersonas = new cPersonas($this->conexion);
			$oPersonas->TraerDatosPersona_xCod($filaDicActAuto["pers_codigo"],$datos_personales,$es_modif);
			$destinatario=htmlspecialchars($datos_personales['pers_apellido'],ENT_QUOTES).", ".htmlspecialchars($datos_personales['pers_nombre'],ENT_QUOTES)." (".htmlspecialchars($datos_personales['pers_cuilt'],ENT_QUOTES).")";
			$filaDic+=array('destinatario'=>$destinatario);
		}

		$nombre_institucion="";
		$oActividadAutodesarrollo = new cActividadAutodesarrollo($this->conexion);
		if (!$oActividadAutodesarrollo->TraerDatosActividadAutodesarrollo($filaDicActAuto['act_codigo'],$filaDicActAuto['tipoact_codigo'],$fila_act_autodesarrollo,$es_modif))
			return false;

		$norma="";
		$this->conexion->TraerCampo("tipo_actividad","tipoact_norma_legal",array("tipoact_codigo='",$filaDicActAuto['tipoact_codigo'],"'"),$norma,$numfilas,$errorcod); 
		$filaActAuto=array('tipoact_codigo'=>$filaDicActAuto['tipoact_codigo'],'tipoact_norma_legal'=>$norma,'act_creditos'=>$filaDicActAuto['actauto_creditos'],);

		$jurisdexp="";	
		$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$filaDicActAuto['jurisdid_exp'],"'"),$jurisdexp,$numfilas,$errorcod);
		$filaExp=array('exp_codigo'=>$filaDicActAuto['exp_codigo'],'exp_numero'=>$filaDicActAuto['exp_numero'],
					   'jurisdid_exp'=>$jurisdexp);				

		$filaAct=array('act_codigo'=>$filaDicActAuto['act_codigo'],'act_nombre'=>$filaDicActAuto['act_nombre'],'act_codinap'=>$filaDicActAuto['act_codinap']);

		$array_DictamenesActAuto[]=array('datos_actividad'=>$filaAct,
										'datos_actividad_tipo'=>$filaActAuto,
										'datos_dictamen'=>$filaDic, 
										'datos_expediente'=>$filaExp,
										'datos_disposicion'=>$filaDis);
	}
	
	mysqli_data_seek($resultDicActAuto, 0);
	return true;
}
//-----------------------------------------------------------------------------------------------------	
	function ObtenerDictamenesxFormato($filtroDatos,&$resultDicActCurso, &$numfilas_DicActCurso,
													&$resultDicActExt,&$numfilas_DicActExt, 
													&$resultDicActAuto,&$numfilas_DicActAuto) {

	$numfilas_DicActCurso=0;
	$numfilas_DicActExt=0;
	$numfilas_DicActAuto=0;

	$ArregloDatos=array();
														
	// Armo la lista separada por comas de dictámenes a listar en caso que me venga 
	$str_in_dic_codigo="";
	if (isset($filtroDatos['dictamen_en'])) {
		$str_in_dic_codigo=str_replace("_",",",$filtroDatos['dictamen_en']);

		$ArregloDatos['dic_codigo']  = 	$str_in_dic_codigo;

		if (strlen($str_in_dic_codigo)==0) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se seleccionaron dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	}
	
	if (isset($filtroDatos['dis_codigo'])) 
		$ArregloDatos['dis_codigo'] = $filtroDatos['dis_codigo'];
	
	$ArregloDatos['orderby'] = "exp_numero,act_nombre";		

	if (!isset($filtroDatos['xrol']) || $filtroDatos['xrol'])  { // Que teneg en cuenta el rol de usuario logueado
	
		switch ($_SESSION['rolcod']) {
		case SUPERUSUARIO:
			$oActividad= new cActividadCurso($this->conexion);
			$tipoact_codigo=TIPOACTCURSOINAP.",".TIPOACTCURSOJURISD.",".TIPOACTCURSOINST;
			$formact_codigo=FORMATOCURSO;
			
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;	
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActCurso,$resultDicActCurso,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			break;	
		case USUCURSOINAP:
			$oActividad= new cActividadCurso($this->conexion);
			$tipoact_codigo=TIPOACTCURSOINAP;
			$formact_codigo=FORMATOCURSO;		
	
			// Obtengo los dictamenes
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;			
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActCurso,$resultDicActCurso,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			break;
	
		case USUACTINS:
			$oActividad = new cActividadCurso($this->conexion);
			$tipoact_codigo=TIPOACTCURSOINST;		
			$formact_codigo=FORMATOCURSO;
	
			// Obtengo los dictamenes
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;			
			
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActCurso,$resultDicActCurso,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			break;
		
		case USUACTJUR:
			$oActividad= new cActividadCurso($this->conexion);
			$tipoact_codigo=TIPOACTCURSOJURISD;
			$formact_codigo=FORMATOCURSO;
	
			// Obtengo los dictamenes
			$ArregloDatos['jurisdid_inap'] = $_SESSION['jurisdid_inap'];
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;			
			
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActCurso,$resultDicActCurso,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			break;
		
		case USUACTEXT:
			$oActividad= new cActividadExterna($this->conexion);
			$formact_codigo=FORMATOEXT;
			$tipoact_codigo=TIPOACTEXTASIS;	
	
			// Obtengo los dictamenes de Actividades Externas
			$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;			
			
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActExt,$resultDicActExt,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
	
			break;	
	
	   case USUAUTODESARROLLO:
			$formact_codigo=FORMATOAUTO;
			$oActividad= new cActividadAutodesarrollo($this->conexion);
			// Obtengo los Dictamenes de Actividades Autodesarrollo
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActAuto,$resultDicActAuto,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			break;
	
		case USUCONSULTA:
			$oActividad= new cActividadCurso($this->conexion);
			// Obtengo los dictamenes Curso		
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActCurso,$resultDicActCurso,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
	
			$oActividad= new cActividadExterna($this->conexion);
			// Obtengo los Dictamenes de Actividades Externas
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActExt,$resultDicActExt,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
			$oActividad= new cActividadAutodesarrollo($this->conexion);
			// Obtengo los Dictamenes de Actividades Autodesarrollo
			if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActAuto,$resultDicActAuto,$error,$errormail)) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			break;
		
		default: 
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error la operación no se encuentra definida para el rol.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	} else { // Que no tenega en cuenta el rol de usuario

		$oActividad= new cActividadCurso($this->conexion);
		// Obtengo los dictamenes Curso		
		if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActCurso,$resultDicActCurso,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		$oActividad= new cActividadExterna($this->conexion);
		// Obtengo los Dictamenes de Actividades Externas
		if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActExt,$resultDicActExt,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		$oActividad= new cActividadAutodesarrollo($this->conexion);
		// Obtengo los Dictamenes de Actividades Autodesarrollo
		if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas_DicActAuto,$resultDicActAuto,$error,$errormail)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al seleccionar dictámenes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
	}		
	return true;
}
