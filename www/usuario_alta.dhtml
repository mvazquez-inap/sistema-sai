<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
//----------------------------------------------------------------------------------------- 	
// Inicio de pantalla
?>
<script type="text/javascript" language="javascript">
function Validar(formulario)
{

	if(formulario.usuariocuit.value=="" || !ValidarContenido(formulario.usuariocuit.value,"CUIT"))
	{
		alert("El CUIT/CUIL/CDI no es válido");
		formulario.usuariocuit.focus();
		return false;	
	}
	if (!ValidarContenido(formulario.usuarioapellido.value,"AlfabeticoPuro") || (trim(formulario.usuarioapellido.value)==""))
	{
		alert("El apellido es inválido");
		formulario.usuarioapellido.focus();
		return false;	
	}
	if (!ValidarContenido(formulario.usuarionombre.value,"AlfabeticoPuro") || (trim(formulario.usuarionombre.value)==""))
	{
		alert("El nombre es inválido");
		formulario.usuarionombre.focus();
		return false;	
	}
	if(formulario.usuarioemail.value=="" || !ValidarContenido(formulario.usuarioemail.value,"Email"))
	{
		alert("Debe ingresar el eMail y debe tener un formato válido");
		formulario.usuarioemail.focus();
		return false;	
	}
	
	return true;
}

// No se usa un reset porque se llama desde el volver
function Limpiar(formulario) {
	formulario.usuariocuit.value="";
	formulario.usuarionombre.value="";
	formulario.usuarioapellido.value="";
	formulario.usuarioemail.value="";
}
</script>
<BR>
<form action="usuario_alta_upd.dhtml" method="post" name="formulario">
<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td valign="top" width="25%" class='textoEtiquetaClave'>CUIT/CUIL/CDI</td>
		<td class="textoEtiquetaDatoResaltado"><input type="text" name="usuariocuit" id="usuariocuit" size="11" maxlength="11" class='textoInput' value="<?php if (isset($_GET["usuariocuit"])) echo htmlspecialchars($_GET["usuariocuit"],ENT_QUOTES); ?>"></td>
	</tr>
	<tr>
		<td valign="top" class="textoEtiqueta">Apellido</td>
		<td class="textoEtiquetaDatoResaltado"><input type="text" name="usuarioapellido" id="usuarioapellido" onblur="PasarAMayusculas('usuarioapellido')" size="32" maxlength="30" class='textoInput' value="<?php if (isset($_GET["usuarioapellido"])) echo htmlspecialchars($_GET["usuarioapellido"],ENT_QUOTES); ?>"></td>
	</tr>
	<tr>
		<td valign="top"  width="25%" class="textoEtiqueta">Nombre</td>		
		<td class="textoEtiquetaDatoResaltado"><input type="text" name="usuarionombre"  id="usuarionombre" size="32" maxlength="30" onblur="PasarAMayusculas('usuarionombre')" class='textoInput' value="<?php if (isset($_GET["usuarionombre"])) echo htmlspecialchars($_GET["usuarionombre"],ENT_QUOTES); ?>"></td>
	</tr>
	<tr>
		<td valign="top" class="textoEtiqueta">Email</td>
		<td class="textoEtiquetaDatoResaltado"><input type="text" name="usuarioemail" size="32"  maxlength="100" class='textoInput' value="<?php if (isset($_GET["usuarioemail"])) echo htmlspecialchars($_GET["usuarioemail"],ENT_QUOTES); ?>"></td>
	</tr> 	
	<tr align="center">
	  	<td colspan="2" valign="top">
			<input type="submit" name="boton_alta" class="botones" value="Confirma Alta" onClick="return Validar(formulario);">&nbsp;&nbsp;&nbsp;&nbsp;
			<input type="button" name="limpiar" class="botones" value="Limpiar"  onClick="Limpiar(formulario);">
	  	</td>
    </tr>	
</table>
</form>
