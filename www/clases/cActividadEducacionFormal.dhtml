//-----------------------------------------------------------------------------------------------------

	function ListarDisenoActividadPDF($act_codigo) {

		function GenerarActividadDiseno(&$pdf,$fila_eformal) {
			$pdf->AddAcividadDiseno();
			$pdf->Set('datos_actividad',$fila_eformal);
			$pdf->Set('formact_codigo',FORMATOEFORMAL);
			$pdf->Set('tipoact_codigo',$fila_eformal['actividad_eformal']['tipoact_codigo']);
		} 

		if (!$this->TraerDatosActividadEducacionFormal($act_codigo,$fila_eformal,$es_modif))  {
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} elseif (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		$descri="";
		if ($this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTFORMALESTADO","' and constantecod='",$fila_eformal['actividad_eformal']['actform_estado'],"'"),$descri,$numfilas,$errorcod))
			$fila_eformal['actividad_eformal'] += array('actform_estado_desc'=>$descri);

		$descri="";
		$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_eformal['actividad_eformal']['tipoact_codigo'],"'"),$descri,$numfilas,$errno);
			$fila_eformal['actividad_eformal'] += array('actform_tipoact_desc'=>$descri);
		
		$pdf = new cActividadDisenoPDF();
		GenerarActividadDiseno($pdf,$fila_eformal);
		$pdf->MostrarActividadDiseno($this->conexion);
		$pdf->Output("disenoActividad.pdf","I");

		return true;
	}

//-----------------------------------------------------------------------------------------------------
function ListarDisenoActividad($act_codigo) {

    $ok=true;

    if (!$this->TraerDatosActividadEducacionFormal($act_codigo,$fila_eformal,$es_modif))  {
        $txt_sys_mail="\nact_codigo=".$act_codigo;
        FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
        $ok=false;
    } elseif (!$es_modif) {
        FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
        $ok=false;
    }

    if (!$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTFORMALESTADO","' and constantecod='",$fila_eformal['actividad_eformal']['actform_estado'],"'"),$descri_estado,$numfilas,$errorcod)){
        FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el estado de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
        $ok=false;
    }

   if (!$this->conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_eformal['actividad_eformal']['tipoact_codigo'],"'"),$descri_tipo,$numfilas,$errorcod)){
        FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar el estado de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
        $ok=false;
    }

?>
    <br><div class="textoTitulo" align="left">Detalle de la Actividad de Educación Formal<?php echo ($fila_eformal['actividad_eformal']['actform_estado'] != ACTFORMALACTIVO)?"(Estado ".$descri_estado.")":""?></div><br>
<?php
    if ($ok) {    ?>
        <table width="100%" class="textoTablaDatoBorde" align="center" border="1" cellpadding="4" cellspacing="0">
            <tr>
                <td width="30%" class='textoTablaDato'>Nombre</td>
                <td class='textoEtiquetaDatoResaltado'><?= htmlspecialchars($fila_eformal['actividad']['act_nombre'],ENT_QUOTES); ?></td>
            </tr>
            <tr>
                <td class='textoTablaDato'>Código INAP</td>
                <td class='textoEtiquetaDatoResaltado'><?= htmlspecialchars($fila_eformal['actividad']['act_codinap'],ENT_QUOTES); ?></td>
            </tr>
            
            
            <tr>
                <td class='textoTablaDato'>Tipo de Actividad</td>
                <td class='textoEtiquetaDatoResaltado'><?= htmlspecialchars($descri_tipo,ENT_QUOTES); ?></td>
            </tr>
            <tr>
                <td class='textoTablaDato'>Observación</td>
                <td class='textoEtiquetaDatoResaltado'><?= htmlspecialchars($fila_eformal['actividad']['act_obs'],ENT_QUOTES)."&nbsp;"; ?></td>
            </tr>
            
            
            
        </table>
        <br />
<?php        }    // ok
    return $ok;
}

