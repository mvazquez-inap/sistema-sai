//-----------------------------------------------------------------------------------------------------	
 	function MostrarDetalleExpediente($exp_codigo) {

 	if (!$this->TraerDatosExpediente($exp_codigo,$fila_expediente,$es_modif)) {
		$txt_sys_mail="Error buscando los datos del expediente. \nexp_codigo=".$exp_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al mostrar detalles del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$txt_sys_mail);
		return false;		
	}
	
	if (!$es_modif) {
		$txt_sys_mail="\nexp_codigo=".$exp_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No se ha encontrado el expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$txt_sys_mail);
		return false;		
	}

	// Expediente Nro, Organismo, Fechas 
	
		// Obtengo los detalles de los cursos asosciados al expediente (actividad_curso + actividad_programacion + expediente )
		//  Actividad - Tipo de Curso - Prestador(*) - Créditos - Estado del Dictamen - Periodo del dictamen
			//	Prestador se define (*)
			//	Curso INAP			 - Inap 
			//  Curso JURISDICCIONAL - Organismo (es la del expediente)
			// 	Curso INSTITUCIONAL  - Organismo (Privado o Público)

	$oActividadCurso = new cActividadCurso($this->conexion);
	$ArregloDatos = array('exp_codigo'=>$exp_codigo,'orderby'=>'act_nombre,act_codigo,tipoact_codigo,actprog_fecha_inicio');
	if (!$oActividadCurso->BuscarActividadDictaminada($ArregloDatos,$numfilas,$resultActCursoExp,$error,$errormail)) {
		$txt_sys_mail="Error al mostrar detalles del expediente de actividad Curso \nexp_codigo=".$exp_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al mostrar detalles del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$txt_sys_mail);
		return false;		
	}
	$array_resultActCursoExp=array();
	while ($filaActCursoExp=mysqli_fetch_assoc($resultActCursoExp)) {
		$array_resultActCursoExp[]=$filaActCursoExp;			
	}
		
	// Obtengo los detalles de las actividades extenas asociados al expediente (Asistencia a actividad externa) 
	// (actividad_externa + actividad_programacion + expediente)

		//  Actividad - Prestador(*) - Créditos - Estado del Dictamen - Periodo del dictamen
			//	Prestador se define (*)
			//  Organismo  (Público o Privado)
			
	$oActividadExtExp = new cActividadExterna($this->conexion);
	$ArregloDatos = array('exp_codigo'=>$exp_codigo,'orderby'=>'act_nombre,act_codigo,tipoact_codigo,actprog_fecha_inicio');
	if (!$oActividadExtExp->BuscarActividadDictaminada($ArregloDatos,$numfilas,$resultActExtExp,$error,$errormail)) {
		$txt_sys_mail="Error al mostrar detalles del expediente de actividad Externa \nexp_codigo=".$exp_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al mostrar detalles del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$txt_sys_mail);
		return false;		
	}
	$array_resultActExtExp=array();
	while ($filaActExtExp=mysqli_fetch_assoc($resultActExtExp)) {
		$array_resultActExtExp[]=$filaActExtExp;			
	}

	// Obtengo los detalles de las actividades de autodesarrollo (actividad_autodesarrollo_dictamen + expediente )
	// Participación Eventos (actividad_autodesarrollo_evento)
			// Actividad 
				// Si Mero Asistente 
					// Créditos (actautoeven_creditos_asistencia) - Estado del Dictamen (actividad_autodesarrollo_evento) 				
				// Si Participante activo
					//  Persona (cuit + nombre + apellido)- Prestador(*) - Créditos - Estado del Dictamen (actividad_autodesarrollo_persona)
			
	// Otra actividad de autodesarrollo
		//  Actividad - Persona (cuit + nombre + apellido)- Prestador(*) - Créditos - Estado del Dictamen (actividad_autodesarrollo_persona)
	$array_resultActAutoExp=array();
	$oActividadAutoExp = new cActividadAutodesarrollo($this->conexion);
	$ArregloDatos = array('exp_codigo'=>$exp_codigo, 'orderby' => 'act_nombre,act_codigo,tipoact_codigo');
	if (!$oActividadAutoExp->BuscarActividadDictaminada($ArregloDatos,$numfilas,$resultActAutoExp,$error,$errormail)) {
		$txt_sys_mail="Error al mostrar detalles del expediente de actividad de Autodesarrollo\nexp_codigo=".$exp_codigo;
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al mostrar detalles del expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$txt_sys_mail);
		return false;		
	}
	$array_resultActAutoExp=array();
	while ($filaActAutoExp=mysqli_fetch_assoc($resultActAutoExp)) {
		$array_resultActAutoExp[]=$filaActAutoExp;			
	}
	
	if(count($array_resultActCursoExp)==0 && count($array_resultActExtExp)==0 && count($array_resultActAutoExp)==0) {
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El expediente no fue asociado a ningún dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
		return true;		
	}
