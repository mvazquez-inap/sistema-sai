<?php class cTablaOrganismoPrivado extends cTablaSysDesc {

	public function __construct($conexion) {

		$array_campos=array('clave'=> 'orgapri_codigo',
							'estado'=>'orgapri_estado',
							'descripcion'=>array('nombre_campo'=>'orgapri_nombre', 'long_campo'=>255 ,'titulo_campo'=>'Organismo'),
							'fecha_alta'=>'orgapri_falta',
							'fecha_baja'=>'orgapri_fbaja');

		parent::__construct($conexion,"organismo_privado",$array_campos);
		$this->SetearTituloTabla('Organismo Privado');
	
		// Array con los cógigos de operaciones a ser registradas
		$array_log=array('ins'=>'35601', 'upd'=>'35603', 'del'=>'35602','chg_estado'=>'35604');
		$this->SetearLogs($array_log);
	
		// Array con las tablas en las que se busca para determinar si la baja es física o lógica.
		$array_tablas=array();
		$array_tablas[]=array('nom_tabla'=>'actividad_autodesarrollo_evento','campo_tabla'=>'orgapri_codigo');
		$array_tablas[]=array('nom_tabla'=>'actividad_curso_diseno_institucional','campo_tabla'=>'orgapri_codigo');
		$array_tablas[]=array('nom_tabla'=>'actividad_externa','campo_tabla'=>'orgapri_codigo');
		$this->SetearTablasTipoBaja($array_tablas);
	}		
} ?>