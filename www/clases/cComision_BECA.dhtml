			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al cerfificar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}
		
		return true;
	}		
//-----------------------------------------------------------------------------------------	
	function BuscarComision($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxact_codigo'=>0);
		$sparam+=array('pxcomi_codigo'=>0);
		$sparam+=array('pxcomi_estado'=>0);
		$sparam+=array('pxcomi_codinap'=>0);
		$sparam+=array('pxcomi_codinap_exacto'=>0);
				
		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('pcomi_codigo'=>"");
		$sparam+=array('pcomi_estado'=>"-1");
		$sparam+=array('pcomi_codinap'=>"");
		$sparam+=array('pcomi_codinap_exacto'=>"");
		
		$sparam+=array('porderby'=>"act_codigo");
			
		if (isset ($ArregloDatos['act_codigo'])) {
			if ($ArregloDatos['act_codigo']!="") {	
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}	

		if (isset ($ArregloDatos['comi_codigo'])) {
			if ($ArregloDatos['comi_codigo']!="") {	
				$sparam['pcomi_codigo']= $ArregloDatos['comi_codigo'];
				$sparam['pxcomi_codigo']= 1;
			}
		}	

		if (isset ($ArregloDatos['comi_estado'])) {
			if ($ArregloDatos['comi_estado']!="") 	{	
				$sparam['pcomi_estado']= $ArregloDatos['comi_estado'];
				$sparam['pxcomi_estado']= 1;
			}
		}	

		if (isset ($ArregloDatos['comi_codinap'])) 	{
			if ($ArregloDatos['comi_codinap']!="")	{	
				$sparam['pcomi_codinap']= $ArregloDatos['comi_codinap'];
				$sparam['pxcomi_codinap']= 1;
			}
		}	

		if (isset ($ArregloDatos['comi_codinap_exacto'])) {
			if ($ArregloDatos['comi_codinap_exacto']!="") {	
				$sparam['pcomi_codinap_exacto']= $ArregloDatos['comi_codinap_exacto'];
				$sparam['pxcomi_codinap_exacto']= 1;
			}
		}	
		
		if (isset ($ArregloDatos['orderby'])) {
			if ($ArregloDatos['orderby']!="") 	{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_comision_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar comisión.";
			$errormail="Error al buscar en comision.".$errno;
			return false;
		}
		return true;
	}
