{
	$error="Error al buscar los estados de prestadores docentes.";
	$errormail="Error al buscar prestadores docentes. ".$errno;
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
	return false;
}
if($numfilas>0)
{
	$i=1;
	while ($fila=mysqli_fetch_assoc($resultado))	
	{
?>		<div align="left" class="colorfondoidentado10">
		<table width="95%" class="textotabla" border="0" cellpadding="2" cellspacing="2" align="center">
			<tr>
				<td class="negrita" width="100%" align="left" >		
				  <div style="margin-left:0px" align="left" class="colorfondoidentado10">
				  <span class='textoEtiquetaClave'>Estado: </span>
					<span class='textoEtiqueta'>
					<?php 	$conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","PRESDOCESTADO","' and constantecod='",$fila['presdoc_estado'],"'"),$caracterdesc,$numfilascaracter,$errorcod);
						echo $caracterdesc; ?>
					</span>
				  </div>
				</td>
			</tr>
			<tr>
				<td class="colortituloetapdesc">
					<div style="margin-left:10px" align="left" class="colorfondoidentado10">
					<?php MostrarGrillaSeleccion($conexion,$fila['presdoc_estado']); ?>
					</div>
				</td>
			</tr>
		</table>
		<br>
		<hr width="95%" align="center">	
		</div>
<?php		$i++;
	}
}
else
{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La búsqueda no retornó resultados.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;			
}
?>
