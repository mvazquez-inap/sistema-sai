function ListaTelefonos($idconexion,$filas_telefono,&$no_error,$titulo="") {
$no_error = true;
?>
<table border=0 cellpadding=0 cellspacing=0 style="width:100%" class="textoTablaDato">
<?php if ($titulo!="") { ?>
	<tr class="textoGrupoTitulo">
	<td colspan="6"><?php echo $titulo ?></td>
	</tr>	

<?php	} ?>

<?php if (count($filas_telefono)>0){ ?>
	<tr class="textoGrupoTituloChico">
	<td style="width:50px">Tipo</td>
	<td>DDI</td>	
	<td>DDN</td>
	<td>Número</td>
	<td>Interno</td>	
	<td style="width:150px">Horario</td>
	</tr>	
<?php	} ?>

<?php for($i=0;$i<count($filas_telefono);$i++) { ?>
	<tr style="height:20px" class="textoTablaDato">
	  <td style="width:50px">
		  <?php echo htmlspecialchars(TraerCampo($idconexion,"telefono_tipo","telt_descripcion",array("telt_codigo='",$filas_telefono[$i]['telt_codigo'],"'")),ENT_QUOTES);?>
	  </td>	  
	  <td>
		<?php	echo htmlspecialchars($filas_telefono[$i]['tele_ddi'],ENT_QUOTES); ?>
	  </td>
	  <td>
		<?php	echo htmlspecialchars($filas_telefono[$i]['tele_ddn'],ENT_QUOTES); ?>		
	  </td>	
	  <td >
   	   <?php 	echo htmlspecialchars($filas_telefono[$i]['tele_numero'],ENT_QUOTES); ?>
	  </td>	  
	  <td>
	  <?php echo htmlspecialchars($filas_telefono[$i]['tele_interno'],ENT_QUOTES); ?>
	  </td>
	  <td  style="width:150px">
		  <?php echo htmlspecialchars($filas_telefono[$i]['tele_horario'],ENT_QUOTES); ?>
	  </td>
	</tr>
<?php 	} // fin telefono ?>

</table> <?php
}  // fin -- funcion Telefonos Lista
//------------------------------------------------------------------------------------------------
function ListarDatosPrivados($idconexion,$opciones_mostrar,$fila_cargo,$fila_datos_privados,$fila_dir_postal,$fila_dir_legal,$filas_telefonos) {

	$no_error=true;
	$array_opciones_mostrar=explode(",",$opciones_mostrar); 
?>
  <table style="width:100%" align="center"  border=0 cellpadding=0 cellspacing=0 class="textoTablaDato"> 
<?php	 if (in_array('dp_personal',$array_opciones_mostrar) && count($fila_dir_postal)!=0) {?>
		  <tr> 
			<td> 
			<?php ListarDireccionPostal($idconexion,"Dirección Personal",$fila_dir_postal,$no_error); ?> 
			</td> 
		  </tr> 
	<?php  } ?>
	<?php	if (in_array('dp_legal',$array_opciones_mostrar) && count($fila_dir_legal)!=0) {?>
		  <tr> 
			<td> <?php 
			ListarDireccionPostal($idconexion,"Dirección Legal",$fila_dir_legal,$no_error); ?> 
			</td> 
		  </tr> 
	<?php } ?>
	<?php if (in_array('telefonos',$array_opciones_mostrar) && count($filas_telefonos)!=0) {?>
		  <tr>  
			<td> 
			<?php ListaTelefonos($idconexion,$filas_telefonos,$no_error,"Teléfonos");	?> 
			</td> 
		  </tr> 
	<?php } ?>
	<?php if (in_array('dir_electronicas',$array_opciones_mostrar) && count($fila_datos_privados)!=0) {?> 
		  <tr>  
			<td> 
			<?php LitarDireccionElectronicaDP($idconexion,"Direcciones Electrónicas",$fila_datos_privados,$no_error); ?> 
			</td> 
		  </tr> 
	<?php } ?>	  	
</table> 
<?php 
} 
//-----------------------------------------------------------------------------
function ListarDireccionPostal($idconexion,$titulo,$fila_dir_postal,$no_error) {
$no_error=true;
?>
  <table border=0 cellpadding=0 cellspacing=7 style="width:100%" class="textoTablaDato">

	<tr class="textoGrupoTitulo">
	  <td colspan="3"> <?php echo $titulo; ?>
	  </td>
	</tr>

	<tr>
	  <td nowrap class="textoEtiqueta">Domicilio: </td>
	  <td colspan="2" class="textoEtiquetaDato">
		<?php echo htmlspecialchars($fila_dir_postal["dirp_domicilio"] ,ENT_QUOTES); ?>
	  </td>
	</tr>	

	<tr>
		<td nowrap class="textoEtiqueta">País:</td>
		<td class="textoEtiquetaDato"><?php echo htmlspecialchars(TraerCampo($idconexion,"pais","pais_nombre",array("pais_codigo='",$fila_dir_postal['pais_codigo'],"'")),ENT_QUOTES); ?>	</td>
		<td>
			  <table border=0 cellpadding=0 cellspacing=0 width="100%" class="textoTablaDato">
					<tr>
					  <td nowrap class="textoEtiqueta">Código Postal:</td>
					  <td class="textoEtiquetaDato">
						<?php  echo htmlspecialchars($fila_dir_postal['dirp_CP'],ENT_QUOTES); ?>
					  </td>
					</tr>
			  </table>
		</td>
	</tr>

<?php	if ($fila_dir_postal['pais_codigo']==ARGENTINA ) { ?>
	<tr>
		<td nowrap class="textoEtiqueta">Provincia:</td>
		<td class="textoEtiquetaDato" colspan="2">
			<?php	echo htmlspecialchars(TraerCampo($idconexion,"provincia","denominacion",array("cod_provincia='",$fila_dir_postal['cod_provincia'],"'")),ENT_QUOTES); ?>
		</td>
	</tr>

	<tr>
	  <td nowrap class="textoEtiqueta">Localidad:</td>
	  <td class="textoEtiquetaDato" colspan="2">
			<?php echo htmlspecialchars(TraerCampo($idconexion,"localidad","denominacion",array("cod_localidad='",$fila_dir_postal['cod_localidad'],"'")),ENT_QUOTES); ?>
	  </td>		  
	</tr>

<?php	} //  fila_dir_postal['pais_codigo']!=ARGENTINA ?>

<?php	if (!$fila_dir_postal['pais_codigo']==ARGENTINA) { ?>
	<tr <?php echo (($fila_dir_postal['pais_codigo']==ARGENTINA)?" disabled ":" "); ?>>
	  <td nowrap class="textoEtiqueta">Ciudad:</td>
	  <td class="textoEtiquetaDato" colspan="2">
		<?php	echo htmlspecialchars($fila_dir_postal['dirp_ciudad'],ENT_QUOTES); ?>
	  </td>
	</tr>		
<?php	} // !$fila_dir_postal['pais_codigo']==ARGENTINA ?>
</table>
<?php
}
