				<img id="img_<?php echo $idFila ?>_estado" name="img_<?php echo $idFila ?>_estado" src="images/boton_grupo_close.gif" style="width:15px" border=0 hspace="1"><br>
		<?php } ?>				
		</td> 
<?php }  // grupo fijo - no se abre y cierra ?>				
  </tr>
<?php }  // Fila_inicial_grupo

