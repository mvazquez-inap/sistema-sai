//----------------------------------------------------------------------------------------- 
function Comienzo_pagina($pagina,$tamano_pagina) {
	$inicio = ($pagina - 1) * $tamano_pagina; 
	return $inicio;
}
// ---------------------------------------------------------------------------------------------------------------- 
// Busca los organismos, por nombre del organismo ordenando el resultado cualquiera de los criterios posibles
// 		1) Se obtiene la cantidad de organismos que cumplen con el filtro seleccionado.
//		2) Se obtiene todos los organismos que cumplan con el filtro seleccionado.
//			Si el orden es por organismo se limitan y ordenan los registros de salida.
// 		    en otro caso no se limita ni ordena.
// ---------------------------------------------------------------------------------------------------------------- 
function ObtenerOrganismosxJurisd($idconexion,&$objJurisdicciones,$oper_campo,$valor_buscado,
								  $orden,$inicio,$resu_x_pag,$numero_pagina,&$cant_total,&$array_jurisd) {

	$array_func=array();

	// No debiera pero no tengo la funcionalidad para sacar la Raiz
	//    $arrayin=array_merge(array(' and '),InTipoOrgDepEjeNacional($objJurisdicciones));
	//    $arrayin=array_merge($arrayin,array(" and jurisdarboltiponodo != 'R'" ));

	//	InTipoOrgDepEjeNacional($objJurisdicciones);
	
	$arrayin=array(" and jurisdarboltiponodo != 'R'");

	// Saco la cantidad total de jurisdicciones que cumplen la condición sobre el nombre
	if (!$objJurisdicciones->SelectCantJurisdxCampo("jurisdnom",$oper_campo,$valor_buscado,array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'pjurisdwhere'=>$arrayin),$cant_total,$CodError)) 
		return false;

	if ($cant_total==0) 
		return true;
	
	// Saco los organismos segun el criterio 
	//	si el orden es por organismo se ordena y limita los registros a los posibles en una pagina
	//  en caso contrario no se ordena ni limita la salida.
	if (trim(strtolower($orden)) == 'jurisdnom asc' || trim(strtolower($orden)) == 'jurisdnom desc')
		$param_juris=array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'pjurisdwhere'=>$arrayin,'pjurisdorden'=>$orden,'pjurisdlimit'=>$inicio.",".$resu_x_pag);
	else
		$param_juris=array('pjurisdestado'=>TABGRALES_JURISDACTIVA,'pjurisdwhere'=>$arrayin);
	
	if (!$objJurisdicciones->SelectJurisdxCampo("jurisdnom",$oper_campo,$valor_buscado,$param_juris,TABGRALES_TS_ARRAY,$array_jurisd,array(),$NumFilas,$CodError))
		return false;

	
	if($CodError)
		return false;

	return true;
}
