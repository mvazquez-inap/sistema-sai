			return false;
		}
		$datosvalidados["pers_nombre"]=$datos["pers_nombre"];

		// if (!isset($datos['pers_sexo']) || ($datos['pers_sexo'] != SEXO_FEMENINO) && ($datos['pers_sexo'] != SEXO_MASCULINO)) {
// MV - SEXO - 17032023 
if ( (!isset($datos['pers_sexo'])) ||  (
    ($datos['pers_sexo'] != SEXO_FEMENINO) && 
    ($datos['pers_sexo'] != SEXO_MASCULINO) &&
    ($datos['pers_sexo'] != SEXO_MUJER_TRANS) &&
    ($datos['pers_sexo'] != SEXO_VARON_TRANS) &&
    ($datos['pers_sexo'] != SEXO_TRAVESTI) &&
    ($datos['pers_sexo'] != SEXO_TRANSEXUAL) &&
    ($datos['pers_sexo'] != SEXO_TRANSGENERO) &&
    ($datos['pers_sexo'] != SEXO_NO_BINARIE) &&
    ($datos['pers_sexo'] != SEXO_NINGUNA) &&
