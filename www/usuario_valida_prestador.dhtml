//----------------------------------------------------------------------------------------- 
function ValidarDatosLogin($conexion,&$datosvalidados) {

	$datosbien=true;
	
	if (!FuncionesPHPLocal::ValidarContenido($conexion,$_POST['usuariocuit'],"NumericoEntero"))
		$datosbien=false;
		
	if ($datosbien)
	{
		$clavemd5 = md5($_POST['usuarioclave']);
		
		$spnombreusuario='sel_prestador_docente_xpresdoc_password_presdoc_cuilt';
		$spparamusuario=array('ppresdoc_cuilt'=>$_POST['usuariocuit'],'ppresdoc_password'=>$clavemd5);
		if(!$conexion->ejecutarStoredProcedure($spnombreusuario,$spparamusuario,$queryusuario,$numfilas,$errno) || $numfilas!=1)
			$datosbien=false;
		
	}


	if(!$datosbien)
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,'013801',"usuariocuit=".$_POST['usuariocuit'],$_SESSION['usuariocod']);
		echo "<br><br><br><br>";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Usuario y/o Clave no válidos - '".htmlspecialchars($_POST['usuariocuit'],ENT_QUOTES)."'",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"",true,false);
		echo "<br><br>";
		return false;
	}
	else
	{
		
		$filausuario=mysqli_fetch_assoc($queryusuario);
		//asignacion de variables de session		
		$datosvalidados['usuariocod'] = $filausuario['presdoc_codigo'];

		$datosvalidados['resetpass']=false;
		switch ($filausuario['presdoc_estado'])
		{
			case USUARIONUEVO :
				$datosvalidados['resetpass']=true;
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Bienvenido al Sistema '".htmlspecialchars($filausuario['presdoc_apellido'].",".$filausuario['presdoc_nombre'],ENT_QUOTES)."'<br>Ud. Deber&aacute; modificar su Clave",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				break;
	
			case USUARIOACT :
				
				$datosvalidados["cantroles"]=1;
				
				break;			
				
			case USUARIOBAJA :
				echo "<br><br><br>";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"No tiene acceso al Sistema.<br>El usuario '".htmlspecialchars($filausuario['presdoc_apellido'].",".$filausuario['presdoc_nombre'],ENT_QUOTES)."' ha sido dado de baja",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				echo "<p>&nbsp;</p>";
				return false;
				
				break;
			default:
				echo "<br><br><br>";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Imposible acceder.  Estado del usuario indefinido:'".htmlspecialchars($filausuario['presdoc_apellido'].",".$filausuario['presdoc_nombre'],ENT_QUOTES)."' indefinido.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				
				return false;
		}
	}
	
	return true;
}
//----------------------------------------------------------------------------------------- 
function ValidarDatosCambiaPass($conexion,&$datosvalidados)
{
	$commit=true;
	$conexion->ManejoTransacciones("B");
	
	$clave_actual = md5($_POST['clave1']);
	$clave_nueva = md5($_POST['clave2']);
	$clave_confirma = md5($_POST['clave3']);

	$spnombre='sel_prestador_docente_xpresdoc_codigos';
	$spparam=array('presdoc_codigo'=>$_SESSION['presdoc_codigo']);
	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$queryusuario,$numfilas,$errno) || $numfilas!=1)
	{
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en acceso a prestador docente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$filausuario=mysqli_fetch_assoc($queryusuario);

	if($filausuario["usuariopassword"] !=$clave_actual || $clave_nueva!=$clave_confirma)
	{
		echo"<p>&nbsp;</p>";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Los datos ingresados son erróneos. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}

	if($commit && !FuncionesPHPLocal::ValidarPassword($_POST['clave2'],$_POST['clave1'],$filausuario["usuarioCUIT"],6))
	{
		echo"<p>&nbsp;</p>";
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"La nueva contraseña no es válida. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
	}
	$datosvalidados["clavenueva"]=$_POST['clave2'];
	$datosvalidados["usuariocuit"]=$filausuario["usuarioCUIT"];

	return true;
}
//----------------------------------------------------------------------------------------- 
$datosvalidados=array();
$accion="NADA";

if(isset($_POST["botoningresar"]))
{

	if(ValidarDatosLogin($conexion,$datosvalidados))
	{ 

		$_SESSION['usuariocod'] = $datosvalidados['usuariocod'];
		if($datosvalidados["resetpass"])
		{
			$accion="CAMBIARPASS";
			$usuariocuit=$_POST["usuariocuit"];
		}
		else
		{
			ob_end_clean();
			header("Location:prestador_docente_ingreso.dhtml");
			die();
		} 
	}
	else
	{ // error al validar los datos
		$_SESSION['usuariocod']=0;
		echo "<div align='center'><a href='index.dhtml' class='textoTablaDato linkFondoBlanco'>Volver al Inicio</a></div>";
		$accion="NADA";
	} 
} // fin botoningresar
elseif(isset($_POST["botoncambiapass"]))
{
	if(ValidarDatosCambiaPass($conexion,$datosvalidados))
	{
		$commit=true;
		$conexion->ManejoTransacciones("B");
		
		if($usuarios->CambiarPwd($_SESSION["usuariocod"],$_POST['clave1'],$_POST['clave2'],$_POST['clave3'])) 
		{		
			FuncionesPHPLocal::RegistrarAcceso($conexion,'023804',"usuariocod=".$_SESSION['usuariocod']." - usuariocuit=".$datosvalidados["usuariocuit"],$_SESSION['usuariocod']);	
			$conexion->ManejoTransacciones("C");
			echo"<p>&nbsp;</p>";
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se actualizó la nueva contraseña",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			echo"<p>&nbsp;</p>";
			echo"<div align='center'><a href='index.dhtml' class='linkFondoBlanco textoAclaraciones'>Deber&aacute; volver ingresar al sistema con la nueva contraseña</a></div>";
			$_SESSION['usuariocod']=0;
			$accion="NADA";
	
		} // si realizó el cambio
		else 
		{  // si se produjo un error en los datos
			$conexion->ManejoTransacciones("R");
			echo"<p>&nbsp;</p>";
			echo"<div align='center'><span class='linkFondoBlanco textoAclaraciones'>Ingrese nuevamente</span></div>";

			$accion="CAMBIARPASS";
		} // commit
	}
	else
	{ // error al validar los datos
		echo "<div align='center'><a href='index.dhtml' class='textoTablaDato linkFondoBlanco'>Volver al Inicio</a></div>";
		$_SESSION['usuariocod']=0;
		$accion="NADA";
	}
} // fin botoncambiapass	


switch ($accion)
{
	case "CAMBIARPASS":
