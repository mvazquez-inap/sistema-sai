<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

//----------------------------------------------------------------------------------------- 
function MostrarGrillaSeleccion($conexion,$ArregloDatos) {

	// array para pasar a la grilla
	$result_array = array();
	$valor_buscado = $ArregloDatos['exp_numero'];
	$ArregloDatos['orderby'] = "exp_numero";
		
		switch ($_SESSION['rolcod']) {

		  // Si el usuario es USUCURSOINAP, USUACTINS el organismo del expediente será Jefatura.
		  case USUCURSOINAP:
		  case USUACTINS:
  				$ArregloDatos['jurisdid_exp']=JURISDID_JEFATURA; 
		  		break;

		  // El usuario USUACTJUR, solamente podrá actualizar expedientes de los organismos que administra el enlace (el que esta logueado).
		  case USUACTJUR:
  				$ArregloDatos['jurisdid_exp']=$_SESSION['jurisdid_inap']; 
				break;

		  // El usuario USUAUTODESARROLLO, USUACTEXT puede actualizar expedientes de cualquier organismo.
		  case USUAUTODESARROLLO:
		  case USUACTEXT:
		  		break;
				
		}

		$oExpediente= new cExpediente($conexion);
		if ($valor_buscado!="") 
			$ArregloDatos['exp_numero']=$valor_buscado;		
			
		if (!$oExpediente->BuscarExpediente($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$txt_sys_mail="\nvalor_buscado_".$valor_buscado."\nerror=".$errormail;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;			
		}			
		
		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"NombrePaginaQuery"=>"pagina",
			"FilasPagina"=>10
		);
		
		if (isset($_GET['pagina']))	{
			$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
			$opciones['QueryString']=$querystring;
		}
		
		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla('Expedientes');	
		$oGrilla->SetearAnchoGrilla('90%');
		
		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'Expediente');
		$oGrilla->Setear('campo_grilla',$miColumna1,'exp_numero');
		$oGrilla->Setear('align_columna',$miColumna1,'left');

		$miColumna4 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna4,'Organismo');
		$oGrilla->Setear('campo_grilla',$miColumna4,'jurisdnom');
		$oGrilla->Setear('align_columna',$miColumna4,'left');

		$miColumna6 = $oGrilla->AddColumna('popup');
		$oGrilla->Setear('ancho_columna',$miColumna6,'60');
		$oGrilla->Setear('imagen',$miColumna6,'images/verdetalle.gif');
		$oGrilla->Setear('altImagen',$miColumna6,'Ver detalle expediente');		
		$oGrilla->Setear('titulo_columna',$miColumna6,'Detalle');
		$oGrilla->Setear('url',$miColumna6,'expediente_ver_detalle.dhtml');
		$oGrilla->Setear('ventanaAnchoPopup',$miColumna6,'680');
		$oGrilla->Setear('ventanaAltoPopup',$miColumna6,'500');
		$oGrilla->Setear('ventanaVarxPopup',$miColumna6,'120');
		$oGrilla->Setear('ventanaVaryPopup',$miColumna6,'50');
		$oGrilla->AddParametrosURL($miColumna6,"exp_codigo",'exp_codigo');

		$miColumna2 = $oGrilla->AddColumna('addValor');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Seleccionar');
		$oGrilla->Setear('imagen',$miColumna2,'images/seleccionar.jpg');
		$oGrilla->Setear('altImagen',$miColumna2,'Seleccionar');						
		$oGrilla->Setear('idtextboxAddValor',$miColumna2,$_SESSION['array_busqueda_basica_expediente']['idtextboxAddValor']);

		if (!$_SESSION['array_busqueda_basica_expediente']['submit']) {
			$oGrilla->Setear('submitAddValor',$miColumna2,'no');
			$oGrilla->Setear('documentAddValor',$miColumna2,'window.opener.document');
			$oGrilla->Setear('nombreContenidoAddValor',$miColumna2,'exp_numero');
			$oGrilla->Setear('idtextoContenidoAddValor',$miColumna2,'exp_numero');
		} else {
			$oGrilla->Setear('submitAddValor',$miColumna2,'si');
			$oGrilla->Setear('nombreFormularioSubmitAddValor',$miColumna2,$_SESSION['array_busqueda_basica_expediente']['formulario']);
		}

		$oGrilla->Setear('ancho_columna',$miColumna2,'60');
		$oGrilla->AddParametrosAddValor($miColumna2,'exp_codigo');


		if (!$oGrilla->CargarGrilla($result))
			return false;
			
		$oGrilla->MostrarGrilla();

		return true;		
}
?>


