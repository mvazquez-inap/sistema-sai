//----------------------------------------------------------------------------------------- 
// Retorna un array con los valores convertidos en pesos (en porcentaje)

	function PasarArrayPorcentaje($ValoresOriginales,&$ResuPeso)
	{
		$suma = array_sum($ValoresOriginales);
		$ResuPeso=$ValoresOriginales;
		array_walk($ResuPeso,array('self','PasarValorPorcentaje'),$suma);
		$diferencia = 100 - array_sum($ResuPeso);
		
		end($ResuPeso);
		$ResuPeso[key($ResuPeso)]+=$diferencia;
		
	}
//----------------------------------------------------------------------------------------- 
// Retorna el valor convertido en porcentaje del total
// $clave es la clave en el array origen, necesario para ser usada por la funcion array_walk

	function PasarValorPorcentaje(&$valor,$clave,$total)
	{
		$valor=round($valor*100/$total,2);
	}

