	function _DatosValidosModifDictamen($datos,&$datosvalidados) {
		$datosvalidados=array();
		if (!$this->TienePermisoModificarDictamen($datos['dic_codigo'])) {
			return false; 
		}
	
		if (!$this->_DatosValidosComunesDictamen($datos,$datosvalidados))
		   return false; 
		return true;	
	}
