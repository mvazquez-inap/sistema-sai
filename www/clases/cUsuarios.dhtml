	function PedirCuit($cuit,$formularioName,$inputName,$confirmName) { ?>
	
	<SCRIPT LANGUAGE="JavaScript" type="text/javascript">

	function ValidarIngresoCuit(<?php echo $formularioName ?>) 	{
		if(<?php echo $formularioName ?>.<?php echo $inputName ?>=="" || !ValidarContenido(<?php echo $formularioName ?>.<?php echo $inputName ?>.value,"CUIT"))	{
			alert("El CUIT/CUIL/CDI no es válido");
			<?php echo $formularioName ?>.<?php echo $inputName ?>.focus();
			return false;	
		}
		return true;
	}  

	</SCRIPT>
		<table width="100%" class="textoTablaDato" align="center">
