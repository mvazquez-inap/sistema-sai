			return false;
		} 
		
		if ($fila_dictamen['dic_estado'] == DICTAMENNUEVO || $fila_dictamen['dic_estado'] == DICTAMENRECHAZADO ) 
			return true;		
		else {
			$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","DICTAMENESTADO","' and constantecod='",$fila_dictamen['dic_estado'],"'"),$descri,$numfilas,$errorcod);
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado del Dictamen (".$descri."), no le permite eliminarlo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;		
		}

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para eliminar el Dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}	
	
