<?php 
$modulo_recarga= "poc_actividad.dhtml";
$result = true;
//--------------------------------------------------------------------------------------------------
// Se confirmo la operacion 
//--------------------------------------------------------------
	if ( isset($_POST['boton_confirma']) ) 	{

		$commit=true;
		$conexion->ManejoTransacciones("B");

		// Alta - Baja - Modificación
		if ($commit) 	{
			if (isset($_POST['boton_confirma'])) {
				if ($_POST['operacion']=="I") {
					if ($oPocActividad->AltaPocActividad($_POST)) 
					{
						$nuevocodigo=$conexion->UltimoCodigoInsertado();
						FuncionesPHPLocal::RegistrarAcceso($conexion,"37301","pocact_codigo=".$nuevocodigo,$_SESSION['usuariocod']);
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de Alta la Actividad ".$_POST['pocact_nombre_tentativo'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					} else {
						//$arraymensajepantalla="No se ha podido dar de alta la Actividad del Poc";
						//FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						$commit=false;
					}
				}			
				if ($_POST['operacion'] == "M") {
					if ($oPocActividad->ModifDatosPocActividad($_POST)) 
					{
						FuncionesPHPLocal::RegistrarAcceso($conexion,"37303","pocact_codigo=".$_POST['pocact_codigo'],$_SESSION['usuariocod']);
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han modificado los datos de la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					} else {
						//$arraymensajepantalla="No se ha podido modificar el Poc";
						//FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						$commit=false;
						}
					//}//fin: else
				}//fin: if ($_POST['operacion'] == "M")
				if ($_POST['operacion'] == "B") {
						if ($oPocActividad->EliminarDatosPocActividad($_POST)) 
						{			
							FuncionesPHPLocal::RegistrarAcceso($conexion,"37302","pocact_codigo=".$_POST['pocact_codigo'],$_SESSION['usuariocod']);
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de baja la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						} else {
							//$arraymensajepantalla="No se ha podido eliminar el Poc";
							//FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							$commit=false;
							}
				}
			 }//fin: if (isset($_POST['boton_actualizar']))			
			//}//fin: if ($commit) 
			
			if($commit)
				$conexion->ManejoTransacciones("C");
			else
				$conexion->ManejoTransacciones("R");
		}	// commit
	} // 	if (isset($_POST['boton_actualizar']) || (isset($_POST['boton_eliminar'])) 

	//------------------------------------------------------------
	// Inicio de pantalla
	//------------------------------------------------------------
	// Se define la acción

	if (!isset($_GET['operacion'])) {
		$leyenda_operacion = "Agregar";
		$boton_operacion = "Agregar";		
		$operacion = "I";
	} else {
		switch ($_GET['operacion']) {		
		case "M" :
				$leyenda_operacion = "Actualizar";		
				$boton_operacion = "Actualizar";		
				$operacion = "M";				
				break;
		case "B" :
				$leyenda_operacion = "Eliminar";		
				$boton_operacion = "Eliminar";		
				$operacion = "B";				
				break;
		default:
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error de operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result=false;
		}
	}
