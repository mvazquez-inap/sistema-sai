//----------------------------------------------------------------------------------------- 
// Retorna si el rol elegido es válido

// Parámetros de Entrada:
//		usuariocod
//		rolcod

// Retorna:
//		datosvalidados: retorna el rol asignado
//		la función retorna true o false si se pudo ejecutar con éxito o no
	
	
	function ValidarDatosElegirRol($usuariocod,$rolcod,$jurisdid,&$datosvalidados)
	{
		$roles=new cRoles($this->conexion);

		$roles->RolesDeUnUsuarioSP($usuariocod,$spnombre,$spparam);
		$arraybusq=array("rolcod"=>$rolcod,'jurisdid_inap'=>$jurisdid);

		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,$arraybusq,$query,$filaret,$numfilasmatcheo,$errno))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error BD en selección de roles. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		elseif($numfilasmatcheo!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error filas en selección de roles. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;			
		}
	  	$datosvalidados["jurisdid_inap"]=$filaret["jurisdid_inap"];
		$datosvalidados["rolcod"]=$filaret["rolcod"];

		return true;
	}
//----------------------------------------------------------------------------------------- 
// Retorna una consulta con todos los usuarios que cumplan con las condiciones

// Parámetros de Entrada:
//		datosbuscar: array asociativo con los filtros. 
//	Claves: usuarionombre, usuarioapellido, usuariocuit, usuarioemail,
//			usuariocod, usuarioestado, usuariopasword

// Retorna:
//		numfilas,resultado: cantidad de filas y query de resultado
//		la función retorna true o false si se pudo ejecutar con éxito o no

	function BuscarUsuarios ($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)
	{
		$sparam=array('pxcuit'=>0);
		$sparam+=array('pxcod'=>0);
		$sparam+=array('pxnombre'=>0);
		$sparam+=array('pxapellido'=>0);
		$sparam+=array('pxpassword'=>0);
		$sparam+=array('pxemail'=>0);
		$sparam+=array('pxestado'=>0);
		
		$sparam+=array('pusuariocuit' =>"");
		$sparam+=array('pusuariocod' =>"");
		$sparam+=array('pusuarionombre' =>"");
		$sparam+=array('pusuarioapellido' =>"");
		$sparam+=array('pusuariopassword' =>"");
		$sparam+=array('pusuarioemail' =>"");
		$sparam+=array('pusuarioestado' =>"-1");
		$sparam+=array('porderby' =>"usuarioapellido, usuarionombre");

		if (isset ($ArregloDatos['usuarioCUIT']))
		{
			if ($ArregloDatos['usuarioCUIT']!="")
			{	
				$sparam['pusuariocuit']= $ArregloDatos['usuarioCUIT'];
				$sparam['pxcuit']= 1;
			}
		}
		if (isset ($ArregloDatos['usuariocod']))
		{
			if ($ArregloDatos['usuariocod']!="")
			{	
				$sparam['pusuariocod']= $ArregloDatos['usuariocod'];
				$sparam['pxcod']= 1;
			}
		}	
		if (isset ($ArregloDatos['usuariopassword']))
		{
			if ($ArregloDatos['usuariopassword']!="")
			{	
				$sparam['pusuariopassword']= $ArregloDatos['usuariopassword'];
				$sparam['pxpassword']= 1;
			}
		}	
		if (isset ($ArregloDatos['usuarionombre']))
		{
			if ($ArregloDatos['usuarionombre']!="")
			{	
				$sparam['pusuarionombre']= $ArregloDatos['usuarionombre'];
				$sparam['pxnombre']= 1;
			}
		}
		if (isset ($ArregloDatos['usuarioapellido']))
		{
			if ($ArregloDatos['usuarioapellido']!="")
			{	
				$sparam['pusuarioapellido']= $ArregloDatos['usuarioapellido'];
				$sparam['pxapellido']= 1;
			}
		}
		if (isset ($ArregloDatos['usuarioemail']))
		{
			if ($ArregloDatos['usuarioemail']!="")
			{	
				$sparam['pusuarioemail']= $ArregloDatos['usuarioemail'];
				$sparam['pxemail']= 1;
			}
		}
		if (isset ($ArregloDatos['usuarioestado']))
		{
			if ($ArregloDatos['usuarioestado']!="")
			{	
				$sparam['pusuarioestado']= $ArregloDatos['usuarioestado'];
				$sparam['pxestado']= 1;
			}
		}

		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}


		$spnombre="sel_usuarios_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el Usuario.";
			$errormail="Error al buscar el Usuario ".$errno;
			return false;
		}

		return true;
	}

