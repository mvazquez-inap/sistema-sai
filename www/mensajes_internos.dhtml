<script type="text/javascript">
//------------------------------------------------------------------------------------------------
function Validar(formulario) {

	// Fecha de Inicio
	if (formulario.msg_fecha_inicio.value!="" && !ValidarFecha(formulario.msg_fecha_inicio.value))	{
		alert("La fecha de inicio no es válida");
		formulario.comi_fecha_inicio.focus();
		return false;
	}
	// Fecha de fin
	if (formulario.msg_fecha_fin.value!="" && !ValidarFecha(formulario.msg_fecha_fin.value)) {
		alert("La fecha de finalización no es válida");
		formulario.comi_fecha_fin.focus();
		return false;
	}

	// Si se seleccionan ambas, Fecha de Inicio >= Fecha de Fin 
	if (formulario.msg_fecha_inicio.value!="" && formulario.msg_fecha_fin.value!="") {
		var fechainicio=ConvertirFecha(formulario.msg_fecha_inicio.value,'dd/mm/aaaa','aaaammdd');
		var fechafin=ConvertirFecha(formulario.msg_fecha_fin.value,'dd/mm/aaaa','aaaammdd');
		if (fechainicio>fechafin) 	{
			alert("La fecha de finalización debe ser mayor o igual que la fecha de inicio");
			formulario.msg_fecha_inicio.focus();
			return false;
		}
	}
	
	return true;
}


function abrirMensaje(msg_codigo) {

		Popup('mensajes_internos_ver_detalle.dhtml?msg_codigo='+msg_codigo,'ventana_descripciones',650,450,130,50,'yes');
		var Celda=EncontrarObjeto('sobre_'+msg_codigo);
		Celda.innerHTML = '';

		var CeldaLupa=EncontrarObjeto('lupa_'+msg_codigo);
		CeldaLupa.innerHTML = '<a href="javascript:void(0)" onclick="abrirMensaje('+msg_codigo+');"><img src="images/verdetalle.gif" alt="Ver detalle" title="Ver detalle" border="0"><//a>';
		
		
		
		
}

//------------------------------------------------------------------------------------------------
</script>
<script type="text/javascript" src="calendar/calendar.js"></script>
<script type="text/javascript" src="calendar/calendar-setup.js"></script>
