//-----------------------------------------------------------------------------------------------
function MostrarGrillaSeleccion($conexion,$arregloBuscar) {

	$oActividadCurso= new cActividadCurso($conexion);
	$oActividadAutodesarrollo= new cActividadAutodesarrollo($conexion);
	$oActividadExterna= new cActividadExterna($conexion);	
	$oActividadEducacionFormal = new cActividadEducacionFormal($conexion);	

	if ($_SESSION['array_busqueda_actividad']['tipoact_codigo'] != "*")
		$ArregloDatos['tipoact_codigo']=$_SESSION['array_busqueda_actividad']['tipoact_codigo'];

	$ArregloDatos['act_nombre'] = $_SESSION['array_busqueda_actividad']['act_nombre'];			
	$ArregloDatos['act_codinap'] = $_SESSION['array_busqueda_actividad']['act_codinap'];			

	$ArregloDatos['orderby']='act_nombre';

	$result = true;
	$numfilas = 0;
	$arrayAct = array();
	
	if ($arregloBuscar['buscaCurso']) {
		if(!$oActividadCurso->BuscarActividadCurso($ArregloDatos,$numfilas,$resultActCurso,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result = false;			
		}
	
		if(!$result) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar actividades. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;											
		} else {
			while ($filaActCurso = mysqli_fetch_assoc($resultActCurso)) {
				$clave = array_search ($filaActCurso['act_codinap'],$arrayAct);
				if ($clave = array_search ($filaActCurso['act_codinap'],$arrayAct) == FALSE) 
						$arrayAct[] = array("act_codinap"=>$filaActCurso['act_codinap'],"act_nombre"=>$filaActCurso['act_nombre'],"act_codigo" => $filaActCurso['act_codigo'],"tipoact_codigo"=>$filaActCurso['tipoact_codigo'],"formact_codigo"=>FORMATOCURSO,"actcur_creditos"=>$filaActCurso['actcur_creditos'],"actauto_creditos"=>"---","actext_creditos"=>"---","actform_creditos"=>"---", "Curso"=>"si","Auto"=>"no","Ext"=>"no","Form"=>"no");
				else 
						$arrayAct[$clave]['Curso'] = 'si';
			}
		}
	}

	$act_codinap = array();
	foreach ($arrayAct as $llave => $fila) {
	   $act_codinap[$llave]  = $fila['act_codinap'];
	}

	if ($arregloBuscar['buscaAuto']) {
		if(!$oActividadAutodesarrollo->BuscarActividadAutodesarrollo($ArregloDatos,$numfilas,$resultActAuto,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result = false;			
		}
	
		if(!$result) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar actividades. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;											
		} else {
			while ($filaActAuto = mysqli_fetch_assoc($resultActAuto)) {

			if (in_array($filaActAuto['act_codinap'],$act_codinap)) {
				$clave = array_search ($filaActAuto['act_codinap'],$act_codinap);
				$arrayAct[$clave]['Auto'] = 'si';
		 	} else {		
				$actauto_creditos = "---";		
				switch ($filaActAuto['tipoact_codigo']) {
					case TIPOACTAUTOEVASIS : 
						if (!$oActividadAutodesarrollo->TraerDatosActividadAutodesarrolloEvento($filaActAuto['act_codigo'],$filaautodesarrollo,$es_modif)) {
							$ok=false;		
						}	
						$actauto_creditos = $filaautodesarrollo['actividad_autodesarrollo_evento']['actautoeven_creditos_asistencia'];
					break;

					case TIPOACTAUTOEVACT : 
					case TIPOACTAUTODOCENTE : 
					case TIPOACTAUTOPUBLI : 
					case TIPOACTAUTOASISTEC : 
					case TIPOACTAUTOAAUTOFORM : 
						$actauto_creditos = "por persona";		
					break;
					
				}
				$arrayAct[] = array("act_codinap"=>$filaActAuto['act_codinap'],"act_nombre"=>$filaActAuto['act_nombre'],"act_codigo" => $filaActAuto['act_codigo'],"tipoact_codigo"=>$filaActAuto['tipoact_codigo'],"formact_codigo"=>FORMATOAUTO,"actcur_creditos"=>"---","actauto_creditos"=>$actauto_creditos,"actext_creditos"=>"---","actform_creditos"=>"---", "Curso"=>"no","Auto"=>"si","Ext"=>"no","Form"=>"no");
				}	
			}
		}
	}
	
	$act_codinap = array();
	foreach ($arrayAct as $llave => $fila) {
	   $act_codinap[$llave]  = $fila['act_codinap'];
	}

	if ($arregloBuscar['buscaExt']) {
		if(!$oActividadExterna->BuscarActividadExterna($ArregloDatos,$numfilas,$resultActExt,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result = false;			
		}
	
		if(!$result) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar actividades. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;											
		} else {
			while ($filaActExt = mysqli_fetch_assoc($resultActExt)) {
				if (in_array($filaActExt['act_codinap'],$act_codinap)) {
					$clave = array_search ($filaActExt['act_codinap'],$act_codinap);
					$arrayAct[$clave]['actext_creditos'] = $filaActExt['actext_creditos'];
				} else 
					$arrayAct[] = array("act_codinap"=>$filaActExt['act_codinap'],"act_nombre"=>$filaActExt['act_nombre'],"act_codigo" => $filaActExt['act_codigo'],"tipoact_codigo"=>$filaActExt['tipoact_codigo'],"formact_codigo"=>FORMATOEXT,"actcur_creditos"=>"---","actauto_creditos"=>"---","actext_creditos"=>$filaActExt['actext_creditos'],"actform_creditos"=>"---", "Curso"=>"no","Auto"=>"no","Ext"=>"si", "Form"=>"no");
			}
		}
	}	
	
	if ($arregloBuscar['buscaFormal']) {
		$numfilas=0;
		if(!$oActividadEducacionFormal->BuscarActividadEducacionFormal($ArregloDatos,$numfilas,$resultActForm,$error,$errormail)){
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$result = false;			
		}
	
		if(!$result) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar actividades. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;											
		} else {
			while ($filaActForm = mysqli_fetch_assoc($resultActForm)) {
				if (in_array($filaActForm['act_codinap'],$act_codinap)) {
					$clave = array_search ($filaActForm['act_codinap'],$act_codinap);
					$arrayAct[$clave]['actform_creditos'] = $filaActForm['actform_creditos'];
				} else {
					$actform_creditos = "por persona";		
					$arrayAct[] = array("act_codinap"=>$filaActForm['act_codinap'],"act_nombre"=>$filaActForm['act_nombre'],"act_codigo" => $filaActForm['act_codigo'],"tipoact_codigo"=>$filaActForm['tipoact_codigo'],"formact_codigo"=>FORMATOEFORMAL,"actcur_creditos"=>"---","actauto_creditos"=>"---","actext_creditos"=>"---","actform_creditos"=>$actform_creditos,"Curso"=>"no","Auto"=>"no","Ext"=>"no","Form"=>"si");
				}
			}
		}
	}	
	
	$act_codinap = array();
	$act_nombre = array();
	$tipoact_codigo = array();
	$formact_codigo = array();			
	
	// separo los arrays par poder ordenarlos
	foreach ($arrayAct as $llave => $fila) {
	   $act_codinap[$llave]  = $fila['act_codinap'];
	   $act_nombre[$llave] = $fila['act_nombre'];
	   $tipoact_codigo[$llave]  = $fila['tipoact_codigo'];
	   $formact_codigo[$llave] = $fila['formact_codigo'];
	}
	
	// ordeno los arrays 
	array_multisort($act_nombre, SORT_ASC, $act_codinap, SORT_ASC, $arrayAct);

		$opciones=array(
			"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
			"FilasPagina"=>20,
			"NombrePaginaQuery"=>"pagina"
		);				
		
		$oGrilla = new cGrilla($opciones);
		$oGrilla->SetearTituloGrilla('Actividades que cumplen los criterios de búsqueda: ');
		$oGrilla->SetearAnchoGrilla('90%');

		$miColumna0 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna0,'Código');
		$oGrilla->Setear('campo_grilla',$miColumna0,'act_codinap');
		$oGrilla->Setear('align_columna',$miColumna0,'left');

		$miColumna1 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('titulo_columna',$miColumna1,'Nombre');
		$oGrilla->Setear('campo_grilla',$miColumna1,'act_nombre');
		$oGrilla->Setear('align_columna',$miColumna1,'left');

		$miColumna2 = $oGrilla->AddColumna('popup');
		$oGrilla->Setear('titulo_columna',$miColumna2,'Detalle');
		$oGrilla->Setear('ancho_columna',$miColumna2,'55');
		$oGrilla->Setear('imagen',$miColumna2,'images/verdetalle.gif');
		$oGrilla->Setear('altImagen',$miColumna2,'Ver detalle');
		$oGrilla->Setear('url',$miColumna2,$_SESSION['array_busqueda_actividad']['idtextboxAddValorDis']);
		$oGrilla->Setear('ventanaAnchoPopup',$miColumna2,'680');
		$oGrilla->Setear('ventanaAltoPopup',$miColumna2,'500');
		$oGrilla->Setear('ventanaVarxPopup',$miColumna2,'120');
		$oGrilla->Setear('ventanaVaryPopup',$miColumna2,'50');
		$oGrilla->AddParametrosURL($miColumna2,"act_codigo",'act_codigo');
		$oGrilla->AddParametrosURL($miColumna2,"tipoact_codigo",'tipoact_codigo');

		$miColumna7 = $oGrilla->AddColumna('linkimg');
		$oGrilla->Setear('ancho_columna',$miColumna7,'30');		
		$oGrilla->Setear('titulo_columna',$miColumna7,'');
		$oGrilla->Setear('align_columna',$miColumna7,'right');
		$oGrilla->Setear('imagen',$miColumna7,'images/pdf.gif');
		$oGrilla->Setear('altImagen',$miColumna7,'Diseño/Detalle en PDF');
		$oGrilla->Setear('url',$miColumna7,"download_pdf.dhtml");
		$oGrilla->Setear('target',$miColumna7,"_blank");
		$oGrilla->AddParametrosURL($miColumna7,"contenido",'diseno','cte');
		$oGrilla->AddParametrosURL($miColumna7,"formact_codigo",'formact_codigo');
		$oGrilla->AddParametrosURL($miColumna7,"act_codigo",'act_codigo');
		$oGrilla->AddParametrosURL($miColumna7,"tipoact_codigo",'tipoact_codigo');
	
	if ($arregloBuscar['buscaCurso']) {
		$miColumna3 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('ancho_columna',$miColumna3,'55');
		$oGrilla->Setear('titulo_columna',$miColumna3,'Créd. Curso');
		$oGrilla->Setear('campo_grilla',$miColumna3,'actcur_creditos');
		$oGrilla->Setear('align_columna',$miColumna3,'right');
	}

	if ($arregloBuscar['buscaAuto']) {
		$miColumna4 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('ancho_columna',$miColumna4,'55');	
		$oGrilla->Setear('titulo_columna',$miColumna4,'Créd. Autod.');
		$oGrilla->Setear('campo_grilla',$miColumna4,'actauto_creditos');
		$oGrilla->Setear('align_columna',$miColumna4,'right');
	}
		
	if ($arregloBuscar['buscaExt']) {
		$miColumna5 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('ancho_columna',$miColumna5,'55');		
		$oGrilla->Setear('titulo_columna',$miColumna5,'Créd. Externa');
		$oGrilla->Setear('campo_grilla',$miColumna5,'actext_creditos');
		$oGrilla->Setear('align_columna',$miColumna5,'right');
	}

	if ($arregloBuscar['buscaFormal']) {
		$miColumna5 = $oGrilla->AddColumna('txt');
		$oGrilla->Setear('ancho_columna',$miColumna5,'55');		
		$oGrilla->Setear('titulo_columna',$miColumna5,'Créd. Formal');
		$oGrilla->Setear('campo_grilla',$miColumna5,'actform_creditos');
		$oGrilla->Setear('align_columna',$miColumna5,'right');
	}

	if ($oGrilla->CargarGrilla($arrayAct)) {
		$oGrilla->MostrarGrilla();					
	} else {
		$error=true;					
		$txt_sys_mail = "Error Grilla='".$oGrilla->GetError();
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al mostrar actividades.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO), $txt_sys_mail);
	}		
	
	return $result;
}
