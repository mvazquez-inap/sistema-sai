					$result = false;			
				}
			break;

			case "todo":
				if(!$oActividadExterna->BuscarActividadExterna($ArregloDatos,$numfilas,$resultActExt,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos a mostrar 5.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$result = false;			
				}
			break;
		}
		
		
	
		if(!$result) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar actividades. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;											
		} else {
			while ($filaActExt = mysqli_fetch_assoc($resultActExt)) {
				if (in_array($filaActExt['act_codinap'],$act_codinap)) {
