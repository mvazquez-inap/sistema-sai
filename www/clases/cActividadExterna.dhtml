//-----------------------------------------------------------------------------------------------------	
	function TienePermisoModificar($act_codigo,$rolcod,$jurisdid) {
	
		if (!$this->TraerDatosActividadExterna($act_codigo,$fila_actividad,$es_modif)) 
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;		
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Externa a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
		
		if 	($rolcod == USUACTEXT)  {
			if ($fila_actividad['actividad_externa']['actext_estado'] == ACTEXTERNAACTIVO) 
				return true;		
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTEXTERNAESTADO","' and constantecod='",$fila_actividad['actext_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Externa (".$descri."), no le permite modificarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;		
			}
		}

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar la Actividad Externa.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoBaja($act_codigo,$rolcod,$jurisdid) {

		if (!$this->TraerDatosActividadExterna($act_codigo,$fila_actividad,$es_modif)) 
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;		
		if (!$es_modif)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Externa a eliminar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		} 
		
		if 	($rolcod == USUACTEXT)  {
			if ($fila_actividad['actividad_externa']['actext_estado'] == ACTEXTERNAACTIVO) 
				return true;		
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTEXTERNAESTADO","' and constantecod='",$fila_actividad['actext_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Externa (".$descri."), no le permite modificarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;		
			}
		}

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar la Actividad Externa.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
//-----------------------------------------------------------------------------------------------------	
	function BuscarActividadExterna($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxact_codigo'=>0);
		$sparam+=array('pxact_nombre'=>0);
		$sparam+=array('pxact_codinap'=>0);
		$sparam+=array('pxact_codinap_exacto'=>0);

		$sparam+=array('pxactext_estado'=>0);
		$sparam+=array('pxtipoact_codigo'=>0);
		
		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('pact_nombre'=>"");
		$sparam+=array('pact_codinap'=>"");
		$sparam+=array('pact_codinap_exacto'=>"");
		$sparam+=array('pactext_estado'=>"-1");
		$sparam+=array('ptipoact_codigo'=>"-1");

		$sparam+=array('porderby'=>"act_nombre");
				
			
		if (isset ($ArregloDatos['act_codigo']))
		{
			if ($ArregloDatos['act_codigo']!="")
			{	
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}	

		if (isset ($ArregloDatos['act_nombre']))
		{
			if ($ArregloDatos['act_nombre']!="")
			{	
				$sparam['pact_nombre']= $ArregloDatos['act_nombre'];
				$sparam['pxact_nombre']= 1;
			}
		}	
	
		if (isset ($ArregloDatos['act_codinap']))
		{
			if ($ArregloDatos['act_codinap']!="")
			{	
				$sparam['pact_codinap']= $ArregloDatos['act_codinap'];
				$sparam['pxact_codinap']= 1;
			}
		}	

