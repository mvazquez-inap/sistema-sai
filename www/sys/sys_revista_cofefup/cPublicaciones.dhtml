	}
	
	
	function EliminarPublicacion($datos)
	{

		if (!$this->PuedeEliminar($datos))
			return false;

		if(!$oArticulos->Buscarxidpublicacion($datosbusqueda,$resultado,$numfilas))
			return false;
		
		if ($numfilas>0)
		{
			MostrarMensaje($this->conexion,MSG_INF,"Error, la publicacion no se puede eliminar ya que se encuentra asociado a ".$numfilas." articulos/s.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),"",2);
			return false;
		}
		$datospublicacion = mysqli_fetch_assoc($resultado);
		
		$spnombre="del_publicacion_xidpub";
		$sparam=array(
			'pidpub'=> $datos["idpub"]
			);
		
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha podido eliminar la publicación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		} 

		if (isset($datospublicacion['revista_pdf']) && $datospublicacion['revista_pdf']!="")
		{
			if (!unlink(ARCHIVOS_PDF.$datospublicacion['revista_pdf']))	
			{
				FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha podido eliminar el pdf.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
		}
		if (isset($datospublicacion['imagen_tapa']) && $datospublicacion['imagen_tapa']!="")
		{
			if (!unlink(ARCHIVOS_IMG.$datospublicacion['imagen_tapa']))	
			{
				FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha podido eliminar el pdf.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
		}
		
		return true;
	
	}
	
	function PuedeInsertar($datos)
	{

		if (isset($datos['fecha_edicion']) && $datos['fecha_edicion']=="")
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, debe ingresar una fecha de edicion",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		if (isset($datos['anio_edicion']) && $datos['anio_edicion']=="")
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, debe ingresar un ano de edicion",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		if (isset($datos['numero_edicion']) && $datos['numero_edicion']=="")
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, debe ingresar un numero de edicion",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		
		if (isset($datos['imagen_tapa']) && $datos['imagen_tapa']=="")
		{
			MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, debe ingresar una imagen de tapa",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
				

		return true;

	
	}

	
	
	function PuedeEliminar($datos)
	{
		
		$oArticulos = new cArticulos($this->conexion);
		$datosbusqueda['idpub'] = $datos['idpub'];
		if(!$oArticulos->Buscarxidpublicacion($datosbusqueda,$resultado,$numfilas))
			return false;
		
		if ($numfilas>0)
		{
			MostrarMensaje($this->conexion,MSG_INF,"Error, la publicacion no se puede eliminar ya que se encuentra asociado a ".$numfilas." articulos/s.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),"",2);
			return false;
		}
		
		return true;
	}
/* 	
//-----------------------------------------------------------------------------------------
//                                       PRIVADAS   
//----------------------------------------------------------------------------------------- 
// Retorna si los datos enviados son válidos para dar de alta un nuevo registro

// Parámetros de Entrada:
//          datos: un array asociativo con los datos a cargar

// Retorna:
//          datosvalidados: datos habilitados para cargar en la base
//          la función retorna true si los datos están correctos, false en caso contrario
      
      protected function DatosValidosAlta($datos,&$datosvalidados)
      {
            $datosvalidados=array();
            
            if(!$this->ValidarDatosBasicosRegistro($datos,$datosvalidados))
                  return false;
                  
            $datosvalidados['regdatoestado'] = REGINICICIAL;     
            
            return true;
      }
//----------------------------------------------------------------------------------------- 
// Retorna si los datos enviados son válidos para actualizar un registro

// Parámetros de Entrada:
//          regdatocod: es el registro a actualizar
//          datos: un array asociativo con los datos a cargar

// Retorna:
//          datosvalidados: datos habilitados para actualizar el registro
//          la función retorna true si los datos están correctos, false en caso contrario
      

      protected function DatosValidosModificacion($regdatocod,$datos,&$datosvalidados)
      {
        	if(!$this->ValidarDatosBasicosRegistro($datos,$datosvalidados))
                  return false;
                  
            return true;
      }
//----------------------------------------------------------------------------------------- 
// Retorna si el registro se puede borrar

// Parámetros de Entrada:
//          usuariocod,rol: es el usuario/rol que quiere borrar el registro
//          regdatocod: es el registro a borrar

// Retorna:
//          datosvalidados: datos habilitados para borrar el registro
//          la función retorna true si los datos están correctos, false en caso contrario

    protected function DatosValidosBorrado($usuariocod,$rolcod,$notcod,&$datosvalidados)
    {
    
// falta
    	return true;
    }      

//----------------------------------------------------------------------------------------- 
// Verifica si están los datos básicos de un registro

// Parámetros de Entrada:
//          datos: los datos a validar

// Retorna:
//          datosvalidados: los datos ya validados
//          la función retorna true o false si se pudo ejecutar con éxito o no
      
	protected function ValidarDatosBasicosRegistro($datos,&$datosvalidados)
    {
		if($datos['regdatonom']=="")
        {
        	FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Falta ingresar el nombre interno.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
            return false;
		}
        $datosvalidados["regdatonom"]=$datos['regdatonom'];

        if($datos['regdatodesccorta']=="")
        {
        	FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Falta ingresar el título. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
            return false;
		}
        $datosvalidados["regdatodesccorta"]=$datos['regdatodesccorta'];

        if($datos['regdatocopete']=="")
        {
        	FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Falta ingresar el copete. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
            return false;
		}
		
		if(strlen($datos['regdatocopete'])>400)
        {
        	FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El copete superó la máxima longitud permitida. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
            return false;
		}
        $datosvalidados["regdatocopete"]=$datos['regdatocopete'];

        $datosvalidados["regdatofvenc"]="NULL";
            
        if(!FuncionesPHPPortal::ValidarContenido($this->conexion,$datos["regdatoorden"],"NumericoEntero"))
        {
        	FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en el orden. Debe ser numérico. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
            return false;
		}
        $datosvalidados["regdatoorden"]=$datos['regdatoorden'];

        if(isset($datos["regdatodestacada"]))
        	$datosvalidados["regdatodestacada"]="1";
		else 
        	$datosvalidados["regdatodestacada"]="0";
            
		$datosvalidados["regdatodesclarga"]=$datos['regdatodesclarga'];

		$datosvalidados["regdatolink"] 		= $datos["regdatolink"] ;
		
		$datosvalidados["imgcod"]=$datos['imgcod'];
		
		$datosvalidados["regdatovideo"]=$datos['regdatovideo'];
		$datosvalidados["regdatoepigrafe"]=$datos['regdatoepigrafe'];
    	$datosvalidados["imgalt"]=$datos['imgalt'];    
		$datosvalidados["regdatoaudio"]=$datos['regdatoaudio'];
		$datosvalidados["regdatovideoyoutube"] 	= $datos['regdatovideoyoutube'];
        
		
        // Setea en null aquellos datos que no se usan en la implementación de articulos 
        $datosvalidados["regdatofinicio"]   = "NULL";
        $datosvalidados["regdatoffin"]      =  "NULL";
        $datosvalidados["regdatofvenc"] 	= "NULL";
        $datosvalidados["usuariobloqueo"] 	= "NULL";
                        
		return true;
	}

//----------------------------------------------------------------------------------------- 
	protected function AltaRegistroTablaPropiaVariables($datos,$regdatocod)
	{

	$datos["art_tags"]=NULL;
	
    	$spnombre="ins_tablas_propias_articulos_datos_variables";
		$sparam=array(
				'pregdatocod'=> $regdatocod,
				'part_ano_edicion'=> $datos["art_ano_edicion"],
				'part_numero_edicion'=> $datos["art_numero_edicion"],
				'part_orden_menu'=> $datos["art_orden_menu"],
				'part_es_mas_leida'=> $datos["art_es_mas_leida"],
				'part_orden_destacada'=> $datos["art_orden_destacado"],
				'part_orden_mas_leida'=> $datos["art_orden_mas_leida"],
				'part_tags'=> $datos["art_tags"],
				'pultmodusuario'=> $_SESSION['usuariocod'],
				'pultmodfecha'=> date("Y/m/d H:i:s")
		);


		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPPortal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"No se ha podido insertar el registro.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		return true;
	}     
