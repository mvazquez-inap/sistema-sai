	function  VerificarInscripcionPersona ($act_codigo, $pers_codigo, &$puede_inscribir, &$mensaje_no_inscripcion) {

		$puede_inscribir = true;

		// Se verifica que la persona sea docente de la actividad y haya sido asignado a alguna comisión
		// de la misma (Se asume que la actividad tiene formato curso)

		$oPrestadorDocente = new cPrestadorDocente($this->conexion);

		$ArregloDatos = array();

		// Hay que obtener el cuit de la persona para buscarlo como prestador docente
		if (!$this->conexion->TraerCampo("persona","pers_cuilt",array("pers_codigo='",$pers_codigo,"'"),$pers_cuilt,$numfilas,$errorcod)) {
			$errormail="\nact_codigo=".$act_codigo."\npers_codigo=".$pers_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la persona",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}

		$ArregloDatos['presdoc_cuilt']=$pers_cuilt;

		if(!$oPrestadorDocente->BuscarPrestadorDocente($ArregloDatos,$numfilas,$result,$error,$errormail)) {
			$errormail = $errno."\nact_codigo=".$act_codigo."\npers_codigo=".$pers_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error buscando a la presona dentro de los prestadores docentes.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} elseif ($numfilas==0) {
			$errormail = "\nnumfilas".$numfilas." ".$error."\nact_codigo=".$act_codigo."\npers_codigo=".$pers_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La persona no esta registrada como Prestador Docente INAP.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		} else {

			$fila_pres_doc = mysql_fetch_assoc($result);

			// Busco el prestador en alguna comisión CERRADA o CERTIFICADA
			$oComisionPrestadorDocente = new cComisionPrestadorDocente($this->conexion);
			$ArregloDatos=array();
			$ArregloDatos['act_codigo']=$act_codigo;
			$ArregloDatos['presdoc_codigo']=$fila_pres_doc['presdoc_codigo'];
			$ArregloDatos['comi_estado']=COMISIONCERRADA.",".COMISIONCERTIFICADA; // cambia se saca abierta para certificar la comision donde fue docente tiene que estar por lo menos cerrada

			if (!$oComisionPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
				$errormail = "\nnumfilas".$numfilas." ".$error."\nact_codigo=".$act_codigo."\npers_codigo=".$pers_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar docentes en las comisiones de la actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			} elseif ($numfilas==0) {
				$errormail = "\nnumfilas".$numfilas." ".$error."\nact_codigo=".$act_codigo."\npers_codigo=".$pers_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"La persona no se encuentra asignada como Prestador Docente <br>de ninguna comisión de la actividad o bien  <br> la Comisión no se encuentra ABIERTA, CERRADA o CERTIFICADA.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		} // !$oPrestadorDocente->BuscarPrestadorDocente

		// Busco a la persona en todas las comisiones de la actividad
		$ArregloDatos = array();
		$ArregloDatos['act_codigo'] = $act_codigo;
		$ArregloDatos['pers_codigo'] = $pers_codigo;

		$oComisionPersona = new cComisionPersona($this->conexion);
		if (!$oComisionPersona->BuscarActividadAsignadaPersonaAvanzada($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
			$error="Error al buscar la Persona en Actividad Curso.";
			$errormail="Error al buscar la Persona en Actividad Curso.".$errno."\nact_codigo=".$act_codigo."\npers_codigo=".$pers_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}

		while (($fila_inscripcion = mysql_fetch_assoc($resultado)) && ($puede_inscribir)) {
			if (!$this->conexion->TraerCampo("comision","comi_estado",array("comi_codigo='",$fila_inscripcion['comi_codigo'],"'"),$comi_estado,$numfilas,$errorcod)) {
				$error="Error al buscar el estado de la Comisión.";
				$errormail="\ncomi_codigo = ".$fila_inscripcion['comi_codigo']."\npers_codigo=".$pers_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
				return false;
			}
			if ($comi_estado != COMISIONCERTIFICADA) {
				$puede_inscribir = false;
				$mensaje_no_inscripcion = "La persona ya tiene asignada esta Actividad en la Comisión con Código INAP: ".$fila_inscripcion['comi_codinap']."<br>"."Dicha Comisión no se ha certificado.";
			} else {
				if ($fila_inscripcion['eval_certifica'] == "S" ) {
					$puede_inscribir = false;
					$mensaje_no_inscripcion = "La persona ya tiene acreditada esta Actividad en la Comisión con Código INAP: ".$fila_inscripcion['comi_codinap'];
				}
			}
		} // while

		return true;
	}



