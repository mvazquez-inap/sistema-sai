// -----------------------------------------------------------------------------------------
function mostrar_tablaBasica($xml2) { ?>
<table border="1" style="width:40%">
  <tr style="background-color:#999999; color:#FFFFFF; font-weight:bold; text-align:center;">
    <th style="width:5%">C&oacute;digo</th>
    <th style="">Descripci&oacute;n</th>
  </tr>
<?php
	foreach ($xml2->tabla_descriptores as $descriptor) {
		foreach ($descriptor as $descriptor) {
?>        <tr>
            <td style="text-align:center"><?php  echo utf8_decode($descriptor->codigo); ?></td>
            <td style="text-align:left"><?php  echo utf8_decode($descriptor->descripcion); ?></td>
          </tr>
  <?php	}
	}
?>
</table>
<?php
} // fin mostrar_tablaBasica

// -----------------------------------------------------------------------------------------
function mostrar_tablaTipoActividad($xml2) { ?>
<table border="1" style="width:40%">
  <tr style="background-color:#999999; color:#FFFFFF; font-weight:bold; text-align:center;">
    <th style="width:5%">C&oacute;digo</th>
    <th style="">Descripci&oacute;n</th>
    <th style="width:5%">C&oacute;digo Formato</th>
  </tr>
<?php
	foreach ($xml2->tabla_descriptores as $descriptor) {
		foreach ($descriptor as $descriptor) {
?>         <tr>
            <td style="text-align:center"><?php  echo utf8_decode($descriptor->codigo); ?></td>
            <td style="text-align:left"><?php  echo utf8_decode($descriptor->descripcion); ?></td>
            <td style="text-align:center"><?php  echo utf8_decode($descriptor->codigo_formato); ?></td>
          </tr>
<?php		}
	}
?>
</table>
<?php
} // mostrar_tablaTipoActividad
// -----------------------------------------------------------------------------------------
function mostrar_tablaResolucionxTipo($xml2) { ?>
<table border="1" style="width:40%">
  <tr style="background-color:#999999; color:#FFFFFF; font-weight:bold; text-align:center;">
    <th style="width:5%">Tipo de Actividad</th>
    <th style="">Descripci&oacute;n</th>
    <th style="width:5%">C&oacute;digo Formato</th>
  </tr>
<?php
	foreach ($xml2->tabla_descriptores as $descriptor) {
		foreach ($descriptor as $descriptor) {
?>        <tr>
            <td style="text-align:center"><?php  echo utf8_decode($descriptor->codigo_tipoact); ?></td>
            <td style="text-align:left"><?php  echo utf8_decode($descriptor->descripcion); ?></td>
            <td style="text-align:center"><?php  echo utf8_decode($descriptor->codigo_formato); ?></td>
		  </tr>
  <?php	}
	}
?>
</table>
<?php 
} // fin mostrar_tablaResolucionxTipo
