<?php	}
//-----------------------------------------------------------------------------------------------------	
	function DescargarExcelDictamen($array_filtro) {

		//------------------------------------------------------------------
		// Funciones internas 
		//------------------------------------------------------------------
		function _cargarDatosCursoArray($array_Dictamenes,&$arrayresult,&$array_claves) {
			$arrayresult=array();
			$array_claves=array();
			$i=0;
			foreach ($array_Dictamenes as $clave=>$filaresult)	{
				$arrayresult[$i]['dis_numero']= $filaresult['datos_disposicion']['dis_numero'];
				$arrayresult[$i]['dis_fecha'] = $filaresult['datos_disposicion']['dis_fecha'];
				$arrayresult[$i]['exp_numero'] = $filaresult['datos_expediente']['exp_numero'];
				$arrayresult[$i]['jurisdid_exp'] = $filaresult['datos_expediente']['jurisdid_exp'];
				$arrayresult[$i]['act_codinap'] = $filaresult['datos_actividad']['act_codinap'];				
				$arrayresult[$i]['act_nombre'] = $filaresult['datos_actividad']['act_nombre'];
				$arrayresult[$i]['tipoact_norma_legal'] = $filaresult['datos_actividad_tipo']['tipoact_norma_legal'];
				
				switch  ($filaresult['datos_actividad_tipo']['tipoact_codigo']) {
				case TIPOACTCURSOINAP:	
					$arrayresult[$i]['progcur_descripcion'] = $filaresult['datos_actividad_tipo']['progcur_descripcion'];
					$arrayresult[$i]['areacur_descripcion'] = $filaresult['datos_actividad_tipo']['areacur_descripcion'];
					break;
				case TIPOACTCURSOINST:
					$arrayresult[$i]['insti_orga'] = $filaresult['datos_actividad_tipo']['insti_orga'];
					break;			
	
				case TIPOACTCURSOJURISD:
					$arrayresult[$i]['datos_perfil'] = $filaresult['datos_perfil'];
					$arrayresult[$i]['datos_poc'] = $filaresult['datos_poc'];
					break;			
				
				case TIPOACTAUTODOCENTE:
				case TIPOACTAUTOEVACT:
				case TIPOACTAUTOPUBLI:
				case TIPOACTAUTOASISTEC:
				case TIPOACTAUTOAAUTOFORM:				
					$arrayresult[$i]['dictamen'] = $filaresult['dictamen']['insti_orga'];
					break;					
				} 
				
				$arrayresult[$i]['actprog_fecha_inicio'] = $filaresult['datos_dictamen']['actprog_fecha_inicio'];
				$arrayresult[$i]['actprog_fecha_fin'] = $filaresult['datos_dictamen']['actprog_fecha_fin'];
				$arrayresult[$i]['actcur_creditos'] = $filaresult['datos_actividad_tipo']['act_creditos'];
				$arrayresult[$i]['dic_observaciones'] = $filaresult['datos_dictamen']['dic_observaciones'];
				$i++;
			}
			
			foreach ($arrayresult[0] as $clave=>$valor) {
				$array_claves[]=$clave;
			}
		} // funcion interna
		
		//----------------------------------------------------------------------
		function _cargarDatosExternaArray($array_Dictamenes,&$arrayresult,&$array_claves) {
			$arrayresult=array();
			$array_claves=array();
			$i=0;
			foreach ($array_Dictamenes as $clave=>$filaresult)	{
				$arrayresult[$i]['dis_numero']= $filaresult['datos_disposicion']['dis_numero'];
				$arrayresult[$i]['dis_fecha'] = $filaresult['datos_disposicion']['dis_fecha'];
				$arrayresult[$i]['exp_numero'] = $filaresult['datos_expediente']['exp_numero'];
				$arrayresult[$i]['jurisdid_exp'] = $filaresult['datos_expediente']['jurisdid_exp'];
				$arrayresult[$i]['act_codinap'] = $filaresult['datos_actividad']['act_codinap'];				
				$arrayresult[$i]['act_nombre'] = $filaresult['datos_actividad']['act_nombre'];
				$arrayresult[$i]['tipoact_norma_legal'] = $filaresult['datos_actividad_tipo']['tipoact_norma_legal'];
				$arrayresult[$i]['insti_orga'] = $filaresult['datos_actividad_tipo']['insti_orga'];
				$arrayresult[$i]['actprog_fecha_inicio'] = $filaresult['datos_dictamen']['actprog_fecha_inicio'];
				$arrayresult[$i]['actprog_fecha_fin'] = $filaresult['datos_dictamen']['actprog_fecha_fin'];
				$arrayresult[$i]['actext_creditos'] = $filaresult['datos_actividad_tipo']['act_creditos'];
				$arrayresult[$i]['dic_observaciones'] = $filaresult['datos_dictamen']['dic_observaciones'];
				$i++;
			}
			foreach ($arrayresult[0] as $clave=>$valor) {
				$array_claves[]=$clave;
			}
		} // funcion interna
		//----------------------------------------------------------------------
		function _cargarDatosAutodesarrolloArray($conexion,$array_Dictamenes,&$arrayresult,&$array_claves) {
		
			$arrayresult=array();
			$array_claves=array();
			$i=0;
			foreach ($array_Dictamenes as $clave=>$filaresult)	{
				$arrayresult[$i]['dis_numero']= $filaresult['datos_disposicion']['dis_numero'];
				$arrayresult[$i]['dis_fecha'] = $filaresult['datos_disposicion']['dis_fecha'];
				$arrayresult[$i]['exp_numero'] = $filaresult['datos_expediente']['exp_numero'];
				$arrayresult[$i]['jurisdid_exp'] = $filaresult['datos_expediente']['jurisdid_exp'];
				$arrayresult[$i]['act_codinap'] = $filaresult['datos_actividad']['act_codinap'];				
				$arrayresult[$i]['act_nombre'] = $filaresult['datos_actividad']['act_nombre'];
				$arrayresult[$i]['tipoact_norma_legal'] = $filaresult['datos_actividad_tipo']['tipoact_norma_legal'];
				$arrayresult[$i]['destinatario'] = isset($filaresult['datos_dictamen']['destinatario'])?$filaresult['datos_dictamen']['destinatario']:"";
				$arrayresult[$i]['actprog_fecha_inicio'] = isset($filaresult['datos_dictamen']['actprog_fecha_inicio'])?$filaresult['datos_dictamen']['actprog_fecha_inicio']:"";
				$arrayresult[$i]['actprog_fecha_fin'] = isset($filaresult['datos_dictamen']['actprog_fecha_fin'])?$filaresult['datos_dictamen']['actprog_fecha_fin']:"";

				$arrayresult[$i]['actauto_creditos'] = $filaresult['datos_actividad_tipo']['act_creditos'];
				$arrayresult[$i]['actauto_dictamen'] =  str_replace("<br>",chr(10),$filaresult['datos_dictamen']['dictamen']);
				$i++;
			}
			
			foreach ($arrayresult[0] as $clave=>$valor) {
				$array_claves[]=$clave;
			}
		} // funcion interna
		
		//----------------------------------------------------------------------
		function _setearFormato(&$oExcel,$elemento) {			

			$oExcel->BorrarFormato("");
			switch ($elemento) {		
				case 'titulo':
					$oExcel->AddFormato ("Tamaño",10);
					$oExcel->AddFormato ("Border",1);
					$oExcel->AddFormato ("TextWrap","");
					$oExcel->AddFormato ("Font","Times New Roman");
					$oExcel->AddFormato ("Color","azul");					
					$oExcel->AddFormato ("FgColor",22);
					$oExcel->AddFormato ("Align","left");
					break;
				case 'titulo_columna':
					$oExcel->AddFormato ("Tamaño",8);
					$oExcel->AddFormato ("Border",1);
					$oExcel->AddFormato ("TextWrap","");
					$oExcel->AddFormato ("Font","Times New Roman");
					$oExcel->AddFormato ("Color","negro");
					$oExcel->AddFormato ("FgColor","gris");
					$oExcel->AddFormato ("Align","center");
					$oExcel->AddFormato ("VAlign","vcenter");
					break;
				case "contenido":
					$oExcel->AddFormato ("Tamaño",8);
					$oExcel->AddFormato ("Border",1);
					$oExcel->AddFormato ("TextWrap","");
					$oExcel->AddFormato ("FgColor","blanco");
					$oExcel->AddFormato ("Align","left");
					$oExcel->AddFormato ("VAlign","vcenter");
					break;		
				case "contenido_centrado":
					$oExcel->AddFormato ("Tamaño",8);
					$oExcel->AddFormato ("Border",1);
					$oExcel->AddFormato ("TextWrap","");
					$oExcel->AddFormato ("FgColor","blanco");
					$oExcel->AddFormato ("Align","center");
					$oExcel->AddFormato ("VAlign","vcenter");
					break;			
			}	
		}	
	//------------ Inicio funcion	
	$nombrearchivo="dictamen.xls";  					
	$oExcel = new cEscribirExcel($nombrearchivo);

	$filtroDatos=array();	
	if (isset($array_filtro['lstDic']))
		$filtroDatos['dictamen_en']=$array_filtro['lstDic'];

	if (isset($array_filtro['dis_codigo']))
		$filtroDatos['dis_codigo']=$array_filtro['dis_codigo'];

	if (!isset($array_filtro['xrol']))
		$filtroDatos['xrol']=false;
	else 
		$filtroDatos['xrol']=$array_filtro['xrol'];

	// Formatos Contenido
	_setearFormato($oExcel,'contenido');
	$formato=$oExcel->GetFormato(); 	
	_setearFormato($oExcel,'contenido_centrado');
	$formato_centrado=$oExcel->GetFormato(); 	
	$arreglo_centrados = array('actcur_creditos','actauto_creditos','actext_creditos','dis_fecha','actprog_fecha_inicio','actprog_fecha_fin','tipoact_norma_legal');							
	// Ancho de cada columna
	$ancho_columna['disposición']=15;
	$ancho_columna['fecha_protocolizacion']=12;
	$ancho_columna['expediente']=15;
	$ancho_columna['origen_expediente']=20;
	$ancho_columna['codinap']=10;
	$ancho_columna['actividad']=40;
	$ancho_columna['asunto']=15;
	$ancho_columna['perfil']=40;
	$ancho_columna['poc']=10;
	$ancho_columna['programa']=20;
	$ancho_columna['area']=20;
	$ancho_columna['fecha_desde']=10;
	$ancho_columna['fecha_fin']=10;
	$ancho_columna['creditos']=10;
	$ancho_columna['organismo_institucion']=20;
	$ancho_columna['destinatario']=20;
	$ancho_columna['dictamen']=40;
	$ancho_columna['observaciones']=40;

	if (!$this->ObtenerDictamenesxFormato($filtroDatos,$resultDicActCurso, $numfilas_DicActCurso,
											$resultDicActExt,$numfilas_DicActExt, 
											$resultDicActAuto,$numfilas_DicActAuto)) { 

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al obtener los dictámenes Formato Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;											
	} else {

		// Según el formato de dictámenes que haya qye lista listar
		if($numfilas_DicActCurso>0) {  
	
			if (!$this->AgregarDetalleDictamenActCurso($resultDicActCurso,
							$array_DictamenesActCursoInap,
							$array_DictamenesActCursoInstitucional,
							$array_DictamenesActCursoJurisdiccional))  {

				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al obtener los dictámenes Formato Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
			if(count($array_DictamenesActCursoInap) > 0) {

				// Defino hoja de cursos
				$oExcel->AddHoja("Cursos Inap");
				$oExcel->EsconderGrillas();
				$oExcel->PaginaHorizontal();

				// Ancho columnas
				$oExcel->FormatoColumna (0,$ancho_columna['disposición']); 
				$oExcel->FormatoColumna (1,$ancho_columna['fecha_protocolizacion']); 
				$oExcel->FormatoColumna (2,$ancho_columna['expediente']); 
				$oExcel->FormatoColumna (3,$ancho_columna['origen_expediente']); 
				$oExcel->FormatoColumna (4,$ancho_columna['codinap']); 
				$oExcel->FormatoColumna (5,$ancho_columna['actividad']); 
				$oExcel->FormatoColumna (6,$ancho_columna['asunto']); 
				$oExcel->FormatoColumna (7,$ancho_columna['programa']); 
				$oExcel->FormatoColumna (8,$ancho_columna['area']); 
				$oExcel->FormatoColumna (9,$ancho_columna['fecha_desde']); 
				$oExcel->FormatoColumna (10,$ancho_columna['fecha_fin']); 
				$oExcel->FormatoColumna (11,$ancho_columna['creditos']); 
				$oExcel->FormatoColumna (11,$ancho_columna['observaciones']); 
				
				// Formato Titulo
				_setearFormato($oExcel,'titulo');
				$oExcel->CargarDatosVariasCeldas (0,0,0,12,"Dictámenes de Actividades Curso Inap",true);		

				// Formato Columnas Titulo
				_setearFormato($oExcel,'titulo_columna');			
				$oExcel->CargarDatos (1,0,"Disposición",true);
				$oExcel->CargarDatos (1,1,"Fecha Protocolización",true);
				$oExcel->CargarDatos (1,2,"Expediente",true);
				$oExcel->CargarDatos (1,3,"Origen Expediente",true);
				$oExcel->CargarDatos (1,4,"Cod. INAP",true);				
				$oExcel->CargarDatos (1,5,"Actividad",true);
				$oExcel->CargarDatos (1,6,"Asunto",true);
				$oExcel->CargarDatos (1,7,"Programa",true);
				$oExcel->CargarDatos (1,8,"Área",true);
				$oExcel->CargarDatos (1,9,"Fecha Desde",true);
				$oExcel->CargarDatos (1,10,"Fecha Hasta",true);
				$oExcel->CargarDatos (1,11,"Créditos",true);
				$oExcel->CargarDatos (1,12,"Observaciones",true);
		
				// Cargo Datos y los mando a la Grilla
				_cargarDatosCursoArray($array_DictamenesActCursoInap,$arrayresult,$arrayclaves);		

				foreach ($arrayclaves as $clave => $valor) {	
					if (in_array($valor,$arreglo_centrados))
	 					$arrayformato[$valor]=$formato_centrado;
					else 
	 					$arrayformato[$valor]=$formato;
				}

				$i=2;
				foreach ($arrayresult as $datos) {
					$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,$arrayformato);	
					$i++;
				}
			} 
		
			if(count($array_DictamenesActCursoInstitucional) > 0) {

				// Defino hoja de Cursos
				$oExcel->AddHoja("Cursos Institucionales");
				$oExcel->EsconderGrillas();
				$oExcel->PaginaHorizontal();

				// Ancho columnas
				$oExcel->FormatoColumna (0,$ancho_columna['disposición']); 
				$oExcel->FormatoColumna (1,$ancho_columna['fecha_protocolizacion']); 
				$oExcel->FormatoColumna (2,$ancho_columna['expediente']); 
				$oExcel->FormatoColumna (3,$ancho_columna['origen_expediente']); 
				$oExcel->FormatoColumna (4,$ancho_columna['codinap']); 				
				$oExcel->FormatoColumna (5,$ancho_columna['actividad']); 
				$oExcel->FormatoColumna (6,$ancho_columna['asunto']); 
				$oExcel->FormatoColumna (7,$ancho_columna['organismo_institucion']); 
				$oExcel->FormatoColumna (8,$ancho_columna['fecha_desde']); 
				$oExcel->FormatoColumna (9,$ancho_columna['fecha_fin']); 
				$oExcel->FormatoColumna (10,$ancho_columna['creditos']); 
			
				// Formato Titulo
				_setearFormato($oExcel,'titulo');				
