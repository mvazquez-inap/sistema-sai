						<?php $conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","PRESDOCCARACTER","' and constantecod='",$filaprestador['presdoc_caracter_alta'],"'"),$descri,$numfilascaracter,$errorcod); 
							echo $descri;
						?>
						</td>
