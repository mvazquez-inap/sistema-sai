<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oActividadCursoJurisdiccional = new cActividadCursoJurisdiccional($conexion);
//-----------------------------------------------------------------------------------------------
$conexion->ManejoTransacciones("B");
$result=true;

	if (isset($_POST['boton_aprueba'])) 
		$operacion = "A";
	else 
		$operacion = "R";	

if(!$oActividadCursoJurisdiccional->EvaluarActividadCursoJurisdiccional($_POST['act_codigo'],$operacion,$_POST,$datosvalidados))
	$result=false;

if($result) {

	if ($operacion == "A") {
		$operacion_mensaje = "APROBADO";
		FuncionesPHPLocal::RegistrarAcceso($conexion,"38602","act_codigo=".$_POST["act_codigo"],$_SESSION['usuariocod']);
	} else  {
		$operacion_mensaje = "RECHAZADO";			
		FuncionesPHPLocal::RegistrarAcceso($conexion,"38603","act_codigo=".$_POST["act_codigo"],$_SESSION['usuariocod']);
	}

	$oActividadCursoJurisdiccional->ArmarMensajeEvaluar($_POST,$operacion,$mensaje);
	$asunto = SISTEMA." - Evaluación del Diseño de la Actividad";

	if (FuncionesPHPLocal::MandarMail($conexion,COORDINADORTECNICO,$_SESSION['jurisdid_inap'],$asunto,$mensaje) || FuncionesPHPLocal::MandarMail($conexion,USUORGANISMO,$_SESSION['jurisdid_inap'],$asunto,$mensaje) ) 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"En unos momentos el Coordinador Técnico / Usuarios del Organismo <br> recibirán un correo electrónico con el resultado de su evaluación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	else 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El correo electrónico con la evaluación no fue enviado, <BR>notifique al Coordinador Técnico / Usuarios del Organismo por otra via.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	
	FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha efectuado la evaluación del diseño borrador de la actividad. <br>El diseño fue (".$operacion_mensaje.")." ,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	
	$conexion->ManejoTransacciones("C");

} else	
	$conexion->ManejoTransacciones("R");

?>		
<br><br><div align="center"><a href="actividad_curso_pre_evaluar.dhtml" class="linkFondoBlanco">Volver</a></div>
<?php
$oEncabezados->PieMenuEmergente();
?>