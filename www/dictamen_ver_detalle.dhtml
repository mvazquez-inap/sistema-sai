// Despues ver si conviene pasarlo a la clase o solo se ver desde este link
function MostrarDetalleDictamen($conexion,$dic_codigo,$formact_codigo,$tipoact_codigo) {

	// El código de dictamen es distinto entre programaciones y entre personas asi que con el
	// codigo lo identifico
		switch ($formact_codigo) {
		case FORMATOCURSO:
			$oActividad=new cActividadCurso($conexion);
			break;
		case FORMATOEXT:
			$oActividad=new cActividadExterna($conexion);
			break;
		case FORMATOAUTO:
			$oActividad=new cActividadAutodesarrollo($conexion);
			break;
	}		
	
	$ArregloDatos['dic_codigo'] = $dic_codigo;
	$ArregloDatos['formact_codigo'] = $formact_codigo;
	$ArregloDatos['tipoact_codigo'] = $tipoact_codigo;

	if (!$oActividad->BuscarActividadDictaminadaAvanzada($ArregloDatos,$numfilas,$resultDictamen,$error,$errormail)) {
		$txt_sys_mail = "\ndic_codigo".$dic_codigo."\nformact_codigo".$formact_codigo."\ntipoact_codigo".$tipoact_codigo;		
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar el dictamen seleccionado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;		
	} elseif($numfilas!=1) {
		$txt_sys_mail = "\ndic_codigo".$dic_codigo."\nformact_codigo".$formact_codigo."\ntipoact_codigo".$tipoact_codigo;		
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar el dictamen seleccionado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;		
	}
	
	// Le agrego descripciones 
	$oDictamen = new cDictamen($conexion);
	switch ($formact_codigo) {
		case FORMATOCURSO:
			// Es un único dictamen cualquiera sea el formato lo dejo array_Dictamen
			$oDictamen->AgregarDetalleDictamenActCurso($resultDictamen,$fila_dictamen_desc,$fila_dictamen_desc,$fila_dictamen_desc);
			break;
		case FORMATOEXT:
			$oDictamen->AgregarDetalleDictamenActExterna($resultDictamen,$fila_dictamen_desc) ;
			break;
		case FORMATOAUTO:
			$oDictamen->AgregarDetalleDictameActAutodesarrollo($resultDictamen,$fila_dictamen_desc); 
			break;
	}		
	$fila_dictamen = mysqli_fetch_assoc($resultDictamen);
	$fila_dictamen_detalle=$fila_dictamen_desc[0];

	// Muestro los detalles
?>	<table width="100%" class="textoTablaDatoBorde" align="center" border="1" cellpadding="4" cellspacing="0">
		<tr>
			<td width="130" class="textoEtiqueta">Nombre Actividad</td>
			<td class="textoEtiquetaDatoResaltado">
			<?= htmlspecialchars($fila_dictamen_detalle['datos_actividad']['act_nombre'],ENT_QUOTES);?></td>
		</tr>		
		<tr>
			<td width="130" class="textoEtiqueta">Código INAP</td>
			<td class="textoEtiquetaDatoResaltado">
				<input name="act_codinap" type="text" size="21" maxlength="20" class="inputReadonly" readonly="readonly" value="<?= htmlspecialchars($fila_dictamen_detalle['datos_actividad']['act_codinap'],ENT_QUOTES);?>" />
				<a class="linkListadoMenu" href='javascript:void(0)' onClick="Popup('actividad_ver_dis.dhtml?act_codigo=<?=$fila_dictamen_detalle['datos_actividad']['act_codigo']."&amp; tipoact_codigo=".$fila_dictamen_detalle['datos_actividad_tipo']['tipoact_codigo'] ?>','ventana_diseno',650,420,screen.availWidth-650,screen.availHeight-420,'yes');"> Ver diseño de la actividad </a> 
			</td>
		</tr>	
		
		<tr>
			<td width="130" class="textoEtiqueta">Tipo de Actividad </td>
			<td class="textoEtiquetaDatoResaltado">
<?php 				$conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_dictamen['tipoact_codigo'],"'"),$descri,$numfilas,$errorcod); 
				echo htmlspecialchars($descri,ENT_QUOTES); 
				echo "<br> Norma Legal: &nbsp;".htmlspecialchars($fila_dictamen_detalle['datos_actividad_tipo']['tipoact_norma_legal'],ENT_QUOTES);
?>			</td>
		</tr>	
		
<?php		if ($formact_codigo!=FORMATOAUTO || ($formact_codigo==FORMATOAUTO && $tipoact_codigo==TIPOACTAUTOEVASIS)) { ?>
