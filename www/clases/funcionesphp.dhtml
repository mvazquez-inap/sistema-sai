//----------------------------------------------------------------------------------------- 
// Genera una password aleatoria del largo ingresado

	static function GenerarPassword($largo) {
		$nuevapwd="";
		
		for($i=1;$i<=$largo;$i++)
			$nuevapwd.=chr(rand(65,90));
			
		return $nuevapwd;
		
	}
//----------------------------------------------------------------------------------------- 
// Verifica que la Fecha Actual sea mayor a FechaInferior y menor/igual a FechaSuperior
// Formatos Fecha: dd/mm/aaaa
static function FechasOrdenadas($FechaInferior,$FechaActual,$FechaSuperior) {
	
	$FIDia=substr($FechaInferior,0,2);
	$FIMes=substr($FechaInferior,3,2);
	$FIAnio=substr($FechaInferior,6,4);

	$FADia=substr($FechaActual,0,2);
	$FAMes=substr($FechaActual,3,2);
	$FAAnio=substr($FechaActual,6,4);

	$FSDia=substr($FechaSuperior,0,2);
	$FSMes=substr($FechaSuperior,3,2);
	$FSAnio=substr($FechaSuperior,6,4);

	if($FAAnio<$FIAnio)
		return false;
	else if($FAAnio==$FIAnio && $FAMes<$FIMes)
		return false;
	else if($FAAnio==$FIAnio && $FAMes==$FIMes && $FADia<$FIDia)
		return false;
	else if($FAAnio>$FSAnio)
		return false;
	else if($FAAnio==$FSAnio && $FAMes>$FSMes)
		return false;
	else if($FAAnio==$FSAnio && $FAMes==$FSMes && $FADia>$FSDia)
		return false;
	else
		return true;
}
//----------------------------------------------------------------------------------------- 
// Formatos Hora: HH:MM
static function HorasOrdenadas($hora1,$hora2) {

	$H1=substr($hora1,0,2);
	$M1=substr($hora1,3,2);
	$H2=substr($hora2,0,2);
	$M2=substr($hora2,3,2);
	
	if($H2<$H1)
		return false;
	else if($H1==$H2 && $M2<$M1)
		return false;
	else
		return true;
}
//----------------------------------------------------------------------------------------- 
	static function ObtenerTituloModulo($conexion,$string,$separador)	{

		if($string=="")
			$string=$_SERVER['PHP_SELF'];
			
		// se busca el último separador en la cadena		
		$posicion=strrpos($string,$separador);
		
		if($posicion === false)
			return "";
			
		$archivonom=substr($string,$posicion+1);
		
		// se busca el codigo del archivo que se está ejecutando
		// sólo si existe un único código
		$spnombre="sel_archivos_xcampovariable";
		$spparam=array("pnombrecampo"=>"archivonom");			
		$spparam+=array("pvalorcampo"=>$archivonom);
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$queryarchivo,$numfilas,$errorcod))
		{			
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en selección archivos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return "";
		}	
			
		if($numfilas!=1)
			return "";
		
		$filaarchivo = mysqli_fetch_assoc($queryarchivo);
		
		// se busca la descripción del módulo que comienza
		// ejecutando ese archivo, sólo si existe un único módulo
		
		$spnombre="sel_modulos_xcampovariable";
		$spparam =array("pnombrecampo"=>"archivocod");			
		$spparam+=array("pvalorcampo"=>$filaarchivo['archivocod']);
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$querymodulo,$numfilas,$errorcod))
		{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error en selección módulos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return "";
		}	
			
		if($numfilas!=1)
			return "";
		
		$filamodulo = mysqli_fetch_assoc($querymodulo);
		
		return $filamodulo['modulodesc'];
			
	}
