<?php
class cComisionPersonaCandidato{
	var $conexion;
	public function __construct($conexion) {
		$this->conexion = &$conexion;
	}
	
	//comentario
//-----------------------------------------------------------------------------------------
//*******************************************************************************//
//*********************************-TRAER_DATOS-*********************************//
//*******************************************************************************//
//-----------------------------------------------------------------------------------------
	function TraerDatosInscripcion($ArregloDatos,&$resultado,&$numfilas){

		$sparam=array('pxcomi_codigo'=>0);
		$sparam+=array('pxpers_cuilt'=>0);
		$sparam+=array('pxpers_codigo'=>0);
		$sparam+=array('pxcpc_estado'=>0);
		$sparam+=array('pxcpc_estado2'=>0);
		$sparam+=array('pxjurisdid_inap'=>0);
		$sparam+=array('pxjurisdid_inap2'=>0);

		$sparam+=array('pcomi_codigo'=>"");
		$sparam+=array('ppers_cuilt'=>"");
		$sparam+=array('ppers_codigo'=>"");
		$sparam+=array('pcpc_estado'=>"");
		$sparam+=array('pcpc_estado2'=>"");
		$sparam+=array('pjurisdid_inap'=>"");
		$sparam+=array('pjurisdid_inap2'=>"");

		$sparam+=array('porderby'=>"pers_apellido");



		if (isset ($ArregloDatos['comi_codigo']))
		{
			if ($ArregloDatos['comi_codigo']!="")
			{
				$sparam['pcomi_codigo']= $ArregloDatos['comi_codigo'];
				$sparam['pxcomi_codigo']= 1;
			}
		}

		if (isset ($ArregloDatos['pers_cuilt']))
		{
			if ($ArregloDatos['pers_cuilt']!="")
			{
				$sparam['ppers_cuilt']= $ArregloDatos['pers_cuilt'];
				$sparam['pxpers_cuilt']= 1;
			}
		}

		if (isset ($ArregloDatos['pers_codigo']))
		{
			if ($ArregloDatos['pers_codigo']!="")
			{
				$sparam['ppers_codigo']= $ArregloDatos['pers_codigo'];
				$sparam['pxpers_codigo']= 1;
			}
		}

		if (isset ($ArregloDatos['cpc_estado']))
		{
			if ($ArregloDatos['cpc_estado']!="")
			{
				$sparam['pcpc_estado']= $ArregloDatos['cpc_estado'];
				$sparam['pxcpc_estado']= 1;
			}
		}

		if (isset ($ArregloDatos['cpc_estado2']))
		{
			if ($ArregloDatos['cpc_estado2']!="")
			{
				$sparam['pcpc_estado2']= $ArregloDatos['cpc_estado2'];
				$sparam['pxcpc_estado2']= 1;
			}
		}

		if (isset ($ArregloDatos['jurisdid_inap']))
		{
			if ($ArregloDatos['jurisdid_inap']!="")
			{
				$sparam['pjurisdid_inap']= $ArregloDatos['jurisdid_inap'];
				$sparam['pxjurisdid_inap']= 1;
			}
		}

		if (isset ($ArregloDatos['jurisdid_inap2']))
		{
			if ($ArregloDatos['jurisdid_inap2']!="")
			{
				$sparam['pjurisdid_inap2']= $ArregloDatos['jurisdid_inap2'];
				$sparam['pxjurisdid_inap2']= 1;
			}
		}


		if (isset ($ArregloDatos['orderby'])) {
			if ($ArregloDatos['orderby']!="") 	{
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}

		$spnombre="sel_comision_persona_candidato_xcomi_codigo_xpers_cuilt_xpers_codigo";

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno)) {
			$errormail="";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}


		return true;
	}





//-----------------------------------------------------------------------------------------
	function TraerDatosInscripcionResumen($ArregloDatos,&$resultado,&$numfilas){

		$sparam=array('pxcpc_estado'=>0);
		$sparam+=array('pxcpc_estado2'=>0);
		$sparam+=array('pxjurisdid_inap'=>0);
		$sparam+=array('pxjurisdid_inap2'=>0);

		$sparam+=array('pcpc_estado'=>"");
		$sparam+=array('pcpc_estado2'=>"");
		$sparam+=array('pjurisdid_inap'=>"");
		$sparam+=array('pjurisdid_inap2'=>"");
		
		



		if (isset ($ArregloDatos['cpc_estado']))
		{
			if ($ArregloDatos['cpc_estado']!="")
			{
				$sparam['pcpc_estado']= $ArregloDatos['cpc_estado'];
				$sparam['pxcpc_estado']= 1;
			}
		}

		if (isset ($ArregloDatos['cpc_estado2']))
		{
			if ($ArregloDatos['cpc_estado2']!="")
			{
				$sparam['pcpc_estado2']= $ArregloDatos['cpc_estado2'];
				$sparam['pxcpc_estado2']= 1;
			}
		}


		if (isset ($ArregloDatos['jurisdid_inap']))
		{
			if ($ArregloDatos['jurisdid_inap']!="")
			{
				$sparam['pjurisdid_inap']= $ArregloDatos['jurisdid_inap'];
				$sparam['pxjurisdid_inap']= 1;
			}
		}

		if (isset ($ArregloDatos['jurisdid_inap2']))
		{
			if ($ArregloDatos['jurisdid_inap2']!="")
			{
				$sparam['pjurisdid_inap2']= $ArregloDatos['jurisdid_inap2'];
				$sparam['pxjurisdid_inap2']= 1;
			}
		}

		$spnombre="sel_comision_persona_resumen";

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno)) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}


		return true;
	}


//-----------------------------------------------------------------------------------------
//*******************************************************************************//
//*********************************-INSERTAR_INSCRIPCION-************************//
//*******************************************************************************//
//-----------------------------------------------------------------------------------------
function AltaDatosInscripcionWebConfirmacion($datos,&$resultado,&$numfilas) {


		if($datos["orgapub_codigo"]=="" || $datos["orgapub_codigo"]=="0")
			$datos["orgapub_codigo"]= "NULL";

		if($datos["agfunc_codigo"]=="")
			$datos["agfunc_codigo"]= "NULL";

		if($datos["jurisdid_apn"]=="" || $datos["jurisdid_apn"]=="0")
			$datos["jurisdid_apn"]= "NULL";

	if(!isset($datosvalidados["pers_codigo"]))
			$datos["pers_codigo"]= "NULL";


		$spnombre="ins_comision_persona_candidato";
		$spparam=array(
			'pcomi_codigo'=> $datos["comi_codigo"],
			'ppers_codigo'=> $datos["pers_codigo"],
			'ppers_cuilt'=> $datos["pers_cuilt"],
			'ppers_nombre'=> $datos["pers_nombre"],
			'ppers_apellido'=> $datos["pers_apellido"],
			'ppers_sexo'=> $datos["pers_sexo"],
			'ppers_fechanac'=> $datos["pers_fechanac"],
			'ppers_email'=> $datos["pers_email"],
			'pescalafcod'=> $datos["escalafcod"],
			'pagrupcod'=> $datos["agrupcod"],
			'pescalafnivcod'=> $datos["escalafnivcod"],
			'pescalaftramocod'=> $datos["escalaftramocod"],
			'pescalafgradocod'=> $datos["escalafgradocod"],
			'pagfunc_codigo'=> $datos["agfunc_codigo"],
			'pjurisdid_inap'=> $datos["jurisdid_inap"],
			'pjurisdid_apn'=> $datos["jurisdid_apn"],
			'porgapub_codigo'=> $datos["orgapub_codigo"],
			'pnivest_codigo'=>$datos["nivest_codigo"] ,
			'pagentes_a_cargo'=>$datos["agentes_a_cargo"] ,
			'ppaiscod_revista'=>$datos["paiscod_revista"] ,
			'pprovinciacod_revista'=>$datos["provinciacod_revista"] ,
			'ptareas'=>$datos["tareas"] ,
			'pcambio_datos'=> $datos["cambio_datos"],
			'pcarr_codigo'=> $datos["carr_codigo"],
			'pcpc_estado'=> $datos["cpc_estado"],
			'pultmodusuario'=> $_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);

			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la inscripción 2.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

		return true;

}

//-----------------------------------------------------------------------------------------//
function AltaDatosInscripcionWeb($datos,&$resultado,&$numfilas) {


	if(!$this->_DatosValidosAltaInscripcionWeb($datos,$datosvalidados))
			return false;

	if(!isset($datosvalidados["pers_codigo"]))
			$datosvalidados["pers_codigo"]= "NULL";

	$datosvalidados["tareas"]=htmlspecialchars($datos["tareas"], ENT_QUOTES);


		$spnombre="ins_comision_persona_candidato";
		$spparam=array(
			'pcomi_codigo'=> $datosvalidados["comi_codigo"],
			'ppers_codigo'=> $datosvalidados["pers_codigo"],
			'ppers_cuilt'=> $datosvalidados["pers_cuilt"],
			'ppers_nombre'=> $datosvalidados["pers_nombre"],
			'ppers_apellido'=> $datosvalidados["pers_apellido"],
			'ppers_sexo'=> $datosvalidados["pers_sexo"],
			'ppers_email'=> $datosvalidados["pers_email"],
			'pescalafcod'=> $datosvalidados["escalafcod"],
			'pagrupcod'=> $datosvalidados["agrupcod"],
			'pescalafnivcod'=> $datosvalidados["escalafnivcod"],
			'pescalaftramocod'=> $datos["escalaftramocod"],			
			'pescalafgradocod'=> $datosvalidados["escalafgradocod"],
			'pagfunc_codigo'=> $datosvalidados["agfunc_codigo"],
			'pjurisdid_inap'=> $datosvalidados["jurisdid_inap"],
			'pjurisdid_apn'=> $datosvalidados["jurisdid_apn"],
			'porgapub_codigo'=> $datosvalidados["orgapub_codigo"],
			'pnivest_codigo'=>$datosvalidados["nivest_codigo"] ,
			'pagentes_a_cargo'=>$datosvalidados["agentes_a_cargo"] ,
			'ppaiscod_revista'=>$datosvalidados["paiscod_revista"] ,
			'pprovinciacod_revista'=>$datosvalidados["provinciacod_revista"] ,
			'ptareas'=>$datosvalidados["tareas"] ,
			'pcpc_estado'=> CANDIDATO_SIN_EVALUAR,
			'pultmodusuario'=> $_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);

  		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la inscripción1.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}

//-----------------------------------------------------------------------------------------//

function  AltaDatosComisionInscribirCandidato ($datos) {

		$oActividad = new cActividad($this->conexion);
		$oPersonas = new cPersonas($this->conexion);
		$oComisionPersona = new cComisionPersona($this->conexion);

		if ($oComisionPersona->TraerDatosComision($datos['comi_codigo'],$fila_comision,$es_modif)) {
			if (!$es_modif) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error no se ha encontrado la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		}

		if ($oActividad->TraerDatosActividad($fila_comision['act_codigo'],$fila_actividad,$es_modif)) {
			if (!$es_modif) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error no se ha encontrado la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		}



		// recoro el post para buscar los chk
		foreach ($datos as $clave=>$valor) {

				if (substr($clave,0,3)=="chk")  {

					$pers_cuilt = $valor;
					// verifico que sea persona nueva
					$ArregloDatos=array(
										"comi_codigo"=>$datos['comi_codigo'],
										"pers_cuilt"=>$pers_cuilt
					);

					if(!$this->TraerDatosInscripcion($ArregloDatos,$result_candidatos,$numfilas_candidatos)) {
							$error="Error al buscar los datos de inscripción.";
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							return false;
					}

					if ($numfilas_candidatos == 1) {
						$fila_candidato = mysqli_fetch_assoc($result_candidatos);
						$fila_candidato["pers_fechanac"] = FuncionesPHPLocal::ConvertirFecha($fila_candidato['pers_fechanac'],'aaaa-mm-dd','dd/mm/aaaa');

					} else
						return false;


					switch ($_SESSION['rolcod']) {

					case COORDINADORTECNICO:
					case USUORGANISMO:
					case USUUNIVERSIDAD:

// echo "<br> sacar mara 1 <br>";
							// es una persona nueva
							if ($fila_candidato['pers_codigo']=="")	{

								// busco si está la persona para modificar los datos o agregarla
								if(!$oPersonas->TraerDatosPersona($fila_candidato["pers_cuilt"],$datospersona,$es_modif_persona)) {
									FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
									return false;
								}

								if ($es_modif_persona) {

									$fila_candidato["pers_codigo"] = $datospersona["pers_codigo"];
									if($oPersonas->ModifDatosPers($fila_candidato)){
										$nuevocodigo=$this->conexion->UltimoCodigoInsertado();

										FuncionesPHPLocal::RegistrarAcceso($this->conexion,"34903","pers_cuilt=".$fila_candidato['pers_cuilt'],$_SESSION['usuariocod']);
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha modificado la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));


									} else {
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										return false;
									}
								}	else {

									if($oPersonas->AltaDatosPers($fila_candidato)){
										$nuevocodigo=$this->conexion->UltimoCodigoInsertado();
										
										FuncionesPHPLocal::RegistrarAcceso($this->conexion,"34901","pers_cuilt=".$fila_candidato['pers_cuilt'],$_SESSION['usuariocod']);
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha dado de Alta la persona con CUIT".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										
										$fila_candidato['pers_codigo']=$nuevocodigo;
/*
echo "<br> sacar mara 2 <br>";
echo "<br> sacar mara - AltaDatosPers <br>  ";
print_r($fila_candidato);
echo "<br> --------------------------- ";
*/
										// borro la persona temporal
										if(!$oPersonas->TraerDatosPersonaTemporal($fila_candidato["pers_cuilt"],$datospersona,$es_modif_persona_temporal)) {
											FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
											return false;
										}

										if(!$oPersonas->BorrarDatosPersTemporal($datospersona['pers_codigo'])){
											FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la persona temporal con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
											return false;
										}


									} else {
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al dar de Alta la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										return false;
									}

								}


							}

// echo "<br> sacar mara 3 <br>";

							$oActividadCurso = new cActividadCurso($this->conexion); 
							if ($oActividadCurso->TieneFormatoTipo($fila_comision['act_codigo'],FORMATOCURSO,TIPOACTCURSOINAP,$tiene_formato_tipo)) {
								if ($tiene_formato_tipo) { 
									// paso el candidato a INAP (candidato APROBADO)
									$ArregloDatos=array(
														"comi_codigo"=>$datos['comi_codigo'],
														"pers_cuilt"=>$pers_cuilt,
														"cpc_estado"=>CANDIDATO_APROBADO
		
									);
		
									if(!$this->CambiarEstadoInscripcionWeb($ArregloDatos,$result,$numfilas)) {
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar el candidato de la Comisión".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										return false;
									}
		
									FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha aprobado la preinscripci&oacute;n. <br> El usuario de INAP deber&aacute; confirmar la Inscripci&oacute;n.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								}
							}
							
/*
echo "<br> sacar mara 4 <br>";							
*/
							if ($oActividadCurso->TieneFormatoTipo($fila_comision['act_codigo'],FORMATOCURSO,TIPOACTCURSOJURISD,$tiene_formato_tipo_jur)) {
									
								if ($tiene_formato_tipo_jur) { 
									// agrego la persona a la comisión
		
		
									if ($fila_candidato["escalafcod"] =="")
										$fila_candidato['tipo_individual_con_org'] = NO;
									else {
										$fila_candidato['tipo_individual_con_org'] = SI;
		
										if (isset($fila_candidato['jurisdid_coordinacion']))
											$fila_candidato['jurisdid_inap'] = $fila_candidato['jurisdid_coordinacion'];
		
										if (isset($fila_candidato['jurisdid_inap']))
											$fila_candidato['jurisdid_coordinacion'] = $fila_candidato['jurisdid_inap'];
									}
		
									$fila_candidato['esc_agrup_niv_grado'] = $fila_candidato["escalafcod"]."_".$fila_candidato["agrupcod"]."_".$fila_candidato["escalafnivcod"]."_".$fila_candidato["escalaftramocod"]."_".$fila_candidato["escalafgradocod"];
		
									if (isset($fila_candidato['jurisdid_apn'])) {
										$fila_candidato['tipoorg_codigo'] = ORGANISMO_APN;
										$fila_candidato['jurisdid'] = $fila_candidato['jurisdid_apn'];
									}
									elseif (isset($fila_candidato['orgapub_codigo'])) {
										$fila_candidato['tipoorg_codigo'] = ORGANISMO_NO_APN;
										$fila_candidato['jurisdid'] = $fila_candidato['orgapub_codigo'];
									}
/*
echo "<br> sacar mara <br>";
$fila_candidato['es_web']='si';
print_r($fila_candidato);
echo "<br> --------------------------- ";	
*/	

									if($oComisionPersona->AltaDatosComisionInscribirAlumnos($fila_candidato)) {								
										FuncionesPHPLocal::RegistrarAcceso($this->conexion,"50401","pers_codigo=".$fila_candidato['pers_codigo']." - comi_codigo=".$datos['comi_codigo'],$_SESSION['usuariocod']);
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha agregado la persona a la comisi&oacute;n.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
									} else {
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al agregar la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										return false;
									}
		
		
									// borro el candidato
									$ArregloDatos=array(
														"comi_codigo"=>$datos['comi_codigo'],
														"pers_cuilt"=>$pers_cuilt
									);
		
									if(!$this->EliminarDatosInscripcionWeb($ArregloDatos,$result,$numfilas)) {
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar el candidato de la Comisión".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										return false;
									}	
									
									$mensaje = " At.: ".$fila_candidato["pers_nombre"]." ".$fila_candidato["pers_apellido"]."\n\n La jurisdicción ha confirmado su inscripción para la siguiente actividad :\n";
									$mensaje .= " Actividad:   ".$fila_actividad['act_nombre']."\n";
									$mensaje .= " Código INAP:   ".$fila_actividad['act_codinap']."\n";	;
									$mensaje .= " Comisión:   ".$fila_comision['comi_codinap']."\n";	;
									$mensaje .=  $fila_candidato["pers_cuilt"]." ".$fila_candidato["pers_nombre"]." ".$fila_candidato["pers_apellido"]." (".$fila_candidato["pers_email"].")\n";
									$asunto = "Confirmación de Inscripción en Actividad";
		
									// Agrego cabeceras al mail
									$cabeceras = "Content-type: text/plain; charset=utf-8\r\n";
									$cabeceras .= "From: ".MAIL_SISTEMA_FROM;
		
									if(mail($fila_candidato['pers_email'],$asunto,$mensaje,$cabeceras))
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha enviado un correo electr&oacute;nico al agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
									else {
										FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Imposible enviar el mail al inscripto con CUIL:".$fila_candidato["pers_cuilt"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										return false;
									}									
								
								}
							
							}
					
							

							break;

					case USUCURSOINAP :

							if(!$oPersonas->TraerDatosPersona($fila_candidato["pers_cuilt"],$datospersona,$es_modif)) {
								FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;
							}

							if ($es_modif) {
								$fila_candidato['pers_codigo'] = $datospersona['pers_codigo'];

							} else {

									$fila_candidato["jurisdid_coordinacion"] = $fila_candidato["jurisdid_inap"];

									if($oPersonas->AltaDatosPers($fila_candidato)){
										$nuevocodigo=$this->conexion->UltimoCodigoInsertado();
										$fila_candidato['pers_codigo'] = $nuevocodigo;
										FuncionesPHPLocal::RegistrarAcceso($this->conexion,"34901","pers_cuilt=".$fila_candidato['pers_cuilt'],$_SESSION['usuariocod']);
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha dado de Alta la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

										// borro la persona temporal
										if(!$oPersonas->TraerDatosPersonaTemporal($fila_candidato["pers_cuilt"],$datospersona,$es_modif_persona_temporal)) {
											FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
											return false;
										}

										if(!$oPersonas->BorrarDatosPersTemporal($datospersona['pers_codigo'])){
											FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la persona temporal con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
											return false;
										}


									} else {
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al dar de Alta la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										return false;
									}

							}

							// agrego la persona a la comisión


							if ($fila_candidato["escalafcod"] =="")
								$fila_candidato['tipo_individual_con_org'] = NO;
							else {
								$fila_candidato['tipo_individual_con_org'] = SI;

								if (isset($fila_candidato['jurisdid_coordinacion']))
									$fila_candidato['jurisdid_inap'] = $fila_candidato['jurisdid_coordinacion'];

								if (isset($fila_candidato['jurisdid_inap']))
									$fila_candidato['jurisdid_coordinacion'] = $fila_candidato['jurisdid_inap'];
							}



							$fila_candidato['esc_agrup_niv_grado'] = $fila_candidato["escalafcod"]."_".$fila_candidato["agrupcod"]."_".$fila_candidato["escalafnivcod"]."_".$fila_candidato["escalaftramocod"]."_".$fila_candidato["escalafgradocod"];

							if (isset($fila_candidato['jurisdid_apn'])) {
								$fila_candidato['tipoorg_codigo'] = ORGANISMO_APN;
								$fila_candidato['jurisdid'] = $fila_candidato['jurisdid_apn'];
							}
							elseif (isset($fila_candidato['orgapub_codigo'])) {
								$fila_candidato['tipoorg_codigo'] = ORGANISMO_NO_APN;
								$fila_candidato['jurisdid'] = $fila_candidato['orgapub_codigo'];
							}

							if($oComisionPersona->AltaDatosComisionInscribirAlumnos($fila_candidato)) {
								FuncionesPHPLocal::RegistrarAcceso($this->conexion,"50401","pers_codigo=".$fila_candidato['pers_codigo']." - comi_codigo=".$datos['comi_codigo'],$_SESSION['usuariocod']);
								FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha agregado la persona a la comisi&oacute;n.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
							} else {
								FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al agregar la persona con CUIT ".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;
							}


							// borro el candidato
							$ArregloDatos=array(
												"comi_codigo"=>$datos['comi_codigo'],
												"pers_cuilt"=>$pers_cuilt
							);

							if(!$this->EliminarDatosInscripcionWeb($ArregloDatos,$result,$numfilas)) {
								FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar el candidato de la Comisión".$fila_candidato['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								return false;
							}

							// lo agrego al mail
							if ($fila_candidato['jurisdid_inap'] != 0) {

								// lo mando al Coordinador Técnico
								$mensaje = " Sr. Coordinador Técnico de Capacitación: \n\nEl Usuario de Cursos INAP ha confirmado la inscripción del siguiente agente:\n";
								$mensaje .= " Actividad:   ".$fila_actividad['act_nombre']."\n";
								$mensaje .= " Código INAP:   ".$fila_actividad['act_codinap']."\n";	;
								$mensaje .= " Comisión:   ".$fila_comision['comi_codinap']."\n";	;
								$mensaje .= " Fecha de Inicio :   ".FuncionesPHPLocal::ConvertirFecha($fila_comision['comi_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa')."\n";	;
								$mensaje .= " Fecha de Finalización :   ".FuncionesPHPLocal::ConvertirFecha($fila_comision['comi_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa')."\n";	;
								$fila_comision['comi_codinap']."\n";	;
								$mensaje .= " Agente: ".$fila_candidato["pers_cuilt"]." ".$fila_candidato["pers_nombre"]." ".$fila_candidato["pers_apellido"]." (".$fila_candidato["pers_email"].")\n";
								$asunto = "SAI - Confirmación de Inscripción";

								//$mensaje = utf8_decode($mensaje);
								//$asunto = utf8_decode($asunto);
								if (FuncionesPHPLocal::MandarMail($this->conexion,COORDINADORTECNICO,$fila_candidato['jurisdid_inap'],$asunto,$mensaje)) {
									FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha enviado un correo electr&oacute;nico al Coordinador Técnico de Capacitaci&oacute;n.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								} else {
									FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El correo electr&oacute;nico no fue enviado,<br> notifique al Coordinador T&eacute;cnico de Capacitaci&oacute;n por otra v&iacute;a.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								}

								// lo mando al Usuario de Organismo
								$mensaje = " Sr. Usuario de Organismo: \n\nEl Usuario de Cursos INAP ha confirmado la inscripción del siguiente agente:\n";
								$mensaje .= " Actividad:   ".$fila_actividad['act_nombre']."\n";
								$mensaje .= " Código INAP:   ".$fila_actividad['act_codinap']."\n";	;
								$mensaje .= " Comisión:   ".$fila_comision['comi_codinap']."\n";	;
								$mensaje .= " Fecha de Inicio :   ".FuncionesPHPLocal::ConvertirFecha($fila_comision['comi_fecha_inicio'],'aaaa-mm-dd','dd/mm/aaaa')."\n";	;
								$mensaje .= " Fecha de Finalización :   ".FuncionesPHPLocal::ConvertirFecha($fila_comision['comi_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa')."\n";	;
								$mensaje .= " Agente: ".$fila_candidato["pers_cuilt"]." ".$fila_candidato["pers_nombre"]." ".$fila_candidato["pers_apellido"]." (".$fila_candidato["pers_email"].")\n";

								if (FuncionesPHPLocal::MandarMail($this->conexion,USUORGANISMO,$fila_candidato['jurisdid_inap'],$asunto,$mensaje)) {
									FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha enviado un correo electr&oacute;nico al Usuario de Organismo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								} else {
									FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"El correo electr&oacute;nico no fue enviado,<br> notifique al Usuario de Organismo por otra v&iacute;a.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
								}
								
							} else {
								
									// la persona no tiene organismo de coordinación
									$mensaje = " At.: ".$fila_candidato["pers_nombre"]." ".$fila_candidato["pers_apellido"]."\n\n El INAP ha confirmado su inscripción para la siguiente actividad :\n";
									$mensaje .= " Actividad:   ".$fila_actividad['act_nombre']."\n";
									$mensaje .= " Código INAP:   ".$fila_actividad['act_codinap']."\n";	;
									$mensaje .= " Comisión:   ".$fila_comision['comi_codinap']."\n";	;
									$mensaje .=  $fila_candidato["pers_cuilt"]." ".$fila_candidato["pers_nombre"]." ".$fila_candidato["pers_apellido"]." (".$fila_candidato["pers_email"].")\n";
									$asunto = "Confirmación de Inscripción en Actividad";
		
									// Agrego cabeceras al mail
									$cabeceras = "Content-type: text/plain; charset=utf-8\r\n";
									$cabeceras .= "From: ".MAIL_SISTEMA_FROM;
		
									if(mail($fila_candidato['pers_email'],$asunto,$mensaje,$cabeceras))
										FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_OK,"Se ha enviado un correo electr&oacute;nico al agente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
									else {
										FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Imposible enviar el mail al inscripto con CUIL:".$fila_candidato["pers_cuilt"],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
										return false;
									}							
							}
							break;
							
					}
					






				} // if (substr($clave,0,3)=="chk")
				
		} //foreach



		return true;
	}

//-----------------------------------------------------------------------------------------//
function ModifDatosInscripcionWeb($datos) {


	$datos["jurislaboral"]= $datos["jurisdid"];


	if(!$this->_DatosValidosModifInscripcionWeb($datos,$datosvalidados))
			return false;

	if(!isset($datosvalidados["pers_codigo"]))
			$datosvalidados["pers_codigo"]= "NULL";



		$spnombre="upd_comision_persona_candidato_xcomi_codigo_pers_codigo";
		$spparam=array(
			'pcomi_codigo'=> $datosvalidados["comi_codigo"],
			'pcomi_codigo'=> $datosvalidados["comi_codigo"],
			'ppers_cuilt'=> $datosvalidados["pers_cuilt"],
			'ppers_nombre'=> $datosvalidados["pers_nombre"],
			'ppers_apellido'=> $datosvalidados["pers_apellido"],
			'ppers_sexo'=> $datosvalidados["pers_sexo"],
			'ppers_fechanac'=> $datosvalidados["pers_fechanac"],
			'ppers_email'=> $datosvalidados["pers_email"],
			'pnivest_codigo'=>$datosvalidados["nivest_codigo"] ,
			'pagentes_a_cargo'=>$datosvalidados["agentes_a_cargo"] ,
			'ppaiscod_revista'=>$datosvalidados["paiscod_revista"] ,
			'pprovinciacod_revista'=>$datosvalidados["provinciacod_revista"] ,
			'pescalafcod'=> $datosvalidados["escalafcod"],
			'pagrupcod'=> $datosvalidados["agrupcod"],
			'pescalafnivcod'=> $datosvalidados["escalafnivcod"],
			'pescalaftramocod'=> $datosvalidados["escalaftramocod"],
			'pescalafgradocod'=> $datosvalidados["escalafgradocod"],
			'pagfunc_codigo'=> $datosvalidados["agfunc_codigo"],
			'pjurisdid_inap'=> $datosvalidados["jurisdid_inap"],
			'pjurisdid_apn'=> $datosvalidados["jurisdid_apn"],
			'porgapub_codigo'=> $datosvalidados["orgapub_codigo"],
			'pultmodusuario'=> $_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);

  		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la inscripción.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		return false;
		}

		return true;
	}

//-----------------------------------------------------------------------------------------
//*******************************************************************************//
//*********************************-ELIMINAR_INSCRIPCION-************************//
//*******************************************************************************//
//-----------------------------------------------------------------------------------------


	function EliminarDatosInscripcionWeb($datos,&$resultado,&$numfilas) {

		$spnombre="del_comision_persona_candidato_xcomi_codigo_xpers_cuilt";
		$spparam=array(
			'pcomi_codigo'=>$datos["comi_codigo"] ,
			'ppers_cuilt'=> $datos["pers_cuilt"]
			);

			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al Eliminar la inscripción.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}

	function EliminarDatosInscripcionWebdeComision($datos,&$resultado,&$numfilas) {

		$spnombre="del_comision_persona_candidato_xcomi_codigo";
		$spparam=array(
			'pcomi_codigo'=>$datos["comi_codigo"]

			);
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al Eliminar todos los candidatos de la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}

	function CambiarEstadoInscripcionWeb($datos,&$resultado,&$numfilas) {

		$spnombre="upd_comision_persona_candidato_estado_xcomi_codigo_xpers_cuilt";
		$spparam=array(
			'pcomi_codigo'=>$datos["comi_codigo"] ,
			'ppers_cuilt'=> $datos["pers_cuilt"],
			'pcpc_estado'=> $datos["cpc_estado"]
			);

			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al Aprobar la inscripción.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		return true;
	}

//-----------------------------------------------------------------------------------------------------
	function DescargarExcel($ArregloDatos) {

		$oActividad = new cActividad($this->conexion);
		$cComision = new cComision($this->conexion);


			if(!$this->TraerDatosInscripcion($ArregloDatos,$result_candidatos,$numfilas_candidatos)) {
				$error="Error al buscar los datos de inscripción.";
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}


			if ($cComision->TraerDatosComision($ArregloDatos['comi_codigo'],$filacomision,$es_modif)) {
				if (!$es_modif) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				} // Tiene permiso el usuario sobre la comision
			} else
				return false;



		$personas_asignadas=array();

		while ($fila_asignacion = mysqli_fetch_assoc($result_candidatos)) {

			// nivel de estudios
			$nivest_descricpcion = "--";
			if ($fila_asignacion['nivest_codigo'] != "0")
				$this->conexion->TraerCampo("nivel_estudios","nivest_descricpcion",array("nivest_codigo='",$fila_asignacion['nivest_codigo'],"'"),$nivest_descricpcion,$numfilas,$errorcod);

			$fila_asignacion['nivest_descricpcion'] =  $nivest_descricpcion;

			$fila_asignacion['agentes_a_cargo']=htmlspecialchars($fila_asignacion['agentes_a_cargo'],ENT_QUOTES);

			// Lugar de Revista
			$pais_descipcion	= "--";

			if ($fila_asignacion['paiscod_revista'] != "0")  {
				$this->conexion->TraerCampo("paises","paisnom",array("paiscod='",$fila_asignacion['paiscod_revista'],"'"),$pais_descipcion,$numfilas,$errorcod);

				if ($fila_asignacion['paiscod_revista'] == ARGENTINA) {
					$this->conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$fila_asignacion['provinciacod_revista'],"'"),$provincia_descipcion,$numfilas,$errorcod);
					$pais_descipcion .= ", ".$provincia_descipcion;
				}

			}
			$fila_asignacion['pais_revista'] =  $pais_descipcion;


			// escalafón
			$escalafon = "--";
			if (!$this->conexion->TraerCampo("escalafones","escalafnom",array("escalafcod='",$fila_asignacion['escalafcod'],"'"),$escalafon,$numfilas,$errorcod))
				return false;
			$fila_asignacion['escalafon'] = $escalafon;

			// nivel
			$escalafonnivel = "--";
			if (!$this->conexion->TraerCampo("escalafones_niveles","escalafnivdesc",array("escalafnivcod='",$fila_asignacion['escalafnivcod'],"'"),$escalafonnivel,$numfilas,$errorcod))
				return false;
			$fila_asignacion['escalafonnivel'] = $escalafonnivel;

			// tramo
			$escalafontramo = "--";
			if (!$this->conexion->TraerCampo("escalafones_tramos","escalaftramodesc",array("escalaftramocod='",$fila_asignacion['escalaftramocod'],"'"),$escalafontramo,$numfilas,$errorcod))
				return false;
			$fila_asignacion['escalafontramo'] = $escalafontramo;

			// grado
			$escalafongrado = "--";
			if (!$this->conexion->TraerCampo("escalafones_grados","escalafgradodesc",array("escalafgradocod='",$fila_asignacion['escalafgradocod'],"'"),$escalafongrado,$numfilas,$errorcod))
				return false;
			$fila_asignacion['escalafongrado'] = $escalafongrado;


			// organismo de coordinacion
			$jurisdnom = "--";
			$jurisdemail = "--";
			if ($fila_asignacion['jurisdid_inap'] != "") {
				$this->conexion->TraerCampo("jurisdiccion_inap","jurisdnom",array("jurisdid='",$fila_asignacion['jurisdid_inap'],"'"),$jurisdnom,$numfilas,$errorcod);

				$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>COORDINADORTECNICO,'pjurisdid_inap'=>$fila_asignacion['jurisdid_inap']);

				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
					return false;

				while($fila=mysqli_fetch_assoc($resultado))
					$jurisdemail=$fila['usuarioemail'];


			}
			$fila_asignacion['jurisdnom'] = $jurisdnom;
			$fila_asignacion['jurisdemail'] = $jurisdemail;

			// organismo donde trabaja
			$jurisdnom_trabajo = "--";
			if (isset($fila_asignacion['jurisdid_apn']) || isset($fila_asignacion['orgapub_codigo']))
				$oActividad->ObtenerOrganismoInstitucion(NULL,$fila_asignacion['jurisdid_apn'],$fila_asignacion['orgapub_codigo'],$jurisdnom_trabajo,$sector_org,$tipoorg_codigo,$campo_jurisdid, true, false);

			$fila_asignacion['jurisdnom_trabajo'] = $jurisdnom_trabajo;

			// función
			$descri_funcion = "--";
			if (isset($fila_asignacion['agfunc_codigo']))
				if (!$this->conexion->TraerCampo("agente_funcion","agfunc_descripcion",array("agfunc_codigo='",$fila_asignacion['agfunc_codigo'],"'"),$descri_funcion,$numfilas,$errorcod))
					return false;
			$fila_asignacion['agfunc_descripcion'] = $descri_funcion;

			// tareas

			$fila_asignacion['tareas'] = htmlspecialchars  ($fila_asignacion['tareas']);

			$personas_asignadas[]=$fila_asignacion;
		} // while $fila_asignacion = mysql_fetch_assoc($resultPersonas)

		if (count($personas_asignadas >0)) {

			$nombrearchivo="comision_inscripcion_web.xls";

			$oExcel= new cEscribirExcel($nombrearchivo);
			$oExcel->AddHoja('candidatos');
			$oExcel->EsconderGrillas();
			$oExcel->PaginaHorizontal();

			$arrayclaves = array (	//'act_codinap',
									//'act_nombre',
									//'tipoact_descripcion',
									//'comi_codinap','fecha_desde','fecha_hasta',
									//'dic_fecha','dic_estado_descripcion',
									'pers_cuilt','pers_apellido','pers_nombre','pers_fechanac', 'pers_email', 'nivest_descricpcion', 'agentes_a_cargo', 'pais_revista',
									'escalafon','escalafonnivel','escalafontramo','escalafongrado','jurisdnom','jurisdemail','jurisdnom_trabajo',
									'agfunc_descripcion', 'tareas'
									//'evaluacion','actcur_creditos'
									);


			// Ancho de cada columna, las claves tienen que coincidir con arrayclaves
			$ancho_columna = array (//'act_codinap'=>15,
									//'act_nombre'=>50,
									//'tipoact_descripcion'=>20,
									//'comi_codinap'=>15,
									//'fecha_desde'=>10,'fecha_hasta'=>10,
									//'dic_fecha'=>10, 'dic_estado_descripcion'=>10,
									'pers_cuilt'=>15,'pers_apellido'=>30,
									'pers_nombre'=>30,'pers_fechanac'=>10, 'pers_email'=>40,
									'nivest_descricpcion'=>40, 'agentes_a_cargo'=>10, 'pais_revista'=>40,
									'escalafon'=>20,
									'escalafonnivel'=>10,'escalafontramo'=>10,'escalafongrado'=>10,'jurisdnom'=>40, 'jurisdemail'=>40,
									'jurisdnom_trabajo'=>40,'agfunc_descripcion'=>30,'tareas'=>30
									//'evaluacion'=>30,'actcur_creditos'=>10
									);

			$titulos_columna = array (//'Código de Actividad','Actividad',
										//'Tipo Actividad',
									//'Código de Comisión','Fecha Desde','Fecha Hasta',
									//'Fecha Dictamen', 'Estado Dictamen',
									'Cuit/Cuil','Apellido','Nombre','Fecha Nacimiento', 'Email', 'Nivel de educación', 'Agentes a cargo', 'Lugar de revista',
									'Escalafón','Nivel', 'Tramo',
									'Grado','Organismo del Coordinador Técnico de Capacitación','Email del Coordinador Técnico de Capacitación', 'Organismo donde Trabaja',
									'Función', 'Breve descripción de tareas relacionadas con el puesto'
									//'Evaluación','Créditos'
									);

			//$oExcel->CargarDatosVariasCeldas (0,0,0,1,$ArregloDatos["leyenda"],true);
			$oExcel->CargarDatosVariasCeldas (1,0,1,2,$ArregloDatos["leyenda"],true);
			$oExcel->CargarDatosVariasCeldas (2,0,2,2,"Código de Comisión: ".$filacomision["comi_codinap"],true);
			$oExcel->CargarDatosVariasCeldas (3,0,3,2,"Fecha de Realización de Comisión: ".$filacomision["comi_fecha_inicio_ddmmaaaa"]." al ".$filacomision["comi_fecha_fin_ddmmaaaa"],true);


			// comi_fecha_fin_ddmmaaaa


			for ($i=0; $i<count($arrayclaves); $i++)
				$oExcel->FormatoColumna ($i,$ancho_columna[$arrayclaves[$i]]);

			// Titulos
			// $oExcel->AddFormato ("Align","left");
			// $oExcel->AddFormato ("Border",1);
			// $oExcel->AddFormato ("Font","Times New Roman");
			// $oExcel->AddFormato ("Tamaño",12);
			// $oExcel->AddFormato ("Color","azul");
			// $oExcel->AddFormato ("FgColor",22);
			// $oExcel->CargarDatosVariasCeldas (0,0,0,count($titulos_columna)-1,'Personas inscriptas en la comisión',true);

			// Titulos de las columnas
			$oExcel->AddFormato ("Align","center");
			$oExcel->AddFormato ("TextWrap","");
			$oExcel->AddFormato ("Border",1);
			$oExcel->AddFormato ("Font","Times New Roman");
			$oExcel->AddFormato ("Tamaño",10);
			$oExcel->AddFormato ("VAlign","vcenter");

			$oExcel->AddFormato ("Color","negro");
			$oExcel->AddFormato ("FgColor","gris");

			$formato_celda = array("NumFormat"=>"dd/mm/yyyy");
			$arregloformatos['fecha_desde']=$formato_celda;
			$arregloformatos['fecha_hasta']=$formato_celda;
			$arregloformatos['dic_fecha']=$formato_celda;


		for ($i=0; $i<count($titulos_columna); $i++)
				$oExcel->CargarDatos (5,$i,$titulos_columna[$i],true); // Cambio saco titulo

			$i=6;
			foreach ($personas_asignadas as $datos) {
				$oExcel->CargarGrilla ($datos,$i,0,$arrayclaves,$arregloformatos);
				$i++;
			}
			$oExcel->Enviar();
		}

		return true;
	}


//--------------------------------------------------------------------------------------------------------
function ImprimirFormularioBeca ($nombre, $carrera, $email, $fecha_nac, $estudios, $agentes, $pais, $provincia, $organismo_ccordinador, $escalafon, $organismo_trabajo, $funcion) {

	function GenerarBeca(&$pdf,$nombre, $carrera, $email, $fecha_nac, $estudios, $agentes, $pais, $provincia, $organismo_ccordinador, $escalafon, $organismo_trabajo, $funcion) {

		$pdf->AddBeca();
		$pdf->Set('fecha',date("d/m/Y"));
		$pdf->Set('nombre',$nombre);
		$pdf->Set('beca',utf8_decode($carrera));
		$pdf->Set('email',utf8_decode($email));
		$pdf->Set('fecha_nac',utf8_decode($fecha_nac));
		$pdf->Set('estudios',utf8_decode($estudios));
		$pdf->Set('agentes',utf8_decode($agentes));
		$pdf->Set('pais',utf8_decode($pais));
		$pdf->Set('provincia',utf8_decode($provincia));
		$pdf->Set('organismo_ccordinador',utf8_decode($organismo_ccordinador));
		$pdf->Set('escalafon',utf8_decode($escalafon));
		$pdf->Set('organismo_trabajo',utf8_decode($organismo_trabajo));
		$pdf->Set('funcion',utf8_decode($funcion));


	} // GenerarBeca

	$pdf = new cBecaPDF();
	GenerarBeca($pdf,$nombre, $carrera, $email, $fecha_nac, $estudios, $agentes, $pais, $provincia, $organismo_ccordinador, $escalafon, $organismo_trabajo, $funcion);
	$pdf->MostrarBeca($this->conexion);
	$pdf->Output("formulario_beca.pdf","I");

	return true;
}

