		        </tr>	
		<?php
					foreach ($xml2->actividades_certificadas as $actividad) {
						foreach ($actividad as $datosactividad) {
		?>
						<tr>
							<td style="text-align:left">
								<?php  echo utf8_decode($datosactividad->act_codinap); ?>
							</td>
