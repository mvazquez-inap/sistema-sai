<?php
class cComision {
	var $conexion;
	public function __construct($conexion) {
		$this->conexion = &$conexion;
	}
//-----------------------------------------------------------------------------------------
	function TraerDatosComision($comi_codigo,&$datosresult,&$es_modif){
		
		$datosresult=array();
		$es_modif = false;		
		$sparam=array('pcomi_codigo'=>$comi_codigo);
		$spnombre="sel_comision_xcomi_codigo";	
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno)) {
			$errormail="\ncomi_codigo=".$comi_codigo."\nerror=".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar la comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}
		return true;
	}
