//----------------------------------------------------------------------------------------- 
	static function ArmarQueryString($variable,$querystring="",$elminino_resto=true)	{

		// Cambio!!!
		// Agrego un parametro para que elimine sólo la variable a limpiar y deje
		// el resto tal cual o saque todo lo que viene después.

		// si no se informa $querystring, 
		// se toma el el querystring del server 
		if($querystring=="")
			$querystring=$_SERVER['QUERY_STRING'];
		
		// si existe en el querystring la variable $variable, se elimina
		// para asegurarse que el nombre de la variable es exacto:
		
		// Primero se buscan variables intermedias
		// 1- se agrega a variable un '&' al principio
		// 2- se agrega a variable un '=' al final
		$variablebusq="&".$variable."=";  
		$posicion=strpos($querystring,$variablebusq);
		if($posicion>0) {
			if (!$elminino_resto) 
			    return substr($querystring,0,$posicion).substr($querystring,$posicion+strlen($variablebusq)+2,strlen($querystring));
			else				
				return substr($querystring,0,$posicion);			
		}

		// Si no se encontró, se busca si es la primera variable
		$variablebusq=$variable."=";  
		$posicion=strpos($querystring,$variablebusq);
		if($posicion===false) 
			return $querystring;
		elseif($posicion==0) {
			if (!$elminino_resto)
				return substr($querystring,strlen($variablebusq)+2,strlen($querystring));
			else
				return "";	
		} else 
			return $querystring;
	}	
	
//----------------------------------------------------------------------------------------- 
// Usada para el envio automatico de mails, según rol/jurisdiccion

// Retorna true si no hubo problema, 
//		sino retorna false en caso de error al ejecutar el SP para seleccionar los usuarios,
//		por rol inválido o por error al enviar el mail.

	static function MandarMail($conexion,$rolcod,$jurisdcod,$subject,$texto)
	{
		switch($rolcod)		{
			case ADMIONTI:
				$spnombre="sel_mail_usuarios_con_mail_xrol_xmenorestado";
				$spparam=array('prolcod'=>$rolcod,'pusuarioestado'=>USUARIOACT);		
				break;	
			case USUCURSOINAP:
				$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
				break;			
			case USUACTINS:
				$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
				break;			
			case USUACTJUR:
				$spnombre="sel_usuario_enlace_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>$jurisdcod);			
				break;			
			case COORDINADORTECNICO:
				$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>$jurisdcod);			
				break;			
			case USUORGANISMO:
				$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>$jurisdcod);			
				break;	
			case COORDINADORINAP:
				$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
				break;			
			case USUACTEXT:
				$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
				break;			
			case USUAUTODESARROLLO:
				$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
				$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
				break;			
			default:
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Intento de enviar mail a rol inexistente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
		}
		
		if(!isset($spnombre)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al generar el mail.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
			return false;

	
		if ($numfilas>0) { // hay destinatarios

			// Agrego cabeceras al mail
			$cabeceras = "Content-type: text/plain; charset=utf-8\r\n";
			$cabeceras .= "From: ".MAIL_SISTEMA_FROM;
			$cabeceras .= "\r\nReturn-Path: ".MAIL_SISTEMA_FROM;

			$destinatarios=array();
			while($fila=mysqli_fetch_assoc($resultado))
				$destinatarios[]=$fila['usuarioemail'];
			
			$str_destinatarios=implode(",",$destinatarios);		
			
			if(!mail($str_destinatarios,$subject,$texto,$cabeceras)) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"Imposible enviar el mail.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			
		} else {
		
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No hay destinatarios para notificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
				
		return true;	
	}


//----------------------------------------------------------------------------------------- 
// Graba el mail en la base de datos
// parámetros de entrada
// datos = array

	static function MandarMailInterno($conexion,$datos)
	{
		$rolcod = $datos['usuario_destino']['rolcod'];
		
		$destinatarios=array();

		if ($datos['usuario_destino']['usuariocod'] == TODOS) {
		
			switch($rolcod)		{
				case ADMIONTI:
					$spnombre="sel_mail_usuarios_con_mail_xrol_xmenorestado";
					$spparam=array('prolcod'=>$rolcod,'pusuarioestado'=>USUARIOACT);		
					break;	
				case USUCURSOINAP:
					$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
					$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
					break;			
				case USUACTINS:
					$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
					$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
					break;			
				case USUACTJUR:
					$spnombre="sel_usuario_enlace_jurisdiccion_inap_xrolcod_jurisdid";
					$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>$jurisdcod);			
					break;			
				case COORDINADORTECNICO:
					$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
					$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>$jurisdcod);			
					break;			
				case USUORGANISMO:
					$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
					$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>$jurisdcod);			
					break;	
				case COORDINADORINAP:
					$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
					$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
					break;			
				case USUACTEXT:
					$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
					$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
					break;			
				case USUAUTODESARROLLO:
					$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
					$spparam=array('prolcod'=>$rolcod,'pjurisdid_inap'=>0);			
					break;			
				default:
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Intento de enviar mail a rol inexistente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
			}

			if(!isset($spnombre)) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al generar el mail.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
	
			if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
				return false;

			while($fila=mysqli_fetch_assoc($resultado))
				$destinatarios[]=$fila['usuariocod'];

		
		} else { 
				
			$destinatarios[]=$datos['usuario_destino']['usuariocod'];
		
		}
		
		
		$oMensajesInternos = new cMensajesInternos($conexion);
		//grabo un mensaje por cada destinatario
		foreach ($destinatarios as $clave => $valor ) {
			$datos['usuario_destino']['usuariocod'] = $valor;	
			$oMensajesInternos->AltaMensajesInternos ($conexion,$datos); 
		}
		
				
		return true;	
	}


		
//----------------------------------------------------------------------------------------- 
// Muestra un mensaje en pantalla y, segun el nivel del mensaje, envía tambien mail a ADMIONTI

// Parametros: $formatomensaje es un array asociativo
//					$formatomensaje['formato']=FMT_TEXTO|FMT_TABLA
//					$formatomensaje['cantcols'] usado para colspan cuando es FMT_TABLA
//				$enviarmail: en caso que sea necesario enviar mail y esta variable esta seteada en true, envia mail al administrador
//						definida en la conexion
//				$graba_variables: en caso de querar grabar las variables de entorno $_GET, $_POST, y $_SESSION

	static function MostrarMensaje($conexion,$nivelmensaje,$texto,$ubicerror,$formatomensaje,$texto_sys="",$enviarmail=true, $graba_variables=true)
	{
	
		if ($nivelmensaje==MSG_ERRGRAVE)
			$texto.=" Avise a su Administrador.";
		
		switch($nivelmensaje)
		{
			case MSG_OK:
			case MSG_INF:
			case MSG_ERRGRAVE:
			case MSG_ERRSOSP:
				if($formatomensaje['formato']==FMT_TEXTO)
					echo "<BR><p align='center' class='textoDatoBold'>".$texto."</p> <BR>";	
				elseif($formatomensaje['formato']==FMT_TABLA) {
				?>	<tr>
						<td colspan="<?php echo $formatomensaje['cantcols'] ?>" height="100" align="center" valign="middle">
							<span class='textoDatoBold'><?php echo $texto ?></span>
						</td>
					</tr> <?php
				} else
					echo $texto;	
				break;
		}

		if($enviarmail)	{
		
			$oMensajesInternos = new cMensajesInternos($conexion);
		
			// envio de mail
			switch($nivelmensaje)
			{
				case MSG_ERRGRAVE:
					$subject=" ( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." ) - Error de Inconsistencia de Datos ";
					$textomail="Se produjo un error:\n";
					$textomail.="  Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";
					$textomail.="  Ubic Archivo: ".$ubicerror['archivo']."\n";
					$textomail.="  Ubic Función: ".($ubicerror['funcion']==""?"-":$ubicerror['funcion'])."\n";
					$textomail.="  Ubic Línea: ".$ubicerror['linea']."\n";
					$textomail.="Texto error:".$texto."\n";
	
					if(isset($_SESSION['usuariocod']))
						$textomail.="Usuario sesion: ".$_SESSION['usuariocod']."\n";
	
					if ($texto_sys!="")
						$textomail.="\nInformación Adicional: ".$texto_sys;
				

					$datos = array( 
					
									'tipo_origen' => cMensajesInternos::MENSAJE_TIPO_ORIGEN_SISTEMA,
									'tipo_destino' => cMensajesInternos::MENSAJE_TIPO_DESTINO_ROL,			
					
									'usuario_origen' => array(
															  'rolcod' => $_SESSION['rolcod'], 
															  'usuariocod' => $_SESSION['usuariocod']
															  ), 
		
									'usuario_destino' => array(
															  'rolcod' => $conexion->VerAdmiGeneral(),
															  'usuariocod' => TODOS
															  ), 
									'nivel_mensaje' => $nivelmensaje,
									'asunto' => $subject,
									'mensaje' => $textomail,
									'archivo' => $ubicerror['archivo'],
									'funcion' => $ubicerror['funcion'],
									'var_session' => $_SESSION ,
									'var_post' => $_POST ,
									'var_get' => $_GET 
								);
					if (!$graba_variables) {
						$datos['var_session'] = "privado";
						$datos['var_post'] = "privado";
						$datos['var_get'] = "privado";
					}	
					
								
								
					FuncionesPHPLocal::MandarMailInterno($conexion,$datos);			
					
					//FuncionesPHPLocal::MandarMail($conexion,$conexion->VerAdmiGeneral(),"",$subject,$textomail);
					break;
	
				case MSG_ERRSOSP:
					$subject=" ( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." ) - Error Datos Sospechosos ";
					$textomail="Se produjo un error:\n";
					$textomail.="  Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";
					$textomail.="  Ubic Archivo: ".$ubicerror['archivo']."\n";
					$textomail.="  Ubic Función: ".($ubicerror['funcion']==""?"-":$ubicerror['funcion'])."\n";
					$textomail.="  Ubic Línea: ".$ubicerror['linea']."\n";
					$textomail.="Texto error:".$texto."\n";
	
					if(isset($_SESSION['usuariocod']))
						$textomail.="Usuario sesion: ".$_SESSION['usuariocod']."\n";

					if ($texto_sys!="")
						$textomail.="Información Adicional: ".$texto_sys;

					$datos = array( 
					
									'tipo_origen' => cMensajesInternos::MENSAJE_TIPO_ORIGEN_SISTEMA,
									'tipo_destino' => cMensajesInternos::MENSAJE_TIPO_DESTINO_ROL,			
					
									'usuario_origen' => array(
															  'rolcod' => $_SESSION['rolcod'], 
															  'usuariocod' => $_SESSION['usuariocod']
															  ), 
		
									'usuario_destino' => array(
															  'rolcod' => $conexion->VerAdmiGeneral(),
															  'usuariocod' => TODOS
															  ), 
									'nivel_mensaje' => $nivelmensaje,
									'asunto' => $subject,
									'mensaje' => $textomail,
									'archivo' => $ubicerror['archivo'],
									'funcion' => $ubicerror['funcion'],
									'var_session' => $_SESSION ,
									'var_post' => $_POST ,
									'var_get' => $_GET 
								);
					
					if (!$graba_variables) {
						$datos['var_session'] = "privado";
						$datos['var_post'] = "privado";
						$datos['var_get'] = "privado";
					}	
								
								
					FuncionesPHPLocal::MandarMailInterno($conexion,$datos);			

					//FuncionesPHPLocal::MandarMail($conexion,$conexion->VerAdmiGeneral(),"",$subject,$textomail);
					break;
			} // switch
			
		}
	}
//----------------------------------------------------------------------------------------- 
// Registra el acceso de un usuario en el sistema

	static function RegistrarAcceso($conexion,$codigo_mensaje,$acciondesc,$usuariocod) 
	{
		$archivonom=substr(strrchr($_SERVER['PHP_SELF'],'/'),1);
	
		if($usuariocod=='')
			$usuariocod=0;
		
		$spnombrelog='ins_logusuarios';
		$spparamlog=array('pcodigo_mensaje'=>$codigo_mensaje,'pacciondesc'=>$acciondesc,'pnumeroip'=>$_SERVER['REMOTE_ADDR'],'parchivonom'=>$archivonom,'pfecha'=>date('Y/m/d H:i:s'),'pusuariocod'=>$usuariocod);
	
		if(!$conexion->ejecutarStoredProcedure($spnombrelog,$spparamlog,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			$textoerror="Error registrar_acceso ".$errno." - ".$conexion->TextoError();
			// MANDAR MAIL con los parámetros de la llamada errónea
				
			$subject=" ( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." ) - Error en registrar acceso";		
			$texto="Se ha producido un error en ".$_SERVER['PHP_SELF']." \n\n";
			if($usuariocod!=0)
			{
				if(!$conexion->TraerCampo("usuarios","concat(usuarioapellido,',',usuarionombre)",array("usuariocod='",$usuariocod,"'" ),$nombreusuario,$numfilas,$errno))
					$texto.="Usuario ".$nombreusuario."\n\n";
			}
			$texto.="parámetros de acceso \n";
			$texto.="pcodigo_mensaje ".$codigo_mensaje."\n";
			$texto.="pacciondesc ".$acciondesc."\n";
			$texto.="pnumeroip ".$_SERVER['REMOTE_ADDR']."\n";
			$texto.="parchivonom ".$archivonom."\n";
			$texto.="pfecha ".date('Y/m/d H:i:s')."\n";
			$texto.="pusuariocod ".$usuariocod;
//			FuncionesPHPLocal::MandarMail($conexion,$conexion->VerAdmiGeneral(),"",$subject,$texto);

			$oMensajesInternos = new cMensajesInternos($conexion);


			$datos = array( 
			
							'tipo_origen' => cMensajesInternos::MENSAJE_TIPO_ORIGEN_SISTEMA,
							'tipo_destino' => cMensajesInternos::MENSAJE_TIPO_DESTINO_ROL,			
			
							'usuario_origen' => array(
													  'rolcod' => $_SESSION['rolcod'], 
													  'usuariocod' => $_SESSION['usuariocod']
													  ), 

							'usuario_destino' => array(
													  'rolcod' => $conexion->VerAdmiGeneral(),
													  'usuariocod' => TODOS
													  ), 
							'nivel_mensaje' => MSG_ERRGRAVE,
							'asunto' => $subject,
							'mensaje' => $texto,
							'archivo' => $archivonom,
							'funcion' => "RegistrarAcceso",
							'var_session' => $_SESSION ,
							'var_post' => $_POST ,
							'var_get' => $_GET 
						);
						
			FuncionesPHPLocal::MandarMailInterno($conexion,$datos);		
			
			return false;
		}
		return true;
	}
//----------------------------------------------------------------------------------------- 
// Arma un combo que recarga la página según la opción seleccionada

// Parametros:
// 		->spnombre y spparam se usan para armar el query
// 		->nomformulario es el nombre del formulario sobre el que está el combo
// 		->nomcombo es el nombre del combo
// 		->clavecombo y desccombo son campos del query con los que arma el combo
// 		->querystring lo coloca despues del nombre del php
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que exista una variables GET con el nombre del combo y coincide con algun registro del query, retorna la fila
// 		->seleccionado, en caso que se haya seleccionado un option del combo
//      ->style estilo del combo

	static function ArmarCombo_BD($conexion,$spnombre,$spparam,$nomformulario,$nomcombo,$clavecombo,$desccombo,$querystring,$textolineauno,&$regactual,&$seleccionado, $style="width: 370px",$vertextocompleto=true)
	{
		// Cargo los registros del query seleccionado
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$num_filas,$errno))
			return false;

		// Genera codigo JavaScript para autollamarse cuando selecciona un elemento del combo
		echo "<SCRIPT LANGUAGE='JavaScript' type='text/javascript'>\n";
		echo "<!--\n";
		
		echo "function ".$nomcombo."_newpage() {\n";
	
		$temp="";
		if($querystring!='')
			$temp="?";
	
		echo "if(document.".$nomformulario.".".$nomcombo.".selectedIndex==0)\n";
		echo "    location='".$_SERVER['PHP_SELF'].$temp.$querystring."';\n";
		echo "else\n";
	
		if($querystring!='')
			$querystring.="&";
	
		echo "    location='".$_SERVER['PHP_SELF']."?".$querystring.$nomcombo."='+document.".$nomformulario.".".$nomcombo."[document.".$nomformulario.".".$nomcombo.".selectedIndex].value;\n";
		echo "}\n";
		
		echo "//-->\n";
		echo "</SCRIPT>\n";
	
		// Generación del combo, poniendo como primera linea $textolineauno
		echo "<select name='".$nomcombo."' size=1 onChange='".$nomcombo."_newpage();' class='combos' style='".$style."'>\n";
		echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>\n";
		$seleccionado=false;
		if($num_filas>0) 
		{
			// Recorre el cursor desde el principio, poniendo cada fila en una linea del combo
			$textopopup='';
			while ($fila = mysqli_fetch_assoc($resultado))
			{ 
				if(isset($_GET[$nomcombo]) && $fila[$clavecombo]==$_GET[$nomcombo]) 
				{
					echo "<option selected value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
					$seleccionado=true;
					$regactual=$fila;
					$textopopup=$fila[$desccombo];
				}
				else
					echo "<option value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
			}
		}
	
		echo "</select>\n";

		if(isset($textopopup) && $vertextocompleto)
			echo "<div><a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?textopopup='+".$nomformulario.".".$clavecombo."[".$nomformulario.".".$clavecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkFondoBlanco'><span class='textoAclaraciones'>Ver texto completo</span></a>\n</div>\n";
		else
			echo "<div style='font-size: 7px;'>&nbsp;</div>\n";
	}

//----------------------------------------------------------------------------------------- 
// Arma un combo con la informacion del SP enviado

// Parametros:
// 		->spnombre y spparam se usan para armar el query
// 		->nomformulario es el nombre del formulario sobre el que está el combo
// 		->nomcombo es el nombre del combo
// 		->clavecombo y desccombo son campos del query con los que arma el combo
// 		->claveselec es el registro que hay que seleccionar
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que se haya seleccionado un option se retorna la fila completa
// 		->seleccionado, en caso que se haya seleccionado un option del combo
//		->$filas, si es 1, es un combo, sino es una lista
//		->$onchange: la accion javascript al momento de seleccionar un elemento de la lista
//		->$style: estilo a aplicar sobre el combo
//		->$multiple: si se permite que en una lista se puedan elegir mas de un item
//		->$vertextocompleto: indica si se muestra el link abajo para ver texto completo

	static function ArmarCombo_SinSalto_BD($conexion,$spnombre,$spparam,$nomformulario,$nombrecombo,$clavecombo,$desccombo,$claveselec,$textolineauno,&$regactual,&$seleccionado,$filas=1,$onchange="",$style="width: 370px",$multiple=false,$vertextocompleto=true,$onDbClick="",$disabled=false)
	{
		// Cargo los registros del query seleccionado
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$num_filas,$errno))
			return false;
		
		
		$mostrardisabled="";
		if ($disabled)
			$mostrardisabled="disabled";
		// Generación del combo, poniendo como primera linea $textolineauno
		echo "<select name='".$nombrecombo."' id='".$nombrecombo."'  size='".$filas."' class='combos' style='".$style."' onChange='".$onchange."'  ondblclick='".$onDbClick."' ".($multiple?"multiple":"")." ".$mostrardisabled.">\n";
		if($filas==1)
			echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>\n";

		$seleccionado=false;
		if($num_filas>0) 
		{
			// Recorre el cursor desde el principio, poniendo cada fila en una linea del combo
			while ($fila = mysqli_fetch_assoc($resultado))
			{ 
				if($fila[$clavecombo]==$claveselec) 
				{
					echo "<option selected value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
					$seleccionado=true;
					$regactual=$fila;
				}
				else
					echo "<option value='".htmlspecialchars($fila[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desccombo],ENT_QUOTES)." </option>\n";
			}
		}
	
		echo "</select>\n" ;
		if($filas==1 && $vertextocompleto)
			echo "<br><a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?textopopup='+".$nomformulario.".".$nombrecombo."[".$nomformulario.".".$nombrecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkFondoBlanco'><span class='textoAclaraciones'>Ver texto completo</span></a>\n";
	}
	
//----------------------------------------------------------------------------------------- 
// Arma un combo en base a la informacion proveniente en un array. Con salto.

// Parametros:
// 		->valores_combo: array asociativo, del que salen los valores para el combo
//			valores_combo=array(1=>array($clavecombo=>"valor",$desccombo=>"valor"),2=>array($clavecombo=>"valor",$desccombo=>"valor"))
// 		->nomformulario es el nombre del formulario sobre el que está el combo
// 		->nomcombo es el nombre del combo
// 		->clavecombo y desccombo son campos del array con los que arma el combo
//		->querystring es el string que se agrega a la linea
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que se haya seleccionado un option se retorna la fila completa
// 		->seleccionado, en caso que se haya seleccionado un option del combo
//      ->style, estilo del combo

	static function ArmarCombo_deArray($valores_combo,$nomformulario,$nomcombo,$clavecombo,$desccombo,$querystring,$textolineauno,&$regactual,&$seleccionado,$style="width: 370px",$vertextocompleto=true) 
	{
		$seleccionado=false;
		$regactual=array();

		
		// Genera codigo JavaScript para autollamarse cuando selecciona un elemento del combo
		echo "<SCRIPT LANGUAGE='JavaScript' type='text/javascript'>\n";
		echo "<!--\n";
		
		echo "function ".$nomcombo."_newpage() {\n";
	
		$temp="";
		if($querystring!='')
			$temp="?";
	
		echo "if(document.".$nomformulario.".".$nomcombo.".selectedIndex==0)\n";
		echo "    location='".$_SERVER['PHP_SELF'].$temp.$querystring."';\n";
		echo "else\n";
	
		if($querystring!='')
			$querystring.="&";
	
		echo "    location='".$_SERVER['PHP_SELF']."?".$querystring.$nomcombo."='+document.".$nomformulario.".".$nomcombo."[document.".$nomformulario.".".$nomcombo.".selectedIndex].value;\n";
		echo "}\n";
		
		echo "//-->\n";
		echo "</SCRIPT>\n";
	
		// Generación del combo, poniendo como primera linea $textolineauno
		echo "<select name='".$nomcombo."' size=1 onChange='".$nomcombo."_newpage();' class='textoTablaDato' style='".$style."'>";
		echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>";
	
		foreach($valores_combo as $optioncombo)
		{
			// Recorre el array, poniendo cada fila en una linea del combo
			echo "<option ";
	
			if(isset($_GET[$nomcombo]) && $optioncombo[$clavecombo]==$_GET[$nomcombo]) 
			{
				echo " selected ";
				$seleccionado=true;
				$regactual=$optioncombo;
			}
			
			echo " value='".htmlspecialchars($optioncombo[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($optioncombo[$desccombo],ENT_QUOTES);
			echo "</option>";
		}
	
		echo "</select>\n";
		if($vertextocompleto)
			echo "<a href='javascript:void(0)' onClick=\"javascript:Popup('ventanatexto.dhtml?textopopup='+formulario.".$nomcombo."[formulario.".$nomcombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkFondoBlanco'><span class='textoAclaraciones'>Ver texto completo</span></a>";
	}
	
//----------------------------------------------------------------------------------------- 
// Arma un combo en base a la informacion proveniente en un array. Sin salto.

// Parametros:
// 		->valores_combo: array asociativo, del que salen los valores para el combo
//			valores_combo=array(1=>array($clavecombo=>"valor",$desccombo=>"valor"),2=>array($clavecombo=>"valor",$desccombo=>"valor"))
// 		->nomformulario es el nombre del formulario sobre el que está el combo
// 		->nombrecombo es el nombre del combo
// 		->clavecombo y desccombo son campos del array con los que arma el combo
// 		->claveselec es el registro que hay que seleccionar
//		->querystring es el string que se agrega a la linea
// 		->claselec está algo seleccionado
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que se haya seleccionado un option se retorna la fila completa
// 		->seleccionado, en caso que se haya seleccionado un option del combo
//		->$filas, si es 1, es un combo, sino es una lista
//		->$onchange: la accion javascript al momento de seleccionar un elemento de la lista
//		->$style: estilo a aplicar sobre el combo

//	static function ArmarCombo_SinSalto_deArray($valores_combo,$nomformulario,$nombrecombo,$clavecombo,$desccombo,$querystring,$claveselec,$textolineauno,&$regactual,&$seleccionado,$filas=1,$onchange="",$style="width: 370px;") 
	static function ArmarCombo_SinSalto_deArray($valores_combo,$nomformulario,$nombrecombo,$clavecombo,$claveselec,$desccombo,$querystring,$textolineauno,&$regactual,&$seleccionado,$filas=1,$onchange="",$style="width: 370px;",$disabled=false) 
	{
		$seleccionado=false;
		$regactual=array();

		$mostrardisabled="";
		if ($disabled)
			$mostrardisabled="disabled";
			
		// Generación del combo, poniendo como primera linea $textolineauno
		echo "<select name='".$nombrecombo."' id='".$nombrecombo."' size='".$filas."' onChange='".$onchange."' class='combos' style='".$style."' ".$mostrardisabled.">";
		
		if($filas==1)
			echo "<option value=''>".htmlspecialchars($textolineauno,ENT_QUOTES)."</option>";
	
		foreach($valores_combo as $optioncombo)
		{
			// Recorre el array, poniendo cada fila en una linea del combo
			echo "<option ";
	
//			if($optioncombo[$clavecombo]==$claveselec)
			if( (isset($_GET[$nombrecombo]) && $optioncombo[$clavecombo]==$_GET[$nombrecombo]) 
				|| ($optioncombo[$clavecombo]==$claveselec)
				)
			{
				echo " selected ";
				$seleccionado=true;
				$regactual=$optioncombo;
			}
			
			
			echo " value='".htmlspecialchars($optioncombo[$clavecombo],ENT_QUOTES)."'> ".htmlspecialchars($optioncombo[$desccombo],ENT_QUOTES);
			echo "</option>";
		}
	
		echo "</select>\n";
			
		if($filas==1)
			echo "<br><a href='javascript:void(0)' onClick=\"javascript:popup('ventanatexto.dhtml?textopopup='+".$nomformulario.".".$nombrecombo."[".$nomformulario.".".$nombrecombo.".selectedIndex].text,'ventanatexto',330,80,screen.availWidth-350,screen.availHeight-140,'yes')\" class='linkFondoBlanco'><span class='textoAclaraciones'>Ver texto completo</span></a>\n";
	}	
//----------------------------------------------------------------------------------------- 
// cambia algunos caracteres para que no de error el JS

	static function ReemplazarCharJS($texto)
	{
		if($texto!="")
			return str_replace(array("'","\r","\n"),array("\'","\\r","\\n"),$texto);
		else
			return $texto;
	}

