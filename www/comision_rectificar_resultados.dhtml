<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oComisionPersona = new cComisionPersona($conexion);
$oComision = new cComision($conexion);

//----------------------------------------------------------------------------------------- 
$filacomision=array();
$filacomision['comi_codinap']=(isset($_POST['comi_codinap_seleccion']))?$_POST['comi_codinap_seleccion']:"";
$filacomision['comi_codigo']=(isset($_POST['comi_codigo']))?$_POST['comi_codigo']:"";
$filacomision['comi_codigo']=(isset($_GET['comi_codigo']))?$_GET['comi_codigo']:"";

if (isset($_POST['comi_codinap_seleccion'])) {
	if($conexion->TraerCampo("comision","comi_codigo",array("comi_codinap='",$_POST['comi_codinap_seleccion'],"'"),$comi_codigo,$numfilas,$errno))
		$filacomision['comi_codigo']=htmlspecialchars($comi_codigo,ENT_QUOTES);
}

if ( isset($_GET['comi_codigo']) ) {
	if($conexion->TraerCampo("comision","comi_codinap",array("comi_codigo='",$filacomision['comi_codigo'],"'"),$comi_codigo_inap,$numfilas,$errno))
		$filacomision['comi_codinap']=htmlspecialchars($comi_codigo_inap,ENT_QUOTES);
}

?>
<script type="text/javascript">
	<?php $oComisionPersona->ValidarFormAltaInscribirAlumno(); ?>
</script>
<?php
//---------------------------------------------------------------------------------------------------------------
$destino_formulario_interface="comision_rectificar_resultados.dhtml";
?>
<form action="<?php echo $destino_formulario_interface ?>" method="post" name="formulario_seleccion" id="formulario_seleccion">
	<table width="100%" class="textoTablaDato" align="center">
	<tr>
		<td><?php $oComisionPersona->PedirComision($filacomision['comi_codinap'],'formulario_seleccion','comi_codinap_seleccion','Rectificar Resultados'); ?></td>
	</tr>
	</table>
</form>	
<?php 
$es_modif=false;
$ok=false;
if ($filacomision['comi_codigo']=="") {

	if ( isset($_POST['comi_codigo']) || isset($_POST['comi_codinap_seleccion']) )
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

} else {

	if ($oComisionPersona->TraerDatosComision($filacomision['comi_codigo'],$filacomision,$es_modif)) {
		if (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else { 
			switch ($_SESSION['rolcod']) {
				case SUPERUSUARIO:
				case USUCURSOINAP:
					$oActividadCurso = new cActividadCursoInap($conexion); 
					$formact_codigo=FORMATOCURSO;
					$tipoact_codigo=TIPOACTCURSOINAP;
					break;
				case USUORGANISMO:
				case COORDINADORTECNICO:
					$oActividadCurso = new cActividadCursoJurisdiccional($conexion); 
					$formact_codigo=FORMATOCURSO;
					$tipoact_codigo=TIPOACTCURSOJURISD;
					break;
			}		
		
			if ($oComisionPersona->TienePermisoRectificarResultados($filacomision['comi_codigo'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap'])) {
				$ok=true;
			} // Tiene permiso el usuario sobre la comision
			
		}	// Se encontró la comisión	
	} // No se produjo error al buscar la comisión

} // seleccion de comisión

if ($ok) { 

	$act_codigo=$filacomision['act_codigo'];
	$actprog_sec=$filacomision['actprog_sec'];

	if ($oComision->MostrarDatosComisionCabecera($conexion,$filacomision['comi_codigo'])) {

		if ($oComision->MostrarInscriptosEvaluar($conexion,$filacomision['comi_codigo'])) { ?>

		<?php } ?>		
		
<?php 	} else {
		$txt_sys_mail="\ncomi_codigo=".$filacomision['comi_codigo'];		
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar los datos de la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
	} // if 
	
} // fin ok ?>

<?php	
$oEncabezados->PieMenuEmergente(); 
?>