					$ArregloDatos['tipoact_codigo'] = TIPOACTCURSOINAP;		
					$ArregloDatos['orderby'] = "act_nombre asc, ap.actprog_fecha_inicio desc, c.comi_fecha_inicio desc, c.comi_codinap";						
