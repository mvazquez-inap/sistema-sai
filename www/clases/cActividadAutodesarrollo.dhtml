<?php
//----------------------------------------------------------------------------------------- 
class cActividadAutodesarrollo extends cActividad {

	public function __construct($conexion) {
		parent::__construct($conexion);
	}
	//-----------------------------------------------------------------------------------------------------	
	 function TieneTipo($act_codigo,$tipoact_codigo,&$tiene_tipo)	{
		$tiene_tipo=$this->EsActividadAutodesarrolloTipo($act_codigo,$tipoact_codigo,$error,$errormsg);
		if ($error) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar Tipo de Actividad",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		    return false;
		}
		return true;
	} 
	//-----------------------------------------------------------------------------------------------------	
	 function ObtenerTipos($act_codigo,&$array_tipos)	{
	 
			$ArregloDatos = array();
			$ArregloDatos['act_codigo'] = $act_codigo;
		
			if(!$this->BuscarActividadAutodesarrollo($ArregloDatos,$numfilas,$resultActAuto,$error,$errormail)){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al obtener los tipos de Autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;			
			}
	 		
			while ($fila_resultActAuto = mysqli_fetch_assoc($resultActAuto)) {
				$array_tipos[]+= $fila_resultActAuto['tipoact_codigo'];
			}
			return true	; 
	}
	
//-----------------------------------------------------------------------------------------
	function EsActividadAutodesarrolloTipo($act_codigo,$tipoact_codigo,&$error,&$errormsg)	{
	
		// La actividad debe existir y ser formato curso
		$error=false;
		if (!$this->TraerDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo,$result_actividad_autodesarrollo,$es_modif)) {
			$errormsg="Error al traer datos de la Actividad Autodesarrollo.";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;
			return false;
		}

		if (!$es_modif) {
			$errormsg="Error al buscar la Actividad Autodesarrollo.";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$errormsg,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$error=true;
			return false;
		}
		
		return ($result_actividad_autodesarrollo['actividad_autodesarrollo']['tipoact_codigo'] == $tipoact_codigo);
	}	
	//-----------------------------------------------------------------------------------------------------	
	function BuscarActividadAutodesarrollo($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxact_codigo'=>0);
		$sparam+=array('pxact_nombre'=>0);
		$sparam+=array('pxact_codinap'=>0);
		$sparam+=array('pxact_codinap_exacto'=>0);

		$sparam+=array('pxactauto_estado'=>0);
		$sparam+=array('pxactauto_duracionhs'=>0);
		$sparam+=array('pxtipoact_codigo'=>0);
		
		$sparam+=array('pact_codigo'=>"");
		$sparam+=array('pact_nombre'=>"");
		$sparam+=array('pact_codinap'=>"");
		$sparam+=array('pact_codinap_exacto'=>"");
		$sparam+=array('pactauto_estado'=>"-1");
		$sparam+=array('pactauto_duracionhs'=>"");
		$sparam+=array('ptipoact_codigo'=>"-1");

		$sparam+=array('porderby'=>"act_nombre");
				
		if (isset ($ArregloDatos['act_codigo']))
		{
			if ($ArregloDatos['act_codigo']!="")
			{	
				$sparam['pact_codigo']= $ArregloDatos['act_codigo'];
				$sparam['pxact_codigo']= 1;
			}
		}	

		if (isset ($ArregloDatos['act_nombre']))
		{
			if ($ArregloDatos['act_nombre']!="")
			{	
				$sparam['pact_nombre']= $ArregloDatos['act_nombre'];
				$sparam['pxact_nombre']= 1;
			}
		}	
	
		if (isset ($ArregloDatos['act_codinap']))
		{
			if ($ArregloDatos['act_codinap']!="")
			{	
				$sparam['pact_codinap']= $ArregloDatos['act_codinap'];
				$sparam['pxact_codinap']= 1;
			}
		}	

		if (isset($ArregloDatos['act_codinap_exacto']))
		{
			if ($ArregloDatos['act_codinap_exacto']!="")
			{	
				$sparam['pact_codinap_exacto']= $ArregloDatos['act_codinap_exacto'];
				$sparam['pxact_codinap_exacto']= 1;
			}
		}	
	
		if (isset($ArregloDatos['actauto_estado']))
		{
			if ($ArregloDatos['actauto_estado']!="")
			{	
				$sparam['pactauto_estado']= $ArregloDatos['actauto_estado'];
				$sparam['pxactauto_estado']= 1;
			}
		}	
		
		if (isset($ArregloDatos['actauto_duracionhs']))
		{
			if ($ArregloDatos['actauto_duracionhs']!="")
			{	
				$sparam['pactauto_duracionhs']= $ArregloDatos['actauto_duracionhs'];
				$sparam['pxactauto_duracionhs']= 1;
			}
		}	
		
		if (isset($ArregloDatos['tipoact_codigo']))
		{
			if ($ArregloDatos['tipoact_codigo']!="")
			{	
				$sparam['ptipoact_codigo']= $ArregloDatos['tipoact_codigo'];
				$sparam['pxtipoact_codigo']= 1;
			}
		}				
		
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}
		$spnombre="sel_actividad_autodesarrollo_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar en Actividad Autodesarrollo.";
			$errormail="Error al buscar en Actividad Autodesarrollo.".$errno;
			return false;
		}
		return true;
	}
