<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
//----------------------------------------------------------------------------------------- 	
$objTabla= new cTablaAreaEspecifica($conexion);
?>
<script type="text/javascript">
	<?php $objTabla->ValidarFormSysTabla(); ?>
</script>
<?php

if (!isset($_POST['buscado']) && !isset($_GET['pagina']) )
	$_SESSION['array_busqueda_tabla']['valor_buscado']="";

$result=true;
$modulo_recarga="area_especifica.dhtml";
//--------------------------------------------------------------------------------------------------
// Se confirmo la operacion 
//--------------------------------------------------------------
if (isset($_POST['boton_confirma'])) {

	$commit=true;
	$conexion->ManejoTransacciones("B");

	// Alta - Baja - Modificación
	if ($commit) {

		switch($_POST['operacion']) {

		case 'I': 	

			if ($objTabla->AltaSysTabla($_POST)) {
				$nuevocodigo=$conexion->UltimoCodigoInsertado();
				FuncionesPHPLocal::RegistrarAcceso($conexion,"035111","\nareacon_codigo=".$_POST['areacon_codigo']."\nareagen_codigo=".$_POST['areagen_codigo']."\nareaesp_codigo=".$nuevocodigo,$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha insertado: ".$_POST['areaesp_descripcion'],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else  //  Cualquier error es informado en AltaSysTabla
				$commit=false;
			break;	
			
		case 'M': 

			if ($objTabla->ModificarSysTabla($_POST)) {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"035113","\nareacon_codigo=".$_POST['areacon_codigo']."\nareagen_codigo=".$_POST['areagen_codigo']."\nareaesp_codigo=".$_POST['areaesp_codigo'],$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha actualizado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else //  Cualquier error es informado en ModificarSysTabla
				$commit=false;
			break;	

		case 'B': 

			if ($objTabla->BorrarSysTabla($_POST,$es_bajafisica)) {			
			
				if ($es_bajafisica) 
					$codlogbaja="035112";
			
				FuncionesPHPLocal::RegistrarAcceso($conexion,$codlogbaja,"\nareacon_codigo=".$_POST['areacon_codigo']."\nareagen_codigo=".$_POST['areagen_codigo']."\nareaesp_codigo=".$_POST['areaesp_codigo'],$_SESSION['usuariocod']);	
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha eliminado: ".$_POST['areaesp_descripcion'],array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else //  Cualquier error es informado en BorrarSysTabla
				$commit=false;
			break;	

		default: 
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error operación",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$commit=false;
		} // $switch
		
		if($commit)
			$conexion->ManejoTransacciones("C");
		else
			$conexion->ManejoTransacciones("R");
	}	// commit
	
} // seteado el confirma 
//------------------------------------------------------------
// Inicio de pantalla
//------------------------------------------------------------
?>
<form action="<?php echo $modulo_recarga; ?>" method="post" name="formulario_seleccion">
	<div align="right" style="width:95%">
			<a href="download_tablas_excel.dhtml?tabla=area_especifica"  class="linkFondoBlanco textoAclaraciones"> 
				<img alt="Bajar en Formato .xls" title="Bajar en Formato .xls" src="./images/iconoexcel.jpg" border="0">
			</a>
	</div>
	
	<table width="90%" class="textoTablaDato" cellpadding="2" cellspacing="0"  align="center">
		<tr>
			<td valign="top" class="textoEtiqueta">Area Contextual</td>
			<td class="textoEtiquetaDatoResaltado">	
	<?php			$querystring=FuncionesPHPLocal::ArmarQueryString("areacon_codigo");
				$spnombre="sel_area_contextual_orden";
				$spparam =array('porderby'=>"areacon_descripcion");
				FuncionesPHPLocal::ArmarCombo_BD($conexion,$spnombre,$spparam,"formulario_seleccion","areacon_codigo","areacon_codigo","areacon_descripcion",$querystring,"--Seleccione un Area Contextual",$filareacon,$seleccon,"width:440px");
	?>		</td>
		</tr> 
		<tr>
			<td valign="top" class="textoEtiqueta">Area General</td>
			<td class="textoEtiquetaDatoResaltado">	
	<?php			$querystring=FuncionesPHPLocal::ArmarQueryString("areagen_codigo");
				$spnombre="sel_area_general_orden";
			//	$spparam =array('pareacon_codigo'=>isset($_GET['areacon_codigo'])?$_GET['areacon_codigo']:"",'porderby'=>"areagen_descripcion");
			$spparam =array('porderby'=>"areagen_descripcion");
				FuncionesPHPLocal::ArmarCombo_BD($conexion,$spnombre,$spparam,"formulario_seleccion","areagen_codigo","areagen_codigo","areagen_descripcion",$querystring,"--Seleccione un Area General",$filareagen,$selecgen,"width:440px");
	?>		</td>
		</tr> 		
		<tr>
			<td>&nbsp; 	</td>			
		</tr>
	</table>		
</form>

<?php
//------- GRILLA VALORES A MODIFICAR 
if ($result)  { ?>
	<table width="100%" class="textoTablaDato">
		<tr> 
			<td align="center">			
			<?php 	if (!$objTabla->MostrarGrillaSeleccion($modulo_recarga,$filareacon['areacon_codigo'],$filareagen['areagen_codigo']))
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar datos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			?>
			</td>
		</tr>	
	</table>
	<br>
<?php	}

// Se define la acción
if (!isset($_GET['operacion'])) {
	$leyenda_operacion = "Agregar";
	$boton_operacion = "Agregar";		
	$operacion = "I";
} else {
	switch ($_GET['operacion']) {		
	case "M" :
			$leyenda_operacion = "Actualizar";		
			$boton_operacion = "Actualizar";		
			$operacion = "M";				
			break;
	case "B" :
			$leyenda_operacion = "Eliminar";		
			$boton_operacion = "Eliminar";		
			$operacion = "B";				
			break;
	default:
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error de operación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$result=false;
	}
}
//------- DATOS DE UN REGISTRO
if ($result) { 	

	$fila_tabla=array();						//  NUEVO

	if ($operacion == "I")
		$fila_tabla['areaesp_codigo']="";
		
	if ($operacion == "M" || $operacion == "B") {	// BAJA o MODIFICACION

		// Datos para la seleccion de un registro por su clave.
		$spnombre= "sel_area_especifica_xareacon_codigo_areagen_codigo_areaesp_codigo";
		$spparam = array('pareacon_codigo' => isset($_GET['areacon_codigo'])?$_GET['areacon_codigo']:"",
						 'pareagen_codigo' => isset($_GET['areagen_codigo'])?$_GET['areagen_codigo']:"",
						 'pareaesp_codigo' => isset($_GET['areaesp_codigo'])?$_GET['areaesp_codigo']:"");
		if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$result,$numfilas,$errno)) {	
			$txt_sys_mail="\nareacon_codigo=".$_POST['areacon_codigo']."\nareagen_codigo=".$_POST['areagen_codigo']."\nareaesp_codigo="."\n".$_POST['areaesp_codigo'];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos de la tabla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			$result=false;
		} elseif ($numfilas==0)  {
				$txt_sys_mail="\nareacon_codigo=".$_POST['areacon_codigo']."\nareagen_codigo=".$_POST['areagen_codigo']."\nareaesp_codigo="."\n".$_POST['areaesp_codigo']."\nnumfilas=".$numfilas;
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando datos, no existe el valor buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				$result=false;
			} else
				$fila_tabla=mysqli_fetch_assoc($result); 
				
	} // Obtencion de datos 
	
	if ( $result ) {  ?>
	<table width="80%"  border="0" align="center" cellspacing="0" cellpadding="0">			
		<!-- DATOS A MODIFICAR -->
		<tr> 
			<td>
				<fieldset class="bordeDetalleRegistro">
				<legend class="textoLeyendaDetalleRegistro">  Detalle del Registro  ( <?php echo $leyenda_operacion ?>  )</legend>
				<form action="<?php echo $modulo_recarga ?>" method="post" name="formulario"> 
				<table width="100%" class="textoTablaDato" cellpadding="2" cellspacing="0">
						<tr>
							<td valign="top" class="textoEtiqueta">Descripción</td>
							<td class="textoEtiquetaDatoResaltado">					
							 <textarea cols="100"  name="areaesp_descripcion"  style="width:400px" <?php echo ($operacion == "B")?' class="inputReadonly" readonly ':' class="textoInput" '?>><?php if($operacion == "M" || $operacion == "B") echo htmlspecialchars($fila_tabla['areaesp_descripcion'],ENT_QUOTES) ?></textarea>
<?php							if($operacion == "M" || $operacion == "I") { ?>
								<br><span class="textoAclaraciones">Nota: La longitud de la descripción debe ser menor a 200 caracteres. </span>
<?php							} ?>
							</td>
						</tr> 
						<tr>
							<td colspan="2" align="center">
								<input type="submit" name="boton_confirma" value="<?php echo $boton_operacion; ?>" onClick="return ValidarFormSysTabla(formulario,'<?php echo $operacion ?>'); " class="botones" />
								<input type="submit" name="boton_cancela" value="Cancelar" class="botones" />
								<input type="hidden" name="operacion" id="operacion" value="<?php echo $operacion;?>" />
								<input type="hidden" name="areacon_codigo" id="areacon_codigo" value="<?php echo $filareacon['areacon_codigo'] ?>" />				  
								<input type="hidden" name="areagen_codigo" id="areagen_codigo" value="<?php echo $filareagen['areagen_codigo'] ?>" />				  
								<input type="hidden" name="areaesp_codigo" id="areaesp_codigo" value="<?php echo $fila_tabla['areaesp_codigo'] ?>" />				  
							</td>
						</tr>					
				</table>
				</form>
				</fieldset> 	
			</td>
			</tr>
		</table>
<?php	} // 
}
$oEncabezados->PieMenuEmergente(); ?>