//-----------------------------------------------------------------------------------------


	function EliminarDatosActividadCursoPrestadorDocenteTodos($act_codigo) {
		
		// Se deben eliminar los docentes asignados como posibles para la actividad			
		$spnombre="del_actividad_curso_prestador_docente_xact_codigo";
		$spparam=array(
			'pact_codigo'=> $act_codigo
		);
			
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod)) 
			return false;					  	 	
	
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosActividadesCursoPrestadorDocenteTodas($presdoc_codigo)	{
 
		 // Selecciono todas las actividades, en las cuales el presador es parte del equipo.
		$spnombre="sel_actividad_curso_prestador_docente_xpresdoc_codigo_actpres_estado";
		$spparam=array('ppresdoc_codigo'=> $presdoc_codigo, 'pactpres_estado'=>ACTPRESDOCACTIVO);
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod)) 
			return false;					  	 	
		
		// Elimino el docente de la actividad
		while ($fila_actividad_prestador=mysqli_fetch_assoc($query)) {
			if( !$this->EliminarDatosActividadCursoPrestadorDocente($fila_actividad_prestador['act_codigo'],$presdoc_codigo) ) {
				$txt_sys_mail="\nact_codigo=".$fila_actividad['act_codigo'].'\npresdoc_codigo='.$presdoc_codigo;
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error desasignando el Prestador Docente de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function ValidarFormAltaActividadPrestadorDocenteCurso() {	
