<?php 
require_once('SysONTIPdf.dhtml');

class cConstanciaCreditosEformalPDF extends cPDF {

	// Datos de la Notificacion
	var $array_datos = array();

	// Ctes para la impresion de la Constancia
	var $ver_borde = 0;	
	var $xContenido = 5;
	var $imagenLogo = 'images/escudo_secretaria.jpg';
	
	var $orientacionPagina = 'portrait';
	var $topMargen = 10;
	var $leftMargen = 10;
	var $rightMargen = 10;
	var $footerMargen = 10;
	var $anchoMaxTexto = 190;	
	var $altoLineaDefault = 6;	
	var $pag_x_inscripto= "N";			// Indica si se imprime un salto x cada inscripto 
										// por el momento la unica manera de llamarla es "S", pero manda 1 solo inscripto
	var $altoMaxPag = 270;
				
	function cConstanciaCreditosTablaPDF ($pag_x_inscripto="N") {	    
		$this->pag_x_inscripto=$pag_x_inscripto;
		$format = "A4";
		parent::__construct($this->orientacionPagina,'mm',$format);
	}	
	
	//------------------------------------------------------------------------
	function AddConstanciaCreditos() {

		// Inicializa formato de la pagina 
		$this->AddPage($this->orientacionPagina);
		$this->AliasNbPages(); 

		$this->SetMargins($this->leftMargen,$this->topMargen,$this->rightMargen);

		// Para que el pie tenga 0.5 por defecto son 2cm
		$this->SetAutoPageBreak(true,$this->footerMargen);

		// Inicializa datos 
		$this->array_datos['datos_cabecera'] = array('act_nombre'=>'',
									'formact_codigo'=>0,
									'tipoact_codigo'=>0,		
									'actform_tipoact_desc'=>'',
									'act_codinap'=>'',
									'act_obs'=>'',
									'datos_inscriptos'=> array()
									);
	}
	//------------------------------------------------------------------------
	function Set($campo,$valor) {
		$this->array_datos[$campo]=$valor;
	}
	//------------------------------------------------------------------------
	function Get($campo) {
		return ($this->array_datos[$campo]);
	}
	//------------------------------------------------------------------------
	function Header() {}
	
	//------------------------------------------------------------------------
	function MostrarCabecera() {
		$datos_cabecera = $this->Get('datos_cabecera');
		$this->SetFont('Arial','BI',12);
		if ($this->pag_x_inscripto != "S") {		
			$this->MultiCellMaxLine($this->anchoMaxTexto,10,
									$this->PageNo()."/{nb}",$this->ver_borde,'R',0,1);
		}
	} 

	//------------------------------------------------------------------------
	function MostrarInscriptos() {
			$datos_inscriptos = $this->Get('datos_inscriptos');

			// Definicion de las columnas
		    $titulo_columnas=array("Apellido y Nombre","Organismo","CUIT/CUIL", "Escalafón","Nivel",'Tramo',"Grado"); 
		    $ancho_columnas=array(40,40,20,50,12,15,12);

			// Cabeceras
			if ($this->pag_x_inscripto=="S") {			//	1 persona por hoja				
				$this->AddPage($this->orientacionPagina);
				$this->MostrarCabecera();           //  si va en la primera los datos de la comisión y los inscriptos
			}
						
			foreach($datos_inscriptos as $indice=>$valor)	{
				
				$this->Ln(4);					
				$this->SetFont('Arial','BU',11);
				$this->MultiCellMaxLine($this->anchoMaxTexto,10,
										"DATOS DE LA ASIGNACIÓN",$this->ver_borde,'L',0,2);

				$this->SetFont('Arial','',10);
				$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'INSTITUCIÓN: '.$valor['actformpers_institucion'],$this->ver_borde,'L',0,2);
				$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'MATERIAS: '.$valor['actformpers_materias'],$this->ver_borde,'L',0,2);
				$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'FECHA DE REALIZACIÓN: '.FuncionesPHPLocal::ConvertirFecha($valor['actformpers_fecha_fin'],'aaaa-mm-dd','dd/mm/aaaa'),$this->ver_borde,'L',0,2);
				$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'CRÉDITOS: '.$valor['actformpers_creditos'],$this->ver_borde,'L',0,2);
				$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'OBSERVACIONES: '.$valor['actformpers_obs'],$this->ver_borde,'L',0,2);
				
			}


			$this->Ln(4);					
			$this->SetFont('Arial','BU',11);
			
								
			$this->MostrarEncabezadoTabla($titulo_columnas,$ancho_columnas);
			

			// Datos
			$n = 0; 	// Número n impreso
			$i = 0;		// Indice del inscripto procesado

			$this->SetFont('Arial','',8);
	
			foreach($datos_inscriptos as $indice=>$valor)	{
				$n++;
				$i++;

				$nombre = $valor['pers_apellido']." ".$valor['pers_nombre'];
				$lineas_nom = $this->WordWrap($nombre,34);				
				$lineas_org = $this->WordWrap($valor['jurisdnom'],34);
				
				$lineas = max($lineas_org, $lineas_nom);
	
				if ($lineas==1)
					$lineas=2;

				if ($this->pag_x_inscripto != "S") {			//	Más de 1 persona por hoja								
					if(($this->altoLineaDefault*$lineas)+10 > $this->altoMaxPag-$this->GetY()) { //  Si el alto para la siguente fila no es suficiente agrego una pagina
						$this->AddPage($this->orientacionPagina);
						$this->MostrarCabecera();
						$this->MostrarEncabezadoTabla($titulo_columnas,$ancho_columnas);
					}
				}			

				$this->CellCompress($ancho_columnas[0],$this->altoLineaDefault*$lineas,$nombre,1,0,'LR');				
				$this->CellCompress($ancho_columnas[1],$this->altoLineaDefault*$lineas,$valor['jurisdnom'],1,0,'LR');
				$this->CellCompress($ancho_columnas[2],$this->altoLineaDefault*$lineas,$valor['pers_cuilt'],1,0,'C');

				$lineas_escalafon = $this->WordWrap($valor['escalafnom'],50);
								
				$this->CellCompress($ancho_columnas[3],$this->altoLineaDefault*$lineas,$valor['escalafnom'],1,0,'LR');				
				$this->CellCompress($ancho_columnas[4],$this->altoLineaDefault*$lineas,$valor['escalafnivdesc'],1,0,'C');				
				$this->CellCompress($ancho_columnas[5],$this->altoLineaDefault*$lineas,$valor['escalaftramodesc'],1,0,'C');	
				$this->CellCompress($ancho_columnas[6],$this->altoLineaDefault*$lineas,$valor['escalafgradodesc'],1,0,'C');	

				$this->Ln();				
			    $this->CellCompress(array_sum($ancho_columnas),0,'','T');
				$this->Ln();

				//$this->pag_x_inscripto == "S"

				if (true) {		// Si es una notificación por hoja
					$this->MostrarPie(); 					// Van las firmas
//					if($i<count($datos_inscriptos)) {		// Si queda otro inscripto agrego una hoja con los encabezados para el proximo
						$this->AddPage($this->orientacionPagina);
						$this->MostrarCabecera();
						//$this->MostrarEncabezadoTabla($titulo_columnas,$ancho_columnas);
						//$n=0;
//					}
				}	
				
			}
	}		
	//------------------------------------------------------------------------
	function MostrarEncabezadoTabla($titulo_columnas, $ancho_columnas) {
		$this->SetFont('Arial','',10);
		$this->SetTextColor(0);
		for($i=0;$i<count($titulo_columnas);$i++)
			$this->Cell($ancho_columnas[$i],12,$titulo_columnas[$i],1,0,'C',0);
		$this->Ln();
		$this->SetTextColor(0);
		$this->SetFont('Arial','',8);
	}
	//------------------------------------------------------------------------
	function MostrarPie() { // No hay firma 
	}
	//------------------------------------------------------------------------
	function MostrarConstanciaCreditos($formato) {
	
		$this->Image($this->imagenLogo,$this->lMargin+$this->xContenido,$this->tMargin+2,190,0);

		$this->SetFont('Arial','BI',12);
		$this->Ln(30);	
    	$this->MultiCellMaxLine($this->anchoMaxTexto,10,
								"SISTEMA NACIONAL DE CAPACITACION\n CONSTANCIA DE CERTIFICACION DE CREDITOS",$this->ver_borde,'C',0,2);
		$this->Ln(4);	
		$this->SetFont('Arial','BU',11);
    	$this->MultiCellMaxLine($this->anchoMaxTexto,10,
								"DATOS DE LA ACTIVIDAD",$this->ver_borde,'L',0,2);
		$this->SetFont('Arial','',10);
		
		$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'ACTIVIDAD: '.$this->Get('act_nombre'),$this->ver_borde,'L',0,2);
		$this->Ln(1);								
		$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'CÓDIGO INAP: '.$this->Get('act_codinap'),$this->ver_borde,'L',0,2);
		$this->Ln(1);								
		$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'TIPO DE ACTIVIDAD: '.$this->Get('actform_tipoact_desc'),$this->ver_borde,'L',0,2);
		$this->Ln(1);								
		$this->MultiCellMaxLine($this->anchoMaxTexto,$this->altoLineaDefault,
								'OBSERVACIONES: '.$this->Get('act_obs'),$this->ver_borde,'L',0,2);


		// Inscriptos 
		$this->MostrarInscriptos();

		if ($this->pag_x_inscripto!= "S") 			// Si van varios inscriptos por hoja las firmas van al final
			$this->MostrarPie();				
			
	}
	//------------------------------------------------------------------------
	function Footer() { }
} // fin clase	
?>