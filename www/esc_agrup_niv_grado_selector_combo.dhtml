	//----------------------------------------------------------------------------------------- 
	function validarEscalafon (docu, idDivDatosApn, idDivOrganismo ,idDivOrganismoTipo, escalafon) {


		var elSelect = docu.getElementById(idDivDatosApn);
		var elSelectOrg = docu.getElementById(idDivOrganismo);	
		var elSelectTipo = docu.getElementById(idDivOrganismoTipo);		
	
		if (escalafon == '<?= SINEP ?>') {
			elSelect.style.display ="block";
			elSelectOrg.style.display ="block";		
			elSelectTipo.value ="A";		
		} else {
			elSelect.style.display ="none";		
			elSelectOrg.style.display ="block";				
			elSelectTipo.value ="T";				
		}
		/*
		alert('escalafon =' + escalafon);

alert('elSelectTipo =' + elSelectTipo.value);

		*/
	}
</script>

