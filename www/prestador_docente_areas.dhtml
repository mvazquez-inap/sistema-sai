								<input type="hidden" name="areacon_codigo" id="areacon_codigo" value="<?php echo isset($_GET['areacon_codigo'])?$_GET['areacon_codigo']:"" ?>" />				  
								<input type="hidden" name="areagen_codigo" id="areagen_codigo" value="<?php echo isset($_GET['areagen_codigo'])?$_GET['areagen_codigo']:"" ?>" />				  
								<input type="hidden" name="areaesp_codigo" id="areaesp_codigo" value="<?php echo isset($_GET['areaesp_codigo'])?$_GET['areaesp_codigo']:""?>" />				  
							</td>
						</tr>					
