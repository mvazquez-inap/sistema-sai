//-----------------------------------------------------------------------------------------------------
	function TienePermisoModificarActividadPrestador($act_codigo,$rolcod,$jurisdid) {

		if (!$this->TraerDatosActividadCurso($act_codigo,$fila_actividad_curso,$es_modif_act_curso))
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;
		if (!$es_modif_act_curso)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Curso a modificar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		if 	($rolcod == SUPERUSUARIO)
			return true;

		if 	($rolcod == USUCURSOINAP || $rolcod == USUACTINS)  {
			if ($fila_actividad_curso['actcur_estado'] == ACTCURSOACTIVO)
				return true;
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), no le permite modificarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		} elseif ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO ||  $rolcod ==  USUACTJUR ) { // Agrego el enalce

			 if ($fila_actividad_curso['jurisdid_inap'] == $jurisdid) { // Se verifica jurisdiccion

				 if($rolcod ==  USUACTJUR) {

					 if ($fila_actividad_curso['actcur_estado'] == ACTCURSOACTIVO) // Nuevo el enlace modifica equipo docente de lo aprobado
							return true;
						else {
							$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), no le permite modificarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
							return false;
						}

				 } else {
						if ($fila_actividad_curso['actcur_estado'] == ACTCURSOACTIVO || $fila_actividad_curso['actcur_estado'] == ACTCURSONUEVO || $fila_actividad_curso['actcur_estado'] == ACTCURSORECHAZADO )
						 // || $fila_actividad_curso['actcur_estado'] == ACTCURSOACTIVO // ya no modifica activos
							return true;
						else {
							$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
							FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), no le permite modificarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
							return false;
						}
				}
			 } else {

 				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene acceso a modificar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
//-----------------------------------------------------------------------------------------------------
	function TienePermisoBaja($act_codigo,$rolcod,$jurisdid) {

		// Valida el estado con rol y la jurisdicción, NO valida si tiene o no dictamen la actividad.
		if (!$this->TraerDatosActividadCurso($act_codigo,$fila_actividad_curso,$es_modif_act_curso))
			return false;

		$txt_sys_mail="\nact_codigo=".$act_codigo;
		if (!$es_modif_act_curso)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error, no existe la Actividad Curso a eliminar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;
		}

		if 	($rolcod == USUCURSOINAP || $rolcod == USUACTINS )  {
			if ($fila_actividad_curso['actcur_estado'] == ACTCURSOACTIVO)
				return true;
			else {
				$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), no le permite eliminarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		} elseif ($rolcod == COORDINADORTECNICO  ||  $rolcod ==  USUORGANISMO) {
			 if ($fila_actividad_curso['jurisdid_inap'] == $jurisdid) {
					if ($fila_actividad_curso['actcur_estado'] == ACTCURSONUEVO || $fila_actividad_curso['actcur_estado'] == ACTCURSORECHAZADO)
						return true;
					else {
						$this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$fila_actividad_curso['actcur_estado'],"'"),$descri,$numfilas,$errorcod);
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El estado de la Actividad Curso (".$descri."), no le permite eliminarla.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
						return false;
					}
			 } else {
 				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene acceso a eliminar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;
			}
		}

		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para eliminar la Actividad Curso.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
