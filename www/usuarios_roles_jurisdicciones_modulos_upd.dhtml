function MostrarOcultar (objetoVisualizar) 
{
	var objeto=EncontrarObjeto(objetoVisualizar);
	
	if (objeto.style.display=='none') 
		objeto.style.display='';

	
}
function Ocultar (objetoVisualizar) 
{
	var objeto=EncontrarObjeto(objetoVisualizar);
	objeto.style.display='none';
}

function Validarjs(formulario) 
	{
		<?php
		$spnombremodulos="sel_modulos_gruposmod_modulos_orden";
		$spparammodulos=array('porderby'=>"modulocod");
		$conexion->ejecutarStoredProcedure($spnombremodulos,$spparammodulos,$querymodulos,$numfilas,$errorcod);
		while($filamodulos=mysqli_fetch_assoc($querymodulos))
		{?>
			formulario.checkbox_<?=$filamodulos['modulocod']?>.disabled=false;
		<?php }?>
		return true;
	}



function ChequearTodos(formulario){
	//chequea todos los checks
	
	<?php
	$spnombremodulos="sel_modulos_gruposmod_modulos_orden";
	$spparammodulos=array('porderby'=>"modulocod");
	$conexion->ejecutarStoredProcedure($spnombremodulos,$spparammodulos,$querymodulos,$numfilas,$errorcod);
	while($filamodulos=mysqli_fetch_assoc($querymodulos)){?>
		if(formulario.checkbox_<?=$filamodulos['modulocod']?>.disabled==false)
			formulario.checkbox_<?=$filamodulos['modulocod']?>.checked=true;
	<?php }?>	
	
}

