	function MostrarDatosProgramaciones($conexion, $oActividad, $act_codigo, $tipoact_codigo) {
	
		$ArregloDatos = array('act_codigo'=> $act_codigo,
							  'tipoact_codigo'=>$tipoact_codigo,					
							  'orderby'=>'actprog_fecha_inicio');
	
		if (!$oActividad->BuscarActividadDictaminada($ArregloDatos,$numfilas,$resultDictamenes,$error,$errormail)) {
			$txt_sys_mail="Error al buscar dictamen de la actividad.\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al buscar dictámenes",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		} elseif($numfilas>0) { 
	?>
		<table width="100%" class="textoTablaDato" align="center" cellpadding="2">
			<tr>
				<td colspan="2" >
					<table width="100%" class="textoTablaDato" align="center">
					<tr>
						<td> 
						<?php
			
							$opciones=array(
								"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
								"NombrePaginaQuery"=>"pagina",
								"FilasPagina"=>$numfilas
							);
							
							if (isset($_GET['pagina']))	{
								$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
								$opciones['QueryString']=$querystring;
							}
							
							$oGrilla = new cGrilla($opciones);
					
							$oGrilla->SetearTituloGrilla('Programaciones');	
							$oGrilla->SetearAnchoGrilla('100%');
							
							$miColumna1 = $oGrilla->AddColumna('txt');
							$oGrilla->Setear('titulo_columna',$miColumna1,'Vigencia Desde');
							$oGrilla->Setear('campo_grilla',$miColumna1,'actprog_fecha_inicio_ddmmaaaa');
							$oGrilla->Setear('align_columna',$miColumna1,'center');
							$oGrilla->Setear('ancho_columna',$miColumna1,'80');
																			
							$miColumna2 = $oGrilla->AddColumna('txt');
							$oGrilla->Setear('titulo_columna',$miColumna2,'Vigencia Hasta' );
							$oGrilla->Setear('campo_grilla',$miColumna2,'actprog_fecha_fin_ddmmaaaa');
							$oGrilla->Setear('align_columna',$miColumna2,'center');
							$oGrilla->Setear('ancho_columna',$miColumna2,'80');
							
							if (!$oGrilla->CargarGrilla($resultDictamenes))
								return false;
								
							$oGrilla->MostrarGrilla();
					?>
						</td>
					</table>
				</td>
			</tr>
		</table>
				<?php 
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function AltaDatosDictamen($datos,&$dic_codigo_nuevo) {

		if(!$this->_DatosValidosAltaDictamen($datos,$datosvalidados))
			return false;
		
		//creo dictamen
		$spnombre="ins_dictamen";
		$spparam=array(
			'pdis_codigo'=> "NULL",
			'pdic_fecha'=> date("Y/m/d H:i:s"),
			'pdic_pertinencia'=>$datosvalidados['dic_pertinencia'],
			'ppondtipopond_codigo_cal_pres'=> $datosvalidados['pondtipopond_codigo_cal_pres'],
			'ppondtipopond_codigo_int'=> $datosvalidados['pondtipopond_codigo_int'],
			'ppondtipopond_codigo_proc_eva'=> $datosvalidados['pondtipopond_codigo_proc_eva'],
			'pdic_observaciones'=> $datosvalidados['dic_observaciones'],
			'pdic_estado'=> DICTAMENNUEVO,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);
			
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar el Dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$dic_codigo_nuevo = $this->conexion->ultimocodigoinsertado();
	
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function PedirAprobacionDictamen($datos) {
	
		if ($datos['tipoact_codigo'] == TIPOACTAUTODOCENTE || 
			$datos['tipoact_codigo'] == TIPOACTAUTOEVACT ||
			$datos['tipoact_codigo'] == TIPOACTAUTOPUBLI ||
			$datos['tipoact_codigo'] == TIPOACTAUTOASISTEC ||
			$datos['tipoact_codigo'] == TIPOACTAUTOAAUTOFORM 		
			) {
			
			if(!$this->_DatosValidosPedidoAprobacionDictamenPersonal ($datos))
				return false;
			
		} else {
				if(!$this->_DatosValidosPedidoAprobacionDictamen($datos))
					return false;
		}
			
		$spnombre="upd_dictamen_cambio_estado_xdic_codigo";
		$spparam=array(
			'pdic_estado'=>DICTAMENPENDIENTEAPROBACION,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'pdic_codigo'=>$datos['dic_codigo']
			);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al realizar el pedido de aprobación del dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		
		return true;
	}
	
//-----------------------------------------------------------------------------------------------------	
	function AsignarDisposicion($datos) {
	
		if ($datos['tipoact_codigo'] == TIPOACTAUTODOCENTE || 
			$datos['tipoact_codigo'] == TIPOACTAUTOEVACT ||
			$datos['tipoact_codigo'] == TIPOACTAUTOPUBLI ||
			$datos['tipoact_codigo'] == TIPOACTAUTOASISTEC ||
			$datos['tipoact_codigo'] == TIPOACTAUTOAAUTOFORM 		
			) {
			
			if(!$this->_DatosValidosAsignarDisposicionPersonal($datos))
				return false;
			
		} else {
			
			if(!$this->_DatosValidosAsignarDisposicion($datos))
				return false;
		}	
		$spnombre="upd_dictamen_asigno_disposicion";
		$spparam=array(
			'pdic_codigo'=>$datos['dic_codigo'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'pdis_codigo'=>($datos['dis_codigo']=="")?"NULL":$datos['dis_codigo']
			);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al realizar la asignacion de la disposición.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}	
		
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function ArmarMensajeEvaluar($datos,$operacion,&$mensaje) {
		$result = true;
		$oActividad = new cActividad($this->conexion);
		if ($oActividad->TraerDatosActividad($datos['act_codigo'],$fila_act,$es_modif)) {
		
			$mensaje = " INAP ha ".$operacion." el dictamen asociado la siguiente actividad\n";
			$mensaje .= " Nombre:   ".$fila_act['act_nombre']."\n";	
			$mensaje .= " Código INAP:   ".$fila_act['act_codinap']."\n";			
			$mensaje .= " Aclaraciones:   ".$datos['aclaracion_mail']."\n";	;		

			if(isset($datos['pers_codigo'])) {
				$oPersonas=new cPersonas($this->conexion);
				if(!$oPersonas->TraerDatosPersona_xCod($datos["pers_codigo"],$datospersona,$es_modif)) {
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$mensaje,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$mensaje .= "\n Datos Personales:\n";
				$mensaje .= " CUIT/CUIL/CDI:".$datospersona['pers_cuilt']."\n";
				$mensaje .= " Apellido y Nombre: ".$datospersona['pers_apellido'].", ".$datospersona['pers_nombre']."\n";
			} 		

		} else 
			$result = false;

		return $result;
	}	
	
	
