	$array_msg_pantalla =array("formato" => FMT_TEXTO);	
	$array_msg_pantalla+=array("texto" => "Error en selección de archivos. ");
	
	$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
	$array_msg_mail+=array("texto" => $array_msg_pantalla['texto']);
	
	MostrarMensaje($idconexion,MSG_ERRSOSP,$array_msg_pantalla,$array_msg_mail);
*/
//----------------------------------------------------------------------------------------- 
// Muestra un mensaje en pantalla y/o envía mail a ADMIONTI
//	Parametros: 
//	$mensajepantalla (array asociativo)
//		$mensajepantalla['formato']=FMT_TEXTO|FMT_TABLA
//		$mensajepantalla['cantcols'] usado para colspan cuando es FMT_TABLA
//		$mensajepantalla['texto'] = texto a mostrar por pantalla
//	$mensajemail (array asociativo) para enviar mail al administrador definido en la conexion
//		$mensajemail['archivo'] = nombre php de llamada
//		$mensajemail['funcion'] = nombre función de llamada
//		$mensajemail['linea'] = línea de llamada
//		$mensajemail['texto'] = texto a mostrar por mail

function MostrarMensaje($idconexion,$nivelmensaje,$arraymensajepantalla,$arraymensajemail=array())	{

	if(count($arraymensajepantalla)>0)	{ // mostrar el mensaje en pantalla

		if(!isset($arraymensajepantalla['formato']))
				$arraymensajepantalla['formato']=FMT_TEXTO;	
	
			if(!isset($arraymensajepantalla['texto']))
				$arraymensajepantalla['texto']=" ";
	
			if ($nivelmensaje==MSG_ERRGRAVE) 
				$arraymensajepantalla['texto']="<div class='textoMensajeError'>".$arraymensajepantalla['texto']."<BR>"."Avise a su Administrador o a la ONIG. </div>";
	
			switch($arraymensajepantalla['formato']) {
				case FMT_TEXTO:
					echo "<p align='center' class='textoMensaje'>".$arraymensajepantalla['texto']."<br>";	
					break;
				case FMT_TABLA:
					if(!isset($arraymensajepantalla['cantcols']))
						$arraymensajepantalla['cantcols']=1;	
					?>
						<tr>
							<td colspan="<?php echo $arraymensajepantalla['cantcols'] ?>" class="textoMensaje" height="100" align="center" valign="middle">
								<span class='textonombreclave'><?php echo $arraymensajepantalla['texto'] ?></span>
							</td>
						</tr>	
					<?php
					break;
				default:
					echo $arraymensajepantalla['texto'];	
					break;
			}
	} // mostrar en pantalla

	if(count($arraymensajemail)>0)	{ // envio de mail

		if(!isset($arraymensajemail['texto']))	{
			$arraymensajemail['texto']=" ";
			if(isset($arraymensajepantalla['texto']))
				$arraymensajemail['texto']=$arraymensajepantalla['texto'];
		}
	
		$subjectmail.="( ".SISTEMA.' - '.$_SERVER['SERVER_NAME']." )";

		//$subjectmail=SISTEMA;
		
		switch($nivelmensaje)	{
			case MSG_OK:
				$subjectmail.=" - Mensaje OK";
				break;
			case MSG_INF:
				$subjectmail.=" - Mensaje Informativo";
				break;
			case MSG_ERRGRAVE:
				$subjectmail.=" - Error de Inconsistencia de Datos";
				break;
			case MSG_ERRSOSP:
				$subjectmail.=" - Error Datos Sospechosos";
				break;
			case MSG_ERRPGM:
				$subjectmail.=" - Error en Programa";
				break;
			default:
				$subjectmail.=" - Nivel de mensaje no definido";
				break;
		}


		$textomail ="\nSituación a informar:\n".$arraymensajemail['texto']."\n\n";
		$textomail.="Ejecutando Archivo: ".$_SERVER['PHP_SELF']."\n";

		if(isset($arraymensajemail['archivo']))
			$textomail.="Ubic Archivo:       ".$arraymensajemail['archivo']."\n";
		if(isset($arraymensajemail['funcion']))
			$textomail.="Ubic Función:       ".$arraymensajemail['funcion']."\n";
		if(isset($arraymensajemail['linea']))
			$textomail.="Ubic Línea:         ".$arraymensajemail['linea']."\n";
		if(isset($_SESSION['usuariocod']) && $_SESSION['usuariocod']!=0)
			$textomail.="\nUsuario sesion:     ".$_SESSION['usuariocod']."\n";

		MandarMail($idconexion,ADMI_SISTEMA,"",$subjectmail,$textomail);
	} // envio del mail
}
//----------------------------------------------------------------------------------------- 
function Comienzo_pagina($pagina,$tamano_pagina) {
	$inicio = ($pagina - 1) * $tamano_pagina; 
	return $inicio;
}
//----------------------------------------------------------------------------------------- 
function ArrayToArray_Delimitado($ArrayValores,$TextoComienzo,$Separador,$TextoFinal){

	$ArrayFinal=array();
	$ArrayFinal[]=$TextoComienzo;
	if (count($ArrayValores)>0) {
		foreach($ArrayValores as $valor) {
			$ArrayFinal[]=$valor;
			$ArrayFinal[]=$Separador;
		} // fin - foreach
	} // fin - if	
	$ArrayFinal[count($ArrayFinal)-1]=$TextoFinal;
	return $ArrayFinal;
}
//----------------------------------------------------------------------------------------- 
function Array_column_sort()   {
	$args = func_get_args();
	$array = array_shift($args);
	$sort_array=array();
   
	// make a temporary copy of array for which will fix the
	// keys to be strings, so that array_multisort() doesn't
	// destroy them
	$array_mod = array();
	foreach ($array as $key => $value)
		$array_mod['_' . $key] = $value;
   
	$i = 0;
	$multi_sort_line = "return array_multisort( ";
	foreach ($args as $arg)
	{
		$i++;
		if ( is_string($arg) )
		{
			foreach ($array_mod as $row_key => $row)
			{
				$sort_array[$i][$row_key] = $row[$arg];
			}
		}
		else
		{
			$sort_array[$i] = $arg;
		}
		$multi_sort_line .= "\$sort_array[" . $i . "], ";
	}
	$multi_sort_line .= "SORT_ASC,\$array_mod );";

	eval($multi_sort_line);

	// now copy $array_mod back into $array, stripping off the "_"
	// that we added earlier.
	$array = array();
	foreach ($array_mod as $key => $value)
		$array[ substr($key, 1) ] = $value;

	return $array;
}
