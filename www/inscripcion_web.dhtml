			$comi_codigo = $_GET['comi_codigo'];
			if ($oComisionPersona->TraerDatosComision($comi_codigo,$filacomision,$es_modif)) {
				if (!$es_modif) {
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisi&oacute;n.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				} else {
					$ok=true;
				} // Tiene permiso el usuario sobre la comision

			} // No se produjo error al buscar la comisi&oacute;n
		} else {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisi&oacute;n.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

		}

if ($ok) {
