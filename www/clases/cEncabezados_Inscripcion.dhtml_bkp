	function _MenuEmergenteJS($usuariocod,$rolcod,$jurisdid)
	{

		if($rolcod=='' || $rolcod==0)
			return false;
	
		$param=array('pusuariocod'=>$usuariocod,'prolcod'=>$rolcod,'pjurisdid'=>($rolcod==USUACTJUR)?0:$jurisdid);
		if(!$this->conexionencab->ejecutarStoredProcedure("sel_menusuperior",$param,$menuprinc,$numfilas,$errno))
			return false;
	
		echo '<script language="javascript" type="text/javascript">'."\n";
		echo "<!--\n";
		echo 'function CargarMenues()'."\n";
		echo '{'."\n";

		while ($filaprinc = mysql_fetch_assoc($menuprinc)) 
		{ 
			echo 'window.mm_menu_'.$filaprinc['grupomodcod'];
			echo ' = new Menu("root",250,17,"Verdana, Arial, Helvetica, sans-serif",10,"'.COLOR_TEXTO_MENU_N2.'","'.COLOR_TEXTO_MENU_N2_SELECTED.'","'.COLOR_MENU_N2.'","'.COLOR_MENU_N2_SELECTED.'","left","middle",3,0,1000,-5,7,true,true,true,0,true,true);'."\n";

			$param=array('pusuariocod'=>$usuariocod,'prolcod'=>$rolcod,'pjurisdid'=>($rolcod==USUACTJUR)?0:$jurisdid,'pgrupomodcod'=>$filaprinc['grupomodcod']);
			if(!$this->conexionencab->ejecutarStoredProcedure("sel_menuizquierdo",$param,$menusecund,$numfilas,$errno))
				return false;

			while ($filasecund = mysql_fetch_assoc($menusecund)) 
			{ 
				echo 'mm_menu_'.$filaprinc['grupomodcod'];
				echo '.addMenuItem("'.htmlspecialchars($filasecund['modulotextomenu'],ENT_QUOTES).'", "location=\''.htmlspecialchars($filasecund['archivonom'],ENT_QUOTES).'\'");'."\n";
			}
			echo 'mm_menu_'.$filaprinc['grupomodcod'].'.hideOnMouseOut=true;'."\n";
			$ultcod=$filaprinc['grupomodcod'];
		}

		echo 'mm_menu_'.$ultcod.'.writeMenus();'."\n";
		echo '}'."\n";
		echo 'CargarMenues();'."\n";
		echo '//-->'."\n";
		echo '</script>'."\n";
	}

	function _MenuEmergente($usuariocod,$rolcod,$jurisdid)
	{
		if($rolcod=='' || $rolcod==0)
			return false;

		// se piden todos los gruposmod que tengan 'S' o 'L' 
		// en modulomostrar
		$param=array('pusuariocod'=>$usuariocod,'prolcod'=>$rolcod,'pjurisdid'=>($rolcod==USUACTJUR)?0:$jurisdid);
		if(!$this->conexionencab->ejecutarStoredProcedure("sel_menusuperior",$param,$menuprinc,$numfilas,$errno))
			return false;
?>	
			<table width='100%' border='0' cellspacing='0' cellpadding='0'>
				<tr>
					<td class='colorLineaMenuIzq' colspan="2">&nbsp;</td>
				</tr>
<?php
		
	
		if ($_SESSION['sistema_a_bloquear'] == "NO") 
			$top=165;
		else 
			$top=132;		
			
		while ($filaprinc = mysql_fetch_assoc($menuprinc)) 
		{ 
			$param=array('pusuariocod'=>$usuariocod,'prolcod'=> $rolcod,'pjurisdid'=>($rolcod==USUACTJUR)?0:$jurisdid,'pgrupomodcod'=>$filaprinc['grupomodcod']);
			if(!$this->conexionencab->ejecutarStoredProcedure("sel_menuizquierdo",$param,$menusecund,$numfilas,$errno))
				return false;
				
			// si tiene una sola fila con 'L' en modulomostrar 
			// es porque no tiene submenu
			// pone link en el menú principal izquierdo	
			$filasecund = mysql_fetch_assoc($menusecund); 

			if($numfilas==1 && $filasecund['modulomostrar']=="L")
			{
?>
				<tr>
					<td class="textoMenuIzquierdo" height="20" colspan="2"> 
						<a href="<?php echo htmlspecialchars($filasecund['archivonom'],ENT_QUOTES) ?>"  class="linkMenuEmergente"><?php echo htmlspecialchars($filaprinc['grupomodtextomenu'],ENT_QUOTES) ?></a>
					</td>
				</tr>
<?php			
			}
			else
			{
?>				<tr id="ho_<?php echo $filaprinc['grupomodcod'] ?>" style="cursor:pointer;" onmouseover="window.MM_showMenu(window.mm_menu_<?php echo $filaprinc['grupomodcod'] ?>,138,<?php echo $top ?>,'','','ho_<?php echo $filaprinc['grupomodcod'] ?>','#BB8BDF','#E0C2EF');" onmouseout="MM_startTimeout()" class="textoMenuIzquierdo">
					<td width="85%"  align="left" height="20"> 
						<?php echo htmlspecialchars($filaprinc['grupomodtextomenu'],ENT_QUOTES) ?>
					</td>
					<td width="15%" align="right" >
						<img src="images/flecha_nar.gif" width=13 height="13" hspace=3 align="middle" alt="flechita">
					</td>
				</tr>
<?php			
			}
			$top+=20;
		}
?>
			</table>
<?php
	}

