	function ListarDictamenActAutodesarrollo($array_DictamenesActAuto) { 
	
    $primero = true;
	if (count($array_DictamenesActAuto)==0) 
		return; 
?>
	<table border="1" class="textoTablaDato" style="width:1970px;" cellspacing="2" cellpadding="2" align="left"> 
<?php		foreach ($array_DictamenesActAuto as $fila_dictamenAct ) { 
