<?php class cTablaOrganismoPublico extends cTablaSysDesc {

	public function __construct($conexion) {
		
		$array_campos=array('clave'=> 'orgapub_codigo',
							'estado'=>'orgapub_estado',
							'descripcion'=>array('nombre_campo'=>'orgapub_nombre', 'long_campo'=>255,'titulo_campo'=>'Organismo'),
							'fecha_alta'=>'orgapub_falta',
							'fecha_baja'=>'orgapub_fbaja');

		parent::__construct($conexion,"organismo_publico",$array_campos);
		$this->SetearTituloTabla('Organismo Público');
	
		// Array con los cógigos de operaciones a ser registradas
		$array_log=array('ins'=>'35501', 'upd'=>'35503', 'del'=>'35502','chg_estado'=>'35504');
		$this->SetearLogs($array_log);
	
		// Array con las tablas en las que se busca para determinar si la baja es física o lógica.
		$array_tablas=array();
	
		$array_tablas[]=array('nom_tabla'=>'actividad_autodesarrollo_evento','campo_tabla'=>'orgapub_codigo');
		$array_tablas[]=array('nom_tabla'=>'actividad_curso_diseno_institucional','campo_tabla'=>'orgapub_codigo');
		$array_tablas[]=array('nom_tabla'=>'actividad_externa','campo_tabla'=>'orgapub_codigo');
		$array_tablas[]=array('nom_tabla'=>'agente','campo_tabla'=>'orgapub_codigo');
		$array_tablas[]=array('nom_tabla'=>'comision_persona','campo_tabla'=>'orgapub_codigo');
		$array_tablas[]=array('nom_tabla'=>'actividad_externa_persona','campo_tabla'=>'orgapub_codigo');
		$array_tablas[]=array('nom_tabla'=>'actividad_autodesarrollo_persona','campo_tabla'=>'orgapub_codigo');
		$array_tablas[]=array('nom_tabla'=>'prestador_docente','campo_tabla'=>'orgapub_codigo');
		$this->SetearTablasTipoBaja($array_tablas);
	}		
} ?>