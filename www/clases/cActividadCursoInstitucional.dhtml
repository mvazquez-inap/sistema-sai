 //-----------------------------------------------------------------------------------------------------	
	function ListarDisenoActividadPDF($act_codigo) {
	
		function GenerarActividadDiseno(&$pdf,$filacurso) {
	
			$pdf->AddAcividadDiseno();
			$pdf->Set('datos_actividad',$filacurso);		
			$pdf->Set('formact_codigo',FORMATOCURSO);
			$pdf->Set('tipoact_codigo',$filacurso['actividad_curso']['tipoact_codigo']);
		
		} // GenerarActividadDiseno
	
	
		if (!$this->TraerDatosActividadCursoInstitucional($act_codigo,$filacurso,$es_modif))  {
			$txt_sys_mail="\nact_codigo=".$act_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error, buscando la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			return false;		
		} elseif (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"No se ha encontrado la Actividad con el formato buscado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;		
		}
	
	
		$ok=$this->ObtenerOrganismoInstitucion($filacurso['actividad_curso_institucional']['orgapri_codigo'],
												$filacurso['actividad_curso_institucional']['jurisdid_apn'],
												$filacurso['actividad_curso_institucional']['orgapub_codigo'],				
												$jurisdnom,$sector_org,$tipoorg_codigo,$jurisdid);
	
		
		if ($ok) {	
			if ($sector_org==ORGANISMO_PUBLICO) 
				$filacurso['actividad_curso_institucional'] += array('org_publico_nom'=>$jurisdnom);
	
			if ($sector_org==ORGANISMO_PRIVADO) 
				$filacurso['actividad_curso_institucional'] += array('org_privado_nom'=>$jurisdnom);
		}
	
		$descri	= "";	
		if($this->conexion->TraerCampo("paises","paisnom",array("paiscod='",$filacurso['actividad_curso_institucional']['pais_codigo'],"'"),$descri,$numfilas,$errorcod))
			$filacurso['actividad_curso_institucional'] += array('paisnom'=>$descri);
	
		if ($filacurso['actividad_curso_institucional']['pais_codigo'] == ARGENTINA) { 
			$descri	= "";	
			if ($this->conexion->TraerCampo("provincias","provincianom",array("provinciacod='",$filacurso['actividad_curso_institucional']['prov_codigo'],"'"),$descri,$numfilas,$errorcod))
				$filacurso['actividad_curso_institucional'] += array('provincianom'=>$descri);		
		}
		
		$descri="";
		if ($this->conexion->TraerCampo("constantes_grales","constantedesc",array("constantetipo='","ACTCURSOESTADO","' and constantecod='",$filacurso['actividad_curso']['actcur_estado'],"'"),$descri,$numfilas,$errorcod)) 
			$filacurso['actividad_curso'] += array('actcur_estado_desc'=>$descri);
	 
	
		$pdf = new cActividadDisenoPDF();
		GenerarActividadDiseno($pdf,$filacurso); 
		$pdf->MostrarActividadDiseno($this->conexion);
		$pdf->Output("disenoActividad.pdf","I");
	
		return true;
	}
