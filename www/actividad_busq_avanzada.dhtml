//--------------------------------------------------------------------------------------------------
function hayDatosCurso($array_fila_grilla) {

if ( $array_fila_grilla['Curso'] == "si" )  
 	return true;
else 
	return false;
}
//--------------------------------------------------------------------------------------------------
function hayDatosAuto($array_fila_grilla) {

if ( $array_fila_grilla['Auto'] == "si" )  
 	return true;
else 
	return false;
}
//--------------------------------------------------------------------------------------------------
function hayDictamen($array_fila_grilla) {

if ( $array_fila_grilla['Formal'] != "si" )  
 	return true;
else 
	return false;
}
//--------------------------------------------------------------------------------------------------
function hayDatosForm($array_fila_grilla) {

if ( $array_fila_grilla['Formal'] == "si" )  
 	return true;
else 
	return false;
}

//--------------------------------------------------------------------------------------------------
function hayDatosExt($array_fila_grilla) {

if ( $array_fila_grilla['Ext'] == "si" )  
 	return true;
else 
	return false;
}

