if (isset($_GET['act_codigo'])) {
// buscar todos los tipos de la actividad

	$operacion = "E";
	$operacion_evento = "V";	
	$ok = false;
	
	$act_codigo=htmlspecialchars($_GET['act_codigo'],ENT_QUOTES);
	$tipoact_codigo=htmlspecialchars($_GET['tipoact_codigo'],ENT_QUOTES);
	
	if ($oActividadAutodesarrollo->TraerDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo,$filaauto,$es_modif)) {
		if (!$es_modif) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else {
			if ($oActividadAutodesarrollo->TienePermisoEliminar($filaauto['actividad']['act_codigo'],$tipoact_codigo,$_SESSION['rolcod'])) {
					$oDictamen = new cDictamen($conexion);
					$ArregloDatos=array(	
									'act_codigo'=>$filaauto['actividad']['act_codigo'],
									'tipoact_codigo'=>$filaauto['actividad_autodesarrollo']['tipoact_codigo'],										
									);
					$oDictamen->BuscarDictamen($ArregloDatos,$numfilas,$array_resultado,$error,$errormail);
					if($error) {
						FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
					} else { 
						if ($numfilas>0) 
							FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"La actividad no puede ser eliminada, pues tiene dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						else // No tiene dictamen
							$ok=true;		
					}		
			} // Tiene permiso el usuario sobre la actividad	
		
		}	// Se encontró la actividad con el formato esperado		
	} // No se produjo error al buscar la actividad con el formato esperado		
	


if ($ok) {
?>
