<?php
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);
$oPrestadorDocente = new cPrestadorDocente($conexion);
//----------------------------------------------------------------------------------------- 	
$conexion->ManejoTransacciones("B");
$result=true;

if(!$oPrestadorDocente->EvaluarPrestadorDocente($_POST['presdoc_codigo'],$_POST['operacion'], $_POST,$datosvalidados))
	$result=false;

if($result) {

	if ($_POST['operacion'] == "A") {
		$operacion_mensaje = " APROBADO ";
		FuncionesPHPLocal::RegistrarAcceso($conexion,"36106","presdoc_codigo=".$_POST["presdoc_codigo"],$_SESSION['usuariocod']);
	} else  {
		$operacion_mensaje = "RECHAZADO";			
		FuncionesPHPLocal::RegistrarAcceso($conexion,"36107","presdoc_codigo=".$_POST["presdoc_codigo"],$_SESSION['usuariocod']);
	}

	$oPrestadorDocente->ArmarMensajeEvaluar ($_POST["presdoc_codigo"], $operacion_mensaje,$mensaje);
	
	// armo para
	$para = "";
	$spnombre="sel_usuarios_roles_jurisdiccion_inap_xrolcod_jurisdid";
	$spparam=array(	'prolcod'=>COORDINADORTECNICO.",".USUORGANISMO, 'pjurisdid_inap'=> $datosvalidados['jurisdid_origen']);			

	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$query_usuarios,$numfilas,$errno) )
	{
		$txt_sys_mail ="rolcod='".COORDINADORTECNICO.",".USUORGANISMO."\n jurisdid_origen = ".$datosvalidados['jurisdid_origen'];
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Se produjo un error al seleccionar los destinatarios.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;
	}
	$oUsuario=new cUsuarios($conexion);

	while ($fila_usuarios = mysqli_fetch_assoc($query_usuarios)) {
		$ArregloDatos['usuariocod']=$fila_usuarios['usuariocod'];	
		if(!$oUsuario->BuscarUsuarios($ArregloDatos,$numfilasusuarios,$resultadousuarios,$error,$errormail) || $numfilasusuarios!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error seleccionando usuarios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}
		$filausuario=mysqli_fetch_assoc($resultadousuarios);				
		$para .= $filausuario['usuarioemail']."; ";
	}

	// armo asunto
	$asunto = SISTEMA." - Evaluación de Prestador Docente";
	
	// armo cabeceras
	$cabeceras = "Content-type: text/plain; charset=utf-8\r\n";
	$cabeceras .= "From: ".MAIL_SISTEMA_FROM;
	
	if($para=="") {
		$txt_sys_mail="\n jurisdid_origen= ".$datosvalidados['jurisdid_origen'];
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"No hay definido un Coordinador Técnico o usuario de organismo <br> en el organismo que generó la solicitud de aprobación. <BR>",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
	} else {
		if(!mail($para,$asunto,$mensaje,$cabeceras)) {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"No se ha podido enviar el correo electrónico informando al Organismo sobre el resultado de la evaluación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		}	
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha efectuado la evaluación (".$operacion_mensaje.") del prestador docente.<br> En unos momentos el Coordinador técnico y los usuarios del organismo <br> recibirán un correo electrónico con el resultado de su evaluación.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
	}		

} else	
	$conexion->ManejoTransacciones("R");

?>		
<br><br><div align="center"><a href="prestador_docente_evaluar.dhtml" class="linkFondoBlanco">Volver</a></div>
<?php
$oEncabezados->PieMenuEmergente();
?>
