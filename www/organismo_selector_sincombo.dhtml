//----------------------------------------------------------------------------------------- 
// Arma una lista con buscador con la informacion del SP enviado

// Parametros:
// 		->spnombre y spparam se usan para armar el query
// 		->nomformulario es el nombre del formulario sobre el que está la lista
// 		->nombrelista es el nombre de la lista
// 		->clavelista y desclista son campos del query con los que arma la lista
// 		->claveselec es el registro que hay que seleccionar
// 		->textolineauno es el texto del primer option del combo, cuando no hay nada seleccionado
// 		->regactual, en caso que se haya seleccionado un option se retorna la fila completa
// 		->filas, es la cantidad de filas que muestra la lista
//		->$onchange: la accion javascript al momento de seleccionar un elemento de la lista
//		->$style: estilo a aplicar sobre el combo
//		->$multiple: si se permite que en una lista se puedan elegir mas de un item
//		->$onDbClick: la accion javascript al momento de hacer un doble click en la lista
//		->$vertextocompleto: indica si se muestra el link abajo para ver texto completo

function Armar_Lista_Buscador($conexion, $spnombre, $spparam, $nomformulario, $nombrelista, $clavelista, $desclista, $claveselec, $textolineauno, 
							  &$regactual,$filas="10", $onchange="",$style="width: 370px",$multiple=false,$onDbClick="") {

	// Cargo los registros del query seleccionado
	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$num_filas,$errno))
		return false;

?>
	<table width="95%" class="textotabla" border="0" cellpadding="2" cellspacing="2" align="center">
      <tr>
        <td width="100%" class="textoTablaDatoResaltado"><p><?php echo $textolineauno; ?></p>
          <input onKeyUp="javascript:obj1.bldUpdate('<?php echo $nomformulario?>','<?php echo $nombrelista?>');" size=80 name="inputNombreOrganismo" id="inputNombreOrganismo" class="textoInput">
        </td>
      </tr>
      <tr>
        <td width="100%">
		<?php
			echo "<select id= '".$nombrelista."' name='".$nombrelista."' size='".$filas."' class='combos' style='".$style."' onChange='".$onchange."'  ondblclick='".$onDbClick."' ".($multiple?"multiple":"").">\n";
			// Recorre el cursor desde el principio, poniendo cada fila en una linea del combo			
			while ($fila = mysqli_fetch_assoc($resultado)) { 
				if($fila[$clavelista]==$claveselec) {
					echo "<option selected value='".htmlspecialchars($fila[$clavelista],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desclista],ENT_QUOTES)." </option>\n";
					$seleccionado=true;
					$regactual=$fila;
				}
				else
					echo "<option value='".htmlspecialchars($fila[$clavelista],ENT_QUOTES)."'> ".htmlspecialchars($fila[$desclista],ENT_QUOTES)." </option>\n";
			}
			echo("</select>\n");
			
			?>        </td>
      </tr>
      <tr>
        <td><div align="center">
			<a href="javascript:void(0)" onClick="addValorPopupTipo(window.opener.document,'jurisdid',<?php echo $nombrelista?>.options[<?php echo $nombrelista?>.selectedIndex].value,<?php echo $nombrelista?>.options[<?php echo $nombrelista?>.selectedIndex].text,'tipoorg_codigo','<?php echo ORGANISMO_NO_APN?>','<?php echo $_GET['texto']?>');window.close();" title="Seleccionar"> <img src="images/activar.jpg" alt="Seleccionar" border="0"></a>
       		</div>
		</td>
      </tr>
</table>
<script type="text/javascript">
	var obj1;
	obj1 = new SelObj('<?php echo $nomformulario?>','<?php echo $nombrelista?>','inputNombreOrganismo');
	obj1.bldInitial('<?php echo $nomformulario?>','<?php echo $nombrelista?>'); 
</script>
