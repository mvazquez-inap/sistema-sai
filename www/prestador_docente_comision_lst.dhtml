<?php require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

//-----------------------------funcion grilla----------------------------------------------
function MostrarGrillaSeleccion($conexion,$presdoc_codigo) 
{	
	$oComision = new cComision($conexion);
	$oPrestadorDocente = new cComisionPrestadorDocente($conexion);
	$ArregloDatos= array();
	$ArregloDatos['presdoc_codigo']=$presdoc_codigo;

	if(!$oPrestadorDocente->BuscarComisionPrestadorDocente($ArregloDatos,$numfilas,$resultado,$error,$errormail)) {
		$txt_sys_mail="\nerror=".$error;
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error buscando los prestadores docentes de la actividad.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}


	if($numfilas>0)
	{
		$i=1;
		$arrayresult = array();
		while ($fila=mysqli_fetch_assoc($resultado))	{
					
			$ArregloDatosComision=array("comi_codigo"=>$fila['comi_codigo']);	


			if(!$oComision->BuscarComisionAvanzada($ArregloDatosComision, $numfilasComision, $resultComision, $error, $errormail)) {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"No se ha encontrado la Comisión.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$ok = false;
			}
			if ($numfilasComision == 1) { 
					$fila_comision = mysqli_fetch_assoc($resultComision);

					$conexion->TraerCampo("tipo_actividad","tipoact_descripcion",array("tipoact_codigo='",$fila_comision['tipoact_codigo'],"'"),$tipoact_descripcion,$numfilas_ta,$errorcod); 


					
					$arrayresult[$i]['act_codinap']=$fila_comision['act_codinap'];
					$arrayresult[$i]['tipoact_descripcion']=$tipoact_descripcion;
					$arrayresult[$i]['fecha_desde_hasta'] = isset($fila_comision['comi_fecha_inicio_ddmmaaaa'])?$fila_comision['comi_fecha_inicio_ddmmaaaa']."\na\n".$fila_comision['comi_fecha_fin_ddmmaaaa']:"Indefinida";
					$arrayresult[$i]['comi_codinap']= $fila_comision['comi_codinap'];
					$arrayresult[$i]['act_nombre']= $fila_comision['act_nombre'];
			}					
					
			$i++;
		}
	}
	$opciones=array(
		"numPagina"=>isset($_GET['pagina'])?$_GET['pagina']:1,
		"NombrePaginaQuery"=>"pagina",
		"FilasPagina"=>$numfilas
	);
	
	if (isset($_GET['pagina']))	{
		$querystring=FuncionesPHPLocal::ArmarQueryString("pagina","",false);	
		$opciones['QueryString']=$querystring;
	}
			
	$oGrilla = new cGrilla($opciones);
	$oGrilla->SetearAnchoGrilla('90%');




 

	$miColumna0 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna0,'Código INAP');
	$oGrilla->Setear('campo_grilla',$miColumna0,'act_codinap');
	$oGrilla->Setear('align_columna',$miColumna0,'left');

	$miColumna0 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna0,'Actividad');
	$oGrilla->Setear('campo_grilla',$miColumna0,'act_nombre');
	$oGrilla->Setear('align_columna',$miColumna0,'left');

	
	$miColumna1 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna1,'Código Comisión INAP');
	$oGrilla->Setear('campo_grilla',$miColumna1,'comi_codinap');
	$oGrilla->Setear('align_columna',$miColumna1,'left');

	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Tipo de Actividad');
	$oGrilla->Setear('campo_grilla',$miColumna2,'tipoact_descripcion');
	$oGrilla->Setear('align_columna',$miColumna2,'center');
	$oGrilla->Setear('ancho_columna',$miColumna2,'80');

	
	$miColumna2 = $oGrilla->AddColumna('txt');
	$oGrilla->Setear('titulo_columna',$miColumna2,'Realización');
	$oGrilla->Setear('campo_grilla',$miColumna2,'fecha_desde_hasta');
	$oGrilla->Setear('align_columna',$miColumna2,'left');


	if (!$oGrilla->CargarGrilla($arrayresult))
		return false;
		
	$oGrilla->MostrarGrilla();

	return true;
} 		
