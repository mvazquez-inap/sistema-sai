class cCodigoHTML
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	var $es_admin;
	
	var $chtmlcod;

	function cCodigoHTML($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->chtmlcod=$parametros["Nombre"];

		return true;
	}
	
	function Mostrar(&$salida)
	{
		if($this->chtmlcod==0)
		{
			$this->msg_error.="chtmlcod no inicializado. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		$spnombre="sel_codigohtml_xchtmlcod";
		$spparam=array("pchtmlcod"=>$this->chtmlcod);

		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$this->msg_error.="CodigoHTML error. chtmlcod: ".$this->chtmlcod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		$filacodigohtml=mysqli_fetch_assoc($query);

		if($this->comentarios)
			$salida.="<!-- CodigoHTML: ".$this->chtmlcod." -->\n";

		$salida.=$filacodigohtml["chtmlhtml"];

		if($this->comentarios)
			$salida.="<!-- /CodigoHTML: ".$this->chtmlcod." -->\n";
		
		return true;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

} // Fin clase cCodigoHTML





//----------------------------------------------------------------------------------------- 
class cVisualizaTablasPropias
{
	var $conexionobjeto;
	var $msg_error;
	var $comentarios;
	
	var $pagcod;
	var $notcod;
	var $visualizcod;
	var $tabla;
	var $parametros;
	var $es_admin;

	function cVisualizaTablasPropias($conexion,$comentarios=false,$es_admin=false)
	{
		$this->conexionobjeto = &$conexion;
		$this->msg_error="";
		$this->comentarios=$comentarios;
		$this->es_admin=$es_admin;
	}
	
	function Setear($parametros)
	{
		$this->pagcod=$parametros["pagcod"];
		$this->regdatocod=$parametros["regdatocod"];
		$this->visualizcod=$parametros["visualizcod"];
		$this->parametros=$parametros["parametros"];
		$this->tabla=$parametros["tabla"];
		return true;
	}
	
	function Mostrar(&$salida,&$noticias_mostradas)
	{
		$seprodujoerror=false;
		
		if($this->visualizcod==0 || $this->regdatocod==0)
		{
			$this->msg_error.="Regadatocod/Visualizcod no inicializados. Pagcod: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		/* deberiamos ir segun los cat seleccionados a hacer una junta contra
		   Tabla: tablas_propias_campos_descriptores 
		  */
		$spnombre="sel_tablas_propias_tablas_xregdatocod";
		$spparam=array("ptabla1"=>$this->tabla);
		$spparam+=array("ptabla2"=>$this->tabla);
		$spparam+=array("pregdatocod"=>$this->regdatocod);
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errno) || $numfilas!=1)
		{
			$this->msg_error.="Tablas propias error. Regdatocod: ".$this->regdatocod." / Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		$filaregistro=mysqli_fetch_assoc($query);
		$spnombre="sel_tablas_propias_visualizaciones_xvisualizcod";
		$spparam=array("pvisualizcod"=>$this->visualizcod);
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$spparam,$queryv,$numfilasv,$errno) || $numfilasv!=1)
		{
			$this->msg_error.="Visualizaciones error. Visualizcod: ".$this->visualizcod." /  Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		$filavisualizacion=mysqli_fetch_assoc($queryv);
		$partes=array();
		cSepararHTML::PreProcesarHTML($filaregistro,$filavisualizacion["visualizhtml"],$html);
		$partes=array();
		cSepararHTML::ProcesarHTML($html,$partes);

		if($this->comentarios)
			$salida.="<!--  Visualiza: ".$this->visualizcod." Regdatocod: ".$this->regdatocod." -->\n";

		foreach($partes as $comando)		
		{
			// si es un comando
			if(is_array($comando))
			{
				// si tengo que mostrar el valor de un campo
				if($comando["Tipo"]=="Campo")
				{
					
					if(isset($filaregistro[$comando["Nombre"]]))
					{
						$conv_SGML=false;
						if($comando["Nombre"]=="regdatodesccorta" || $comando["Nombre"]=="regdatocopete" || $comando["Nombre"]=="regdatodesclarga")
							$conv_SGML=true;
						if ( 
						isset($comando["SubTipo"]) && // agrego el isset
						$comando["SubTipo"]=="categoria_descripcion" )
						{
							$this->MostrarCampoCategoria($comando["Nombre"],$filaregistro[$comando["Nombre"]],$salida);
						}else
						{	
							$campo=new cVisualizaCampo($this->conexionobjeto,$this->comentarios,$this->es_admin);
							if($campo->Setear(array("ContCampo"=>$filaregistro[$comando["Nombre"]],"conv_SGML"=>$conv_SGML)))
							{
								if(!$campo->Mostrar($salida))
									$seprodujoerror=true;
							}
							else
								$seprodujoerror=true;
						}
						$this->msg_error.=$campo->RetornarMsgError();
						
					}
					else
					{
						$this->msg_error.="Campo ".$comando["Nombre"]." no encontrado o vacio en pagina: ".$_GET["pagina"]." / Visualizacion: ".$this->visualizcod."<br>";
						$seprodujoerror=true;
					}
				}elseif($comando["Tipo"]=="Fecha")
				{
					$salida.=FuncionesPHPPortal::ConvertirFecha($filaregistro[$comando["Nombre"]],"aaaa-mm-dd","dd/mm/aaaa");
				}
				elseif($comando["Tipo"]=="TablaPropiaAmpliada")
				{
					$salida.="&middot; <a href=\"paginas.dhtml?pagina=".$this->pagcod."\" target=\"_self\">Más información</a>";
				
				}
				elseif($comando["Tipo"]=="Pagina")
				{
					if (isset($comando["NumeroPaginaAmpliada"]) && $comando["NumeroPaginaAmpliada"]!="")
						$salida.=$comando["NumeroPaginaAmpliada"];
					else
						$salida.=$this->pagcod;
				
				}
				elseif($comando["Tipo"]=="Parametro")
				{
					$paramvisualiz=array();
					
					if($this->parametros!="" && !is_null($this->parametros))
					{			
						if(!cSepararHTML::ProcesarParametros($this->parametros,$paramvisualiz))
						{
							$this->msg_error.="Error en los parámetros de una visualizacion. Regdatocod: ".$this->regdatocod." / Visualizcod: ".$this->visualizcod."<br>";
							$seprodujoerror=true;
						}
					}

					// Si el valor está seteado, imprimo ese, sino, imprimo el valor por default
					if(isset($paramvisualiz[$comando["Nombre"]]))
						$salida.=$paramvisualiz[$comando["Nombre"]]; 
					else
					{
						if(isset($comando["Default"]))
							$salida.=$comando["Default"]; 
					}
				}
				else
				{					
					$this->msg_error.="Clase ".$comando["Tipo"]." no soportada en pagina: ".$_GET["pagina"]." / Regdatocod: ".$this->regdatocod." / Visualizacion: ".$this->visualizcod."<br>";
					$seprodujoerror=true;
				}
			}
			else
				$salida.=$comando;
		}

		if($this->comentarios)
			$salida.="<!-- /Visualiza: ".$this->visualizcod." Regdatocod: ".$this->regdatocod." -->\n";
		
		$noticias_mostradas++;
		return !$seprodujoerror;
	}

	function RetornarMsgError()
	{
		return $this->msg_error;
	}

	
	function MostrarCampoCategoria($campo,$valor,&$salida)
	{
		
		$spnombre="sel_tablas_propias_campos_descriptores_xvalor";
		$sparam=array(
			'ptabla'=> $this->tabla,
			'pcampo'=> $campo,
			'pvalor'=> $valor
			);	
		if(!$this->conexionobjeto->ejecutarStoredProcedure($spnombre,$sparam,$queryv,$numfilasv,$errno))
		{
			$this->msg_error.="Mostrar Campo categoria error. Visualizcod: ".$this->visualizcod." /  Pagina: ".(isset($_GET["pagina"])?$_GET["pagina"]:"")."<br>";
			return false;
		}
		
		//echo "asdf";
		$datos=mysqli_fetch_assoc($queryv);
		$salida .= $datos['tabcampocatdesc'];	
		
		return true;
	}
	
} // Fin clase cVisualizaTablasPropias

