//-----------------------------------------------------------------------------
function Fila_contenido_grupo_inicio_php($idFila,$visible) {

	echo "<!-- Fila con datos contenido -->";
	ObtenerBrowser($browser);
	if ($browser['browser']=="MSIE") {
		  if ($visible=="SI")
			  echo "<tr id='".$idFila."' style='display:block';>";
		  else	
			  echo "<tr id='".$idFila."' style='display:none';>";	  
	
		  //  anterior: echo "<td colspan=2 style='padding:9px 10px 14px 10px;'>";
		  echo "<td colspan=2>";

	} else {

	    echo "<tr>";

		if ($visible=="SI")
		   // anterior echo "<td colspan=2 style='padding:9px 10px 14px 10px;'><div id='".$idFila."' style=''>";
		   echo "<td colspan=2><div id='".$idFila."' style=''>";
		else   
			// anterior echo "<td colspan=2 style='padding:9px 10px 14px 10px;'><div id='".$idFila."' style='visibility:hidden;position:absolute'>";
	       echo "<td colspan=2><div id='".$idFila."' style='visibility:hidden;position:absolute'>";
	}	
}	   
//-----------------------------------------------------------------------------
function VerificaPermisoDatosCargo($idconexion,$carg_codigo,$cuit,$modulo,$emitir_mensaje=false) {

	// Verifica que el cuit sea funcionario actual del cargo o que
	// corresponda a un asistente del cargo y tenga permisos para acceder al móldulo
	if (!ObtenerDatosFuncionario($idconexion,$carg_codigo,USUARIO_ROL_CARGO_ACT,$fila_func))  {
		$array_msg_pantalla=array("formato" => FMT_TEXTO);	
		$array_msg_pantalla+=array("texto" => "Se ha producido un error al verificar los permisos de acceso.");
		$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
		$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n carg_codigo=".$carg_codigo);			
		MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
		return false;
	}

	if ($fila_func['pers_cuilt']==$cuit ) { // Es el funcionario la persona logueada

		return true;

	} else { // Es un asistente la persona logueada
		
		$param=array('ppers_cuilt'=>$cuit,'prol_codigo'=>ASISTENTE); 		
		$param+=array('pcarg_codigo'=>$carg_codigo);
		$param+=array('pusurolcar_estado'=>USUARIO_ROL_CARGO_ACT);		
		$spnombre = "sel_usuario_rol_cargo_xpers_cuilt_rol_codigo_carg_codigo_usurolcar_estado";

		$query_usuario=ejecutarStoredProcedure($idconexion,$spnombre,$param);

		if ($query_usuario<0)   { // No es asistente del cargo

			if($emitir_mensaje) {
				$array_msg_pantalla=array("formato" => FMT_TEXTO);	
				$array_msg_pantalla+=array("texto" => "Ud. no tiene permisos para realizar la operación seleccionada.");
				$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n pers_cuilt=".$cuit."\n\n carg_codigo=".$carg_codigo);			
				MostrarMensaje($idconexion,MSG_ERRSOSP,$array_msg_pantalla,$array_msg_mail);
			}

			return false;
			
		} elseif (mysqli_num_rows($query_usuario!=1)) {

			if($emitir_mensaje) {
				$array_msg_pantalla=array("formato" => FMT_TEXTO);	
				$array_msg_pantalla+=array("texto" => "Ud. no tiene permisos para realizar la operación seleccionada.");
				$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n pers_cuilt=".$cuit."\n\n carg_codigo=".$carg_codigo);			
				MostrarMensaje($idconexion,MSG_ERRSOSP,$array_msg_pantalla,$array_msg_mail);
			}

			return false;
		
		} else {

			// Hay que verificar que tenga acceso a la pagina.
			$archivonom=$modulo;
			$spnombre="sel_rol_modulo_asistente";
			$param=array('prol_codigo'=>$rol_codigo,'parch_nombre'=>$archivonom);
			$param+=array('ppers_cuilt'=>$cuit,'pcarg_codigo'=>$carg_codigo);		
			$query=ejecutarStoredProcedure($idconexion,$spnombre,$param);

			if ($query<0)   { 	// No esta aurotizado a actualizar los datos privados

				if($emitir_mensaje) {	
					$array_msg_pantalla=array("formato" => FMT_TEXTO);	
					$array_msg_pantalla+=array("texto" => "Se ha producido un error al verificar los permisos de acceso.");
					$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
					$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n pers_cuilt=".$cuit."\n\n carg_codigo=".$carg_codigo);			
					MostrarMensaje($idconexion,MSG_ERRSOSP,$array_msg_pantalla,$array_msg_mail);
				}

				return false;
			} elseif(mysqli_num_rows($query)<1) {

				if($emitir_mensaje) {
					$array_msg_pantalla=array("formato" => FMT_TEXTO);	
					$array_msg_pantalla+=array("texto" => "Ud. no tiene permisos para realizar la operación seleccionada.");
					MostrarMensaje($idconexion,MSG_INF,$array_msg_pantalla,array());
				}

				return false;
			}
		}
	}
return true;
}

//------------------------------------------------------------------------------------
function VerificaPermisoVisualizarDP($idconexion,$cargo_visualizar,$rol_logueado,$cargo_logueado) {
// El funcionario del cargo que se visualiza, le dio permisos para visualizar
// sus datos logueados al 

if ($rol_logueado!=FUNCIONARIO)
	return false;

if ($cargo_visualizar==$cargo_logueado) 
	return true;
	
// Obtengo el grupo de confidencialidad del cargo a visualizar
$param=array('pcarg_codigo'=>$cargo_visualizar);
if (($query=ejecutarStoredProcedure($idconexion,'sel_grupo_confidencialidad_xcarg_codigo',$param))<0) {
	$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar el Grupo de Confidencialidad." );
	$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
	$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n carg_codigo=".$cargo_visualizar);
	MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
	return false;
} elseif ( mysqli_num_rows($query) > 1 ) {
		$array_msg_pantalla=array("formato" => FMT_TEXTO);	
		$array_msg_pantalla+=array("texto" => "Se ha producido un error, la cantidad de Grupo de Confidencialidad para el cargo incorrecta." );
		$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
		$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n carg_codigo=".$cargo_visualizar);
		MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
		return false;
	} elseif (mysqli_num_rows($query) == 0 ) {
			return false;
		} else 
			$fila_grupo=mysqli_fetch_assoc($query);

// Verifico que el cargo logueado pertenezca al grupo de confidencialidad
$param=array('pgrucf_codigo'=>$fila_grupo['grucf_codigo'],'pcarg_codigo'=>$cargo_logueado);
if (($query=ejecutarStoredProcedure($idconexion,'sel_cargo_grupo_confidencialidad_xgrucf_codigo_carg_codigo',$param))<0 ) {
	$array_msg_pantalla=array("formato" => FMT_TEXTO);	
	$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar los miembros del grupo de confidencialidad." );
	$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
	$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n grucf_codigo=".$fila_grupo['grucf_codigo']."\n\n".$cargo_logueado);
	MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
	return false;
} elseif(mysqli_num_rows($query) == 0) {
	return false;
}

return true;
}
//------------------------------------------------------------------------------------------
function ObtenerDatosPrivadosDB($idconexion,$operacion,$opciones_detalle,$carg_codigo,&$fila_datos_privados,&$fila_dir_postal,&$fila_dir_legal,&$filas_telefonos) {

	$fila_datos_privados=array();
	$fila_dir_postal=array();
	$fila_dir_legal=array();
	$filas_telefonos=array();

	$array_opciones_obtener=explode(",",$opciones_detalle); 

	// Obtengo los datos basicos del funcionario asociado al cargo, para obtener el cuit de 
	// dicha persona.
	if (!ObtenerDatosFuncionario($idconexion,$carg_codigo,USUARIO_ROL_CARGO_ACT.",".USUARIO_ROL_CARGO_BLOQUEADO,$fila_func)) {
		$array_msg_pantalla=array("formato" => FMT_TEXTO);	
		$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar los datos del funcionario.");
		$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
		$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n carg_codigo=".$carg_codigo);			
		MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
		return false;
	}
	// Obtengo los datos de usuario_datos_privados	
	if (in_array('dir_electronicas',$array_opciones_obtener) ) {
		$param=array("ppers_cuilt"=>$fila_func['pers_cuilt']);			
		if(($query=ejecutarStoredProcedure($idconexion,"sel_usuario_datos_privados_cuilt",$param))<0)	{
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar los datos privados del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n pers_cuilt=".$fila_func['pers_cuilt']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;
		} elseif(mysqli_num_rows($query)>1)	{
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar los datos privados del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n Hay más de un registro \n\n pers_cuilt=".$fila_func['pers_cuilt']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;
		 }	elseif (mysqli_num_rows($query)==1) {
				$fila_datos_privados = mysqli_fetch_assoc($query);
				$fila_datos_privados['_nuevo'] = false;
			} else {
				if ($operacion!="v") {
					ObtenerNuevaDirElectronica($idconexion,$fila_datos_privados);
					$fila_datos_privados['_nuevo'] = true;
				}
		}
	}
	
	if (in_array('dp_personal',$array_opciones_obtener) ) {
		
		$param=array("ppers_cuilt"=>$fila_func['pers_cuilt'],"pdircp_tipo"=>DP_TIPO_PERSONAL);			
		if(($query=ejecutarStoredProcedure($idconexion,"sel_usuario_dir_postal_xpers_cuilt_dircp_tipo",$param)) < 0) {
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar la dirección personal del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n pers_cuilt=".$fila_func['pers_cuilt']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;		 
		}
		$fila_dp_personal=mysqli_fetch_assoc($query);
	
		// Obtengo la dirección postal
		$param=array('pdirp_codigo'=>$fila_dp_personal['dirp_codigo']);
		if(($query=ejecutarStoredProcedure($idconexion,"sel_dir_postal_xdirp_codigo",$param)) < 0) {
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar la dirección personal del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n dirp_codigo=".$fila_dp_personal['dirp_codigo']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;		 
		} elseif(mysqli_num_rows($query)>1)	{
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar la dirección personal del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n dirp_codigo=".$fila_dp_personal['dirp_codigo']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;
		 }	elseif (mysqli_num_rows($query)==1) {
				$fila_dir_postal = mysqli_fetch_assoc($query);
				$fila_dir_postal['_nuevo'] = false;
			} else {
				if ($operacion!="v") {
					ObtenerNuevaDirPostal($idconexion,$fila_dir_postal);
					$fila_dir_postal['_nuevo'] = true;
				}
			}
	}	
	
	// Obtengo la dicección legal
	if (in_array('dp_legal',$array_opciones_obtener) ) {
		$param=array("ppers_cuilt"=>$fila_func['pers_cuilt'],"pdircp_tipo"=>DP_TIPO_LEGAL);			
		if(($query=ejecutarStoredProcedure($idconexion,"sel_usuario_dir_postal_xpers_cuilt_dircp_tipo",$param)) < 0) {
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar la dirección personal del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n pers_cuilt=".$fila_func['pers_cuilt']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;		 
		}
	
		$fila_dp_legal=mysqli_fetch_assoc($query);
		$param=array('pdirp_codigo'=>$fila_dp_legal['dirp_codigo']);
		if(($query=ejecutarStoredProcedure($idconexion,"sel_dir_postal_xdirp_codigo",$param)) < 0) {
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar la dirección legal del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n dirp_codigo=".$fila_dp_legal['dirp_codigo']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;		 
		} elseif(mysqli_num_rows($query)>1)	{
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar la dirección legal del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n dirp_codigo=".$fila_dp_legal['dirp_codigo']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;
		 }	elseif (mysqli_num_rows($query)==1) {
				$fila_dir_legal = mysqli_fetch_assoc($query);
				$fila_dir_legal['_nuevo'] = false;
			} else {
				if ($operacion!="v") {
					ObtenerNuevaDirPostal($idconexion,$fila_dir_legal);
					$fila_dir_legal['_nuevo'] = true;
				}
		}
	}

	// Obtengo los teléfonos
	if (in_array('telefonos',$array_opciones_obtener) ) {

		$param=array('ppers_cuilt'=>$fila_func['pers_cuilt']);
		if(($filas_usuario_telefono=ejecutarStoredProcedure($idconexion,"sel_usuario_telefono_xpers_cuilt",$param)) < 0) {
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar los teléfonos privados del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n pers_cuilt=".$fila_func['pers_cuilt']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
		 	return false;		 
		} 	

		$cant_telefonos = mysqli_num_rows($filas_usuario_telefono);
		if($cant_telefonos > MAX_TELEFONOS_USUARIO)	{
			$array_msg_pantalla=array("formato" => FMT_TEXTO);	
			$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar los teléfonos privados del funcionario.");
			$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
			$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n pers_cuilt=".$fila_func['pers_cuilt']);			
			MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
			return false;
		} 
	
		$i=0;
		$filas_telefonos=array();
		while ($fila_telefono=mysqli_fetch_assoc($filas_usuario_telefono) ) {
			$param=array('ptele_codigo'=>$fila_telefono['tele_codigo']);
		
			if (($una_fila_telefono=ejecutarStoredProcedure($idconexion,"sel_telefono_xtele_codigo",$param)) < 0) {
				$array_msg_pantalla=array("formato" => FMT_TEXTO);	
				$array_msg_pantalla+=array("texto" => "Se ha producido un error al seleccionar los teléfonos privados del funcionario.");
				$array_msg_mail=array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__);			
				$array_msg_mail+=array("texto" =>$array_msg_pantalla['texto']."\n\n ptele_codigo=".$fila_telefono['tele_codigo']);			
				MostrarMensaje($idconexion,MSG_ERRGRAVE,$array_msg_pantalla,$array_msg_mail);
				return false;		 
			} 
			$filas_telefonos[$i]=mysqli_fetch_assoc($una_fila_telefono);
			$filas_telefonos[$i]['_nuevo'] = false;
			$i++;
	   }
	   
	   if (count($filas_telefonos)==0 && $operacion!="v") {
		  ObtenerNuevoTelefono($idconexion,$filas_telefonos);
		  $filas_telefonos[0]['_nuevo'] = true;   
	   }
	}   

	if($operacion!="v") {
		$_SESSION['dp_nuevo'] = array();	
		$_SESSION['dp_nuevo']['dir_electronicas']=$fila_datos_privados['_nuevo'] ;;
		$_SESSION['dp_nuevo']['dp_personal']=$fila_dir_postal['_nuevo'] ;;
		$_SESSION['dp_nuevo']['dp_legal'] = $fila_dir_legal['_nuevo'] ;
	}
   return true;
}
