function MostrarGrillaSeleccion($conexion, $cuit) {

	$spnombre='sel_usuarios_roles_jurisdiccion_inap_actualizables_xrolcod_jurisd_cuit';
	$spparam = array('pusuariocuit'=>$cuit, 
 					 'pusuarioestado'=>USUARIOACT.",".USUARIONUEVO,
					 'prolcodactualiza'=>$_SESSION['rolcod'],				
					 'prolcodactualizado'=>USUORGANISMO,				
					 'pjurisdid_inap'=>$_SESSION['jurisdid_inap'],
					 'porderby'=>"roldesc"
			);

	if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$result_usu,$num_roles_usu,$errno)) {	
		$txt_sys_mail="\nusuariocuit=".$cuit."\nusuarioestado=".USUARIOACT."\nrolcodactualiza=".$_SESSION['rolcod'];
		$txt_sys_mail.="\nrolcodactualizado=".USUORGANISMO."\njurisdid_inap=".$_SESSION['jurisdid_inap'];
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar usuarios.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
		return false;			
	}

	if ($num_roles_usu>0) {

			$opciones=array(
				"numPagina"=>isset($_GET['paginaG1'])?$_GET['paginaG1']:1,
				"FilasPagina"=>$num_roles_usu,
				"NombrePaginaQuery"=>"paginaG1"
			);
			
			if (isset($_GET['paginaG1']))	{
				$querystring=FuncionesPHPLocal::ArmarQueryString("paginaG1","",false);
				$opciones['QueryString']=$querystring;
			}
			
			$oGrilla = new cGrilla($opciones);
			$oGrilla->SetearTituloGrilla('Roles asociados al usuario con CUIT'.$cuit);
			
			$oGrilla->SetearAnchoGrilla('90%');
			
			$miColumna1 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna1,'Rol');
			$oGrilla->Setear('campo_grilla',$miColumna1,'roldesc');
			$oGrilla->Setear('align_columna',$miColumna1,'left');
		
			$miColumna2 = $oGrilla->AddColumna('txt');
			$oGrilla->Setear('titulo_columna',$miColumna2,'Jurisdicción');
			$oGrilla->Setear('campo_grilla',$miColumna2,'jurisdnom');
			$oGrilla->Setear('align_columna',$miColumna2,'left');
		
			$miColumna3 = $oGrilla->AddColumna('linkimg');
			$oGrilla->Setear('titulo_columna',$miColumna3,'Editar');
			$oGrilla->Setear('ancho_columna',$miColumna3,'60');
			$oGrilla->Setear('url',$miColumna3,'usuarios_roles_jurisdicciones_modulos_upd.dhtml');
			$oGrilla->Setear('imagen',$miColumna3,'images/editar.jpg');
			$oGrilla->Setear('altImagen',$miColumna3,'Editar');						
			$oGrilla->AddParametrosURL($miColumna3,"usuariocod","usuariocod");
			$oGrilla->AddParametrosURL($miColumna3,"rolcod","rolcod");
			$oGrilla->AddParametrosURL($miColumna3,"jurisdid_inap","jurisdid_inap");
			$oGrilla->AddParametrosURL($miColumna3,"operacion","M","cte");
		
			if (!$oGrilla->CargarGrilla($result_usu))
				return false;
				
			$oGrilla->MostrarGrilla();
		
			$spnombre="sel_roles_asignables_xrolactualiza";
			$spparam= array('prolcodactualiza'=>$_SESSION['rolcod']);
			if(!$conexion->ejecutarStoredProcedure($spnombre,$spparam,$result_usu,$num_max_roles,$errno)) {	
				$txt_sys_mail="\nrolcodactualiza=".$_SESSION['rolcod'];
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al seleccionar roles asignables.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
				return false;			
			}

} else { 
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El usuario seleccionado no tiene roles asignados que Ud. pueda administrar.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	 }
	 

	
	return true;
} 		


$datosvalidados = array();
if (isset($_POST['usuarioCUIT'])) {

	$datosbien = true;
	$datos=array();
	
	if (!FuncionesPHPLocal::ValidarContenido($conexion,$_POST['usuarioCUIT'],"CUIT")) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en el CUIT/CUIL/CDI del usuario ingresado.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$datosbien=false;
	}
	
	if ($datosbien) {

		$datosvalidados['usuarioCUIT']=$_POST['usuarioCUIT'];
		$spnombreusuario='sel_usuarios_xusuariocuit';
		$spparamusuario=array('pusuariocuit'=>$datosvalidados['usuarioCUIT']);
		$conexion->ejecutarStoredProcedure($spnombreusuario,$spparamusuario,$queryusuario,$numfilas,$errorcod);
		
		if($numfilas==1) {
			$filausuario=mysqli_fetch_assoc($queryusuario);
			$datosvalidados['usuariocod']=$filausuario['usuariocod'];	
			$datosvalidados['usuarioestado']=$filausuario['usuarioestado'];				
		} else {
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_INF,"El usuario no se encuentra en el sistema.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			$datosbien=false;
		}
	}
}

if (isset($_GET['usuariocod'])) {
	$datosvalidados['usuariocod']=$_GET['usuariocod'];

	if($conexion->TraerCampo("usuarios","usuariocuit",array("usuariocod='",$datosvalidados['usuariocod'],"'"),$usuariocuit,$numfilas,$errno))
	 	$datosvalidados['usuarioCUIT']=htmlspecialchars($usuariocuit,ENT_QUOTES);

	if($conexion->TraerCampo("usuarios","usuarioestado",array("usuariocod='",$datosvalidados['usuariocod'],"'"),$usuarioestado,$numfilas,$errno))
	 	$datosvalidados['usuarioestado']=htmlspecialchars($usuarioestado,ENT_QUOTES);
	
}
//----------------------------------------------------------------------------------------- 
$commit=true;
$errorinformable=true;

if (isset($_POST['botonasignar'])){
	$conexion->ManejoTransacciones("B");

	$jurisd = $_POST['jurisdid_inap'];
	if ($_POST['rolcod'] == USUORGANISMO)
		$jurisd = $_SESSION['jurisdid_inap'];	
	$rol = $_POST['rolcod'];
	$spmodulosasignables="sel_modulos_gruposmod_modulos_orden";
	$spparamselmod=array('porderby'=>"modulocod");
	$conexion->ejecutarStoredProcedure($spmodulosasignables,$spparamselmod,$querymodulos,$numfilas,$errorcod);

	//baja de modulos
	
	while($filamodulos=mysqli_fetch_assoc($querymodulos))
	{
		$spnombredel="del_usuarios_roles_jurisdiccion_inap_xusuariocod_xrolcod_xjurisdid_xmodulocod";
		$spparamdel=array('pusuariocod'=>$_POST['usuariocod']);
		$spparamdel+=array('prolcod'=>$rol);
		$spparamdel+=array('pjurisdid_inap'=>$jurisd);
		$spparamdel+=array('pmodulocod'=>$filamodulos['modulocod']);
						
		if(!$conexion->ejecutarStoredProcedure($spnombredel,$spparamdel,$query,$numfilas,$errorcod))
		{
			$commit=false;
			if($errorcod==MYSQLFORKEY){
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Existen organismos relacionados con usuarios '".$jurisd."'. Imposible borrarlo ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				$errorinformable=false;
			}	
		}else
			FuncionesPHPLocal::RegistrarAcceso($conexion,'33902',"usuariocod='".$_POST['usuariocod']."' - rolcod='".$rol."' - jurisd='".$jurisd."' - modulocod='".$filamodulos['modulocod'],$_SESSION['usuariocod']);
	
	}
	//alta de modulos
	$spmodulosasignables="sel_modulos_gruposmod_modulos_orden";
	$spparamselmod=array('porderby'=>"modulocod");
	$conexion->ejecutarStoredProcedure($spmodulosasignables,$spparamselmod,$querymodulos,$numfilas,$errorcod);
	
	$conexion->ejecutarStoredProcedure($spmodulosasignables,$spparamselmod,$querymodulos,$numfilas,$errorcod);
	while ($commit && $filamodulos = mysqli_fetch_assoc($querymodulos))	{ 
		$check = "checkbox_".$filamodulos['modulocod'];
		if (isset($_POST[$check]))	{
			$spnombreins="ins_usuarios_roles_jurisdiccion_inap_modulos";
			$spparamins=array('pusuariocod'=>$_POST['usuariocod']);
			$spparamins+=array('prolcod'=>$rol);		
			$spparamins+=array('pjurisdid_inap'=>$jurisd);
			$spparamins+=array('pmodulocod'=>$filamodulos['modulocod']);
			$spparamins+=array('pultmodusuario'=>$_SESSION['usuariocod']);
			$spparamins+=array('pultmodfecha'=>date('Y/m/d H:i:s'));
			
			if(!$conexion->ejecutarStoredProcedure($spnombreins,$spparamins,$query,$numfilas,$errorcod))	{
				if($errorcod!=MYSQLCLAVEDUP){	
					FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error al insertar jurisdiccion-usuario-rol_modulos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),"\n Numfilas='".$numfilas."' - errorcod='".$errorcod."'. ");
					$commit=false;
				}
			} else
				FuncionesPHPLocal::RegistrarAcceso($conexion,'33901',"usuariocod='".$_POST['usuariocod']."' - rolcod='".$rol."' - jurisd='".$_SESSION['jurisdid_inap']."' - modulocod='".$filamodulos['modulocod'],$_SESSION['usuariocod']);
		}
	}

	if($commit)	{
		$conexion->ManejoTransacciones("C");
		// cambio este mensaje
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se asignaron modulos al usuario '".$_POST['usuarioCUIT']."'",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
	} elseif($commit==false && $errorinformable) {
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"No se pudo actualizar el usuario '".$_POST['usuarioCUIT']."' ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("R");
	}	
}
