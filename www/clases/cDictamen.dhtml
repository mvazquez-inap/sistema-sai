							FuncionesPHPLocal::ArmarCombo_SinSalto_BD($conexion,$spnombre,$spparam,"formulario","pondtipopond_codigo_int","pondtipopond_codigo","pondtipopond_descripcion",($es_modif)?$fila_dictamen_editable['pondtipopond_codigo_int']:"","-- Seleccione Ponderación",$fila_pondtipopond_codigo_int,$selected2,1,'ReCalculo_creditos(act_duracionhs.value,pondtipopond_codigo_cal_pres.value,pondtipopond_codigo_int.value,pondtipopond_codigo_proc_eva.value,"idEspere");',"width: 210px",false,false,"",$operacion_dictamen=="V");
						?>
						</td>
