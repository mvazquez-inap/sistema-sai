//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosExpediente($exp_codigo) {

		if(!$this->_DatosValidosEliminarExpediente($exp_codigo,$datosvalidados))
			return false;

		$spnombre="del_expediente";
		$spparam=array('pexp_codigo'=> $datosvalidados['exp_codigo']);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$query,$numfilas,$errorcod)) 
			return false;					  	 	

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function ModifDatosExpediente($datos)	{

		if(!$this->_DatosValidosModifExpediente($datos,$datosvalidados))
			return false;

		$spnombre="upd_expediente";
		$spparam=array(
			'pexp_codigo'=> $datosvalidados['exp_codigo'], 
			'pexp_numero'=> $datosvalidados['exp_numero'],
			'pexp_fecha_inicio'=>FuncionesPHPLocal::ConvertirFecha($datosvalidados['exp_fecha_inicio'],'dd/mm/aaaa','aaaa-mm-dd'),
			'pexp_fecha_ingreso'=>FuncionesPHPLocal::ConvertirFecha($datosvalidados['exp_fecha_ingreso'],'dd/mm/aaaa','aaaa-mm-dd'),
			'pexp_obs'=> $datosvalidados['exp_obs'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
		);
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno) || $numfilas!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar el Expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
			return false;
		}
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoModificar($exp_codigo,$rolcod,$jurisdid) {
	
		// Trae los datos del expediente a modificar 
		$es_modif=false;
		if (!$this->TraerDatosExpediente($exp_codigo,$fila_expediente,$es_modif) || !$es_modif ) {
			$error="No se encontró el expediente.";
			$errormail="Error al buscar el expediente \nexp_codigo=".$exp_codigo;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato),$errormail);
			return false;
		}
		
		switch ($rolcod) {
		  case USUCURSOINAP:
		  case USUACTINS:
				// Jefatura de Gabinete			
				if ($fila_expediente['jurisdid_exp'] == JURISDID_JEFATURA ) {
				  return true;
				}
				break;
		  case USUACTJUR:
		  case USUDISJUR:		  
		  
				//	Jurisdiccion del usuario que esta logeado
				if ($fila_expediente['jurisdid_exp'] == $jurisdid) {
				  return true;
				}
				break;
		  case USUAUTODESARROLLO:
		  case USUACTEXT:
				// La jurisdiccion debe ser de coordinacion	
				return true;	  
				break;
		}
		
		FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"No tiene permisos para modificar el expediente.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>$this->formato));
		return false;
	}
//-----------------------------------------------------------------------------------------------------	
	function TienePermisoBaja($exp_codigo,$rolcod,$jurisdid) {
			return $this->TienePermisoModificar($exp_codigo,$rolcod,$jurisdid);
	}
//-----------------------------------------------------------------------------------------------------	
	function ValidarFormAltaExpediente()	{ 	?>		
	
	function VerificarNroExpediente(formulario,valor_buscado,codigo_buscado) {
	
		var ajax=nuevoAjax();
		var variables="?tipo=E&valor_buscado="+valor_buscado+"&valor_codigo_unico="+codigo_buscado;
		var direccion= "verifico_existencia_codigo_ajax.dhtml"+variables;
		var ejecutook=false;
		
		ajax.open("GET",direccion,true);
		ajax.onreadystatechange=function() {
			if (ajax.readyState==4) {	
				if (ajax.responseText.substr(0,15)=="//tienepermisos") 	{				
					eval (ajax.responseText);
					if (!ejecutook){	
						alert(error);
						formulario.exp_numero.focus();
					} else {
						document.formulario.submit();
					}
				} else {	
					alert ('Error de permisos');
					formulario.exp_numero.focus();
				}
			}
		}	
		ajax.send(null);	
	}

	function ValidarFormAltaExpediente(formulario,operacion) {

			// Si la operacion = "B" no hay que hacer ninguna validación
			// como el boton no es submit hay que hacer el submit en este caso	
			if (operacion=="B") {
			 	document.formulario.submit();
				return true;
			}		 
			 
			// Número de Expediente
			if ((trim(formulario.exp_numero.value)=="")) {
				alert("Debe ingresar el número del expediente");
				formulario.exp_numero.focus();
				return false;
			}	
	
			if (formulario.jurisdid_exp.value=="") {
				alert("Debe ingresar la jurisdicción del expediente");
				formulario.jurisdid_exp.focus();
				return false;
			}	

			// Fecha de Inicio
			if (formulario.exp_fecha_inicio.value=="" || !ValidarFecha(formulario.exp_fecha_inicio.value))
			{
				alert("La fecha de inicio del expediente no es válida");
				formulario.exp_fecha_inicio.focus();
				return false;
			}

			// Fecha de Ingreso
			if (formulario.exp_fecha_ingreso.value=="" || !ValidarFecha(formulario.exp_fecha_ingreso.value))
			{
				alert("La fecha de ingreso del expediente no es válida");
				formulario.exp_fecha_ingreso.focus();
				return false;
			}

			// Dia actual
			var hoy = new Date();
			var dia = hoy.getDate();
			var mes = hoy.getMonth()+1;
			var ano = hoy.getFullYear();			 

			if (dia <= 9) dia = "0" + dia; 
			if (mes <= 9) mes = "0" + mes; 
					
			var fecha_actual_AAAAMMDD = ano+""+mes+""+dia; 
			var fechainicio=ConvertirFecha(formulario.exp_fecha_inicio.value,'dd/mm/aaaa','aaaammdd');
			var fechaingreso=ConvertirFecha(formulario.exp_fecha_ingreso.value,'dd/mm/aaaa','aaaammdd');
		
			// La fecha de ingreso o la fecha inicial no puede ser superior al actual.			
			if (fechainicio > fecha_actual_AAAAMMDD || fechainicio < '<?php echo ANOINICALINAP."0101" ?>') {
				alert("La fecha de inicio debe ser menor o igual a la actual y mayor o igual a <?php echo "01/01/".ANOINICALINAP ?>");
				formulario.exp_fecha_inicio.focus();
				return false;
			}				
				
			if (fechaingreso > fecha_actual_AAAAMMDD || fechaingreso < '<?php echo ANOINICALINAP."0101" ?>') {
				alert("La fecha de ingreso debe ser menor o igual a la actual y mayor o igual a <?php echo "01/01/".ANOINICALINAP ?>");
				formulario.exp_fecha_ingreso.focus();
				return false;
			}

			// Fecha de Ingreso >= Fecha de Inicio
			if (fechainicio>fechaingreso) 	{
				alert("La fecha de ingreso debe ser mayor o igual que la fecha de inicio");
				formulario.exp_fecha_ingreso.focus();
				return false;
			}
			
			// Verifico que el expediente 
			VerificarNroExpediente(formulario,formulario.exp_numero.value,formulario.exp_codigo.value);
		
			return true;
		}			
//-----------------------------------------------------------------------------------------------------	
<?php }
//-----------------------------------------------------------------------------------------------------	
	function BuscarExpediente($ArregloDatos,&$numfilas,&$resultado,&$error,&$errormail)	{

		$sparam=array('pxexp_codigo'=>0);
		$sparam+=array('pxexp_numero'=>0);
		$sparam+=array('pxexp_numero_exacto'=>0);
		$sparam+=array('pxjurisdid_exp'=>0);
		
		$sparam+=array('pexp_codigo'=>"");
		$sparam+=array('pexp_numero'=>"");
		$sparam+=array('pexp_numero_exacto'=>"");

		$sparam+=array('pjurisdid_exp'=>"");
		$sparam+=array('porderby'=>"jurisdnom,exp_numero");

		if (isset ($ArregloDatos['exp_codigo']))
		{
			if ($ArregloDatos['exp_codigo']!="")
			{	
				$sparam['pexp_codigo']= $ArregloDatos['exp_codigo'];
				$sparam['pxexp_codigo']= 1;
			}
		}
		if (isset ($ArregloDatos['exp_numero']))
		{
			if ($ArregloDatos['exp_numero']!="")
			{	
				$sparam['pexp_numero']= $ArregloDatos['exp_numero'];
				$sparam['pxexp_numero']= 1;
			}
		}	
		if (isset ($ArregloDatos['exp_numero_exacto']))
		{
			if ($ArregloDatos['exp_numero_exacto']!="")
			{	
				$sparam['pexp_numero_exacto']= $ArregloDatos['exp_numero_exacto'];
				$sparam['pxexp_numero_exacto']= 1;
			}
		}	

		if (isset ($ArregloDatos['jurisdid_exp']))
		{
			if ($ArregloDatos['jurisdid_exp']!="")
			{	
				$sparam['pjurisdid_exp']= $ArregloDatos['jurisdid_exp'];
				$sparam['pxjurisdid_exp']= 1;
			}
		}
		if (isset ($ArregloDatos['orderby']))
		{
			if ($ArregloDatos['orderby']!="")
			{	
				$sparam['porderby']= $ArregloDatos['orderby'];
			}
		}
		
		$spnombre="sel_expediente_xdatos";	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno))
		{
			$error="Error al buscar el Expediente.";
			$errormail="Error al buscar el Expediente \nerror=.".$errno;
			return false;
		}

		return true;
	}
