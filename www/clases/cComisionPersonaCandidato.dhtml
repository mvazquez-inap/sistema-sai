//*******************************************************************************//
//*************************************VALIDAR-**********************************//
//*******************************************************************************//
//-----------------------------------------------------------------------------------------

	function _DatosValidosAltaInscripcionWeb($datos,&$datosvalidados)
	{
		$datosvalidados=array();

		if (!FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['pers_cuilt'],"CUIT"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"El CUIT ingresado no es válido",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["pers_cuilt"]=$datos["pers_cuilt"];

		if(!$this->_DatosValidosComunesInscripcionWeb($datos,$datosvalidados))
			return false;

		return true;
	}


	function _DatosValidosModifInscripcionWeb($datos,&$datosvalidados)
	{
		$datosvalidados=array();


		if(!$this->_DatosValidosComunesInscripcionWeb($datos,$datosvalidados))
			return false;

		return true;
	}




//-----------------------------------------------------------------------------------------------------
	function _DatosValidosComunesInscripcionWeb($datos,&$datosvalidados)
	{
		$oAgentes = new cAgentes($this->conexion);

		$datosvalidados=array();

		// validar todos los campos
		$datosvalidados = $datos;


		// paiscod_revista ----------------------
		$spnombre = "sel_paises_xestado";
		$spparam = array("ppaisestado"=>ESTADOACTIVO, "porderby"=>"paisnom");
		if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("paiscod"=>$datos["paiscod_revista"]),$resultado,$filapais,$numfilasmatcheo,$errno))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el pais de revista. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}

		if($numfilasmatcheo!=1)
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el pais de revista. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["paiscod_revista"]=$datos['paiscod_revista'];



		// paiscod_revista ----------------------
		if ($datos['paiscod_revista'] == ARGENTINA) {
			$oprovincia = new cProvincias($this->conexion);
			$oprovincia->ProvinciasSP($spnombre,$spparam);
			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("provinciacod"=>$datos["provinciacod_revista"]),$resultado,$filapais,$numfilasmatcheo,$errno))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la provincia de revista. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

			if($numfilasmatcheo!=1)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la provincia de revista. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		}
		$datosvalidados["provinciacod_revista"]=$datos['provinciacod_revista'];


		// agentes a cargo ----------------------------------------
		if (trim($datos['agentes_a_cargo']) == "") {
			$arraymensajepantalla="La cantidad de agentes a cargo no es válida";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["agentes_a_cargo"]=$datos["agentes_a_cargo"];





	if ($datos["tipo_individual_con_org"]=="si") {

		if($datos["pers_apellido"]==""){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error Debe ingresar el Apellido.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				die();
				}
		if($datos["pers_nombre"]==""){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error Debe ingresar el Nombre.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				die();
				}
		if($datos["jurisdid_inap"]==""){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error Debe ingresar el Organismo del Coordinador T&eacute;cnico de Capacitaci&oacute;n.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				die();
				}
		if($datos["esc_agrup_niv_grado"]==""){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error Debe ingresar Escalafon.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				die();
				}
		if($datos["escalafon"]=="A"){
				if($datos["agfunc_codigo"]==""){
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error Debe ingresar la funcion.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					die();
				}
			}
		if($datos["jurislaboral"]==""){
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error Debe ingresar el organismo Laboral.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				die();
				}


		$oEscalafon = new cEscalafones($this->conexion);
		$jurisdicciones=new jurisdicciones($this->conexion);

		// escalafón	 [esc_agrup_niv_grado]
		if (!$oEscalafon->ValidarEscalafon($datos['esc_agrup_niv_grado'], $datosvalidados) ) {
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error seleccionando el escalafón.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}


		// tipoorg_codigo	 [tipoorg_codigo]
			switch ($datos['tipoorg_codigo']) {

				case ORGANISMO_APN :
					//-----------------------------------
					// jurisdid_inap ----------------------
					/*if(!$jurisdicciones-> SelectJurisdxCampo("jurisdid",JURISD_BUSQCAMPOIGUAL,$datos['jurislaboral'],"",TABGRALES_TS_ARRAY,$Destino,"",$numfilasmatcheo_jurisdid,$CodError)) {
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error al seleccionar el organismo donde trabaja. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}

					if($numfilasmatcheo_jurisdid!=1)
					{
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error al seleccionar el organismo donde trabaja. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}
					*/
					$datosvalidados["jurisdid_apn"]=$datos['jurislaboral'];
					$datosvalidados["orgapub_codigo"]="NULL";

					break;

				case ORGANISMO_NO_APN:
					//-----------------------------------
					// orgapub_codigo ----------------------
					/*
					$oAgentes->Organismo_PublicoSP($spnombre,$spparam);
					if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("orgapub_codigo"=>$datos["jurislaboral"]),$resultado,$filaret,$numfilasmatcheo_orgapub,$errno)) {
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error al seleccionar el organismo donde trabaja. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}

					if($numfilasmatcheo_orgapub!=1)
					{
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_INF,"Error al seleccionar el organismo donde trabaja. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
					}
					*/


					$datosvalidados["jurisdid_apn"]="NULL";
					$datosvalidados["orgapub_codigo"]=$datos['jurislaboral'];

					break;

				default :
						FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error en el tipo de Organismo Público donde trabaja.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
						return false;
						break;
			}
			$datosvalidados["tipoorg_codigo"]=$datos['tipoorg_codigo'];

			//echo $datos['tipo_individual_con_org'];


		// agfunc_codigo	 [agfunc_codigo]


			if ($datosvalidados['escalafcod']==SINEP) {
				//-----------------------------------
				// agfunc_codigo ----------------------
				$oAgentes->FuncionSP($spnombre,$spparam);
				if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("agfunc_codigo"=>$datos["agfunc_codigo"]),$resultado,$filaret,$numfilasmatcheo,$errno))
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la función del agente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}

				if($numfilasmatcheo!=1)
				{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar la función del agente. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				$datosvalidados["agfunc_codigo"]=$datos['agfunc_codigo'];

			} else
				$datosvalidados["agfunc_codigo"]="NULL";




	} else {

		$datosvalidados["escalafcod"]="NULL";
		$datosvalidados["agrupcod"]="NULL";
		$datosvalidados["escalafnivcod"]="NULL";
		$datosvalidados["escalaftramocod"]="NULL";
		$datosvalidados["escalafgradocod"]="NULL";
		$datosvalidados["jurisdid_inap"]=$datos['jurisdid_inap'];
		$datosvalidados["jurisdid_apn"]="NULL";
		$datosvalidados["orgapub_codigo"]="NULL";
		$datosvalidados["agfunc_codigo"]="NULL";

	}




		// MV - SEXO - 17032023 
		if ( (!isset($datos['pers_sexo'])) ||  (
			($datos['pers_sexo'] != SEXO_FEMENINO) && 
			($datos['pers_sexo'] != SEXO_MASCULINO) &&
			($datos['pers_sexo'] != SEXO_NO_RESPONDE)
			) ) {
			$arraymensajepantalla="El sexo ingresado no es válido";
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$arraymensajepantalla,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$datosvalidados["pers_sexo"]=$datos["pers_sexo"];

		// Fecha nacimiento- [pers_fechanac] 	- [OBLIG]
		if (trim($datos['pers_fechanac'])=="" || !FuncionesPHPLocal::ValidarContenido($this->conexion,$datos['pers_fechanac'],"FechaDDMMAAAA"))
		{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"La fecha de nacimiento no es válida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		$fechanac_AAAAMMDD=FuncionesPHPLocal::ConvertirFecha($datos['pers_fechanac'],'dd/mm/aaaa','aaaa-mm-dd');
		$datosvalidados["pers_fechanac"]=$fechanac_AAAAMMDD;



			// nivest_codigo

			$spnombre = "sel_nivel_estudios_xorden";
			$spparam = array("porderby"=>"nivest_descricpcion");

			if(!$this->conexion->BuscarRegistroxClave($spnombre,$spparam,array("nivest_codigo"=>$datos["nivest_codigo"]),$resultado,$filapais,$numfilasmatcheo,$errno))
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el nivel de estudios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

			if($numfilasmatcheo!=1)
			{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,"Error al seleccionar el nivel de estudios. ",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}

			$datosvalidados["nivest_codigo"]=$datos["nivest_codigo"];



		return true;
	}




}?>
