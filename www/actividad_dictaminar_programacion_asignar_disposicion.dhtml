//-----------------------------------------------------------------------------------------------------
	function MostrarDatosDictamenPersona($conexion,$operacion_dictamen,$fila_dictamen_editable,$fila_actividad, $fila_asignacion) {


		// si queda esta opcion no mandar la conexion
		if ($operacion_dictamen=="A") {
		   $es_modif = false;
		} elseif ($operacion_dictamen=="M" || $operacion_dictamen=="V") {
			$es_modif = true;
			if($conexion->TraerCampo("dictamen","dic_pertinencia",array("dic_codigo='",$fila_dictamen_editable['dic_codigo'],"'"),$dic_pertinencia,$numfilas,$errno))
				$filadic['dic_pertinencia']=htmlspecialchars($dic_pertinencia,ENT_QUOTES);
		   } else {
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRGRAVE,"Error en la llamada, operación inválida.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
		   }

		$oPonderadorDictamen= new cPonderadorDictamen($conexion);

	?>
		<table width="100%" class="textoTablaDato"  border="0" cellpadding="2" cellspacing="2">
			<tr>
				<td>
