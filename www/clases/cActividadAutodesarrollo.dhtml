	function ValidarFormAltaActividadAutodesarrollo() {	

	// Incluir las validaciones javascript de las 3 tablas.
	$this->ValidarFormAltaActividad(); 
?>		
	function ValidarFormAltaActividadAutodesarrollo(formulario,operacion) {


			if(!ValidarContenido(formulario.actauto_duracionhs.value,"NumericoEntero"))
			{
				alert("La cantidad de créditos ingresada no es válida");
				formulario.actauto_duracionhs.focus();
				return false;
			}


			// Tipo de Actividad							- [tipoact_codigo] 				- [OBLIG]
			if ((trim(formulario.tipoact_codigo.value)=="")) {
				alert("Debe ingresar el tipo de actividad");
				formulario.tipoact_codigo.focus();
				return false;
			}	

			// Duracion en Horas							- [actauto_duracionhs] 				- [OBLIG]
			if ((trim(formulario.actauto_duracionhs.value)=="")) {
				alert("Debe ingresar la duración en horas");
				formulario.actauto_duracionhs.focus();
				return false;
			}	

			if(!ValidarContenido(formulario.actauto_duracionhs.value,"NumericoEntero"))
			{
				alert("La duración en horas ingresada no es válida");
				formulario.actauto_duracionhs.focus();
				return false;
			}
			
		 	if (formulario.tipoact_codigo.value == <?php echo TIPOACTAUTOEVASIS ?> || formulario.tipoact_codigo.value == <?php echo TIPOACTAUTOEVACT ?>) { 


				// Pais								- [pais_codigo] 	- [OBLIG]
				if ((trim(formulario.pais_codigo.value)=="")) {
					alert("Debe ingresar un pais");
					formulario.pais_codigo.focus();
					return false;
				}	
	
				// Provincia						- [prov_codigo] 	- [OBLIG] / Si es Argentina
				if ((trim(formulario.pais_codigo.value)== <?php echo ARGENTINA?>)){
					if ((trim(formulario.prov_codigo.value)=="")){
						alert("Debe ingresar una provincia");
						formulario.prov_codigo.focus();
						return false;
					}					
				}
				
	
				// Sector del Organismo
				if (!formulario.tipo_institucion[0].checked   && !formulario.tipo_institucion[1].checked) {
					alert("Debe seleccionar el sector del organismo");
					formulario.tipo_institucion[0].focus();
					return false;
				}
				
				// Organismo 											[OBLIG]
				if (formulario.tipo_institucion[0].checked ) {			// Organismo Público
					if (trim(formulario.jurisdid.value)=="") {
						alert("Debe seleccionar el organismo público");
						formulario.jurisdid.focus();
						return false;
					}
				}  
				if (formulario.tipo_institucion[1].checked ) {			// Organismo Privado
					if (trim(formulario.orgapri_codigo.value)=="") {
						alert("Debe seleccionar el organismo privado");
						formulario.orgapri_codigo.focus();
						return false;
					}
				}  		
			
			 } 
		return true;		
		}	

//-----------------------------------------------------------------------------------------------------	
	function SeleccionPais(formulario){
		var elSelect = document.getElementById('datos_provincia');
		if (formulario.pais_codigo.value == <?php echo ARGENTINA ?>) {
			elSelect.style.display ="block";
		} else {
			elSelect.style.display ="none";
		}
	}
//-----------------------------------------------------------------------------------------------------	
	function SeleccionTipoInstitucion(valorlogico,seccion_mostrar,seccion_ocultar ){

		var elSelectMostrar = document.getElementById(seccion_mostrar);
		var elSelectOcultar = document.getElementById(seccion_ocultar);

			if (valorlogico) {
				elSelectMostrar.style.display ="block";
				elSelectOcultar.style.display ="none";			
			} else {
				elSelectMostrar.style.display ="none";
				elSelectOcultar.style.display ="block";			
			}				
	}		
	<?php			
 }
 //-----------------------------------------------------------------------------------------------------	
	function AltaDatosActividadAutodesarrollo($datos,&$act_codigo_nuevo,&$act_codinap) {

		$datosvalidados=array();		
		
		$this->_AguparDatosPost($datos,$datos_agrup,false);	
		$datosactividad['actividad']=$datos_agrup['actividad'];
		$datosactividad['actividad_autodesarrollo']=$datos_agrup['actividad_autodesarrollo'];		
		$datosactividad['actividad_autodesarrollo_evento']=$datos_agrup['actividad_autodesarrollo_evento'];				

		// inserto actividad
		if ($datos['es_nueva'] == 'si') {
			if(!$this->AltaDatosActividad($datosactividad['actividad'],$act_codigo_nuevo,true,"AU",$act_codinap))
				return false;
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38001","act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);
		} else {
			$act_codigo_nuevo = $datosactividad['actividad']['act_codigo'];		
			$act_codinap = $datosactividad['actividad']['act_codinap'];
			if(!$this->AltaFormatoActividad($act_codigo_nuevo,FORMATOAUTO)) {
				return false;		
			}
		}

		// inserto actividad_autodesarrollo
		if(!$this->_DatosValidosAltaActividadAutodesarrollo($datos_agrup['actividad_autodesarrollo'],$datosvalidados))
			return false;

		$spnombre="ins_actividad_autodesarrollo";
		$spparam=array(
			'pact_codigo'=> $act_codigo_nuevo,
			'ptipoact_codigo'=> $datosvalidados['actividad_autodesarrollo']['tipoact_codigo'],
			'pactauto_estado'=> ACTAUTOACTIVO,
			'pactauto_duracionhs'=> $datosvalidados['actividad_autodesarrollo']['actauto_duracionhs'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
	        'pultmodfecha'=> date("Y/m/d H:i:s")
			);
			
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad Autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"48601","act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);

		// inserto actividad_autodesarrollo_evento		
		if ($datosactividad['actividad_autodesarrollo']['tipoact_codigo'] == TIPOACTAUTOEVASIS || $datosactividad['actividad_autodesarrollo']['tipoact_codigo'] == TIPOACTAUTOEVACT) {
			if ($datos['es_nueva'] == 'si') {
				if(!$this->_DatosValidosAltaActividadAutodesarrolloEvento($datos_agrup['actividad_autodesarrollo_evento'],$datosvalidados))
					return false;
				$log = "48701";					
				$spnombre="ins_actividad_autodesarrollo_evento";
				$spparam=array(
					'pact_codigo'=> $act_codigo_nuevo,
					'pactautoeven_duraciondetalle'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_duraciondetalle'],
					'ppais_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['pais_codigo'],
					'pactautoeven_creditos_asistencia'=> 0,
					'pprov_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['prov_codigo'],
					'pactautoeven_direccion'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_direccion'],
					'porgapri_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['orgapri_codigo'],
					'pjurisdid_apn'=> $datosactividad['actividad_autodesarrollo_evento']['jurisdid_apn'],
					'porgapub_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['orgapub_codigo'],
					'pactautoeven_obs'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_obs'],
					'pultmodusuario'=>$_SESSION['usuariocod'],
					'pultmodfecha'=> date("Y/m/d H:i:s")
					);		
							
			} else {
				
				if ($datosactividad['actividad_autodesarrollo']['tipoact_codigo'] == TIPOACTAUTOEVASIS )
					$otro_tipoevento = TIPOACTAUTOEVACT;
					
				if ($datosactividad['actividad_autodesarrollo']['tipoact_codigo'] == TIPOACTAUTOEVACT )
					$otro_tipoevento = TIPOACTAUTOEVASIS;
	
				if ($this->TieneTipo($act_codigo_nuevo,$otro_tipoevento,$tiene_tipo)) {
	
					if ($tiene_tipo) {
					
						if(!$this->_DatosValidosModifActividadAutodesarrolloEvento($datos_agrup['actividad_autodesarrollo_evento'],$datosvalidados))
							return false;
						$log = "48703";						
						$spnombre="upd_actividad_autodesarrollo_evento";
						$spparam=array(
							'pact_codigo'=> $act_codigo_nuevo,
							'pactautoeven_duraciondetalle'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_duraciondetalle'],
							'ppais_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['pais_codigo'],
							'pprov_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['prov_codigo'],
							'pactautoeven_direccion'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_direccion'],
							'porgapri_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['orgapri_codigo'],
							'pjurisdid_apn'=> $datosactividad['actividad_autodesarrollo_evento']['jurisdid_apn'],
							'porgapub_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['orgapub_codigo'],
							'pactautoeven_obs'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_obs'],
							'pultmodusuario'=>$_SESSION['usuariocod'],
							'pultmodfecha'=> date("Y/m/d H:i:s")
							);						
					} else {
						if(!$this->_DatosValidosAltaActividadAutodesarrolloEvento($datos_agrup['actividad_autodesarrollo_evento'],$datosvalidados))
							return false;
						$log = "48701";					
						$spnombre="ins_actividad_autodesarrollo_evento";
						$spparam=array(
							'pact_codigo'=> $act_codigo_nuevo,
							'pactautoeven_duraciondetalle'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_duraciondetalle'],
							'ppais_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['pais_codigo'],
							'pactautoeven_creditos_asistencia'=> 0,
							'pprov_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['prov_codigo'],
							'pactautoeven_direccion'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_direccion'],
							'porgapri_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['orgapri_codigo'],
							'pjurisdid_apn'=> $datosactividad['actividad_autodesarrollo_evento']['jurisdid_apn'],
							'porgapub_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['orgapub_codigo'],
							'pactautoeven_obs'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_obs'],
							'pultmodusuario'=>$_SESSION['usuariocod'],
							'pultmodfecha'=> date("Y/m/d H:i:s")
							);						
					} // if ($tiene_tipo) 
				} else { 
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad Autodesarrollo Evento.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
			} // if ($datos['es_nueva'] == 'si') 
				
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al insertar la Actividad Autodesarrollo Evento.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,$log,"act_codigo=".$act_codigo_nuevo,$_SESSION['usuariocod']);
				
		} // if ($datosactividad['actividad_autodesarrollo']['operacion_evento'] == "A" 

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function ModifDatosActividadAutodesarrollo($datos) {

		$datosvalidados=array();		
		
		$this->_AguparDatosPost($datos,$datos_agrup,false);	
		$datosactividad['actividad']=$datos_agrup['actividad'];
		$datosactividad['actividad_autodesarrollo']=$datos_agrup['actividad_autodesarrollo'];		
		$datosactividad['actividad_autodesarrollo_evento']=$datos_agrup['actividad_autodesarrollo_evento'];				

		// modifico actividad
		if ($datos['operacion'] == 'M') {
			if(!$this->ModifDatosActividad($datosactividad['actividad']))
				return false;
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38003","act_codigo=".$datosactividad['actividad']['act_codigo'],$_SESSION['usuariocod']);
		}

		// modifico actividad_autodesarrollo
		if(!$this->_DatosValidosModifActividadAutodesarrollo($datos_agrup['actividad_autodesarrollo'],$datosvalidados))
			return false;
		$spnombre="upd_actividad_autodesarrollo_xact_codigo_tipoact_codigo";
		$spparam=array(
			'pact_codigo'=> $datosactividad['actividad']['act_codigo'],
			'ptipoact_codigo'=> $datosvalidados['actividad_autodesarrollo']['tipoact_codigo'],
			'pactauto_estado'=> ACTAUTOACTIVO,
			'pactauto_duracionhs'=> $datosvalidados['actividad_autodesarrollo']['actauto_duracionhs'],
			'pultmodusuario'=>$_SESSION['usuariocod'],
	        'pultmodfecha'=> date("Y/m/d H:i:s")
			);
			
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la Actividad Autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"48603","act_codigo=".$datosactividad['actividad']['act_codigo'],$_SESSION['usuariocod']);
				

		// modifico actividad_autodesarrollo_evento		
		if ($datosactividad['actividad_autodesarrollo']['operacion_evento'] == "M" && ($datosactividad['actividad_autodesarrollo']['tipoact_codigo'] == TIPOACTAUTOEVASIS || $datosactividad['actividad_autodesarrollo']['tipoact_codigo'] == TIPOACTAUTOEVACT) ) {

			if(!$this->_DatosValidosModifActividadAutodesarrolloEvento($datos_agrup['actividad_autodesarrollo_evento'],$datosvalidados))
				return false;
			$spnombre="upd_actividad_autodesarrollo_evento";
			$spparam=array(
				'pact_codigo'=> $datosactividad['actividad']['act_codigo'],
				'pactautoeven_duraciondetalle'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_duraciondetalle'],
				'ppais_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['pais_codigo'],
				'pprov_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['prov_codigo'],
				'pactautoeven_direccion'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_direccion'],
				'porgapri_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['orgapri_codigo'],
				'pjurisdid_apn'=> $datosactividad['actividad_autodesarrollo_evento']['jurisdid_apn'],
				'porgapub_codigo'=> $datosactividad['actividad_autodesarrollo_evento']['orgapub_codigo'],
				'pactautoeven_obs'=> $datosactividad['actividad_autodesarrollo_evento']['actautoeven_obs'],
				'pultmodusuario'=>$_SESSION['usuariocod'],
		        'pultmodfecha'=> date("Y/m/d H:i:s")
				);			
	
				
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al modificar la Actividad Autodesarrollo Evento.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"48703","act_codigo=".$datosactividad['actividad']['act_codigo'],$_SESSION['usuariocod']);
			
		}

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosActividadAutodesarrollo($act_codigo,$tipoact_codigo) {

		$this -> ObtenerTipos($act_codigo, $tipos_auto);
		$oActividadCurso = new cActividadCurso($this->conexion);
		$oActividadCurso -> ObtenerTipos($act_codigo, $tipos_curso);
		$tiene_todos_auto = false;
		
		if (count($tipos_curso) > 0 && count($tipos_auto) > 0 && in_array(TIPOACTAUTODOCENTE,$tipos_auto)) 
			$tiene_todos_auto = true;
	
		if (count($tipos_auto) > 0 && in_array(TIPOACTAUTOEVASIS,$tipos_auto) && in_array(TIPOACTAUTOEVACT,$tipos_auto)) 
			$tiene_todos_auto = true;

		$cant_evento = 0;

		if (count($tipos_auto) > 0 && in_array(TIPOACTAUTOEVASIS,$tipos_auto)) 
			$cant_evento = 1;

		if (count($tipos_auto) > 0 && in_array(TIPOACTAUTOEVACT,$tipos_auto)) 
			$cant_evento++;
			
		$tiene_formato_curso = (count($tipos_curso)>0); 
		$tiene_formato_auto  = (count($tipos_auto)>1);


		if(!$this->_DatosValidosEliminarActividadAutodesarrollo($act_codigo,$tipoact_codigo))
			return false;

		// elimino actividad_autodesarrollo_evento
		// verifico que solo tenga un tipo
		if ($tipoact_codigo == TIPOACTAUTOEVASIS || $tipoact_codigo == TIPOACTAUTOEVACT ) {
		
			if ($cant_evento ==1) {
				$spnombre="del_actividad_autodesarrollo_evento_xact_codigo";
				$spparam=array('pact_codigo'=> $act_codigo);
		
				if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
					FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la Actividad Autodesarrollo Evento.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
					return false;
				}
				FuncionesPHPLocal::RegistrarAcceso($this->conexion,"48702","act_codigo=".$act_codigo,$_SESSION['usuariocod']);
			}
		} 
		
		// elimino actividad_autodesarrollo
		$spnombre="del_actividad_autodesarrollo_xact_codigo_tipoact_codigo";
		$spparam=array(
			'pact_codigo'=> $act_codigo,
			'ptipoact_codigo'=> $tipoact_codigo				
		);

		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al eliminar la Actividad Autodesarrollo.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			return false;
		}
		FuncionesPHPLocal::RegistrarAcceso($this->conexion,"48602","act_codigo=".$act_codigo,$_SESSION['usuariocod']);
			
		// elimino actividad
		// Verificar que no tiene asignado otro formato de autodesarrollo.

		// Eliminar formato actividad
		if(count($tipos_auto)==1)
			if(!$this->EliminarFormatoActividad($act_codigo,FORMATOAUTO)) 
				return false;		

		// Verificar que no tiene asignado otro formato de curso.
		if(!$tiene_formato_auto && !$tiene_formato_curso) {
			if(!$this->EliminarDatosActividad($act_codigo,FORMATOAUTO))
				return false;
			FuncionesPHPLocal::RegistrarAcceso($this->conexion,"38002","act_codigo=".$act_codigo,$_SESSION['usuariocod']);
		} 

		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function _AguparDatosPost($datos,&$datos_agrup,$es_modif)	{

		//-----------------------------------------------------------
		$datos_agrup['actividad']=array('act_codinap'=>isset($datos['act_codinap'])?$datos['act_codinap']:"",
										'act_nombre'=>$datos['act_nombre'],
										'act_obs'=>$datos['act_obs'],
										'act_codigo'=>$datos['act_codigo']										
										);
		if ($es_modif) 
			$datos_agrup['actividad']+=array('act_codigo'=>$datos['act_codigo']);
		 else 
			$datos_agrup['actividad']+=array('formact_codigo'=>FORMATOAUTO);	
		
			
		//-------------------------------------------------------------
		$datos_agrup['actividad_autodesarrollo'] = array();
		if ($es_modif)
			$datos_agrup['actividad_autodesarrollo']+=array('act_codigo'=>$datos['act_codigo']);
		else {
		 	$datos_agrup['actividad_autodesarrollo']+=array('tipoact_codigo'=>$datos['tipoact_codigo']);
		 	$datos_agrup['actividad_autodesarrollo']+=array('actauto_duracionhs'=>$datos['actauto_duracionhs']);
		}						
		$datos_agrup['actividad_autodesarrollo']['operacion_evento'] = $datos['operacion_evento'];

		$datos_agrup['actividad_autodesarrollo_evento'] = array();

		if ($datos['operacion_evento'] == 'A' || $datos['operacion_evento'] == 'M'){
			if ($datos['tipoact_codigo'] == TIPOACTAUTOEVASIS || $datos['tipoact_codigo'] == TIPOACTAUTOEVACT )	{
				$datos_agrup['actividad_autodesarrollo_evento']+=array('tipo_institucion'=>$datos['tipo_institucion']);
				$datos_agrup['actividad_autodesarrollo_evento']+=array('actautoeven_duraciondetalle'=>$datos['actautoeven_duraciondetalle']);
				$datos_agrup['actividad_autodesarrollo_evento']+=array('pais_codigo'=>$datos['pais_codigo']);			
				$datos_agrup['actividad_autodesarrollo_evento']+=array('prov_codigo'=>($datos['pais_codigo'] == ARGENTINA)?$datos['prov_codigo']:"NULL");						
				$datos_agrup['actividad_autodesarrollo_evento']+=array('actautoeven_direccion'=>$datos['actautoeven_direccion']);									
				$datos_agrup['actividad_autodesarrollo_evento']+=array('tipoorg_codigo'=>$datos['tipoorg_codigo']);		
				$datos_agrup['actividad_autodesarrollo_evento']+=array('orgapri_codigo'=>($datos['tipo_institucion'] == ORGANISMO_PRIVADO)?$datos['orgapri_codigo']:"NULL");
				$datos_agrup['actividad_autodesarrollo_evento']+=array('jurisdid_apn'=>($datos['tipo_institucion'] == ORGANISMO_PUBLICO && ($datos['tipoorg_codigo']==ORGANISMO_APN))?$datos['jurisdid']:"NULL");									
				$datos_agrup['actividad_autodesarrollo_evento']+=array('orgapub_codigo'=>($datos['tipo_institucion'] == ORGANISMO_PUBLICO && ($datos['tipoorg_codigo']==ORGANISMO_NO_APN))?$datos['jurisdid']:"NULL");
				$datos_agrup['actividad_autodesarrollo_evento']+=array('actautoeven_obs'=>$datos['actautoeven_obs']);
			}						
		}		
	}
//-----------------------------------------------------------------------------------------------------	
	function ActualizarCreditos($act_codigo,$act_creditos) {

		$spnombre="upd_actividad_autodesarrollo_asigno_creditos_mero_asistente";
		$spparam=array(
			'pact_codigo'=> $act_codigo,
			'pactautoeven_creditos_asistencia'=> $act_creditos,
			'pultmodusuario'=>$_SESSION['usuariocod'],
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);
			if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))	{
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al buscar para actualizar los créditos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
			if ($numfilas != 1) {
				FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,"Error al actualizar los créditos.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
				return false;
			}
		return true;
		
	}
