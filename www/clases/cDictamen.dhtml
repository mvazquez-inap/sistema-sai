//-----------------------------------------------------------------------------------------------------	
	function ValidarFormDictamen() {	?>		
	function ValidarFormDictamen(formulario,operacion) {
			// Ponderador 	- [pondtipopond_codigo_cal_pres] 	- [OBLIG]
			if ((trim(formulario.pondtipopond_codigo_cal_pres.value)=="")) {
				alert("Debe ingresar el ponderador Calidad del prestador individual o institucional");
				formulario.pondtipopond_codigo_cal_pres.focus();
				return false;
			}	
		
			// Ponderador 	- [pondtipopond_codigo_int] 	- [OBLIG]
			if ((trim(formulario.pondtipopond_codigo_int.value)=="")) {
				alert("Debe ingresar el Ponderador de la Intensidad de la actividadl");
				formulario.pondtipopond_codigo_int.focus();
				return false;
			}	

			// Ponderador 	- [pondtipopond_codigo_proc_eva] 	- [OBLIG]
			if ((trim(formulario.pondtipopond_codigo_proc_eva.value)=="")) {
				alert("Debe ingresar el Ponderador Calidad del proceso evaluador");
				formulario.pondtipopond_codigo_proc_eva.focus();
				return false;
			}	

			// Créditos 	- [actcur_creditos] 	- [OBLIG]
			if (!ValidarContenido(formulario.act_creditos.value,'NumericoEntero') ) {
				alert("Los créditos ingresados deben ser un número entero");
				formulario.act_creditos.focus();
				return false;
			}	
			if (formulario.act_creditos.value<=0) {
				alert("Los créditos deben ser mayor que cero");
				formulario.act_creditos.focus();
				return false;
			}	
			return true;
		}
<?php 	}	
//-----------------------------------------------------------------------------------------------------	
	function ValidarFormProgramacion() {	?>		
	function ValidarFormProgramacion(formulario,operacion) {
			// Fecha de Inicio
			if (formulario.actprog_fecha_inicio.value=="" || !ValidarFecha(formulario.actprog_fecha_inicio.value))
			{
				alert("La fecha de inicio no es válida");
				formulario.actprog_fecha_inicio.focus();
				return false;
			}

			// Fecha de fin
			if (formulario.actprog_fecha_fin.value=="" || !ValidarFecha(formulario.actprog_fecha_fin.value))
			{
				alert("La fecha de finalización no es válida");
				formulario.actprog_fecha_fin.focus();
				return false;
			}

			var fechainicio=ConvertirFecha(formulario.actprog_fecha_inicio.value,'dd/mm/aaaa','aaaammdd');
			var fechafin=ConvertirFecha(formulario.actprog_fecha_fin.value,'dd/mm/aaaa','aaaammdd');
		
			// La fecha de ingreso o la fecha inicial no puede ser superior al actual.			
			if (fechainicio < '<?php echo ANOINICALINAP."0101" ?>') {
				alert("La fecha de inicio debe ser mayor o igual a <?php echo "01/01/".ANOINICALINAP ?>");
				formulario.actprog_fecha_inicio.focus();
				return false;
			}				
				
			if (fechafin< '<?php echo ANOINICALINAP."0101" ?>') {
				alert("La fecha de finalización mayor o igual a <?php echo "01/01/".ANOINICALINAP ?>");
				formulario.actprog_fecha_fin.focus();
				return false;
			}

			// Fecha de Ingreso >= Fecha de Inicio
			if (fechainicio>fechafin) 	{
				alert("La fecha de finalización debe ser mayor o igual que la fecha de inicio");
				formulario.actprog_fecha_inicio.focus();
				return false;
			}

			// Expediente 	- [exp_codigo] 	- [OBLIG]
			if ((trim(formulario.exp_codigo.value)=="")) {
				alert("Debe ingresar el Expediente");
				formulario.exp_codigo.focus();
				return false;
			}	
			
		return true;
	}
<?php 	}	
