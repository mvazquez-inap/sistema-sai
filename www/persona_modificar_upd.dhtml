<?php 
require('./include.dhtml');

$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

$oPersonas = new cPersonas($conexion);



if(isset($_POST['BotonAlta']) && $_POST["pers_codigo"]=="")
{
	$conexion->ManejoTransacciones("B");

	if($oPersonas->AltaDatosPers($_POST))
	{
	
		FuncionesPHPLocal::RegistrarAcceso($conexion,"34901","pers_cuilt=".$_POST['pers_cuilt'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de Alta la persona con CUIT ".$_POST['pers_cuilt'].".",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));

		$conexion->ManejoTransacciones("C");
?>		
		<br><br><br><div align="center"><a href="persona_modificar.dhtml" class="linkFondoBlanco">Continuar</a></div>
		<br><br><br><div align="center"><a href="agente_modificar.dhtml?persCUIT=<?php echo $_POST['pers_cuilt']; ?>" class="linkFondoBlanco">Actualizar datos laborales de la persona</a></div>
<?php 

	}
	else
		$conexion->ManejoTransacciones("R");
}
elseif(isset($_POST['BotonAlta']) && $_POST["pers_codigo"]!="")
{
	$conexion->ManejoTransacciones("B");

	if($oPersonas->ModifDatosPers($_POST))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"34903","pers_codigo=".$_POST['pers_codigo'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han modificado los datos de la persona.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
?>		
		<br><br><br><div align="center"><a href="persona_modificar.dhtml" class="linkFondoBlanco">Continuar</a></div>
<?php 
	}
	else
		$conexion->ManejoTransacciones("R");
}
elseif(isset($_POST['BotonBaja']))
{
	$conexion->ManejoTransacciones("B");

	if($oPersonas->BorrarDatosPers($_POST["pers_codigo"]))
	{
		FuncionesPHPLocal::RegistrarAcceso($conexion,"34902","pers_codigo=".$_POST['pers_codigo'],$_SESSION['usuariocod']);
		FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se han eliminado los datos de la persona.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		$conexion->ManejoTransacciones("C");
?>		
		<br><br><br><div align="center"><a href="persona_modificar.dhtml" class="linkFondoBlanco">Continuar</a></div>
<?php 
	}
	else
		$conexion->ManejoTransacciones("R");
}
else
{

?>		
		<br><br><br><div align="center"><a href="persona_modificar.dhtml" class="linkFondoBlanco">Ir al listado</a></div>
<?php 
}

$oEncabezados->PieMenuEmergente();
?>
