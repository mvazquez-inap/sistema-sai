<?php require('./include.dhtml');
$conexion = new accesoBDLocal(SERVIDORBD,USUARIOBD,CLAVEBD);
$conexion->SeleccionBD(BASEDATOS);

// carga las constantes generales
FuncionesPHPLocal::CargarConstantes($conexion,array("roles"=>"si","sistema"=>SISTEMA));
$conexion->SetearAdmiGeneral(ADMIONTI);

// arma las variables de sesion y verifica si se tiene permisos
$sesion = new Sesion($conexion,false); // Inicia session y no borra
$sesion->TienePermisos($conexion,$_SESSION['usuariocod'],$_SESSION['rolcod'],$_SERVER['PHP_SELF']);

// ve si el sistema está bloqueado
$oSistemaBloqueo = new SistemaBloqueo();
$oSistemaBloqueo->VerificarBloqueo($conexion);

$oEncabezados = new cEncabezados($conexion);
$oEncabezados->EncabezadoMenuEmergente($_SESSION['usuariocod'],$_SESSION['rolcod'],$_SESSION['jurisdid_inap']);

// funciones para pasar  a la clase cDictamen

//-----------------------------------------------------------------------------------------------------	
	function ModifDatosDictamenPersonal($datos,&$dic_codigo_nuevo) {
		echo "<br> Falta definir Actualizar";

	}

//----------------------------------------------------------------------------------------- 
$conexion->ManejoTransacciones("B");
$result=true;
$oDictamen = new cDictamen($conexion);
if (isset($_POST['boton_alta'])) 

		if($oDictamen->AltaDatosDictamenPersonal($_POST,$dic_codigo_nuevo)) {
			FuncionesPHPLocal::RegistrarAcceso($conexion,"48901","act_codigo=".$_POST['act_codigo']."\npers_codigo=".$_POST['pers_codigo'],$_SESSION['usuariocod']);
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de alta el dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
		} else 
			$result=false;

	elseif (isset($_POST['boton_eliminar'])) 
		
			if($oDictamen->BajaDatosDictamenPersonal($_POST)) {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"48902","act_codigo=".$_POST['act_codigo']."\npers_codigo=".$_POST['pers_codigo'],$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha dado de baja el dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else 
				$result=false;

	elseif (isset($_POST['boton_actualizar'])) 

			if($oDictamen->ModifDatosDictamenPersonal($_POST)) {
				FuncionesPHPLocal::RegistrarAcceso($conexion,"48903","act_codigo=".$_POST['act_codigo']."\npers_codigo=".$_POST['pers_codigo'],$_SESSION['usuariocod']);
				FuncionesPHPLocal::MostrarMensaje($conexion,MSG_OK,"Se ha modificado el dictamen.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO));
			} else 
				$result=false;
	
	else {
			$txt_sys_mail="Error validando la operación seleccionada.\nusuariocod=".$_SESSION['usuariocod'];
			FuncionesPHPLocal::MostrarMensaje($conexion,MSG_ERRSOSP,"Error validando la operación seleccionada.",array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$txt_sys_mail);
			$result=false;
		}

if($result) {
	$conexion->ManejoTransacciones("C");
} else	
	$conexion->ManejoTransacciones("R");

$volver ="actividad_autodesarrollo_dictaminar.dhtml";
?>
