<?php 
	class cPrestadorInstitucional  {

	var $conexion;	

	public function __construct($conexion)
	{
		$this->conexion = &$conexion;
	}

//-----------------------------------------------------------------------------------------------------	
	function TraerDatosPrestadorInstitucional($codigo,&$datosresult, &$es_modif) {

		$es_modif = false;		

		$sparam=array('ppresins_codigo' =>$codigo);
		$spnombre="sel_prestador_institucional_xprestint_codigo";	

		if(!($this->conexion->ejecutarStoredProcedure($spnombre,$sparam,$resultado,$numfilas,$errno)) )
		{
			$error="Error al buscar al prestador institucional.";
			$errormail="Error al buscar al prestador institucional en la tabla prestador_institucional. ".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRSOSP,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		if ($numfilas == 1)	{
			$datosresult = mysqli_fetch_assoc($resultado);
			$es_modif = true;
		}
		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function AltaPrestadorInstitucional($datos) {

		if(!$this->_DatosValidosAltaPrestadorInstitucional($datos,$datosvalidados))
			return false;
			
		
		$spnombre="ins_prestador_institucional";
		$spparam=array(
			'ppresins_nombre'=>$datosvalidados["presins_nombre"] ,
			'ppresins_sede'=>$datosvalidados["presins_sede"] ,			
			'ppresins_ra_apellido'=>$datosvalidados["presins_ra_apellido"] ,			
			'ppresins_ra_nombre'=>$datosvalidados["presins_ra_nombre"] ,
			'ppresins_ra_domicilio'=>$datosvalidados["presins_ra_domicilio"] ,
			'ppresins_ra_cp'=>$datosvalidados["presins_ra_cp"] ,			
			'ppresins_ra_prov_codigo'=>$datosvalidados["presins_ra_prov_codigo"] ,			
			'ppresins_ra_part_loca_descripcion'=>$datosvalidados["presins_ra_part_loca_descripcion"] ,
			'ppresins_ra_telefono'=>$datosvalidados["presins_ra_telefono"] ,			
			'ppresins_ra_fax'=>$datosvalidados["presins_ra_fax"] ,
			'ppresins_ra_email'=>$datosvalidados["presins_ra_email"] ,			
			'ppresins_falta'=> date("Y/m/d H:i:s") , 
			'ppresins_fbaja'=> "NULL" , 
			'ppresins_estado'=>PRESINSACTIVO,						
			'pultmodusuario'=>$_SESSION['usuariocod'] ,
			'pultmodfecha'=> date("Y/m/d H:i:s")
			);			
	
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		{
			$error="Error al agregar el prestador institucional.";
			$errormail="Error al insertar en la tabla prestador_institucional".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		
		return true;
	}		
//-----------------------------------------------------------------------------------------------------	
	function EliminarDatosPrestadorInstitucional($presins_codigo,&$codlogbaja) {

		if(!$this->_DatosValidosBorrarPrestadorInstitucional($presins_codigo,$datosvalidados))
			return false;
		$oPrestadorDocente = new cPrestadorDocente($this->conexion);
		$ArregloDatos= array();
		$ArregloDatos['presins_codigo']=$presins_codigo;
		
		if(!$oPrestadorDocente->BuscarPrestadorDocente($ArregloDatos,$numfilas,$resultado,$error,$errormail))
			return false;	
	
		if ($numfilas >= 1) {
				//baja lógica
				$codlogbaja = "36004";
				$spnombre="upd_prestador_institucional_cambio_estado_xpresins_codigo";
				$spparam=array(
					'ppresins_fbaja'=>date("Y/m/d H:i:s"), 
					'ppresins_estado'=>PRESINSBAJA, 
					'pultmodusuario'=>$_SESSION['usuariocod'], 
					'ppresins_codigo'=>$presins_codigo						
				);
		} else {
			//baja física
			$codlogbaja = "36002";			
			$spnombre="del_prestador_institucional";
			$spparam=array(
				'ppresins_codigo'=>$datosvalidados["presins_codigo"]
			);			
		}		
		
		
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		{
			$error="Error al eliminar la institución prestadora.";
			$errormail="Error al eliminar en la tabla prstador_institución".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		return true;
	}	
	
//-----------------------------------------------------------------------------------------------------	
	function ModifDatosPrestadorInstitucional($datos)	{

		if(!$this->_DatosValidosModifPrestadorInstitucional($datos,$datosvalidados))
			return false;

		$spnombre="upd_prestador_institucional";
		$spparam=array(
			'ppresins_nombre'=>$datosvalidados["presins_nombre"] ,
			'ppresins_sede'=>$datosvalidados["presins_sede"] ,			
			'ppresins_ra_apellido'=>$datosvalidados["presins_ra_apellido"] ,			
			'ppresins_ra_nombre'=>$datosvalidados["presins_ra_nombre"] ,
			'ppresins_ra_domicilio'=>$datosvalidados["presins_ra_domicilio"] ,
			'ppresins_ra_cp'=>$datosvalidados["presins_ra_cp"] ,			
			'ppresins_ra_prov_codigo'=>$datosvalidados["presins_ra_prov_codigo"] ,			
			'ppresins_ra_part_loca_descripcion'=>$datosvalidados["presins_ra_part_loca_descripcion"] ,
			'ppresins_ra_telefono'=>$datosvalidados["presins_ra_telefono"] ,			
			'ppresins_ra_fax'=>$datosvalidados["presins_ra_fax"] ,
			'ppresins_ra_email'=>$datosvalidados["presins_ra_email"] ,			
			'pultmodusuario'=>$_SESSION['usuariocod'] ,
			'pultmodfecha'=> date("Y/m/d H:i:s"),
			'ppresins_codigo'=>$datosvalidados["presins_codigo"]		
			);			
			
		if(!$this->conexion->ejecutarStoredProcedure($spnombre,$spparam,$resultado,$numfilas,$errno))
		{
			$error="Error al modificar los datos de la institución prestadora.";
			$errormail="Error al modificar en la tabla prestador_institucional".$errno;
			FuncionesPHPLocal::MostrarMensaje($this->conexion,MSG_ERRGRAVE,$error,array("archivo" => __FILE__,"funcion" => __FUNCTION__, "linea" => __LINE__),array("formato"=>FMT_TEXTO),$errormail);
			return false;
		}
		
		return true;
	}	
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosAltaPrestadorInstitucional($datos,&$datosvalidados)	{

		$datosvalidados=array();
		
		if(!$this->_DatosValidosComunesPrestadorInstitucional($datos,$datosvalidados))
			return false;

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosBorrarPrestadorInstitucional($presins_codigo,&$datosvalidados)	{

		if(!$this->TraerDatosPrestadorInstitucional($presins_codigo,$datosvalidados,$es_modif))
			return false;

		return true;
	}
//-----------------------------------------------------------------------------------------------------	
	function _DatosValidosModifPrestadorInstitucional($datos,&$datosvalidados)	{
		$datosvalidados=array();
			
		if(!$this->_DatosValidosComunesPrestadorInstitucional($datos,$datosvalidados))
			return false;
			
	return true;
	}
